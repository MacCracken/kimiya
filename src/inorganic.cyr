# inorganic.cyr — inorganic chemistry: crystal field theory, the spectrochemical series, spin-only magnetic moments,
# lattice energies and ionic radii (port of rust-old/src/inorganic.rs).
#
# CFSE is in units of Δ_oct, moments in Bohr magnetons, the Born–Landé energy in J/mol and the Born–Haber one in
# kJ/mol, radii in pm. The data — KmLigand and its field strengths, Rust's private octahedral occupancy and
# unpaired-electron tables, the Madelung constants and Born exponents, the 30 Shannon IONIC_RADII rows — is
# src/inorganic_data.cyr (generated); AVOGADRO, ELEMENTARY_CHARGE and COULOMB_CONSTANT are src/constants.cyr's.
# Fallible functions return a value-form Result whose Err payload is a KM_ERR_* code, and reject NaN and ±∞ inputs.
# Every expression keeps Rust's operation order, so every result is bit-identical (classes A and B), but one: the CFSE
# is computed exactly, (3·e_g − 2·t₂g) / 5 in one correctly rounded division (ADR 0002 #12; the golden rows where Rust's
# −0.4·t₂g + 0.6·e_g misses it are mapped by the harness and reported as accepted under ADR 2), and Δ_tet is the
# correctly rounded 4Δ/9 also where Rust's Δ·4 overflows (ADR 0002 #15, mapped the same way). ADR 0002 #32 (the overflow
# audit's B3, #20's semantics): born_lande_lattice_energy is Rust's chain where it stays in the normal range (Rust's
# bits) and otherwise Rust's sequence with an unbounded exponent, the final product rounded once (mapped the same way);
# its (1 − 1/n) stays Rust's (M4b's review). ADR 0002 #33 (the audit's B4, #20's semantics): born_haber_lattice_energy's
# chain of differences likewise, the last difference rounded once.
#
# - Rust's integers are words here, never wrapped (port plan §6.4). A d-electron or unpaired-electron count (`u8`)
#   outside 0 ..= 255, an ion charge (`u32`) outside 0 ..= u32::MAX, an ionic-radius charge (`i8`) outside
#   −128 ..= 127: Err(KM_ERR_INVALID_INPUT) for a Result function (cfse_octahedral, unpaired_electrons_oct,
#   born_lande_lattice_energy), NaN for a bare f64 (spin_only_moment), None (0) for a lookup (lookup_ionic_radius).
# - Rust's `bool` is a word: 0 is false and 1 is true. Any other word is Err(KM_ERR_INVALID_INPUT) in a Result
#   function (`high_spin` of cfse_octahedral and unpaired_electrons_oct), checked where Rust picks its table, before
#   the count. (A non-Result function with a bool argument would return its "none", as for an out-of-type integer:
#   port plan §6.4; inorganic has none.)
# - KmLigand has explicit, append-only values in Rust variant order; Ligand's const methods are
#   ligand_field_strength(l) and ligand_is_strong_field(l), 0 for a word that is no KmLigand value.
#   is_strong_field is Rust's formula, field_strength ≥ 8 (the 8 typed inline, as in Rust).
# - lookup_ionic_radius(symbol, charge) returns a handle, IONIC_RADII row + 1, or 0 for None; IonicRadius's fields
#   are ionic_radius_symbol(h) ("" for an invalid handle), ionic_radius_charge(h) and ionic_radius_coordination(h) (0:
#   no row has a zero charge or coordination) and ionic_radius_radius_pm(h) (NaN).

include "lib/string.cyr"

# 1 if the word x is a Rust u8 (0 ..= 255).
#must_use
fn _km_is_u8(x): i64 {
    if (x < 0 || x > 255) { return 0; }
    return 1;
}

# 1 if the word x is a Rust bool: 0 (false) or 1 (true).
#must_use
fn _km_is_bool(x): i64 {
    if (x == 0 || x == 1) { return 1; }
    return 0;
}

# ── crystal field theory ────────────────────────────────────────────────────────────

# Crystal field stabilization energy (CFSE) of an octahedral dⁿ complex, in units of Δ_oct (a dimensionless
# multiplier; negative = stabilizing): CFSE = −0.4·n(t₂g) + 0.6·n(e_g) = (3·n(e_g) − 2·n(t₂g)) / 5, from the generated
# (t₂g, e_g) occupancy of dⁿ, high-spin (weak field, high_spin = 1: Hund's rule) or low-spin (strong field,
# high_spin = 0: t₂g filled first). Electron-pairing energy is not included, so for d⁴–d⁷ the low-spin value is more
# negative than the high-spin one even when the high-spin state is the ground state. Ok(CFSE) for n = 0 ..= 10;
# Err(KM_ERR_INVALID_INPUT) if high_spin is no bool (0 or 1) or d_electrons is outside 0 ..= 10 (a word outside Rust's
# u8 included). ADR 0002 #12: the value is exact — the integer numerator 3·e_g − 2·t₂g converted to f64, then one
# correctly rounded division by 5 — where Rust's `t2g * (−0.4) + eg * 0.6` misses it on 13 of the 22 cases (high-spin
# d⁵ gives −2⁻⁵² and d¹⁰ −2⁻⁵¹ rather than 0, d³ −1.2000000000000002). Mirrors `inorganic::cfse_octahedral`.
#must_use
fn cfse_octahedral(d_electrons, high_spin): Result {
    if (_km_is_bool(high_spin) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    if (d_electrons < 0 || d_electrons > 10) { return Err(KM_ERR_INVALID_INPUT); }
    var t2g = _KM_OCT_OCCUPANCY_LOW_SPIN_T2G[d_electrons];
    var eg = _KM_OCT_OCCUPANCY_LOW_SPIN_EG[d_electrons];
    if (high_spin == 1) {
        t2g = _KM_OCT_OCCUPANCY_HIGH_SPIN_T2G[d_electrons];
        eg = _KM_OCT_OCCUPANCY_HIGH_SPIN_EG[d_electrons];
    }
    var num = 3 * eg - 2 * t2g;
    var n: f64 = f64_from(num);
    var cfse: f64 = n / 5.0;
    return Ok(cfse);
}

# The tetrahedral crystal field splitting Δ_tet ≈ (4/9)·Δ_oct (same metal, ligands and metal–ligand distance), in the
# unit of delta_oct: the correctly rounded 4Δ/9. Computed as Rust's `delta_oct * 4.0 / 9.0` (Δ·4 is exact, so one
# rounding) except where Δ·4 overflows, |Δ| ≥ 2¹⁰²² (above DBL_MAX/4): there Rust gives ±∞, and ADR 0002 #15 (the user's
# decision, 2026-11-09) takes (Δ/9)·4 — one rounded division, then an exact ×4 that cannot overflow — which is again the
# correctly rounded 4Δ/9 (4·DBL_MAX/9 ≈ 7.99 × 10³⁰⁷, not +∞). ±∞ and NaN propagate as in Rust.
# Mirrors `inorganic::delta_tet_from_oct`, with ADR 0002 #15.
#must_use
fn delta_tet_from_oct(delta_oct: f64): f64 {
    var four: f64 = delta_oct * 4.0;
    if (_km_is_finite(four) != 1 && _km_is_finite(delta_oct) == 1) {
        var ninth: f64 = delta_oct / 9.0;          # ADR 0002 #15: Δ·4 overflowed
        var tet4: f64 = ninth * 4.0;
        return tet4;
    }
    var tet: f64 = four / 9.0;
    return tet;
}

# ── spectrochemical series ──────────────────────────────────────────────────────────

# The relative field strength of ligand l (a KmLigand value) as an ordinal rank 1–12 (dimensionless; higher =
# stronger field; gaps between ranks carry no meaning); 0 for a word that is no KmLigand value. Mirrors
# `Ligand::field_strength`.
#must_use
fn ligand_field_strength(l): i64 {
    if (l < 0 || l >= KM_LIGAND_COUNT) { return 0; }
    return KM_LIGAND_FIELD_STRENGTH[l];
}

# 1 if ligand l is a strong-field ligand (typically causes low spin), i.e. its rank is ≥ 8 (KM_LIGAND_AMMONIA and
# stronger); 0 otherwise and for a word that is no KmLigand value. NH₃ is borderline: whether its complexes are
# low-spin depends on the metal ion and its oxidation state ([Co(NH₃)₆]³⁺ is low-spin, [Co(NH₃)₆]²⁺ high-spin).
# Mirrors `Ligand::is_strong_field`.
#must_use
fn ligand_is_strong_field(l): i64 {
    if (l < 0 || l >= KM_LIGAND_COUNT) { return 0; }
    if (KM_LIGAND_FIELD_STRENGTH[l] >= 8) { return 1; }
    return 0;
}

# ── spin-only magnetic moment ───────────────────────────────────────────────────────

# The spin-only magnetic moment μ = √(n(n + 2)) in Bohr magnetons for n unpaired electrons (a Rust u8, as a word);
# NaN for a word outside 0 ..= 255 (there is no error channel). Mirrors `inorganic::spin_only_moment`.
#must_use
fn spin_only_moment(unpaired_electrons): f64 {
    if (_km_is_u8(unpaired_electrons) != 1) { return _km_nan(); }
    var n: f64 = f64_from(unpaired_electrons);
    var n2: f64 = n + 2.0;
    var p: f64 = n * n2;
    var mu: f64 = f64_sqrt(p);
    return mu;
}

# The number of unpaired electrons of an octahedral dⁿ complex, high-spin (high_spin = 1) or low-spin (0), from the
# generated tables. Ok(n unpaired) for d_electrons = 0 ..= 10; Err(KM_ERR_INVALID_INPUT) if high_spin is no bool or
# d_electrons is outside 0 ..= 10 (a word outside Rust's u8 included). Mirrors `inorganic::unpaired_electrons_oct`.
#must_use
fn unpaired_electrons_oct(d_electrons, high_spin): Result {
    if (_km_is_bool(high_spin) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    if (d_electrons < 0 || d_electrons > 10) { return Err(KM_ERR_INVALID_INPUT); }
    if (high_spin == 1) { return Ok(_KM_OCT_UNPAIRED_HIGH_SPIN[d_electrons]); }
    return Ok(_KM_OCT_UNPAIRED_LOW_SPIN[d_electrons]);
}

# ── lattice energy ──────────────────────────────────────────────────────────────────

# The Born–Landé lattice energy U = −(k_e·N_A·M·z⁺·z⁻·e²) / r₀ · (1 − 1/n) in J/mol (negative = stable), from the
# Madelung constant M (dimensionless, positive), the cation and anion charge magnitudes z⁺ and z⁻ (Rust u32s, as words;
# the anion's sign is handled by the formula), the nearest-neighbour distance r₀ in m and the Born exponent n (typically
# 5–12). Computed in Rust's order, `−k_e · N_A · M · z⁺ · z⁻ · e · e / r₀ · (1 − 1/n)` left to right. Ok(U);
# Err(KM_ERR_INVALID_INPUT) if r₀ is not positive and finite, n is not finite or ≤ 1, M is not positive and finite, or
# either charge is 0 or outside 0 ..= u32::MAX (in that order). ADR 0002 #32 (the overflow audit's B3, #20's semantics:
# the factor (1 − 1/n) is a sum, left as Rust's in M4b): Rust's chain where it stays in the normal range (Rust's bits),
# otherwise the same sequence with an unbounded exponent and the final product rounded once (_km_born_lande_ux): a
# prefix (−k_e·N_A·M·z⁺·z⁻) past DBL_MAX (M above about 3·10²⁷⁴/(z⁺·z⁻)) or a subnormal M, which e² and /r₀ bring back
# (Rust: −∞, −0 or a degraded value). Mirrors `inorganic::born_lande_lattice_energy`, with ADR 0002 #32.
#must_use
fn born_lande_lattice_energy(madelung: f64, z_cation, z_anion, r0_m: f64, born_exponent: f64): Result {
    if (_km_is_positive(r0_m) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    if (_km_is_finite(born_exponent) != 1 || born_exponent <= 1.0) { return Err(KM_ERR_INVALID_INPUT); }
    if (_km_is_positive(madelung) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    if (z_cation < 1 || z_cation > 0xFFFFFFFF || z_anion < 1 || z_anion > 0xFFFFFFFF) {
        return Err(KM_ERR_INVALID_INPUT);
    }
    var zc: f64 = f64_from(z_cation);
    var za: f64 = f64_from(z_anion);
    var u, ok = _km_born_lande_fast(madelung, zc, za, r0_m, born_exponent);
    if (ok == 1) { return Ok(u); }
    var w: f64 = _km_born_lande_ux(madelung, zc, za, r0_m, born_exponent);
    return Ok(w);
}

# born_lande_lattice_energy's fast path, for its validated inputs (the charges as exact doubles): (U, 1) while Rust's
# chain provably is the unbounded-exponent one (ADR 0002 #32), or (0, 0). For M in [2⁻⁶⁰, 2⁶⁰] and r₀ in [2⁻²⁰⁰, 2⁶⁰]
# every partial product is provably normal (−k_e·N_A·M in [2⁵², 2¹⁷²], times z⁺ and z⁻ (at most 2³² each) below 2²³⁶,
# times e·e (e ≈ 2^-62.4) in [2⁻⁷⁴, 2¹⁷⁴], over r₀ in [2⁻¹³⁴, 2³¹²]: every physical salt), so the test is skipped;
# otherwise each partial product and the quotient by r₀ must lie in [2⁻¹⁰²¹, DBL_MAX] (_km_ux_normal; −k_e·N_A is a
# normal constant). The factor 1 − 1/n is always the unbounded one: 1/n is in (0, 1), and where Rust's 1/n is not normal
# (n > 2¹⁰²¹) both 1/n are below 2⁻⁵⁴, so both differences round to 1. The final product of two doubles is then rounded
# once in both evaluations.
#must_use
fn _km_born_lande_fast(madelung: f64, zc: f64, za: f64, r0_m: f64, born_exponent: f64): (f64, i64) {
    var ke: f64 = KM_COULOMB_CONSTANT;
    var na: f64 = KM_AVOGADRO;
    var e: f64 = KM_ELEMENTARY_CHARGE;
    var u1: f64 = -ke;
    u1 = u1 * na;
    var u2: f64 = u1 * madelung;
    var u3: f64 = u2 * zc;
    var u4: f64 = u3 * za;
    var u5: f64 = u4 * e;
    var u6: f64 = u5 * e;
    var u7: f64 = u6 / r0_m;
    var bm = load64(&madelung);
    var br = load64(&r0_m);
    if (bm < 0x3C30000000000000 || bm > 0x43B0000000000000 || br < 0x3370000000000000 || br > 0x43B0000000000000) {
        var n = _km_ux_normal(u2) + _km_ux_normal(u3) + _km_ux_normal(u4) + _km_ux_normal(u5) + _km_ux_normal(u6);
        if (n != 5 || _km_ux_normal(u7) != 1) { return (0.0, 0); }
    }
    var inv: f64 = 1.0 / born_exponent;
    var factor: f64 = 1.0 - inv;
    var u: f64 = u7 * factor;
    return (u, 1);
}

# born_lande_lattice_energy with an unbounded exponent (ADR 0002 #32), for its validated inputs (the charges as exact
# doubles): Rust's −k_e · N_A · M · z⁺ · z⁻ · e · e / r₀ · (1 − 1/n) left to right, every operation rounded to 53 bits
# and nothing over- or underflowing (src/mathx.cyr's _km_ux_*), the final product rounded once into binary64
# (_km_ux_mul_f64).
#must_use
fn _km_born_lande_ux(madelung: f64, zc: f64, za: f64, r0_m: f64, born_exponent: f64): f64 {
    var ke: f64 = KM_COULOMB_CONSTANT;
    var na: f64 = KM_AVOGADRO;
    var e: f64 = KM_ELEMENTARY_CHARGE;
    var nke: f64 = -ke;
    var us, ue = _km_ux_from(nke);
    var ns, ne = _km_ux_from(na);
    var u1s, u1e = _km_ux_mul(us, ue, ns, ne);
    var ms, me = _km_ux_from(madelung);
    var u2s, u2e = _km_ux_mul(u1s, u1e, ms, me);
    var cs, ce = _km_ux_from(zc);
    var u3s, u3e = _km_ux_mul(u2s, u2e, cs, ce);
    var as1, ae = _km_ux_from(za);
    var u4s, u4e = _km_ux_mul(u3s, u3e, as1, ae);
    var es, ee = _km_ux_from(e);
    var u5s, u5e = _km_ux_mul(u4s, u4e, es, ee);
    var u6s, u6e = _km_ux_mul(u5s, u5e, es, ee);
    var rs, re = _km_ux_from(r0_m);
    var u7s, u7e = _km_ux_div(u6s, u6e, rs, re);
    var one: f64 = 1.0;
    var os, oe = _km_ux_from(one);
    var bs, be = _km_ux_from(born_exponent);
    var is1, ie = _km_ux_div(os, oe, bs, be);
    var fs, fe = _km_ux_sub(os, oe, is1, ie);
    var u: f64 = _km_ux_mul_f64(u7s, u7e, fs, fe);
    return u;
}

# The Born–Haber lattice energy U = ΔH_f° − ΔH_sub − IE − ΔH_diss/2 − EA in kJ/mol (negative = stable), from the
# compound's formation enthalpy, the metal's sublimation enthalpy and ionization energy, the full X₂ → 2X
# dissociation enthalpy (halved here, for MX) and the nonmetal's electron affinity (negative = energy released), all
# in kJ/mol. Computed in Rust's order, left to right; inputs are not validated (NaN and ±∞ propagate). ADR 0002 #33:
# Rust's chain where its result is finite and ΔH_diss/2 exact (the halving rounds only for an odd multiple of 2⁻¹⁰⁷⁴
# below 2⁻¹⁰²¹; the differences of doubles are then exact below 2⁻¹⁰²¹ and the 53-bit roundings above, so a finite
# result of finite inputs is the unbounded chain's: src/thermo.cyr's comment on #33's sums); otherwise, for finite
# inputs, the same sequence with an unbounded exponent and the last difference rounded once
# (born_haber_lattice_energy(DBL_MAX, −DBL_MAX, DBL_MAX, 0, 0) is DBL_MAX, Rust's ∞). Mirrors
# `inorganic::born_haber_lattice_energy`, with ADR 0002 #33.
#must_use
fn born_haber_lattice_energy(formation_enthalpy_kj: f64, sublimation_enthalpy_kj: f64, ionization_energy_kj: f64,
    dissociation_enthalpy_kj: f64, electron_affinity_kj: f64): f64 {
    var u: f64 = formation_enthalpy_kj - sublimation_enthalpy_kj;
    u = u - ionization_energy_kj;
    var half: f64 = dissociation_enthalpy_kj / 2.0;
    u = u - half;
    u = u - electron_affinity_kj;
    var du: f64 = u - u;
    var h2: f64 = half * 2.0;
    if (du == 0.0 && h2 == dissociation_enthalpy_kj) { return u; }
    var nf = _km_is_finite(formation_enthalpy_kj) + _km_is_finite(sublimation_enthalpy_kj);
    nf = nf + _km_is_finite(ionization_energy_kj) + _km_is_finite(dissociation_enthalpy_kj);
    if (nf + _km_is_finite(electron_affinity_kj) != 5) { return u; }
    var r: f64 = _km_born_haber_ux(formation_enthalpy_kj, sublimation_enthalpy_kj, ionization_energy_kj,
        dissociation_enthalpy_kj, electron_affinity_kj);
    return r;
}

# born_haber_lattice_energy with an unbounded exponent (ADR 0002 #33), for finite inputs: Rust's differences left to
# right and the halving rounded to 53 bits (_km_ux_*), the last difference rounded once into binary64.
#must_use
fn _km_born_haber_ux(formation_enthalpy_kj: f64, sublimation_enthalpy_kj: f64, ionization_energy_kj: f64,
    dissociation_enthalpy_kj: f64, electron_affinity_kj: f64): f64 {
    var fs, fe = _km_ux_from(formation_enthalpy_kj);
    var ss, se = _km_ux_from(sublimation_enthalpy_kj);
    var is1, ie = _km_ux_from(ionization_energy_kj);
    var ds, de = _km_ux_from(dissociation_enthalpy_kj);
    var es, ee = _km_ux_from(electron_affinity_kj);
    var two: f64 = 2.0;
    var ts, te = _km_ux_from(two);
    var a1, b1 = _km_ux_sub(fs, fe, ss, se);
    var a2, b2 = _km_ux_sub(a1, b1, is1, ie);
    var hs, he = _km_ux_div(ds, de, ts, te);
    var a3, b3 = _km_ux_sub(a2, b2, hs, he);
    var r: f64 = _km_ux_sub_f64(a3, b3, es, ee);
    return r;
}

# ── ionic radii ─────────────────────────────────────────────────────────────────────

# The IONIC_RADII row of handle h (h − 1), or -1 if h is no handle.
#must_use
fn _km_ionic_radius_row(h): i64 {
    if (h >= 1 && h <= KM_IONIC_RADII_COUNT) { return h - 1; }
    return 0 - 1;
}

# The Shannon (1976) ionic radius of the ion with element symbol `symbol` (a C string, exact and case-sensitive:
# "Fe") and charge `charge` (in e, negative for anions; a Rust i8, as a word), as a handle (its IONIC_RADII row + 1),
# whatever its coordination number; 0 when no row matches, `symbol` is 0, or charge is outside −128 ..= 127. The first
# match in table order, as Rust's linear `find` (each ion has one row). Mirrors `inorganic::lookup_ionic_radius`.
#must_use
fn lookup_ionic_radius(symbol, charge): i64 {
    if (symbol == 0 || charge < (0 - 128) || charge > 127) { return 0; }
    var c0 = load8(symbol);
    if (c0 == 0) { return 0; }
    var n = strlen(symbol);
    var row = 0;
    while (row < KM_IONIC_RADII_COUNT) {
        var p = &_KM_IONIC_RADII_SYMBOL_BYTES + _KM_IONIC_RADII_SYMBOL_OFF[row];
        # The charge and the first byte decide most rows; memeq stops at p's NUL, which differs from symbol's byte.
        if (KM_IONIC_RADII_CHARGE[row] == charge && load8(p) == c0) {
            if (memeq(p, symbol, n) == 1 && load8(p + n) == 0) { return row + 1; }
        }
        row = row + 1;
    }
    return 0;
}

# The element symbol of IONIC_RADII handle h ("Fe") as a C string in the baked table; "" for an invalid handle.
# Mirrors `IonicRadius::symbol`.
#must_use
fn ionic_radius_symbol(h): i64 {
    var row = _km_ionic_radius_row(h);
    if (row < 0) { return ""; }
    return &_KM_IONIC_RADII_SYMBOL_BYTES + _KM_IONIC_RADII_SYMBOL_OFF[row];
}

# The ion charge of IONIC_RADII handle h in units of e (negative for anions); 0 for an invalid handle, which no row
# has. Mirrors `IonicRadius::charge`.
#must_use
fn ionic_radius_charge(h): i64 {
    var row = _km_ionic_radius_row(h);
    if (row < 0) { return 0; }
    return KM_IONIC_RADII_CHARGE[row];
}

# The coordination number the radius of IONIC_RADII handle h applies to (6 for every row but Sn²⁺, 8); 0 for an
# invalid handle. Mirrors `IonicRadius::coordination`.
#must_use
fn ionic_radius_coordination(h): i64 {
    var row = _km_ionic_radius_row(h);
    if (row < 0) { return 0; }
    return KM_IONIC_RADII_COORDINATION[row];
}

# The effective ionic radius of IONIC_RADII handle h in pm (Shannon 1976); NaN for an invalid handle. Mirrors
# `IonicRadius::radius_pm`.
#must_use
fn ionic_radius_radius_pm(h): f64 {
    var row = _km_ionic_radius_row(h);
    if (row < 0) { return _km_nan(); }
    var r: f64 = KM_IONIC_RADII_RADIUS_PM[row];
    return r;
}
