# numerics.cyr — the hisab 1.4.0 numerical routines kimiya 1.2.0 calls that hisab 3.4.1 lacks, transcribed (ADR 0003,
# port plan §6.2; M5a).
#
# The oracle's reaction_dynamics integrates systems of ODEs through hisab 1.4.0's `num::rk4_trajectory`, `num::dopri45`
# and `num::euler_maruyama`, and solves its backward-Euler Newton systems with `num::gaussian_elimination`. hisab 3.4.1
# has scalar ODE steps only and no dense direct solver, so each routine is here, private, operation for operation from
# ~/.cargo/registry/src/*/hisab-1.4.0/src/num/{ode,roots,rng}.rs: the same loops, the same left-to-right sums, the same
# scratch buffers reused (and never re-zeroed) across steps, no FMA. Only + − × ÷ and √ are on the RK4, Euler–Maruyama
# drift and elimination paths; dopri45's step factor is err^(−0.2) and the Box–Muller normal draw takes ln and cos,
# which are src/mathx.cyr's correctly rounded _km_cr_pow, _km_cr_ln and _km_cr_cos (ADR 0006), so every routine gives
# the corrected oracle's bits on every target. The PCG32 generator is hisab 3.4.1's (pcg32_new / pcg32_next, stream 1:
# its output is 1.4.0's `Pcg32::new(seed, 1)` bit for bit, tests/numerics.tcyr's golden rows); next_f64 and
# next_normal are 1.4.0's, transcribed here on its u32 output.
#
# The Rust closures `Fn(f64, &[f64], &mut [f64])` are a function pointer and a context pointer (port plan §6.3):
# f(ctx, t, y, dy, n), called through `callptr`, with y and dy pointers to n f64 each (the slices' common length n). A
# trajectory is a flat buffer of points, each 1 + n f64 (t, then y[0 .. n)), point k at out + 8·k·(1 + n): the
# routines store point k only while k < cap (out may then be 0 with cap 0) and return the point count, so a caller
# can integrate without keeping the path. `fin`, when not 0, receives the final state (n f64). Errors are the
# HisabError variants (the _KM_NUM_ERR_* codes below, private; tests/numerics.tcyr names them), and _KM_NUM_ERR_ALLOC
# where a work table can't be allocated (Rust would abort). Work tables of up to _KM_NUM_STACK f64 are on the stack;
# larger ones come from the bump allocator (which never frees), zeroed as Rust's `vec![0.0; n]`.
#
# M5b adds hisab 1.4.0's `num::least_squares_poly` (fitting: the Vandermonde system by `powi`, modified Gram–Schmidt QR
# with its 10⁻¹² rank threshold, back substitution), `num::matrix_rank` with `num::svd` (network: one-sided Jacobi
# rotations to its EPSILON_F64² test, the column norms counted above the threshold) and `CsrMatrix::from_dense`
# (network: entries with |v| > 10⁻¹² kept, into a hisab 3.4.1 CSR). hisab 3.4.1's svd_compute_checked answers where
# 1.4.0's Jacobi does not converge (most dense matrices: the network golden rows) and refuses the non-finite entries
# 1.4.0 counts, and its csr_from_dense keeps every nonzero entry, so all three are transcribed (ADR 0003's M5b
# amendment); only + − × ÷, √ and powi are on their paths, so every result is the oracle's bit for bit.

include "lib/alloc.cyr"
include "lib/hisab.cyr"

# hisab 1.4.0's HisabError variants, as the private routines return them.
const _KM_NUM_ERR_ZERO_STEPS = 1;           # HisabError::ZeroSteps
const _KM_NUM_ERR_INVALID_INPUT = 2;        # HisabError::InvalidInput
const _KM_NUM_ERR_NO_CONVERGENCE = 3;       # HisabError::NoConvergence
const _KM_NUM_ERR_SINGULAR_PIVOT = 4;       # HisabError::SingularPivot
const _KM_NUM_ERR_ALLOC = 5;                # a work table could not be allocated (no Rust counterpart)

# Work-table words kept on the stack (RK4 needs 7·n, dopri45 10·n, Euler–Maruyama 3·n).
const _KM_NUM_STACK = 96;

# n zeroed f64 words: the caller's stack table `st` (cap words) when n fits, else the bump allocator; 0 when that
# fails or 8·n would overflow.
#must_use
fn _km_num_table(st, cap, n): i64 {
    var p = st;
    if (n > cap) {
        if (n > 0x0080000000000000) { return 0; }
        p = alloc(8 * n);
        if (p == 0) { return 0; }
    }
    var k = 0;
    while (k < n) {
        store64(p + 8 * k, 0);
        k = k + 1;
    }
    return p;
}

# Copies n f64 words from src to dst.
fn _km_num_copy(dst, src, n) {
    var k = 0;
    while (k < n) {
        store64(dst + 8 * k, load64(src + 8 * k));
        k = k + 1;
    }
    return 0;
}

# Stores trajectory point k = (t, y[0 .. n)) at out when k < cap.
fn _km_num_point(out, cap, k, t: f64, y, n) {
    if (k >= cap) { return 0; }
    var p = out + 8 * k * (1 + n);
    store64(p, t);
    _km_num_copy(p + 8, y, n);
    return 0;
}

# ── classical RK4 (num::rk4_trajectory) ──────────────────────────────────────────────

# One RK4 step in place, hisab 1.4.0's `rk4_step`: the four stages, then each component's increment
# h/6·(k1 + 2·k2 + 2·k3 + k4) added with Neumaier compensation, `comp` carrying each component's running correction
# across steps.
fn _km_rk4_step(f, ctx, t: f64, h: f64, y, k1, k2, k3, k4, tmp, comp, n) {
    callptr(f, ctx, t, y, k1, n);
    var hh: f64 = 0.5 * h;
    var i = 0;
    while (i < n) {
        var yi: f64 = load64(y + 8 * i);
        var ki: f64 = load64(k1 + 8 * i);
        var s: f64 = hh * ki;
        var v: f64 = yi + s;
        store64(tmp + 8 * i, v);
        i = i + 1;
    }
    var th: f64 = t + hh;
    callptr(f, ctx, th, tmp, k2, n);
    i = 0;
    while (i < n) {
        var yi2: f64 = load64(y + 8 * i);
        var ki2: f64 = load64(k2 + 8 * i);
        var s2: f64 = hh * ki2;
        var v2: f64 = yi2 + s2;
        store64(tmp + 8 * i, v2);
        i = i + 1;
    }
    callptr(f, ctx, th, tmp, k3, n);
    i = 0;
    while (i < n) {
        var yi3: f64 = load64(y + 8 * i);
        var ki3: f64 = load64(k3 + 8 * i);
        var s3: f64 = h * ki3;
        var v3: f64 = yi3 + s3;
        store64(tmp + 8 * i, v3);
        i = i + 1;
    }
    var t1: f64 = t + h;
    callptr(f, ctx, t1, tmp, k4, n);
    var h6: f64 = h / 6.0;
    i = 0;
    while (i < n) {
        var a: f64 = load64(k1 + 8 * i);
        var b: f64 = load64(k2 + 8 * i);
        var c: f64 = load64(k3 + 8 * i);
        var d: f64 = load64(k4 + 8 * i);
        var b2: f64 = 2.0 * b;
        var c2: f64 = 2.0 * c;
        var sum: f64 = a + b2;
        sum = sum + c2;
        sum = sum + d;
        var delta: f64 = h6 * sum;
        var yv: f64 = load64(y + 8 * i);
        var ns: f64 = yv + delta;
        var cv: f64 = load64(comp + 8 * i);
        var ay: f64 = f64_abs(yv);
        var ad: f64 = f64_abs(delta);
        if (ay >= ad) {
            var e1: f64 = yv - ns;
            e1 = e1 + delta;
            cv = cv + e1;
        } else {
            var e2: f64 = delta - ns;
            e2 = e2 + yv;
            cv = cv + e2;
        }
        store64(comp + 8 * i, cv);
        var yn: f64 = ns + cv;
        store64(y + 8 * i, yn);
        i = i + 1;
    }
    return 0;
}

# hisab 1.4.0's `num::rk4_trajectory`: dy/dt = f(t, y) from (t0, y0[0 .. n)) to t_end in `steps` RK4 steps of
# h = (t_end − t0)/steps, t advanced by repeated `t += h`; the steps + 1 points (t0, y0), …, go to `out` (the first cap
# of them), the final state to `fin` (if not 0). Ok(steps + 1); Err(_KM_NUM_ERR_ZERO_STEPS) for steps = 0;
# Err(_KM_NUM_ERR_ALLOC). `steps` is a usize: the caller keeps it in 1 ..= 10⁷ (hisab pre-allocates the path).
#must_use
fn _km_rk4_trajectory(f, ctx, t0: f64, y0, n, t_end: f64, steps, out, cap, fin): Result {
    if (steps == 0) { return Err(_KM_NUM_ERR_ZERO_STEPS); }
    var st: f64[96];
    var w = _km_num_table(&st, _KM_NUM_STACK, 7 * n);
    if (w == 0) { return Err(_KM_NUM_ERR_ALLOC); }
    var y = w;
    var k1 = w + 8 * n;
    var k2 = w + 16 * n;
    var k3 = w + 24 * n;
    var k4 = w + 32 * n;
    var tmp = w + 40 * n;
    var comp = w + 48 * n;
    _km_num_copy(y, y0, n);
    var span: f64 = t_end - t0;
    var ns: f64 = f64_from(steps);
    var h: f64 = span / ns;
    var t: f64 = t0;
    _km_num_point(out, cap, 0, t, y, n);
    var s = 0;
    while (s < steps) {
        _km_rk4_step(f, ctx, t, h, y, k1, k2, k3, k4, tmp, comp, n);
        t = t + h;
        s = s + 1;
        _km_num_point(out, cap, s, t, y, n);
    }
    if (fin != 0) { _km_num_copy(fin, y, n); }
    return Ok(steps + 1);
}

# ── Dormand–Prince 4(5) (num::dopri45) ───────────────────────────────────────────────

# hisab 1.4.0's `num::dopri45`: the adaptive Dormand–Prince RK4(5) from (t0, y0[0 .. n)) to t_end with error tolerance
# `tol` (component scale max(tol, tol·|y|), the RMS error norm) and first step h_init, at most 100 000 attempted steps;
# every accepted point, starting with (t0, y0), goes to `out` (the first cap of them). The Butcher tableau is Rust's
# const expressions (each a correctly rounded quotient of two integers, evaluated here the same way), the step factor
# 0.9·err^(−0.2) (5 for err = 0 or NaN) clamped to [0.2, 5], the step clamped so as not to pass t_end, the direction
# that of t_end − t0. Ok(point count, which may exceed cap); Err(_KM_NUM_ERR_INVALID_INPUT) for n = 0 or h_init ≤ 0
# (a NaN h_init passes, as in Rust, and min ignores it); Err(_KM_NUM_ERR_NO_CONVERGENCE) when |t − t_end| > h/100
# after the 100 000 steps; Err(_KM_NUM_ERR_ALLOC).
#must_use
fn _km_dopri45(f, ctx, t0: f64, y0, n, t_end: f64, tol: f64, h_init: f64, out, cap): Result {
    if (n == 0) { return Err(_KM_NUM_ERR_INVALID_INPUT); }
    if (h_init <= 0.0) { return Err(_KM_NUM_ERR_INVALID_INPUT); }
    var a21: f64 = 1.0 / 5.0;
    var a31: f64 = 3.0 / 40.0;
    var a32: f64 = 9.0 / 40.0;
    var a41: f64 = 44.0 / 45.0;
    var a42: f64 = -56.0 / 15.0;
    var a43: f64 = 32.0 / 9.0;
    var a51: f64 = 19372.0 / 6561.0;
    var a52: f64 = -25360.0 / 2187.0;
    var a53: f64 = 64448.0 / 6561.0;
    var a54: f64 = -212.0 / 729.0;
    var a61: f64 = 9017.0 / 3168.0;
    var a62: f64 = -355.0 / 33.0;
    var a63: f64 = 46732.0 / 5247.0;
    var a64: f64 = 49.0 / 176.0;
    var a65: f64 = -5103.0 / 18656.0;
    var b1: f64 = 35.0 / 384.0;
    var b3: f64 = 500.0 / 1113.0;
    var b4: f64 = 125.0 / 192.0;
    var b5: f64 = -2187.0 / 6784.0;
    var b6: f64 = 11.0 / 84.0;
    var e1: f64 = 71.0 / 57600.0;
    var e3: f64 = -71.0 / 16695.0;
    var e4: f64 = 71.0 / 1920.0;
    var e5: f64 = -17253.0 / 339200.0;
    var e6: f64 = 22.0 / 525.0;
    var e7: f64 = -1.0 / 40.0;
    var c2: f64 = 1.0 / 5.0;
    var c3: f64 = 3.0 / 10.0;
    var c4: f64 = 4.0 / 5.0;
    var c5: f64 = 8.0 / 9.0;
    var st: f64[96];
    if (n > 0x0010000000000000) { return Err(_KM_NUM_ERR_ALLOC); }
    var w = _km_num_table(&st, _KM_NUM_STACK, 9 * n);
    if (w == 0) { return Err(_KM_NUM_ERR_ALLOC); }
    var y = w;
    var k1 = w + 8 * n;
    var k2 = w + 16 * n;
    var k3 = w + 24 * n;
    var k4 = w + 32 * n;
    var k5 = w + 40 * n;
    var k6 = w + 48 * n;
    var k7 = w + 56 * n;
    var yt = w + 64 * n;
    var t: f64 = t0;
    _km_num_copy(y, y0, n);
    var span: f64 = t_end - t0;
    var aspan: f64 = f64_abs(span);
    var h: f64 = _km_min(h_init, aspan);
    var dir: f64 = -1.0;
    if (t_end >= t0) { dir = 1.0; }
    var nf: f64 = f64_from(n);
    var mexp: f64 = -0.2;
    _km_num_point(out, cap, 0, t, y, n);
    var count = 1;
    var it = 0;
    while (it < 100000) {
        var d0: f64 = t - t_end;
        var d1: f64 = d0 * dir;
        if (d1 >= 0.0) { break; }
        var dh: f64 = dir * h;
        var tn: f64 = t + dh;
        var ov: f64 = tn - t_end;
        ov = ov * dir;
        if (ov > 0.0) {
            var rem: f64 = t_end - t;
            h = f64_abs(rem);
        }
        var hd: f64 = dir * h;
        # Stage 1
        callptr(f, ctx, t, y, k1, n);
        # Stage 2
        var q21: f64 = hd * a21;
        var i = 0;
        while (i < n) {
            var yv: f64 = load64(y + 8 * i);
            var x1: f64 = load64(k1 + 8 * i);
            var s21: f64 = q21 * x1;
            var v2: f64 = yv + s21;
            store64(yt + 8 * i, v2);
            i = i + 1;
        }
        var tc2: f64 = hd * c2;
        tc2 = t + tc2;
        callptr(f, ctx, tc2, yt, k2, n);
        # Stage 3
        i = 0;
        while (i < n) {
            var yv3: f64 = load64(y + 8 * i);
            var p1: f64 = load64(k1 + 8 * i);
            var p2: f64 = load64(k2 + 8 * i);
            var u1: f64 = a31 * p1;
            var u2: f64 = a32 * p2;
            var s3: f64 = u1 + u2;
            s3 = hd * s3;
            var v3: f64 = yv3 + s3;
            store64(yt + 8 * i, v3);
            i = i + 1;
        }
        var tc3: f64 = hd * c3;
        tc3 = t + tc3;
        callptr(f, ctx, tc3, yt, k3, n);
        # Stage 4
        i = 0;
        while (i < n) {
            var yv4: f64 = load64(y + 8 * i);
            var q1: f64 = load64(k1 + 8 * i);
            var q2: f64 = load64(k2 + 8 * i);
            var q3: f64 = load64(k3 + 8 * i);
            var w1: f64 = a41 * q1;
            var w2: f64 = a42 * q2;
            var w3: f64 = a43 * q3;
            var s4: f64 = w1 + w2;
            s4 = s4 + w3;
            s4 = hd * s4;
            var v4: f64 = yv4 + s4;
            store64(yt + 8 * i, v4);
            i = i + 1;
        }
        var tc4: f64 = hd * c4;
        tc4 = t + tc4;
        callptr(f, ctx, tc4, yt, k4, n);
        # Stage 5
        i = 0;
        while (i < n) {
            var yv5: f64 = load64(y + 8 * i);
            var r1: f64 = load64(k1 + 8 * i);
            var r2: f64 = load64(k2 + 8 * i);
            var r3: f64 = load64(k3 + 8 * i);
            var r4: f64 = load64(k4 + 8 * i);
            var z1: f64 = a51 * r1;
            var z2: f64 = a52 * r2;
            var z3: f64 = a53 * r3;
            var z4: f64 = a54 * r4;
            var s5: f64 = z1 + z2;
            s5 = s5 + z3;
            s5 = s5 + z4;
            s5 = hd * s5;
            var v5: f64 = yv5 + s5;
            store64(yt + 8 * i, v5);
            i = i + 1;
        }
        var tc5: f64 = hd * c5;
        tc5 = t + tc5;
        callptr(f, ctx, tc5, yt, k5, n);
        # Stage 6
        i = 0;
        while (i < n) {
            var yv6: f64 = load64(y + 8 * i);
            var m1: f64 = load64(k1 + 8 * i);
            var m2: f64 = load64(k2 + 8 * i);
            var m3: f64 = load64(k3 + 8 * i);
            var m4: f64 = load64(k4 + 8 * i);
            var m5: f64 = load64(k5 + 8 * i);
            var g1: f64 = a61 * m1;
            var g2: f64 = a62 * m2;
            var g3: f64 = a63 * m3;
            var g4: f64 = a64 * m4;
            var g5: f64 = a65 * m5;
            var s6: f64 = g1 + g2;
            s6 = s6 + g3;
            s6 = s6 + g4;
            s6 = s6 + g5;
            s6 = hd * s6;
            var v6: f64 = yv6 + s6;
            store64(yt + 8 * i, v6);
            i = i + 1;
        }
        var tc6: f64 = t + hd;
        callptr(f, ctx, tc6, yt, k6, n);
        # The 5th-order solution
        i = 0;
        while (i < n) {
            var yv7: f64 = load64(y + 8 * i);
            var n1: f64 = load64(k1 + 8 * i);
            var n3: f64 = load64(k3 + 8 * i);
            var n4: f64 = load64(k4 + 8 * i);
            var n5: f64 = load64(k5 + 8 * i);
            var n6: f64 = load64(k6 + 8 * i);
            var h1: f64 = b1 * n1;
            var h3: f64 = b3 * n3;
            var h4: f64 = b4 * n4;
            var h5: f64 = b5 * n5;
            var h6: f64 = b6 * n6;
            var s7: f64 = h1 + h3;
            s7 = s7 + h4;
            s7 = s7 + h5;
            s7 = s7 + h6;
            s7 = hd * s7;
            var v7: f64 = yv7 + s7;
            store64(yt + 8 * i, v7);
            i = i + 1;
        }
        # Stage 7 (for the error estimate)
        callptr(f, ctx, tc6, yt, k7, n);
        # The error estimate
        var err: f64 = 0.0;
        i = 0;
        while (i < n) {
            var o1: f64 = load64(k1 + 8 * i);
            var o3: f64 = load64(k3 + 8 * i);
            var o4: f64 = load64(k4 + 8 * i);
            var o5: f64 = load64(k5 + 8 * i);
            var o6: f64 = load64(k6 + 8 * i);
            var o7: f64 = load64(k7 + 8 * i);
            var j1: f64 = e1 * o1;
            var j3: f64 = e3 * o3;
            var j4: f64 = e4 * o4;
            var j5: f64 = e5 * o5;
            var j6: f64 = e6 * o6;
            var j7: f64 = e7 * o7;
            var se: f64 = j1 + j3;
            se = se + j4;
            se = se + j5;
            se = se + j6;
            se = se + j7;
            var ei: f64 = hd * se;
            var yti: f64 = load64(yt + 8 * i);
            var ay: f64 = f64_abs(yti);
            var ty: f64 = tol * ay;
            var scale: f64 = _km_max(tol, ty);
            var qa: f64 = ei / scale;
            var qb: f64 = ei / scale;
            var sq: f64 = qa * qb;
            err = err + sq;
            i = i + 1;
        }
        var en: f64 = err / nf;
        err = f64_sqrt(en);
        if (err <= 1.0) {
            # Accept the step
            t = t + hd;
            _km_num_copy(y, yt, n);
            _km_num_point(out, cap, count, t, y, n);
            count = count + 1;
        }
        # Adapt the step size
        var factor: f64 = 5.0;
        if (err > 0.0) {
            var pw: f64 = _km_cr_pow(err, mexp);
            factor = 0.9 * pw;
        }
        if (factor < 0.2) { factor = 0.2; }
        if (factor > 5.0) { factor = 5.0; }
        h = h * factor;
        it = it + 1;
    }
    var gap: f64 = t - t_end;
    gap = f64_abs(gap);
    var lim: f64 = h * 0.01;
    if (gap > lim) { return Err(_KM_NUM_ERR_NO_CONVERGENCE); }
    return Ok(count);
}

# ── dense solve (num::gaussian_elimination) ──────────────────────────────────────────

# hisab 1.4.0's `num::gaussian_elimination` with partial pivoting: solves A·x = b for the augmented n × (n + 1) matrix
# [A | b] at `m` (row-major f64, entry (i, j) at m + 8·(i·(n + 1) + j)), modified in place: per column the first row
# of largest |entry| at or below the diagonal (a strictly larger one replaces it, so NaN never does), Err when that
# magnitude is below hisab's EPSILON_F64 (10⁻¹²; a NaN one passes), the rows swapped whole, the rows below reduced by
# m[r][j] −= (m[r][col]/pivot)·m[col][j] for j = col ..= n; then back substitution, the sum from b down the row. x
# (n f64) goes to `x`. Ok(n); Err(_KM_NUM_ERR_INVALID_INPUT) for n = 0 (Rust's ragged-row check has no flat
# counterpart: the buffer is n × (n + 1) by construction); Err(_KM_NUM_ERR_SINGULAR_PIVOT).
#must_use
fn _km_gaussian_elimination(m, n, x): Result {
    if (n == 0) { return Err(_KM_NUM_ERR_INVALID_INPUT); }
    var eps: f64 = EPSILON_F64;
    var w8 = 8 * (n + 1);                   # a row's bytes
    var col = 0;
    while (col < n) {
        var pc = m + col * w8;              # row col
        var max_row = col;
        var c0: f64 = load64(pc + 8 * col);
        var max_val: f64 = f64_abs(c0);
        var row = col + 1;
        while (row < n) {
            var cr: f64 = load64(m + row * w8 + 8 * col);
            var val: f64 = f64_abs(cr);
            if (val > max_val) {
                max_val = val;
                max_row = row;
            }
            row = row + 1;
        }
        if (max_val < eps) { return Err(_KM_NUM_ERR_SINGULAR_PIVOT); }
        if (max_row != col) {
            var pm = m + max_row * w8;
            var j = 0;
            while (j < w8) {
                var sa = load64(pc + j);
                store64(pc + j, load64(pm + j));
                store64(pm + j, sa);
                j = j + 8;
            }
        }
        var pivot: f64 = load64(pc + 8 * col);
        row = col + 1;
        while (row < n) {
            var pr = m + row * w8;
            var rc: f64 = load64(pr + 8 * col);
            var factor: f64 = rc / pivot;
            var jj = 8 * col;
            while (jj < w8) {
                var val2: f64 = load64(pc + jj);
                var cur: f64 = load64(pr + jj);
                var fv: f64 = factor * val2;
                var nv: f64 = cur - fv;
                store64(pr + jj, nv);
                jj = jj + 8;
            }
            row = row + 1;
        }
        col = col + 1;
    }
    var k = 0;
    while (k < n) {
        store64(x + 8 * k, 0);
        k = k + 1;
    }
    var i = n - 1;
    while (i >= 0) {
        var pi = m + i * w8;
        var sum: f64 = load64(pi + 8 * n);
        var j2 = i + 1;
        while (j2 < n) {
            var aij: f64 = load64(pi + 8 * j2);
            var xj: f64 = load64(x + 8 * j2);
            var px: f64 = aij * xj;
            sum = sum - px;
            j2 = j2 + 1;
        }
        var aii: f64 = load64(pi + 8 * i);
        var xi: f64 = sum / aii;
        store64(x + 8 * i, xi);
        i = i - 1;
    }
    return Ok(n);
}

# ── PCG32 draws and Euler–Maruyama (num::Pcg32, num::euler_maruyama) ─────────────────

# hisab 1.4.0's `Pcg32::next_f64`: the next u32 (hisab 3.4.1's pcg32_next) over u32::MAX + 1 = 2³², exact.
#must_use
fn _km_pcg32_next_f64(rng): f64 {
    var u = pcg32_next(rng);
    var fu: f64 = f64_from(u);
    var d: f64 = 4294967295.0 + 1.0;
    var r: f64 = fu / d;
    return r;
}

# hisab 1.4.0's `Pcg32::next_normal`, the Box–Muller transform: u1 = max(next_f64, 10⁻³⁰⁰), u2 = next_f64, then
# √(−2·ln u1)·cos(τ·u2), with the correctly rounded ln and cos (the oracle's glibc log and cos, ADR 0006).
#must_use
fn _km_pcg32_next_normal(rng): f64 {
    var tiny: f64 = 0x01A56E1FC2F8F359;     # 1e-300
    var tau: f64 = 0x401921FB54442D18;      # std::f64::consts::TAU
    var r1: f64 = _km_pcg32_next_f64(rng);
    var u1: f64 = _km_max(r1, tiny);
    var u2: f64 = _km_pcg32_next_f64(rng);
    var l: f64 = _km_cr_ln(u1);
    var m2: f64 = -2.0 * l;
    var r: f64 = f64_sqrt(m2);
    var ang: f64 = tau * u2;
    var c: f64 = _km_cr_cos(ang);
    var z: f64 = r * c;
    return z;
}

# hisab 1.4.0's `num::euler_maruyama`: dX = drift(t, X)·dt + diffusion(t, X)·dW from (t0, y0[0 .. n)) to t_end in
# `steps` steps of dt = (t_end − t0)/steps (t advanced by `t += dt`), with drift(dctx, t, y, a, n) and the diffusion
# diff(gctx, t, y, b, n) evaluated at the start of each step and one draw dW = next_normal·√dt per component,
# in order, from `rng` (a hisab 3.4.1 pcg32 handle); y[i] += a[i]·dt + b[i]·dW. The steps + 1 points go to `out`
# (the first cap of them), the final state to `fin` (if not 0). Ok(steps + 1); Err(_KM_NUM_ERR_ZERO_STEPS) for
# steps = 0; Err(_KM_NUM_ERR_ALLOC). `steps` as for _km_rk4_trajectory.
#must_use
fn _km_euler_maruyama_system(drift, dctx, diff, gctx, t0: f64, y0, n, t_end: f64, steps, rng, out, cap, fin): Result {
    if (steps == 0) { return Err(_KM_NUM_ERR_ZERO_STEPS); }
    var st: f64[96];
    var w = _km_num_table(&st, _KM_NUM_STACK, 3 * n);
    if (w == 0) { return Err(_KM_NUM_ERR_ALLOC); }
    var y = w;
    var a = w + 8 * n;
    var b = w + 16 * n;
    var span: f64 = t_end - t0;
    var ns: f64 = f64_from(steps);
    var dt: f64 = span / ns;
    var sqrt_dt: f64 = f64_sqrt(dt);
    _km_num_copy(y, y0, n);
    var t: f64 = t0;
    _km_num_point(out, cap, 0, t, y, n);
    var s = 0;
    while (s < steps) {
        callptr(drift, dctx, t, y, a, n);
        callptr(diff, gctx, t, y, b, n);
        var i = 0;
        while (i < n) {
            var z: f64 = _km_pcg32_next_normal(rng);
            var dw: f64 = z * sqrt_dt;
            var ai: f64 = load64(a + 8 * i);
            var bi: f64 = load64(b + 8 * i);
            var p: f64 = ai * dt;
            var q: f64 = bi * dw;
            var inc: f64 = p + q;
            var yi: f64 = load64(y + 8 * i);
            var yn: f64 = yi + inc;
            store64(y + 8 * i, yn);
            i = i + 1;
        }
        t = t + dt;
        s = s + 1;
        _km_num_point(out, cap, s, t, y, n);
    }
    if (fin != 0) { _km_num_copy(fin, y, n); }
    return Ok(steps + 1);
}

# ── polynomial least squares (num::least_squares_poly) ───────────────────────────────

# hisab 1.4.0's `num::least_squares_poly`: the degree-`degree` polynomial a0 + a1·x + … fitting the m points (x[k],
# y[k]) in least squares. Its Vandermonde columns x^j (`f64::powi`, `_km_powi`) are decomposed by `qr_decompose`'s
# modified Gram–Schmidt — for each column j, against each earlier unit column i: the dot product (Rust's `.sum()`,
# folded from −0.0) to R, the projection subtracted; then the norm √Σ (from −0.0) to R's diagonal, Err below
# EPSILON_F64 (10⁻¹²; a NaN norm passes), the column divided by it — then Qᵀy, and back substitution from the
# last coefficient, each sum from Qᵀy down the row. The n = degree + 1 coefficients go to `out`. Ok(n);
# Err(_KM_NUM_ERR_INVALID_INPUT) for m = 0, fewer than n points or a degree past usize::MAX − 1 (as an unsigned
# word), or the dependent-columns case; Err(_KM_NUM_ERR_ALLOC). Work: Q (n·m f64) and R (n·n), on the stack up to
# _KM_NUM_LS_STACK words.
const _KM_NUM_LS_STACK = 384;
#must_use
fn _km_least_squares_poly(x, y, m, degree, out): Result {
    if (m == 0) { return Err(_KM_NUM_ERR_INVALID_INPUT); }
    if (degree < 0 || degree >= m) { return Err(_KM_NUM_ERR_INVALID_INPUT); }
    var n = degree + 1;
    var st: f64[384];
    var w = _km_num_table(&st, _KM_NUM_LS_STACK, n * m + n * n);
    if (w == 0) { return Err(_KM_NUM_ERR_ALLOC); }
    var q = w;                              # column j at q + 8·j·m (column-major, as Rust's Vec<Vec<f64>> of columns)
    var r = w + 8 * n * m;                  # R[i][j] stored as r[j][i], at r + 8·(j·n + i)
    var j = 0;
    while (j < n) {
        var k = 0;
        while (k < m) {
            var xk: f64 = load64(x + 8 * k);
            var pw: f64 = _km_powi(xk, j);
            store64(q + 8 * (j * m + k), pw);
            k = k + 1;
        }
        j = j + 1;
    }
    var eps: f64 = EPSILON_F64;
    j = 0;
    while (j < n) {
        var qj = q + 8 * j * m;
        var i = 0;
        while (i < j) {
            var qi = q + 8 * i * m;
            var dot: f64 = -0.0;
            var k2 = 0;
            while (k2 < m) {
                var a: f64 = load64(qi + 8 * k2);
                var b: f64 = load64(qj + 8 * k2);
                var p: f64 = a * b;
                dot = dot + p;
                k2 = k2 + 1;
            }
            store64(r + 8 * (j * n + i), dot);
            k2 = 0;
            while (k2 < m) {
                var c: f64 = load64(qj + 8 * k2);
                var d: f64 = load64(qi + 8 * k2);
                var pd: f64 = dot * d;
                var nc: f64 = c - pd;
                store64(qj + 8 * k2, nc);
                k2 = k2 + 1;
            }
            i = i + 1;
        }
        var ss: f64 = -0.0;
        var k3 = 0;
        while (k3 < m) {
            var e: f64 = load64(qj + 8 * k3);
            var e2: f64 = e * e;
            ss = ss + e2;
            k3 = k3 + 1;
        }
        var norm: f64 = f64_sqrt(ss);
        if (norm < eps) { return Err(_KM_NUM_ERR_INVALID_INPUT); }
        store64(r + 8 * (j * n + j), norm);
        k3 = 0;
        while (k3 < m) {
            var g: f64 = load64(qj + 8 * k3);
            var gn: f64 = g / norm;
            store64(qj + 8 * k3, gn);
            k3 = k3 + 1;
        }
        j = j + 1;
    }
    # Qᵀy into out (each coefficient's slot), then back substitution in place: out[i] is read as Qᵀy[i] before it is
    # overwritten, and only the coefficients above i are read from it.
    j = 0;
    while (j < n) {
        var qj2 = q + 8 * j * m;
        var t: f64 = -0.0;
        var k4 = 0;
        while (k4 < m) {
            var qv: f64 = load64(qj2 + 8 * k4);
            var yv: f64 = load64(y + 8 * k4);
            var py: f64 = qv * yv;
            t = t + py;
            k4 = k4 + 1;
        }
        store64(out + 8 * j, t);
        j = j + 1;
    }
    var i2 = n - 1;
    while (i2 >= 0) {
        var sum: f64 = load64(out + 8 * i2);
        var j2 = i2 + 1;
        while (j2 < n) {
            var rv: f64 = load64(r + 8 * (j2 * n + i2));
            var cv: f64 = load64(out + 8 * j2);
            var pr: f64 = rv * cv;
            sum = sum - pr;
            j2 = j2 + 1;
        }
        var diag: f64 = load64(r + 8 * (i2 * n + i2));
        var co: f64 = sum / diag;
        store64(out + 8 * i2, co);
        i2 = i2 - 1;
    }
    return Ok(n);
}

# ── the rank by one-sided Jacobi SVD (num::matrix_rank, num::svd) ────────────────────

# hisab 1.4.0's `num::matrix_rank(a, Some(tol))` of the m × n row-major matrix at `a`: the number of singular values
# above `tol` from `num::svd`. `svd` works on Aᵀ when m < n; `svd_tall` then rotates the vectors b — A's columns (m
# ≥ n) or rows (m < n), w vectors of length l — in one-sided Jacobi sweeps: for each pair p < q the sums app, aqq,
# apq (from +0.0, in one pass), skipped when |apq| ≤ EPSILON_F64²·√(app·aqq), else the rotation with τ = (aqq
# − app)/(2·apq), t = 1/(τ + √(1 + τ²)) (or −1/(−τ + √(1 + τ²)) for τ < 0 or NaN), c = 1/√(1 +
# t²), s = t·c, (b_p, b_q) ← (c·b_p − s·b_q, s·b_p + c·b_q); a sweep with no rotation ends the loop, and
# 100·max(m, n) sweeps without one are Err(NoConvergence). Each singular value is its vector's norm √Σ b² (from
# −0.0); 1.4.0's V, U, its basis extension and its descending sort feed nothing the count reads, so they are left
# out. The test 10⁻²⁴·√(app·aqq) lies below the rounding of a rotated pair's dot product, so many matrices
# never pass it (port plan §6.4, M5b): that is the oracle's NoConvergence, reproduced. Ok(rank);
# Err(_KM_NUM_ERR_INVALID_INPUT) for m = 0 or n = 0; Err(_KM_NUM_ERR_NO_CONVERGENCE); Err(_KM_NUM_ERR_ALLOC). The
# vectors: on the stack up to _KM_NUM_SVD_STACK words.
const _KM_NUM_SVD_STACK = 256;
#must_use
fn _km_matrix_rank(a, m, n, tol: f64): Result {
    if (m == 0 || n == 0) { return Err(_KM_NUM_ERR_INVALID_INPUT); }
    var w = n;                              # the vectors b_0 … b_{w−1}, each of length l
    var l = m;
    if (m < n) {
        w = m;
        l = n;
    }
    var st: f64[256];
    var b = _km_num_table(&st, _KM_NUM_SVD_STACK, w * l);
    if (b == 0) { return Err(_KM_NUM_ERR_ALLOC); }
    var i = 0;
    while (i < m) {
        var j = 0;
        while (j < n) {
            var v = load64(a + 8 * (i * n + j));
            if (m < n) { store64(b + 8 * (i * l + j), v); } else { store64(b + 8 * (j * l + i), v); }
            j = j + 1;
        }
        i = i + 1;
    }
    var e: f64 = EPSILON_F64;
    var tol2: f64 = e * e;
    var max_sweeps = 100 * l;
    var one: f64 = 1.0;
    var sweep = 0;
    while (sweep < max_sweeps) {
        var converged = 1;
        var p = 0;
        while (p < w) {
            var bp = b + 8 * p * l;
            var q = p + 1;
            while (q < w) {
                var bq = b + 8 * q * l;
                var app: f64 = 0.0;
                var aqq: f64 = 0.0;
                var apq: f64 = 0.0;
                var k = 0;
                while (k < l) {
                    var x: f64 = load64(bp + 8 * k);
                    var y: f64 = load64(bq + 8 * k);
                    var xx: f64 = x * x;
                    var yy: f64 = y * y;
                    var xy: f64 = x * y;
                    app = app + xx;
                    aqq = aqq + yy;
                    apq = apq + xy;
                    k = k + 1;
                }
                var pp: f64 = app * aqq;
                var sq: f64 = f64_sqrt(pp);
                var lim: f64 = tol2 * sq;
                var aa: f64 = f64_abs(apq);
                if (aa <= lim) {
                    q = q + 1;
                    continue;
                }
                converged = 0;
                var dif: f64 = aqq - app;
                var den: f64 = 2.0 * apq;
                var tau: f64 = dif / den;
                var tt: f64 = tau * tau;
                var u: f64 = one + tt;
                var su: f64 = f64_sqrt(u);
                var t: f64 = 0.0;
                if (tau >= 0.0) {
                    var d1: f64 = tau + su;
                    t = one / d1;
                } else {
                    var mt: f64 = -tau;
                    var d2: f64 = mt + su;
                    var mone: f64 = -1.0;
                    t = mone / d2;
                }
                var t2: f64 = t * t;
                var u2: f64 = one + t2;
                var s2: f64 = f64_sqrt(u2);
                var c: f64 = one / s2;
                var s: f64 = t * c;
                k = 0;
                while (k < l) {
                    var vp: f64 = load64(bp + 8 * k);
                    var vq: f64 = load64(bq + 8 * k);
                    var cp: f64 = c * vp;
                    var sq2: f64 = s * vq;
                    var np: f64 = cp - sq2;
                    var sp: f64 = s * vp;
                    var cq: f64 = c * vq;
                    var nq: f64 = sp + cq;
                    store64(bp + 8 * k, np);
                    store64(bq + 8 * k, nq);
                    k = k + 1;
                }
                q = q + 1;
            }
            p = p + 1;
        }
        if (converged == 1) { break; }
        if (sweep == max_sweeps - 1) { return Err(_KM_NUM_ERR_NO_CONVERGENCE); }
        sweep = sweep + 1;
    }
    var rank = 0;
    var j2 = 0;
    while (j2 < w) {
        var bj = b + 8 * j2 * l;
        var ss: f64 = -0.0;
        var k5 = 0;
        while (k5 < l) {
            var z: f64 = load64(bj + 8 * k5);
            var zz: f64 = z * z;
            ss = ss + zz;
            k5 = k5 + 1;
        }
        var sigma: f64 = f64_sqrt(ss);
        if (sigma > tol) { rank = rank + 1; }
        j2 = j2 + 1;
    }
    return Ok(rank);
}

# ── CSR (hisab 1.4.0's CsrMatrix::from_dense) ────────────────────────────────────────

# hisab 1.4.0's `CsrMatrix::from_dense` of the m × n row-major matrix at `a`, as a hisab 3.4.1 CSR handle (csr_new):
# the entries with |v| > EPSILON_F64 (10⁻¹²: never a zero or a NaN), row by row, their column indices, and the m + 1
# row offsets. hisab 3.4.1's csr_from_dense keeps every nonzero entry (a structural test since its 2.15.0), so it would
# store 10⁻¹³ and NaN where 1.4.0 drops them. The three arrays and the header come from the bump allocator (never
# freed); an empty matrix's two data arrays are 0, as csr_from_dense's. The handle, or 0 when an allocation fails.
#must_use
fn _km_csr_from_dense(a, m, n): i64 {
    var eps: f64 = EPSILON_F64;
    var count = 0;
    var k = 0;
    while (k < m * n) {
        var v: f64 = load64(a + 8 * k);
        var av: f64 = f64_abs(v);
        if (av > eps) { count = count + 1; }
        k = k + 1;
    }
    var row_ptr = alloc(8 * (m + 1));
    var col_idx = 0;
    var values = 0;
    if (count > 0) {
        col_idx = alloc(8 * count);
        values = alloc(8 * count);
    }
    if (row_ptr == 0 || (count > 0 && (col_idx == 0 || values == 0))) { return 0; }
    store64(row_ptr, 0);
    var pos = 0;
    var i = 0;
    while (i < m) {
        var j = 0;
        while (j < n) {
            var x: f64 = load64(a + 8 * (i * n + j));
            var ax: f64 = f64_abs(x);
            if (ax > eps) {
                store64(col_idx + 8 * pos, j);
                store64(values + 8 * pos, x);
                pos = pos + 1;
            }
            j = j + 1;
        }
        store64(row_ptr + 8 * (i + 1), pos);
        i = i + 1;
    }
    return csr_new(m, n, count, row_ptr, col_idx, values);
}
