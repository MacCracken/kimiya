# mathx.cyr — kimiya's private floating-point helpers (port plan §6.1, §6.4).
#
# Each helper reproduces what the Rust oracle (rust-old/, rustc 1.99.1) computes where no Cyrius
# builtin or ganita function has Rust's semantics (probed in M0, docs/development/port-parity.md §1):
# - min / max: Rust ignores a NaN operand on either side, and on (+0, −0) returns the second
#   operand (maxsd / minsd); f64_min / f64_max return a NaN second operand;
# - signum: Rust gives ±1.0 for ±0 and NaN for NaN; f64_sign gives 0.0 for all three;
# - round: Rust rounds halves away from zero; f64_round rounds them to even;
# - powi, total_cmp, is_finite, log10, exp_m1: no stdlib function.
# min, max, signum, round, total_cmp and is_finite are exact (class A); powi is the
# compiler-builtins square-and-multiply loop, so it is bit-identical (class B, 0 ulp expected).
#
# log10 and exp_m1 call glibc in the oracle. glibc's code is not portable to transcribe, so
# _km_log10 and _km_expm1 transcribe Rust `libm` 0.2.16 (src/math/{log10,expm1}.rs, which are
# FreeBSD msun / fdlibm, documented < 1 ulp) operation for operation: the same bits on every
# target, within 2 ulp of glibc (class C, K = 2; port-parity.md). The coefficients are the
# Rust source's decimal literals as bit patterns in typed f64 locals (never a hex `const`).
# lib/math.cyr is included for f64_cos, the out-of-domain fallback of _km_cos (M2a).

include "lib/math.cyr"

# +∞ (0x7FF0000000000000), a compile-time constant.
const _KM_INF = 1.0 / 0.0;

# The quiet NaN Rust's f64::NAN is (0x7FF8000000000000). The parity rules match any NaN.
#must_use
fn _km_nan(): f64 {
    var n: f64 = 0x7FF8000000000000;
    return n;
}

# The bit pattern of an f64, as an integer. The untyped parameter carries the word, and the
# `: i64` return types the caller's binding as an integer: a bare `var u = x;` copy of an f64
# is f64-typed, so its `<` would be a float compare.
#must_use
fn _km_bits(x): i64 { return x; }

# 1 if x is NaN.
#must_use
fn _km_is_nan(x: f64): i64 {
    if (x != x) { return 1; }
    return 0;
}

# 1 if x is finite: neither ±∞ nor NaN (x − x is 0 exactly for finite x, NaN otherwise; one
# subtract and compare, no call: the M2a guards make several per function). Mirrors
# `f64::is_finite`.
#must_use
fn _km_is_finite(x: f64): i64 {
    var d: f64 = x - x;
    if (d == 0.0) { return 1; }
    return 0;
}

# The larger of x and y, ignoring a NaN operand (NaN only when both are). Equal operands,
# +0 and −0 included, give y: what rustc 1.99.1's `x.max(y)` returns (maxsd). Mirrors `f64::max`.
#must_use
fn _km_max(x: f64, y: f64): f64 {
    if (x != x) { return y; }
    if (y != y) { return x; }
    if (x > y) { return x; }
    return y;
}

# The smaller of x and y, ignoring a NaN operand (NaN only when both are). Equal operands,
# +0 and −0 included, give y (minsd). Mirrors `f64::min`.
#must_use
fn _km_min(x: f64, y: f64): f64 {
    if (x != x) { return y; }
    if (y != y) { return x; }
    if (x < y) { return x; }
    return y;
}

# 1.0 for +0 and positive x, −1.0 for −0 and negative x (the sign bit), NaN for NaN.
# Mirrors `f64::signum`.
#must_use
fn _km_signum(x: f64): f64 {
    if (x != x) { return x; }
    if (_km_bits(x) < 0) { return -1.0; }
    return 1.0;
}

# round(x), halves away from zero, as Rust's (compiler-builtins libm generic round):
# trunc(x + copysign(0.5 − 0.25·ε, x)), where 0.5 − 0.25·ε is 0x3FDFFFFFFFFFFFFF, the double
# just below ½. Mirrors `f64::round`.
#must_use
fn _km_round_half_away(x: f64): f64 {
    var h: f64 = 0.49999999999999994;
    if (_km_bits(x) < 0) { h = -h; }
    var r: f64 = f64_trunc(x + h);
    return r;
}

# x^n by compiler-builtins' `__powidf2` (float/pow.rs), the loop Rust's `f64::powi` calls:
# square-and-multiply over the bits of |n|, low bit first, then 1/r for a negative n. Rust's n
# is an i32; |n| is taken as an unsigned word here, so i64::MIN is 2^63 as abs_diff gives.
# Mirrors `f64::powi`.
#must_use
fn _km_powi(a: f64, n): f64 {
    var base: f64 = a;
    var p = n;
    var recip = 0;
    if (n < 0) { recip = 1; p = 0 - n; }
    var mul: f64 = 1.0;
    while (1) {
        if ((p & 1) != 0) { mul = mul * base; }
        p = p >> 1;
        if (p == 0) { break; }
        base = base * base;
    }
    if (recip == 1) {
        var r: f64 = 1.0 / mul;
        return r;
    }
    return mul;
}

# IEEE 754 totalOrder of x and y as -1 / 0 / 1: −NaN < −∞ < … < −0 < +0 < … < +∞ < +NaN, NaNs
# ordered by payload. Rust flips the magnitude bits of a negative pattern and compares the words
# as i64 (`>>>` is the arithmetic shift, `>>` the logical one). Mirrors `f64::total_cmp`.
#must_use
fn _km_total_cmp(x: f64, y: f64): i64 {
    var a = _km_bits(x);
    var b = _km_bits(y);
    a = a ^ ((a >>> 63) >> 1);
    b = b ^ ((b >>> 63) >> 1);
    if (a < b) { return 0 - 1; }
    if (a > b) { return 1; }
    return 0;
}

# log10(x), Rust libm 0.2.16 (FreeBSD e_log10.c): x = 2^k (1 + f) with √2/2 ≤ 1 + f < √2,
# log(1 + f) from s = f/(2 + f) and the Remez polynomial of log.c, then
# log10(x) = (f − f²/2 + r)/ln 10 + k·log10(2), combined in extra precision.
#must_use
fn _km_log10(xa: f64): f64 {
    var x: f64 = xa;
    var ivln10hi: f64 = 0x3FDBCB7B15200000;
    var ivln10lo: f64 = 0x3DBB9438CA9AADD5;
    var log10_2hi: f64 = 0x3FD34413509F6000;
    var log10_2lo: f64 = 0x3D59FEF311F12B36;
    var lg1: f64 = 0x3FE5555555555593;
    var lg2: f64 = 0x3FD999999997FA04;
    var lg3: f64 = 0x3FD2492494229359;
    var lg4: f64 = 0x3FCC71C51D8E78AF;
    var lg5: f64 = 0x3FC7466496CB03DE;
    var lg6: f64 = 0x3FC39A09D078C69F;
    var lg7: f64 = 0x3FC2F112DF3E5244;
    var ui = _km_bits(x);
    var hx = (ui >> 32) & 0xFFFFFFFF;
    var k = 0;
    if (hx < 0x00100000 || (hx >> 31) != 0) {
        if ((ui << 1) == 0) {
            var m1: f64 = -1.0;
            var ninf: f64 = m1 / (x * x);   # log(±0) = −∞
            return ninf;
        }
        if ((hx >> 31) != 0) {
            var nan: f64 = (x - x) / 0.0;   # log(negative) = NaN
            return nan;
        }
        k = 0 - 54;                         # subnormal: scale by 2^54
        var p54: f64 = 0x4350000000000000;
        x = x * p54;
        ui = _km_bits(x);
        hx = (ui >> 32) & 0xFFFFFFFF;
    } elif (hx >= 0x7FF00000) {
        return x;
    } elif (hx == 0x3FF00000 && (ui << 32) == 0) {
        return 0.0;
    }
    # Reduce x into [√2/2, √2].
    hx = hx + (0x3FF00000 - 0x3FE6A09E);
    k = k + ((hx >> 20) - 0x3FF);
    hx = (hx & 0x000FFFFF) + 0x3FE6A09E;
    var mb = (hx << 32) | (ui & 0xFFFFFFFF);
    var m: f64 = mb;
    var f: f64 = m - 1.0;
    var hfsq: f64 = (0.5 * f) * f;
    var s: f64 = f / (2.0 + f);
    var z: f64 = s * s;
    var w: f64 = z * z;
    var t1: f64 = w * (lg2 + (w * (lg4 + (w * lg6))));
    var t2: f64 = z * (lg1 + (w * (lg3 + (w * (lg5 + (w * lg7))))));
    var r: f64 = t2 + t1;
    # hi + lo = f − hfsq + s·(hfsq + r) ≈ log(1 + f), hi with its low word cleared.
    var hd: f64 = f - hfsq;
    var hb = _km_bits(hd) & 0xFFFFFFFF00000000;
    var hi: f64 = hb;
    var lo: f64 = ((f - hi) - hfsq) + (s * (hfsq + r));
    # val_hi + val_lo ≈ log10(1 + f) + k·log10(2).
    var val_hi: f64 = hi * ivln10hi;
    var dk: f64 = f64_from(k);
    var y: f64 = dk * log10_2hi;
    var val_lo: f64 = ((dk * log10_2lo) + ((lo + hi) * ivln10lo)) + (lo * ivln10hi);
    var w2: f64 = y + val_hi;
    val_lo = val_lo + ((y - w2) + val_hi);
    val_hi = w2;
    var out: f64 = val_lo + val_hi;
    return out;
}

# exp(x) − 1, Rust libm 0.2.16 (FreeBSD s_expm1.c): x = k·ln2 + r with |r| ≤ ln2/2 (hi − lo
# in extra precision, c the correction), expm1(r) from a rational approximation in r²/2, then
# rescaled by 2^k. Accurate where exp(x) − 1 would cancel. Mirrors `f64::exp_m1`.
#must_use
fn _km_expm1(xa: f64): f64 {
    var x: f64 = xa;
    var o_threshold: f64 = 0x40862E42FEFA39EF;
    var ln2_hi: f64 = 0x3FE62E42FEE00000;
    var ln2_lo: f64 = 0x3DEA39EF35793C76;
    var invln2: f64 = 0x3FF71547652B82FE;
    var q1: f64 = 0xBFA11111111110F4;
    var q2: f64 = 0x3F5A01A019FE5585;
    var q3: f64 = 0xBF14CE199EAADBB7;
    var q4: f64 = 0x3ED0CFCA86E65239;
    var q5: f64 = 0xBE8AFDB76E09C32D;
    var ui = _km_bits(x);
    var hx = (ui >> 32) & 0x7FFFFFFF;
    var sign = (ui >> 63) & 1;
    # Huge and non-finite arguments.
    if (hx >= 0x4043687A) {                 # |x| ≥ 56·ln2
        if (x != x) { return x; }
        if (sign != 0) { return -1.0; }
        if (x > o_threshold) {
            var huge: f64 = 0x7FE0000000000000;
            var over: f64 = x * huge;
            return over;
        }
    }
    # Argument reduction.
    var hi: f64 = 0.0;
    var lo: f64 = 0.0;
    var c: f64 = 0.0;
    var k = 0;
    if (hx > 0x3FD62E42) {                  # |x| > ln2/2
        if (hx < 0x3FF0A2B2) {              # and |x| < 1.5·ln2
            if (sign == 0) {
                hi = x - ln2_hi;
                lo = ln2_lo;
                k = 1;
            } else {
                hi = x + ln2_hi;
                lo = -ln2_lo;
                k = 0 - 1;
            }
        } else {
            var half: f64 = 0.5;
            if (sign != 0) { half = -0.5; }
            k = f64_to((invln2 * x) + half);
            var t: f64 = f64_from(k);
            hi = x - (t * ln2_hi);          # t·ln2_hi is exact here
            lo = t * ln2_lo;
        }
        x = hi - lo;
        c = (hi - x) - lo;
    } elif (hx < 0x3C900000) {              # |x| < 2^-54: expm1(x) = x
        return x;
    }
    # x is now in the primary range.
    var hfx: f64 = 0.5 * x;
    var hxs: f64 = x * hfx;
    var r1: f64 = 1.0 + (hxs * (q1 + (hxs * (q2 + (hxs * (q3 + (hxs * (q4 + (hxs * q5)))))))));
    var t3: f64 = 3.0 - (r1 * hfx);
    var e: f64 = hxs * ((r1 - t3) / (6.0 - (x * t3)));
    if (k == 0) {                           # c is 0
        var r0: f64 = x - ((x * e) - hxs);
        return r0;
    }
    e = (x * (e - c)) - c;
    e = e - hxs;
    # exp(x) ≈ 2^k (x_reduced − e + 1)
    if (k == 0 - 1) {
        var rm: f64 = (0.5 * (x - e)) - 0.5;
        return rm;
    }
    if (k == 1) {
        if (x < -0.25) {
            var m2: f64 = -2.0;
            var rp: f64 = m2 * (e - (x + 0.5));
            return rp;
        }
        var rq: f64 = 1.0 + (2.0 * (x - e));
        return rq;
    }
    var tb = (0x3FF + k) << 52;
    var twopk: f64 = tb;                    # 2^k
    if (k < 0 || k > 56) {                  # exp(x) − 1 is exp(x) to working precision
        var y: f64 = (x - e) + 1.0;
        if (k == 1024) {
            var huge2: f64 = 0x7FE0000000000000;
            y = (y * 2.0) * huge2;
        } else {
            y = y * twopk;
        }
        var ry: f64 = y - 1.0;
        return ry;
    }
    var ub = (0x3FF - k) << 52;
    var uf: f64 = ub;                       # 2^-k
    var y2: f64 = 0.0;
    if (k < 20) {
        y2 = ((x - e) + (1.0 - uf)) * twopk;
    } else {
        y2 = ((x - (e + uf)) + 1.0) * twopk;
    }
    return y2;
}

# ── correctly rounded acos, cos, ln and x^2.5 (M2a, ADR 0005) ─────────────────────────
#
# The Peng–Robinson cubic (gas.cyr) is ill-conditioned near a double root and at the critical
# point, its fugacity coefficient goes as exp(ln φ) with |ln φ| up to hundreds at extreme states,
# and Redlich–Kwong cancels near P = 0: a 1-ulp change in one glibc acos, cos, log or pow result
# moved those outputs by up to 2²⁶ ulp over the golden grid, so no class-C bound is meaningful
# (docs/development/port-parity.md §5). glibc 2.44's code can't be transcribed (it is not in the
# oracle's dependency graph, and x86_64 picks FMA variants at load time), so these four are
# correctly rounded instead: double-double evaluation (about 2⁻¹⁰⁰ relative) and one final
# rounding. glibc is within 1 ulp and correctly rounded on all but 0.04–0.16 % of arguments, so
# the port's result is the oracle's bit for bit wherever glibc's is correctly rounded;
# scripts/oracle/validate.py decides that per golden argument with a 60-digit reference, and only
# the calls where it isn't count toward a function's sensitivity S (ADR 0005).
# Only + − × ÷ and f64_sqrt are used (no x87, no polyfill), so the bits are the same on every
# target. The constants are their exact double-double splits, as bit patterns in typed locals.

# a + b = s + e exactly (Knuth's TwoSum).
#must_use
fn _km_two_sum(a: f64, b: f64): (f64, f64) {
    var s: f64 = a + b;
    var bb: f64 = s - a;
    var e: f64 = (a - (s - bb)) + (b - bb);
    return (s, e);
}

# a + b = s + e exactly, for |a| ≥ |b| or a = 0 (Dekker's FastTwoSum): s = RN(a + b).
#must_use
fn _km_fast_two_sum(a: f64, b: f64): (f64, f64) {
    var s: f64 = a + b;
    var e: f64 = b - (s - a);
    return (s, e);
}

# a·b = p + e exactly (Dekker's TwoProduct with Veltkamp's 2²⁷ + 1 split), for |a|, |b| < 2⁹⁹⁶
# and no underflow in e.
#must_use
fn _km_two_prod(a: f64, b: f64): (f64, f64) {
    var p: f64 = a * b;
    var split: f64 = 134217729.0;
    var ca: f64 = split * a;
    var ah: f64 = ca - (ca - a);
    var al: f64 = a - ah;
    var cb: f64 = split * b;
    var bh: f64 = cb - (cb - b);
    var bl: f64 = b - bh;
    var e: f64 = (al * bl) - (((p - (ah * bh)) - (al * bh)) - (ah * bl));
    return (p, e);
}

# Double-double sum (ah + al) + (bh + bl), renormalised (the accurate two-TwoSum form).
#must_use
fn _km_dd_add(ah: f64, al: f64, bh: f64, bl: f64): (f64, f64) {
    var s, e = _km_two_sum(ah, bh);
    var t, f = _km_two_sum(al, bl);
    var e1: f64 = e + t;
    var s1, e2 = _km_fast_two_sum(s, e1);
    var e3: f64 = e2 + f;
    var s2, e4 = _km_fast_two_sum(s1, e3);
    return (s2, e4);
}

# Double-double product (ah + al)·(bh + bl), renormalised.
#must_use
fn _km_dd_mul(ah: f64, al: f64, bh: f64, bl: f64): (f64, f64) {
    var p, e = _km_two_prod(ah, bh);
    var cross: f64 = (ah * bl) + (al * bh);
    var e1: f64 = e + cross;
    var s, t = _km_fast_two_sum(p, e1);
    return (s, t);
}

# Double-double quotient (ah + al) / d for a double d ≠ 0.
#must_use
fn _km_dd_div_d(ah: f64, al: f64, d: f64): (f64, f64) {
    var q1: f64 = ah / d;
    var p, e = _km_two_prod(q1, d);
    var r: f64 = ((ah - p) - e) + al;
    var q2: f64 = r / d;
    var s, t = _km_fast_two_sum(q1, q2);
    return (s, t);
}

# Double-double quotient (ah + al) / (bh + bl): three correction steps.
#must_use
fn _km_dd_div(ah: f64, al: f64, bh: f64, bl: f64): (f64, f64) {
    var q1: f64 = ah / bh;
    var ph, pl = _km_dd_mul(q1, 0.0, bh, bl);
    var rh, rl = _km_dd_add(ah, al, -ph, -pl);
    var q2: f64 = rh / bh;
    var qh, ql = _km_dd_mul(q2, 0.0, bh, bl);
    var sh, sl = _km_dd_add(rh, rl, -qh, -ql);
    var q3: f64 = sh / bh;
    var uh, ul = _km_fast_two_sum(q1, q2);
    var vh, vl = _km_dd_add(uh, ul, q3, 0.0);
    return (vh, vl);
}

# √y as a double-double, y > 0 finite: one Newton correction of the correctly rounded √y.
#must_use
fn _km_dd_sqrt(y: f64): (f64, f64) {
    var s: f64 = f64_sqrt(y);
    var p, e = _km_two_prod(s, s);
    var r: f64 = ((y - p) - e) / (2.0 * s);
    var h, l = _km_fast_two_sum(s, r);
    return (h, l);
}

# cos(r) (sin = 0) or sin(r) (sin = 1) of a double-double |r| ≤ π/4 (+ a rounding), by its Taylor
# series: 16 terms, the last below 2⁻¹²⁸ of the sum.
#must_use
fn _km_dd_cos_sin(rh: f64, rl: f64, sin): (f64, f64) {
    var r2h, r2l = _km_dd_mul(rh, rl, rh, rl);
    var th: f64 = 1.0;
    var tl: f64 = 0.0;
    var k = 0;
    if (sin == 1) { th = rh; tl = rl; k = 1; }
    var sh: f64 = th;
    var sl: f64 = tl;
    var n = 1;
    while (n <= 16) {
        var mh, ml = _km_dd_mul(th, tl, r2h, r2l);
        var d: f64 = f64_from((k + 1) * (k + 2));
        var qh, ql = _km_dd_div_d(mh, ml, d);
        th = -qh;
        tl = -ql;
        var ah, al = _km_dd_add(sh, sl, th, tl);
        sh = ah;
        sl = al;
        k = k + 2;
        n = n + 1;
    }
    return (sh, sl);
}

# cos(x), correctly rounded, for |x| ≤ 8 (x − kπ/2 reduced in double-double against a
# triple-double π/2; the Peng–Robinson arguments are in [−2π/3, π]). Outside that it is f64_cos
# (within 1 ulp, not correctly rounded); NaN and ±∞ give NaN. Mirrors `f64::cos`.
#must_use
fn _km_cos(x: f64): f64 {
    if (_km_is_finite(x) != 1) {
        var nan: f64 = x - x;
        return nan;
    }
    var ax: f64 = f64_abs(x);
    if (ax > 8.0) {
        var c: f64 = f64_cos(x);
        return c;
    }
    var twobypi: f64 = 0x3FE45F306DC9C883;
    var p1: f64 = 0x3FF921FB54442D18;   # π/2 = p1 + p2 + p3 + O(2⁻¹⁶³)
    var p2: f64 = 0x3C91A62633145C07;
    var p3: f64 = 0xB91F1976B7ED8FBC;
    var kf: f64 = _km_round_half_away(x * twobypi);
    var k = f64_to(kf);
    var h1, l1 = _km_two_prod(kf, p1);
    var h2, l2 = _km_two_prod(kf, p2);
    var h3: f64 = kf * p3;
    var ah, al = _km_two_sum(x, -h1);
    var bh, bl = _km_dd_add(ah, al, -l1, 0.0);
    var ch, cl = _km_dd_add(bh, bl, -h2, -l2);
    var rh, rl = _km_dd_add(ch, cl, -h3, 0.0);
    var q = k & 3;
    var sin = 0;
    if (q == 1 || q == 3) { sin = 1; }
    var vh, vl = _km_dd_cos_sin(rh, rl, sin);
    if (q == 1 || q == 2) { vh = -vh; }
    return vh;
}

# asin(s) of a double-double |s| ≤ 1/2, by its series Σ cₙ s²ⁿ⁺¹/(2n + 1),
# cₙ = cₙ₋₁·(2n − 1)/(2n), until a term is below 2⁻¹¹⁵ of the sum (at most 60 terms).
#must_use
fn _km_dd_asin(sh: f64, sl: f64): (f64, f64) {
    var s2h, s2l = _km_dd_mul(sh, sl, sh, sl);
    var ph: f64 = sh;
    var pl: f64 = sl;
    var uh: f64 = sh;
    var ul: f64 = sl;
    var tiny: f64 = 0x38C0000000000000;   # 2⁻¹¹⁵
    var n = 1;
    while (n <= 60) {
        var mh, ml = _km_dd_mul(ph, pl, s2h, s2l);
        var odd: f64 = f64_from(2 * n - 1);
        var ah, al = _km_dd_mul(mh, ml, odd, 0.0);
        var even: f64 = f64_from(2 * n);
        var bh, bl = _km_dd_div_d(ah, al, even);
        ph = bh;
        pl = bl;
        var next: f64 = f64_from(2 * n + 1);
        var th, tl = _km_dd_div_d(ph, pl, next);
        var vh, vl = _km_dd_add(uh, ul, th, tl);
        uh = vh;
        ul = vl;
        var at: f64 = f64_abs(th);
        var au: f64 = f64_abs(uh);
        if (at < (au * tiny)) { break; }
        n = n + 1;
    }
    return (uh, ul);
}

# acos(x), correctly rounded: π/2 − asin(x) for |x| ≤ 1/2; 2·asin(√((1 − x)/2)) above;
# π − 2·asin(√((1 + x)/2)) below. acos(1) = +0, acos(−1) = π rounded; NaN for NaN and |x| > 1.
# Mirrors `f64::acos`.
#must_use
fn _km_acos(x: f64): f64 {
    if (x != x) { return x; }
    var ax: f64 = f64_abs(x);
    if (ax > 1.0) {
        var nan: f64 = (x - x) / 0.0;
        return nan;
    }
    var p1: f64 = 0x3FF921FB54442D18;   # π/2 = p1 + p2 + O(2⁻¹⁰⁹)
    var p2: f64 = 0x3C91A62633145C07;
    if (x == 1.0) { return 0.0; }
    if (x == -1.0) {
        var pi: f64 = 0x400921FB54442D18;
        return pi;
    }
    if (ax <= 0.5) {
        var sh, sl = _km_dd_asin(x, 0.0);
        var rh, rl = _km_dd_add(p1, p2, -sh, -sl);
        return rh;
    }
    var y: f64 = (1.0 - ax) * 0.5;      # exact for 1/2 < |x| < 1
    var qh, ql = _km_dd_sqrt(y);
    var ah, al = _km_dd_asin(qh, ql);
    var th: f64 = 2.0 * ah;
    var tl: f64 = 2.0 * al;
    if (x > 0.0) { return th; }
    var p1x2: f64 = 2.0 * p1;
    var p2x2: f64 = 2.0 * p2;
    var vh, vl = _km_dd_add(p1x2, p2x2, -th, -tl);
    return vh;
}

# ln(x), correctly rounded: x = 2ᵏ·m with √2/2 < m ≤ √2, ln m = 2·atanh((m − 1)/(m + 1)) by its
# series (at most 30 terms), plus k·ln 2 in triple-double. ln(1) = +0, ln(±0) = −∞, ln(+∞) = +∞,
# NaN for NaN and x < 0. Mirrors `f64::ln`.
#must_use
fn _km_ln(xa: f64): f64 {
    var x: f64 = xa;
    if (x != x) { return x; }
    if (x < 0.0) {
        var nan: f64 = (x - x) / 0.0;
        return nan;
    }
    if (x == 0.0) {
        var m1: f64 = -1.0;
        var ninf: f64 = m1 / 0.0;
        return ninf;
    }
    if (_km_is_finite(x) != 1) { return x; }
    if (x == 1.0) { return 0.0; }
    var k = 0;
    var ui = _km_bits(x);
    if ((ui >> 52) == 0) {                  # subnormal: scale by 2⁵⁴
        var p54: f64 = 0x4350000000000000;
        x = x * p54;
        k = 0 - 54;
        ui = _km_bits(x);
    }
    k = k + (((ui >> 52) & 0x7FF) - 1023);
    var mb = (ui & 0x000FFFFFFFFFFFFF) | 0x3FF0000000000000;
    var m: f64 = mb;                        # [1, 2)
    var sqrt2: f64 = 0x3FF6A09E667F3BCD;
    if (m > sqrt2) {
        m = m * 0.5;
        k = k + 1;
    }
    var num: f64 = m - 1.0;                 # exact
    var dh, dl = _km_two_sum(m, 1.0);
    var fh, fl = _km_dd_div(num, 0.0, dh, dl);
    var f2h, f2l = _km_dd_mul(fh, fl, fh, fl);
    var ph: f64 = fh;
    var pl: f64 = fl;
    var uh: f64 = fh;
    var ul: f64 = fl;
    var tiny: f64 = 0x38C0000000000000;   # 2⁻¹¹⁵
    var n = 1;
    while (n <= 30) {
        var qh, ql = _km_dd_mul(ph, pl, f2h, f2l);
        ph = qh;
        pl = ql;
        var odd: f64 = f64_from(2 * n + 1);
        var th, tl = _km_dd_div_d(ph, pl, odd);
        var vh, vl = _km_dd_add(uh, ul, th, tl);
        uh = vh;
        ul = vl;
        var at: f64 = f64_abs(th);
        var au: f64 = f64_abs(uh);
        if (at < (au * tiny)) { break; }
        n = n + 1;
    }
    var lh: f64 = 2.0 * uh;
    var ll: f64 = 2.0 * ul;
    if (k == 0) { return lh; }
    var ln2h: f64 = 0x3FE62E42FEFA39EF;   # ln 2 = ln2h + ln2l + ln2t + O(2⁻¹⁶⁰)
    var ln2l: f64 = 0x3C7ABC9E3B39803F;
    var ln2t: f64 = 0x3907B57A079A1934;
    var kf: f64 = f64_from(k);
    var kh, ke = _km_two_prod(kf, ln2h);
    var kl: f64 = kf * ln2l;
    var kt: f64 = kf * ln2t;
    var ah, al = _km_dd_add(kh, ke, kl, kt);
    var rh, rl = _km_dd_add(ah, al, lh, ll);
    return rh;
}

# x^2.5 = x²·√x, correctly rounded for x from 2⁻³⁸⁷ to overflow at 2⁴⁰⁹·⁶: x² is exact as a
# double-double and √x is one. Below 2⁻³⁸⁷ (x^2.5 < 2⁻⁹⁶⁷) the product's error term underflows and the
# result can be 1 ulp off, normal results just above DBL_MIN included (an independent sweep found 33 such
# among 2,000 arguments below 2⁻⁴⁰⁷); below 2⁻⁴³⁰ it is +0.
# pow(±0, 2.5) = +0, pow(+∞, 2.5) = +∞, NaN for NaN and x < 0. Mirrors `x.powf(2.5)`.
#must_use
fn _km_pow_2_5(x: f64): f64 {
    if (x != x) { return x; }
    if (x == 0.0) { return 0.0; }
    if (x < 0.0) {
        var nan: f64 = (x - x) / 0.0;
        return nan;
    }
    if (_km_is_finite(x) != 1) { return x; }
    var big: f64 = 0x5990000000000000;     # 2⁴¹⁰: x^2.5 ≥ 2¹⁰²⁵ overflows
    var small: f64 = 0x2510000000000000;   # 2⁻⁴³⁰: x^2.5 < 2⁻¹⁰⁷⁵ rounds to +0
    if (x >= big) {
        var inf: f64 = 1.0 / 0.0;
        return inf;
    }
    if (x < small) { return 0.0; }
    var x2h, x2l = _km_two_prod(x, x);
    var sh, sl = _km_dd_sqrt(x);
    var p0: f64 = x2h * sh;
    if (_km_is_finite(p0) != 1) { return p0; }
    var rh, rl = _km_dd_mul(x2h, x2l, sh, sl);
    return rh;
}
