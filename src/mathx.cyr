# RN(a·b·c·d·f) by its fast path: the exact TwoProduct s_a·s_b, then _km_dd_mul_d by s_c, s_d and s_f (within
# 3·3.01u²·(1 + 2⁻⁵⁰) < 9.1u², N in [1, 32)), rounded by _km_dd_round_ends; a failed test falls back.
#must_use
fn _km_mul5_fast(a: f64, b: f64, c: f64, d: f64, f: f64): (f64, i64) {
    var ba = load64(&a);
    var bb = load64(&b);
    var bc = load64(&c);
    var bd = load64(&d);
    var bf = load64(&f);
    var neg = (ba ^ bb ^ bc ^ bd ^ bf) >> 63;
    var abs = 0x7FFFFFFFFFFFFFFF;
    var aa = ba & abs;
    var ab = bb & abs;
    var ac = bc & abs;
    var ad = bd & abs;
    var af = bf & abs;
    var nmin = 0x0010000000000000;
    var nmax = 0x7FF0000000000000;
    if (aa < nmin || ab < nmin || ac < nmin || ad < nmin || af < nmin) { return (0.0, 0); }
    if (aa >= nmax || ab >= nmax || ac >= nmax || ad >= nmax || af >= nmax) { return (0.0, 0); }
    var k = (aa >> 52) + (ab >> 52) + (ac >> 52) + (ad >> 52) + (af >> 52) - 5115;
    var mask = 0x000FFFFFFFFFFFFF;
    var one = 0x3FF0000000000000;
    var sab = (aa & mask) | one;
    var sbb = (ab & mask) | one;
    var scb = (ac & mask) | one;
    var sdb = (ad & mask) | one;
    var sfb = (af & mask) | one;
    var sa: f64 = sab;
    var sb: f64 = sbb;
    var sc: f64 = scb;
    var sd: f64 = sdb;
    var sf: f64 = sfb;
    var ph, pl = _km_two_prod(sa, sb);
    var h1, l1 = _km_dd_mul_d(ph, pl, sc);
    var h2, l2 = _km_dd_mul_d(h1, l1, sd);
    var h3, l3 = _km_dd_mul_d(h2, l2, sf);
    var z1, z2 = _km_dd_round_ends(h3, l3);
    if (z1 != z2) { return (0.0, 0); }
    var r, ok = _km_mono_fin(z1, k, neg);
    return (r, ok);
}

