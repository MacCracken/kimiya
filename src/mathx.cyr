# mathx.cyr — kimiya's private floating-point helpers (port plan §6.1, §6.4).
#
# Each helper reproduces what the Rust oracle (rust-old/, rustc 1.99.1) computes where no Cyrius
# builtin or ganita function has Rust's semantics (probed in M0, docs/development/port-parity.md §1):
# - min / max: Rust ignores a NaN operand on either side, and on (+0, −0) returns the second
#   operand (maxsd / minsd); f64_min / f64_max return a NaN second operand;
# - signum: Rust gives ±1.0 for ±0 and NaN for NaN; f64_sign gives 0.0 for all three;
# - round: Rust rounds halves away from zero; f64_round rounds them to even;
# - powi, total_cmp, is_finite: no stdlib function.
# min, max, signum, round, total_cmp and is_finite are exact (class A); powi is the
# compiler-builtins square-and-multiply loop, so it is bit-identical (class B, 0 ulp expected).
#
# The transcendental primitives the modules call are correctly rounded (ADR 0006): exp, expm1, exp10, ln,
# log10 and pow (M3c-2) and sin, cos, sincos, atan2 and acos (M4a), each two-phase (Ziv: a fast path with
# a proven error bound and a rounding test, a triple-double accurate path), on the generated tables of
# src/mathx_data.cyr. Every one is + − × ÷, f64_sqrt and integer bit operations only, so the
# bits are the same on every target. In the oracle these are glibc's (Rust std), which misrounds on about
# 0.04–5 % of arguments depending on the function (port-parity.md §9); the class-C golden rows are
# compared against the corrected oracle, the oracle's operations with every primitive result correctly
# rounded (port-parity.md §10). M1's fdlibm transcriptions (_km_log10, _km_expm1) and M3a's
# _km_log10_ln (glibc's log10 composition) were removed in M3c-3, when nothing called them any more.
# M4a added two-phase sin, cos, sincos (the full double range: Cody–Waite, then Payne–Hanek past 2^20),
# atan2 and acos (_km_cr_sin … _km_cr_acos, at the end of this file). M4d moved gas.cyr's Peng–Robinson
# trigonometry onto them (and potential.cyr's angles, on _km_cr_atan2), and removed ADR 0005's double-double
# _km_acos and _km_cos (M2a) and their helpers, so no stdlib transcendental is called here any more and
# lib/math.cyr is no longer included; and added _km_cr_exp2_scaled, the correctly rounded s·2^y·2^e of ADR
# 0002 #13 (nuclear.cyr's N₀/2ⁿ past the normal range). M4e added _km_cr_hundredth_div (ADR 0002 #19), M4e-2
# binary64 with an unbounded exponent (_km_ux_*: potential.cyr's geometry under ADR 0002 #20, and the machinery of the
# library-wide audit of intermediate over- and underflow after M4), and M4e-3, at the end of this file, multi-word
# unsigned integers (_km_bn_*), the exact RN(p/q·2^e) _km_cr_ratio and the double-double _km_dd_mul / _km_dd_div_cr
# (spectroscopy.cyr's Bohr model, Rydberg formula and reduced mass rounded once, ADR 0002 #21 and #22).
# The coefficients and constants are bit patterns in typed f64 locals (never a hex `const`).

# +∞ (0x7FF0000000000000), a compile-time constant.
const _KM_INF = 1.0 / 0.0;

# The quiet NaN Rust's f64::NAN is (0x7FF8000000000000). The parity rules match any NaN.
#must_use
fn _km_nan(): f64 {
    var n: f64 = 0x7FF8000000000000;
    return n;
}

# The bit pattern of an f64, as an integer. The untyped parameter carries the word, and the
# `: i64` return types the caller's binding as an integer: a bare `var u = x;` copy of an f64
# is f64-typed, so its `<` would be a float compare.
#must_use
fn _km_bits(x): i64 { return x; }

# 1 if x is NaN.
#must_use
fn _km_is_nan(x: f64): i64 {
    if (x != x) { return 1; }
    return 0;
}

# 1 if x is finite: neither ±∞ nor NaN (x − x is 0 exactly for finite x, NaN otherwise; one
# subtract and compare, no call: the M2a guards make several per function). Mirrors
# `f64::is_finite`.
#must_use
fn _km_is_finite(x: f64): i64 {
    var d: f64 = x - x;
    if (d == 0.0) { return 1; }
    return 0;
}

# The larger of x and y, ignoring a NaN operand (NaN only when both are). Equal operands,
# +0 and −0 included, give y: what rustc 1.99.1's `x.max(y)` returns (maxsd). Mirrors `f64::max`.
#must_use
fn _km_max(x: f64, y: f64): f64 {
    if (x != x) { return y; }
    if (y != y) { return x; }
    if (x > y) { return x; }
    return y;
}

# The smaller of x and y, ignoring a NaN operand (NaN only when both are). Equal operands,
# +0 and −0 included, give y (minsd). Mirrors `f64::min`.
#must_use
fn _km_min(x: f64, y: f64): f64 {
    if (x != x) { return y; }
    if (y != y) { return x; }
    if (x < y) { return x; }
    return y;
}

# 1.0 for +0 and positive x, −1.0 for −0 and negative x (the sign bit), NaN for NaN.
# Mirrors `f64::signum`.
#must_use
fn _km_signum(x: f64): f64 {
    if (x != x) { return x; }
    if (_km_bits(x) < 0) { return -1.0; }
    return 1.0;
}

# round(x), halves away from zero, as Rust's (compiler-builtins libm generic round):
# trunc(x + copysign(0.5 − 0.25·ε, x)), where 0.5 − 0.25·ε is 0x3FDFFFFFFFFFFFFF, the double
# just below ½. Mirrors `f64::round`.
#must_use
fn _km_round_half_away(x: f64): f64 {
    var h: f64 = 0.49999999999999994;
    if (_km_bits(x) < 0) { h = -h; }
    var r: f64 = f64_trunc(x + h);
    return r;
}

# x^n by compiler-builtins' `__powidf2` (float/pow.rs), the loop Rust's `f64::powi` calls:
# square-and-multiply over the bits of |n|, low bit first, then 1/r for a negative n. Rust's n
# is an i32; |n| is taken as an unsigned word here, so i64::MIN is 2^63 as abs_diff gives.
# Mirrors `f64::powi`.
#must_use
fn _km_powi(a: f64, n): f64 {
    var base: f64 = a;
    var p = n;
    var recip = 0;
    if (n < 0) { recip = 1; p = 0 - n; }
    var mul: f64 = 1.0;
    while (1) {
        if ((p & 1) != 0) { mul = mul * base; }
        p = p >> 1;
        if (p == 0) { break; }
        base = base * base;
    }
    if (recip == 1) {
        var r: f64 = 1.0 / mul;
        return r;
    }
    return mul;
}

# IEEE 754 totalOrder of x and y as -1 / 0 / 1: −NaN < −∞ < … < −0 < +0 < … < +∞ < +NaN, NaNs
# ordered by payload. Rust flips the magnitude bits of a negative pattern and compares the words
# as i64 (`>>>` is the arithmetic shift, `>>` the logical one). Mirrors `f64::total_cmp`.
#must_use
fn _km_total_cmp(x: f64, y: f64): i64 {
    var a = _km_bits(x);
    var b = _km_bits(y);
    a = a ^ ((a >>> 63) >> 1);
    b = b ^ ((b >>> 63) >> 1);
    if (a < b) { return 0 - 1; }
    if (a > b) { return 1; }
    return 0;
}

# ── error-free transformations (M2a) ───────────────────────────────────────────────────────────
#
# Knuth's TwoSum, Dekker's FastTwoSum and Dekker's TwoProduct (Veltkamp's split): each returns a rounded result and
# its exact error, from + − × only, the same bits on every target. Every correctly rounded primitive below builds on
# them. (M2a introduced them for ADR 0005's double-double _km_acos and _km_cos, which M4d removed with their
# double-double helpers once gas.cyr moved to M4a's two-phase _km_cr_acos and _km_cr_cos: the same bits on every golden
# argument and every argument cr_verify.py tried, at a fraction of the cost, port-parity.md §13–§14.)

# a + b = s + e exactly (Knuth's TwoSum).
#must_use
fn _km_two_sum(a: f64, b: f64): (f64, f64) {
    var s: f64 = a + b;
    var bb: f64 = s - a;
    var e: f64 = (a - (s - bb)) + (b - bb);
    return (s, e);
}

# a + b = s + e exactly, for |a| ≥ |b| or a = 0 (Dekker's FastTwoSum): s = RN(a + b).
#must_use
fn _km_fast_two_sum(a: f64, b: f64): (f64, f64) {
    var s: f64 = a + b;
    var e: f64 = b - (s - a);
    return (s, e);
}

# a·b = p + e exactly (Dekker's TwoProduct with Veltkamp's 2²⁷ + 1 split), for |a|, |b| < 2⁹⁹⁶
# and no underflow in e.
#must_use
fn _km_two_prod(a: f64, b: f64): (f64, f64) {
    var p: f64 = a * b;
    var split: f64 = 134217729.0;
    var ca: f64 = split * a;
    var ah: f64 = ca - (ca - a);
    var al: f64 = a - ah;
    var cb: f64 = split * b;
    var bh: f64 = cb - (cb - b);
    var bl: f64 = b - bh;
    var e: f64 = (al * bl) - (((p - (ah * bh)) - (al * bh)) - (ah * bl));
    return (p, e);
}

# ── correctly rounded exp, expm1, exp10, ln and log10 (M3c-2a): ADR 0006 ────────────────────────
#
# Each is round-to-nearest-even of the exact value for every double argument, subnormal results and the
# exact cases included, from + − × ÷ and integer bit operations only (no stdlib transcendental, no FMA): the
# same bits on every target. Ziv's strategy:
# - a fast path: table-driven reduction, a short polynomial, a result hi + lo with a proven error bound ε,
#   and a rounding test that returns RN(hi + lo) only when hi + (lo − ε) and hi + (lo + ε) round to the
#   same double. RN is monotone and the true value lies between those two sums (ε is the proven bound plus
#   the rounding error of lo ± ε), so equal ends mean the true value rounds to them;
# - an accurate path when the test fails: the same reduction in triple-double, rounded once by _km_rn3
#   (exact rounding of a sum of three doubles). Its relative error is below 2^-135 by the operation count
#   (each triple-double step below 2^-153 of its operands, at most 40 steps, at most 1.3 bits of
#   cancellation, 6.1 in expm1; the tables and constants to 2^-145 or better), measured 2^-150 against
#   400-bit MPFR. That is past the hardest cases known: Lefèvre and Muller's binary64 worst cases ("Worst
#   cases for correct rounding of the elementary functions in double precision", 2003 database, Properties
#   1 and 2) need a mantissa distance of 2^-113 for exp at |x| ≥ 2^-30 (2^-158 below, see
#   _km_exp_tiny_acc) and 2^-118 for ln; a relative error r gives a mantissa distance below 2r. No table
#   was found for exp10, log10 and expm1; 2^-135 is 18 bits past those functions' expected hardest case
#   (about 2^-(53 + 64) for 2^64 arguments) and past every hard case the verification found.
# The tables are src/mathx_data.cyr (generated by scripts/oracle/mathx_tables.py from MPFR, with the
# bit-count properties below asserted). Two private entry points per function serve the tests and
# scripts/oracle/cr_verify.py, which check all of them against MPFR on x86_64 ELF, x86_64 PE and aarch64:
# _km_cr_<f>_acc(x) is the whole function by the accurate path alone (also the fast path's fallback), and
# _km_cr_<f>_fast(x) returns (the fast path's result, 1) or (0, 0) when its rounding test fails, so the
# fallback rate is measured without any state. No global is written: every function here is pure.

# RO(a + b): a + b rounded to odd (of the two doubles around an inexact sum, the one with an odd last
# bit; exact sums are returned as they are). TwoSum's error e gives the side of the exact sum; an inexact
# sum is never 0, so the bit step stays in range.
#must_use
fn _km_ro_sum(a: f64, b: f64): f64 {
    var s, e = _km_two_sum(a, b);
    if (e == 0.0) { return s; }
    var sb = load64(&s);
    if ((sb & 1) != 0) { return s; }
    var up = 0;
    if (e > 0.0) { up = 1; }
    var pos = 0;
    if (s > 0.0) { pos = 1; }
    if (up == pos) { sb = sb + 1; } else { sb = sb - 1; }   # away from zero is the larger magnitude word
    var r: f64 = sb;
    return r;
}

# RN(a + b + c) exactly, for any three doubles without underflow in the TwoSums: Boldo and Melquiond's
# rounding-to-odd algorithm ("Emulation of FMA and correctly rounded sums", IEEE TC 2008): b + c = uh + ul
# and a + uh = th + tl exactly, then RN(th + RO(tl + ul)). (300,000 adversarial triples — ties, near-ties,
# binade edges, cancellation — agree with exact rational rounding.)
#must_use
fn _km_rn3(a: f64, b: f64, c: f64): f64 {
    var uh, ul = _km_two_sum(b, c);
    var th, tl = _km_two_sum(a, uh);
    var v: f64 = _km_ro_sum(tl, ul);
    var z: f64 = th + v;
    return z;
}

# Triple-doubles (h, m, l), normalised (|m| ≲ ulp(h), |l| ≲ ulp(m)). Every step is TwoSum or TwoProduct
# (exact) except the rounded sums of the third-order terms and the dropped products below 2^-158 of the
# result, so each operation's error is below 2^-155·max(|a|, |b|) for a sum and 2^-153·|a·b| for a
# product. The renormalising TwoSums keep the sum exact whatever the magnitudes, so a cancellation costs
# only its relative factor.
#must_use
fn _km_td_add(a0: f64, a1: f64, a2: f64, b0: f64, b1: f64, b2: f64): (f64, f64, f64) {
    var s0, e0 = _km_two_sum(a0, b0);
    var s1, e1 = _km_two_sum(a1, b1);
    var s2: f64 = a2 + b2;
    var t1, f1 = _km_two_sum(e0, s1);
    var t2: f64 = (f1 + e1) + s2;
    var h, u = _km_two_sum(s0, t1);
    var m, l = _km_two_sum(u, t2);
    return (h, m, l);
}

# (a0, a1, a2) + d.
#must_use
fn _km_td_add_d(a0: f64, a1: f64, a2: f64, d: f64): (f64, f64, f64) {
    var s0, e0 = _km_two_sum(a0, d);
    var t1, f1 = _km_two_sum(e0, a1);
    var t2: f64 = f1 + a2;
    var h, u = _km_two_sum(s0, t1);
    var m, l = _km_two_sum(u, t2);
    return (h, m, l);
}

# (a0, a1, a2)·(b0, b1, b2): a0b0, a0b1, a1b0 exact (TwoProduct), the 2^-106 terms rounded, the 2^-159 ones
# (a1b2, a2b1, a2b2) dropped.
#must_use
fn _km_td_mul(a0: f64, a1: f64, a2: f64, b0: f64, b1: f64, b2: f64): (f64, f64, f64) {
    var p0, q0 = _km_two_prod(a0, b0);
    var p1, q1 = _km_two_prod(a0, b1);
    var p2, q2 = _km_two_prod(a1, b0);
    var r: f64 = ((a0 * b2) + (a1 * b1)) + (a2 * b0);
    var s1, e1 = _km_two_sum(p1, p2);
    var s2, e2 = _km_two_sum(q0, s1);
    var t: f64 = (((e1 + e2) + q1) + q2) + r;
    var h, u = _km_two_sum(p0, s2);
    var m, l = _km_two_sum(u, t);
    return (h, m, l);
}

# (a0, a1, a2)·d for a double d.
#must_use
fn _km_td_mul_d(a0: f64, a1: f64, a2: f64, d: f64): (f64, f64, f64) {
    var p0, q0 = _km_two_prod(a0, d);
    var p1, q1 = _km_two_prod(a1, d);
    var r: f64 = a2 * d;
    var s, e = _km_two_sum(q0, p1);
    var t: f64 = (e + q1) + r;
    var h, u = _km_two_sum(p0, s);
    var m, l = _km_two_sum(u, t);
    return (h, m, l);
}

# 2^e as a double, for −1022 ≤ e ≤ 1023.
#must_use
fn _km_cr_pow2(e): f64 {
    var b = (e + 1023) << 52;
    var r: f64 = b;
    return r;
}

# RN(2^e·(h + m + l)) for a normalised triple-double h + m + l in [0.99, 2.01], every result range: a normal
# result is RN3 then an exact scale (2^1024 in two steps; a significand that rounds up past DBL_MAX gives
# +∞, as IEEE overflow does). A result below 2^-1022 is rounded ONCE, at the subnormal grid: with
# y = 2^(e + 1022)·(h + m + l) < 1 (each part scaled exactly), RN(1 + y) has its ulp at 2^-52, which is
# 2^-1074 after the final scale, and (RN(1 + y) − 1)·2^-1022 is exact (glibc's specialcase technique). The
# sum 1 + yh + ym + yl is rounded exactly: 1 + yh = a + b (Fast2Sum), and RN(a + b + RO(ym + yl)) =
# RN(a + b + ym + yl) because every breakpoint minus a − b is a multiple of ulp(yh), an even multiple of
# ulp(RO(ym + yl)), and rounding to odd keeps the order against those.
#must_use
fn _km_cr_finish(e, h: f64, m: f64, l: f64): f64 {
    if (e >= 0 - 1021) {
        var z: f64 = _km_rn3(h, m, l);
        if (e > 1023) {
            var s1: f64 = _km_cr_pow2(e - 1);
            var o: f64 = (z * s1) * 2.0;
            return o;
        }
        var s2: f64 = _km_cr_pow2(e);
        var y: f64 = z * s2;
        return y;
    }
    var h1, m1a = _km_fast_two_sum(h, m);    # renormalised, so the sign tests below decide y < 1
    var m1, l1 = _km_two_sum(m1a, l);
    var s: f64 = _km_cr_pow2(e + 1022);
    var yh: f64 = h1 * s;
    var ym: f64 = m1 * s;
    var yl: f64 = l1 * s;
    var normal = 0;
    if (yh > 1.0) { normal = 1; }
    if (yh == 1.0) {
        if (ym > 0.0) { normal = 1; }
        if (ym == 0.0 && yl >= 0.0) { normal = 1; }
    }
    if (normal == 1) {                       # y ≥ 1: the result is at least 2^-1022
        var z2: f64 = _km_rn3(h, m, l);
        var s3: f64 = _km_cr_pow2(e);
        var y2: f64 = z2 * s3;
        return y2;
    }
    var a, b = _km_fast_two_sum(1.0, yh);
    var v: f64 = _km_ro_sum(ym, yl);
    var w: f64 = _km_rn3(a, b, v);
    var dmin: f64 = _km_cr_pow2(0 - 1022);
    var r: f64 = (w - 1.0) * dmin;
    return r;
}

# ── exp ─────────────────────────────────────────────────────────────────────────────────────────
#
# Reduction: x = (512·E + j)·ln2/512 + r, K = 512·E + j = RN(x·512/ln 2) by the 1.5·2^52 shift, |K| < 2^20,
# |r| ≤ 2^-10.52. ln2/512 = L1 + L2 + L3 + L4 with L1 at 33 bits: K·L1 is exact, and rh = x − K·L1 is exact
# (a multiple of min(ulp(x), 2^-42) below 2^-10 in magnitude: at most 53 bits). r + rl = rh − K·L2 to 2^-74.5
# (K·L2's rounding, 2^-77; the Fast2Sum is exact unless |rh| < |K·L2| ≤ 2^-23.9, where its error is below
# 2^-75), and the fast path drops K·L3 (below 2^-79). e^x = 2^E·T_j·e^r with T_j = 2^(j/512) =
# A_j + B_j (+ C_j + D_j), A_j at 26 bits.
# Fast path: q = r²(1/2 + r/6) + r⁴(1/24 + r/120) (Estrin; truncation 2^-72.6, rounding 2^-73.5); r = r1 + r2
# with r1 = r rounded to a multiple of 2^-37 (27 bits), so A·r1 is exact and A + A·r1 = hi + e1 (Fast2Sum);
# lo = (e1 + B) + (A·(r2 + rl + q) + B·(r + rl + q)), each partial sum below 2^-20 (roundings 2^-74). The
# neglected rl·(e^r − 1) is below 2^-74.5 and C below 2^-79, so |hi + lo − e^x/2^E| < 0.9·2^-70 (measured
# 2^-71.1 over 100,000 arguments against 400-bit MPFR), on a value in [0.9993, 1.9987]. The test uses
# ε = 2^-69, which also covers lo ± ε's own rounding (2^-73). The evaluation order keeps the dependency
# chains short: this code is latency-bound (each operation goes through memory). About one argument in
# 50,000 falls back.

# The fast core for e^(xh + xl), |xh| ≤ 745.2 and |xl| ≤ 2^-42: (hi, lo, E) with hi + lo = e^x/2^E within
# 2^-70. exp passes xl = 0; exp10 passes x·ln 10 as xh + xl (xl folds into the K·L2 term).
#must_use
fn _km_exp_core(xh: f64, xl: f64): (f64, f64, i64) {
    var inv: f64 = _KM_CR_EXP_INVLN2N;
    var l1: f64 = _KM_CR_EXP_L1;
    var l2: f64 = _KM_CR_EXP_L2;
    var tt: f64 = (xh * inv) + 6755399441055744.0;   # 1.5·2^52: rounds x·512/ln 2 to an integer
    var kd: f64 = tt - 6755399441055744.0;
    var k = load64(&tt) - 0x4338000000000000;
    var ti = (k & 511) * 32;
    var e = k >>> 9;
    var rh: f64 = xh - (kd * l1);
    var s: f64 = (kd * l2) - xl;
    var r: f64 = rh - s;
    var rl: f64 = (rh - r) - s;
    var c: f64 = r + 49152.0;                         # 1.5·2^15: rounds r to a multiple of 2^-37
    var r1: f64 = c - 49152.0;
    var r2: f64 = r - r1;
    var p3: f64 = _KM_CR_EXP_P3;
    var p4: f64 = _KM_CR_EXP_P4;
    var p5: f64 = _KM_CR_EXP_P5;
    var z: f64 = r * r;                       # Estrin: the code is latency-bound, so keep chains short
    var q: f64 = (z * (0.5 + (r * p3))) + ((z * z) * (p4 + (r * p5)));
    var a: f64 = load64(&_KM_CR_EXP_T + ti);
    var b: f64 = load64(&_KM_CR_EXP_T + ti + 8);
    var p1: f64 = a * r1;
    var hi: f64 = a + p1;
    var e1: f64 = p1 - (hi - a);
    var rlq: f64 = rl + q;
    var lo: f64 = (e1 + b) + ((a * (r2 + rlq)) + (b * (r + rlq)));
    return (hi, lo, e);
}

# The fast test with bound err (absolute, on hi + lo) and the scale for any E: (1, RN(2^E·(hi + lo))) or (0, 0)
# when the test fails. Normal results scale
# exactly (2^1024 in two steps). A result that may be subnormal (E ≤ −1022 and 2^(E+1022)·(hi + lo) < 1, decided
# on hi + lo renormalised: the core's lo is not, when r1 = 0) is tested on the subnormal grid, rounding once:
# y = 2^(E+1022)·(hi + lo) (exact), 1 + y = a + b + yl with a + b = 1 + yh exactly, and the ends
# a + ((b + yl) ∓ ε') with ε' = err·2^(E+1022) + 2^-104 (|b + yl| ≤ 2^-52, so the two inner roundings are below
# 2^-104.4 at this scale, where the grid is 2^-52).
#must_use
fn _km_exp_fin(hi: f64, lo: f64, e, err: f64): (i64, f64) {
    if (e >= 0 - 1021) {
        var u: f64 = hi + (lo - err);
        var v: f64 = hi + (lo + err);
        if (u != v) { return (0, 0.0); }
        if (e > 1023) {
            var s1: f64 = _km_cr_pow2(e - 1);
            var o: f64 = (u * s1) * 2.0;
            return (1, o);
        }
        var s2: f64 = _km_cr_pow2(e);
        var y: f64 = u * s2;
        return (1, y);
    }
    var s: f64 = _km_cr_pow2(e + 1022);
    var hn: f64 = hi + lo;                   # hi + lo renormalised: lo can be up to 2^-38 when r1 = 0
    var ln: f64 = lo - (hn - hi);
    var yh: f64 = hn * s;
    if (yh > 1.0 || (yh == 1.0 && ln >= 0.0)) {   # 2^E·(hi + lo) ≥ 2^-1022: a normal result
        var u2: f64 = hi + (lo - err);
        var v2: f64 = hi + (lo + err);
        if (u2 != v2) { return (0, 0.0); }
        var s3: f64 = _km_cr_pow2(e);
        var y2: f64 = u2 * s3;
        return (1, y2);
    }
    var yl: f64 = ln * s;
    var a, b = _km_fast_two_sum(1.0, yh);
    var w: f64 = b + yl;
    var tiny: f64 = 0x3970000000000000;     # 2^-104
    var err2: f64 = (err * s) + tiny;
    var u3: f64 = a + (w - err2);
    var v3: f64 = a + (w + err2);
    if (u3 != v3) { return (0, 0.0); }
    var dmin: f64 = _km_cr_pow2(0 - 1022);
    var r: f64 = (u3 - 1.0) * dmin;
    return (1, r);
}

# e^x, correctly rounded. exp(±0) = 1 (as every |x| < 2^-54: e^x is then within 2^-54 of 1, inside 1's
# rounding interval), exp(+∞) = +∞, exp(−∞) = +0, NaN for NaN; x above 709.782712893384 overflows to +∞, and
# below −745.1332191019411 (e^x < 2^-1075) rounds to +0. e^x is exact only at x = 0 (Lindemann–Weierstrass: e^x
# is transcendental for algebraic x ≠ 0), so no other argument is exact or a tie. The fast path covers
# 2^-54 ≤ |x| ≤ 708 (normal results, one scale), inline; the rest goes through _km_cr_exp_fast.
#must_use
fn _km_cr_exp(x: f64): f64 {
    var ax = load64(&x) & 0x7FFFFFFFFFFFFFFF;
    # |x| < 2^-54, |x| > 708 or NaN, in one compare: ax − bits(2^-54) is above bits(708) − bits(2^-54) as an
    # unsigned word (the sign flip makes the signed compare an unsigned one) exactly then.
    if (((ax - 0x3C90000000000000) ^ 0x8000000000000000) > 0x83F6200000000000) {
        var w, okw = _km_cr_exp_fast(x);
        if (okw == 1) { return w; }
        var zw: f64 = _km_cr_exp_acc(x);
        return zw;
    }
    var inv: f64 = _KM_CR_EXP_INVLN2N;
    var l1: f64 = _KM_CR_EXP_L1;
    var l2: f64 = _KM_CR_EXP_L2;
    var tt: f64 = (x * inv) + 6755399441055744.0;
    var kd: f64 = tt - 6755399441055744.0;
    var k = load64(&tt) - 0x4338000000000000;
    var ti = (k & 511) * 32;
    var e = k >>> 9;
    var rh: f64 = x - (kd * l1);
    var s: f64 = kd * l2;
    var r: f64 = rh - s;
    var rl: f64 = (rh - r) - s;
    var c: f64 = r + 49152.0;
    var r1: f64 = c - 49152.0;
    var r2: f64 = r - r1;
    var p3: f64 = _KM_CR_EXP_P3;
    var p4: f64 = _KM_CR_EXP_P4;
    var p5: f64 = _KM_CR_EXP_P5;
    var z: f64 = r * r;                       # Estrin: the code is latency-bound, so keep chains short
    var q: f64 = (z * (0.5 + (r * p3))) + ((z * z) * (p4 + (r * p5)));
    var a: f64 = load64(&_KM_CR_EXP_T + ti);
    var b: f64 = load64(&_KM_CR_EXP_T + ti + 8);
    var p1: f64 = a * r1;
    var hi: f64 = a + p1;
    var e1: f64 = p1 - (hi - a);
    var rlq: f64 = rl + q;
    var lo: f64 = (e1 + b) + ((a * (r2 + rlq)) + (b * (r + rlq)));
    var err: f64 = 0x3BA0000000000000;      # 2^-69
    var u: f64 = hi + (lo - err);
    var v: f64 = hi + (lo + err);
    if (u == v) {
        var sb = (e + 1023) << 52;
        var sc: f64 = sb;
        var y: f64 = u * sc;
        return y;
    }
    var za: f64 = _km_cr_exp_acc(x);
    return za;
}

# The fast path alone, for every x: (RN(e^x), 1), or (0, 0) when the rounding test fails and the accurate path
# must decide. NaN, the tiny end, overflow and underflow first, then the fast core with the general finish
# (708 < x: E up to 1024; x < −708: subnormal results). For 2^-54 ≤ |x| ≤ 708 _km_exp_core and _km_exp_fin
# perform exactly the operations of _km_cr_exp's inline path (E ≥ −1022 there, with hi > 1 at E = −1022), so
# this gives its result and its test.
#must_use
fn _km_cr_exp_fast(x: f64): (f64, i64) {
    if (x != x) { return (x, 1); }
    var ax = load64(&x) & 0x7FFFFFFFFFFFFFFF;
    if (ax < 0x3C90000000000000) { return (1.0, 1); }
    var ovf: f64 = _KM_CR_EXP_OVF;
    var unf: f64 = _KM_CR_EXP_UNF;
    if (x > ovf) {
        var inf: f64 = _KM_INF;
        return (inf, 1);
    }
    if (x < unf) { return (0.0, 1); }
    var hi, lo, e = _km_exp_core(x, 0.0);
    var err: f64 = 0x3BA0000000000000;      # 2^-69
    var ok, y = _km_exp_fin(hi, lo, e, err);
    return (y, ok);
}

# The accurate core: e^(y0 + y1 + y2) = 2^E·(h + m + l), (h, m, l) stored at out[0..2], E returned. The same
# K as the fast path; r = y − K·(L1 + L2 + L3 + L4) as a triple-double (K·L1 exact, K·L2 and K·L3
# TwoProducts, K·L4 rounded: below 2^-186 of error); e^r − 1 by Horner in triple-double to r^11/11!
# (truncation 2^-152); T_j = A + B + C + D renormalised (2^-159); h + m + l = T_j + T_j·(e^r − 1). Measured
# relative error 2^-155 against 400-bit MPFR.
#must_use
fn _km_exp_acc_core(y0: f64, y1: f64, y2: f64, out): i64 {
    var inv: f64 = _KM_CR_EXP_INVLN2N;
    var l1: f64 = _KM_CR_EXP_L1;
    var l2: f64 = _KM_CR_EXP_L2;
    var l3: f64 = _KM_CR_EXP_L3;
    var l4: f64 = _KM_CR_EXP_L4;
    var tt: f64 = (y0 * inv) + 6755399441055744.0;
    var kd: f64 = tt - 6755399441055744.0;
    var k = load64(&tt) - 0x4338000000000000;
    var ti = (k & 511) * 32;
    var e = k >>> 9;
    var rh: f64 = y0 - (kd * l1);
    var a2, a2e = _km_two_prod(kd, l2);
    var a3, a3e = _km_two_prod(kd, l3);
    var a4: f64 = kd * l4;
    var ra0, ra1, ra2 = _km_td_add_d(rh, 0.0, 0.0, -a2);
    var rb0, rb1, rb2 = _km_td_add_d(ra0, ra1, ra2, y1);
    var rc0, rc1, rc2 = _km_td_add_d(rb0, rb1, rb2, -a2e);
    var rd0, rd1, rd2 = _km_td_add_d(rc0, rc1, rc2, -a3);
    var re0, re1, re2 = _km_td_add_d(rd0, rd1, rd2, y2);
    var a34: f64 = a3e + a4;
    var r0, r1, r2 = _km_td_add_d(re0, re1, re2, -a34);
    var sh: f64 = load64(&_KM_CR_EXP_ACC + 216);    # 1/11! (index 3·(11 − 2))
    var sm: f64 = load64(&_KM_CR_EXP_ACC + 224);
    var sl: f64 = load64(&_KM_CR_EXP_ACC + 232);
    var n = 10;
    while (n >= 2) {
        var th, tm, tl = _km_td_mul(r0, r1, r2, sh, sm, sl);
        var off = (n - 2) * 24;
        var ch: f64 = load64(&_KM_CR_EXP_ACC + off);
        var cm: f64 = load64(&_KM_CR_EXP_ACC + off + 8);
        var cl: f64 = load64(&_KM_CR_EXP_ACC + off + 16);
        var uh, um, ul = _km_td_add(ch, cm, cl, th, tm, tl);
        sh = uh;
        sm = um;
        sl = ul;
        n = n - 1;
    }
    var vh, vm, vl = _km_td_mul(r0, r1, r2, sh, sm, sl);
    var wh, wm, wl = _km_td_add_d(vh, vm, vl, 1.0);
    var ph, pm, pl = _km_td_mul(r0, r1, r2, wh, wm, wl);     # e^r − 1
    var ta: f64 = load64(&_KM_CR_EXP_T + ti);
    var tb: f64 = load64(&_KM_CR_EXP_T + ti + 8);
    var tc: f64 = load64(&_KM_CR_EXP_T + ti + 16);
    var td: f64 = load64(&_KM_CR_EXP_T + ti + 24);
    var t0, t1a = _km_fast_two_sum(ta, tb);
    var t1, t2a = _km_fast_two_sum(t1a, tc);
    var t2: f64 = t2a + td;
    var qh, qm, ql = _km_td_mul(t0, t1, t2, ph, pm, pl);
    var zh, zm, zl = _km_td_add(t0, t1, t2, qh, qm, ql);
    store64(out, zh);
    store64(out + 8, zm);
    store64(out + 16, zl);
    return e;
}

# e^x for 2^-54 ≤ |x| < 2^-30, where Lefèvre–Muller's bound is 2^-158 (e^x is then 1 + x + x²/2 + …, and
# 1 + x is a short exact number): 1 + x = a + b exactly, q = x²/2 + x³/6 + x⁴/24 + x⁵/120 as a double-double
# to 2^-165 absolute (x² and x³ by TwoProduct, x³/6 by a corrected division; x⁶/720 < 2^-189 dropped), and
# RN(a + b + RO(qh + ql)) by _km_rn3 (the rounding-to-odd argument of _km_cr_finish: ulp(x) is an even
# multiple of ulp(q)).
#must_use
fn _km_exp_tiny_acc(x: f64): f64 {
    var p, pe = _km_two_prod(x, x);
    var a, ae = _km_two_prod(x, p);
    var x3l: f64 = ae + (x * pe);
    var d3h: f64 = a / 6.0;
    var pp, pe2 = _km_two_prod(d3h, 6.0);
    var d3l: f64 = (((a - pp) - pe2) + x3l) / 6.0;
    var ax: f64 = a * x;
    var x4: f64 = ax / 24.0;
    var x5: f64 = (ax * x) / 120.0;
    var hp: f64 = p * 0.5;
    var t, te = _km_two_sum(hp, d3h);
    var lo: f64 = ((((pe * 0.5) + te) + d3l) + x4) + x5;
    var qh, ql = _km_fast_two_sum(t, lo);
    var a1, b1 = _km_fast_two_sum(1.0, x);
    var v: f64 = _km_ro_sum(qh, ql);
    var r: f64 = _km_rn3(a1, b1, v);
    return r;
}

# e^x by the accurate path alone, for every x (the fast path's fallback, and a test hook).
#must_use
fn _km_cr_exp_acc(x: f64): f64 {
    if (x != x) { return x; }
    var ax = load64(&x) & 0x7FFFFFFFFFFFFFFF;
    if (ax < 0x3C90000000000000) { return 1.0; }
    var ovf: f64 = _KM_CR_EXP_OVF;
    var unf: f64 = _KM_CR_EXP_UNF;
    if (x > ovf) { return _KM_INF; }
    if (x < unf) { return 0.0; }
    if (ax < 0x3E10000000000000) {              # |x| < 2^-30
        var t: f64 = _km_exp_tiny_acc(x);
        return t;
    }
    var buf: f64[3];
    var e = _km_exp_acc_core(x, 0.0, 0.0, &buf);
    var r: f64 = _km_cr_finish(e, buf[0], buf[1], buf[2]);
    return r;
}

# ── exp10 ───────────────────────────────────────────────────────────────────────────────────────
#
# 10^x = e^(x·ln 10): x·ln 10 = yh + yl to 2^-93.5 (yh = RN(x·LN10H), its exact error by Dekker's product
# with LN10H pre-split 26 + 27 bits, plus x·LN10M; LN10L ≈ 2^-106 dropped), then exp's core: e^(yh + yl) has
# a relative error below 2^-93 from the argument, and the core's 2^-70 bound stands (the same ε).
# Exact and tie cases: 10^x is rational only for integer x (10^(p/q) is irrational unless q | p), dyadic
# only for x ≥ 0, so the doubles 10^0 … 10^22 (5^22 < 2^53) are the only exact results and 10^23 (5^23 has
# 54 bits) the only tie: the fast path returns the exact ones (they are ulp/2 from every midpoint), and
# exp10(23) = 1e23 (the tie rounded to even, what the literal 1e23 parses to) is special-cased in the
# accurate path, where the fast path's test sends it (its interval straddles the tie).

# 10^x, correctly rounded. exp10(±0) = 1 (as every |x| < 2^-56), +∞ → +∞, −∞ → +0, NaN for NaN; x above
# 308.2547155599167 overflows, below −323.60724533877976 rounds to +0.
#must_use
fn _km_cr_exp10(x: f64): f64 {
    var ax = load64(&x) & 0x7FFFFFFFFFFFFFFF;
    # |x| < 2^-56, |x| > 307 or NaN (the unsigned range test of _km_cr_exp): the specials and the general
    # finish, through _km_cr_exp10_fast.
    if (((ax - 0x3C70000000000000) ^ 0x8000000000000000) > 0x8403300000000000) {
        var w, okw = _km_cr_exp10_fast(x);
        if (okw == 1) { return w; }
        var zw: f64 = _km_cr_exp10_acc(x);
        return zw;
    }
    var h: f64 = _KM_CR_EXP_LN10H;
    var hm: f64 = _KM_CR_EXP_LN10M;
    var h1: f64 = _KM_CR_EXP_LN10H1;
    var h2: f64 = _KM_CR_EXP_LN10H2;
    var yh: f64 = x * h;
    var c: f64 = 134217729.0 * x;
    var x1: f64 = c - (c - x);
    var x2: f64 = x - x1;
    var pe: f64 = ((((x1 * h1) - yh) + (x1 * h2)) + (x2 * h1)) + (x2 * h2);
    var yl: f64 = pe + (x * hm);
    var hi, lo, e = _km_exp_core(yh, yl);
    var err: f64 = 0x3BA0000000000000;      # 2^-69
    var u: f64 = hi + (lo - err);
    var v: f64 = hi + (lo + err);
    if (u == v) {
        var sb = (e + 1023) << 52;
        var sc: f64 = sb;
        var y: f64 = u * sc;
        return y;
    }
    var z: f64 = _km_cr_exp10_acc(x);
    return z;
}

# The fast path alone, for every x (as _km_cr_exp_fast): the specials, x·ln 10 as yh + yl, exp's core and the
# general finish (subnormal results and the overflow end included). For 2^-56 ≤ |x| ≤ 307 (E ≥ −1020) it
# performs _km_cr_exp10's inline operations.
#must_use
fn _km_cr_exp10_fast(x: f64): (f64, i64) {
    if (x != x) { return (x, 1); }
    var ax = load64(&x) & 0x7FFFFFFFFFFFFFFF;
    if (ax < 0x3C70000000000000) { return (1.0, 1); }
    var ovf: f64 = _KM_CR_EXP10_OVF;
    var unf: f64 = _KM_CR_EXP10_UNF;
    if (x > ovf) {
        var inf: f64 = _KM_INF;
        return (inf, 1);
    }
    if (x < unf) { return (0.0, 1); }
    var h: f64 = _KM_CR_EXP_LN10H;
    var hm: f64 = _KM_CR_EXP_LN10M;
    var h1: f64 = _KM_CR_EXP_LN10H1;
    var h2: f64 = _KM_CR_EXP_LN10H2;
    var yh: f64 = x * h;
    var c: f64 = 134217729.0 * x;
    var x1: f64 = c - (c - x);
    var x2: f64 = x - x1;
    var pe: f64 = ((((x1 * h1) - yh) + (x1 * h2)) + (x2 * h1)) + (x2 * h2);
    var yl: f64 = pe + (x * hm);
    var hi, lo, e = _km_exp_core(yh, yl);
    var err: f64 = 0x3BA0000000000000;      # 2^-69
    var ok, y = _km_exp_fin(hi, lo, e, err);
    return (y, ok);
}

# 10^x by the accurate path alone: x·ln 10 as a triple-double (x·LN10H and x·LN10M by TwoProduct, x·LN10L
# rounded: 2^-155 relative), then exp's accurate core.
#must_use
fn _km_cr_exp10_acc(x: f64): f64 {
    if (x != x) { return x; }
    var ax = load64(&x) & 0x7FFFFFFFFFFFFFFF;
    if (ax < 0x3C70000000000000) { return 1.0; }
    var ovf: f64 = _KM_CR_EXP10_OVF;
    var unf: f64 = _KM_CR_EXP10_UNF;
    if (x > ovf) { return _KM_INF; }
    if (x < unf) { return 0.0; }
    if (x == 23.0) {
        var t23: f64 = 100000000000000000000000.0;  # the tie 10^23, rounded to even
        return t23;
    }
    var h: f64 = _KM_CR_EXP_LN10H;
    var hm: f64 = _KM_CR_EXP_LN10M;
    var hl: f64 = _KM_CR_EXP_LN10L;
    var p0, q0 = _km_two_prod(x, h);
    var p1, q1 = _km_two_prod(x, hm);
    var p2: f64 = x * hl;
    var s, se = _km_two_sum(q0, p1);
    var t: f64 = (se + q1) + p2;
    var y0, u = _km_fast_two_sum(p0, s);
    var y1, y2 = _km_two_sum(u, t);
    var buf: f64[3];
    var e = _km_exp_acc_core(y0, y1, y2, &buf);
    var r: f64 = _km_cr_finish(e, buf[0], buf[1], buf[2]);
    return r;
}

# ── expm1 ───────────────────────────────────────────────────────────────────────────────────────
#
# Fast path, two regions:
# - |x| < 2^-6: expm1(x) = x + x²/2 + x³·S(x), S = 1/3! + x/4! + … + x⁶/9! (truncation x^10/10!, below 2^-75
#   of x). x² = p + pe exactly (TwoProduct), x + p/2 = hs + ht (Fast2Sum), lo = ht + pe/2 + x3 with
#   x3 = RN(RN(x·p)·S), S by Estrin in x and p = RN(x²). x3's relative error is below 6.1·2^-53 (x·p, p for
#   x², S's 3·2^-53, the product) and lo's rounding below 2^-53·|lo|, so ε = 2^-49·|x3| + 2^-100·|x| (the
#   error measured at most 0.29 of it over 100,000 arguments).
# - otherwise: exp's core, hi + lo = e^x/2^E within 2^-70·(…), and e^x − 1 = 2^E·hi − 1 + 2^E·lo, the first
#   difference exact (Sterbenz for E = 0, Fast2Sum otherwise: hi is in [0.9993, 1.9987], so 2^E·hi < 1 for
#   E < 0 and > 1 for E > 0); ε = 2^-69·2^E. |expm1(x)| ≥ 0.0155 there, so the fallback rate stays small.
# expm1(x) is exact only at x = 0 (e^x − 1 is transcendental for algebraic x ≠ 0).

# expm1(x) = e^x − 1, correctly rounded. ±0 → ±0 and |x| < 2^-53 → x (x²/2 is then below half an ulp of x,
# on the side that keeps x), +∞ → +∞, −∞ → −1, NaN for NaN; x above 709.782712893384 overflows, below
# −37.42994775023704 (e^x < 2^-54) rounds to −1.
#must_use
fn _km_cr_expm1(x: f64): f64 {
    var y, ok = _km_cr_expm1_fast(x);
    if (ok == 1) { return y; }
    var z: f64 = _km_cr_expm1_acc(x);
    return z;
}

# The fast path alone: (its result, 1), or (0, 0) when its test fails or x > 708 (left to the accurate path).
#must_use
fn _km_cr_expm1_fast(x: f64): (f64, i64) {
    var ax = load64(&x) & 0x7FFFFFFFFFFFFFFF;
    if (ax < 0x3F90000000000000) {               # |x| < 2^-6
        if (ax < 0x3CA0000000000000) { return (x, 1); }   # |x| < 2^-53, ±0, subnormals
        var p: f64 = x * x;                      # x² = p + pe exactly (Dekker, inline)
        var cx: f64 = 134217729.0 * x;
        var x1: f64 = cx - (cx - x);
        var x2: f64 = x - x1;
        var pe: f64 = (((x1 * x1) - p) + (2.0 * (x1 * x2))) + (x2 * x2);
        var k3: f64 = _KM_CR_EXPM1_Q3;
        var k4: f64 = _KM_CR_EXPM1_Q4;
        var k5: f64 = _KM_CR_EXPM1_Q5;
        var k6: f64 = _KM_CR_EXPM1_Q6;
        var k7: f64 = _KM_CR_EXPM1_Q7;
        var k8: f64 = _KM_CR_EXPM1_Q8;
        var k9: f64 = _KM_CR_EXPM1_Q9;
        var s: f64 = ((k3 + (x * k4)) + (p * (k5 + (x * k6)))) + ((p * p) * ((k7 + (x * k8)) + (p * k9)));
        var x3: f64 = (x * p) * s;
        var hp: f64 = p * 0.5;
        var hs: f64 = x + hp;
        var ht: f64 = hp - (hs - x);
        var lo: f64 = (ht + (pe * 0.5)) + x3;
        var ex3: f64 = f64_abs(x3);
        var exa: f64 = f64_abs(x);
        var c49: f64 = 0x3CE0000000000000;      # 2^-49
        var c100: f64 = 0x39B0000000000000;     # 2^-100
        var err: f64 = (ex3 * c49) + (exa * c100);
        var u: f64 = hs + (lo - err);
        var v: f64 = hs + (lo + err);
        if (u == v) { return (u, 1); }
        return (0.0, 0);
    }
    var m1b = _KM_CR_EXPM1_M1 & 0x7FFFFFFFFFFFFFFF;
    if (ax > m1b) {                              # |x| > 37.42994775023704
        if (x < 0.0) { return (-1.0, 1); }       # x < EXPM1_M1 (−∞ included): e^x < 2^-54
        if (ax > 0x4086200000000000) {           # x > 708, +∞, NaN: left to the accurate path (which returns
            return (0.0, 0);                     # the specials at once)
        }
    }
    var hi, lo2, e = _km_exp_core(x, 0.0);
    var hh: f64 = 0.0;
    var ll: f64 = lo2;
    var sc: f64 = 1.0;
    if (e == 0) {
        hh = hi - 1.0;                           # exact: hi in [0.9993, 1.9987]
    } else {
        sc = _km_cr_pow2(e);
        var hsc: f64 = hi * sc;
        if (e > 0) {
            hh = hsc - 1.0;
            var t1: f64 = -1.0 - (hh - hsc);
            ll = t1 + (lo2 * sc);
        } else {
            hh = -1.0 + hsc;
            var t2: f64 = hsc - (hh + 1.0);
            ll = t2 + (lo2 * sc);
        }
    }
    var err2: f64 = 0x3BA0000000000000;      # 2^-69
    var errs: f64 = err2 * sc;
    var u2: f64 = hh + (ll - errs);
    var v2: f64 = hh + (ll + errs);
    if (u2 == v2) { return (u2, 1); }
    return (0.0, 0);
}

# expm1 by the accurate path alone. |x| < 2^-6: x + x²/2 + … + x^17/17! by Horner in triple-double on the
# exact x (truncation below 2^-154 of x; measured 2^-155). Otherwise e^x from exp's accurate core, scaled,
# minus 1 in triple-double (|expm1(x)| ≥ 0.0155: at most 6.1 bits of cancellation; measured 2^-152); for
# E ≥ 120 the −1 is below 2^-114 of e^x, inside exp's own worst-case distance (Lefèvre–Muller: 2^-113 for
# |x| ≥ 2^-30), so it cannot move the rounding and expm1 rounds as exp does.
#must_use
fn _km_cr_expm1_acc(x: f64): f64 {
    if (x != x) { return x; }
    var ax = load64(&x) & 0x7FFFFFFFFFFFFFFF;
    if (ax < 0x3CA0000000000000) { return x; }
    var ovf: f64 = _KM_CR_EXPM1_OVF;
    var m1: f64 = _KM_CR_EXPM1_M1;
    if (x > ovf) { return _KM_INF; }
    if (x < m1) { return -1.0; }
    if (ax < 0x3F90000000000000) {
        var sh: f64 = load64(&_KM_CR_EXP_ACC + 360);   # 1/17! (index 3·(17 − 2))
        var sm: f64 = load64(&_KM_CR_EXP_ACC + 368);
        var sl: f64 = load64(&_KM_CR_EXP_ACC + 376);
        var n = 16;
        while (n >= 2) {
            var th, tm, tl = _km_td_mul_d(sh, sm, sl, x);
            var off = (n - 2) * 24;
            var ch: f64 = load64(&_KM_CR_EXP_ACC + off);
            var cm: f64 = load64(&_KM_CR_EXP_ACC + off + 8);
            var cl: f64 = load64(&_KM_CR_EXP_ACC + off + 16);
            var uh, um, ul = _km_td_add(ch, cm, cl, th, tm, tl);
            sh = uh;
            sm = um;
            sl = ul;
            n = n - 1;
        }
        var vh, vm, vl = _km_td_mul_d(sh, sm, sl, x);
        var wh, wm, wl = _km_td_add_d(vh, vm, vl, 1.0);
        var ph, pm, pl = _km_td_mul_d(wh, wm, wl, x);
        var r: f64 = _km_rn3(ph, pm, pl);
        return r;
    }
    var buf: f64[3];
    var e = _km_exp_acc_core(x, 0.0, 0.0, &buf);
    if (e >= 120) {
        var big: f64 = _km_cr_finish(e, buf[0], buf[1], buf[2]);
        return big;
    }
    var sc: f64 = _km_cr_pow2(e);
    var bh: f64 = buf[0] * sc;
    var bm: f64 = buf[1] * sc;
    var bl: f64 = buf[2] * sc;
    var dh, dm, dl = _km_td_add_d(bh, bm, bl, -1.0);
    var r2: f64 = _km_rn3(dh, dm, dl);
    return r2;
}

# ── ln and log10 ────────────────────────────────────────────────────────────────────────────────
#
# Reduction: t = bits(x) − 0x3FE7FC0000000000, E = t >> 52 (arithmetic), j = bits 43 … 51 of t, so
# x = 2^E·m with m in [0.7495, 1.4990) and E·ln2 + ln m never cancels (|ln m| ≤ 0.405 < ln 2). On interval j,
# c_j ≈ 1/m is short (a multiple of 2^-9 or 2^-10) and r = m·c_j − 1 is exact with |r| < 2^-9 (the generator
# asserts both): m = mh + ml (mh = m's top 25 bits), mh·c − 1 is exact (Sterbenz), ml·c is exact, and their
# sum is the representable r. ln x = E·ln2 + L_j + log1p(r), L_j = −ln c_j (0 on interval 256, where c = 1).
# Fast path: r = ra + rb (Veltkamp, ra at 26 bits) so r²/2 = ra²/2 (exact) + rb·(ra + rb/2) (2^-80·|r| of
# error); log1p(r) − r + r²/2 = r³·(1/3 − r/4 + … − r⁵/8) (Estrin, relative error 4·2^-53; truncation
# |r|⁹/9 < 2^-84); hi + lo = the three
# Fast2Sums of E·LN2H + Lh, + r, − ra²/2 plus the small terms. The test's bound is absolute, from the computed
# terms: err = 2^-49·|p| + 2^-83·|hi| + 2^-93·|E| covers p's own error and truncation (2^-50.6·|p|), the six
# roundings of lo (each below 2^-53 of a partial sum: 2^-51.4·|p|, 2^-84.4·|hi| for the t2, Ll and d terms,
# 2^-95.4·|E| for E·LN2M) with E·LN2M's rounding (2^-97·|E|) and the dropped E·LN2L (2^-102·|E|), and the
# test's own rounding of lo ∓ err (2^-53·|lo|); what is left over covers log10's extra roundings, 2^-52.4·|lo|
# (|lo| is below |p| + 2^-44·|E| + 2^-43.3·|hi|). It is relative to r near 1 (interval 256, where p, t2 and
# the d terms all scale with r) and about 2^-77 elsewhere (measured error 2^-69.9 relative at E = 0 next to
# interval 256 and 2^-81.2 at E ≠ 0, over 100,000 arguments). pow needs exactly this absolute form: the
# error of y·ln x is |y|·err. ln(1) = +0 falls out (every term is ±0 and their sum +0).
# log10 = ln·(1/ln 10): hi + lo times IVH + IVM (Dekker's product, IVH pre-split 26 + 27 bits), with the
# bound carried over (_km_cr_log10_fast). log10(10^k) = k for k = 0 … 22 comes out of the fast path: k is a
# double, ulp/2 from every midpoint. ln x and log10 x are exact only there (and ln at x = 1): log10 x rational means
# x = 10^(p/q) with q | p, and 10^n is a double only for n = 0 … 22; nothing else is exact or a tie.

# The ln fast core for the bits ui of a positive normal x (ebias −54 for a subnormal pre-scaled by 2^54):
# (hi, lo, err) with |hi + lo − ln x| < err minus the test's own rounding (the bound above).
#must_use
fn _km_ln_core(ui, ebias): (f64, f64, f64) {
    var t = ui - 0x3FE7FC0000000000;
    var e0 = t >>> 52;
    var ti = ((t >> 43) & 511) * 32;
    var mb = ui - (e0 << 52);
    var m: f64 = mb;
    var mhb = mb & 0xFFFFFFFFF0000000;
    var mh: f64 = mhb;
    var ml: f64 = m - mh;
    var c: f64 = load64(&_KM_CR_LN_T + ti);
    var lh: f64 = load64(&_KM_CR_LN_T + ti + 8);
    var lm: f64 = load64(&_KM_CR_LN_T + ti + 16);
    var r: f64 = ((mh * c) - 1.0) + (ml * c);
    var cc: f64 = r * 134217729.0;
    var ra: f64 = cc - (cc - r);
    var rb: f64 = r - ra;
    var t1: f64 = -0.5 * (ra * ra);             # −ra²/2, exact
    var nrb: f64 = -rb;
    var t2: f64 = nrb * (ra + (0.5 * rb));
    var c3: f64 = _KM_CR_LN_C3;
    var c4: f64 = _KM_CR_LN_C4;
    var c5: f64 = _KM_CR_LN_C5;
    var c6: f64 = _KM_CR_LN_C6;
    var c7: f64 = _KM_CR_LN_C7;
    var c8: f64 = _KM_CR_LN_C8;
    var z: f64 = r * r;
    var pz: f64 = ((c3 + (r * c4)) + (z * (c5 + (r * c6)))) + ((z * z) * (c7 + (r * c8)));   # Estrin
    var p: f64 = (z * r) * pz;
    var e = e0 + ebias;
    var ef: f64 = f64_from(e);
    var ln2h: f64 = _KM_CR_LN_LN2H;
    var ln2m: f64 = _KM_CR_LN_LN2M;
    var a: f64 = ef * ln2h;                      # exact: LN2H has 42 bits, |E| < 2^11
    var s0: f64 = a + lh;
    var d0: f64 = lh - (s0 - a);
    var s1: f64 = s0 + r;
    var d1: f64 = r - (s1 - s0);
    var s2: f64 = s1 + t1;
    var d2: f64 = t1 - (s2 - s1);
    var lo: f64 = (((ef * ln2m) + lm) + (t2 + p)) + ((d0 + d1) + d2);   # short chains (latency)
    var ap: f64 = f64_abs(p);
    var ah: f64 = f64_abs(s2);
    var ae: f64 = f64_abs(ef);
    var k49: f64 = 0x3CE0000000000000;          # 2^-49
    var k83: f64 = 0x3AC0000000000000;          # 2^-83
    var k93: f64 = 0x3A20000000000000;          # 2^-93
    var err: f64 = ((ap * k49) + (ah * k83)) + (ae * k93);
    return (s2, lo, err);
}

# ln(x), correctly rounded. ln(1) = +0, ln(±0) = −∞, ln(+∞) = +∞, NaN for NaN and x < 0 (−∞ included).
#must_use
fn _km_cr_ln(x: f64): f64 {
    var ui = load64(&x);
    # x ≤ 0 (the sign bit), subnormal, ∞ or NaN: ui − bits(DBL_MIN) is at least bits(∞) − bits(DBL_MIN) as an
    # unsigned word (the unsigned range test of _km_cr_exp).
    if (((ui - 0x0010000000000000) ^ 0x8000000000000000) >= 0xFFE0000000000000) {
        var w, okw = _km_cr_ln_fast(x);
        if (okw == 1) { return w; }
        var zw: f64 = _km_cr_ln_acc(x);
        return zw;
    }
    # _km_ln_core's body, inline (a call and its three-value return cost about 4 ns here).
    var t = ui - 0x3FE7FC0000000000;
    var e0 = t >>> 52;
    var ti = ((t >> 43) & 511) * 32;
    var mb = ui - (e0 << 52);
    var m: f64 = mb;
    var mhb = mb & 0xFFFFFFFFF0000000;
    var mh: f64 = mhb;
    var ml: f64 = m - mh;
    var c: f64 = load64(&_KM_CR_LN_T + ti);
    var lh: f64 = load64(&_KM_CR_LN_T + ti + 8);
    var lm: f64 = load64(&_KM_CR_LN_T + ti + 16);
    var r: f64 = ((mh * c) - 1.0) + (ml * c);
    var cc: f64 = r * 134217729.0;
    var ra: f64 = cc - (cc - r);
    var rb: f64 = r - ra;
    var t1: f64 = -0.5 * (ra * ra);             # −ra²/2, exact
    var nrb: f64 = -rb;
    var t2: f64 = nrb * (ra + (0.5 * rb));
    var c3: f64 = _KM_CR_LN_C3;
    var c4: f64 = _KM_CR_LN_C4;
    var c5: f64 = _KM_CR_LN_C5;
    var c6: f64 = _KM_CR_LN_C6;
    var c7: f64 = _KM_CR_LN_C7;
    var c8: f64 = _KM_CR_LN_C8;
    var z: f64 = r * r;
    var pz: f64 = ((c3 + (r * c4)) + (z * (c5 + (r * c6)))) + ((z * z) * (c7 + (r * c8)));   # Estrin
    var p: f64 = (z * r) * pz;
    var e = e0;
    var ef: f64 = f64_from(e);
    var ln2h: f64 = _KM_CR_LN_LN2H;
    var ln2m: f64 = _KM_CR_LN_LN2M;
    var a: f64 = ef * ln2h;                      # exact: LN2H has 42 bits, |E| < 2^11
    var s0: f64 = a + lh;
    var d0: f64 = lh - (s0 - a);
    var s1: f64 = s0 + r;
    var d1: f64 = r - (s1 - s0);
    var s2: f64 = s1 + t1;
    var d2: f64 = t1 - (s2 - s1);
    var lo: f64 = (((ef * ln2m) + lm) + (t2 + p)) + ((d0 + d1) + d2);   # short chains (latency)
    var ap: f64 = f64_abs(p);
    var ah: f64 = f64_abs(s2);
    var ae: f64 = f64_abs(ef);
    var k49: f64 = 0x3CE0000000000000;          # 2^-49
    var k83: f64 = 0x3AC0000000000000;          # 2^-83
    var k93: f64 = 0x3A20000000000000;          # 2^-93
    var err: f64 = ((ap * k49) + (ah * k83)) + (ae * k93);
    var u: f64 = s2 + (lo - err);
    var v: f64 = s2 + (lo + err);
    if (u == v) { return u; }
    var za: f64 = _km_cr_ln_acc(x);
    return za;
}

# The fast path alone, for every x (as _km_cr_exp_fast): the specials, a subnormal x scaled exactly by 2^54,
# then the core and its test, the operations of _km_cr_ln's inline path.
#must_use
fn _km_cr_ln_fast(x: f64): (f64, i64) {
    var ui = load64(&x);
    var eb = 0;
    if (((ui - 0x0010000000000000) ^ 0x8000000000000000) >= 0xFFE0000000000000) {
        if (x != x) { return (x, 1); }
        if (x == 0.0) {
            var m1: f64 = -1.0;
            var ninf: f64 = m1 / 0.0;
            return (ninf, 1);
        }
        if (x < 0.0) {
            var nan: f64 = _km_nan();           # the same quiet NaN on every target
            return (nan, 1);
        }
        if (x == _KM_INF) { return (x, 1); }
        var p54: f64 = 0x4350000000000000;      # 2^54
        var xs: f64 = x * p54;
        ui = load64(&xs);
        eb = 0 - 54;
    }
    var hi, lo, err = _km_ln_core(ui, eb);
    var u: f64 = hi + (lo - err);
    var v: f64 = hi + (lo + err);
    if (u == v) { return (u, 1); }
    return (0.0, 0);
}

# The accurate ln of a positive finite x ≠ 1 as a triple-double at out[0..2]: the fast path's E, j and the
# exact r; log1p(r) by Horner in triple-double on the exact r to r^16/16 (truncation 2^-144·|r|);
# E·ln 2 = E·LN2H (exact) + E·LN2M (TwoProduct) + E·LN2L (rounded, 2^-138); then E·ln2 + L_j + log1p(r)
# with at most 1.3 bits of cancellation. Measured relative error 2^-150.
fn _km_ln_acc_td(x: f64, out) {
    var ui = load64(&x);
    var eb = 0;
    if (ui < 0x0010000000000000) {
        var p54: f64 = 0x4350000000000000;
        var xs: f64 = x * p54;
        ui = load64(&xs);
        eb = 0 - 54;
    }
    var t = ui - 0x3FE7FC0000000000;
    var e0 = t >>> 52;
    var ti = ((t >> 43) & 511) * 32;
    var mb = ui - (e0 << 52);
    var m: f64 = mb;
    var mhb = mb & 0xFFFFFFFFF0000000;
    var mh: f64 = mhb;
    var ml: f64 = m - mh;
    var c: f64 = load64(&_KM_CR_LN_T + ti);
    var r: f64 = ((mh * c) - 1.0) + (ml * c);
    var sh: f64 = load64(&_KM_CR_LN_ACC + 336);     # −1/16 (index 3·(16 − 2))
    var sm: f64 = load64(&_KM_CR_LN_ACC + 344);
    var sl: f64 = load64(&_KM_CR_LN_ACC + 352);
    var n = 15;
    while (n >= 2) {
        var th, tm, tl = _km_td_mul_d(sh, sm, sl, r);
        var off = (n - 2) * 24;
        var ch: f64 = load64(&_KM_CR_LN_ACC + off);
        var cm: f64 = load64(&_KM_CR_LN_ACC + off + 8);
        var cl: f64 = load64(&_KM_CR_LN_ACC + off + 16);
        var uh, um, ul = _km_td_add(ch, cm, cl, th, tm, tl);
        sh = uh;
        sm = um;
        sl = ul;
        n = n - 1;
    }
    var vh, vm, vl = _km_td_mul_d(sh, sm, sl, r);
    var wh, wm, wl = _km_td_add_d(vh, vm, vl, 1.0);
    var ph, pm, pl = _km_td_mul_d(wh, wm, wl, r);       # log1p(r)
    var lh: f64 = load64(&_KM_CR_LN_T + ti + 8);
    var lm: f64 = load64(&_KM_CR_LN_T + ti + 16);
    var ll: f64 = load64(&_KM_CR_LN_T + ti + 24);
    var ef: f64 = f64_from(e0 + eb);
    var ln2h: f64 = _KM_CR_LN_LN2H;
    var ln2m: f64 = _KM_CR_LN_LN2M;
    var ln2l: f64 = _KM_CR_LN_LN2L;
    var a0: f64 = ef * ln2h;
    var a1, a1e = _km_two_prod(ef, ln2m);
    var a2: f64 = ef * ln2l;
    var h0, u0 = _km_fast_two_sum(a0, a1);
    var a12: f64 = a1e + a2;
    var m0, l0 = _km_two_sum(u0, a12);
    var bh, bm, bl = _km_td_add(h0, m0, l0, lh, lm, ll);
    var zh, zm, zl = _km_td_add(bh, bm, bl, ph, pm, pl);
    store64(out, zh);
    store64(out + 8, zm);
    store64(out + 16, zl);
}

# ln by the accurate path alone, for every x.
#must_use
fn _km_cr_ln_acc(x: f64): f64 {
    if (x != x) { return x; }
    if (x == 0.0) {
        var m1: f64 = -1.0;
        var ninf: f64 = m1 / 0.0;
        return ninf;
    }
    if (x < 0.0) {
        var nan: f64 = _km_nan();               # the same quiet NaN on every target
        return nan;
    }
    if (x == _KM_INF) { return x; }
    if (x == 1.0) { return 0.0; }
    var buf: f64[3];
    _km_ln_acc_td(x, &buf);
    var r: f64 = _km_rn3(buf[0], buf[1], buf[2]);
    return r;
}

# log10(x), correctly rounded. log10(10^k) = k (k = 0 … 22), log10(1) = +0, log10(±0) = −∞, log10(+∞) = +∞,
# NaN for NaN and x < 0. The ln core's (hi, lo, ε), then (hi + lo)·(IVH + IVM) (Dekker's product with IVH
# pre-split) and the rounding test, else the accurate path.
#must_use
fn _km_cr_log10(x: f64): f64 {
    var ui = load64(&x);
    var eb = 0;
    if (((ui - 0x0010000000000000) ^ 0x8000000000000000) >= 0xFFE0000000000000) {   # as in _km_cr_ln
        if (x != x) { return x; }
        if (x == 0.0) {
            var m1: f64 = -1.0;
            var ninf: f64 = m1 / 0.0;
            return ninf;
        }
        if (x < 0.0) {
            var nan: f64 = _km_nan();
            return nan;
        }
        if (x == _KM_INF) { return x; }
        var p54: f64 = 0x4350000000000000;          # a subnormal x, scaled exactly by 2^54
        var xs: f64 = x * p54;
        ui = load64(&xs);
        eb = 0 - 54;
    }
    var hi, lo, eln = _km_ln_core(ui, eb);
    var ivh: f64 = _KM_CR_LN_IVH;
    var ivm: f64 = _KM_CR_LN_IVM;
    var i1: f64 = _KM_CR_LN_IVH1;
    var i2: f64 = _KM_CR_LN_IVH2;
    var ph: f64 = hi * ivh;
    var c: f64 = 134217729.0 * hi;
    var h1: f64 = c - (c - hi);
    var h2: f64 = hi - h1;
    var pe: f64 = ((((h1 * i1) - ph) + (h1 * i2)) + (h2 * i1)) + (h2 * i2);
    var pl: f64 = pe + ((hi * ivm) + (lo * ivh));
    # The error: 0.4343·(ln's error) plus the product's roundings (hi·IVM, lo·IVH, pl's sum, the test's own:
    # below 2^-52.4·|lo| + 2^-101·|ph|, which eln's slack and 0.5 − 0.4343 cover) and IVL (2^-111·|ln x|):
    # err10 = eln/2 + 2^-100·|ph|.
    var ap: f64 = f64_abs(ph);
    var k100: f64 = 0x39B0000000000000;     # 2^-100
    var err: f64 = (eln * 0.5) + (ap * k100);
    var u: f64 = ph + (pl - err);
    var v: f64 = ph + (pl + err);
    if (u == v) { return u; }
    var z: f64 = _km_cr_log10_acc(x);
    return z;
}

# The fast path alone: (its result, 1), or (0, 0) when its rounding test fails; the same operations as
# _km_cr_log10 (used by the tests and scripts/oracle/cr_verify.py).
#must_use
fn _km_cr_log10_fast(x: f64): (f64, i64) {
    var ui = load64(&x);
    var eb = 0;
    if (((ui - 0x0010000000000000) ^ 0x8000000000000000) >= 0xFFE0000000000000) {   # as in _km_cr_ln
        if (x != x) { return (x, 1); }
        if (x == 0.0) {
            var m1: f64 = -1.0;
            var ninf: f64 = m1 / 0.0;
            return (ninf, 1);
        }
        if (x < 0.0) {
            var nan: f64 = _km_nan();
            return (nan, 1);
        }
        if (x == _KM_INF) { return (x, 1); }
        var p54: f64 = 0x4350000000000000;          # a subnormal x, scaled exactly by 2^54
        var xs: f64 = x * p54;
        ui = load64(&xs);
        eb = 0 - 54;
    }
    var hi, lo, eln = _km_ln_core(ui, eb);
    var ivh: f64 = _KM_CR_LN_IVH;
    var ivm: f64 = _KM_CR_LN_IVM;
    var i1: f64 = _KM_CR_LN_IVH1;
    var i2: f64 = _KM_CR_LN_IVH2;
    var ph: f64 = hi * ivh;
    var c: f64 = 134217729.0 * hi;
    var h1: f64 = c - (c - hi);
    var h2: f64 = hi - h1;
    var pe: f64 = ((((h1 * i1) - ph) + (h1 * i2)) + (h2 * i1)) + (h2 * i2);
    var pl: f64 = pe + ((hi * ivm) + (lo * ivh));
    # The error: 0.4343·(ln's error) plus the product's roundings (hi·IVM, lo·IVH, pl's sum, the test's own:
    # below 2^-52.4·|lo| + 2^-101·|ph|, which eln's slack and 0.5 − 0.4343 cover) and IVL (2^-111·|ln x|):
    # err10 = eln/2 + 2^-100·|ph|.
    var ap: f64 = f64_abs(ph);
    var k100: f64 = 0x39B0000000000000;     # 2^-100
    var err: f64 = (eln * 0.5) + (ap * k100);
    var u: f64 = ph + (pl - err);
    var v: f64 = ph + (pl + err);
    if (u == v) { return (u, 1); }
    return (0.0, 0);
}

# log10 by the accurate path alone: the triple-double ln times 1/ln 10 = IVH + IVM + IVL.
#must_use
fn _km_cr_log10_acc(x: f64): f64 {
    if (x != x) { return x; }
    if (x == 0.0) {
        var m1: f64 = -1.0;
        var ninf: f64 = m1 / 0.0;
        return ninf;
    }
    if (x < 0.0) {
        var nan: f64 = _km_nan();               # the same quiet NaN on every target
        return nan;
    }
    if (x == _KM_INF) { return x; }
    if (x == 1.0) { return 0.0; }
    var buf: f64[3];
    _km_ln_acc_td(x, &buf);
    var ivh: f64 = _KM_CR_LN_IVH;
    var ivm: f64 = _KM_CR_LN_IVM;
    var ivl: f64 = _KM_CR_LN_IVL;
    var zh, zm, zl = _km_td_mul(buf[0], buf[1], buf[2], ivh, ivm, ivl);
    var r: f64 = _km_rn3(zh, zm, zl);
    return r;
}

# ── pow (M3c-2b) ────────────────────────────────────────────────────────────────────────────────
#
# |x|^y = e^(y·ln|x|), on the ln and exp machinery above.
# - Fast path: (lh, ll, eln) from the ln core (|lh + ll − ln|x|| < eln, absolute); z = y·(lh + ll) as zh + zl
#   (Dekker's product of y and lh, both split; y·ll rounded; renormalised so |zl| ≤ 2^-44), with
#   |zh + zl − y·ln|x|| ≤ |y|·eln + 2^-100·|zh| (the product's roundings are below 2^-105·|zh| plus a
#   2^-53·|y·ll| that the slack in eln covers); exp's core on zh + zl (its 0.9·2^-70 bound on the value in
#   [0.9993, 1.9987]); so the test's bound is err = 2.0625·(|y|·eln + 2^-100·|zh|) + 2^-69 on that value,
#   through _km_exp_fin (subnormal results tested on the subnormal grid and rounded once, the overflow end in
#   two scales). zh > 710 is +∞ and zh < −746 is +0 for certain. Near x = 1 eln is about
#   (2^-50.6·r² + 2^-83)·|ln x|, so the bound on z is that times |z| ≤ 746: x within 2^-10 of 1 with a large
#   |y·ln x| keeps a fallback rate that falls as r²; CORE-MATH's first phase has the same shape (2^-57.6 for x
#   in (1/√2, √2), Hubrecht, Jeannerod and Zimmermann, ARITH 2023). Measured: actual error at most 0.32 of
#   the bound over 150,000 pairs (x near 1 with huge y included), against 400-bit MPFR.
# - Exact and midpoint results are found before the accurate path rounds (_km_pow_exact, below); the fast
#   path needs no check, since an exact double is half an ulp from every midpoint and the interval around a
#   midpoint always straddles it (the test fails and the accurate path decides).
# - Accurate path: ln|x| in triple-double (relative error below 2^-142 by the operation count, measured
#   2^-150), times y (TwoProducts, 2^-153), e^z by exp's accurate core (2^-150) and _km_cr_finish: below
#   2^-130 relative overall (|z| ≤ 746 amplifies ln's error by at most 2^9.6), measured 2^-140.
#   What that rests on: pow's hardest-to-round cases are not known (there are about 2^126 argument pairs, too
#   many to search); CORE-MATH's pow (ibid.) has a third phase at 256 bits that reports an error rather than
#   misround when even that fails. This accurate path is correct for every pair whose x^y is not exact, not a
#   midpoint, and not within 2^-130 of one: that covers every published hard case (the worst, CRLIBM's
#   failure at x = 0x1.524ebae943097p+1, y = 0x1.ep-2, has 64 identical bits after the round bit and needs
#   2^-118; LIBMCR's at x = 0x1.f80b060553772p-1, y = 0x1.99cp+13 needs 2^-103) and every pair the
#   verification met, but it is not a proof for all 2^126 pairs. A random pair is that close with
#   probability about 2^-76.
# Special values are C99 Annex F's (glibc's pow, which Rust's f64::powf calls): pow(x, ±0) = 1 and
# pow(+1, y) = 1 for every x and y, NaN included; pow(−1, ±∞) = 1; otherwise a NaN argument gives NaN;
# ±0 and ±∞ bases by the sign of y and the parity of an integer y; a negative finite x with an integer y takes
# the sign from y's parity (|y| ≥ 2^53 is even); a negative finite x with a non-integer y is NaN.

# (1 if y is an integer, 1 if y is an odd integer) for a finite y ≠ 0: y = M·2^(f − 1075) with the 53-bit
# significand M; integer when no set bit of M lies below 2^(1075 − f).
#must_use
fn _km_pow_yclass(y: f64): (i64, i64) {
    var uy = load64(&y) & 0x7FFFFFFFFFFFFFFF;
    var f = uy >> 52;
    var m = (uy & 0x000FFFFFFFFFFFFF) | 0x0010000000000000;
    if (f >= 1075) {
        if (f == 1075) { return (1, m & 1); }
        return (1, 0);                           # |y| ≥ 2^53: even
    }
    if (f < 1023) { return (0, 0); }             # 0 < |y| < 1
    var sh = 1075 - f;
    if ((m & ((1 << sh) - 1)) != 0) { return (0, 0); }
    return (1, (m >> sh) & 1);
}

# RN(mm·2^s) for an integer 1 ≤ mm < 2^62 and an integer |s| < 2^40, by integer rounding: ties to even,
# subnormal results on the 2^-1074 grid, +∞ past DBL_MAX, +0 below half of 2^-1074. Exact, so it rounds exact
# results and exact midpoints right.
#must_use
fn _km_cr_from_int(mm, s): f64 {
    var b = 0;
    var t = mm;
    while (t != 0) {
        t = t >> 1;
        b = b + 1;
    }
    var top = s + b - 1;                         # the exponent of mm·2^s's leading bit
    if (top > 1023) {
        var inf: f64 = _KM_INF;
        return inf;
    }
    var lsb = top - 52;                          # the result's last bit, at most 53 bits and not below 2^-1074
    if (lsb < 0 - 1074) { lsb = 0 - 1074; }
    var sh = lsb - s;
    var q = mm;
    if (sh > 0) {
        if (sh > 62) { return 0.0; }
        q = mm >> sh;
        var rem = mm - (q << sh);
        var half = 1 << (sh - 1);
        if (rem > half || (rem == half && (q & 1) == 1)) { q = q + 1; }
    } else {
        lsb = s;
    }
    var qf: f64 = f64_from(q);                   # q ≤ 2^53: exact
    if (lsb >= 0 - 1022) {
        var sc: f64 = _km_cr_pow2(lsb);
        var r: f64 = qf * sc;                    # exact, or +∞ when q·2^lsb = 2^1024
        return r;
    }
    var s1: f64 = _km_cr_pow2(lsb + 1074);       # q·2^lsb = ((q·2^(lsb + 1074))·2^-52)·2^-1022: each step exact
    var s2: f64 = _km_cr_pow2(0 - 52);
    var s3: f64 = _km_cr_pow2(0 - 1022);
    var w: f64 = ((qf * s1) * s2) * s3;
    return w;
}

# M^n for odd integers M ≥ 3 and n ≥ 1, or 0 when it reaches 2^54.
#must_use
fn _km_pow_int54(mm, n): i64 {
    var acc = 1;
    var i = 0;
    while (i < n) {
        if (acc > (0x0040000000000000 / mm)) { return 0; }
        acc = acc * mm;
        i = i + 1;
    }
    if (acc >= 0x0040000000000000) { return 0; }
    return acc;
}

# (1, RN(x^y)) when x^y is an exact double or an exact midpoint (or another value known exactly), else (0, 0);
# x > 0 finite, y finite with 0 < |y| < 2^64. After Lauter and Lefèvre ("An efficient rounding boundary test for
# pow(x, y) in double precision", IEEE TC 2009) and CORE-MATH's pow. Write x = mx·2^ex and y = ±my·2^fy with mx,
# my odd. y is a double, so in lowest terms y = p/2^k (k = max(0, −fy)). If x^y = R is rational then
# R^(2^k) = x^p: when p > 0, unique factorisation makes mx a perfect 2^k-th power, mx = a^(2^k), with 2^k | ex,
# and R = a^p·2^(ex·p/2^k); when p < 0, R's odd part 1/a^|p| is dyadic only for a = 1, mx = 1. A double or a
# midpoint has an odd part below 2^54, so beyond these cases x^y is neither: mx = 1 gives a power of two
# 2^(ex·y) (exact, the tie 2^-1075, or out of range); mx ≥ 3 needs p > 0, a^p < 2^54 (so p ≤ 34) and
# a^(2^k) = mx < 2^53 (so k ≤ 5). In particular y = RN(1/3) has k = 54: x^y is never exact unless x = 1.
#must_use
fn _km_pow_exact(ax: f64, y: f64): (i64, f64) {
    var ux = load64(&ax);
    var mx = ux & 0x000FFFFFFFFFFFFF;
    var ex = 0 - 1074;
    if ((ux >> 52) != 0) {
        mx = mx | 0x0010000000000000;
        ex = (ux >> 52) - 1075;
    }
    while ((mx & 1) == 0) {
        mx = mx >> 1;
        ex = ex + 1;
    }
    var uy = load64(&y);
    var sy = 1;
    if (uy < 0) { sy = 0 - 1; }
    var ay = uy & 0x7FFFFFFFFFFFFFFF;
    var my = ay & 0x000FFFFFFFFFFFFF;
    var fy = 0 - 1074;
    if ((ay >> 52) != 0) {
        my = my | 0x0010000000000000;
        fy = (ay >> 52) - 1075;
    }
    while ((my & 1) == 0) {
        my = my >> 1;
        fy = fy + 1;
    }
    if (fy >= 0) {                               # y an integer: |y| = my·2^fy
        if (fy >= 12 || my >= 4096) { return (0, 0.0); }   # |y| ≥ 4096: 2^(ex·y) and mx^y are out of reach
        var yi = my << fy;
        if (yi >= 4096) { return (0, 0.0); }
        if (mx == 1) {
            var r1: f64 = _km_cr_from_int(1, ex * yi * sy);
            return (1, r1);
        }
        if (sy < 0) { return (0, 0.0); }
        if (yi > 34) { return (0, 0.0); }
        var mm = _km_pow_int54(mx, yi);
        if (mm == 0) { return (0, 0.0); }
        var r2: f64 = _km_cr_from_int(mm, ex * yi);
        return (1, r2);
    }
    var k = 0 - fy;                              # y = ±my/2^k, k ≥ 1
    var q = 0;
    if (k >= 11) {
        if (ex != 0) { return (0, 0.0); }        # |ex| < 2^11: 2^k ∤ ex
    } else {
        if ((ex & ((1 << k) - 1)) != 0) { return (0, 0.0); }
        q = ex >>> k;
    }
    if (mx == 1) {
        if (q == 0) { return (1, 1.0); }         # x = 1
        if (my >= 4096) { return (0, 0.0); }     # |ex·y| ≥ my: out of range
        var r3: f64 = _km_cr_from_int(1, q * my * sy);
        return (1, r3);
    }
    if (k > 5 || sy < 0 || my > 34) { return (0, 0.0); }
    var a = mx;
    var i = 0;
    while (i < k) {                              # a = mx^(1/2^k), each root exact or none
        var af: f64 = f64_from(a);
        var sf: f64 = f64_sqrt(af);
        var si = f64_to(sf);
        if (si * si != a) { return (0, 0.0); }
        a = si;
        i = i + 1;
    }
    var m2 = _km_pow_int54(a, my);
    if (m2 == 0) { return (0, 0.0); }
    var r4: f64 = _km_cr_from_int(m2, q * my);
    return (1, r4);
}

# The fast kernel for x > 0 finite (bits ux, a subnormal included) and finite y with 0 < |y| < 2^64:
# (RN(x^y), 1), or (0, 0) when the rounding test fails.
#must_use
fn _km_pow_pos_fast(ux, y: f64): (f64, i64) {
    var ui = ux;
    var eb = 0;
    if (ui < 0x0010000000000000) {               # a subnormal x, scaled exactly by 2^54
        var xf: f64 = ui;
        var p54: f64 = 0x4350000000000000;
        var xs: f64 = xf * p54;
        ui = load64(&xs);
        eb = 0 - 54;
    }
    var lh, ll, eln = _km_ln_core(ui, eb);
    var zh0: f64 = y * lh;                       # z = y·(lh + ll): Dekker's product, both factors split
    var cy: f64 = 134217729.0 * y;
    var y1: f64 = cy - (cy - y);
    var y2: f64 = y - y1;
    var cl: f64 = 134217729.0 * lh;
    var l1: f64 = cl - (cl - lh);
    var l2: f64 = lh - l1;
    var ze: f64 = ((((y1 * l1) - zh0) + (y1 * l2)) + (y2 * l1)) + (y2 * l2);
    var zl0: f64 = ze + (y * ll);
    var zh: f64 = zh0 + zl0;                     # renormalised (Fast2Sum): |zl| ≤ 2^-44
    var zl: f64 = zl0 - (zh - zh0);
    var azh: f64 = f64_abs(zh);
    if (azh > 708.0) {
        if (zh > 710.0) {
            var inf: f64 = _KM_INF;
            return (inf, 1);
        }
        if (zh < -746.0) { return (0.0, 1); }
    }
    var ay: f64 = f64_abs(y);
    var k100: f64 = 0x39B0000000000000;          # 2^-100
    var k69: f64 = 0x3BA0000000000000;           # 2^-69
    var errz: f64 = (ay * eln) + (azh * k100);
    var err: f64 = (errz * 2.0625) + k69;
    var hi, lo, e = _km_exp_core(zh, zl);
    if (e > 0 - 1022 && e < 1024) {             # a normal result: _km_exp_fin's first case, inline
        var u: f64 = hi + (lo - err);
        var v: f64 = hi + (lo + err);
        if (u != v) { return (0.0, 0); }
        var sb = (e + 1023) << 52;
        var sc: f64 = sb;
        var rn: f64 = u * sc;
        return (rn, 1);
    }
    var ok, r = _km_exp_fin(hi, lo, e, err);
    return (r, ok);
}

# The accurate kernel for the same arguments: an exact or midpoint result exactly, else the triple-double path.
#must_use
fn _km_pow_pos_acc(ax: f64, y: f64): f64 {
    var found, rx = _km_pow_exact(ax, y);
    if (found == 1) { return rx; }
    var lb: f64[3];
    _km_ln_acc_td(ax, &lb);
    var z0, z1, z2 = _km_td_mul_d(lb[0], lb[1], lb[2], y);
    if (z0 > 710.0) {
        var inf: f64 = _KM_INF;
        return inf;
    }
    if (z0 < -746.0) { return 0.0; }
    var eb: f64[3];
    var e = _km_exp_acc_core(z0, z1, z2, &eb);
    var r: f64 = _km_cr_finish(e, eb[0], eb[1], eb[2]);
    return r;
}

# Every argument outside the fast path's common case (x positive normal, 0 < |y| < 2^64): the special values,
# a negative x (the sign from y's parity), a subnormal x, |y| ≥ 2^64. acc = 0 runs the fast kernel, 1 the
# accurate one; (result, 1), or (0, 0) when the fast kernel's test fails.
#must_use
fn _km_pow_cases(x: f64, y: f64, acc): (f64, i64) {
    if (y == 0.0) { return (1.0, 1); }           # pow(x, ±0) = 1, x NaN included
    if (x == 1.0) { return (1.0, 1); }           # pow(+1, y) = 1, y NaN included
    if (x != x) { return (x, 1); }
    if (y != y) { return (y, 1); }
    var ax: f64 = f64_abs(x);
    var ay: f64 = f64_abs(y);
    var inf: f64 = _KM_INF;
    if (ay == inf) {
        if (ax == 1.0) { return (1.0, 1); }      # pow(−1, ±∞) = 1
        if (ax < 1.0) {
            if (y > 0.0) { return (0.0, 1); }
            return (inf, 1);
        }
        if (y > 0.0) { return (inf, 1); }
        return (0.0, 1);
    }
    var yint, yodd = _km_pow_yclass(y);
    if (ax == 0.0) {
        if (y < 0.0) {
            if (yodd == 1) {
                var pz: f64 = 1.0 / x;           # ±∞ with x's sign
                return (pz, 1);
            }
            return (inf, 1);
        }
        if (yodd == 1) { return (x, 1); }        # ±0
        return (0.0, 1);
    }
    if (ax == inf) {
        var res: f64 = inf;
        if (y < 0.0) { res = 0.0; }
        if (x < 0.0 && yodd == 1) { res = -res; }
        return (res, 1);
    }
    var neg = 0;
    if (x < 0.0) {
        if (yint == 0) {
            var nan: f64 = _km_nan();
            return (nan, 1);
        }
        neg = yodd;
    }
    var r: f64 = 0.0;
    var ok = 1;
    var big: f64 = 0x43F0000000000000;           # 2^64: |y·ln|x|| ≥ 2^64·2^-53 > 746 unless |x| = 1
    if (ay >= big) {
        if (ax == 1.0) {
            r = 1.0;
        } else {
            r = 0.0;
            if ((ax > 1.0) == (y > 0.0)) { r = inf; }
        }
    } else {
        if (acc == 1) {
            r = _km_pow_pos_acc(ax, y);
        } else {
            var rf, okf = _km_pow_pos_fast(load64(&ax), y);
            r = rf;
            ok = okf;
        }
    }
    if (neg == 1) { r = -r; }
    return (r, ok);
}

# pow(x, y) = x^y, correctly rounded, with the special values above. Mirrors `f64::powf`.
#must_use
fn _km_cr_pow(x: f64, y: f64): f64 {
    var ux = load64(&x);
    var ay = load64(&y) & 0x7FFFFFFFFFFFFFFF;
    # The common case of _km_cr_pow_fast, dispatched here to save a call: x in [DBL_MIN, DBL_MAX] and
    # 0 < |y| < 2^64.
    if (((ux - 0x0010000000000000) ^ 0x8000000000000000) < 0xFFE0000000000000) {
        if (((ay - 1) ^ 0x8000000000000000) < 0xC3EFFFFFFFFFFFFF) {
            var r, ok = _km_pow_pos_fast(ux, y);
            if (ok == 1) { return r; }
            var a: f64 = _km_pow_pos_acc(x, y);
            return a;
        }
    }
    var r2, ok2 = _km_pow_cases(x, y, 0);
    if (ok2 == 1) { return r2; }
    var a2: f64 = _km_cr_pow_acc(x, y);
    return a2;
}

# The fast path alone: (its result, 1), or (0, 0) when its rounding test fails.
#must_use
fn _km_cr_pow_fast(x: f64, y: f64): (f64, i64) {
    var ux = load64(&x);
    var ay = load64(&y) & 0x7FFFFFFFFFFFFFFF;
    # x in [DBL_MIN, DBL_MAX] and 0 < |y| < 2^64, as unsigned range tests (the trick of _km_cr_exp).
    if (((ux - 0x0010000000000000) ^ 0x8000000000000000) < 0xFFE0000000000000) {
        if (((ay - 1) ^ 0x8000000000000000) < 0xC3EFFFFFFFFFFFFF) {
            var r, ok = _km_pow_pos_fast(ux, y);
            return (r, ok);
        }
    }
    var r2, ok2 = _km_pow_cases(x, y, 0);
    return (r2, ok2);
}

# pow by the accurate path alone, for every (x, y).
#must_use
fn _km_cr_pow_acc(x: f64, y: f64): f64 {
    var r, ok = _km_pow_cases(x, y, 1);
    return r;
}

# ── sin and cos (M4a) ───────────────────────────────────────────────────────────────────────────
#
# sin x = sgn(x)·sin|x| and cos x = cos|x|; f(|x|) = ±sin r or ±cos r with |x| = k·π/2 + r, |r| ≤ π/4 + 2^-30.
# - |x| < 2^-26: sin x rounds to x (0 < |x| − |sin x| < |x|³/6 < 2^-54·|x|, below the distance from x to the
#   midpoint under it, which is at least 2^-54·|x|; subnormals and ±0 included); |x| < 2^-27: cos x rounds to 1
#   (1 − cos x < x²/2 < 2^-55, inside 1's rounding interval). sin and cos are transcendental at every algebraic
#   x ≠ 0 (Lindemann–Weierstrass), so nothing else is exact or a tie. NaN gives that NaN, ±∞ the quiet NaN.
# - Reduction, 2^-27 ≤ |x| < 2^20 (Cody–Waite): k = RN(|x|·2/π) by the 1.5·2^52 shift (|k| < 2^20); π/2 =
#   P1 + P2 + P3 + P4 + P5 with P1, P2 at 33 bits, so k·P1 and k·P2 are exact, and |x| − k·P1 is exact (a
#   multiple of min(ulp(x), 2^-32) below 1 in magnitude). Fast path: (|x| − k·P1) − k·P2 = s + e (TwoSum),
#   w = e − k·P3, rh + rl = s + w (Fast2Sum, so |rl| ≤ 2^-53·|rh|), with an absolute error below
#   |k|·2^-119.7 + 2^-106·|r| (the tail k·(P4 + P5 + …), k·P3's and w's roundings). Accurate path: the same
#   with all five parts in triple-double (k·P3, k·P4, k·P5 by TwoProduct): each step's error is below 2^-159
#   of the running sum r + k·(P_(i+1) + …), at most |r| + 2^-48, so the error is below 2^-156·|r| + 2^-200.
#   |x| ≥ 2^20 (Payne–Hanek, _km_ph_reduce): x·2/π mod 4 from 288 bits of 2/π, to 2^-233 absolute.
#   No double is within 2^-61 of a nonzero multiple of π/2 (Lefèvre and Muller, "Worst cases for correct
#   rounding of the elementary functions in double precision", 2003, §2.3: the closest is
#   6381956970095103·2^797, 4.687·10^-19 away; mathx_tables.py re-derives that bound binade by binade from the
#   continued fraction of 2^(e−52)·2/π), so the accurate reduction is good to 2^-139 relative (2^-172 for
#   Payne–Hanek), whatever x.
# - Evaluation: r = a + t with a = i/256, i = RN(256·r) (|i| ≤ 201), |t| ≤ 2^-9; f = U·cos t + V·sin t with
#   (U, V) = (sin a, cos a) for ±sin r and (cos a, −sin a) for ±cos r, from the table _KM_CR_SC_T (each value
#   A + B + C + D, A at 26 bits). Fast path: t = th + rl (th = rh − a, exact), th = t1 + t2 with t1 on the
#   2^-36 grid (27 bits; t1 = th when i = 0, where V is 0 or ±1), so V_A·t1 is exact and U_A + V_A·t1 =
#   hi + e1 (Fast2Sum, |U_A| ≥ |V_A·t1| or U_A = 0);
#   lo = e1 + V_A·t2 + V_B·th + V·(sin th − th) + rl·(V − U·th) + U_B + U·(cos th − 1),
#   sin th − th = th³(−1/6 + th²/120 − th⁴/5040) (truncation 2^-99.5) and cos th − 1 = th²(−1/2 + th²/24 −
#   th⁴/720) (2^-87.3), the large U terms added last. Error: |U|·2^-69.0 (U·(cos th − 1): 5.02 roundings of a
#   term below |U|·2^-19; the last two sums; the test's own rounding of lo ∓ err) + |V|·2^-79.1 (the sin
#   terms) + 2^-71.8·|f| (the neglected V·rl·(cos th − 1), below 2^-72·|V|·|rh|) + the reduction's error (the
#   derivative is at most 1.002). |U|/|f| ≤ 2 (at i = 1, sin type) and |V|·2^-79 ≤ 2^-70·|f| unless i = 0,
#   where every V term is relative to |f| ≈ |th|; so the test's bound err = 2^-68·|U_A| + 2^-69·|hi| + 2^-119·|k|
#   covers it with half a bit to spare. The result is never subnormal (|f| > 2^-62 by the reduction bound).
#   Measured: the error is at most 0.17 of err (2^-70.0 relative) over 750,000 arguments against 400-bit MPFR;
#   the fast test fails on 7·10^-5 (sin) and 9·10^-5 (cos) of scripts/oracle/cr_verify.py's arguments.
# - Accurate path: t in triple-double, sin t = t·Σ (−t²)^n/(2n + 1)! to n = 6 (truncation 2^-166 relative)
#   and cos t = Σ (−t²)^n/(2n)! to n = 6 (2^-162), Horner in triple-double on _KM_CR_EXP_ACC's 1/k!, then
#   U·cos t + V·sin t (at most one bit of cancellation: |t| ≤ |a|/2 when i ≠ 0) and _km_rn3. Below 2^-148
#   relative by the operation count when |r| ≥ 2^-10 (2^-146 at |r| = 2^-53.9, sin(RN(π/2 + kπ)) for small k), and
#   2^-138 at worst (the reduction); measured 2^-156.7 against 400-bit MPFR, the doubles closest to a multiple of
#   π/2 in every binade included.
# What that rests on: Lefèvre and Muller (2003, Property 5 and Tables 8 and 10) give the worst cases of sin on
# [2^-24, 2 + 4675/8192] (a mantissa distance of 2^-126 suffices: 0 0^72 after the round bit at
# 0x1.e0000000001c2p-20) and of cos on [2^-25, 12867/8192] (2^-142: 0 0^88 at 0x1.8000000000009p-23); a
# relative error ρ gives a mantissa distance below 2ρ, and the accurate path is below 2^-146 relative on those
# ranges (r = x for |x| ≤ π/4; beyond, |r| ≥ 2^-53.9 for sin and ≥ 2^-13.3 for cos). Outside them no exhaustive
# search exists; Hanrot, Lefèvre, Stehlé and Zimmermann ("Worst cases of a periodic function for large
# arguments", ARITH 18, 2007) found sin(5501214608935005·2^971) with 0^45 after the 53 bits in [2^1023, 2^1024).
# The expected hardest case over all 2^63 doubles needs about 2^-(53 + 64); 2^-138 is 21 bits past it.
# Entry points as for exp: _km_cr_sin / _km_cr_cos / _km_cr_sincos, _km_cr_<f>_fast (the fast path's result
# and 1, or 0 and 0 when its test fails) and _km_cr_<f>_acc (the accurate path alone).

# Payne–Hanek reduction for 2^20 ≤ x < 2^1024 (bits ux of a positive finite x): returns k with x·2/π = k + f,
# |f| ≤ 1/2 (only k mod 4 is meaningful), and r = f·π/2 as a triple-double at out[0..2]. x = m·2^e (m the 53-bit
# significand, e ≥ −32); bits j < e − 1 of 2/π add multiples of 4 to m·2^e·2/π and are skipped, the 288 bits
# from e − 1 on are W (9 limbs of 32 bits from _KM_CR_TWOPI), the rest add below m·2^(e − (e − 1) − 287) =
# m·2^-286 < 2^-233. m·W mod 2^288 is computed exactly in base-2^32 columns (each product of 32-bit halves fits
# 64 bits, unsigned); its top 2 bits are k mod 4, the next 286 the fraction, centred into [−1/2, 1/2) by a
# two's-complement negation, then summed limb by limb into a triple-double (each step's error below 2^-155 of
# the sum) and multiplied by π/2 (2^-153).
fn _km_ph_reduce(ux, out): i64 {
    var m = (ux & 0x000FFFFFFFFFFFFF) | 0x0010000000000000;
    var e = (ux >> 52) - 1075;
    var m1 = m >> 32;
    var m0 = m & 0xFFFFFFFF;
    var p = e + 62;                               # bit e − 1 of 2/π sits at position e − 1 + 63 of the table
    var w = p >> 5;
    var s = p & 31;
    var col: i64[10];
    var k = 0;
    while (k < 10) {
        col[k] = 0;
        k = k + 1;
    }
    k = 0;
    while (k < 9) {                               # limb k (weight 2^(32k)) is window word 8 − k
        var hw = load64(&_KM_CR_TWOPI + 8 * (w + 8 - k));
        var lw = load64(&_KM_CR_TWOPI + 8 * (w + 9 - k));
        var v = ((hw << s) | (lw >> (32 - s))) & 0xFFFFFFFF;
        var a = m0 * v;                           # < 2^64: the exact product, as an unsigned word
        var b = m1 * v;                           # < 2^53
        col[k] = col[k] + (a & 0xFFFFFFFF);
        col[k + 1] = col[k + 1] + (a >> 32) + (b & 0xFFFFFFFF);
        if (k < 8) { col[k + 2] = col[k + 2] + (b >> 32); }
        k = k + 1;
    }
    k = 0;
    while (k < 8) {                               # carries; each column is below 2^35
        col[k + 1] = col[k + 1] + (col[k] >> 32);
        col[k] = col[k] & 0xFFFFFFFF;
        k = k + 1;
    }
    var top = col[8] & 0xFFFFFFFF;
    var q = top >> 30;
    col[8] = top & 0x3FFFFFFF;
    var neg = 0;
    if ((top & 0x20000000) != 0) {                # f ≥ 1/2: f − 1 = −(2^286 − F)·2^-286
        neg = 1;
        q = q + 1;
        var c = 1;
        k = 0;
        while (k < 9) {
            var mask = 0xFFFFFFFF;
            if (k == 8) { mask = 0x3FFFFFFF; }
            var t = (mask - col[k]) + c;
            col[k] = t & mask;
            c = t >> 32;
            k = k + 1;
        }
    }
    var lead: f64 = f64_from(col[8]);
    var s30: f64 = 0x3E10000000000000;            # 2^-30
    var h: f64 = lead * s30;
    var mm: f64 = 0.0;
    var l: f64 = 0.0;
    k = 7;
    while (k >= 0) {
        var lf: f64 = f64_from(col[k]);
        var sc: f64 = _km_cr_pow2(32 * k - 286);
        var d: f64 = lf * sc;                     # exact: 32 bits at a normal scale
        var h2, m2, l2 = _km_td_add_d(h, mm, l, d);
        h = h2;
        mm = m2;
        l = l2;
        k = k - 1;
    }
    var ph: f64 = _KM_CR_SC_PIO2H;
    var pm: f64 = _KM_CR_SC_PIO2M;
    var pl: f64 = _KM_CR_SC_PIO2L;
    var rh, rm, rl = _km_td_mul(h, mm, l, ph, pm, pl);
    if (neg == 1) {
        rh = -rh;
        rm = -rm;
        rl = -rl;
    }
    store64(out, rh);
    store64(out + 8, rm);
    store64(out + 16, rl);
    return q;
}

# The fast evaluation of ±sin r / ±cos r (q = 0: sin r, 1: cos r, 2: −sin r, 3: −cos r) for r = rh + rl,
# |r| ≤ π/4 + 2^-30, |rl| ≤ 2^-53·|rh|, with the reduction's absolute error dr: (hi, lo, err) with
# |hi + lo − f| < err less the test's own rounding (the bound above).
#must_use
fn _km_sc_eval(q, rh: f64, rl: f64, dr: f64): (f64, f64, f64) {
    var cc: f64 = rh + 26388279066624.0;          # 1.5·2^44: rounds rh to a multiple of 2^-8
    var ad: f64 = cc - 26388279066624.0;
    var i = load64(&cc) - 0x42B8000000000000;
    var th: f64 = rh - ad;                        # exact, |th| ≤ 2^-9
    var ai = i;
    if (i < 0) { ai = 0 - i; }
    var off = ai * 64;
    var sa: f64 = load64(&_KM_CR_SC_T + off);
    var sb: f64 = load64(&_KM_CR_SC_T + off + 8);
    var ca: f64 = load64(&_KM_CR_SC_T + off + 32);
    var cb: f64 = load64(&_KM_CR_SC_T + off + 40);
    if (i < 0) {
        sa = -sa;
        sb = -sb;
    }
    var ua: f64 = sa;
    var ub: f64 = sb;
    var va: f64 = ca;
    var vb: f64 = cb;
    if ((q & 1) == 1) {
        ua = ca;
        ub = cb;
        va = -sa;
        vb = -sb;
    }
    if ((q & 2) == 2) {
        ua = -ua;
        ub = -ub;
        va = -va;
        vb = -vb;
    }
    var t1: f64 = th;
    var t2: f64 = 0.0;
    if (i != 0) {
        var ct: f64 = th + 98304.0;               # 1.5·2^16: rounds th to a multiple of 2^-36
        t1 = ct - 98304.0;
        t2 = th - t1;
    }
    var p1: f64 = va * t1;                        # exact
    var hi: f64 = ua + p1;
    var e1: f64 = p1 - (hi - ua);
    var s3: f64 = _KM_CR_SC_S3;
    var s5: f64 = _KM_CR_SC_S5;
    var s7: f64 = _KM_CR_SC_S7;
    var c4: f64 = _KM_CR_SC_C4;
    var c6: f64 = _KM_CR_SC_C6;
    var z: f64 = th * th;
    var cm1: f64 = z * ((z * (c4 + (z * c6))) - 0.5);
    var sm: f64 = (th * z) * (s3 + (z * (s5 + (z * s7))));
    var uf: f64 = ua + ub;
    var vf: f64 = va + vb;
    var small: f64 = (e1 + (va * t2)) + (vb * th);
    var mid: f64 = (vf * sm) + (rl * (vf - (uf * th)));
    var big: f64 = ub + (uf * cm1);
    var lo: f64 = (small + mid) + big;
    var aua: f64 = f64_abs(ua);
    var ahi: f64 = f64_abs(hi);
    var k68: f64 = 0x3BB0000000000000;            # 2^-68
    var k69: f64 = 0x3BA0000000000000;            # 2^-69
    var err: f64 = ((aua * k68) + (ahi * k69)) + dr;
    return (hi, lo, err);
}

# The fast core for a = |x|, 2^-27 ≤ a < +∞ (bits ax), sel = 0 for sin, 1 for cos: (hi, lo, err) for f(a).
#must_use
fn _km_sc_core(ax, sel): (f64, f64, f64) {
    var a: f64 = ax;
    if (ax >= 0x4130000000000000) {               # a ≥ 2^20: Payne–Hanek
        var rb: f64[3];
        var kp = _km_ph_reduce(ax, &rb);
        var ph, pl, pe = _km_sc_eval((kp + sel) & 3, rb[0], rb[1], 0.0);
        return (ph, pl, pe);
    }
    var inv: f64 = _KM_CR_SC_INVPIO2;
    var p1: f64 = _KM_CR_SC_P1;
    var p2: f64 = _KM_CR_SC_P2;
    var p3: f64 = _KM_CR_SC_P3;
    var tt: f64 = (a * inv) + 6755399441055744.0; # 1.5·2^52: rounds a·2/π to an integer
    var kd: f64 = tt - 6755399441055744.0;
    var k = load64(&tt) - 0x4338000000000000;
    var d1: f64 = a - (kd * p1);                  # exact
    var q2: f64 = kd * p2;                        # exact
    var nq2: f64 = -q2;
    var s: f64 = d1 + nq2;                        # TwoSum(d1, −k·P2)
    var bb: f64 = s - d1;
    var e: f64 = (d1 - (s - bb)) + (nq2 - bb);
    var w: f64 = e - (kd * p3);
    var rh: f64 = s + w;                          # Fast2Sum: |rl| ≤ 2^-53·|rh|
    var rl: f64 = w - (rh - s);
    var k119: f64 = 0x3880000000000000;           # 2^-119
    var dr: f64 = kd * k119;
    var hi, lo, err = _km_sc_eval((k + sel) & 3, rh, rl, dr);
    return (hi, lo, err);
}

# The accurate reduction of a = |x| ≥ 2^-27 (bits ax): k and r = a − k·π/2 as a triple-double at out[0..2].
fn _km_sc_reduce_acc(ax, out): i64 {
    if (ax >= 0x4130000000000000) {
        var kp = _km_ph_reduce(ax, out);
        return kp;
    }
    var a: f64 = ax;
    var inv: f64 = _KM_CR_SC_INVPIO2;
    var p1: f64 = _KM_CR_SC_P1;
    var p2: f64 = _KM_CR_SC_P2;
    var tt: f64 = (a * inv) + 6755399441055744.0;
    var kd: f64 = tt - 6755399441055744.0;
    var k = load64(&tt) - 0x4338000000000000;
    var d1: f64 = a - (kd * p1);
    var q2: f64 = kd * p2;
    var h, m = _km_two_sum(d1, -q2);
    var l: f64 = 0.0;
    var n = 0;
    while (n < 3) {                               # k·P3, k·P4, k·P5 by TwoProduct
        var pv: f64 = _KM_CR_SC_P3;
        if (n == 1) { pv = _KM_CR_SC_P4; }
        if (n == 2) { pv = _KM_CR_SC_P5; }
        var ph, pe = _km_two_prod(kd, pv);
        var a0, a1, a2 = _km_td_add_d(h, m, l, -ph);
        var b0, b1, b2 = _km_td_add_d(a0, a1, a2, -pe);
        h = b0;
        m = b1;
        l = b2;
        n = n + 1;
    }
    store64(out, h);
    store64(out + 8, m);
    store64(out + 16, l);
    return k;
}

# U·cos t + V·sin t in triple-double for quadrant q, from buf = S (sin a), C (cos a), sin t, cos t (four
# triple-doubles, 12 words), at out[0..2].
fn _km_sc_comb(q, buf, out) {
    var uo = 0;                                   # U = S, V = C (sin type) or U = C, V = −S (cos type)
    var vo = 24;
    var vs: f64 = 1.0;
    if ((q & 1) == 1) {
        uo = 24;
        vo = 0;
        vs = -1.0;
    }
    var us: f64 = 1.0;
    if ((q & 2) == 2) {
        us = -1.0;
        vs = -vs;
    }
    var u0: f64 = load64(buf + uo);
    var u1: f64 = load64(buf + uo + 8);
    var u2: f64 = load64(buf + uo + 16);
    var v0: f64 = load64(buf + vo);
    var v1: f64 = load64(buf + vo + 8);
    var v2: f64 = load64(buf + vo + 16);
    var c0: f64 = load64(buf + 72);
    var c1: f64 = load64(buf + 80);
    var c2: f64 = load64(buf + 88);
    var s0: f64 = load64(buf + 48);
    var s1: f64 = load64(buf + 56);
    var s2: f64 = load64(buf + 64);
    var ah, am, al = _km_td_mul(u0 * us, u1 * us, u2 * us, c0, c1, c2);   # ±1 scalings are exact
    var bh, bm, bl = _km_td_mul(v0 * vs, v1 * vs, v2 * vs, s0, s1, s2);
    var rh, rm, rl = _km_td_add(ah, am, al, bh, bm, bl);
    store64(out, rh);
    store64(out + 8, rm);
    store64(out + 16, rl);
}

# The accurate f_q(r) for r = r0 + r1 + r2 at out[0..2], and f_(q+1)(r) at out[3..5] when both = 1.
fn _km_sc_acc_td(q, r0: f64, r1: f64, r2: f64, both, out) {
    var cc: f64 = r0 + 26388279066624.0;
    var ad: f64 = cc - 26388279066624.0;
    var i = load64(&cc) - 0x42B8000000000000;
    var t0: f64 = r0 - ad;                        # exact
    var th, tm, tl = _km_td_add_d(r1, r2, 0.0, t0);
    var zh, zm, zl = _km_td_mul(th, tm, tl, th, tm, tl);
    var wh: f64 = -zh;                            # w = −t²
    var wm: f64 = -zm;
    var wl: f64 = -zl;
    var ph: f64 = load64(&_KM_CR_EXP_ACC + 264);  # 1/13! (index 3·(13 − 2))
    var pm: f64 = load64(&_KM_CR_EXP_ACC + 272);
    var pl: f64 = load64(&_KM_CR_EXP_ACC + 280);
    var k = 11;
    while (k >= 3) {                              # 1/k! + w·P for k = 11, 9, …, 3
        var ah, am, al = _km_td_mul(ph, pm, pl, wh, wm, wl);
        var off = (k - 2) * 24;
        var ch: f64 = load64(&_KM_CR_EXP_ACC + off);
        var cm: f64 = load64(&_KM_CR_EXP_ACC + off + 8);
        var cl: f64 = load64(&_KM_CR_EXP_ACC + off + 16);
        var bh, bm, bl = _km_td_add(ch, cm, cl, ah, am, al);
        ph = bh;
        pm = bm;
        pl = bl;
        k = k - 2;
    }
    var sh1, sm1, sl1 = _km_td_mul(ph, pm, pl, wh, wm, wl);
    var sh2, sm2, sl2 = _km_td_add_d(sh1, sm1, sl1, 1.0);
    var snh, snm, snl = _km_td_mul(sh2, sm2, sl2, th, tm, tl);       # sin t
    ph = load64(&_KM_CR_EXP_ACC + 240);           # 1/12!
    pm = load64(&_KM_CR_EXP_ACC + 248);
    pl = load64(&_KM_CR_EXP_ACC + 256);
    k = 10;
    while (k >= 2) {                              # 1/k! + w·P for k = 10, 8, …, 2
        var dh, dm, dl = _km_td_mul(ph, pm, pl, wh, wm, wl);
        var off2 = (k - 2) * 24;
        var eh: f64 = load64(&_KM_CR_EXP_ACC + off2);
        var em: f64 = load64(&_KM_CR_EXP_ACC + off2 + 8);
        var el: f64 = load64(&_KM_CR_EXP_ACC + off2 + 16);
        var fh, fm, fl = _km_td_add(eh, em, el, dh, dm, dl);
        ph = fh;
        pm = fm;
        pl = fl;
        k = k - 2;
    }
    var ch1, cm1, cl1 = _km_td_mul(ph, pm, pl, wh, wm, wl);
    var csh, csm, csl = _km_td_add_d(ch1, cm1, cl1, 1.0);           # cos t
    var ai = i;
    if (i < 0) { ai = 0 - i; }
    var to = ai * 64;
    var buf: f64[12];
    var g = 0;
    while (g < 2) {                               # S then C, each A + B + C + D renormalised
        var xa: f64 = load64(&_KM_CR_SC_T + to + 32 * g);
        var xb: f64 = load64(&_KM_CR_SC_T + to + 32 * g + 8);
        var xc: f64 = load64(&_KM_CR_SC_T + to + 32 * g + 16);
        var xd: f64 = load64(&_KM_CR_SC_T + to + 32 * g + 24);
        var y0, y1a = _km_fast_two_sum(xa, xb);
        var y1, y2a = _km_fast_two_sum(y1a, xc);
        var y2: f64 = y2a + xd;
        if (g == 0 && i < 0) {
            y0 = -y0;
            y1 = -y1;
            y2 = -y2;
        }
        buf[3 * g] = y0;
        buf[3 * g + 1] = y1;
        buf[3 * g + 2] = y2;
        g = g + 1;
    }
    buf[6] = snh;
    buf[7] = snm;
    buf[8] = snl;
    buf[9] = csh;
    buf[10] = csm;
    buf[11] = csl;
    _km_sc_comb(q, &buf, out);
    if (both == 1) { _km_sc_comb(q + 1, &buf, out + 24); }
}

# The accurate path for f(|x|), sel = 0 sin, 1 cos, bits ax with 2^-27 ≤ |x| < ∞.
#must_use
fn _km_sc_acc(ax, sel): f64 {
    var rb: f64[3];
    var k = _km_sc_reduce_acc(ax, &rb);
    var ob: f64[6];
    _km_sc_acc_td((k + sel) & 3, rb[0], rb[1], rb[2], 0, &ob);
    var r: f64 = _km_rn3(ob[0], ob[1], ob[2]);
    return r;
}

# sin(x), correctly rounded. sin(±0) = ±0 (as every |x| < 2^-26: x), NaN for NaN and ±∞. Mirrors `f64::sin`.
#must_use
fn _km_cr_sin(x: f64): f64 {
    var ux = load64(&x);
    var ax = ux & 0x7FFFFFFFFFFFFFFF;
    if (ax < 0x3E50000000000000) { return x; }   # |x| < 2^-26
    if (ax >= 0x7FF0000000000000) {
        if (ax > 0x7FF0000000000000) { return x; }
        var nan: f64 = _km_nan();               # the same quiet NaN on every target
        return nan;
    }
    if (ax >= 0x4130000000000000) {               # |x| ≥ 2^20: Payne–Hanek, through _km_sc_core
        var ph, pl, pe = _km_sc_core(ax, 0);
        var pu: f64 = ph + (pl - pe);
        var pv: f64 = ph + (pl + pe);
        if (pu != pv) { pu = _km_sc_acc(ax, 0); }
        if (ux < 0) { pu = -pu; }
        return pu;
    }
    var a: f64 = ax;                              # _km_sc_core's Cody–Waite reduction, inline
    var inv: f64 = _KM_CR_SC_INVPIO2;
    var p1: f64 = _KM_CR_SC_P1;
    var p2: f64 = _KM_CR_SC_P2;
    var p3: f64 = _KM_CR_SC_P3;
    var tt: f64 = (a * inv) + 6755399441055744.0;
    var kd: f64 = tt - 6755399441055744.0;
    var k = load64(&tt) - 0x4338000000000000;
    var d1: f64 = a - (kd * p1);
    var q2: f64 = kd * p2;
    var nq2: f64 = -q2;
    var s: f64 = d1 + nq2;
    var bb: f64 = s - d1;
    var e: f64 = (d1 - (s - bb)) + (nq2 - bb);
    var w: f64 = e - (kd * p3);
    var rh: f64 = s + w;
    var rl: f64 = w - (rh - s);
    var k119: f64 = 0x3880000000000000;
    var dr: f64 = kd * k119;
    var hi, lo, err = _km_sc_eval(k & 3, rh, rl, dr);
    var u: f64 = hi + (lo - err);
    var v: f64 = hi + (lo + err);
    var r: f64 = u;
    if (u != v) { r = _km_sc_acc(ax, 0); }
    if (ux < 0) { r = -r; }
    return r;
}

# The fast path alone: (sin x, 1), or (0, 0) when its rounding test fails.
#must_use
fn _km_cr_sin_fast(x: f64): (f64, i64) {
    var ux = load64(&x);
    var ax = ux & 0x7FFFFFFFFFFFFFFF;
    if (ax < 0x3E50000000000000) { return (x, 1); }
    if (ax >= 0x7FF0000000000000) {
        if (ax > 0x7FF0000000000000) { return (x, 1); }
        var nan: f64 = _km_nan();
        return (nan, 1);
    }
    var hi, lo, err = _km_sc_core(ax, 0);
    var u: f64 = hi + (lo - err);
    var v: f64 = hi + (lo + err);
    if (u != v) { return (0.0, 0); }
    if (ux < 0) { u = -u; }
    return (u, 1);
}

# sin x by the accurate path alone.
#must_use
fn _km_cr_sin_acc(x: f64): f64 {
    var ux = load64(&x);
    var ax = ux & 0x7FFFFFFFFFFFFFFF;
    if (ax < 0x3E50000000000000) { return x; }
    if (ax >= 0x7FF0000000000000) {
        if (ax > 0x7FF0000000000000) { return x; }
        var nan: f64 = _km_nan();
        return nan;
    }
    var r: f64 = _km_sc_acc(ax, 0);
    if (ux < 0) { r = -r; }
    return r;
}

# cos(x), correctly rounded. cos(±0) = 1 (as every |x| < 2^-27), NaN for NaN and ±∞. Mirrors `f64::cos`.
#must_use
fn _km_cr_cos(x: f64): f64 {
    var ax = load64(&x) & 0x7FFFFFFFFFFFFFFF;
    if (ax < 0x3E40000000000000) { return 1.0; }   # |x| < 2^-27
    if (ax >= 0x7FF0000000000000) {
        if (ax > 0x7FF0000000000000) { return x; }
        var nan: f64 = _km_nan();
        return nan;
    }
    if (ax >= 0x4130000000000000) {               # |x| ≥ 2^20: Payne–Hanek, through _km_sc_core
        var ph, pl, pe = _km_sc_core(ax, 1);
        var pu: f64 = ph + (pl - pe);
        var pv: f64 = ph + (pl + pe);
        if (pu == pv) { return pu; }
        var pa: f64 = _km_sc_acc(ax, 1);
        return pa;
    }
    var a: f64 = ax;                              # _km_sc_core's Cody–Waite reduction, inline
    var inv: f64 = _KM_CR_SC_INVPIO2;
    var p1: f64 = _KM_CR_SC_P1;
    var p2: f64 = _KM_CR_SC_P2;
    var p3: f64 = _KM_CR_SC_P3;
    var tt: f64 = (a * inv) + 6755399441055744.0;
    var kd: f64 = tt - 6755399441055744.0;
    var k = load64(&tt) - 0x4338000000000000;
    var d1: f64 = a - (kd * p1);
    var q2: f64 = kd * p2;
    var nq2: f64 = -q2;
    var s: f64 = d1 + nq2;
    var bb: f64 = s - d1;
    var e: f64 = (d1 - (s - bb)) + (nq2 - bb);
    var w: f64 = e - (kd * p3);
    var rh: f64 = s + w;
    var rl: f64 = w - (rh - s);
    var k119: f64 = 0x3880000000000000;
    var dr: f64 = kd * k119;
    var hi, lo, err = _km_sc_eval((k + 1) & 3, rh, rl, dr);
    var u: f64 = hi + (lo - err);
    var v: f64 = hi + (lo + err);
    if (u == v) { return u; }
    var r: f64 = _km_sc_acc(ax, 1);
    return r;
}

# The fast path alone: (cos x, 1), or (0, 0) when its rounding test fails.
#must_use
fn _km_cr_cos_fast(x: f64): (f64, i64) {
    var ax = load64(&x) & 0x7FFFFFFFFFFFFFFF;
    if (ax < 0x3E40000000000000) { return (1.0, 1); }
    if (ax >= 0x7FF0000000000000) {
        if (ax > 0x7FF0000000000000) { return (x, 1); }
        var nan: f64 = _km_nan();
        return (nan, 1);
    }
    var hi, lo, err = _km_sc_core(ax, 1);
    var u: f64 = hi + (lo - err);
    var v: f64 = hi + (lo + err);
    if (u != v) { return (0.0, 0); }
    return (u, 1);
}

# cos x by the accurate path alone.
#must_use
fn _km_cr_cos_acc(x: f64): f64 {
    var ax = load64(&x) & 0x7FFFFFFFFFFFFFFF;
    if (ax < 0x3E40000000000000) { return 1.0; }
    if (ax >= 0x7FF0000000000000) {
        if (ax > 0x7FF0000000000000) { return x; }
        var nan: f64 = _km_nan();
        return nan;
    }
    var r: f64 = _km_sc_acc(ax, 1);
    return r;
}

# sin and cos of a = |x| ≥ 2^-27 (bits ax) by the fast path, sharing the reduction, the table row and the
# polynomials: (sin a, cos a, 1), or (0, 0, 0) when either test fails. Each result is _km_sc_eval's for its
# quadrant, so the same bits and the same test as _km_cr_sin_fast and _km_cr_cos_fast.
#must_use
fn _km_sincos_core(ax): (f64, f64, i64) {
    var a: f64 = ax;
    var k = 0;
    var rh: f64 = 0.0;
    var rl: f64 = 0.0;
    var dr: f64 = 0.0;
    if (ax >= 0x4130000000000000) {
        var rb: f64[3];
        k = _km_ph_reduce(ax, &rb);
        rh = rb[0];
        rl = rb[1];
    } else {
        var inv: f64 = _KM_CR_SC_INVPIO2;
        var p1: f64 = _KM_CR_SC_P1;
        var p2: f64 = _KM_CR_SC_P2;
        var p3: f64 = _KM_CR_SC_P3;
        var tt: f64 = (a * inv) + 6755399441055744.0;
        var kd: f64 = tt - 6755399441055744.0;
        k = load64(&tt) - 0x4338000000000000;
        var d1: f64 = a - (kd * p1);
        var q2: f64 = kd * p2;
        var nq2: f64 = -q2;
        var s: f64 = d1 + nq2;
        var bb: f64 = s - d1;
        var e: f64 = (d1 - (s - bb)) + (nq2 - bb);
        var w: f64 = e - (kd * p3);
        rh = s + w;
        rl = w - (rh - s);
        var k119: f64 = 0x3880000000000000;       # 2^-119
        dr = kd * k119;
    }
    var cc: f64 = rh + 26388279066624.0;
    var ad: f64 = cc - 26388279066624.0;
    var i = load64(&cc) - 0x42B8000000000000;
    var th: f64 = rh - ad;
    var ai = i;
    if (i < 0) { ai = 0 - i; }
    var off = ai * 64;
    var sa: f64 = load64(&_KM_CR_SC_T + off);
    var sb: f64 = load64(&_KM_CR_SC_T + off + 8);
    var ca: f64 = load64(&_KM_CR_SC_T + off + 32);
    var cb: f64 = load64(&_KM_CR_SC_T + off + 40);
    if (i < 0) {
        sa = -sa;
        sb = -sb;
    }
    var t1: f64 = th;
    var t2: f64 = 0.0;
    if (i != 0) {
        var ct: f64 = th + 98304.0;
        t1 = ct - 98304.0;
        t2 = th - t1;
    }
    var s3: f64 = _KM_CR_SC_S3;
    var s5: f64 = _KM_CR_SC_S5;
    var s7: f64 = _KM_CR_SC_S7;
    var c4: f64 = _KM_CR_SC_C4;
    var c6: f64 = _KM_CR_SC_C6;
    var z: f64 = th * th;
    var cm1: f64 = z * ((z * (c4 + (z * c6))) - 0.5);
    var sm: f64 = (th * z) * (s3 + (z * (s5 + (z * s7))));
    # sin a = f_k(r), cos a = f_(k+1)(r): (U, V) = ±(S, C) or ±(C, −S) by the quadrant; then _km_sc_eval's
    # last operations and its test, once for each (the same operations in the same order).
    var q = k & 3;
    var sg: f64 = 1.0;
    if ((q & 2) == 2) { sg = -1.0; }
    var ssa: f64 = sg * sa;
    var ssb: f64 = sg * sb;
    var sca: f64 = sg * ca;
    var scb: f64 = sg * cb;
    var u1a: f64 = ssa;                           # sin: (S, C), cos: (C, −S) for even q
    var u1b: f64 = ssb;
    var v1a: f64 = sca;
    var v1b: f64 = scb;
    var u2a: f64 = sca;
    var u2b: f64 = scb;
    var v2a: f64 = -ssa;
    var v2b: f64 = -ssb;
    if ((q & 1) == 1) {                           # sin: (C, −S), cos: (−S, −C) for odd q
        u1a = sca;
        u1b = scb;
        v1a = -ssa;
        v1b = -ssb;
        u2a = -ssa;
        u2b = -ssb;
        v2a = -sca;
        v2b = -scb;
    }
    var k68: f64 = 0x3BB0000000000000;            # 2^-68
    var k69: f64 = 0x3BA0000000000000;            # 2^-69
    var p1s: f64 = v1a * t1;
    var his: f64 = u1a + p1s;
    var e1s: f64 = p1s - (his - u1a);
    var ufs: f64 = u1a + u1b;
    var vfs: f64 = v1a + v1b;
    var sms: f64 = (e1s + (v1a * t2)) + (v1b * th);
    var mds: f64 = (vfs * sm) + (rl * (vfs - (ufs * th)));
    var bgs: f64 = u1b + (ufs * cm1);
    var los: f64 = (sms + mds) + bgs;
    var aus: f64 = f64_abs(u1a);
    var ahs: f64 = f64_abs(his);
    var ers: f64 = ((aus * k68) + (ahs * k69)) + dr;
    var su: f64 = his + (los - ers);
    var sv: f64 = his + (los + ers);
    if (su != sv) { return (0.0, 0.0, 0); }
    var p1c: f64 = v2a * t1;
    var hic: f64 = u2a + p1c;
    var e1c: f64 = p1c - (hic - u2a);
    var ufc: f64 = u2a + u2b;
    var vfc: f64 = v2a + v2b;
    var smc: f64 = (e1c + (v2a * t2)) + (v2b * th);
    var mdc: f64 = (vfc * sm) + (rl * (vfc - (ufc * th)));
    var bgc: f64 = u2b + (ufc * cm1);
    var loc: f64 = (smc + mdc) + bgc;
    var auc: f64 = f64_abs(u2a);
    var ahc: f64 = f64_abs(hic);
    var erc: f64 = ((auc * k68) + (ahc * k69)) + dr;
    var cu: f64 = hic + (loc - erc);
    var cv: f64 = hic + (loc + erc);
    if (cu != cv) { return (0.0, 0.0, 0); }
    return (su, cu, 1);
}

# (sin x, cos x), both correctly rounded, sharing the work (M4d's FFT twiddles). Mirrors `f64::sin_cos`.
#must_use
fn _km_cr_sincos(x: f64): (f64, f64) {
    var ux = load64(&x);
    var ax = ux & 0x7FFFFFFFFFFFFFFF;
    if (ax >= 0x3E40000000000000 && ax < 0x7FF0000000000000) {   # 2^-27 ≤ |x| < ∞: the fast core
        var s, c, ok = _km_sincos_core(ax);
        if (ok == 1) {
            if (ux < 0) { s = -s; }
            return (s, c);
        }
        var sa, ca = _km_cr_sincos_acc(x);
        return (sa, ca);
    }
    var s2, c2, ok2 = _km_cr_sincos_fast(x);      # the special values
    return (s2, c2);
}

# The fast path alone: (sin x, cos x, 1), or (0, 0, 0) when either rounding test fails.
#must_use
fn _km_cr_sincos_fast(x: f64): (f64, f64, i64) {
    var ux = load64(&x);
    var ax = ux & 0x7FFFFFFFFFFFFFFF;
    if (ax < 0x3E40000000000000) { return (x, 1.0, 1); }   # |x| < 2^-27
    if (ax >= 0x7FF0000000000000) {
        if (ax > 0x7FF0000000000000) { return (x, x, 1); }
        var nan: f64 = _km_nan();
        return (nan, nan, 1);
    }
    var s, c, ok = _km_sincos_core(ax);
    if (ok == 0) { return (0.0, 0.0, 0); }
    if (ux < 0) { s = -s; }
    return (s, c, 1);
}

# (sin x, cos x) by the accurate path alone (one reduction, one pair of series).
#must_use
fn _km_cr_sincos_acc(x: f64): (f64, f64) {
    var ux = load64(&x);
    var ax = ux & 0x7FFFFFFFFFFFFFFF;
    if (ax < 0x3E40000000000000) { return (x, 1.0); }
    if (ax >= 0x7FF0000000000000) {
        if (ax > 0x7FF0000000000000) { return (x, x); }
        var nan: f64 = _km_nan();
        return (nan, nan);
    }
    var rb: f64[3];
    var k = _km_sc_reduce_acc(ax, &rb);
    var ob: f64[6];
    _km_sc_acc_td(k & 3, rb[0], rb[1], rb[2], 1, &ob);
    var s: f64 = _km_rn3(ob[0], ob[1], ob[2]);
    var c: f64 = _km_rn3(ob[3], ob[4], ob[5]);
    if (ux < 0) { s = -s; }
    return (s, c);
}

# ── atan2 and acos (M4a) ────────────────────────────────────────────────────────────────────────
#
# Both are θ = atan(n/d) with 0 < n ≤ d plus an offset (oct 0: θ; 1: π − θ; 2: π/2 − θ; 3: π/2 + θ), with
# atan2(y, x) = ±atan(|y|/|x|) and acos x = atan2(√(1 − x²), x). The quotient is never rounded to a double
# first: with z = n/d and c = j/256 (j = RN(256·RN(n/d)), 0 ≤ j ≤ 256), atan(n/d) = atan(c) + atan(δ) with
# δ = (n − c·d)/(d + c·n), |δ| ≤ 2^-9, from the inputs themselves (crlibm's atan reduction, in atan2 form).
# - n − c·d and d + c·n are exact or nearly: d = d1 + d2 and n = n1 + n2 with d1, n1 on the 2^-44 grid (45 bits,
#   d < 2), so c·d1, c·n1 (c has 8 bits) and c·d2, c·n2 (at most 26 bits: n ≥ d/512 when j ≥ 1) are exact; n − c·d1
#   and d + c·n1 are TwoSums; the low parts add with errors below 2^-97. j = 0 takes δ = n/d.
# - Fast path: δ = qh + ql (Dekker's division, the remainder exact), atan δ − δ = δ³(−1/3 + δ²/5 − δ⁴/7 + δ⁶/9)
#   − ql·δ² (truncation δ^11/11 < 2^-102), atan(c) = A_h + A_m (_KM_CR_ATAN_T, to 2^-106), and offset + θ as
#   hi + lo with two Fast2Sums (|offset| ≥ π/4 ≥ |A_h| ≥ 2^-8.0 ≥ 2|δ| when nonzero). The error, relative to the
#   result: 2^-70.3 for the polynomial (5 roundings of a term below |δ|³/3, against a result ≥ |δ| when j = 0
#   and ≥ 2^-9 otherwise), 2^-71 for lo's three roundings of that term, 2^-72.6 for the test's own rounding,
#   2^-87.9 for δ and below 2^-100 for the tables (the offsets make the result at least π/4, where every
#   term is 2^-9 smaller): 2^-69.44 in all, so the test uses err = 2^-68.5·|hi|. Measured: at most 0.21 of err
#   (2^-70.8 relative) over 1.05 million arguments against 400-bit MPFR; the fast test fails on 1.9·10^-5 (atan2)
#   and 1.4·10^-5 (acos) of scripts/oracle/cr_verify.py's arguments.
# - Accurate path: δ = num/den in triple-double (long division with two corrections, each from a renormalised
#   remainder: 2^-151), atan δ = δ + δ·w·Σ (−1)^k w^(k−1)/(2k + 1) to k = 8 (w = δ², truncation δ^19/19 < 2^-166
#   relative), atan(c) and the offset as triple-doubles (at most one bit of cancellation in each sum), then
#   _km_rn3: below 2^-149 relative by the operation count, measured 2^-156.9 against 400-bit MPFR (acos too).
# Exact cases: atan(q) is transcendental for every rational q ≠ 0 (Lindemann–Weierstrass: tan of a nonzero
# algebraic number is transcendental), and so are π − atan(q) and π/2 ± atan(q); the only exact results are
# the zeros and acos(1) = +0. No result is a midpoint except where the quotient y/x itself is a subnormal
# midpoint (below).
# What the accurate path rests on: atan2's hardest cases are not known (a two-variable search is out of
# reach); Lefèvre and Muller (2003, Table 13) give arctan's on [tan(2^-25), 2] (atan2(y, 1) = atan(y): a
# mantissa distance of 2^-126 suffices) and arccos's on [cos(12867/8192), 1 − 2^-53] (Table 11: 2^-116, at
# 0x1.fd737be914578p-11). 2^-149 is 23 bits past the expected hardest case of 2^64 arguments, and a random
# argument pair is that close to a midpoint with probability about 2^-95.

# The fast atan core for n = nh + nl, d = dh + dl with 0 < n ≤ d (1 + 2^-50), dh in [1/2, 2), nh ≥ 2^-62·dh:
# (hi, lo, err) for offset ± atan(n/d) by oct.
#must_use
fn _km_atan_core(nh: f64, nl: f64, dh: f64, dl: f64, oct): (f64, f64, f64) {
    var zh: f64 = nh / dh;
    var cz: f64 = zh + 26388279066624.0;          # 1.5·2^44: rounds n/d to a multiple of 2^-8
    var c: f64 = cz - 26388279066624.0;
    var j = load64(&cz) - 0x42B8000000000000;
    var sh: f64 = nh;
    var sl: f64 = nl;
    var eh: f64 = dh;
    var el: f64 = dl;
    if (j != 0) {
        var d1: f64 = (dh + 384.0) - 384.0;       # 1.5·2^8: dh on the 2^-44 grid
        var d2: f64 = dh - d1;
        var n1: f64 = (nh + 384.0) - 384.0;
        var n2: f64 = nh - n1;
        var p1: f64 = c * d1;                     # exact
        var np1: f64 = -p1;
        var u: f64 = nh + np1;                    # TwoSum(nh, −c·d1)
        var ub: f64 = u - nh;
        var ue: f64 = (nh - (u - ub)) + (np1 - ub);
        sh = u;
        sl = ((ue - (c * d2)) + nl) - (c * dl);
        var q1: f64 = c * n1;                     # exact
        var v: f64 = dh + q1;                     # TwoSum(dh, c·n1)
        var vb: f64 = v - dh;
        var ve: f64 = (dh - (v - vb)) + (q1 - vb);
        eh = v;
        el = ((ve + (c * n2)) + dl) + (c * nl);
    }
    var qh: f64 = sh / eh;                        # δ = qh + ql: Dekker's division
    var cq: f64 = 134217729.0 * qh;
    var q1h: f64 = cq - (cq - qh);
    var q1l: f64 = qh - q1h;
    var ce: f64 = 134217729.0 * eh;
    var e1h: f64 = ce - (ce - eh);
    var e1l: f64 = eh - e1h;
    var pp: f64 = qh * eh;
    var pe: f64 = (((q1h * e1h) - pp) + (q1h * e1l) + (q1l * e1h)) + (q1l * e1l);
    var ql: f64 = ((((sh - pp) - pe) + sl) - (qh * el)) / eh;
    var a3: f64 = _KM_CR_SC_A3;
    var a5: f64 = _KM_CR_SC_A5;
    var a7: f64 = _KM_CR_SC_A7;
    var a9: f64 = _KM_CR_SC_A9;
    var z: f64 = qh * qh;
    var pz: f64 = ((qh * z) * (a3 + (z * (a5 + (z * (a7 + (z * a9))))))) - (ql * z);
    var ah: f64 = load64(&_KM_CR_ATAN_T + 24 * j);
    var am: f64 = load64(&_KM_CR_ATAN_T + 24 * j + 8);
    var oh: f64 = 0.0;
    var om: f64 = 0.0;
    var sg: f64 = 1.0;
    if (oct == 1) {
        oh = _KM_CR_SC_PIH;
        om = _KM_CR_SC_PIM;
        sg = -1.0;
    }
    if (oct >= 2) {
        oh = _KM_CR_SC_PIO2H;
        om = _KM_CR_SC_PIO2M;
        if (oct == 2) { sg = -1.0; }
    }
    var sah: f64 = sg * ah;
    var h1: f64 = oh + sah;                       # Fast2Sum: |oh| ≥ |ah| or oh = 0
    var f1: f64 = sah - (h1 - oh);
    var sqh: f64 = sg * qh;
    var hi: f64 = h1 + sqh;                       # Fast2Sum: |h1| ≥ |qh| or h1 = 0
    var f2: f64 = sqh - (hi - h1);
    var tl: f64 = (am + ql) + pz;
    var lo: f64 = ((f1 + f2) + om) + (sg * tl);
    var ahi: f64 = f64_abs(hi);
    var k68: f64 = 0x3BA6A09E667F3BCD;            # 2^-68.5 (√2·2^-69)
    var err: f64 = ahi * k68;
    return (hi, lo, err);
}

# The fast atan core with its rounding test: (RN(result), 1) or (0, 0).
#must_use
fn _km_atan_fast(nh: f64, nl: f64, dh: f64, dl: f64, oct): (f64, i64) {
    var hi, lo, err = _km_atan_core(nh, nl, dh, dl, oct);
    var u: f64 = hi + (lo - err);
    var v: f64 = hi + (lo + err);
    if (u != v) { return (0.0, 0); }
    return (u, 1);
}

# A triple-double renormalised (two bottom-up TwoSum passes): after a cancellation _km_td_add's leading word can
# be far from the sum (its last renormalisation does not see the rounded third-order term), and the corrections
# below need the leading word to be the sum to 2^-52. The sum is unchanged (every step is exact).
#must_use
fn _km_td_norm(a0: f64, a1: f64, a2: f64): (f64, f64, f64) {
    var s, e = _km_two_sum(a1, a2);
    var h, u = _km_two_sum(a0, s);
    var m, l = _km_two_sum(u, e);
    var h2, u2 = _km_two_sum(h, m);
    var m2, l2 = _km_two_sum(u2, l);
    return (h2, m2, l2);
}

# (a0, a1, a2)/(b0, b1, b2) as a triple-double at out[0..2], b ≠ 0 normalised: q0 = a0/b0 (a renormalised first),
# then two corrections from the remainder a − q·b, computed in triple-double (each below 2^-153 of a) and
# renormalised: relative error below 2^-151.
fn _km_td_div(a0: f64, a1: f64, a2: f64, b0: f64, b1: f64, b2: f64, out) {
    var n0, n1, n2 = _km_td_norm(a0, a1, a2);
    var q0: f64 = n0 / b0;
    var t0, t1, t2 = _km_td_mul_d(b0, b1, b2, q0);
    var ra, rb, rc = _km_td_add(n0, n1, n2, -t0, -t1, -t2);
    var r0, r1, r2 = _km_td_norm(ra, rb, rc);
    var q1: f64 = r0 / b0;
    var u0, u1, u2 = _km_td_mul_d(b0, b1, b2, q1);
    var sa, sb, sc = _km_td_add(r0, r1, r2, -u0, -u1, -u2);
    var s0, s1, s2 = _km_td_norm(sa, sb, sc);
    var q2: f64 = s0 / b0;
    var h, m0 = _km_fast_two_sum(q0, q1);
    var m, l = _km_two_sum(m0, q2);
    store64(out, h);
    store64(out + 8, m);
    store64(out + 16, l);
}

# The accurate atan core: RN(offset ± atan(n/d)) by oct, for triple-doubles 0 < n ≤ d (1 + 2^-50), n0 ≥ 2^-62·d0.
#must_use
fn _km_atan_acc(n0: f64, n1: f64, n2: f64, d0: f64, d1: f64, d2: f64, oct): f64 {
    var rb: f64[3];
    _km_atan_acc_td(n0, n1, n2, d0, d1, d2, oct, &rb);
    var r: f64 = _km_rn3(rb[0], rb[1], rb[2]);
    return r;
}

# offset ± atan(n/d) as a triple-double at out[0..2] (the accurate atan core before its rounding).
fn _km_atan_acc_td(n0: f64, n1: f64, n2: f64, d0: f64, d1: f64, d2: f64, oct, out) {
    var zh: f64 = n0 / d0;
    var cz: f64 = zh + 26388279066624.0;
    var c: f64 = cz - 26388279066624.0;
    var j = load64(&cz) - 0x42B8000000000000;
    var a0: f64 = n0;
    var a1: f64 = n1;
    var a2: f64 = n2;
    var b0: f64 = d0;
    var b1: f64 = d1;
    var b2: f64 = d2;
    if (j != 0) {                                 # num = n − c·d, den = d + c·n
        var cd0, cd1, cd2 = _km_td_mul_d(d0, d1, d2, c);
        var x0, x1, x2 = _km_td_add(n0, n1, n2, -cd0, -cd1, -cd2);
        var cn0, cn1, cn2 = _km_td_mul_d(n0, n1, n2, c);
        var y0, y1, y2 = _km_td_add(d0, d1, d2, cn0, cn1, cn2);
        a0 = x0;
        a1 = x1;
        a2 = x2;
        b0 = y0;
        b1 = y1;
        b2 = y2;
    }
    var db: f64[3];
    _km_td_div(a0, a1, a2, b0, b1, b2, &db);
    var dh: f64 = db[0];
    var dm: f64 = db[1];
    var dl: f64 = db[2];
    var wh, wm, wl = _km_td_mul(dh, dm, dl, dh, dm, dl);
    var ph: f64 = load64(&_KM_CR_ATAN_ACC + 168);  # 1/17 (index 3·(8 − 1))
    var pm: f64 = load64(&_KM_CR_ATAN_ACC + 176);
    var pl: f64 = load64(&_KM_CR_ATAN_ACC + 184);
    var k = 7;
    while (k >= 1) {                              # (−1)^k/(2k + 1) + w·P
        var th, tm, tl = _km_td_mul(ph, pm, pl, wh, wm, wl);
        var off = (k - 1) * 24;
        var ch: f64 = load64(&_KM_CR_ATAN_ACC + off);
        var cm: f64 = load64(&_KM_CR_ATAN_ACC + off + 8);
        var cl: f64 = load64(&_KM_CR_ATAN_ACC + off + 16);
        var uh, um, ul = _km_td_add(ch, cm, cl, th, tm, tl);
        ph = uh;
        pm = um;
        pl = ul;
        k = k - 1;
    }
    var vh, vm, vl = _km_td_mul(wh, wm, wl, ph, pm, pl);
    var xh, xm, xl = _km_td_mul(vh, vm, vl, dh, dm, dl);
    var th2, tm2, tl2 = _km_td_add(dh, dm, dl, xh, xm, xl);          # atan δ
    var ah: f64 = load64(&_KM_CR_ATAN_T + 24 * j);
    var am: f64 = load64(&_KM_CR_ATAN_T + 24 * j + 8);
    var al: f64 = load64(&_KM_CR_ATAN_T + 24 * j + 16);
    var gh, gm, gl = _km_td_add(ah, am, al, th2, tm2, tl2);          # θ
    if (oct == 0) {
        store64(out, gh);
        store64(out + 8, gm);
        store64(out + 16, gl);
        return;
    }
    var oh: f64 = _KM_CR_SC_PIO2H;
    var om: f64 = _KM_CR_SC_PIO2M;
    var ol: f64 = _KM_CR_SC_PIO2L;
    if (oct == 1) {
        oh = _KM_CR_SC_PIH;
        om = _KM_CR_SC_PIM;
        ol = _KM_CR_SC_PIL;
    }
    if (oct != 3) {
        gh = -gh;
        gm = -gm;
        gl = -gl;
    }
    var rh, rm, rl = _km_td_add(oh, om, ol, gh, gm, gl);
    store64(out, rh);
    store64(out + 8, rm);
    store64(out + 16, rl);
}

# A positive finite nonzero double from its bits b as (m, e), b's value = m·2^e with m in [1, 2).
#must_use
fn _km_frexp(b): (f64, i64) {
    var bb = b;
    var eo = 0;
    if ((b >> 52) == 0) {                         # subnormal: scale by 2^54 (exact)
        var v: f64 = b;
        var p54: f64 = 0x4350000000000000;
        var vs: f64 = v * p54;
        bb = load64(&vs);
        eo = 0 - 54;
    }
    var mb = (bb & 0x000FFFFFFFFFFFFF) | 0x3FF0000000000000;
    var m: f64 = mb;
    return (m, (bb >> 52) - 1023 + eo);
}

# atan2 for |n/d| < 2^-59 (n = mn·2^en, d = md·2^ed, mn and md in [1, 2), en − ed ≤ −60), unsigned:
# π/2 ∓ atan(n/d) rounds to π/2 (the quotient is below 2^-55 and π/2 is 2^-54.15 inside its rounding interval),
# π − atan(n/d) to π (likewise, 2^-52.86 inside); atan(q) itself lies in (q − q³/3, q), with q²/3 < 2^-119
# below any distance from a non-midpoint quotient of two doubles to a rounding boundary (at least 2^-107 of q,
# or 2^-1128 on the subnormal grid), so it rounds as q does unless q is exactly a midpoint (possible only in
# the subnormal range, e.g. 3·2^-1075 = atan2(3·2^-60, 2^1015)), where it rounds toward zero. q = qs·2^(en − ed)
# with qs = mn/md as q0 + q1 + q2 (Dekker's division, the remainders exact): an exact qs (q1 = 0) is lowered by
# q0·2^-100 to break the tie, and _km_cr_finish rounds once, at the subnormal grid when the result is subnormal.
#must_use
fn _km_atan2_tiny(mn: f64, md: f64, e, oct): f64 {
    if (oct >= 2) {
        var p2: f64 = _KM_CR_SC_PIO2H;
        return p2;
    }
    if (oct == 1) {
        var pi: f64 = _KM_CR_SC_PIH;
        return pi;
    }
    if (e < 0 - 1077) { return 0.0; }             # q < 2^-1076: below half of 2^-1074
    var q0: f64 = mn / md;
    var p, pe = _km_two_prod(q0, md);
    var r1: f64 = (mn - p) - pe;                  # exact
    var q1: f64 = r1 / md;
    var p2b, pe2 = _km_two_prod(q1, md);
    var r2: f64 = (r1 - p2b) - pe2;
    var q2: f64 = r2 / md;
    var tiny: f64 = 0x39B0000000000000;           # 2^-100
    if (r1 == 0.0) {
        q1 = -(q0 * tiny);
        q2 = 0.0;
    }
    var ee = e;
    if (q0 < 1.0) {                               # into [1, 2) for _km_cr_finish: exact
        q0 = q0 * 2.0;
        q1 = q1 * 2.0;
        q2 = q2 * 2.0;
        ee = ee - 1;
    }
    var r: f64 = _km_cr_finish(ee, q0, q1, q2);
    return r;
}

# atan2(y, x) for finite nonzero y and x, |y| = ay, |x| = ax (bits), the sign of x xneg: by the fast path
# (acc = 0: (result, 1) or (0, 0)) or the accurate one (acc = 1), unsigned.
#must_use
fn _km_atan2_pos(ay, ax, xneg, acc): (f64, i64) {
    var nb = ay;
    var db = ax;
    var oct = 0;
    if (xneg == 1) { oct = 1; }
    if (ay > ax) {
        nb = ax;
        db = ay;
        oct = 2;
        if (xneg == 1) { oct = 3; }
    }
    var mn, en = _km_frexp(nb);
    var md, ed = _km_frexp(db);
    if (en - ed <= 0 - 60) {
        var t: f64 = _km_atan2_tiny(mn, md, en - ed, oct);
        return (t, 1);
    }
    var sc: f64 = _km_cr_pow2(en - ed);
    var n: f64 = mn * sc;                         # exact: n/d ≥ 2^-60
    if (acc == 1) {
        var a: f64 = _km_atan_acc(n, 0.0, 0.0, md, 0.0, 0.0, oct);
        return (a, 1);
    }
    var r, ok = _km_atan_fast(n, 0.0, md, 0.0, oct);
    return (r, ok);
}

# The special values of atan2 (C99 Annex F, as glibc and Rust's f64::atan2): (result, 1), or (0, 0) for finite
# nonzero y and x. A NaN argument is returned as it is (y's first).
#must_use
fn _km_atan2_special(y: f64, x: f64): (f64, i64) {
    var uy = load64(&y);
    var ux = load64(&x);
    var ay = uy & 0x7FFFFFFFFFFFFFFF;
    var ax = ux & 0x7FFFFFFFFFFFFFFF;
    if (ay > 0x7FF0000000000000) { return (y, 1); }
    if (ax > 0x7FF0000000000000) { return (x, 1); }
    var r: f64 = 0.0;
    var found = 0;
    if (ay == 0) {                                # atan2(±0, x): ±0 for x ≥ +0, ±π for x ≤ −0
        found = 1;
        if (ux < 0) { r = _KM_CR_SC_PIH; }
    } elif (ax == 0) {                            # atan2(y ≠ 0, ±0) = ±π/2
        found = 1;
        r = _KM_CR_SC_PIO2H;
    } elif (ax == 0x7FF0000000000000) {
        found = 1;
        if (ay == 0x7FF0000000000000) {           # ±π/4, ±3π/4
            r = _KM_CR_SC_PIO4;
            if (ux < 0) { r = _KM_CR_SC_PI3O4; }
        } elif (ux < 0) {                         # finite y, x = −∞: ±π; x = +∞: ±0
            r = _KM_CR_SC_PIH;
        }
    } elif (ay == 0x7FF0000000000000) {           # y = ±∞, x finite: ±π/2
        found = 1;
        r = _KM_CR_SC_PIO2H;
    }
    if (found == 0) { return (0.0, 0); }
    if (uy < 0) { r = -r; }
    return (r, 1);
}

# atan2(y, x), correctly rounded, the angle of (x, y) in [−π, π]. Mirrors `f64::atan2`.
#must_use
fn _km_cr_atan2(y: f64, x: f64): f64 {
    var uy0 = load64(&y);
    var ux0 = load64(&x);
    var ay0 = uy0 & 0x7FFFFFFFFFFFFFFF;
    var ax0 = ux0 & 0x7FFFFFFFFFFFFFFF;
    var ey = ay0 >> 52;
    var ex = ax0 >> 52;
    # Both normal and finite (biased exponents 1 … 2046, an unsigned range test each) with |n/d| ≥ 2^-59: the
    # scaling of _km_atan2_pos done on the bits (n's significand at exponent en − ed, d's at 0: the same
    # doubles), then the fast core and its test, inline.
    if (((ey - 1) ^ 0x8000000000000000) < 0x80000000000007FE) {
        if (((ex - 1) ^ 0x8000000000000000) < 0x80000000000007FE) {
            var nb = ay0;
            var db = ax0;
            var en = ey;
            var ed = ex;
            var oct = 0;
            if (ux0 < 0) { oct = 1; }
            if (ay0 > ax0) {
                nb = ax0;
                db = ay0;
                en = ex;
                ed = ey;
                oct = oct + 2;
            }
            if (ed - en < 60) {
                var nbits = (nb & 0x000FFFFFFFFFFFFF) | ((1023 + en - ed) << 52);
                var dbits = (db & 0x000FFFFFFFFFFFFF) | 0x3FF0000000000000;
                var n: f64 = nbits;
                var d: f64 = dbits;
                var hi, lo, err = _km_atan_core(n, 0.0, d, 0.0, oct);
                var u: f64 = hi + (lo - err);
                var v: f64 = hi + (lo + err);
                if (u != v) { u = _km_atan_acc(n, 0.0, 0.0, d, 0.0, 0.0, oct); }
                if (uy0 < 0) { u = -u; }
                return u;
            }
        }
    }
    var s, sp = _km_atan2_special(y, x);
    if (sp == 1) { return s; }
    var uy = load64(&y);
    var ux = load64(&x);
    var xneg = 0;
    if (ux < 0) { xneg = 1; }
    var r, ok = _km_atan2_pos(uy & 0x7FFFFFFFFFFFFFFF, ux & 0x7FFFFFFFFFFFFFFF, xneg, 0);
    if (ok == 0) {
        var a, oka = _km_atan2_pos(uy & 0x7FFFFFFFFFFFFFFF, ux & 0x7FFFFFFFFFFFFFFF, xneg, 1);
        r = a;
    }
    if (uy < 0) { r = -r; }
    return r;
}

# The fast path alone: (atan2(y, x), 1), or (0, 0) when its rounding test fails.
#must_use
fn _km_cr_atan2_fast(y: f64, x: f64): (f64, i64) {
    var s, sp = _km_atan2_special(y, x);
    if (sp == 1) { return (s, 1); }
    var uy = load64(&y);
    var ux = load64(&x);
    var xneg = 0;
    if (ux < 0) { xneg = 1; }
    var r, ok = _km_atan2_pos(uy & 0x7FFFFFFFFFFFFFFF, ux & 0x7FFFFFFFFFFFFFFF, xneg, 0);
    if (ok == 0) { return (0.0, 0); }
    if (uy < 0) { r = -r; }
    return (r, 1);
}

# atan2(y, x) by the accurate path alone.
#must_use
fn _km_cr_atan2_acc(y: f64, x: f64): f64 {
    var s, sp = _km_atan2_special(y, x);
    if (sp == 1) { return s; }
    var uy = load64(&y);
    var ux = load64(&x);
    var xneg = 0;
    if (ux < 0) { xneg = 1; }
    var r, ok = _km_atan2_pos(uy & 0x7FFFFFFFFFFFFFFF, ux & 0x7FFFFFFFFFFFFFFF, xneg, 1);
    if (uy < 0) { r = -r; }
    return r;
}

# acos x = atan2(s, x), s = √(1 − x²) ≥ 0: θ = atan(s/|x|) (s ≤ |x|, oct 0 or 1 by x's sign) or
# atan(|x|/s) (oct 2 or 3). Fast path: 1 − x² as a double-double, exact but for a rounding at 2^-106
# ((1 − |x|)·(1 + |x|) for |x| ≥ 1/2, 1 − |x| exact by Sterbenz; 1 − x² by TwoProduct below), s by one Newton
# step from √ (2^-104 relative); the atan core's 2^-69.44 bound absorbs it. Accurate path: 1 − x² as an exact
# sum of four doubles, s by two Newton steps in triple-double (2^-150), the accurate atan core. Special values:
# acos(1) = +0, acos(−1) = π and acos(±0) = π/2 rounded; |x| < 2^-56 gives π/2 (acos x = π/2 − x − …, and
# π/2 is 2^-54.15 inside its rounding interval); NaN for NaN and |x| > 1. Mirrors `f64::acos`.
#must_use
fn _km_cr_acos(x: f64): f64 {
    var ax = load64(&x) & 0x7FFFFFFFFFFFFFFF;
    if (ax >= 0x3C70000000000000 && ax < 0x3FF0000000000000) {   # 2^-56 ≤ |x| < 1: the fast core inline
        var hi, lo, err = _km_acos_core(x);
        var u: f64 = hi + (lo - err);
        var v: f64 = hi + (lo + err);
        if (u == v) { return u; }
        var a: f64 = _km_cr_acos_acc(x);
        return a;
    }
    var r, ok = _km_acos_special(x);              # every other x is a special value
    return r;
}

# The special values of acos: (result, 1), or (0, 0) for 2^-56 ≤ |x| < 1.
#must_use
fn _km_acos_special(x: f64): (f64, i64) {
    var ax = load64(&x) & 0x7FFFFFFFFFFFFFFF;
    if (ax > 0x7FF0000000000000) { return (x, 1); }
    if (ax > 0x3FF0000000000000) {
        var nan: f64 = _km_nan();
        return (nan, 1);
    }
    if (x == 1.0) { return (0.0, 1); }
    if (x == -1.0) {
        var pi: f64 = _KM_CR_SC_PIH;
        return (pi, 1);
    }
    if (ax < 0x3C70000000000000) {                # |x| < 2^-56, ±0 included
        var p2: f64 = _KM_CR_SC_PIO2H;
        return (p2, 1);
    }
    return (0.0, 0);
}

# The fast path alone: (acos x, 1), or (0, 0) when its rounding test fails.
#must_use
fn _km_cr_acos_fast(x: f64): (f64, i64) {
    var s, sp = _km_acos_special(x);
    if (sp == 1) { return (s, 1); }
    var hi, lo, err = _km_acos_core(x);
    var u: f64 = hi + (lo - err);
    var v: f64 = hi + (lo + err);
    if (u != v) { return (0.0, 0); }
    return (u, 1);
}

# The fast core of acos for 2^-56 ≤ |x| < 1: (hi, lo, err) from the atan core.
#must_use
fn _km_acos_core(x: f64): (f64, f64, f64) {
    var ax: f64 = f64_abs(x);
    var wh: f64 = 0.0;
    var wl: f64 = 0.0;
    if (ax >= 0.5) {
        var a: f64 = 1.0 - ax;                    # exact (Sterbenz)
        var bh: f64 = 1.0 + ax;                   # Fast2Sum(1, |x|)
        var bl: f64 = ax - (bh - 1.0);
        var ca: f64 = 134217729.0 * a;            # (1 − |x|)·bh by Dekker's product
        var a1: f64 = ca - (ca - a);
        var a2: f64 = a - a1;
        var cb: f64 = 134217729.0 * bh;
        var b1: f64 = cb - (cb - bh);
        var b2: f64 = bh - b1;
        wh = a * bh;
        var we: f64 = (((a1 * b1) - wh) + (a1 * b2) + (a2 * b1)) + (a2 * b2);
        wl = we + (a * bl);
    } else {
        var cx: f64 = 134217729.0 * ax;           # x² = p + pe (Dekker)
        var x1: f64 = cx - (cx - ax);
        var x2: f64 = ax - x1;
        var p: f64 = ax * ax;
        var pe: f64 = (((x1 * x1) - p) + (2.0 * (x1 * x2))) + (x2 * x2);
        wh = 1.0 - p;                             # Fast2Sum(1, −p)
        var we2: f64 = (1.0 - wh) - p;
        wl = we2 - pe;
    }
    var sh: f64 = f64_sqrt(wh);                   # s = sh + sl, one Newton step
    var cs: f64 = 134217729.0 * sh;
    var s1: f64 = cs - (cs - sh);
    var s2: f64 = sh - s1;
    var sp2: f64 = sh * sh;
    var spe: f64 = (((s1 * s1) - sp2) + (2.0 * (s1 * s2))) + (s2 * s2);
    var sl: f64 = (((wh - sp2) - spe) + wl) / (2.0 * sh);
    var neg = 0;
    if (x < 0.0) { neg = 1; }
    if (sh <= ax) {
        var h1, l1, e1 = _km_atan_core(sh, sl, ax, 0.0, neg);
        return (h1, l1, e1);
    }
    var h2, l2, e2 = _km_atan_core(ax, 0.0, sh, sl, 2 + neg);
    return (h2, l2, e2);
}

# √(w0 + w1 + w2) for w > 0 as a triple-double at out[0..2]: two Newton corrections of √w0, each from the
# renormalised residual w − s² (2^-150).
fn _km_td_sqrt(w0: f64, w1: f64, w2: f64, out) {
    var s0: f64 = f64_sqrt(w0);
    var p, pe = _km_two_prod(s0, s0);
    var ra, rb, rc = _km_td_add(w0, w1, w2, -p, -pe, 0.0);
    var r0, r1, r2 = _km_td_norm(ra, rb, rc);     # the residual w − s0², renormalised
    var tw: f64 = 2.0 * s0;
    var c1: f64 = r0 / tw;
    var h, m = _km_fast_two_sum(s0, c1);
    var q0, q1, q2 = _km_td_mul(h, m, 0.0, h, m, 0.0);
    var ua, ub, uc = _km_td_add(w0, w1, w2, -q0, -q1, -q2);
    var u0, u1, u2 = _km_td_norm(ua, ub, uc);
    var c2: f64 = u0 / tw;
    var v0, v1, v2 = _km_td_add_d(h, m, 0.0, c2);
    store64(out, v0);
    store64(out + 8, v1);
    store64(out + 16, v2);
}

# acos x by the accurate path alone.
#must_use
fn _km_cr_acos_acc(x: f64): f64 {
    var s, sp = _km_acos_special(x);
    if (sp == 1) { return s; }
    var rb: f64[3];
    _km_acos_acc_td(x, &rb);
    var r: f64 = _km_rn3(rb[0], rb[1], rb[2]);
    return r;
}

# acos x for 2^-56 ≤ |x| < 1 as a triple-double at out[0..2] (the accurate path before its rounding).
fn _km_acos_acc_td(x: f64, out) {
    var ax: f64 = f64_abs(x);
    var w0: f64 = 0.0;
    var w1: f64 = 0.0;
    var w2: f64 = 0.0;
    if (ax >= 0.5) {                              # (1 − |x|)·(1 + |x|): four exact products
        var a: f64 = 1.0 - ax;
        var bh, bl = _km_fast_two_sum(1.0, ax);
        var p0, e0 = _km_two_prod(a, bh);
        var p1, e1 = _km_two_prod(a, bl);
        var g0, g1, g2 = _km_td_add_d(p0, e0, 0.0, p1);
        var h0, h1, h2 = _km_td_add_d(g0, g1, g2, e1);
        w0 = h0;
        w1 = h1;
        w2 = h2;
    } else {
        var p, pe = _km_two_prod(ax, ax);
        var k0, k1, k2 = _km_td_add_d(1.0, 0.0, 0.0, -p);
        var m0, m1, m2 = _km_td_add_d(k0, k1, k2, -pe);
        w0 = m0;
        w1 = m1;
        w2 = m2;
    }
    var sb: f64[3];
    _km_td_sqrt(w0, w1, w2, &sb);
    var neg = 0;
    if (x < 0.0) { neg = 1; }
    if (sb[0] <= ax) {
        _km_atan_acc_td(sb[0], sb[1], sb[2], ax, 0.0, 0.0, neg, out);
        return;
    }
    _km_atan_acc_td(ax, 0.0, 0.0, sb[0], sb[1], sb[2], 2 + neg, out);
}

# ── x·2^y, correctly rounded (M4d): ADR 0002 #13 ──────────────────────────────────────────────────────
#
# RN(x·2^y) for doubles x and y, rounded ONCE (normal results, subnormal results at the 2^-1074 grid, overflow to ±∞):
# nuclear.cyr's N₀/2ⁿ = N₀·2^(−n) where Rust's 2.0.powf(−n) is not a normal double (ADR 0002 #13). Rust's x·CR(2^y)
# rounds twice, and 2^y alone over- or underflows long before x·2^y does. With |x| = s·2^j (s in [1, 2)) and y = k + f
# (k = trunc(y), f = y − k in (−1, 1), both exact), x·2^y = ±s·2^f·2^(j + k):
# - f = 0: s·2^(j + k), one rounding by _km_cr_finish (exact inputs, so ties go to even exactly);
# - otherwise 2^f = e^(f·ln 2) from exp's machinery: f·ln 2 = yh + yl (f·LN2H by TwoProduct, + f·LN2M; within 2^-96.9
#   absolute), exp's fast core (hi + lo = 2^f/2^E within 0.9·2^-70 on [0.9993, 1.9987], E in {−1, 0, 1}), s·hi = p + pe
#   exactly (TwoProduct), q = pe + s·lo, so p + q = s·2^f/2^E within 1.8·2^-70 + 2^-88, halved (exactly) into [1, 2)
#   when p ≥ 2; then exp's finish and rounding test (_km_exp_fin) with err = 2^-68, at the final scale: one rounding for
#   a normal result, at the subnormal grid for a subnormal one. When the test fails, the accurate path: f·ln 2 as a
#   triple-double (both products by TwoProduct, f·LN2L rounded: 2^-155 relative), exp's accurate core (2^-155), the
#   product with s by _km_td_mul_d (2^-153), and _km_cr_finish: below 2^-150 relative in all.
# Exact and tie cases: for f ≠ 0, 2^f is irrational (a double f in (−1, 1) other than 0 is a rational p/q in lowest
# terms with q > 1, and 2^(p/q) = a/b would give 2^p·b^q = a^q, which unique factorisation forbids), so x·2^y is never a
# double or a midpoint, at the normal or the subnormal grid; for f = 0 the value is exact and rounded exactly. As for
# pow and atan2 (two arguments, so no exhaustive worst-case search exists), the accurate path is proven correct for
# results not within 2^-150 (relative) of a midpoint; a random pair is that close with probability about 2^-96.
# scripts/oracle/cr_verify.py checks it against MPFR (mpfr_ref.scaled_exp2: 2^f to 400 bits, bounded from both sides) on
# x86_64 ELF, x86_64 PE and aarch64. Special values: x NaN, ±0 or ±∞ gives x for every finite y (scaleB's semantics: the
# caller's N₀ itself); y NaN gives NaN; y = +∞ gives ±∞ for x ≠ 0 and NaN for x = 0, y = −∞ gives ±0 for finite x and
# NaN for x = ±∞ (x·2^y as IEEE multiplication would); |y| > 2200 is ±∞ or ±0 with no arithmetic (|x|·2^y is then above
# 2^1126 or below 2^-1176). Entry points as for exp: _km_cr_exp2_scaled, _km_cr_exp2_scaled_fast and
# _km_cr_exp2_scaled_acc.

# The special values of x·2^y: (result, 1), or (0, 0) for a finite nonzero x and a finite y with |y| ≤ 2200.
#must_use
fn _km_e2s_special(x: f64, y: f64): (f64, i64) {
    if (x != x) { return (x, 1); }
    if (y != y) { return (y, 1); }
    var dx: f64 = x - x;
    var dy: f64 = y - y;
    if (dy != 0.0) {                              # y = ±∞
        if (y > 0.0) {
            if (x == 0.0) {
                var n1: f64 = _km_nan();
                return (n1, 1);
            }
            var inf: f64 = _KM_INF;
            if (x < 0.0) { inf = -inf; }
            return (inf, 1);
        }
        if (dx != 0.0) {
            var n2: f64 = _km_nan();
            return (n2, 1);
        }
        var z: f64 = 0.0;
        if (load64(&x) < 0) { z = -z; }
        return (z, 1);
    }
    if (x == 0.0 || dx != 0.0) { return (x, 1); }  # ±0, ±∞: x
    if (y > 2200.0) {
        var big: f64 = _KM_INF;
        if (x < 0.0) { big = -big; }
        return (big, 1);
    }
    if (y < -2200.0) {
        var tiny: f64 = 0.0;
        if (x < 0.0) { tiny = -tiny; }
        return (tiny, 1);
    }
    return (0.0, 0);
}

# s·2^e rounded once, for s in [1, 2) (an exact case: f = 0): ±∞ past e = 1024, 0 below e = −1077.
#must_use
fn _km_e2s_exact(s: f64, e): f64 {
    if (e > 1024) { return _KM_INF; }             # s·2^e ≥ 2^1025
    if (e < 0 - 1077) { return 0.0; }             # s·2^e < 2^-1076: below half of 2^-1074
    var r: f64 = _km_cr_finish(e, s, 0.0, 0.0);
    return r;
}

# The fast path for |x| (bits ax, finite nonzero) and a finite y with |y| ≤ 2200: (RN(|x|·2^y), 1), or (0, 0) when
# its rounding test fails.
#must_use
fn _km_e2s_fast_pos(ax, y: f64): (f64, i64) {
    var s, j = _km_frexp(ax);
    var kf: f64 = f64_trunc(y);
    var f: f64 = y - kf;                          # exact: |f| < 1, a multiple of ulp(y)
    var e = j + f64_to(kf);
    if (f == 0.0) {
        var r0: f64 = _km_e2s_exact(s, e);
        return (r0, 1);
    }
    var lh: f64 = _KM_CR_LN_LN2H;
    var lm: f64 = _KM_CR_LN_LN2M;
    var yh, ye = _km_two_prod(f, lh);             # f·ln 2 = yh + yl to 2^-96.9
    var yl: f64 = ye + (f * lm);
    var hi, lo, eb = _km_exp_core(yh, yl);        # 2^f = 2^eb·(hi + lo), eb in {−1, 0, 1}
    var p, pe = _km_two_prod(s, hi);
    var q: f64 = pe + (s * lo);
    var ex = e + eb;
    if (p >= 2.0) {
        p = p * 0.5;
        q = q * 0.5;
        ex = ex + 1;
    }
    if (ex > 1024) {
        var inf: f64 = _KM_INF;
        return (inf, 1);
    }
    if (ex < 0 - 1077) { return (0.0, 1); }
    var err: f64 = 0x3BB0000000000000;            # 2^-68
    var ok, v = _km_exp_fin(p, q, ex, err);
    return (v, ok);
}

# The accurate path for |x| (bits ax, finite nonzero) and a finite y with |y| ≤ 2200: RN(|x|·2^y).
#must_use
fn _km_e2s_acc_pos(ax, y: f64): f64 {
    var s, j = _km_frexp(ax);
    var kf: f64 = f64_trunc(y);
    var f: f64 = y - kf;
    var e = j + f64_to(kf);
    if (f == 0.0) {
        var r0: f64 = _km_e2s_exact(s, e);
        return r0;
    }
    var lh: f64 = _KM_CR_LN_LN2H;
    var lm: f64 = _KM_CR_LN_LN2M;
    var ll: f64 = _KM_CR_LN_LN2L;
    var p0, q0 = _km_two_prod(f, lh);             # f·ln 2 as a triple-double
    var p1, q1 = _km_two_prod(f, lm);
    var p2: f64 = f * ll;
    var t, te = _km_two_sum(q0, p1);
    var u: f64 = (te + q1) + p2;
    var y0, w = _km_fast_two_sum(p0, t);
    var y1, y2 = _km_two_sum(w, u);
    var buf: f64[3];
    var eb = _km_exp_acc_core(y0, y1, y2, &buf);  # 2^f = 2^eb·(h + m + l)
    var a0, a1, a2 = _km_td_mul_d(buf[0], buf[1], buf[2], s);
    var ex = e + eb;
    if (a0 >= 2.0) {
        a0 = a0 * 0.5;
        a1 = a1 * 0.5;
        a2 = a2 * 0.5;
        ex = ex + 1;
    }
    if (ex > 1024) { return _KM_INF; }
    if (ex < 0 - 1077) { return 0.0; }
    var r: f64 = _km_cr_finish(ex, a0, a1, a2);
    return r;
}

# x·2^y, correctly rounded (rounded once, every result range). See the section comment for the special values.
#must_use
fn _km_cr_exp2_scaled(x: f64, y: f64): f64 {
    var sv, sp = _km_e2s_special(x, y);
    if (sp == 1) { return sv; }
    var ux = load64(&x);
    var ax = ux & 0x7FFFFFFFFFFFFFFF;
    var r, ok = _km_e2s_fast_pos(ax, y);
    if (ok == 0) { r = _km_e2s_acc_pos(ax, y); }
    if (ux < 0) { r = -r; }
    return r;
}

# The fast path alone: (RN(x·2^y), 1), or (0, 0) when its rounding test fails.
#must_use
fn _km_cr_exp2_scaled_fast(x: f64, y: f64): (f64, i64) {
    var sv, sp = _km_e2s_special(x, y);
    if (sp == 1) { return (sv, 1); }
    var ux = load64(&x);
    var r, ok = _km_e2s_fast_pos(ux & 0x7FFFFFFFFFFFFFFF, y);
    if (ok == 0) { return (0.0, 0); }
    if (ux < 0) { r = -r; }
    return (r, 1);
}

# x·2^y by the accurate path alone.
#must_use
fn _km_cr_exp2_scaled_acc(x: f64, y: f64): f64 {
    var sv, sp = _km_e2s_special(x, y);
    if (sp == 1) { return sv; }
    var ux = load64(&x);
    var r: f64 = _km_e2s_acc_pos(ux & 0x7FFFFFFFFFFFFFFF, y);
    if (ux < 0) { r = -r; }
    return r;
}

# ── x·2^(1/6), correctly rounded (M4d): ADR 0002 #16 ──────────────────────────────────────────────────
#
# RN(x·2^(1/6)), rounded once: potential.cyr's lj_equilibrium_distance, r_min = 2^(1/6)·σ, where Rust's
# `sigma * 2.0.powf(1.0 / 6.0)` rounds twice (2^RN(1/6), which is RN(2^(1/6)) = _KM_CR_ROOT6_2_H, then the product).
# |x| = s·2^e (s in [1, 2)); s·2^(1/6) = s·(H + M + L) as a triple-double by _km_td_mul_d (s·H and s·M by TwoProduct,
# exact; s·L and the third-order sum rounded: within 2^-154.6 absolute on a value in [1.12, 2.25), so 2^-102.6 ulp),
# halved into [1, 2) (exactly) past 2, then scaled by 2^e and rounded once by _km_cr_finish (normal results exact
# scaling, subnormal results at the 2^-1074 grid, overflow ±∞). No rounding test is needed: 2^(1/6) is irrational, and
# scripts/oracle/mathx_tables.py proves from its continued fraction that every x·2^(1/6) is at least 2^-55.1 ulp from
# a rounding boundary (normal, subnormal or the overflow threshold), so the triple-double's rounding is the correct one
# for every double x. x NaN, ±0 or ±∞ gives x (Rust's σ·RN(2^(1/6)) there).
#must_use
fn _km_cr_sixth_root2_mul(x: f64): f64 {
    var ux = load64(&x);
    var ax = ux & 0x7FFFFFFFFFFFFFFF;
    if (ax == 0 || ax >= 0x7FF0000000000000) { return x; }
    var s, e = _km_frexp(ax);
    var ch: f64 = _KM_CR_ROOT6_2_H;
    var cm: f64 = _KM_CR_ROOT6_2_M;
    var cl: f64 = _KM_CR_ROOT6_2_L;
    var h, m, l = _km_td_mul_d(ch, cm, cl, s);
    var ex = e;
    if (h >= 2.0) {
        h = h * 0.5;
        m = m * 0.5;
        l = l * 0.5;
        ex = ex + 1;
    }
    var r: f64 = _km_cr_finish(ex, h, m, l);
    if (ux < 0) { r = -r; }
    return r;
}

# ── 1/(100·x), correctly rounded (M4e): ADR 0002 #19 ──────────────────────────────────────────────────
#
# RN(1/(100·x)), the exact (1/100)/x rounded once: spectroscopy.cyr's wavenumber conversions, ν̃ = 1/(λ in cm) =
# (1/100)/λ_m, where Rust's `0.01 / x` rounds the constant 1/100 (0.01 is 1/100 + 2.08·10⁻¹⁹) and then the quotient.
# 1/(100·x) is never a midpoint: 100·x = 4·25·m·2^e, and the odd factor 25 keeps it from dividing any power of two.
# - Fast path, 2^-900 ≤ |x| ≤ 2^900 (the result, y0 and every intermediate below are normal): y0 = RN(H/|x|) with
#   1/100 = H + L + t (_KM_CR_HUNDREDTH_H, _L, |t| < 2^-116); y0·|x| = p + e exactly (TwoProduct); H − p is exact
#   (Sterbenz: p is within 2^-52 of H); r = ((H − p) − e) + L, the residual 1/100 − y0·|x| to 2^-110.2 (two roundings
#   of values below 2^-58.2, and t); d = RN(r/|x|), so y0 + d is 1/(100·|x|) to 2^-102.9 relative. The rounding test
#   uses ε = 2^-100·y0 (covering also the roundings of d ± ε, 2^-105.2): RN(y0 + (d − ε)) = RN(y0 + (d + ε)) means
#   every value between, the true one included, rounds to it. It fails with probability about 2^-47.
# - Accurate path (every finite x ≠ 0, and the fast path's fallback): exact integer arithmetic. |x| = m·2^ex (m < 2^53,
#   subnormals included), D = 100·m < 2^60 with bit length b; q = ⌊2^(b + 53)/D⌋ in [2^53, 2^54) by 53 steps of
#   restoring division from 2^b = D + (2^b − D), and its remainder; 1/(100·|x|) = (q + rem/D)·2^(−b − 53 − ex), rounded
#   once to nearest even at its binade's grid (normal) or the 2^-1074 grid (subnormal), the remainder as the sticky
#   bit; ±∞ past DBL_MAX.
# ±0 gives ±∞, ±∞ gives ±0 and NaN NaN, as Rust's 0.01/x. The sign is x's.

# The fast path alone: (RN(1/(100·x)), 1), or (0, 0) when |x| is outside [2^-900, 2^900] or the rounding test fails.
#must_use
fn _km_cr_hundredth_div_fast(x: f64): (f64, i64) {
    var ux = load64(&x);
    var ax = ux & 0x7FFFFFFFFFFFFFFF;
    if (ax < 0x07B0000000000000 || ax > 0x7830000000000000) { return (0.0, 0); }   # |x| < 2^-900 or > 2^900
    var a: f64 = ax;
    var ch: f64 = _KM_CR_HUNDREDTH_H;
    var cl: f64 = _KM_CR_HUNDREDTH_L;
    var y0: f64 = ch / a;
    var p, e = _km_two_prod(y0, a);
    var s: f64 = ch - p;
    var t: f64 = s - e;
    var r: f64 = t + cl;
    var d: f64 = r / a;
    var k100: f64 = 0x39B0000000000000;          # 2^-100
    var eps: f64 = y0 * k100;
    var lo: f64 = d - eps;
    var hi: f64 = d + eps;
    var z1: f64 = y0 + lo;
    var z2: f64 = y0 + hi;
    if (z1 != z2) { return (0.0, 0); }
    if (ux < 0) { z1 = -z1; }
    return (z1, 1);
}

# RN(1/(100·x)) by the accurate path alone: exact integer arithmetic (the section comment), every x.
#must_use
fn _km_cr_hundredth_div_acc(x: f64): f64 {
    var ux = load64(&x);
    var ax = ux & 0x7FFFFFFFFFFFFFFF;
    var sign = ux & 0x8000000000000000;
    if (ax > 0x7FF0000000000000) { return x; }                    # NaN
    if (ax == 0x7FF0000000000000) {                               # ±∞ → ±0
        var z: f64 = sign;
        return z;
    }
    if (ax == 0) {                                                # ±0 → ±∞
        var w: f64 = sign | 0x7FF0000000000000;
        return w;
    }
    var be = ax >> 52;
    var m = ax & 0x000FFFFFFFFFFFFF;
    var ex = 0 - 1074;
    if (be != 0) {
        m = m | 0x0010000000000000;
        ex = be - 1075;
    }
    var dd = m * 100;                                             # 100·m < 2^60
    var b = 0;
    var tb = dd;
    while (tb != 0) { b = b + 1; tb = tb >> 1; }                  # bit length: 2^(b − 1) < D < 2^b
    var rem = (1 << b) - dd;                                      # 2^b = 1·D + rem, rem < D
    var q = 1;
    var i = 0;
    while (i < 53) {
        rem = rem << 1;
        q = q << 1;
        if (rem >= dd) {
            rem = rem - dd;
            q = q + 1;
        }
        i = i + 1;
    }
    var sticky = 0;
    if (rem != 0) { sticky = 1; }
    var e2 = 0 - b - 53 - ex;                                     # the weight of q's last bit
    var top = e2 + 53;                                            # the value is in [2^top, 2^(top + 1))
    if (top >= 1024) {
        var o: f64 = sign | 0x7FF0000000000000;
        return o;
    }
    var lsb = top - 52;
    if (top < 0 - 1022) { lsb = 0 - 1074; }
    var sh = lsb - e2;                                            # 1 for a normal result, more for a subnormal one
    if (sh >= 55) {
        var u: f64 = sign;                                        # below half the smallest subnormal
        return u;
    }
    var q0 = q >> sh;
    var low = q & ((1 << sh) - 1);
    var half = 1 << (sh - 1);
    if (low > half || (low == half && (sticky == 1 || (q0 & 1) == 1))) { q0 = q0 + 1; }
    var rb = q0;                                                  # subnormal: q0 units of 2^-1074 (2^52 is DBL_MIN)
    if (top >= 0 - 1022) {
        if (q0 == 0x0020000000000000) {
            q0 = q0 >> 1;
            lsb = lsb + 1;
        }
        if (lsb + 52 >= 1024) {
            var o2: f64 = sign | 0x7FF0000000000000;
            return o2;
        }
        rb = ((lsb + 52 + 1023) << 52) | (q0 & 0x000FFFFFFFFFFFFF);
    }
    var res: f64 = sign | rb;
    return res;
}

# RN(1/(100·x)): the correctly rounded (1/100)/x (ADR 0002 #19). See the section comment.
#must_use
fn _km_cr_hundredth_div(x: f64): f64 {
    var r, ok = _km_cr_hundredth_div_fast(x);
    if (ok == 1) { return r; }
    var a: f64 = _km_cr_hundredth_div_acc(x);
    return a;
}

# ── binary64 with an unbounded exponent (M4e-2): ADR 0002 #20 ──────────────────────────────────────────────
#
# Rust evaluates a chain of + − × ÷ √ in IEEE binary64, so a product or quotient of inputs can overflow to ±∞ or
# underflow to a subnormal or 0 although the chain's result is representable (potential.cyr's squared coordinates: an
# Err, 0, ±∞ or a degraded angle where the true one is an ordinary double). The helpers here evaluate such a chain in
# binary64 round-to-nearest-even with an UNBOUNDED exponent range: every operation rounds its exact result to 53 bits,
# as IEEE does, and nothing overflows or underflows; the final operation is then rounded once into binary64 itself
# (its subnormal grid, or ±∞). Where Rust's chain stays in the normal range the two are the same operations on the same
# values, so the bits are Rust's; outside it they are what Rust's sequence means. ADR 0002 #20 adopts them for
# potential.cyr's geometry (M4e-2); the library-wide audit of intermediate over- and underflow after M4 uses them for
# every edge it fixes.
#
# A value is a pair (s, e) = s·2^e (two words: an f64 and an i64), normalised:
# - s finite and nonzero with 1 ≤ |s| < 2 (s carries the sign), e any i64;
# - or s = ±0, ±∞ or NaN with e = 0 (a zero keeps its IEEE sign; a special only comes from a special operand or a
#   division by zero, and propagates as IEEE's does).
# Exponents add per product and halve per √, so the chains here stay far inside ±2^62 (a degree-4 polynomial of
# doubles has |e| < 4,400).
#
# Exactness. Each operation is ONE IEEE operation on the significands whose exact result lies far inside binary64's
# normal range (or is exactly 0), so IEEE's rounding of it is the 53-bit rounding of the exact value; scaling by 2^e
# commutes with 53-bit rounding when no exponent bound intervenes:
# - ×: s₁·s₂ in [1, 4); ÷: s₁/s₂ in (½, 2); √: √s (e even) or √(2s) (e odd) in [1, 2], the exponent halved exactly;
# - +, −: with e₁ ≥ e₂ and d = e₁ − e₂ ≤ 55, s₂·2^-d is exact (at least 2^-55), and s₁ + s₂·2^-d is a multiple of
#   2^-107 below 4 in magnitude: one IEEE addition, never subnormal (an exact 0 is IEEE's +0). For d ≥ 56 the smaller
#   term is below 2^(e₁ − 55), under a quarter ulp of the larger (which is what a power of two needs below it), so the
#   53-bit sum IS the larger term;
# - the result's significand is renormalised by its own exponent field (exact).
# Comparisons and max act on the exact values (e then s); IEEE's signed-zero rules hold throughout (x − x = +0 under
# round-to-nearest, a product's sign is the xor, √−0 = −0).
#
# Final operations, rounded ONCE into binary64. A 53-bit result s·2^e is exact in binary64 when 2^-1022 ≤ |s·2^e| ≤
# DBL_MAX; past e = 1023 it overflows to ±∞ (IEEE overflow is "the 53-bit rounding exceeds DBL_MAX", so this is the IEEE
# result); below 2^-1022 it must be rounded again at the 2^-1074 grid, and a second rounding of an already rounded
# value can be wrong exactly when the 53-bit value is a midpoint of that grid. Every such midpoint is itself a 53-bit
# number (an odd multiple of 2^-1075 below 2^-1022), so the 53-bit rounding s never crosses one: the grid's rounding of
# the exact value is the grid's rounding of s, except when s·2^e IS a midpoint, where the exact error t (value =
# (s + t)·2^e) decides the side. _km_ux_round takes that error from each operation's error-free transformation and
# rounds once with _km_cr_finish (the subnormal grid, ties to even when t = 0): _km_ux_mul_f64 (TwoProduct),
# _km_ux_div_f64 (the exact remainder), _km_ux_add_f64 (TwoSum, or a sticky ±2^-60 for a term below a quarter ulp),
# _km_ux_sqrt_f64 (the residual s − r²), and _km_ux_atan2_f64, which needs no scaling at all: atan2 depends only on
# the ratio, and _km_cr_atan2's core already works on (significand, exponent difference) pairs (_km_atan2_tiny rounds
# a quotient below 2^-59 once at whatever exponent, the subnormal grid included, with its exact midpoints broken toward
# zero).
#
# Entry points: _km_ux_from (a double), _km_ux_neg, _km_ux_add, _km_ux_sub, _km_ux_mul, _km_ux_div, _km_ux_sqrt,
# _km_ux_cmp, _km_ux_le, _km_ux_max (Rust's f64::max), _km_ux_is_positive (validate.cyr's is_positive), _km_ux_round
# (the round-once conversion), the final _km_ux_add_f64, _km_ux_sub_f64, _km_ux_mul_f64, _km_ux_div_f64,
# _km_ux_sqrt_f64 and _km_ux_atan2_f64 (with _km_ux_atan2_fast and _km_ux_atan2_acc for the tests and cr_verify.py).
# tests/mathx.tcyr checks each against IEEE's own operation wherever binary64's range suffices (every pair of doubles,
# subnormal results included) and against MPFR's values beyond it; scripts/oracle/cr_verify.py checks the final
# operations against MPFR with an unbounded intermediate exponent (mpfr_ref.py's ux_* functions) on x86_64 ELF,
# x86_64 PE and aarch64.

# (s, e) for a double r whose magnitude is normal, times 2^e: s is r with its exponent field set to 0 (1 ≤ |s| < 2), e
# plus r's exponent. A zero or a special gives (r, 0). r is never subnormal here (every caller's r is a significand
# operation's result, at least 2^-107 in magnitude, or a value _km_ux_from has scaled).
#must_use
fn _km_ux_norm(r: f64, e): (f64, i64) {
    var b = load64(&r);
    var be = (b >> 52) & 0x7FF;
    if (be == 0 || be == 0x7FF) { return (r, 0); }
    var sb = (b & 0x800FFFFFFFFFFFFF) | 0x3FF0000000000000;
    var s: f64 = sb;
    return (s, e + be - 1023);
}

# The unbounded-exponent value of a double x: (s, e) with x = s·2^e exactly (subnormals included); ±0, ±∞ and NaN give
# (x, 0).
#must_use
fn _km_ux_from(x: f64): (f64, i64) {
    var b = load64(&x);
    if ((b & 0x7FF0000000000000) == 0 && (b & 0x7FFFFFFFFFFFFFFF) != 0) {
        var p54: f64 = 0x4350000000000000;           # 2^54: a subnormal scaled into the normal range, exactly
        var y: f64 = x * p54;
        var s, e = _km_ux_norm(y, 0 - 54);
        return (s, e);
    }
    var s2, e2 = _km_ux_norm(x, 0);
    return (s2, e2);
}

# −x.
#must_use
fn _km_ux_neg(xs: f64, xe): (f64, i64) {
    var n: f64 = -xs;
    return (n, xe);
}

# x·y, rounded to 53 bits with an unbounded exponent.
#must_use
fn _km_ux_mul(xs: f64, xe, ys: f64, ye): (f64, i64) {
    var p: f64 = xs * ys;
    var s, e = _km_ux_norm(p, xe + ye);
    return (s, e);
}

# x/y, rounded to 53 bits with an unbounded exponent (y = ±0 gives IEEE's ±∞ or NaN).
#must_use
fn _km_ux_div(xs: f64, xe, ys: f64, ye): (f64, i64) {
    var q: f64 = xs / ys;
    var s, e = _km_ux_norm(q, xe - ye);
    return (s, e);
}

# √x, rounded to 53 bits with an unbounded exponent: √s·2^(e/2), or √(2s)·2^((e − 1)/2) for an odd e (2s exact).
# ±0, a negative x, ±∞ and NaN as IEEE's √ (√−0 = −0).
#must_use
fn _km_ux_sqrt(xs: f64, xe): (f64, i64) {
    if (xs <= 0.0 || xs != xs || xs == _KM_INF) {
        var z: f64 = f64_sqrt(xs);
        return (z, 0);
    }
    var odd = xe & 1;
    var w: f64 = xs;
    if (odd != 0) { w = xs * 2.0; }
    var r: f64 = f64_sqrt(w);
    var s, e = _km_ux_norm(r, (xe - odd) / 2);
    return (s, e);
}

# x + y, rounded to 53 bits with an unbounded exponent (the section comment's argument). A zero operand contributes
# nothing (x + ±0 = x); two zeros, or a special, add as IEEE's significands do.
#must_use
fn _km_ux_add(xs: f64, xe, ys: f64, ye): (f64, i64) {
    var dx: f64 = xs - xs;
    var dy: f64 = ys - ys;
    if (xs == 0.0 || ys == 0.0 || dx != 0.0 || dy != 0.0) {
        if (ys == 0.0 && xs != 0.0 && dx == 0.0) { return (xs, xe); }
        if (xs == 0.0 && ys != 0.0 && dy == 0.0) { return (ys, ye); }
        var z: f64 = xs + ys;
        return (z, 0);
    }
    var hs: f64 = xs;
    var he = xe;
    var ls: f64 = ys;
    var le = ye;
    if (ye > xe) {
        hs = ys;
        he = ye;
        ls = xs;
        le = xe;
    }
    var d = he - le;
    if (d > 55) { return (hs, he); }
    var sc: f64 = _km_cr_pow2(0 - d);
    var t: f64 = ls * sc;                           # exact: at least 2^-55
    var r: f64 = hs + t;
    var s, e = _km_ux_norm(r, he);
    return (s, e);
}

# x − y, rounded to 53 bits with an unbounded exponent: x + (−y) (IEEE's x − y, signed zeros included).
#must_use
fn _km_ux_sub(xs: f64, xe, ys: f64, ye): (f64, i64) {
    var ny: f64 = -ys;
    var s, e = _km_ux_add(xs, xe, ny, ye);
    return (s, e);
}

# −1, 0 or 1 as x <, =, > y in exact value; 2 when either is NaN. Zeros are equal whatever their signs.
#must_use
fn _km_ux_cmp(xs: f64, xe, ys: f64, ye): i64 {
    if (xs != xs || ys != ys) { return 2; }
    var dx: f64 = xs - xs;
    var dy: f64 = ys - ys;
    if (xs == 0.0 || ys == 0.0 || dx != 0.0 || dy != 0.0) {
        # a zero or ±∞ against anything: the significands order the values (a finite nonzero one is 1 ≤ |s| < 2)
        if (xs < ys) { return 0 - 1; }
        if (xs > ys) { return 1; }
        return 0;
    }
    if ((xs < 0.0) != (ys < 0.0)) {
        if (xs < 0.0) { return 0 - 1; }
        return 1;
    }
    if (xe == ye) {
        if (xs < ys) { return 0 - 1; }
        if (xs > ys) { return 1; }
        return 0;
    }
    var c = 1;
    if (xe < ye) { c = 0 - 1; }
    if (xs < 0.0) { c = 0 - c; }
    return c;
}

# 1 if x ≤ y (false for a NaN), as f64's `<=` on the exact values.
#must_use
fn _km_ux_le(xs: f64, xe, ys: f64, ye): i64 {
    var c = _km_ux_cmp(xs, xe, ys, ye);
    if (c == 0 - 1 || c == 0) { return 1; }
    return 0;
}

# Rust's x.max(y) on the exact values (_km_max's semantics): a NaN operand is ignored, equal operands give y.
#must_use
fn _km_ux_max(xs: f64, xe, ys: f64, ye): (f64, i64) {
    if (xs != xs) { return (ys, ye); }
    if (ys != ys) { return (xs, xe); }
    if (_km_ux_cmp(xs, xe, ys, ye) == 1) { return (xs, xe); }
    return (ys, ye);
}

# 1 if 0 < x < +∞ (validate.cyr's _km_is_positive on the exact value): a normalised value's sign and class are its
# significand's.
#must_use
fn _km_ux_is_positive(xs: f64, xe): i64 {
    if (xs > 0.0 && xs < _KM_INF) { return 1; }
    return 0;
}

# RN((s + t)·2^e) in binary64, rounded once, for a normalised s with s = RN53(s + t) (|t| at most half an ulp of s: t
# is the exact error of the operation that produced s, or 0 for an exact value): s·2^e itself when it is normal
# (2^-1022 ≤ |s·2^e|, e ≤ 1023); ±∞ past e = 1023; at the 2^-1074 grid by _km_cr_finish (|s| + ±t, scaled once) below
# 2^-1022, where t breaks a midpoint s·2^e toward the exact value (the section comment); ±0 below 2^-1100 (under a
# quarter of 2^-1074). A zero or a special s is returned as it is.
#must_use
fn _km_ux_round(s: f64, e, t: f64): f64 {
    var ds: f64 = s - s;
    if (s == 0.0 || ds != 0.0) { return s; }
    if (e > 1023) {
        var inf: f64 = _KM_INF;
        if (s < 0.0) { inf = -inf; }
        return inf;
    }
    if (e >= 0 - 1022) {
        var sc: f64 = _km_cr_pow2(e);
        var y: f64 = s * sc;
        return y;
    }
    if (e < 0 - 1100) {
        var z: f64 = s * 0.0;
        return z;
    }
    var h: f64 = s;
    var m: f64 = t;
    if (s < 0.0) {
        h = -s;
        m = -t;
    }
    var r: f64 = _km_cr_finish(e, h, m, 0.0);
    if (s < 0.0) { r = -r; }
    return r;
}

# RN(x·y) in binary64, rounded once: the 53-bit product (TwoProduct of the significands, its exact error), then
# _km_ux_round. A zero or special operand gives IEEE's product of the significands.
#must_use
fn _km_ux_mul_f64(xs: f64, xe, ys: f64, ye): f64 {
    var p: f64 = xs * ys;
    var dp: f64 = p - p;
    if (p == 0.0 || dp != 0.0) { return p; }
    var ph, pe = _km_two_prod(xs, ys);
    var e = xe + ye;
    if (ph >= 2.0 || ph <= -2.0) {
        ph = ph * 0.5;
        pe = pe * 0.5;
        e = e + 1;
    }
    var r: f64 = _km_ux_round(ph, e, pe);
    return r;
}

# RN(x/y) in binary64, rounded once: q = RN(s₁/s₂), the remainder s₁ − q·s₂ (s₁ − p exact by Sterbenz, p = RN(q·s₂),
# then − pe: the sign is exact), its quotient by s₂ as the error, then _km_ux_round. A zero dividend, a zero divisor
# or a special gives IEEE's quotient of the significands.
#must_use
fn _km_ux_div_f64(xs: f64, xe, ys: f64, ye): f64 {
    var q: f64 = xs / ys;
    var dq: f64 = q - q;
    var dy: f64 = ys - ys;
    if (q == 0.0 || dq != 0.0 || dy != 0.0) { return q; }
    var p, pe = _km_two_prod(q, ys);
    var rem: f64 = (xs - p) - pe;
    var t: f64 = rem / ys;
    var e = xe - ye;
    if (q < 1.0 && q > -1.0) {
        q = q * 2.0;
        t = t * 2.0;
        e = e - 1;
    }
    var r: f64 = _km_ux_round(q, e, t);
    return r;
}

# RN(x + y) in binary64, rounded once: TwoSum of the aligned significands (d ≤ 55), its sum renormalised with its error;
# for d ≥ 56 the larger term with a sticky ±2^-60 in the smaller's direction (below a quarter ulp, so it moves only a
# midpoint, which is where the exact sum's side matters). A zero operand gives the other rounded once; two zeros or a
# special, IEEE's sum.
#must_use
fn _km_ux_add_f64(xs: f64, xe, ys: f64, ye): f64 {
    var dx: f64 = xs - xs;
    var dy: f64 = ys - ys;
    if (dx != 0.0 || dy != 0.0 || (xs == 0.0 && ys == 0.0)) {
        var z: f64 = xs + ys;
        return z;
    }
    if (xs == 0.0) {
        var ry: f64 = _km_ux_round(ys, ye, 0.0);
        return ry;
    }
    if (ys == 0.0) {
        var rx: f64 = _km_ux_round(xs, xe, 0.0);
        return rx;
    }
    var hs: f64 = xs;
    var he = xe;
    var ls: f64 = ys;
    var le = ye;
    if (ye > xe) {
        hs = ys;
        he = ye;
        ls = xs;
        le = xe;
    }
    var d = he - le;
    if (d > 55) {
        var st: f64 = 0x3C30000000000000;           # 2^-60
        if (ls < 0.0) { st = -st; }
        var rs: f64 = _km_ux_round(hs, he, st);
        return rs;
    }
    var sc: f64 = _km_cr_pow2(0 - d);
    var t: f64 = ls * sc;                           # exact
    var r, err = _km_two_sum(hs, t);
    if (r == 0.0) { return r; }                     # an exact cancellation: +0
    var s, e = _km_ux_norm(r, he);
    var k = e - he;                                 # r = s·2^k, −107 ≤ k ≤ 1
    var ks: f64 = _km_cr_pow2(0 - k);
    var te: f64 = err * ks;                         # exact (err is a multiple of 2^-107)
    var y: f64 = _km_ux_round(s, e, te);
    return y;
}

# RN(x − y) in binary64, rounded once.
#must_use
fn _km_ux_sub_f64(xs: f64, xe, ys: f64, ye): f64 {
    var ny: f64 = -ys;
    var r: f64 = _km_ux_add_f64(xs, xe, ny, ye);
    return r;
}

# RN(√x) in binary64, rounded once: r = RN(√w) (w = s or 2s, in [1, 4)), the residual w − r² (r² = p + pe by
# TwoProduct, w − p exact by Sterbenz, then − pe: its sign is exact), its quotient by 2r as the error, then
# _km_ux_round. √x is either exact (a 27-bit significand) or irrational, so a midpoint is only ever an exact one,
# broken to even. ±0, a negative x, ±∞ and NaN as IEEE's √.
#must_use
fn _km_ux_sqrt_f64(xs: f64, xe): f64 {
    if (xs <= 0.0 || xs != xs || xs == _KM_INF) {
        var z: f64 = f64_sqrt(xs);
        return z;
    }
    var odd = xe & 1;
    var w: f64 = xs;
    if (odd != 0) { w = xs * 2.0; }
    var r: f64 = f64_sqrt(w);
    var p, pe = _km_two_prod(r, r);
    var rem: f64 = (w - p) - pe;
    var tr: f64 = r + r;
    var t: f64 = rem / tr;
    var k = (xe - odd) / 2;
    if (r >= 2.0) {                                 # √w rounded up to 2: (1, k + 1)
        r = r * 0.5;
        t = t * 0.5;
        k = k + 1;
    }
    var y: f64 = _km_ux_round(r, k, t);
    return y;
}

# atan2(y, x) of two unbounded-exponent values, by the fast core (acc = 0: (result, 1), or (0, 0) when its rounding test
# fails) or the accurate one (acc = 1): _km_atan2_pos's octant reduction on the pairs themselves, so n/d (0 < n ≤ d) is
# mn·2^k / md with k = en − ed ≤ 0 whatever the exponents; k ≤ −60 is _km_atan2_tiny's (π/2, π, or the quotient rounded
# once at any exponent), otherwise mn·2^k is an exact double and the core is _km_cr_atan2's. A zero or special operand:
# _km_cr_atan2 of the significands (its result depends only on their signs and classes).
#must_use
fn _km_ux_atan2_any(ys: f64, ye, xs: f64, xe, acc): (f64, i64) {
    var dy: f64 = ys - ys;
    var dx: f64 = xs - xs;
    if (ys == 0.0 || xs == 0.0 || dy != 0.0 || dx != 0.0) {
        var sp: f64 = _km_cr_atan2(ys, xs);
        return (sp, 1);
    }
    var my: f64 = ys;
    if (ys < 0.0) { my = -ys; }
    var mx: f64 = xs;
    if (xs < 0.0) { mx = -xs; }
    var oct = 0;
    if (xs < 0.0) { oct = 1; }
    var mn: f64 = my;
    var en = ye;
    var md: f64 = mx;
    var ed = xe;
    if (ye > xe || (ye == xe && my > mx)) {
        mn = mx;
        en = xe;
        md = my;
        ed = ye;
        oct = oct + 2;
    }
    var k = en - ed;
    var r: f64 = 0.0;
    var ok = 1;
    if (k <= 0 - 60) {
        r = _km_atan2_tiny(mn, md, k, oct);
    } else {
        var sc: f64 = _km_cr_pow2(k);
        var n: f64 = mn * sc;                       # exact: n/d ≥ 2^-60
        if (acc == 1) {
            r = _km_atan_acc(n, 0.0, 0.0, md, 0.0, 0.0, oct);
        } else {
            var rf, okf = _km_atan_fast(n, 0.0, md, 0.0, oct);
            r = rf;
            ok = okf;
        }
    }
    if (ok == 0) { return (0.0, 0); }
    if (ys < 0.0) { r = -r; }
    return (r, 1);
}

# atan2(y, x), correctly rounded in binary64, of two unbounded-exponent values (the angle of (x, y) in [−π, π]).
#must_use
fn _km_ux_atan2_f64(ys: f64, ye, xs: f64, xe): f64 {
    var r, ok = _km_ux_atan2_any(ys, ye, xs, xe, 0);
    if (ok == 1) { return r; }
    var a, oka = _km_ux_atan2_any(ys, ye, xs, xe, 1);
    return a;
}

# The fast path alone: (atan2(y, x), 1), or (0, 0) when its rounding test fails.
#must_use
fn _km_ux_atan2_fast(ys: f64, ye, xs: f64, xe): (f64, i64) {
    var r, ok = _km_ux_atan2_any(ys, ye, xs, xe, 0);
    return (r, ok);
}

# atan2(y, x) by the accurate path alone.
#must_use
fn _km_ux_atan2_acc(ys: f64, ye, xs: f64, xe): f64 {
    var a, ok = _km_ux_atan2_any(ys, ye, xs, xe, 1);
    return a;
}

# ── exact rationals rounded once (M4e-3): ADR 0002 #21, #22 ──────────────────────────────────────────────────
#
# RN(p/q·2^e) for exact nonnegative integers p and q (q ≥ 1): spectroscopy.cyr's Bohr levels, Rydberg formula and
# reduced mass, whose exact values are such ratios of products of small integers and the binary64 constants and inputs
# (ADR 0002 #21, #22); written for reuse (M4f's stoichiometry, the library-wide audit). Two parts:
# - Multi-word unsigned integers (_km_bn_*): _KM_BN_LIMBS = 8 limbs of 32 bits, little-endian, each in an i64 word
#   (0 ≤ limb < 2^32), 64 bytes (`var a[64];`): values below 2^256. Products of two limbs and a carry are below 2^64
#   and are formed in wrapping 64-bit arithmetic, their halves taken with `&` and the logical `>>`, so every limb
#   operation is exact. The caller keeps every result below the capacity (each function says what it needs).
# - _km_cr_ratio(p, q, e): restoring long division, one quotient bit per step. With bp, bq the bit lengths and
#   t = bp − bq, N = p and D = q are aligned (D·2^t, or N·2^-t) to the same bit length L = max(bp, bq), and N doubled
#   once more (t − 1) if N < D, so D ≤ N < 2D and p/q = (N/D)·2^t. 55 steps give Q = ⌊N·2^54/D⌋ in [2^54, 2^55) and
#   the remainder (N stays below 2D: at most L + 1 bits); p/q·2^e = (Q + f)·2^(e + t − 54), 0 ≤ f < 1. The value
#   lies in [2Q, 2Q + 2)·2^(e + t − 55), strictly inside when f > 0, and 2Q + sticky (sticky = 1 iff the remainder is
#   not 0) lies in the same half-open interval; every binary64 rounding boundary there (53 bits kept of the 56, or
#   fewer at the subnormal grid, so a multiple of 4 units) is an end point of it, so the two round alike, exact values
#   and midpoints (f = 0) included: _km_cr_from_int(2Q + sticky, e + t − 55) rounds once, ties to even, subnormal
#   results on the 2^-1074 grid, +∞ past DBL_MAX, +0 below half of 2^-1074. p = 0 gives +0. About 55·(3·n) limb
#   operations for n = ⌈(L + 1)/32⌉ limbs: a microsecond, the slow path of the functions that call it.
# The double-double helpers below serve their fast paths: _km_dd_mul (a product of normalised double-doubles to
# 2^-102.99) and _km_dd_div_cr (the quotient with a rounding test), whose error budget is stated there.

# The capacity of a multi-word integer, in 32-bit limbs (8: below 2^256, 64 bytes).
const _KM_BN_LIMBS = 8;

# a = v, for v a 64-bit word read as unsigned (the other limbs cleared).
fn _km_bn_set(a, v) {
    store64(a, v & 0xFFFFFFFF);
    store64(a + 8, v >> 32);
    var k = 2;
    while (k < _KM_BN_LIMBS) {
        store64(a + 8 * k, 0);
        k = k + 1;
    }
    return 0;
}

# a = b.
fn _km_bn_copy(a, b) {
    var k = 0;
    while (k < _KM_BN_LIMBS) {
        store64(a + 8 * k, load64(b + 8 * k));
        k = k + 1;
    }
    return 0;
}

# The bit length of a (0 for zero).
#must_use
fn _km_bn_bitlen(a): i64 {
    var k = _KM_BN_LIMBS - 1;
    while (k >= 0) {
        var w = load64(a + 8 * k);
        if (w != 0) {
            var b = 0;
            while (w != 0) {
                w = w >> 1;
                b = b + 1;
            }
            return 32 * k + b;
        }
        k = k - 1;
    }
    return 0;
}

# −1, 0 or 1 as a <, =, > b.
#must_use
fn _km_bn_cmp(a, b): i64 {
    var k = _KM_BN_LIMBS - 1;
    while (k >= 0) {
        var x = load64(a + 8 * k);
        var y = load64(b + 8 * k);
        if (x < y) { return 0 - 1; }
        if (x > y) { return 1; }
        k = k - 1;
    }
    return 0;
}

# r = a + b (r may be a or b); the sum must be below 2^256.
fn _km_bn_add(r, a, b) {
    var c = 0;
    var k = 0;
    while (k < _KM_BN_LIMBS) {
        var s = load64(a + 8 * k) + load64(b + 8 * k) + c;
        store64(r + 8 * k, s & 0xFFFFFFFF);
        c = s >> 32;
        k = k + 1;
    }
    return 0;
}

# r = a − b, for a ≥ b (r may be a or b).
fn _km_bn_sub(r, a, b) {
    var borrow = 0;
    var k = 0;
    while (k < _KM_BN_LIMBS) {
        var d = load64(a + 8 * k) - load64(b + 8 * k) - borrow;
        borrow = 0;
        if (d < 0) {
            d = d + 0x100000000;
            borrow = 1;
        }
        store64(r + 8 * k, d);
        k = k + 1;
    }
    return 0;
}

# a = a·m in place, for 0 ≤ m < 2^32; the product must be below 2^256. Each limb·m + carry is below 2^64.
fn _km_bn_mul_small(a, m) {
    var c = 0;
    var k = 0;
    while (k < _KM_BN_LIMBS) {
        var t = load64(a + 8 * k) * m + c;
        store64(a + 8 * k, t & 0xFFFFFFFF);
        c = t >> 32;
        k = k + 1;
    }
    return 0;
}

# r = a·b, schoolbook on the limbs, r distinct from a and b; the product must be below 2^256. Each limb product plus
# the partial limb and the carry is below 2^64.
fn _km_bn_mul(r, a, b) {
    var k = 0;
    while (k < _KM_BN_LIMBS) {
        store64(r + 8 * k, 0);
        k = k + 1;
    }
    var la = (_km_bn_bitlen(a) + 31) / 32;
    var lb = (_km_bn_bitlen(b) + 31) / 32;
    var i = 0;
    while (i < la) {
        var ai = load64(a + 8 * i);
        var c = 0;
        var j = 0;
        while (j < lb && i + j < _KM_BN_LIMBS) {
            var t = ai * load64(b + 8 * j) + load64(r + 8 * (i + j)) + c;
            store64(r + 8 * (i + j), t & 0xFFFFFFFF);
            c = t >> 32;
            j = j + 1;
        }
        if (i + lb < _KM_BN_LIMBS) { store64(r + 8 * (i + lb), c); }
        i = i + 1;
    }
    return 0;
}

# a = a·2^s in place, for s ≥ 0; the result must be below 2^256.
fn _km_bn_shl(a, s) {
    var w = s / 32;
    var b = s - 32 * w;
    var k = _KM_BN_LIMBS - 1;
    while (k >= 0) {
        var v = 0;
        if (k - w >= 0) {
            v = (load64(a + 8 * (k - w)) << b) & 0xFFFFFFFF;
            if (b > 0 && k - w - 1 >= 0) { v = v | (load64(a + 8 * (k - w - 1)) >> (32 - b)); }
        }
        store64(a + 8 * k, v);
        k = k - 1;
    }
    return 0;
}

# (M, E) with x = M·2^E and 2^52 ≤ M < 2^53 for the bits b of a positive finite nonzero double (a subnormal's
# significand shifted up, E below −1074).
#must_use
fn _km_f64_int(b): (i64, i64) {
    var be = b >> 52;
    var m = b & 0x000FFFFFFFFFFFFF;
    if (be != 0) { return (m | 0x0010000000000000, be - 1075); }
    var e = 0 - 1074;
    while (m < 0x0010000000000000) {
        m = m << 1;
        e = e - 1;
    }
    return (m, e);
}

# RN(p/q·2^e) in binary64, rounded once, for multi-word integers 0 ≤ p < 2^254 and 1 ≤ q < 2^254 and |e| < 2^39 (the
# section comment): exact, ties to even, subnormal results on the 2^-1074 grid, +∞ past DBL_MAX, +0 for p = 0 and below
# half of 2^-1074. p and q are not changed.
#must_use
fn _km_cr_ratio(p, q, e): f64 {
    var bp = _km_bn_bitlen(p);
    if (bp == 0) { return 0.0; }
    var bq = _km_bn_bitlen(q);
    var nb[64];
    var db[64];
    var tb[64];
    _km_bn_copy(&nb, p);
    _km_bn_copy(&db, q);
    var t = bp - bq;
    var ll = bp;
    if (t >= 0) {
        _km_bn_shl(&db, t);
    } else {
        _km_bn_shl(&nb, 0 - t);
        ll = bq;
    }
    if (_km_bn_cmp(&nb, &db) < 0) {
        _km_bn_shl(&nb, 1);
        t = t - 1;
    }
    var n = (ll + 32) / 32;                         # the limbs of L + 1 bits: N < 2D throughout
    var np = &nb;
    var tp = &tb;
    var qq = 0;
    var i = 0;
    while (i < 55) {
        var borrow = 0;                             # T = N − D, kept when it does not borrow
        var k = 0;
        while (k < n) {
            var d = load64(np + 8 * k) - load64(&db + 8 * k) - borrow;
            borrow = 0;
            if (d < 0) {
                d = d + 0x100000000;
                borrow = 1;
            }
            store64(tp + 8 * k, d);
            k = k + 1;
        }
        qq = qq << 1;
        if (borrow == 0) {
            var sw = np;
            np = tp;
            tp = sw;
            qq = qq + 1;
        }
        var c = 0;                                  # N = 2N
        k = 0;
        while (k < n) {
            var w = load64(np + 8 * k);
            store64(np + 8 * k, ((w << 1) | c) & 0xFFFFFFFF);
            c = w >> 31;
            k = k + 1;
        }
        i = i + 1;
    }
    var sticky = 0;
    var j = 0;
    while (j < n) {
        if (load64(np + 8 * j) != 0) { sticky = 1; }
        j = j + 1;
    }
    var r: f64 = _km_cr_from_int(2 * qq + sticky, e + t - 55);
    return r;
}

# (a_h + a_l)·(b_h + b_l) as a normalised double-double (h, l): TwoProduct of the heads (p + e exactly), the cross terms
# a_h·b_l + a_l·b_h rounded, a_l·b_l dropped, e + c rounded, FastTwoSum (exact, |p| ≥ |e + c|). For normalised inputs
# (|a_l| ≤ 2^-53·|a_h|, likewise b) with |a_h|, |b_h| < 2^996 and |a_h·b_h| ≥ 2^-900 (TwoProduct's conditions, every
# term normal): h + l = (a_h + a_l)(b_h + b_l)(1 + δ) with |δ| ≤ 8.01·2^-106 < 2^-102.99 (with u = 2^-53 and
# P = |a_h·b_h|: the two cross products' roundings u²·P each, their sum's 2u²·P, e + c's 3u²·P, the dropped term u²·P,
# so 8u²(1 + u)·P, and P ≤ |product|/(1 − u)²), |l| ≤ 2^-53·|h|.
#must_use
fn _km_dd_mul(ah: f64, al: f64, bh: f64, bl: f64): (f64, f64) {
    var p, e = _km_two_prod(ah, bh);
    var c: f64 = (ah * bl) + (al * bh);
    var t: f64 = e + c;
    var h, l = _km_fast_two_sum(p, t);
    return (h, l);
}

# (RN(n/d), 1) for the double-double quotient n/d = (n_h + n_l)/(d_h + d_l) of an exact positive value v, or (0, 0) when
# the rounding test fails. n and d are normalised (|n_l| ≤ 2^-53·n_h, likewise d), n_h, d_h and n_h/d_h in
# [2^-900, 2^900], and they may carry relative errors δn, δd (n = N(1 + δn), d = D(1 + δd), v = N/D) with
# |δn| + |δd| ≤ 32u², u = 2^-53. y0 = RN(n_h/d_h); y0·d_h = a + b (TwoProduct); n_h − a is exact (Sterbenz: a is within
# 2u of n_h); r = (((n_h − a) − b) + n_l) − y0·d_l is n − y0·d to 7.04u²·n (four roundings: u²·n_h, 2.01u², 1.01u² and
# 3.01u² of n_h); d = RN(r/d_h) (|r| ≤ 3.02u·n, and r/d_h is r/d to 2.01u, so d is r/d to 6.08u²·v); so y0 + d is n/d to
# 13.12u², and v to 13.12u² + 32.01u² = 45.13u². The test: ε = 2^-100·y0 = 64u²·y0 ≥ 63.9u²·v; RN(d ∓ ε) are d ∓ ε to
# 3.04u²·v, so y0 + RN(d − ε) < v < y0 + RN(d + ε), and when the two sums round to the same double, RN being monotone,
# v rounds to it: exact values (half an ulp from every boundary) pass, a midpoint never does. It fails with probability
# about 2^-46 (v within 2^-99 of a midpoint, relative).
#must_use
fn _km_dd_div_cr(nh: f64, nl: f64, dh: f64, dl: f64): (f64, i64) {
    var y0: f64 = nh / dh;
    var a: f64 = y0 * dh;                           # y0·d_h = a + b: TwoProduct, inline (Veltkamp's 2^27 + 1 split)
    var sp: f64 = 134217729.0;
    var cy: f64 = sp * y0;
    var yh: f64 = cy - (cy - y0);
    var yl: f64 = y0 - yh;
    var cd: f64 = sp * dh;
    var dhh: f64 = cd - (cd - dh);
    var dhl: f64 = dh - dhh;
    var b: f64 = (yl * dhl) - (((a - (yh * dhh)) - (yl * dhh)) - (yh * dhl));
    var s: f64 = nh - a;
    var s1: f64 = s - b;
    var s2: f64 = s1 + nl;
    var s3: f64 = y0 * dl;
    var r: f64 = s2 - s3;
    var d: f64 = r / dh;
    var k100: f64 = 0x39B0000000000000;             # 2^-100
    var eps: f64 = y0 * k100;
    var lo: f64 = d - eps;
    var hi: f64 = d + eps;
    var z1: f64 = y0 + lo;
    var z2: f64 = y0 + hi;
    if (z1 != z2) { return (0.0, 0); }
    return (z1, 1);
}
