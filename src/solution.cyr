# solution.cyr — solution chemistry: concentration units, pH, weak acid/base equilibria, ionic strength and
# activity coefficients, and electrolytic conductivity (port of rust-old/src/solution.rs).
#
# Concentrations are in mol/L (M) unless stated otherwise. The acid–base functions assume aqueous solution
# at 25 °C (Kw = KM_KW_WATER_25C, pH + pOH = 14). The constants — KM_KW_WATER_25C, KM_DH_A_WATER_25C,
# KM_DH_B_WATER_25C and the seven KM_LAMBDA_* — are src/constants.cyr's (generated; solution has no data file
# of its own). Fallible functions return a value-form Result whose Err payload is a KM_ERR_* code, and
# reject NaN and ±∞ inputs. Every expression keeps Rust's operation order, so the arithmetic functions are
# bit-identical (class B), except the five below; the log10 and 10^x functions are class C
# (docs/development/port-parity.md §7, §10).
#
# - ADR 0002 #29 (the overflow audit's B2; the user's decisions of 2026-11-09 and 2026-11-10, "library-wide audit" and
#   "round once"): dilution's (M₁·V₁)/V₂ and solution_conductivity's (Λ·c)/1000 are each one quotient of a product of
#   inputs (1000 an exact integer literal), so the port returns the exact value rounded once (src/mathx.cyr's
#   correctly rounded monomial, _km_cr_mul_div), where Rust rounds twice (one ulp off on about a quarter of inputs) and
#   M₁·V₁ or Λ·c that over- or underflows gives ±∞, 0 or a degraded subnormal although the value is representable
#   (solution_conductivity(126.4, DBL_MAX) is ∞ in Rust, 2.27·10³⁰⁷ here). Rust's checks and Err codes are kept;
#   solution_conductivity, which validates nothing, keeps Rust's expression for a non-finite input.
# - ADR 0002 #33 (the overflow audit's B4; the same decisions): ionic_strength's ½·Σ c·z²,
#   kohlrausch_molar_conductivity's Λ° − K·√c and limiting_molar_conductivity's ν₊λ₊ + ν₋λ₋ have sums inside, so they
#   get ADR 0002 #20's semantics: Rust's operation sequence with an unbounded exponent (src/mathx.cyr's _km_ux_*), the
#   final operation rounded once into binary64, behind a cheap test that proves Rust's chain stayed in the normal range
#   (its bits there). A term or a partial sum past DBL_MAX that the rest brings back gave ±∞ or NaN although the value
#   is representable. Rust's checks and Err codes are kept, and a non-finite input of the two unvalidated functions
#   keeps Rust's expression.
# - ADR 0002 #35 (the overflow audit's B5; the same decisions): the activity models' log₁₀ γ — the limiting law's
#   (((−A)·z)·z)·√I, the extended law's ((((−A)·z)·z)·√I)/(1 + (B·å)·√I), Davies' (((−A)·z)·z)·(√I/(1 + √I) − 0.3·I) —
#   is the argument of one 10^x, and has sums inside, so it gets ADR 0002 #20's semantics: Rust's sequence with an
#   unbounded exponent, its final quotient or product rounded once into binary64, behind a cheap test that proves
#   Rust's chain gives that argument (or, for the extended law, one below 2⁻¹⁰²¹ in both, where γ = 1); then the
#   unchanged correctly rounded 10^x, which of the binary64 argument is the correctly rounded 10^x of the unbounded
#   53-bit one (ADR 0002 #35's lemma). A·z² past DBL_MAX at I = 0 gave ∞·0 = NaN (γ = 1), and B·å or A·z² past it in
#   the extended law γ = 1 or 0 although γ is representable. Rust's checks and Err codes are kept.
# - log10 is src/mathx.cyr's correctly rounded _km_cr_log10 and 10^x its _km_cr_exp10 (the same value as a
#   correctly rounded pow(10, x), Rust's 10.0_f64.powf(x)), as the Antoine equation's (ADR 0006). With both
#   sides on correctly rounded primitives in Rust's operation order the class-C rows are compared exactly
#   against the corrected oracle (docs/development/port-parity.md §10), henderson_hasselbalch's
#   near-cancellation rows (pKa + log10(ratio) ≈ 0) included.
# - weak_acid_ph / weak_base_ph: kimiya's own Newton iteration on the charge-balance cubic, transcribed
#   operation for operation as _km_charge_balance_root / _km_checked_root. Its iteration cap (Rust's
#   CHARGE_BALANCE_MAX_ITER = 50) and relative-step tolerance (CHARGE_BALANCE_REL_TOL = 10⁻¹²) are private
#   Rust consts, so they are typed formula constants inline here (port plan §6.4), pinned by the golden rows
#   and tests/solution.tcyr. The loop is + − × ÷ and √, so the root is bit-identical to Rust's; the pH is
#   class C only through its one log10.
# - Rust's `charge: i32` is a word here: one outside the i32 range is Err(KM_ERR_INVALID_INPUT), checked
#   first (Rust's type rejects it at compile time), never wrapped.
# - ionic_strength's `&[(f64, i32)]` is a pointer to n 16-byte records — the concentration's f64 bits, then
#   the charge as an i64 word — and the count n, as thermochem's species lists. It has no error channel (Rust
#   returns a bare f64): a negative n, a null pointer with n > 0, or a charge outside the i32 range gives NaN.

# 1 if the word z is a Rust i32 (−2³¹ ..= 2³¹ − 1).
#must_use
fn _km_is_i32(z): i64 {
    if (z < (0 - 0x80000000) || z > 0x7FFFFFFF) { return 0; }
    return 1;
}

# ── concentration units ─────────────────────────────────────────────────────────────

# Molarity M = moles / volume_liters in mol/L, from the amount of solute (mol) and the solution volume (L).
# Ok(M), or Err(KM_ERR_INVALID_INPUT) if the volume is not positive and finite or `moles` is not finite.
# Mirrors `solution::molarity`.
#must_use
fn molarity(moles: f64, volume_liters: f64): Result {
    if (_km_is_positive(volume_liters) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    if (_km_is_finite(moles) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    var m: f64 = moles / volume_liters;
    return Ok(m);
}

# Molality m = moles / solvent_kg in mol/kg, from the amount of solute (mol) and the solvent mass (kg).
# Ok(m), or Err(KM_ERR_INVALID_INPUT) if the solvent mass is not positive and finite or `moles` is not
# finite. Mirrors `solution::molality`.
#must_use
fn molality(moles: f64, solvent_kg: f64): Result {
    if (_km_is_positive(solvent_kg) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    if (_km_is_finite(moles) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    var m: f64 = moles / solvent_kg;
    return Ok(m);
}

# Dilution M₁V₁ = M₂V₂: the final concentration M₂ = M₁·V₁/V₂ in mol/L, from the initial concentration
# (mol/L) and the initial and final volumes (any one volume unit). Ok(M₂), or Err(KM_ERR_INVALID_INPUT) if
# V₂ is not positive and finite or M₁ or V₁ is not finite. ADR 0002 #29: the correctly rounded M₁·V₁/V₂ (its sign the
# xor of the factors'; a zero factor gives that signed zero), where Rust's (M₁·V₁)/V₂ rounds twice. Mirrors
# `solution::dilution`, with ADR 0002 #29.
#must_use
fn dilution(m1: f64, v1: f64, v2: f64): Result {
    if (_km_is_positive(v2) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    if (_km_is_finite(m1) != 1 || _km_is_finite(v1) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    var m2: f64 = _km_cr_mul_div(m1, v1, v2);
    return Ok(m2);
}

# ── pH ──────────────────────────────────────────────────────────────────────────────

# pH from the hydrogen ion concentration, pH = −log₁₀[H⁺], [H⁺] in mol/L. Ok(pH), or
# Err(KM_ERR_INVALID_CONCENTRATION) if [H⁺] is not positive and finite. Mirrors
# `solution::ph_from_h_concentration`.
#must_use
fn ph_from_h_concentration(h_molar: f64): Result {
    if (_km_is_positive(h_molar) != 1) { return Err(KM_ERR_INVALID_CONCENTRATION); }
    var l: f64 = _km_cr_log10(h_molar);
    var ph: f64 = -l;
    return Ok(ph);
}

# pOH from the hydroxide ion concentration, pOH = −log₁₀[OH⁻], [OH⁻] in mol/L. Ok(pOH), or
# Err(KM_ERR_INVALID_CONCENTRATION) if [OH⁻] is not positive and finite. Mirrors
# `solution::poh_from_oh_concentration`.
#must_use
fn poh_from_oh_concentration(oh_molar: f64): Result {
    if (_km_is_positive(oh_molar) != 1) { return Err(KM_ERR_INVALID_CONCENTRATION); }
    var l: f64 = _km_cr_log10(oh_molar);
    var poh: f64 = -l;
    return Ok(poh);
}

# pH = 14 − pOH (pH + pOH = 14 at 25 °C). Non-finite input propagates to the result. Mirrors
# `solution::ph_from_poh`.
#must_use
fn ph_from_poh(poh: f64): f64 {
    var ph: f64 = 14.0 - poh;
    return ph;
}

# The Henderson–Hasselbalch equation pH = pKa + log₁₀([A⁻]/[HA]), from the acid's pKa = −log₁₀(Ka) and the
# conjugate base and acid concentrations (mol/L). Ok(pH); Err(KM_ERR_INVALID_CONCENTRATION) if either
# concentration is not positive and finite (the acid's checked first); Err(KM_ERR_INVALID_INPUT) if pKa is not
# finite. pKa + log10(ratio) cancels near pH 0, where one ulp of the log moves the pH by many: the log10 is the
# correctly rounded _km_cr_log10, so the pH is the corrected oracle's bit for bit there too (ADR 0006). Mirrors
# `solution::henderson_hasselbalch`.
#must_use
fn henderson_hasselbalch(pka: f64, conjugate_base: f64, acid: f64): Result {
    if (_km_is_positive(acid) != 1 || _km_is_positive(conjugate_base) != 1) {
        return Err(KM_ERR_INVALID_CONCENTRATION);
    }
    if (_km_is_finite(pka) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    var ratio: f64 = conjugate_base / acid;
    var l: f64 = _km_cr_log10(ratio);
    var ph: f64 = pka + l;
    return Ok(ph);
}

# The H⁺ concentration from pH, [H⁺] = 10^(−pH) in mol/L. Non-finite input propagates to the result. Mirrors
# `solution::h_concentration_from_ph`.
#must_use
fn h_concentration_from_ph(ph: f64): f64 {
    var x: f64 = -ph;
    var h: f64 = _km_cr_exp10(x);
    return h;
}

# ── weak acids and bases ────────────────────────────────────────────────────────────

# Accepts a charge-balance root only if it is a usable concentration: Ok(x) if x is positive and finite,
# else Err(KM_ERR_COMPUTATION_ERROR). Mirrors Rust's private `solution::checked_root`.
#must_use
fn _km_checked_root(x: f64): Result {
    if (_km_is_positive(x) == 1) { return Ok(x); }
    return Err(KM_ERR_COMPUTATION_ERROR);
}

# The positive root x of the monoprotic weak-electrolyte charge balance
# x³ + K·x² − (K·C + Kw)·x − K·Kw = 0, x = [H⁺] for an acid (K = Ka) or [OH⁻] for a base (K = Kb), from
# x = K·C/(K + x) + Kw/x. Newton from the smaller of the upper bounds √(K·C + Kw) and (C + √(C² + 4·Kw))/2,
# which decreases monotonically onto the root. Per iteration (at most 50, Rust's CHARGE_BALANCE_MAX_ITER):
# f(x) ≤ 0 accepts x (the root to within rounding); a non-finite step (only when K·C or x³ overflows) stops;
# else x −= f/f′, and a step ≤ 10⁻¹²·x (Rust's CHARGE_BALANCE_REL_TOL, the step against the updated x)
# accepts x. An accepted x goes through _km_checked_root; a stop or 50 iterations without acceptance is
# Err(KM_ERR_COMPUTATION_ERROR). Mirrors Rust's private `solution::charge_balance_root`, operation for
# operation.
#must_use
fn _km_charge_balance_root(k: f64, c: f64): Result {
    var kw: f64 = KM_KW_WATER_25C;
    var tol: f64 = 0.000000000001;          # CHARGE_BALANCE_REL_TOL = 1e-12
    var kc_kw: f64 = (k * c) + kw;
    var weak_bound: f64 = f64_sqrt(kc_kw);
    var disc: f64 = (c * c) + (4.0 * kw);
    var sq: f64 = f64_sqrt(disc);
    var strong_bound: f64 = 0.5 * (c + sq);
    var x: f64 = _km_min(weak_bound, strong_bound);
    var it = 0;
    while (it < 50) {                       # CHARGE_BALANCE_MAX_ITER = 50
        var fx: f64 = (((x * x) * (x + k)) - (k * ((c * x) + kw))) - (kw * x);
        if (fx <= 0.0) { return _km_checked_root(x); }
        var dfx: f64 = (x * ((3.0 * x) + (2.0 * k))) - kc_kw;
        var step: f64 = fx / dfx;
        if (_km_is_finite(step) != 1) { break; }
        x = x - step;
        var lim: f64 = tol * x;
        if (step <= lim) { return _km_checked_root(x); }
        it = it + 1;
    }
    return Err(KM_ERR_COMPUTATION_ERROR);
}

# The pH of a monoprotic weak acid solution at 25 °C, from Ka (mol/L) and the analytical acid concentration C
# (mol/L): the full charge balance [H⁺] = [A⁻] + [OH⁻], water's autoionisation included, solved for [H⁺] by
# _km_charge_balance_root (dilute solutions approach pH 7 from below; a very large Ka gives the strong-acid
# limit), then pH = −log₁₀[H⁺]. Ok(pH); Err(KM_ERR_INVALID_INPUT) if Ka is not positive and finite;
# Err(KM_ERR_INVALID_CONCENTRATION) if C is not; Err(KM_ERR_COMPUTATION_ERROR) if the root can't be
# represented (e.g. Ka·C overflows). Mirrors `solution::weak_acid_ph`.
#must_use
fn weak_acid_ph(ka: f64, concentration: f64): Result {
    if (_km_is_positive(ka) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    if (_km_is_positive(concentration) != 1) { return Err(KM_ERR_INVALID_CONCENTRATION); }
    var t, v = _km_charge_balance_root(ka, concentration);
    if (is_ok(t) != 1) { return Err(v); }
    var h: f64 = v;
    return ph_from_h_concentration(h);
}

# The pH of a monoprotic weak base solution at 25 °C, from Kb (mol/L) and the analytical base concentration C
# (mol/L): weak_acid_ph's mirror, the charge balance [OH⁻] = [BH⁺] + [H⁺] solved for [OH⁻], then
# pH = 14 − pOH (dilute solutions approach pH 7 from above). Ok(pH); Err(KM_ERR_INVALID_INPUT) if Kb is not
# positive and finite; Err(KM_ERR_INVALID_CONCENTRATION) if C is not; Err(KM_ERR_COMPUTATION_ERROR) if the root
# can't be represented (e.g. Kb·C overflows). Mirrors `solution::weak_base_ph`.
#must_use
fn weak_base_ph(kb: f64, concentration: f64): Result {
    if (_km_is_positive(kb) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    if (_km_is_positive(concentration) != 1) { return Err(KM_ERR_INVALID_CONCENTRATION); }
    var t, v = _km_charge_balance_root(kb, concentration);
    if (is_ok(t) != 1) { return Err(v); }
    var oh: f64 = v;
    var tp, vp = poh_from_oh_concentration(oh);
    if (is_ok(tp) != 1) { return Err(vp); }
    var poh: f64 = vp;
    var ph: f64 = ph_from_poh(poh);
    return Ok(ph);
}

# ── ionic strength and activity coefficients ────────────────────────────────────────

# Ionic strength I = ½ Σ cᵢ·zᵢ² in mol/L, over the n (concentration, charge) records at `ions`: each 16 bytes,
# the concentration's f64 bits (mol/L), then the charge zᵢ as an i64 word. The charge is squared in f64, so any
# i32 charge is accepted; the terms (c·z)·z are summed in list order from −0.0 (Rust's `.sum()`), so no ions give
# 0.5 × −0.0 = −0.0. Concentrations are not validated: negative or non-finite ones propagate. NaN if (ions, n)
# is no list or a charge is outside the i32 range (Rust's type), since there is no error channel. ADR 0002 #33: Rust's
# chain where the sum is finite, otherwise for finite concentrations the same sequence with an unbounded exponent and
# the final ½·Σ rounded once (a sum or a term past DBL_MAX whose half is finite: ionic_strength([(0.4·DBL_MAX, 2)]) is
# 1.44·10³⁰⁸, Rust's ∞). A term c·z·z of a finite c and an integer z ≠ 0 is a multiple of 2⁻¹⁰⁷⁴ and so exact below
# 2⁻¹⁰²¹, the 53-bit rounding above, and z = 0 gives an exact zero: only overflow leaves the range, which makes the
# sum ±∞ or NaN, and a finite sum of such terms is the unbounded one (src/thermo.cyr's comment on #33's sums). Mirrors
# `solution::ionic_strength`, with ADR 0002 #33.
#must_use
fn ionic_strength(ions, n): f64 {
    if (n < 0 || (n > 0 && ions == 0)) { return _km_nan(); }
    var s: f64 = -0.0;
    var fin = 1;
    var k = 0;
    while (k < n) {
        var c: f64 = load64(ions + k * 16);
        var zi = load64(ions + k * 16 + 8);
        if (_km_is_i32(zi) != 1) { return _km_nan(); }
        var z: f64 = f64_from(zi);
        var term: f64 = (c * z) * z;
        s = s + term;
        if (_km_is_finite(c) != 1) { fin = 0; }
        k = k + 1;
    }
    var i: f64 = 0.5 * s;
    var ds: f64 = s - s;
    if (ds == 0.0 || fin != 1) { return i; }
    var u: f64 = _km_ionic_strength_ux(ions, n);
    return u;
}

# ionic_strength with an unbounded exponent (ADR 0002 #33), for a valid list of finite concentrations and i32 charges:
# Rust's ½·Σ (c·z)·z from −0.0, every product and addition rounded to 53 bits (src/mathx.cyr's _km_ux_*), the final
# product by ½ rounded once into binary64 (_km_ux_mul_f64).
#must_use
fn _km_ionic_strength_ux(ions, n): f64 {
    var z0: f64 = -0.0;
    var ss, se = _km_ux_from(z0);
    var k = 0;
    while (k < n) {
        var c: f64 = load64(ions + k * 16);
        var z: f64 = f64_from(load64(ions + k * 16 + 8));
        var cs, ce = _km_ux_from(c);
        var zs, ze = _km_ux_from(z);
        var ps, pe = _km_ux_mul(cs, ce, zs, ze);
        var ts, te = _km_ux_mul(ps, pe, zs, ze);
        var ns, ne = _km_ux_add(ss, se, ts, te);
        ss = ns;
        se = ne;
        k = k + 1;
    }
    var h: f64 = 0.5;
    var hs, he = _km_ux_from(h);
    var r: f64 = _km_ux_mul_f64(hs, he, ss, se);
    return r;
}

# The checks shared by the activity-coefficient models: KM_ERR_INVALID_INPUT if the ionic strength is negative
# or not finite, or the Debye–Hückel A parameter is not finite; else KM_ERR_NONE. Mirrors Rust's private
# `solution::validate_ionic_strength_and_a`.
#must_use
fn _km_validate_ionic_strength_and_a(ionic_str: f64, a_constant: f64): i64 {
    if (_km_is_non_negative(ionic_str) != 1) { return KM_ERR_INVALID_INPUT; }
    if (_km_is_finite(a_constant) != 1) { return KM_ERR_INVALID_INPUT; }
    return KM_ERR_NONE;
}

# The Debye–Hückel limiting law log₁₀ γ = −A·z²·√I (valid for I < 0.01 M): the dimensionless activity
# coefficient γ of an ion of charge z (a Rust i32, as a word) at ionic strength I (mol/L), with the
# Debye–Hückel A parameter in (L/mol)^½ (KM_DH_A_WATER_25C = 0.509 for water at 25 °C). Ok(γ), or
# Err(KM_ERR_INVALID_INPUT) if z is outside the i32 range, I is negative or not finite, or A is not finite.
# ADR 0002 #35 (the overflow audit's B5): log₁₀ γ is Rust's chain where A·z² is finite — a product of a double and an
# integer is a multiple of 2⁻¹⁰⁷⁴, so exact below 2⁻¹⁰²¹ and the 53-bit rounding above unless it overflows (each of
# (−A)·z and ·z), √I of a non-negative double is 0 or normal (correctly rounded in both), and the final product of
# those two operands is then rounded once in both; otherwise the unbounded chain (_km_dh_limiting_arg_ux), whose γ
# differs from Rust's only at I = 0 (debye_huckel_limiting(100000, 0, 10³⁰⁰) is 1, Rust's ∞·0 = NaN; elsewhere the
# argument is beyond ±2⁴⁸⁷, so γ is Rust's ∞ or 0). Mirrors `solution::debye_huckel_limiting`, with ADR 0002 #35.
#must_use
fn debye_huckel_limiting(charge, ionic_str: f64, a_constant: f64): Result {
    if (_km_is_i32(charge) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    var e = _km_validate_ionic_strength_and_a(ionic_str, a_constant);
    if (e != KM_ERR_NONE) { return Err(e); }
    var z: f64 = f64_from(charge);
    var sqrt_i: f64 = f64_sqrt(ionic_str);
    var az2: f64 = ((-a_constant) * z) * z;
    var log_gamma: f64 = az2 * sqrt_i;
    var d: f64 = az2 - az2;
    if (d != 0.0) { log_gamma = _km_dh_limiting_arg_ux(charge, ionic_str, a_constant); }
    var gamma: f64 = _km_cr_exp10(log_gamma);
    return Ok(gamma);
}

# debye_huckel_limiting's log₁₀ γ with an unbounded exponent (ADR 0002 #35), for its validated inputs: Rust's
# ((−A)·z)·z and √I rounded to 53 bits (src/mathx.cyr's _km_ux_*), the final product rounded once into binary64.
#must_use
fn _km_dh_limiting_arg_ux(charge, ionic_str: f64, a_constant: f64): f64 {
    var z: f64 = f64_from(charge);
    var zs, ze = _km_ux_from(z);
    var as, ae = _km_ux_from(a_constant);
    var ns, ne = _km_ux_neg(as, ae);
    var ps, pe = _km_ux_mul(ns, ne, zs, ze);
    var qs, qe = _km_ux_mul(ps, pe, zs, ze);
    var is, ie = _km_ux_from(ionic_str);
    var rs, re = _km_ux_sqrt(is, ie);
    var x: f64 = _km_ux_mul_f64(qs, qe, rs, re);
    return x;
}

# The extended Debye–Hückel equation log₁₀ γ = −A·z²·√I / (1 + B·å·√I) (valid for I < 0.1 M): γ of an ion of
# charge z (a word) at ionic strength I (mol/L), with A in (L/mol)^½ (KM_DH_A_WATER_25C), B in Å⁻¹·(mol/L)^−½
# (KM_DH_B_WATER_25C = 0.328 for water at 25 °C) and the effective ion diameter å in Å (typically 3–9). Ok(γ),
# or Err(KM_ERR_INVALID_INPUT) if z is outside the i32 range, I is negative or not finite, A is not finite, or B
# or å is negative or not finite (a negative B·å could make 1 + B·å·√I zero). ADR 0002 #35 (the overflow audit's
# B5): Rust's chain where the numerator (((−A)·z)·z)·√I and y = (B·å)·√I are finite. Then A·z² is finite, so the
# 53-bit rounding of its exact value (debye_huckel_limiting's argument), and √I is; the numerator is the 53-bit
# rounding of its exact value where it is at least 2⁻¹⁰²¹ or an exact zero, and otherwise below 2⁻¹⁰²¹ in both
# evaluations; B·å is the 53-bit one where it is at least 2⁻¹⁰²¹ or 0, and otherwise y is below 2⁻⁵⁰⁹ in both (√I <
# 2⁵¹²); so 1 + y, a sum at least 1, is the unbounded one in both (exactly 1 where y < 2⁻⁵³). The final quotient of
# those operands is then rounded once in both, or both are below 2⁻¹⁰²¹ (the denominator is at least 1), where 10^x
# is 1. Otherwise the unbounded chain (_km_dh_extended_arg_ux): debye_huckel_extended(1, 1, 10³⁰⁸, 10¹⁵⁵, 10¹⁵⁵) is
# 0.977, Rust's 10^(−x/∞) = 1, (100000, 1, 10³⁰⁰, 10¹⁵⁴, 10¹⁵⁴) 10⁻¹⁰⁰, Rust's 10^−∞ = 0, and B·å past DBL_MAX at
# I = 0 gives 1, Rust's ∞·0 = NaN. Mirrors `solution::debye_huckel_extended`, with ADR 0002 #35.
#must_use
fn debye_huckel_extended(charge, ionic_str: f64, a_constant: f64, b_constant: f64, ion_size: f64): Result {
    if (_km_is_i32(charge) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    var e = _km_validate_ionic_strength_and_a(ionic_str, a_constant);
    if (e != KM_ERR_NONE) { return Err(e); }
    if (_km_is_non_negative(b_constant) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    if (_km_is_non_negative(ion_size) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    var sqrt_i: f64 = f64_sqrt(ionic_str);
    var z: f64 = f64_from(charge);
    var num: f64 = (((-a_constant) * z) * z) * sqrt_i;
    var y: f64 = (b_constant * ion_size) * sqrt_i;
    var den: f64 = 1.0 + y;
    var log_gamma: f64 = num / den;
    var dn: f64 = num - num;
    var dy: f64 = y - y;
    if (dn != 0.0 || dy != 0.0) {
        log_gamma = _km_dh_extended_arg_ux(charge, ionic_str, a_constant, b_constant, ion_size);
    }
    var gamma: f64 = _km_cr_exp10(log_gamma);
    return Ok(gamma);
}

# debye_huckel_extended's log₁₀ γ with an unbounded exponent (ADR 0002 #35), for its validated inputs: Rust's
# numerator (((−A)·z)·z)·√I and denominator 1 + (B·å)·√I rounded to 53 bits (src/mathx.cyr's _km_ux_*; the denominator
# is at least 1), the quotient rounded once into binary64.
#must_use
fn _km_dh_extended_arg_ux(charge, ionic_str: f64, a_constant: f64, b_constant: f64, ion_size: f64): f64 {
    var z: f64 = f64_from(charge);
    var zs, ze = _km_ux_from(z);
    var as, ae = _km_ux_from(a_constant);
    var ns, ne = _km_ux_neg(as, ae);
    var ps, pe = _km_ux_mul(ns, ne, zs, ze);
    var qs, qe = _km_ux_mul(ps, pe, zs, ze);
    var is, ie = _km_ux_from(ionic_str);
    var rs, re = _km_ux_sqrt(is, ie);
    var us, ue = _km_ux_mul(qs, qe, rs, re);
    var bs, be = _km_ux_from(b_constant);
    var ks, ke = _km_ux_from(ion_size);
    var cs, ce = _km_ux_mul(bs, be, ks, ke);
    var ys, ye = _km_ux_mul(cs, ce, rs, re);
    var one: f64 = 1.0;
    var os, oe = _km_ux_from(one);
    var ds, de = _km_ux_add(os, oe, ys, ye);
    var x: f64 = _km_ux_div_f64(us, ue, ds, de);
    return x;
}

# The Davies equation log₁₀ γ = −A·z²·(√I/(1 + √I) − 0.3·I) (valid for I < 0.5 M; no ion size): γ of an ion of
# charge z (a word) at ionic strength I (mol/L), with A in (L/mol)^½ (KM_DH_A_WATER_25C for water at 25 °C).
# Ok(γ), or Err(KM_ERR_INVALID_INPUT) if z is outside the i32 range, I is negative or not finite, or A is not
# finite. ADR 0002 #35 (the overflow audit's B5): log₁₀ γ is Rust's chain where A·z² is finite (then the 53-bit
# rounding of its exact value: debye_huckel_limiting's argument). The bracket is always the unbounded one: √I is 0 or
# normal, 1 + √I at least 1, √I/(1 + √I) 0 or at least 2⁻⁵³⁸; 0.3·I is the 53-bit rounding of its exact value where it
# is at least 2⁻¹⁰²¹, and below that (I < 2⁻¹⁰¹⁹) under 2⁻⁴⁸³ of √I/(1 + √I), whose difference with it then rounds to
# √I/(1 + √I) in both; and the difference of two doubles is exact below 2⁻¹⁰²¹. So the final product of those operands
# is rounded once in both; otherwise the unbounded chain (_km_davies_arg_ux), whose γ differs from Rust's only where
# the bracket is 0 (I = 0, or √I/(1 + √I) and 0.3·I the same double): davies_activity(100000, 0, 10³⁰⁰) is 1, Rust's
# ∞·0 = NaN; a nonzero bracket is at least 2⁻⁵⁴ or 0.19·√I, so the argument is beyond ±2⁴⁸⁴ and γ Rust's ∞ or 0.
# Mirrors `solution::davies_activity`, with ADR 0002 #35.
#must_use
fn davies_activity(charge, ionic_str: f64, a_constant: f64): Result {
    if (_km_is_i32(charge) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    var e = _km_validate_ionic_strength_and_a(ionic_str, a_constant);
    if (e != KM_ERR_NONE) { return Err(e); }
    var sqrt_i: f64 = f64_sqrt(ionic_str);
    var z: f64 = f64_from(charge);
    var bracket: f64 = (sqrt_i / (1.0 + sqrt_i)) - (0.3 * ionic_str);
    var az2: f64 = ((-a_constant) * z) * z;
    var log_gamma: f64 = az2 * bracket;
    var d: f64 = az2 - az2;
    if (d != 0.0) { log_gamma = _km_davies_arg_ux(charge, ionic_str, a_constant); }
    var gamma: f64 = _km_cr_exp10(log_gamma);
    return Ok(gamma);
}

# davies_activity's log₁₀ γ with an unbounded exponent (ADR 0002 #35), for its validated inputs: Rust's ((−A)·z)·z and
# bracket √I/(1 + √I) − 0.3·I rounded to 53 bits (src/mathx.cyr's _km_ux_*), the final product rounded once into
# binary64.
#must_use
fn _km_davies_arg_ux(charge, ionic_str: f64, a_constant: f64): f64 {
    var z: f64 = f64_from(charge);
    var zs, ze = _km_ux_from(z);
    var as, ae = _km_ux_from(a_constant);
    var ns, ne = _km_ux_neg(as, ae);
    var ps, pe = _km_ux_mul(ns, ne, zs, ze);
    var qs, qe = _km_ux_mul(ps, pe, zs, ze);
    var is, ie = _km_ux_from(ionic_str);
    var rs, re = _km_ux_sqrt(is, ie);
    var one: f64 = 1.0;
    var os, oe = _km_ux_from(one);
    var ds, de = _km_ux_add(os, oe, rs, re);
    var fs, fe = _km_ux_div(rs, re, ds, de);
    var c: f64 = 0.3;
    var cs, ce = _km_ux_from(c);
    var ts, te = _km_ux_mul(cs, ce, is, ie);
    var bs, be = _km_ux_sub(fs, fe, ts, te);
    var x: f64 = _km_ux_mul_f64(qs, qe, bs, be);
    return x;
}

# ── conductivity ────────────────────────────────────────────────────────────────────

# Kohlrausch's law Λ_m = Λ°_m − K·√c: the molar conductivity (S·cm²/mol) at concentration c (mol/L), from the
# limiting molar conductivity at infinite dilution Λ°_m (S·cm²/mol) and the Kohlrausch constant K
# (S·cm²·L^½/mol^(3/2)). Ok(Λ_m); Err(KM_ERR_INVALID_CONCENTRATION) if c is negative or not finite;
# Err(KM_ERR_INVALID_INPUT) if Λ°_m or K is not finite. ADR 0002 #33: Rust's chain where K·√c is the 53-bit rounding of
# its exact value (normal, _km_ux_normal, or an exact zero: K = 0 or c = 0; √c itself, of a non-negative double, is 0
# or normal and correctly rounded in both), so the final difference is rounded once in both; otherwise the same
# sequence with an unbounded exponent and the difference rounded once (kohlrausch_molar_conductivity(DBL_MAX, DBL_MAX,
# 1.21) is −1.80·10³⁰⁷, Rust's −∞). Mirrors `solution::kohlrausch_molar_conductivity`, with ADR 0002 #33.
#must_use
fn kohlrausch_molar_conductivity(lambda_zero: f64, k_kohlrausch: f64, concentration: f64): Result {
    if (_km_is_non_negative(concentration) != 1) { return Err(KM_ERR_INVALID_CONCENTRATION); }
    if (_km_is_finite(lambda_zero) != 1 || _km_is_finite(k_kohlrausch) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    var lm, ok = _km_kohlrausch_fast(lambda_zero, k_kohlrausch, concentration);
    if (ok == 1) { return Ok(lm); }
    var u: f64 = _km_kohlrausch_ux(lambda_zero, k_kohlrausch, concentration);
    return Ok(u);
}

# kohlrausch_molar_conductivity's fast path, for its validated inputs: (Rust's Λ° − K·√c, 1) where K·√c is the 53-bit
# rounding of its exact value (normal, _km_ux_normal, or an exact zero: K = 0 or c = 0), otherwise (0, 0).
#must_use
fn _km_kohlrausch_fast(lambda_zero: f64, k_kohlrausch: f64, concentration: f64): (f64, i64) {
    var sq: f64 = f64_sqrt(concentration);
    var p: f64 = k_kohlrausch * sq;
    var lm: f64 = lambda_zero - p;
    if (_km_ux_normal(p) == 1 || k_kohlrausch == 0.0 || sq == 0.0) { return (lm, 1); }
    return (0.0, 0);
}

# kohlrausch_molar_conductivity with an unbounded exponent (ADR 0002 #33), for its validated inputs: Rust's Λ° − K·√c
# with √c and K·√c rounded to 53 bits (_km_ux_*), the difference rounded once into binary64.
#must_use
fn _km_kohlrausch_ux(lambda_zero: f64, k_kohlrausch: f64, concentration: f64): f64 {
    var ls, le = _km_ux_from(lambda_zero);
    var ks, ke = _km_ux_from(k_kohlrausch);
    var cs, ce = _km_ux_from(concentration);
    var qs, qe = _km_ux_sqrt(cs, ce);
    var ps, pe = _km_ux_mul(ks, ke, qs, qe);
    var u: f64 = _km_ux_sub_f64(ls, le, ps, pe);
    return u;
}

# Kohlrausch's law of independent ion migration Λ°_m = ν₊·λ°₊ + ν₋·λ°₋ in S·cm²/mol, from the cation's and
# anion's limiting ionic conductivities λ° (S·cm²/mol, e.g. KM_LAMBDA_NA_PLUS) and stoichiometric numbers ν.
# Non-finite input propagates to the result. ADR 0002 #33: Rust's chain where both products are the 53-bit roundings of
# their exact values (normal, _km_ux_normal, or an exact zero: a zero factor), the final sum rounded once in both;
# otherwise, for finite inputs, the same sequence with an unbounded exponent and the sum rounded once
# (limiting_molar_conductivity(DBL_MAX, 1.5, −DBL_MAX, 1) is 8.99·10³⁰⁷, Rust's ∞); a non-finite input keeps Rust's
# expression. Mirrors `solution::limiting_molar_conductivity`, with ADR 0002 #33.
#must_use
fn limiting_molar_conductivity(cation_conductivity: f64, cation_stoich: f64, anion_conductivity: f64,
    anion_stoich: f64): f64 {
    var l, ok = _km_limiting_fast(cation_conductivity, cation_stoich, anion_conductivity, anion_stoich);
    if (ok == 1) { return l; }
    var nf = _km_is_finite(cation_conductivity) + _km_is_finite(cation_stoich) + _km_is_finite(anion_conductivity);
    if (nf + _km_is_finite(anion_stoich) != 4) {
        var r: f64 = (cation_stoich * cation_conductivity) + (anion_stoich * anion_conductivity);
        return r;
    }
    var u: f64 = _km_limiting_ux(cation_conductivity, cation_stoich, anion_conductivity, anion_stoich);
    return u;
}

# limiting_molar_conductivity's fast path: (Rust's ν₊·λ₊ + ν₋·λ₋, 1) where both products are the 53-bit roundings of
# their exact values (normal, _km_ux_normal, or an exact zero: a zero factor), otherwise (0, 0). For a non-finite input
# that passes it, the value is Rust's expression too.
#must_use
fn _km_limiting_fast(cation_conductivity: f64, cation_stoich: f64, anion_conductivity: f64,
    anion_stoich: f64): (f64, i64) {
    var p1: f64 = cation_stoich * cation_conductivity;
    var p2: f64 = anion_stoich * anion_conductivity;
    var l: f64 = p1 + p2;
    var ok1 = 0;
    if (_km_ux_normal(p1) == 1 || cation_stoich == 0.0 || cation_conductivity == 0.0) { ok1 = 1; }
    if (ok1 == 1 && (_km_ux_normal(p2) == 1 || anion_stoich == 0.0 || anion_conductivity == 0.0)) { return (l, 1); }
    return (0.0, 0);
}

# limiting_molar_conductivity with an unbounded exponent (ADR 0002 #33), for finite inputs: Rust's ν₊·λ₊ + ν₋·λ₋ with
# the products rounded to 53 bits (_km_ux_*), the sum rounded once into binary64.
#must_use
fn _km_limiting_ux(cation_conductivity: f64, cation_stoich: f64, anion_conductivity: f64, anion_stoich: f64): f64 {
    var vs, ve = _km_ux_from(cation_stoich);
    var cs, ce = _km_ux_from(cation_conductivity);
    var ws, we = _km_ux_from(anion_stoich);
    var as1, ae = _km_ux_from(anion_conductivity);
    var ps, pe = _km_ux_mul(vs, ve, cs, ce);
    var qs, qe = _km_ux_mul(ws, we, as1, ae);
    var u: f64 = _km_ux_add_f64(ps, pe, qs, qe);
    return u;
}

# The solution conductivity κ = Λ_m × c / 1000 in S/cm, from the molar conductivity Λ_m (S·cm²/mol) and the
# concentration c (mol/L). Non-finite input propagates to the result. ADR 0002 #29: the correctly rounded Λ·c/1000 for
# finite inputs (a zero factor gives its signed zero), where Rust's (Λ·c)/1000 rounds twice; a non-finite input gives
# Rust's (Λ·c)/1000. Mirrors `solution::solution_conductivity`, with ADR 0002 #29.
#must_use
fn solution_conductivity(molar_conductivity: f64, concentration: f64): f64 {
    var f, ok = _km_mul_div_fast(molar_conductivity, concentration, 1000.0);
    if (ok == 1) { return f; }
    if (_km_is_finite(molar_conductivity) != 1 || _km_is_finite(concentration) != 1) {
        var kappa: f64 = (molar_conductivity * concentration) / 1000.0;
        return kappa;
    }
    var r: f64 = _km_cr_mul_div(molar_conductivity, concentration, 1000.0);
    return r;
}
