    # Metalloids: B, Si, Ge, As, Sb, Te.
    KM_ELEMENT_CATEGORY_METALLOID = 4;
    # Reactive nonmetals other than the halogens: H, C, N, O, P, S, Se.
    KM_ELEMENT_CATEGORY_NONMETAL = 5;
    # Group 17: F, Cl, Br, I, At, Ts.
    KM_ELEMENT_CATEGORY_HALOGEN = 6;
    # Group 18: He, Ne, Ar, Kr, Xe, Rn, Og.
    KM_ELEMENT_CATEGORY_NOBLE_GAS = 7;
