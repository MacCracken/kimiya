# reaction_dynamics.cyr — the time evolution of chemical systems by ODE integration (port of
# rust-old/src/reaction_dynamics.rs; M5a).
#
# Concentration trajectories from 0 to t_end, in the time unit of the rate constants (s for rate constants in s⁻¹),
# concentrations in mol/L: classical RK4 (fixed step, explicit) for the five built-in rate laws, Dormand–Prince 4(5)
# (adaptive, explicit) for a custom system, backward Euler (implicit, Newton iteration on a dense solve) for a stiff
# one, and Euler–Maruyama for a stochastic one. The integrators are hisab 1.4.0's, transcribed into src/numerics.cyr
# (ADR 0003); the backward-Euler loop is kimiya's own, transcribed here. Rust's checks, Err codes and check order are
# kept; every expression keeps Rust's operation order, so the RK4 and backward-Euler trajectories are bit-identical to
# the oracle's (class B), and the adaptive and stochastic ones, which take a pow per step and a ln and a cos per normal
# draw, the corrected oracle's (class C, bound 0, ADR 0006). Fixed-step methods accept at most 10 000 000 steps.
#
# - **Callbacks** (port plan §6.3). Rust's `impl Fn(f64, &[f64], &mut [f64])` closures are a function pointer and a
#   context pointer each: f(ctx, t, y, dy, n) fills dy[0 .. n) from y[0 .. n) at time t (y and dy point to n f64, the
#   state's dimension; the return value is ignored); the Jacobian is jac(ctx, t, y, j, n), filling the flat row-major
#   n × n buffer j (∂fᵢ/∂yⱼ at j + 8·(i·n + j)). As in Rust, every work buffer a callback writes (dy, the Jacobian, the
#   diffusion) starts zeroed and is reused, never re-zeroed, between calls, so a callback that leaves an entry alone
#   leaves its previous value. The flat Jacobian cannot be resized, so Rust's "Jacobian must stay n×n" Err has no
#   counterpart (port plan §4, M5).
# - **Trajectories** (port plan §4, M5). Rust's `Vec<TrajectoryPoint>`, `TrajectoryPoint = (f64, Vec<f64>)`, is the
#   caller's buffer `out` of `cap` points, each 1 + n f64 (t, then the n concentrations), point k at
#   out + 8·k·(1 + n): Ok(points written). A slice argument (y0) is a pointer and a count; a negative count, a null
#   pointer with values or a null function pointer is Err(KM_ERR_INVALID_INPUT), checked first (an out-of-type
#   input, port plan §6.4). Err(KM_ERR_INVALID_INPUT) when the trajectory doesn't fit, checked after Rust's own
#   errors: an RK4 or Euler–Maruyama run knows its steps + 1 points and then integrates without storing, to give
#   Rust's error first, and leaves `out` untouched; simulate_stiff writes its two points only at the end; the adaptive
#   run stores the first cap points while it integrates. On Err(KM_ERR_COMPUTATION_ERROR) the buffer holds whatever
#   the solver wrote before it failed.
# - **Integers.** `steps` is Rust's usize: a negative word is past 10 000 000 (Err), never wrapped; `seed` is a u64
#   word, used as its bits.
# - **Typed constants.** Rust's MAX_STEPS (10⁷), STIFF_MAX_NEWTON (20), STIFF_NEWTON_RTOL (10⁻¹⁰) and
#   STIFF_ACCEPT_RTOL (10⁻⁶) are typed inline (port plan §6.4); the golden rows and tests/reaction_dynamics.tcyr pin
#   them.

include "lib/alloc.cyr"
include "lib/hisab.cyr"

# Rust's MAX_STEPS: the largest accepted step count.
const _KM_RD_MAX_STEPS = 10000000;

# Work-table words kept on the stack by simulate_stiff (y, y₊, f, δ: 4n; the Jacobian n²; the Newton system
# n·(n + 1): 2n² + 5n, so n ≤ 8 here).
const _KM_RD_STIFF_STACK = 168;

# Rust's validate_time_and_steps: KM_ERR_NONE, or the code for a t_end that is not positive and finite, then a step
# count of 0 or past 10⁷ (a negative word is a usize past it).
#must_use
fn _km_rd_time_and_steps(t_end: f64, steps): i64 {
    if (_km_is_positive(t_end) != 1) { return KM_ERR_INVALID_INPUT; }
    if (steps == 0) { return KM_ERR_INVALID_INPUT; }
    if (steps < 0 || steps > _KM_RD_MAX_STEPS) { return KM_ERR_INVALID_INPUT; }
    return KM_ERR_NONE;
}

# 1 if every one of the n f64 at y is finite (Rust's validate_state, and finish_trajectory's final-state test).
#must_use
fn _km_rd_all_finite(y, n): i64 {
    var k = 0;
    while (k < n) {
        var v: f64 = load64(y + 8 * k);
        if (_km_is_finite(v) != 1) { return 0; }
        k = k + 1;
    }
    return 1;
}

# 1 if (p, n) is a slice: n ≥ 0, and p not null when n > 0.
#must_use
fn _km_rd_slice(p, n): i64 {
    if (n < 0 || (n > 0 && p == 0)) { return 0; }
    return 1;
}

# ∞-norm of n f64 at v, Rust's max_abs: fold from 0 with max (NaN-ignoring) of |x|.
#must_use
fn _km_rd_max_abs(v, n): f64 {
    var m: f64 = 0.0;
    var k = 0;
    while (k < n) {
        var x: f64 = load64(v + 8 * k);
        var a: f64 = f64_abs(x);
        m = _km_max(m, a);
        k = k + 1;
    }
    return m;
}

# ── the built-in rate laws (Rust's closures; ctx points to the rate constants) ────────

# d[A]/dt = −k[A].
fn _km_rd_first_order_f(ctx, t: f64, y, dy, n) {
    var k: f64 = load64(ctx);
    var nk: f64 = -k;
    var a: f64 = load64(y);
    var d: f64 = nk * a;
    store64(dy, d);
    return 0;
}

# d[A]/dt = −k[A]².
fn _km_rd_second_order_f(ctx, t: f64, y, dy, n) {
    var k: f64 = load64(ctx);
    var nk: f64 = -k;
    var a: f64 = load64(y);
    var d: f64 = nk * a;
    d = d * a;
    store64(dy, d);
    return 0;
}

# A →(k₁) B →(k₂) C: d[A]/dt = −k₁[A], d[B]/dt = k₁[A] − k₂[B], d[C]/dt = k₂[B].
fn _km_rd_consecutive_f(ctx, t: f64, y, dy, n) {
    var k1: f64 = load64(ctx);
    var k2: f64 = load64(ctx + 8);
    var a: f64 = load64(y);
    var b: f64 = load64(y + 8);
    var nk1: f64 = -k1;
    var da: f64 = nk1 * a;
    var p: f64 = k1 * a;
    var q: f64 = k2 * b;
    var db: f64 = p - q;
    store64(dy, da);
    store64(dy + 8, db);
    store64(dy + 16, q);
    return 0;
}

# A ⇌ B: d[A]/dt = −k_f[A] + k_r[B], d[B]/dt = k_f[A] − k_r[B].
fn _km_rd_reversible_f(ctx, t: f64, y, dy, n) {
    var kf: f64 = load64(ctx);
    var kr: f64 = load64(ctx + 8);
    var a: f64 = load64(y);
    var b: f64 = load64(y + 8);
    var nkf: f64 = -kf;
    var p: f64 = nkf * a;
    var q: f64 = kr * b;
    var da: f64 = p + q;
    var r: f64 = kf * a;
    var db: f64 = r - q;
    store64(dy, da);
    store64(dy + 8, db);
    return 0;
}

# Michaelis–Menten with depletion: rate = Vmax·[S]/(Km + [S]), d[S]/dt = −rate, d[P]/dt = rate.
fn _km_rd_michaelis_menten_f(ctx, t: f64, y, dy, n) {
    var vmax: f64 = load64(ctx);
    var km: f64 = load64(ctx + 8);
    var s: f64 = load64(y);
    var num: f64 = vmax * s;
    var den: f64 = km + s;
    var rate: f64 = num / den;
    var nrate: f64 = -rate;
    store64(dy, nrate);
    store64(dy + 8, rate);
    return 0;
}

# A built-in rate law integrated by RK4 from (0, y0[0 .. n)), n ≤ 3, after Rust's checks, then Rust's
# finish_trajectory: Ok(steps + 1); Err(KM_ERR_COMPUTATION_ERROR) if the solver fails or the final state is not
# finite; Err(KM_ERR_INVALID_INPUT) if the steps + 1 points don't fit (after integrating without storing, so Rust's
# error comes first and `out` is untouched).
#must_use
fn _km_rd_rk4(f, ctx, y0, n, t_end: f64, steps, out, cap): Result {
    var count = steps + 1;
    var o = out;
    var c = cap;
    if (out == 0 || cap < count) {
        o = 0;
        c = 0;
    }
    var fin: f64[3];
    var r, v = _km_rk4_trajectory(f, ctx, 0.0, y0, n, t_end, steps, o, c, &fin);
    if (is_err_result(r) == 1) { return Err(KM_ERR_COMPUTATION_ERROR); }
    if (_km_rd_all_finite(&fin, n) != 1) { return Err(KM_ERR_COMPUTATION_ERROR); }
    if (o == 0) { return Err(KM_ERR_INVALID_INPUT); }
    return Ok(count);
}

# First-order decay, d[A]/dt = −k[A], from [A]₀ (mol/L) with k (s⁻¹), by RK4 in `steps` steps (1 ..= 10⁷) to t_end:
# the steps + 1 points (t, [A]) from t = 0, 2 f64 each, to the caller's buffer `out` of `cap` points. RK4 is explicit:
# it is only stable for k·t_end/steps ≲ 2.78. Ok(steps + 1); Err(KM_ERR_INVALID_CONCENTRATION) if [A]₀ is negative or
# not finite; Err(KM_ERR_INVALID_INPUT) if k is negative or not finite, t_end is not positive and finite, or steps is
# 0 or above 10⁷; Err(KM_ERR_COMPUTATION_ERROR) if the solver fails or the final state is not finite;
# Err(KM_ERR_INVALID_INPUT) if the points don't fit. Mirrors `reaction_dynamics::simulate_first_order`.
#must_use
fn simulate_first_order(initial_concentration: f64, rate_constant: f64, t_end: f64, steps, out, cap): Result {
    if (_km_is_non_negative(initial_concentration) != 1) { return Err(KM_ERR_INVALID_CONCENTRATION); }
    if (_km_is_non_negative(rate_constant) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    var e = _km_rd_time_and_steps(t_end, steps);
    if (e != KM_ERR_NONE) { return Err(e); }
    var k: f64[1];
    store64(&k, rate_constant);
    var y0: f64[1];
    store64(&y0, initial_concentration);
    return _km_rd_rk4(&_km_rd_first_order_f, &k, &y0, 1, t_end, steps, out, cap);
}

# Second-order decay, d[A]/dt = −k[A]², from [A]₀ (mol/L) with k (L·mol⁻¹·s⁻¹), by RK4 in `steps` steps to t_end: the
# steps + 1 points (t, [A]), 2 f64 each, to `out` (cap points). Ok(steps + 1); the errors of simulate_first_order.
# Mirrors `reaction_dynamics::simulate_second_order`.
#must_use
fn simulate_second_order(initial_concentration: f64, rate_constant: f64, t_end: f64, steps, out, cap): Result {
    if (_km_is_non_negative(initial_concentration) != 1) { return Err(KM_ERR_INVALID_CONCENTRATION); }
    if (_km_is_non_negative(rate_constant) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    var e = _km_rd_time_and_steps(t_end, steps);
    if (e != KM_ERR_NONE) { return Err(e); }
    var k: f64[1];
    store64(&k, rate_constant);
    var y0: f64[1];
    store64(&y0, initial_concentration);
    return _km_rd_rk4(&_km_rd_second_order_f, &k, &y0, 1, t_end, steps, out, cap);
}

# Consecutive reactions A →(k₁) B →(k₂) C from ([A]₀, 0, 0) (mol/L) with first-order k₁, k₂ (s⁻¹), by RK4 in `steps`
# steps to t_end: the steps + 1 points (t, [A], [B], [C]), 4 f64 each, to `out` (cap points). Ok(steps + 1);
# Err(KM_ERR_INVALID_CONCENTRATION) if [A]₀ is negative or not finite; Err(KM_ERR_INVALID_INPUT) if k₁, then k₂, is
# negative or not finite, then for t_end and steps as simulate_first_order; Err(KM_ERR_COMPUTATION_ERROR) if the
# final state is not finite; Err(KM_ERR_INVALID_INPUT) if the points don't fit. Mirrors
# `reaction_dynamics::simulate_consecutive`.
#must_use
fn simulate_consecutive(initial_a: f64, k1: f64, k2: f64, t_end: f64, steps, out, cap): Result {
    if (_km_is_non_negative(initial_a) != 1) { return Err(KM_ERR_INVALID_CONCENTRATION); }
    if (_km_is_non_negative(k1) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    if (_km_is_non_negative(k2) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    var e = _km_rd_time_and_steps(t_end, steps);
    if (e != KM_ERR_NONE) { return Err(e); }
    var k: f64[2];
    store64(&k, k1);
    store64(&k + 8, k2);
    var y0: f64[3];
    var z: f64 = 0.0;
    store64(&y0, initial_a);
    store64(&y0 + 8, z);
    store64(&y0 + 16, z);
    return _km_rd_rk4(&_km_rd_consecutive_f, &k, &y0, 3, t_end, steps, out, cap);
}

# The reversible reaction A ⇌ B from ([A]₀, [B]₀) (mol/L) with first-order k_f, k_r (s⁻¹), by RK4 in `steps` steps to
# t_end: the steps + 1 points (t, [A], [B]), 3 f64 each, to `out` (cap points). Ok(steps + 1);
# Err(KM_ERR_INVALID_CONCENTRATION) if [A]₀ or [B]₀ is negative or not finite; Err(KM_ERR_INVALID_INPUT) if k_f, then
# k_r, is negative or not finite, then for t_end and steps as simulate_first_order; Err(KM_ERR_COMPUTATION_ERROR) if
# the final state is not finite; Err(KM_ERR_INVALID_INPUT) if the points don't fit. Mirrors
# `reaction_dynamics::simulate_reversible`.
#must_use
fn simulate_reversible(initial_a: f64, initial_b: f64, k_forward: f64, k_reverse: f64, t_end: f64, steps, out,
  cap): Result {
    if (_km_is_non_negative(initial_a) != 1 || _km_is_non_negative(initial_b) != 1) {
        return Err(KM_ERR_INVALID_CONCENTRATION);
    }
    if (_km_is_non_negative(k_forward) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    if (_km_is_non_negative(k_reverse) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    var e = _km_rd_time_and_steps(t_end, steps);
    if (e != KM_ERR_NONE) { return Err(e); }
    var k: f64[2];
    store64(&k, k_forward);
    store64(&k + 8, k_reverse);
    var y0: f64[2];
    store64(&y0, initial_a);
    store64(&y0 + 8, initial_b);
    return _km_rd_rk4(&_km_rd_reversible_f, &k, &y0, 2, t_end, steps, out, cap);
}

# Michaelis–Menten kinetics with substrate depletion, E + S ⇌ ES → E + P simplified to d[S]/dt = −Vmax·[S]/(Km + [S]),
# d[P]/dt = Vmax·[S]/(Km + [S]), from ([S]₀, 0) (mol/L) with Vmax (mol·L⁻¹·s⁻¹) and Km (mol/L), by RK4 in `steps` steps
# to t_end: the steps + 1 points (t, [S], [P]), 3 f64 each, to `out` (cap points). Ok(steps + 1);
# Err(KM_ERR_INVALID_CONCENTRATION) if [S]₀ is negative or not finite; Err(KM_ERR_INVALID_INPUT) if Vmax, then Km, is
# not positive and finite, then for t_end and steps as simulate_first_order; Err(KM_ERR_COMPUTATION_ERROR) if the
# final state is not finite; Err(KM_ERR_INVALID_INPUT) if the points don't fit. Mirrors
# `reaction_dynamics::simulate_michaelis_menten`.
#must_use
fn simulate_michaelis_menten(initial_substrate: f64, v_max: f64, km: f64, t_end: f64, steps, out, cap): Result {
    if (_km_is_non_negative(initial_substrate) != 1) { return Err(KM_ERR_INVALID_CONCENTRATION); }
    if (_km_is_positive(v_max) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    if (_km_is_positive(km) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    var e = _km_rd_time_and_steps(t_end, steps);
    if (e != KM_ERR_NONE) { return Err(e); }
    var k: f64[2];
    store64(&k, v_max);
    store64(&k + 8, km);
    var y0: f64[2];
    var z: f64 = 0.0;
    store64(&y0, initial_substrate);
    store64(&y0 + 8, z);
    return _km_rd_rk4(&_km_rd_michaelis_menten_f, &k, &y0, 2, t_end, steps, out, cap);
}

# A custom reaction system f(ctx, t, y, dy, n) from (0, y0[0 .. n)) to t_end by Dormand–Prince 4(5) with error
# tolerance `tol` (the per-component scale max(tol, tol·|y|)) and first step t_end/100: an explicit adaptive
# Runge–Kutta for non-stiff systems whose rates change quickly (a stiff one forces tiny steps until the solver gives
# up after 100 000; use simulate_stiff). Every accepted step (t, y), 1 + n f64 each, starting at (0, y0) and ending at
# t_end, goes to the caller's buffer `out` of `cap` points. Ok(points); Err(KM_ERR_INVALID_INPUT) if t_end, then tol,
# is not positive and finite, or y0 has a non-finite value; Err(KM_ERR_COMPUTATION_ERROR) if y0 is empty or the
# solver needs more than 100 000 steps; Err(KM_ERR_INVALID_INPUT) if the trajectory has more than cap points (found
# after the integration; its first cap points are then written). Mirrors `reaction_dynamics::simulate_adaptive`.
#must_use
fn simulate_adaptive(f, ctx, y0, n, t_end: f64, tol: f64, out, cap): Result {
    if (f == 0 || _km_rd_slice(y0, n) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    if (_km_is_positive(t_end) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    if (_km_is_positive(tol) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    if (_km_rd_all_finite(y0, n) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    var h_init: f64 = t_end / 100.0;
    var o = out;
    var c = cap;
    if (out == 0 || cap < 0) {
        o = 0;
        c = 0;
    }
    var r, v = _km_dopri45(f, ctx, 0.0, y0, n, t_end, tol, h_init, o, c);
    if (is_err_result(r) == 1) { return Err(KM_ERR_COMPUTATION_ERROR); }
    if (v > c) { return Err(KM_ERR_INVALID_INPUT); }
    return Ok(v);
}

# A stiff reaction system by backward Euler (implicit): f(fctx, t, y, dy, n) and its Jacobian jac(jctx, t, y, j, n)
# (the flat n × n buffer, zeroed once and reused, not re-zeroed), from (0, y0[0 .. n)) in `steps` equal steps of
# h = t_end/steps (1 ..= 10⁷; the last step's time is t_end, step k's h·k). Each step solves y₊ = y + h·f(t₊, y₊) by
# Newton iteration on (I − h·J)·δ = −(y₊ − y − h·f) (src/numerics.cyr's hisab 1.4.0 Gaussian elimination), from
# y₊ = y; it converges when ‖δ‖∞ ≤ 10⁻¹⁰·‖y₊‖∞ within 20 iterations, or is still accepted when the 20th leaves
# ‖δ‖∞ ≤ 10⁻⁶·‖y₊‖∞ (the round-off floor of very stiff systems). Suits systems with widely separated timescales.
# Exactly two points, (0, y0) and (t_end, y(t_end)), 1 + n f64 each, go to `out` (cap ≥ 2 points): Ok(2). For n = 0
# nothing is integrated. Err(KM_ERR_INVALID_INPUT) if t_end is not positive and finite, steps is 0 or above 10⁷, or
# y0 has a non-finite value; Err(KM_ERR_COMPUTATION_ERROR) if I − h·J is singular (a pivot below 10⁻¹²), an iterate is
# not finite, or Newton fails to converge in a step; Err(KM_ERR_INVALID_INPUT) if cap < 2 (after the integration; out
# untouched on every Err). Mirrors `reaction_dynamics::simulate_stiff`; Rust's Err for a resized Jacobian has no
# counterpart (the buffer is flat).
#must_use
fn simulate_stiff(f, fctx, jac, jctx, y0, n, t_end: f64, steps, out, cap): Result {
    if (f == 0 || jac == 0 || _km_rd_slice(y0, n) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    var e = _km_rd_time_and_steps(t_end, steps);
    if (e != KM_ERR_NONE) { return Err(e); }
    if (_km_rd_all_finite(y0, n) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    if (n > 0x01000000) { return Err(KM_ERR_COMPUTATION_ERROR); }
    var ns: f64 = f64_from(steps);
    var h: f64 = t_end / ns;
    var st: f64[168];
    var w = _km_num_table(&st, _KM_RD_STIFF_STACK, 2 * n * n + 5 * n);
    if (w == 0) { return Err(KM_ERR_COMPUTATION_ERROR); }
    var y = w;
    var yn = w + 8 * n;
    var fv = w + 16 * n;
    var delta = w + 24 * n;
    var jm = w + 32 * n;
    var aug = jm + 8 * n * n;
    var wa = n + 1;
    var rtol: f64 = 0.0000000001;           # STIFF_NEWTON_RTOL = 1e-10
    var atol: f64 = 0.000001;               # STIFF_ACCEPT_RTOL = 1e-6
    _km_num_copy(y, y0, n);
    _km_num_copy(yn, y0, n);
    if (n > 0) {
        var step = 1;
        while (step <= steps) {
            var t: f64 = t_end;
            if (step != steps) {
                var sf: f64 = f64_from(step);
                t = h * sf;
            }
            _km_num_copy(yn, y, n);
            var last: f64 = _KM_INF;
            var converged = 0;
            var it = 0;
            while (it < 20) {
                callptr(f, fctx, t, yn, fv, n);
                callptr(jac, jctx, t, yn, jm, n);
                # The augmented Newton system [I − h·J | −(y₊ − y − h·f)].
                var i = 0;
                while (i < n) {
                    var j = 0;
                    while (j < n) {
                        var id: f64 = 0.0;
                        if (i == j) { id = 1.0; }
                        var jij: f64 = load64(jm + 8 * (i * n + j));
                        var hj: f64 = h * jij;
                        var en: f64 = id - hj;
                        store64(aug + 8 * (i * wa + j), en);
                        j = j + 1;
                    }
                    var ynx: f64 = load64(yn + 8 * i);
                    var yx: f64 = load64(y + 8 * i);
                    var fx: f64 = load64(fv + 8 * i);
                    var dyx: f64 = ynx - yx;
                    var hf: f64 = h * fx;
                    var rr: f64 = dyx - hf;
                    var rhs: f64 = -rr;
                    store64(aug + 8 * (i * wa + n), rhs);
                    i = i + 1;
                }
                var gr, gv = _km_gaussian_elimination(aug, n, delta);
                if (is_err_result(gr) == 1) { return Err(KM_ERR_COMPUTATION_ERROR); }
                i = 0;
                while (i < n) {
                    var a: f64 = load64(yn + 8 * i);
                    var dl: f64 = load64(delta + 8 * i);
                    var s: f64 = a + dl;
                    store64(yn + 8 * i, s);
                    i = i + 1;
                }
                if (_km_rd_all_finite(yn, n) != 1) { return Err(KM_ERR_COMPUTATION_ERROR); }
                last = _km_rd_max_abs(delta, n);
                var ynorm: f64 = _km_rd_max_abs(yn, n);
                var lim: f64 = rtol * ynorm;
                if (last <= lim) {
                    converged = 1;
                    break;
                }
                it = it + 1;
            }
            if (converged == 0) {
                var ynorm2: f64 = _km_rd_max_abs(yn, n);
                var lim2: f64 = atol * ynorm2;
                if (last > lim2) { return Err(KM_ERR_COMPUTATION_ERROR); }
            }
            _km_num_copy(y, yn, n);
            step = step + 1;
        }
    }
    if (out == 0 || cap < 2) { return Err(KM_ERR_INVALID_INPUT); }
    var zero: f64 = 0.0;
    _km_num_point(out, 2, 0, zero, y0, n);
    _km_num_point(out, 2, 1, t_end, y, n);
    return Ok(2);
}

# A stochastic reaction system by Euler–Maruyama: dX = drift(t, X)·dt + diffusion(t, X)·dW, molecular noise as one
# independent Wiener increment per component; drift(dctx, t, y, dy, n) is the deterministic part (as an ODE's f),
# diffusion(gctx, t, y, g, n) the noise amplitude, from (0, y0[0 .. n)) in `steps` steps (1 ..= 10⁷) to t_end, the
# normal draws from hisab's PCG32 seeded with `seed` (stream 1, as Rust's `Pcg32::new(seed, 1)`), so a seed gives the
# same path every time. The steps + 1 points (t, y), 1 + n f64 each, go to `out` (cap points). Ok(steps + 1);
# Err(KM_ERR_INVALID_INPUT) if t_end is not positive and finite, steps is 0 or above 10⁷, or y0 has a non-finite value;
# Err(KM_ERR_COMPUTATION_ERROR) if the solver fails or the final state is not finite (or the generator can't be
# allocated); Err(KM_ERR_INVALID_INPUT) if the points don't fit (after integrating without storing, out untouched).
# Mirrors `reaction_dynamics::simulate_stochastic`.
#must_use
fn simulate_stochastic(drift, dctx, diffusion, gctx, y0, n, t_end: f64, steps, seed, out, cap): Result {
    if (drift == 0 || diffusion == 0 || _km_rd_slice(y0, n) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    var e = _km_rd_time_and_steps(t_end, steps);
    if (e != KM_ERR_NONE) { return Err(e); }
    if (_km_rd_all_finite(y0, n) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    var rng = pcg32_new(seed);
    if (rng == 0) { return Err(KM_ERR_COMPUTATION_ERROR); }
    var count = steps + 1;
    var o = out;
    var c = cap;
    if (out == 0 || cap < count) {
        o = 0;
        c = 0;
    }
    var st: f64[16];
    var fin = _km_num_table(&st, 16, n);
    if (fin == 0) { return Err(KM_ERR_COMPUTATION_ERROR); }
    var r, v = _km_euler_maruyama_system(drift, dctx, diffusion, gctx, 0.0, y0, n, t_end, steps, rng, o, c, fin);
    if (is_err_result(r) == 1) { return Err(KM_ERR_COMPUTATION_ERROR); }
    if (_km_rd_all_finite(fin, n) != 1) { return Err(KM_ERR_COMPUTATION_ERROR); }
    if (o == 0) { return Err(KM_ERR_INVALID_INPUT); }
    return Ok(count);
}
