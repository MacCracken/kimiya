# thermochem.cyr — thermochemical data and the functions over it: reaction enthalpy, Gibbs energy
# and entropy from the formation table, the van 't Hoff equation, Shomate heat capacities and
# enthalpies, and the adiabatic flame temperature (port of rust-old/src/thermochem.rs).
#
# The data — struct KmShomate, the 76 THERMOCHEM_DATA rows and the 34 SHOMATE_DATA segments — is
# src/thermochem_data.cyr (generated). Fallible functions return a value-form Result whose Err
# payload is a KM_ERR_* code. Every expression keeps Rust's operation order, so everything but
# vant_hoff_k is + − × ÷ and bit-identical (class B); vant_hoff_k's one exp is the correctly rounded
# _km_cr_exp (src/mathx.cyr, ADR 0006), so its class-C rows are compared exactly against the corrected
# oracle (docs/development/port-parity.md §10).
#
# - ADR 0002 #33 and #34 (the overflow audit's B4; the user's decisions of 2026-11-09 and 2026-11-10): the reaction sums
#   (#33) and the Shomate polynomials (#34) have sums inside, so they get ADR 0002 #20's semantics: Rust's operation
#   sequence, its summation order included, evaluated with an unbounded exponent (src/mathx.cyr's _km_ux_*), the final
#   operation rounded once into binary64, behind fast tests that prove Rust's chain stayed in the normal range (its bits
#   there: every physical input, every tabulated segment over its range). A product past DBL_MAX whose sums cancel, or a
#   Shomate term that over- or underflows, gave ±∞ or NaN although the value is finite or ±∞; here it is that value.
#   Rust's checks, Err codes and order are kept; a non-finite input keeps Rust's result.
# - ADR 0002 #38 (the overflow audit's B6; the user's decision "fix all three iterative edges", the flame's being its
#   bracket's exact sign test): adiabatic_flame_temperature's bracket test f(T₀)·f(T_max) < 0 is an exact sign
#   comparison, since the product underflows to −0 when |ΔH| and the moles are tiny (a real system scaled by 10⁻²⁰⁰:
#   Rust's Err, here Newton's answer, Rust's own at a scale where the product does not underflow), and the transcribed
#   bisection's f(a)·f(b) > 0 likewise (no result changes there).
#   Newton, its absolute 10⁻³ J/mol tolerance (which accepts the initial guess at once at such scales) and every Err
#   are Rust's.
#
# Units: reaction_enthalpy and reaction_gibbs_energy return **J/mol** (ADR 0002 #1: Rust 1.2 returns
# kJ/mol; here Rust's kJ difference is multiplied by 1000.0 once, so the value is the oracle's × 1000
# exactly); reaction_entropy returns J/(mol·K); enthalpy_change_cp returns J/mol; vant_hoff_k and
# adiabatic_flame_temperature take J/mol. The table fields stay as tabulated (ΔH_f°, ΔG_f° in kJ/mol).
#
# - Rows are reached by handle (port plan §6.4): THERMOCHEM_DATA and SHOMATE_DATA row + 1, 0 for
#   None. thermochem_data_<field>(h) reads a THERMOCHEM_DATA row ("" or NaN for an invalid handle);
#   shomate_data_formula(h) / shomate_data_coeffs(h) a segment (NaN fields for an invalid handle).
# - A species list `&[(&str, f64)]` is a pointer to n 16-byte records — a C-string pointer, then the
#   f64's bits — and the count n, as KmMolecule_new's pairs. A negative n, or a null pointer with
#   n > 0, is no list: Err(KM_ERR_INVALID_INPUT).
# - Rust's private Segments (one species' run of adjacent SHOMATE_DATA rows) is a (start row, count)
#   pair, and its lookup / cp / enthalpy_change are _km_segments_* helpers in Rust's operation order.
# - adiabatic_flame_temperature transcribes hisab 1.4.0's newton_raphson and bisection operation for
#   operation (ADR 0003, amendment M2b), specialised to the flame balance: _km_flame_newton and
#   _km_flame_bisection call _km_flame_f / _km_flame_df directly. The derivative threshold is hisab's
#   EPSILON_F64 (10⁻¹², the value of hisab 1.4.0's), which thermo.cyr's include of lib/hisab.cyr
#   supplies too.

include "lib/string.cyr"
include "lib/hisab.cyr"

# ── THERMOCHEM_DATA ─────────────────────────────────────────────────────────────────

# The THERMOCHEM_DATA row of handle h (h − 1), or -1 if h is no handle.
#must_use
fn _km_thermochem_row(h): i64 {
    if (h >= 1 && h <= KM_THERMOCHEM_COUNT) { return h - 1; }
    return 0 - 1;
}

# The standard thermochemical data of the substance whose formula is the C string `formula`,
# exactly and case-sensitively ("H2O(l)", "CO2(g)"), as a handle (its THERMOCHEM_DATA row + 1); 0 when
# none matches (or `formula` is 0). The first match in table order, as Rust's linear `find`. Mirrors
# `thermochem::lookup_thermochem`.
#must_use
fn lookup_thermochem(formula): i64 {
    if (formula == 0) { return 0; }
    var c0 = load8(formula);
    if (c0 == 0) { return 0; }
    var n = strlen(formula);
    var row = 0;
    while (row < KM_THERMOCHEM_COUNT) {
        var p = &_KM_THERMOCHEM_FORMULA_BYTES + _KM_THERMOCHEM_FORMULA_OFF[row];
        # The first byte decides most rows; memeq stops at p's NUL, which differs from formula's byte.
        if (load8(p) == c0) {
            if (memeq(p, formula, n) == 1 && load8(p + n) == 0) { return row + 1; }
        }
        row = row + 1;
    }
    return 0;
}

# The chemical formula of THERMOCHEM_DATA handle h ("H2O(l)") as a C string in the baked table; ""
# for an invalid handle. Mirrors `ThermochemData::formula`.
#must_use
fn thermochem_data_formula(h): i64 {
    var row = _km_thermochem_row(h);
    if (row < 0) { return ""; }
    return &_KM_THERMOCHEM_FORMULA_BYTES + _KM_THERMOCHEM_FORMULA_OFF[row];
}

# The common name of THERMOCHEM_DATA handle h ("Water (liquid)"); "" for an invalid handle. Mirrors
# `ThermochemData::name`.
#must_use
fn thermochem_data_name(h): i64 {
    var row = _km_thermochem_row(h);
    if (row < 0) { return ""; }
    return &_KM_THERMOCHEM_NAME_BYTES + _KM_THERMOCHEM_NAME_OFF[row];
}

# The standard enthalpy of formation ΔH_f° (kJ/mol, as tabulated) of handle h; NaN for an invalid
# handle. Mirrors `ThermochemData::delta_hf_kj`.
#must_use
fn thermochem_data_delta_hf_kj(h): f64 {
    var row = _km_thermochem_row(h);
    if (row < 0) { return _km_nan(); }
    var x: f64 = KM_THERMOCHEM_DELTA_HF_KJ[row];
    return x;
}

# The standard Gibbs energy of formation ΔG_f° (kJ/mol, as tabulated) of handle h; NaN for an
# invalid handle. Mirrors `ThermochemData::delta_gf_kj`.
#must_use
fn thermochem_data_delta_gf_kj(h): f64 {
    var row = _km_thermochem_row(h);
    if (row < 0) { return _km_nan(); }
    var x: f64 = KM_THERMOCHEM_DELTA_GF_KJ[row];
    return x;
}

# The standard molar entropy S° (J/(mol·K)) of handle h; NaN for an invalid handle. Mirrors
# `ThermochemData::s_standard_j`.
#must_use
fn thermochem_data_s_standard_j(h): f64 {
    var row = _km_thermochem_row(h);
    if (row < 0) { return _km_nan(); }
    var x: f64 = KM_THERMOCHEM_S_STANDARD_J[row];
    return x;
}

# ── reaction thermochemistry from the table ─────────────────────────────────────────

# Σ coefficient × property over the n (formula, coefficient) records at `species`, in list order,
# reading the property from the THERMOCHEM_DATA f64 column `col` (Rust's private sum_property): from
# +0.0 with `total += coeff * prop`, as Rust (not `.sum()`), and no coefficient guard (a NaN
# coefficient gives NaN, as Rust). (code, Σ, chain): KM_ERR_INVALID_REACTION for the first formula with no
# row, KM_ERR_INVALID_INPUT if (species, n) is no list. chain (ADR 0002 #33) is 1 when every product coeff·prop is the
# 53-bit rounding of its exact value — normal (_km_ux_normal: at least 2⁻¹⁰²¹ and finite) or an exact zero (a zero
# factor) —, 2 when a coefficient is not finite (Rust's value stands), 0 otherwise.
#must_use
fn _km_sum_property(species, n, col): (i64, f64, i64) {
    if (n < 0 || (n > 0 && species == 0)) { return (KM_ERR_INVALID_INPUT, 0.0, 0); }
    var total: f64 = 0.0;
    var chain = 1;
    var k = 0;
    while (k < n) {
        var h = lookup_thermochem(load64(species + k * 16));
        if (h == 0) { return (KM_ERR_INVALID_REACTION, 0.0, 0); }
        var coeff: f64 = load64(species + k * 16 + 8);
        var prop: f64 = load64(col + (h - 1) * 8);
        var p: f64 = coeff * prop;
        total = total + p;
        var pb = load64(&p) & 0x7FFFFFFFFFFFFFFF;          # _km_ux_normal's test, inline
        if (chain == 1 && (pb < 0x0020000000000000 || pb > 0x7FEFFFFFFFFFFFFF) && coeff != 0.0 && prop != 0.0) {
            chain = 0;
        }
        if ((load64(&coeff) & 0x7FF0000000000000) == 0x7FF0000000000000) { chain = 2; }
        k = k + 1;
    }
    return (KM_ERR_NONE, total, chain);
}

# _km_sum_property's Σ with an unbounded exponent (ADR 0002 #33): from +0.0, every product and addition rounded to 53
# bits (src/mathx.cyr's _km_ux_*), for a valid list whose formulas all have rows and whose coefficients are finite.
#must_use
fn _km_sum_property_ux(species, n, col): (f64, i64) {
    var z: f64 = 0.0;
    var ts, te = _km_ux_from(z);
    var k = 0;
    while (k < n) {
        var h = lookup_thermochem(load64(species + k * 16));
        var coeff: f64 = load64(species + k * 16 + 8);
        var prop: f64 = load64(col + (h - 1) * 8);
        var cs, ce = _km_ux_from(coeff);
        var qs, qe = _km_ux_from(prop);
        var ps, pe = _km_ux_mul(cs, ce, qs, qe);
        var ns, ne = _km_ux_add(ts, te, ps, pe);
        ts = ns;
        te = ne;
        k = k + 1;
    }
    return (ts, te);
}

# Σ over the products minus Σ over the reactants of the column `col`: (code, difference, fast). fast (ADR 0002 #33) is 1
# when Rust's chain is provably the unbounded-exponent one: every product the 53-bit rounding of its exact value
# (_km_sum_property's chain = 1) and both sums finite, so each partial sum is the unbounded one too (src/thermo.cyr's
# comment on #33's sums) and the difference of the two is rounded once in both; 2 when a coefficient is not finite
# (Rust's value stands); 0 otherwise (the caller's slow path on _km_sum_property_ux).
#must_use
fn _km_reaction_property(products, np, reactants, nr, col): (i64, f64, i64) {
    var ep, sum_products, cp = _km_sum_property(products, np, col);
    if (ep != KM_ERR_NONE) { return (ep, 0.0, 0); }
    var er, sum_reactants, cr = _km_sum_property(reactants, nr, col);
    if (er != KM_ERR_NONE) { return (er, 0.0, 0); }
    var d: f64 = sum_products - sum_reactants;
    if (cp == 2 || cr == 2) { return (KM_ERR_NONE, d, 2); }
    var dp: f64 = sum_products - sum_products;
    var dr: f64 = sum_reactants - sum_reactants;
    var fast = 0;
    if (cp == 1 && cr == 1 && dp == 0.0 && dr == 0.0) { fast = 1; }
    return (KM_ERR_NONE, d, fast);
}

# reaction_enthalpy's and reaction_gibbs_energy's J/mol value: Rust's kJ difference × 1000.0 (ADR 0002 #1), under ADR
# 0002 #33. Rust's chain where it is provably the unbounded one (fast, and the difference finite: the product with 1000
# is then rounded once in both), and Rust's value for a non-finite coefficient; otherwise the sums and their difference
# with an unbounded exponent (_km_sum_property_ux) and the product with 1000 rounded once into binary64 (two sums past
# DBL_MAX that cancel are their difference's value, not ∞ − ∞ = NaN).
#must_use
fn _km_reaction_j(products, np, reactants, nr, col): Result {
    var e, d, fast = _km_reaction_property(products, np, reactants, nr, col);
    if (e != KM_ERR_NONE) { return Err(e); }
    var kj: f64 = d;
    var j: f64 = kj * 1000.0;
    var dd: f64 = kj - kj;
    if (fast == 2 || (fast == 1 && dd == 0.0)) { return Ok(j); }
    var u: f64 = _km_reaction_j_ux(products, np, reactants, nr, col);
    return Ok(u);
}

# _km_reaction_j's slow path (ADR 0002 #33), for valid lists with known formulas and finite coefficients: the two sums
# (_km_sum_property_ux) and their difference rounded to 53 bits, the product with 1000 rounded once into binary64.
#must_use
fn _km_reaction_j_ux(products, np, reactants, nr, col): f64 {
    var ps, pe = _km_sum_property_ux(products, np, col);
    var rs, re = _km_sum_property_ux(reactants, nr, col);
    var ds, de = _km_ux_sub(ps, pe, rs, re);
    var k: f64 = 1000.0;
    var ks, ke = _km_ux_from(k);
    var u: f64 = _km_ux_mul_f64(ds, de, ks, ke);
    return u;
}

# reaction_entropy's slow path (ADR 0002 #33), as _km_reaction_j_ux: the two sums, their difference rounded once.
#must_use
fn _km_reaction_s_ux(products, np, reactants, nr): f64 {
    var ps, pe = _km_sum_property_ux(products, np, &KM_THERMOCHEM_S_STANDARD_J);
    var rs, re = _km_sum_property_ux(reactants, nr, &KM_THERMOCHEM_S_STANDARD_J);
    var u: f64 = _km_ux_sub_f64(ps, pe, rs, re);
    return u;
}

# The standard reaction enthalpy at 298.15 K from formation enthalpies, ΔH°_rxn = Σ n_i·ΔH_f°(products) − Σ
# n_j·ΔH_f°(reactants), in **J/mol** (per mole of reaction as written), from np product and nr reactant (formula,
# coefficient) records. Ok(ΔH); Err(KM_ERR_INVALID_REACTION) if a formula has no THERMOCHEM_DATA row (the products are
# read first); Err(KM_ERR_INVALID_INPUT) if either list is no list. Mirrors `thermochem::reaction_enthalpy` with ADR
# 0002 #1: Rust returns the kJ/mol difference; this returns it × 1000.0, the one multiply after Rust's subtraction (so
# vant_hoff_k and adiabatic_flame_temperature take it as it is). ADR 0002 #33: Rust's sequence (with that multiply)
# where its chain stays in the normal range, otherwise with an unbounded exponent and the product with 1000 rounded once
# (_km_reaction_j).
#must_use
fn reaction_enthalpy(products, np, reactants, nr): Result {
    var t, v = _km_reaction_j(products, np, reactants, nr, &KM_THERMOCHEM_DELTA_HF_KJ);
    if (is_ok(t) == 1) { return Ok(v); }
    return Err(v);
}

# The standard reaction Gibbs energy at 298.15 K,
# ΔG°_rxn = Σ n_i·ΔG_f°(products) − Σ n_j·ΔG_f°(reactants), in **J/mol**; arguments and errors as
# reaction_enthalpy. Mirrors `thermochem::reaction_gibbs_energy` with ADR 0002 #1 (Rust's kJ/mol
# difference × 1000.0) and #33 (as reaction_enthalpy).
#must_use
fn reaction_gibbs_energy(products, np, reactants, nr): Result {
    var t, v = _km_reaction_j(products, np, reactants, nr, &KM_THERMOCHEM_DELTA_GF_KJ);
    if (is_ok(t) == 1) { return Ok(v); }
    return Err(v);
}

# The standard reaction entropy change at 298.15 K,
# ΔS°_rxn = Σ n_i·S°(products) − Σ n_j·S°(reactants), in J/(mol·K) (unchanged from Rust; with the
# J/mol reaction_enthalpy, ΔG = ΔH − TΔS needs no unit factor); arguments and errors as
# reaction_enthalpy. ADR 0002 #33: Rust's difference where its chain stays in the normal range, otherwise the sums with
# an unbounded exponent and the difference rounded once. Mirrors `thermochem::reaction_entropy`, with ADR 0002 #33.
#must_use
fn reaction_entropy(products, np, reactants, nr): Result {
    var e, d, fast = _km_reaction_property(products, np, reactants, nr, &KM_THERMOCHEM_S_STANDARD_J);
    if (e != KM_ERR_NONE) { return Err(e); }
    var ds: f64 = d;
    if (fast != 0) { return Ok(ds); }
    var u: f64 = _km_reaction_s_ux(products, np, reactants, nr);
    return Ok(u);
}

# ── van 't Hoff equation ────────────────────────────────────────────────────────────

# The van 't Hoff equation ln(K₂/K₁) = −(ΔH°/R)(1/T₂ − 1/T₁): the equilibrium constant at t_new_k
# (K), dimensionless, from K₁ = k_ref at t_ref_k (K) and ΔH° in J/mol (reaction_enthalpy's unit),
# assumed constant over the range. It may overflow to Ok(+∞) for extreme ΔH°, as Rust. Ok(K₂),
# Err(KM_ERR_INVALID_TEMPERATURE) if a temperature is not positive and finite, or
# Err(KM_ERR_INVALID_INPUT) if k_ref is not positive and finite or ΔH° is not finite. Mirrors
# `thermochem::vant_hoff_k`.
#must_use
fn vant_hoff_k(k_ref: f64, delta_h_j: f64, t_ref_k: f64, t_new_k: f64): Result {
    if (_km_is_positive(t_ref_k) != 1 || _km_is_positive(t_new_k) != 1) {
        return Err(KM_ERR_INVALID_TEMPERATURE);
    }
    if (_km_is_positive(k_ref) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    if (_km_is_finite(delta_h_j) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    var h: f64 = delta_h_j / KM_GAS_CONSTANT;
    var exponent: f64 = -h * ((1.0 / t_new_k) - (1.0 / t_ref_k));
    var e: f64 = _km_cr_exp(exponent);
    var k: f64 = k_ref * e;
    return Ok(k);
}

# ── Shomate heat capacities ─────────────────────────────────────────────────────────

# ADR 0002 #34 (the overflow audit's B4): the Shomate polynomials under ADR 0002 #20's semantics. Rust's operation
# sequence (below) evaluated with an unbounded exponent (src/mathx.cyr's _km_ux_*), the final operation rounded once
# into binary64, wherever Rust's chain may have left the normal range; elsewhere Rust's chain itself, whose bits are
# then the unbounded one's. For user coefficients and any T: as T → 0, t·t underflows and E/(t·t) is ±∞ (or 0/0 = NaN
# for E = 0) where Cp is finite; for large T, C·t², D·t³ and t⁴ overflow and their difference is ∞ − ∞ = NaN where the
# value is ±∞. A chain agrees with the unbounded one when every product and quotient is the 53-bit rounding of its exact
# value (normal, _km_ux_normal, or an exact zero: a zero factor or dividend) and every sum is finite (a sum of doubles
# is exact below 2⁻¹⁰²¹: src/thermo.cyr's comment on #33's sums); its final operation is then rounded once in both. T =
# ±0 makes every product an exact zero and E/0 IEEE's special in both evaluations: Rust's value. A non-finite
# coefficient or T keeps Rust's chain. The box: T and every nonzero coefficient within [2⁻³⁰, 2³⁰] and [2⁻²⁰⁰, 2²⁰⁰] in
# magnitude (every tabulated segment over its range, every physical use) proves the test without running it
# (_km_shomate_box, which the evaluation tests first; the table-row path, whose coefficients are all in the box, tests
# T alone, inline: _km_shomate_row_cp).

# 1 if |T| is in [2⁻³⁰, 2³⁰] and each of a … e is 0 or in [2⁻²⁰⁰, 2²⁰⁰] in magnitude. Then t = T/1000 is in [2⁻⁴⁰, 2²¹]
# and every product and quotient of either polynomial is normal or an exact zero: in Cp, B·t, C·t·t, D·t·t·t, t·t and
# E/(t·t) are in [2⁻³²⁰, 2²⁸¹]; in the antiderivative D/4, C/3, B/2 are in [2⁻²⁰², 2¹⁹⁹], and each nested sum is 0 or at
# least an ulp of its smaller term (a multiple of it), so t·(D/4) ≥ 2⁻²⁴², C/3 + t·D/4 is 0 or ≥ 2⁻²⁹⁴, its product with
# t ≥ 2⁻³³⁴, B/2 + … 0 or ≥ 2⁻³⁸⁶, × t ≥ 2⁻⁴²⁶, A + … 0 or ≥ 2⁻⁴⁷⁸, × t ≥ 2⁻⁵¹⁸, E/t ≥ 2⁻²²¹, every value below 2²⁹⁷
# (the bounds include each step's rounding, a factor 1 ± 2⁻⁵³), and every sum finite.
#must_use
fn _km_shomate_box(a: f64, b: f64, c: f64, d: f64, e: f64, temperature_k: f64): i64 {
    var lo = 0x3370000000000000;            # 2⁻²⁰⁰
    var hi = 0x4C70000000000000;            # 2²⁰⁰
    var bt = load64(&temperature_k) & 0x7FFFFFFFFFFFFFFF;
    if (bt < 0x3E10000000000000 || bt > 0x41D0000000000000) { return 0; }     # 2⁻³⁰, 2³⁰
    var ba = load64(&a) & 0x7FFFFFFFFFFFFFFF;
    var bb = load64(&b) & 0x7FFFFFFFFFFFFFFF;
    var bc = load64(&c) & 0x7FFFFFFFFFFFFFFF;
    var bd = load64(&d) & 0x7FFFFFFFFFFFFFFF;
    var be = load64(&e) & 0x7FFFFFFFFFFFFFFF;
    if (ba != 0 && (ba < lo || ba > hi)) { return 0; }
    if (bb != 0 && (bb < lo || bb > hi)) { return 0; }
    if (bc != 0 && (bc < lo || bc > hi)) { return 0; }
    if (bd != 0 && (bd < lo || bd > hi)) { return 0; }
    if (be != 0 && (be < lo || be > hi)) { return 0; }
    return 1;
}

# 1 if the IEEE product x·y = p of two agreeing operands is the 53-bit rounding of the exact one: normal, or an exact
# zero from a zero factor.
#must_use
fn _km_mul_agrees(p: f64, x: f64, y: f64): i64 {
    if (_km_ux_normal(p) == 1 || x == 0.0 || y == 0.0) { return 1; }
    return 0;
}

# 1 if each of the six values is finite.
#must_use
fn _km_finite6(a: f64, b: f64, c: f64, d: f64, e: f64, f: f64): i64 {
    var n = _km_is_finite(a) + _km_is_finite(b) + _km_is_finite(c);
    n = n + _km_is_finite(d) + _km_is_finite(e) + _km_is_finite(f);
    if (n == 6) { return 1; }
    return 0;
}

# Cp = A + B·t + C·t² + D·t³ + E/t² in J/(mol·K), t = T/1000, in Rust's order: the one evaluation behind KmShomate.cp
# and the table-row path. ADR 0002 #34 (the comment above): Rust's chain where it provably agrees with the unbounded one
# (_km_shomate_cp_fast), otherwise the unbounded-exponent sequence with the final addition rounded once
# (_km_shomate_cp_ux).
#must_use
fn _km_shomate_cp5(a: f64, b: f64, c: f64, d: f64, e: f64, temperature_k: f64): f64 {
    var t: f64 = temperature_k / 1000.0;
    var r: f64 = (((a + (b * t)) + ((c * t) * t)) + (((d * t) * t) * t)) + (e / (t * t));
    if (_km_shomate_box(a, b, c, d, e, temperature_k) == 1) { return r; }
    var f, ok = _km_shomate_cp_fast(a, b, c, d, e, temperature_k);
    if (ok == 1) { return f; }
    var u: f64 = _km_shomate_cp_ux(a, b, c, d, e, temperature_k);
    return u;
}

# Cp's fast path: (Rust's (((A + B·t) + (C·t)·t) + ((D·t)·t)·t) + E/(t·t), 1) inside the box, for T = ±0 or a
# non-finite input (Rust's value stands), or where each product and quotient is the 53-bit rounding of its exact value
# and the sums are finite; otherwise (0, 0).
#must_use
fn _km_shomate_cp_fast(a: f64, b: f64, c: f64, d: f64, e: f64, temperature_k: f64): (f64, i64) {
    var t: f64 = temperature_k / 1000.0;
    var p1: f64 = b * t;
    var s1: f64 = a + p1;
    var p2: f64 = c * t;
    var p3: f64 = p2 * t;
    var s2: f64 = s1 + p3;
    var p4: f64 = d * t;
    var p5: f64 = p4 * t;
    var p6: f64 = p5 * t;
    var s3: f64 = s2 + p6;
    var q1: f64 = t * t;
    var q2: f64 = e / q1;
    var r: f64 = s3 + q2;
    if (_km_shomate_box(a, b, c, d, e, temperature_k) == 1) { return (r, 1); }
    if (temperature_k == 0.0 || _km_finite6(a, b, c, d, e, temperature_k) != 1) { return (r, 1); }
    if (_km_ux_normal(t) == 1 && _km_mul_agrees(p1, b, t) == 1 && _km_mul_agrees(p2, c, t) == 1) {
        if (_km_mul_agrees(p3, p2, t) == 1 && _km_mul_agrees(p4, d, t) == 1 && _km_mul_agrees(p5, p4, t) == 1) {
            if (_km_mul_agrees(p6, p5, t) == 1 && _km_ux_normal(q1) == 1) {
                var ds3: f64 = s3 - s3;
                if (ds3 == 0.0 && (_km_ux_normal(q2) == 1 || e == 0.0)) { return (r, 1); }
            }
        }
    }
    return (0.0, 0);
}

# Cp with an unbounded exponent (ADR 0002 #34), for finite coefficients and a finite T ≠ 0: Rust's
# (((A + B·t) + (C·t)·t) + ((D·t)·t)·t) + E/(t·t), t = T/1000, every operation rounded to 53 bits (_km_ux_*), the last
# addition rounded once into binary64 (_km_ux_add_f64).
#must_use
fn _km_shomate_cp_ux(a: f64, b: f64, c: f64, d: f64, e: f64, temperature_k: f64): f64 {
    var k: f64 = 1000.0;
    var ks, ke = _km_ux_from(k);
    var xs, xe = _km_ux_from(temperature_k);
    var ts, te = _km_ux_div(xs, xe, ks, ke);
    var as1, ae = _km_ux_from(a);
    var bs, be = _km_ux_from(b);
    var cs, ce = _km_ux_from(c);
    var ds, de = _km_ux_from(d);
    var es, ee = _km_ux_from(e);
    var p1s, p1e = _km_ux_mul(bs, be, ts, te);
    var s1s, s1e = _km_ux_add(as1, ae, p1s, p1e);
    var p2s, p2e = _km_ux_mul(cs, ce, ts, te);
    var p3s, p3e = _km_ux_mul(p2s, p2e, ts, te);
    var s2s, s2e = _km_ux_add(s1s, s1e, p3s, p3e);
    var p4s, p4e = _km_ux_mul(ds, de, ts, te);
    var p5s, p5e = _km_ux_mul(p4s, p4e, ts, te);
    var p6s, p6e = _km_ux_mul(p5s, p5e, ts, te);
    var s3s, s3e = _km_ux_add(s2s, s2e, p6s, p6e);
    var q1s, q1e = _km_ux_mul(ts, te, ts, te);
    var q2s, q2e = _km_ux_div(es, ee, q1s, q1e);
    var r: f64 = _km_ux_add_f64(s3s, s3e, q2s, q2e);
    return r;
}

# ∫Cp dT = 1000·(A·t + B·t²/2 + C·t³/3 + D·t⁴/4 − E/t) in J/mol, t = T/1000, in Rust's nested
# order: the one evaluation behind KmShomate.enthalpy_antiderivative and the table-row path. ADR 0002 #34 (the comment
# above): Rust's chain where it provably agrees with the unbounded one (_km_shomate_h_fast), otherwise the
# unbounded-exponent sequence with the final product by 1000 rounded once (_km_shomate_h_ux).
#must_use
fn _km_shomate_h5(a: f64, b: f64, c: f64, d: f64, e: f64, temperature_k: f64): f64 {
    var t: f64 = temperature_k / 1000.0;
    var inner: f64 = t * (a + (t * ((b / 2.0) + (t * ((c / 3.0) + (t * (d / 4.0)))))));
    var r: f64 = 1000.0 * (inner - (e / t));
    if (_km_shomate_box(a, b, c, d, e, temperature_k) == 1) { return r; }
    var f, ok = _km_shomate_h_fast(a, b, c, d, e, temperature_k);
    if (ok == 1) { return f; }
    var u: f64 = _km_shomate_h_ux(a, b, c, d, e, temperature_k);
    return u;
}

# The antiderivative's fast path: (Rust's 1000·(t·(A + t·(B/2 + t·(C/3 + t·(D/4)))) − E/t), 1) inside the box, for
# T = ±0 or a non-finite input (Rust's value stands), or where each product and quotient is the 53-bit rounding of its
# exact value and the sums are finite; otherwise (0, 0).
#must_use
fn _km_shomate_h_fast(a: f64, b: f64, c: f64, d: f64, e: f64, temperature_k: f64): (f64, i64) {
    var t: f64 = temperature_k / 1000.0;
    var h1: f64 = d / 4.0;
    var h2: f64 = t * h1;
    var h3: f64 = c / 3.0;
    var h4: f64 = h3 + h2;
    var h5: f64 = t * h4;
    var h6: f64 = b / 2.0;
    var h7: f64 = h6 + h5;
    var h8: f64 = t * h7;
    var h9: f64 = a + h8;
    var inner: f64 = t * h9;
    var q: f64 = e / t;
    var diff: f64 = inner - q;
    var r: f64 = 1000.0 * diff;
    if (_km_shomate_box(a, b, c, d, e, temperature_k) == 1) { return (r, 1); }
    if (temperature_k == 0.0 || _km_finite6(a, b, c, d, e, temperature_k) != 1) { return (r, 1); }
    if (_km_ux_normal(t) == 1 && (_km_ux_normal(h1) == 1 || d == 0.0) && _km_mul_agrees(h2, t, h1) == 1) {
        if ((_km_ux_normal(h3) == 1 || c == 0.0) && (_km_ux_normal(h6) == 1 || b == 0.0)) {
            var dh4: f64 = h4 - h4;
            var dh7: f64 = h7 - h7;
            var dh9: f64 = h9 - h9;
            if (dh4 == 0.0 && dh7 == 0.0 && dh9 == 0.0 && _km_mul_agrees(h5, t, h4) == 1) {
                if (_km_mul_agrees(h8, t, h7) == 1 && _km_mul_agrees(inner, t, h9) == 1) {
                    var dd: f64 = diff - diff;
                    if (dd == 0.0 && (_km_ux_normal(q) == 1 || e == 0.0)) { return (r, 1); }
                }
            }
        }
    }
    return (0.0, 0);
}

# The antiderivative with an unbounded exponent (ADR 0002 #34), for finite coefficients and a finite T ≠ 0: Rust's
# 1000·(t·(A + t·(B/2 + t·(C/3 + t·(D/4)))) − E/t), t = T/1000, every operation rounded to 53 bits (_km_ux_*), the
# product by 1000 rounded once into binary64 (_km_ux_mul_f64).
#must_use
fn _km_shomate_h_ux(a: f64, b: f64, c: f64, d: f64, e: f64, temperature_k: f64): f64 {
    var k: f64 = 1000.0;
    var ks, ke = _km_ux_from(k);
    var xs, xe = _km_ux_from(temperature_k);
    var ts, te = _km_ux_div(xs, xe, ks, ke);
    var two: f64 = 2.0;
    var three: f64 = 3.0;
    var four: f64 = 4.0;
    var w2s, w2e = _km_ux_from(two);
    var w3s, w3e = _km_ux_from(three);
    var w4s, w4e = _km_ux_from(four);
    var as1, ae = _km_ux_from(a);
    var bs, be = _km_ux_from(b);
    var cs, ce = _km_ux_from(c);
    var ds, de = _km_ux_from(d);
    var es, ee = _km_ux_from(e);
    var h1s, h1e = _km_ux_div(ds, de, w4s, w4e);
    var h2s, h2e = _km_ux_mul(ts, te, h1s, h1e);
    var h3s, h3e = _km_ux_div(cs, ce, w3s, w3e);
    var h4s, h4e = _km_ux_add(h3s, h3e, h2s, h2e);
    var h5s, h5e = _km_ux_mul(ts, te, h4s, h4e);
    var h6s, h6e = _km_ux_div(bs, be, w2s, w2e);
    var h7s, h7e = _km_ux_add(h6s, h6e, h5s, h5e);
    var h8s, h8e = _km_ux_mul(ts, te, h7s, h7e);
    var h9s, h9e = _km_ux_add(as1, ae, h8s, h8e);
    var is1, ie = _km_ux_mul(ts, te, h9s, h9e);
    var qs, qe = _km_ux_div(es, ee, ts, te);
    var fs, fe = _km_ux_sub(is1, ie, qs, qe);
    var r: f64 = _km_ux_mul_f64(ks, ke, fs, fe);
    return r;
}

impl KmShomate {
    # Cp at temperature_k (K) in J/(mol·K). The range t_min ..= t_max is not checked: outside it the
    # polynomial is an extrapolation (lookup_shomate_at picks the right segment). Mirrors
    # `Shomate::cp`.
    #must_use
    fn cp(self, temperature_k: f64): f64 {
        var r: f64 = _km_shomate_cp5(self.a, self.b, self.c, self.d, self.e, temperature_k);
        return r;
    }

    # The antiderivative of cp with respect to T, in J/mol, without NIST's integration constant:
    # only differences within one segment are meaningful (enthalpy_change_cp spans segments).
    # Mirrors `Shomate::enthalpy_antiderivative`.
    #must_use
    fn enthalpy_antiderivative(self, temperature_k: f64): f64 {
        var r: f64 = _km_shomate_h5(self.a, self.b, self.c, self.d, self.e, temperature_k);
        return r;
    }
}

# Cp of SHOMATE_DATA row `row` at temperature_k (the row's KmShomate.cp, read from the columns). Every row's
# coefficients are 0 or in [2⁻²⁰⁰, 2²⁰⁰] (validate.py checks the generated table, tests/thermochem.tcyr every row), so
# _km_shomate_box reduces to its test on T, inline here: Rust's chain wherever |T| is in [2⁻³⁰, 2³⁰] (every temperature
# enthalpy_change_cp evaluates, every Newton iterate of the flame on the corpus), _km_shomate_cp5 elsewhere (ADR 0002
# #34).
#must_use
fn _km_shomate_row_cp(row, temperature_k: f64): f64 {
    var a: f64 = KM_SHOMATE_A[row];
    var b: f64 = KM_SHOMATE_B[row];
    var c: f64 = KM_SHOMATE_C[row];
    var d: f64 = KM_SHOMATE_D[row];
    var e: f64 = KM_SHOMATE_E[row];
    var bt = load64(&temperature_k) & 0x7FFFFFFFFFFFFFFF;
    if (bt >= 0x3E10000000000000 && bt <= 0x41D0000000000000) {     # the box's T: the table's coefficients are in it
        var t: f64 = temperature_k / 1000.0;
        var r: f64 = (((a + (b * t)) + ((c * t) * t)) + (((d * t) * t) * t)) + (e / (t * t));
        return r;
    }
    var u: f64 = _km_shomate_cp5(a, b, c, d, e, temperature_k);
    return u;
}

# The antiderivative of SHOMATE_DATA row `row` at temperature_k (its enthalpy_antiderivative), with _km_shomate_row_cp's
# inline box test.
#must_use
fn _km_shomate_row_h(row, temperature_k: f64): f64 {
    var a: f64 = KM_SHOMATE_A[row];
    var b: f64 = KM_SHOMATE_B[row];
    var c: f64 = KM_SHOMATE_C[row];
    var d: f64 = KM_SHOMATE_D[row];
    var e: f64 = KM_SHOMATE_E[row];
    var bt = load64(&temperature_k) & 0x7FFFFFFFFFFFFFFF;
    if (bt >= 0x3E10000000000000 && bt <= 0x41D0000000000000) {     # the box's T: the table's coefficients are in it
        var t: f64 = temperature_k / 1000.0;
        var inner: f64 = t * (a + (t * ((b / 2.0) + (t * ((c / 3.0) + (t * (d / 4.0)))))));
        var r: f64 = 1000.0 * (inner - (e / t));
        return r;
    }
    var u: f64 = _km_shomate_h5(a, b, c, d, e, temperature_k);
    return u;
}

# 1 if SHOMATE_DATA row `row`'s formula is the C string `formula` of length n, whose first byte is c0.
#must_use
fn _km_shomate_formula_is(row, formula, c0, n): i64 {
    var p = &_KM_SHOMATE_FORMULA_BYTES + _KM_SHOMATE_FORMULA_OFF[row];
    if (load8(p) != c0) { return 0; }
    if (memeq(p, formula, n) == 1 && load8(p + n) == 0) { return 1; }
    return 0;
}

# The SHOMATE_DATA row of handle h (h − 1), or -1 if h is no handle.
#must_use
fn _km_shomate_row(h): i64 {
    if (h >= 1 && h <= KM_SHOMATE_COUNT) { return h - 1; }
    return 0 - 1;
}

# The Shomate coefficients of the species whose formula is the C string `formula` (exact,
# case-sensitive), as a handle (its SHOMATE_DATA row + 1): the first, lowest-temperature segment; 0
# when there is none (or `formula` is 0). For a species with several segments use lookup_shomate_at.
# Mirrors `thermochem::lookup_shomate`.
#must_use
fn lookup_shomate(formula): i64 {
    if (formula == 0) { return 0; }
    var c0 = load8(formula);
    if (c0 == 0) { return 0; }
    var n = strlen(formula);
    var row = 0;
    while (row < KM_SHOMATE_COUNT) {
        if (_km_shomate_formula_is(row, formula, c0, n) == 1) { return row + 1; }
        row = row + 1;
    }
    return 0;
}

# The Shomate segment of `formula` whose range covers temperature_k, t_min ≤ T ≤ t_max, as a handle;
# at a boundary two segments share, the lower-temperature one (the first in table order). 0 if the
# formula is unknown or no segment covers T (NaN included). Mirrors `thermochem::lookup_shomate_at`.
#must_use
fn lookup_shomate_at(formula, temperature_k: f64): i64 {
    if (formula == 0) { return 0; }
    var c0 = load8(formula);
    if (c0 == 0) { return 0; }
    var n = strlen(formula);
    var row = 0;
    while (row < KM_SHOMATE_COUNT) {
        if (_km_shomate_formula_is(row, formula, c0, n) == 1) {
            var lo: f64 = KM_SHOMATE_T_MIN[row];
            var hi: f64 = KM_SHOMATE_T_MAX[row];
            if (temperature_k >= lo && temperature_k <= hi) { return row + 1; }
        }
        row = row + 1;
    }
    return 0;
}

# The formula of SHOMATE_DATA handle h ("H2O(g)") as a C string in the baked table; "" for an invalid
# handle. With shomate_data_coeffs and KM_SHOMATE_COUNT, this mirrors iterating
# `thermochem::SHOMATE_DATA`.
#must_use
fn shomate_data_formula(h): i64 {
    var row = _km_shomate_row(h);
    if (row < 0) { return ""; }
    return &_KM_SHOMATE_FORMULA_BYTES + _KM_SHOMATE_FORMULA_OFF[row];
}

# The coefficients of SHOMATE_DATA handle h, by value; every field NaN for an invalid handle. Mirrors
# `thermochem::SHOMATE_DATA[h − 1].1` (and the `&Shomate` lookup_shomate / lookup_shomate_at return).
#must_use
fn shomate_data_coeffs(h): KmShomate {
    var s: KmShomate;
    var row = _km_shomate_row(h);
    if (row < 0) {
        var x: f64 = _km_nan();
        s.a = x;
        s.b = x;
        s.c = x;
        s.d = x;
        s.e = x;
        s.t_min = x;
        s.t_max = x;
        return s;
    }
    s.a = KM_SHOMATE_A[row];
    s.b = KM_SHOMATE_B[row];
    s.c = KM_SHOMATE_C[row];
    s.d = KM_SHOMATE_D[row];
    s.e = KM_SHOMATE_E[row];
    s.t_min = KM_SHOMATE_T_MIN[row];
    s.t_max = KM_SHOMATE_T_MAX[row];
    return s;
}

# ── one species' segments (Rust's private Segments) ─────────────────────────────────

# The run of SHOMATE_DATA rows of `formula` (adjacent in the table): (first row, count), or (-1, 0)
# if it has none. Its covered range is KM_SHOMATE_T_MIN[first] ..= KM_SHOMATE_T_MAX[first + count − 1].
# Rust's Segments::lookup.
#must_use
fn _km_segments_lookup(formula): (i64, i64) {
    if (formula == 0) { return (0 - 1, 0); }
    var c0 = load8(formula);
    if (c0 == 0) { return (0 - 1, 0); }
    var n = strlen(formula);
    var start = 0;
    while (start < KM_SHOMATE_COUNT) {
        if (_km_shomate_formula_is(start, formula, c0, n) == 1) {
            var count = 1;
            while (start + count < KM_SHOMATE_COUNT && _km_shomate_formula_is(start + count, formula, c0, n) == 1) {
                count = count + 1;
            }
            return (start, count);
        }
        start = start + 1;
    }
    return (0 - 1, 0);
}

# Cp(T) in J/(mol·K) from the first segment of the run (start, count) whose t_max ≥ T, else the last
# (extrapolated below the first and above the last; NaN T reaches the last). Rust's Segments::cp.
#must_use
fn _km_segments_cp(start, count, temperature_k: f64): f64 {
    var k = 0;
    while (k < count) {
        var hi: f64 = KM_SHOMATE_T_MAX[start + k];
        if (temperature_k <= hi) {
            var r: f64 = _km_shomate_row_cp(start + k, temperature_k);
            return r;
        }
        k = k + 1;
    }
    var last: f64 = _km_shomate_row_cp(start + count - 1, temperature_k);
    return last;
}

# ∫[T₁→T₂] Cp dT in J/mol over the run (start, count), analytically and segment by segment: the
# boundaries are the interior t_max values, the first and last segments extrapolate beyond the covered
# range. From +0.0 with `total +=`, then × ±1, as Rust's Segments::enthalpy_change.
#must_use
fn _km_segments_enthalpy_change(start, count, t1_k: f64, t2_k: f64): f64 {
    var lo: f64 = t2_k;
    var hi: f64 = t1_k;
    var sign: f64 = -1.0;
    if (t1_k <= t2_k) {
        lo = t1_k;
        hi = t2_k;
        sign = 1.0;
    }
    var inf: f64 = _KM_INF;
    var total: f64 = 0.0;
    var lower: f64 = -inf;
    var k = 0;
    while (k < count) {
        var row = start + k;
        var upper: f64 = KM_SHOMATE_T_MAX[row];
        if (k + 1 == count) { upper = inf; }
        var a: f64 = _km_max(lo, lower);
        var b: f64 = _km_min(hi, upper);
        if (b > a) {
            var hb: f64 = _km_shomate_row_h(row, b);
            var ha: f64 = _km_shomate_row_h(row, a);
            total = total + (hb - ha);
        }
        if (upper >= hi) { break; }
        lower = upper;
        k = k + 1;
    }
    var r: f64 = sign * total;
    return r;
}

# The sensible-enthalpy change of one species from T₁ to T₂ (K), ΔH = ∫[T₁→T₂] Cp(T) dT in **J/mol**,
# integrating the Shomate polynomials analytically and piecewise across the species' segments
# (negative when T₂ < T₁). Ok(ΔH); Err(KM_ERR_INVALID_REACTION) if the formula has no Shomate data
# (checked first); Err(KM_ERR_INVALID_TEMPERATURE) if a temperature is not positive and finite, or any
# part of [T₁, T₂] lies outside the range the segments cover. Mirrors `thermochem::enthalpy_change_cp`.
#must_use
fn enthalpy_change_cp(formula, t1_k: f64, t2_k: f64): Result {
    var start, count = _km_segments_lookup(formula);
    if (count == 0) { return Err(KM_ERR_INVALID_REACTION); }
    if (_km_is_positive(t1_k) != 1 || _km_is_positive(t2_k) != 1) { return Err(KM_ERR_INVALID_TEMPERATURE); }
    var lo: f64 = _km_min(t1_k, t2_k);
    var hi: f64 = _km_max(t1_k, t2_k);
    var t_min: f64 = KM_SHOMATE_T_MIN[start];
    var t_max: f64 = KM_SHOMATE_T_MAX[start + count - 1];
    if (lo < t_min || hi > t_max) { return Err(KM_ERR_INVALID_TEMPERATURE); }
    var dh: f64 = _km_segments_enthalpy_change(start, count, t1_k, t2_k);
    return Ok(dh);
}

# ── adiabatic flame temperature ─────────────────────────────────────────────────────

# How many products' resolved segments adiabatic_flame_temperature keeps in its stack table (2 words
# each); a longer list resolves the rest again at each evaluation (same values, slower). Rust keeps a
# Vec; the port doesn't allocate (the bump allocator can't free, and this is called in loops).
const _KM_FLAME_CACHED = 32;

# The segments (start, count) of product k: from the stack table `cache` for k < _KM_FLAME_CACHED,
# else resolved from its formula (already checked to have segments).
#must_use
fn _km_flame_segments(products, cache, k): (i64, i64) {
    if (k < _KM_FLAME_CACHED) { return (load64(cache + k * 16), load64(cache + k * 16 + 8)); }
    var start, count = _km_segments_lookup(load64(products + k * 16));
    return (start, count);
}

# The flame's energy balance f(T) = −ΔH_rxn − Σ nᵢ·∫[T₀→T] Cpᵢ dT (J/mol): Rust's closure `f`, the sum
# folded from −0.0 (Rust's `.sum()`) in product order.
#must_use
fn _km_flame_f(dh: f64, products, n, cache, t0: f64, t: f64): f64 {
    var heat: f64 = -0.0;
    var k = 0;
    while (k < n) {
        var start, count = _km_flame_segments(products, cache, k);
        var moles: f64 = load64(products + k * 16 + 8);
        var d: f64 = _km_segments_enthalpy_change(start, count, t0, t);
        heat = heat + (moles * d);
        k = k + 1;
    }
    var ndh: f64 = -dh;
    var r: f64 = ndh - heat;
    return r;
}

# Its derivative f′(T) = −Σ nᵢ·Cpᵢ(T): Rust's closure `df`, the sum folded from −0.0.
#must_use
fn _km_flame_df(products, n, cache, t: f64): f64 {
    var cp: f64 = -0.0;
    var k = 0;
    while (k < n) {
        var start, count = _km_flame_segments(products, cache, k);
        var moles: f64 = load64(products + k * 16 + 8);
        var c: f64 = _km_segments_cp(start, count, t);
        cp = cp + (moles * c);
        k = k + 1;
    }
    var r: f64 = -cp;
    return r;
}

# hisab 1.4.0 `num::newton_raphson(f, df, x0, tol, max_iter)` on the flame balance, operation for
# operation, with Rust's FLAME_NEWTON_TOL_J = 1e-3 J/mol and max_iter = 50: per iteration, stop with
# x if |f(x)| < tol; fail if |f′(x)| < EPSILON_F64 (10⁻¹²); else x −= f(x)/f′(x). (KM_ERR_NONE, x), or
# (KM_ERR_INVALID_INPUT, x) for hisab's "derivative is zero" and (KM_ERR_COMPUTATION_ERROR, x) for its
# NoConvergence; the caller only tells Ok from Err, as Rust's `if let Ok`.
#must_use
fn _km_flame_newton(dh: f64, products, n, cache, t0: f64, x0: f64): (i64, f64) {
    var tol: f64 = 0.001;
    var eps: f64 = EPSILON_F64;
    var x: f64 = x0;
    var it = 0;
    while (it < 50) {
        var fx: f64 = _km_flame_f(dh, products, n, cache, t0, x);
        var afx: f64 = f64_abs(fx);
        if (afx < tol) { return (KM_ERR_NONE, x); }
        var dfx: f64 = _km_flame_df(products, n, cache, x);
        var adfx: f64 = f64_abs(dfx);
        if (adfx < eps) { return (KM_ERR_INVALID_INPUT, x); }
        x = x - (fx / dfx);
        it = it + 1;
    }
    return (KM_ERR_COMPUTATION_ERROR, x);
}

# hisab 1.4.0 `num::bisection(f, a, b, tol, max_iter)` on the flame balance, operation for operation,
# with Rust's FLAME_BISECTION_TOL = 1e-6 and max_iter = 200: fail if f(a) and f(b) have the same sign; orient so
# f(lo) < 0 (swap when f(a) > 0); per iteration mid = (lo + hi)·0.5, stop with mid if |f(mid)| < tol or
# |hi − lo| < tol, else move the end whose sign f(mid) shares; after max_iter, (lo + hi)·0.5.
# (KM_ERR_NONE, T) or (KM_ERR_INVALID_INPUT, 0.0) for hisab's opposite-signs error. ADR 0002 #38 (the overflow audit's
# B6): hisab's test is the product f(a)·f(b) > 0, which a product underflowing to +0 passes although the signs agree;
# here it is the exact sign comparison (f(a) > 0 and f(b) > 0, or both < 0), the same answer wherever the product does
# not underflow to a zero (a NaN, ±∞ or ±0 operand included). The flame calls it only after its bracket test proved
# f(a) and f(b) of strictly opposite signs, and f is deterministic, so neither test refuses there: no result changes.
#must_use
fn _km_flame_bisection(dh: f64, products, n, cache, t0: f64, a: f64, b: f64): (i64, f64) {
    var tol: f64 = 0.000001;
    var lo: f64 = a;
    var hi: f64 = b;
    var f_lo: f64 = _km_flame_f(dh, products, n, cache, t0, lo);
    var f_hi: f64 = _km_flame_f(dh, products, n, cache, t0, hi);
    if ((f_lo > 0.0 && f_hi > 0.0) || (f_lo < 0.0 && f_hi < 0.0)) { return (KM_ERR_INVALID_INPUT, 0.0); }
    if (f_lo > 0.0) {
        var sw: f64 = lo;
        lo = hi;
        hi = sw;
    }
    var it = 0;
    while (it < 200) {
        var mid: f64 = (lo + hi) * 0.5;
        var f_mid: f64 = _km_flame_f(dh, products, n, cache, t0, mid);
        var am: f64 = f64_abs(f_mid);
        var w: f64 = hi - lo;
        var aw: f64 = f64_abs(w);
        if (am < tol || aw < tol) { return (KM_ERR_NONE, mid); }
        if (f_mid < 0.0) { lo = mid; } else { hi = mid; }
        it = it + 1;
    }
    var r: f64 = (lo + hi) * 0.5;
    return (KM_ERR_NONE, r);
}

# The adiabatic flame temperature in K (no dissociation, constant pressure): T where
# ΔH_rxn + Σ nᵢ·∫[T₀→T] Cpᵢ dT = 0, the sensible enthalpies integrated analytically and piecewise
# across each product's Shomate segments. From reaction_enthalpy_j, ΔH_rxn in **J/mol** (exothermic
# negative) at T₀ (reaction_enthalpy's value, corrected to T₀ if T₀ ≠ 298.15 K), the n product
# (formula, moles) records at `products` (per mole of reaction; each needs Shomate data) and T₀ =
# t_initial_k. The search is restricted to the range every product's data covers: Newton–Raphson from
# T₀ − ΔH/(40·Σn) (an average Cp of 40 J/(mol·K) per mole of product) clamped to [T₀, T_max], accepted
# only inside it, else bisection on [T₀, T_max] (hisab 1.4.0's loops, transcribed). Ok(T);
# Err(KM_ERR_INVALID_TEMPERATURE) if T₀ is not positive and finite or lies outside the products' common
# range [T_min, T_max); Err(KM_ERR_INVALID_INPUT) if ΔH is not finite, the list is empty (or no list),
# or a product's moles are not positive and finite; Err(KM_ERR_INVALID_REACTION) for a product with no
# Shomate data (the first bad product in list order decides); Err(KM_ERR_COMPUTATION_ERROR) if the root
# can't be bracketed (ΔH ≥ 0, or the flame temperature is past T_max: f(T₀) and f(T_max) not of strictly
# opposite signs, so NaN and ±0 fail it) or the bisection fails. Mirrors
# `thermochem::adiabatic_flame_temperature`, in Rust's order of checks. ADR 0002 #38 (the overflow audit's B6,
# the user's decision to fix the iterative edges, here the bracket's exact sign test): Rust tests
# f(T₀)·f(T_max) < 0, a product that underflows to −0 for a tiny |ΔH| and moles (|f(T₀)·f(T_max)| at most
# 2⁻¹⁰⁷⁵), so a reaction whose balance does change sign is "not bracketed" (Err); here the signs are compared
# exactly, the same answer wherever the product does not underflow to a zero (a NaN, ±∞ or ±0 operand included).
# Newton, its tolerances and every Err are Rust's.
#must_use
fn adiabatic_flame_temperature(reaction_enthalpy_j: f64, products, n, t_initial_k: f64): Result {
    if (_km_is_positive(t_initial_k) != 1) { return Err(KM_ERR_INVALID_TEMPERATURE); }
    if (_km_is_finite(reaction_enthalpy_j) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    if (n <= 0 || products == 0) { return Err(KM_ERR_INVALID_INPUT); }

    # Resolve each product's segments once (Rust's `resolved`, one pass in list order) and the range
    # every product covers.
    var cache: i64[64];
    var inf: f64 = _KM_INF;
    var range_min: f64 = -inf;
    var range_max: f64 = inf;
    var k = 0;
    while (k < n) {
        var start, count = _km_segments_lookup(load64(products + k * 16));
        if (count == 0) { return Err(KM_ERR_INVALID_REACTION); }
        var moles: f64 = load64(products + k * 16 + 8);
        if (_km_is_positive(moles) != 1) { return Err(KM_ERR_INVALID_INPUT); }
        var smin: f64 = KM_SHOMATE_T_MIN[start];
        var smax: f64 = KM_SHOMATE_T_MAX[start + count - 1];
        range_min = _km_max(range_min, smin);
        range_max = _km_min(range_max, smax);
        if (k < _KM_FLAME_CACHED) {
            store64(&cache + k * 16, start);
            store64(&cache + k * 16 + 8, count);
        }
        k = k + 1;
    }
    if (t_initial_k < range_min || t_initial_k >= range_max) { return Err(KM_ERR_INVALID_TEMPERATURE); }

    # f(T₀) = −ΔH_rxn and f decreases, so a sign change on [T₀, T_max] means an exothermic reaction
    # whose root lies in the data range. ADR 0002 #38: the exact sign test (f_lo < 0 < f_hi or f_hi < 0 < f_lo),
    # where Rust's f_lo·f_hi < 0 fails when the product underflows to −0. It is Rust's answer wherever the
    # product does not underflow to a zero: a NaN operand fails both (NaN·x is NaN; NaN compares false), a ±0
    # operand fails both (the product ±0 or 0·∞ = NaN), and for two nonzero non-NaN values the product's sign is
    # the xor of theirs, its value negative, −∞ or −0, the last only by underflow.
    var t_lo: f64 = t_initial_k;
    var t_hi: f64 = range_max;
    var f_lo: f64 = _km_flame_f(reaction_enthalpy_j, products, n, &cache, t_initial_k, t_lo);
    var f_hi: f64 = _km_flame_f(reaction_enthalpy_j, products, n, &cache, t_initial_k, t_hi);
    var bracketed = 0;
    if ((f_lo < 0.0 && f_hi > 0.0) || (f_lo > 0.0 && f_hi < 0.0)) { bracketed = 1; }
    if (bracketed != 1) { return Err(KM_ERR_COMPUTATION_ERROR); }

    # The initial guess: an average Cp of 40 J/(mol·K) per mole of product (Rust's typed constant).
    var total_moles: f64 = -0.0;
    k = 0;
    while (k < n) {
        var m: f64 = load64(products + k * 16 + 8);
        total_moles = total_moles + m;
        k = k + 1;
    }
    var g0: f64 = t_initial_k - (reaction_enthalpy_j / (total_moles * 40.0));
    var g1: f64 = _km_max(g0, t_lo);
    var t_guess: f64 = _km_min(g1, t_hi);

    # Newton first; accept only a root in t_lo ..= t_hi.
    var en, tn = _km_flame_newton(reaction_enthalpy_j, products, n, &cache, t_initial_k, t_guess);
    var t_newton: f64 = tn;
    if (en == KM_ERR_NONE && t_newton >= t_lo && t_newton <= t_hi) { return Ok(t_newton); }

    # Fallback: bisection on the verified bracket.
    var eb, tb = _km_flame_bisection(reaction_enthalpy_j, products, n, &cache, t_initial_k, t_lo, t_hi);
    if (eb != KM_ERR_NONE) { return Err(KM_ERR_COMPUTATION_ERROR); }
    var t_bis: f64 = tb;
    return Ok(t_bis);
}
