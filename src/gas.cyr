# gas.cyr — gas laws: ideal gas, van der Waals, Peng–Robinson and Redlich–Kwong equations of
# state, Dalton's law, gas density and Peng–Robinson fugacity (port of rust-old/src/gas.rs).
#
# SI throughout: pressure in Pa, temperature in K, volume in m³ (molar volume in m³/mol), amount
# in mol. Fallible functions return a value-form Result whose Err payload is a KM_ERR_* code, and
# reject NaN and ±∞ inputs instead of returning Ok(NaN). The data — struct KmPengRobinsonParams,
# the KM_PR_* presets and KM_STP_* — is src/gas_data.cyr (generated).
#
# Every expression keeps Rust's operation order, constant by constant, including the private
# helpers (pr_coefficients, pr_dimensionless, pr_physical_roots, cubic_real_roots), which are
# transcribed as _km_* functions. The cubic is Rust's analytic solver: the trigonometric form when
# there are three real roots (acos, cos), Cardano's in the cancellation-free form of Numerical
# Recipes §5.6 otherwise (cbrt and sqrt, both correctly rounded on both sides), then two guarded
# Newton steps per root.
# - Rust's PengRobinsonParams is passed by value, as a KmPengRobinsonParams; a preset is the global
#   KM_PR_WATER, … (port plan §6.4).
# - peng_robinson_z_roots's Vec<f64> of 1–3 roots becomes a caller's buffer of three f64 (24
#   bytes), `var roots[24];`: the call returns Ok(n) with the n ascending roots in roots[0 .. n − 1].
# - Every transcendental is correctly rounded (ADR 0006): acos and cos are src/mathx.cyr's two-phase _km_cr_acos and
#   _km_cr_cos (M4a; M4d replaced ADR 0005's double-double _km_acos and _km_cos, which gave the same bits on every
#   golden argument), ln, exp and x^2.5 its _km_cr_ln, _km_cr_exp and _km_cr_pow(x, 2.5), so the class-C
#   rows are compared exactly against the corrected oracle (docs/development/port-parity.md §10). cbrt is
#   ganita_f64_cbrt, correctly rounded as the oracle's (Rust's compiler-builtins) is on every golden argument;
#   f64_clamp is lib/math.cyr's.
# - ADR 0002 #31 (the overflow audit's B3; the user's decisions of 2026-11-09 and 2026-11-10, "library-wide audit" and
#   "round once"): ideal_gas_pressure's and ideal_gas_volume's ((n·R)·T)/x and gas_density's (P·M)/(R·T) are each one
#   product or quotient of inputs and R's double, so the port returns the exact value rounded once (src/mathx.cyr's
#   correctly rounded monomial: _km_cr_mul3_div, _km_cr_mul2_div2), where Rust rounds three times (1–2 ulp off on about
#   a quarter of inputs) and a partial product that over- or underflows gives ±∞ or 0 although the value is
#   representable. van_der_waals_pressure, peng_robinson_pressure and redlich_kwong_pressure have sums inside, so they
#   get ADR 0002 #20's semantics: Rust's chain where it provably stays in the normal range (a range test per operation:
#   Rust's bits), otherwise Rust's operation sequence with an unbounded exponent (src/mathx.cyr's _km_ux_*), the V ≤ n·b
#   or V ≤ b test on the unbounded co-volume and the final subtraction rounded once into binary64 (_km_vdw_ux,
#   _km_pr_pressure_ux, _km_rk_pressure_ux; Tc^2.5 exactly rescaled, _km_rk_tc25_ux). The Peng–Robinson Z, roots and
#   fugacity keep _km_pr_coefficients, Rust's chain (the audit's later batches review them). Rust's checks, Err codes
#   and order are kept.

include "lib/math.cyr"
include "lib/ganita.cyr"

# Peng–Robinson validation of the critical constants (Rust's validate_pr_params): KM_ERR_NONE, or
# the error code (NaN and ±∞ rejected).
#must_use
fn _km_pr_validate(params: KmPengRobinsonParams): i64 {
    var tc: f64 = params.tc;
    var pc: f64 = params.pc;
    var omega: f64 = params.omega;
    if (_km_is_positive(tc) != 1) { return KM_ERR_INVALID_TEMPERATURE; }
    if (_km_is_positive(pc) != 1) { return KM_ERR_INVALID_INPUT; }
    if (_km_is_finite(omega) != 1) { return KM_ERR_INVALID_INPUT; }
    return KM_ERR_NONE;
}

# Peng–Robinson a·α(T) (Pa·m⁶/mol²) and b (m³/mol) from the critical constants, with the original
# 1976 κ(ω) polynomial (fitted for ω ≤ 0.49). The caller has run _km_pr_validate. Rust's
# pr_coefficients.
#must_use
fn _km_pr_coefficients(params: KmPengRobinsonParams, temperature_k: f64): (f64, f64) {
    var tc: f64 = params.tc;
    var pc: f64 = params.pc;
    var omega: f64 = params.omega;
    var a: f64 = ((((0.45724 * KM_GAS_CONSTANT) * KM_GAS_CONSTANT) * tc) * tc) / pc;
    var b: f64 = ((0.07780 * KM_GAS_CONSTANT) * tc) / pc;
    var kappa: f64 = (0.37464 + (1.54226 * omega)) - ((0.26992 * omega) * omega);
    var tr: f64 = temperature_k / tc;
    var sq: f64 = f64_sqrt(tr);
    var u: f64 = 1.0 + (kappa * (1.0 - sq));
    var alpha: f64 = _km_powi(u, 2);
    var a_alpha: f64 = a * alpha;
    return (a_alpha, b);
}

# The validated, dimensionless Peng–Robinson parameters A = a·α·P/(RT)² and B = bP/(RT): (code,
# A, B), the code KM_ERR_NONE or the error (the Rust order of checks: T, P, then the critical
# constants). Rust's pr_dimensionless.
#must_use
fn _km_pr_dimensionless(params: KmPengRobinsonParams, temperature_k: f64, pressure_pa: f64): (i64, f64, f64) {
    if (_km_is_positive(temperature_k) != 1) { return (KM_ERR_INVALID_TEMPERATURE, 0.0, 0.0); }
    if (_km_is_positive(pressure_pa) != 1) { return (KM_ERR_INVALID_INPUT, 0.0, 0.0); }
    var e = _km_pr_validate(params);
    if (e != KM_ERR_NONE) { return (e, 0.0, 0.0); }
    var a_alpha, b = _km_pr_coefficients(params, temperature_k);
    var rt: f64 = KM_GAS_CONSTANT * temperature_k;
    var cap_a: f64 = (a_alpha * pressure_pa) / (rt * rt);
    var cap_b: f64 = (b * pressure_pa) / rt;
    return (KM_ERR_NONE, cap_a, cap_b);
}

# The cubic z³ + c2·z² + c1·z + c0 at z, Horner's form as Rust's `poly` closure.
#must_use
fn _km_cubic_poly(z: f64, c2: f64, c1: f64, c0: f64): f64 {
    var p: f64 = ((((z + c2) * z) + c1) * z) + c0;
    return p;
}

# Up to two Newton steps on the cubic from z, each kept only if it lowers |poly| (Rust's guarded
# polish); stops at a zero value or a zero derivative.
#must_use
fn _km_cubic_polish(z0: f64, c2: f64, c1: f64, c0: f64): f64 {
    var z: f64 = z0;
    var it = 0;
    while (it < 2) {
        var f: f64 = _km_cubic_poly(z, c2, c1, c0);
        var df: f64 = (((3.0 * z) + (2.0 * c2)) * z) + c1;
        if (f == 0.0 || df == 0.0) { break; }
        var next: f64 = z - (f / df);
        var fnext: f64 = _km_cubic_poly(next, c2, c1, c0);
        var an: f64 = f64_abs(fnext);
        var af: f64 = f64_abs(f);
        if (an < af) { z = next; } else { break; }
        it = it + 1;
    }
    return z;
}

# Real roots of z³ + c2·z² + c1·z + c0 = 0, ascending, into `out` (three f64, 24 bytes); returns
# how many (1 or 3). The trigonometric form when there are three real roots (the discriminant
# within the 10⁻¹² relative degeneracy tolerance, so a double root lost to rounding is still
# reported), Cardano's formula otherwise, then each root polished by _km_cubic_polish. Rust's
# cubic_real_roots, operation for operation.
fn _km_cubic_real_roots(c2: f64, c1: f64, c0: f64, out): i64 {
    var shift: f64 = c2 / 3.0;
    var q: f64 = ((c2 * c2) - (3.0 * c1)) / 9.0;
    var r: f64 = ((c2 * (((2.0 * c2) * c2) - (9.0 * c1))) + (27.0 * c0)) / 54.0;
    var q3: f64 = (q * q) * q;
    var r2: f64 = r * r;
    var tol: f64 = 1.0 + 0.000000000001;   # 1.0 + CUBIC_DEGENERACY_TOL, folded in Rust
    var z0: f64 = 0.0;
    var z1: f64 = 0.0;
    var z2: f64 = 0.0;
    var n = 1;
    if (q > 0.0 && r2 <= (q3 * tol)) {
        # Three real roots (possibly coincident). Clamp: rounding can push |r|/√q³ slightly
        # above 1 near a double root.
        var sqrt_q: f64 = f64_sqrt(q);
        var ratio: f64 = r / (sqrt_q * q);
        var cl: f64 = f64_clamp(ratio, -1.0, 1.0);
        var theta: f64 = _km_cr_acos(cl);
        var m: f64 = -2.0 * sqrt_q;
        var tau: f64 = 0x401921FB54442D18;  # std::f64::consts::TAU
        var k0: f64 = _km_cr_cos(theta / 3.0);
        var k1: f64 = _km_cr_cos((theta - tau) / 3.0);
        var k2: f64 = _km_cr_cos((theta + tau) / 3.0);
        z0 = (m * k0) - shift;
        z1 = (m * k1) - shift;
        z2 = (m * k2) - shift;
        n = 3;
    } else {
        # One real root.
        var sg: f64 = _km_signum(r);
        var d: f64 = _km_max(r2 - q3, 0.0);
        var sd: f64 = f64_sqrt(d);
        var ar: f64 = f64_abs(r);
        var cb: f64 = ganita_f64_cbrt(ar + sd);
        var big_a: f64 = -sg * cb;
        var big_b: f64 = 0.0;
        if (big_a != 0.0) { big_b = q / big_a; }
        z0 = (big_a + big_b) - shift;
    }
    z0 = _km_cubic_polish(z0, c2, c1, c0);
    if (n == 3) {
        z1 = _km_cubic_polish(z1, c2, c1, c0);
        z2 = _km_cubic_polish(z2, c2, c1, c0);
        # Already ascending by construction; re-sort in case polishing swapped two nearly
        # coincident roots (Rust's three compare-and-swaps).
        var t: f64 = 0.0;
        if (z0 > z1) { t = z0; z0 = z1; z1 = t; }
        if (z1 > z2) { t = z1; z1 = z2; z2 = t; }
        if (z0 > z1) { t = z0; z0 = z1; z1 = t; }
    }
    store64(out, z0);
    store64(out + 8, z1);
    store64(out + 16, z2);
    return n;
}

# The roots of the Peng–Robinson Z-cubic Z³ − (1−B)Z² + (A−3B²−2B)Z − (AB−B²−B³) = 0 with Z > B
# and finite, ascending, into `out` (three f64); returns how many (0–3). Rust's pr_physical_roots.
fn _km_pr_physical_roots(cap_a: f64, cap_b: f64, out): i64 {
    var c2: f64 = cap_b - 1.0;
    var c1: f64 = (cap_a - ((3.0 * cap_b) * cap_b)) - (2.0 * cap_b);
    var c0: f64 = -(((cap_a * cap_b) - (cap_b * cap_b)) - ((cap_b * cap_b) * cap_b));
    var all[24];
    var n_real = _km_cubic_real_roots(c2, c1, c0, &all);
    var n = 0;
    var k = 0;
    while (k < n_real) {
        var z: f64 = load64(&all + k * 8);
        if (_km_is_finite(z) == 1 && z > cap_b) {
            store64(out + n * 8, z);
            n = n + 1;
        }
        k = k + 1;
    }
    return n;
}

# ── ideal gas, van der Waals, Dalton, density ───────────────────────────────────────

# Ideal gas law P = nRT/V in Pa, from n in mol, T in K and V in m³. Ok(P),
# Err(KM_ERR_INVALID_INPUT) if n is not finite or V is not positive and finite, or
# Err(KM_ERR_INVALID_TEMPERATURE) if T is not positive and finite. ADR 0002 #31: the correctly rounded n·R·T/V (R as
# its double; n = ±0 gives that signed zero), where Rust's ((n·R)·T)/V rounds three times and n·R·T can over- or
# underflow. Mirrors `gas::ideal_gas_pressure`, with ADR 0002 #31.
#must_use
fn ideal_gas_pressure(moles: f64, temperature_k: f64, volume_m3: f64): Result {
    if (_km_is_finite(moles) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    if (_km_is_positive(temperature_k) != 1) { return Err(KM_ERR_INVALID_TEMPERATURE); }
    if (_km_is_positive(volume_m3) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    var r: f64 = KM_GAS_CONSTANT;
    var p: f64 = _km_cr_mul3_div(moles, r, temperature_k, volume_m3);
    return Ok(p);
}

# Ideal gas law V = nRT/P in m³, from n in mol, T in K and P in Pa. Ok(V),
# Err(KM_ERR_INVALID_INPUT) if n is not finite or P is not positive and finite, or
# Err(KM_ERR_INVALID_TEMPERATURE) if T is not positive and finite. ADR 0002 #31: the correctly rounded n·R·T/P (R as
# its double; n = ±0 gives that signed zero), where Rust's ((n·R)·T)/P rounds three times and n·R·T can over- or
# underflow (ideal_gas_volume(DBL_MAX, 300, 101325) is ∞ in Rust, 4.43·10³⁰⁶ here). Mirrors `gas::ideal_gas_volume`,
# with ADR 0002 #31.
#must_use
fn ideal_gas_volume(moles: f64, temperature_k: f64, pressure_pa: f64): Result {
    if (_km_is_finite(moles) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    if (_km_is_positive(temperature_k) != 1) { return Err(KM_ERR_INVALID_TEMPERATURE); }
    if (_km_is_positive(pressure_pa) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    var r: f64 = KM_GAS_CONSTANT;
    var v: f64 = _km_cr_mul3_div(moles, r, temperature_k, pressure_pa);
    return Ok(v);
}

# Van der Waals equation (P + a·n²/V²)(V − n·b) = nRT, solved for P in Pa, from n (mol), T (K),
# V (m³), the attraction constant a (Pa·m⁶/mol²; 1 L²·bar/mol² = 0.1 Pa·m⁶/mol²) and the excluded
# volume b (m³/mol; 1 L/mol = 10⁻³ m³/mol). Ok(P), Err(KM_ERR_INVALID_TEMPERATURE) if T is not
# positive and finite, or Err(KM_ERR_INVALID_INPUT) if n is not finite, a or b is negative or
# non-finite, V is not positive and finite, or V ≤ n·b. ADR 0002 #31 (#20's semantics: the formula has a difference
# inside): Rust's (((n·R)·T)/(V − n·b)) − ((a·(n/V))·(n/V)) where its chain stays in the normal range (Rust's bits),
# otherwise the same sequence with an unbounded exponent, the V ≤ n·b test on the unbounded n·b and the final
# subtraction rounded once (_km_vdw_ux). Mirrors `gas::van_der_waals_pressure`, with ADR 0002 #31.
#must_use
fn van_der_waals_pressure(moles: f64, temperature_k: f64, volume_m3: f64, a: f64, b: f64): Result {
    if (_km_is_positive(temperature_k) != 1) { return Err(KM_ERR_INVALID_TEMPERATURE); }
    if (_km_is_finite(moles) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    if (_km_is_non_negative(a) != 1 || _km_is_non_negative(b) != 1) {
        return Err(KM_ERR_INVALID_INPUT);
    }
    if (_km_is_positive(volume_m3) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    var p, e, ok = _km_vdw_fast(moles, temperature_k, volume_m3, a, b);
    if (ok != 1) {
        var p2, e2 = _km_vdw_ux(moles, temperature_k, volume_m3, a, b);
        p = p2;
        e = e2;
    }
    if (e != KM_ERR_NONE) { return Err(e); }
    return Ok(p);
}

# van_der_waals_pressure's fast path, for its validated inputs: (P, KM_ERR_NONE, 1) or (0, the Err, 1) while Rust's
# chain provably is the unbounded-exponent one (ADR 0002 #31), (0, 0, 0) otherwise. Inside the region n, a, b = 0 or of
# magnitude in [2⁻⁶⁰, 2⁶⁰] and T, V in [2⁻⁶⁰, 2⁶⁰] every intermediate is provably normal or an exact zero (n·b is 0 or
# within 2^±120, n·R·T 0 or in [2⁻¹¹⁷, 2¹²⁴], V − n·b in [2⁻¹⁷², 2¹²¹] (V > n·b: ulp-close values subtract exactly), the
# quotient 0 or in [2⁻¹⁷⁷, 2²⁹⁶], n/V within 2^±120, a·(n/V) and its product with n/V 0 or within 2^±300), so the tests
# below are skipped. Outside it: n·b normal or exact (a zero factor), or +∞ (then V ≤ n·b in both evaluations: the
# unbounded n·b is past DBL_MAX ≥ V), so V ≤ n·b decides alike; then n·R, n·R·T, n/V, a·(n/V), its product with n/V and
# the quotient term each normal or an exact zero (n = 0, or a = 0), and V − n·b finite (a difference of two doubles is
# exact where it is subnormal). The final subtraction of two doubles is then rounded once in both evaluations.
#must_use
fn _km_vdw_fast(n: f64, t: f64, v: f64, a: f64, b: f64): (f64, i64, i64) {
    var lo = 0x3C30000000000000;                # 2⁻⁶⁰
    var hi = 0x43B0000000000000;                # 2⁶⁰
    var m = 0x7FFFFFFFFFFFFFFF;
    var bn = load64(&n) & m;
    var bt = load64(&t);
    var bv = load64(&v);
    var ba = load64(&a);
    var bbv = load64(&b);
    var inbox = 1;
    if (bt < lo || bt > hi || bv < lo || bv > hi) { inbox = 0; }
    if (bn != 0 && (bn < lo || bn > hi)) { inbox = 0; }
    if (ba != 0 && (ba < lo || ba > hi)) { inbox = 0; }
    if (bbv != 0 && (bbv < lo || bbv > hi)) { inbox = 0; }
    var nb: f64 = n * b;
    var exact = 0;
    if (n == 0.0 || b == 0.0) { exact = 1; }
    if (inbox != 1 && _km_ux_normal(nb) != 1 && exact != 1 && nb != _KM_INF) { return (0.0, 0, 0); }
    if (v <= nb) { return (0.0, KM_ERR_INVALID_INPUT, 1); }
    var nr: f64 = n * KM_GAS_CONSTANT;
    var nrt: f64 = nr * t;
    var den: f64 = v - nb;
    var t1: f64 = nrt / den;
    var nv: f64 = n / v;
    var an: f64 = a * nv;
    var t2: f64 = an * nv;
    if (inbox != 1 && n != 0.0) {
        var ok1 = _km_ux_normal(nr) + _km_ux_normal(nrt) + _km_ux_normal(t1) + _km_ux_normal(nv);
        if (ok1 != 4 || den == _KM_INF) { return (0.0, 0, 0); }
        if (a != 0.0 && (_km_ux_normal(an) != 1 || _km_ux_normal(t2) != 1)) { return (0.0, 0, 0); }
    }
    var p: f64 = t1 - t2;
    return (p, KM_ERR_NONE, 1);
}

# van_der_waals_pressure with an unbounded exponent (ADR 0002 #31), for its validated inputs: (P, KM_ERR_NONE) or
# (0, KM_ERR_INVALID_INPUT) where V ≤ n·b on the unbounded n·b; Rust's (((n·R)·T)/(V − n·b)) − ((a·(n/V))·(n/V)) with
# every operation rounded to 53 bits and nothing over- or underflowing (src/mathx.cyr's _km_ux_*), the final
# subtraction rounded once into binary64 (_km_ux_sub_f64).
#must_use
fn _km_vdw_ux(n: f64, t: f64, v: f64, a: f64, b: f64): (f64, i64) {
    var ns, ne = _km_ux_from(n);
    var bs, be = _km_ux_from(b);
    var nbs, nbe = _km_ux_mul(ns, ne, bs, be);
    var vs, ve = _km_ux_from(v);
    if (_km_ux_le(vs, ve, nbs, nbe) == 1) { return (0.0, KM_ERR_INVALID_INPUT); }
    var r: f64 = KM_GAS_CONSTANT;
    var rs, re = _km_ux_from(r);
    var ts, te = _km_ux_from(t);
    var q1s, q1e = _km_ux_mul(ns, ne, rs, re);
    var q2s, q2e = _km_ux_mul(q1s, q1e, ts, te);
    var ds, de = _km_ux_sub(vs, ve, nbs, nbe);
    var t1s, t1e = _km_ux_div(q2s, q2e, ds, de);
    var nvs, nve = _km_ux_div(ns, ne, vs, ve);
    var as1, ae = _km_ux_from(a);
    var ans, ane = _km_ux_mul(as1, ae, nvs, nve);
    var t2s, t2e = _km_ux_mul(ans, ane, nvs, nve);
    var p: f64 = _km_ux_sub_f64(t1s, t1e, t2s, t2e);
    return (p, KM_ERR_NONE);
}

# Dalton's law: the partial pressure, total pressure × mole fraction, in the total's unit. Mirrors
# `gas::partial_pressure`.
#must_use
fn partial_pressure(total_pressure: f64, mole_fraction: f64): f64 {
    var p: f64 = total_pressure * mole_fraction;
    return p;
}

# Gas density ρ = PM/(RT) in kg/m³, from P in Pa, the molar mass M in kg/mol and T in K. Ok(ρ),
# Err(KM_ERR_INVALID_TEMPERATURE) if T is not positive and finite, or Err(KM_ERR_INVALID_INPUT) if P
# is negative or non-finite or M is not positive and finite. ADR 0002 #31: the correctly rounded P·M/(R·T) (R as its
# double; P = ±0 gives that signed zero), where Rust's (P·M)/(R·T) rounds three times and R·T overflows for T past
# 2.16·10³⁰⁷ (gas_density(101325, 0.029, DBL_MAX) is 0 in Rust, 1.97·10⁻³⁰⁶ here). Mirrors `gas::gas_density`, with
# ADR 0002 #31.
#must_use
fn gas_density(pressure_pa: f64, molar_mass_kg: f64, temperature_k: f64): Result {
    if (_km_is_positive(temperature_k) != 1) { return Err(KM_ERR_INVALID_TEMPERATURE); }
    if (_km_is_non_negative(pressure_pa) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    if (_km_is_positive(molar_mass_kg) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    var r: f64 = KM_GAS_CONSTANT;
    var rho: f64 = _km_cr_mul2_div2(pressure_pa, molar_mass_kg, r, temperature_k);
    return Ok(rho);
}

# ── Peng–Robinson ───────────────────────────────────────────────────────────────────

# Peng–Robinson pressure P = RT/(V − b) − a·α(T)/(V² + 2bV − b²) in Pa, from the critical constants
# and acentric factor (`params`), T in K and the molar volume V in m³/mol. Ok(P),
# Err(KM_ERR_INVALID_TEMPERATURE) if T or Tc is not positive and finite, or
# Err(KM_ERR_INVALID_INPUT) if Pc is not positive and finite, ω is not finite, or V is non-finite or
# not greater than b. ADR 0002 #31 (#20's semantics: sums inside): Rust's chain (pr_coefficients' a·α and b, then
# RT/(V − b) − a·α/(V² + 2bV − b²)) where it stays in the normal range (Rust's bits), otherwise the same sequence with
# an unbounded exponent, the V ≤ b test on the unbounded b and the final subtraction rounded once (_km_pr_pressure_ux):
# a subnormal Tc (Rust's T/Tc = ∞ and a·α = 0·∞ = NaN), V·V past DBL_MAX (Rust's term₂ = 0, the wrong sign), Tc·Tc
# or ω² past it. Mirrors `gas::peng_robinson_pressure`, with ADR 0002 #31.
#must_use
fn peng_robinson_pressure(params: KmPengRobinsonParams, temperature_k: f64, molar_volume: f64): Result {
    if (_km_is_positive(temperature_k) != 1) { return Err(KM_ERR_INVALID_TEMPERATURE); }
    var e = _km_pr_validate(params);
    if (e != KM_ERR_NONE) { return Err(e); }
    if (_km_is_finite(molar_volume) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    var tc: f64 = params.tc;
    var pc: f64 = params.pc;
    var omega: f64 = params.omega;
    var p, e2, ok = _km_pr_pressure_fast(tc, pc, omega, temperature_k, molar_volume);
    if (ok != 1) {
        var p2, e3 = _km_pr_pressure_ux(tc, pc, omega, temperature_k, molar_volume);
        p = p2;
        e2 = e3;
    }
    if (e2 != KM_ERR_NONE) { return Err(e2); }
    return Ok(p);
}

# peng_robinson_pressure's fast path, for validated inputs and a finite V: (P, KM_ERR_NONE, 1) or (0, the Err, 1) while
# Rust's chain provably is the unbounded-exponent one (ADR 0002 #31), (0, 0, 0) otherwise. Rust's operations in Rust's
# order (pr_coefficients transcribed); inside _km_pr_box's region every one is proven normal, outside it each product,
# quotient or square is checked normal (_km_ux_normal) or an exact zero (a zero factor) and each sum finite (a subnormal
# sum of two doubles is exact); √(T/Tc) of a correct operand is correct. Then b is the unbounded b, so V ≤ b decides
# alike, and the final subtraction of two doubles is rounded once in both evaluations.
#must_use
fn _km_pr_pressure_fast(tc: f64, pc: f64, omega: f64, t: f64, v: f64): (f64, i64, i64) {
    var r: f64 = KM_GAS_CONSTANT;
    var c3: f64 = ((0.45724 * r) * r) * tc;
    var c4: f64 = c3 * tc;
    var a: f64 = c4 / pc;
    var d2: f64 = (0.07780 * r) * tc;
    var b: f64 = d2 / pc;
    var k1: f64 = 1.54226 * omega;
    var k3: f64 = 0.26992 * omega;
    var k4: f64 = k3 * omega;
    var kappa: f64 = (0.37464 + k1) - k4;
    var tr: f64 = t / tc;
    var sq: f64 = f64_sqrt(tr);
    var s1: f64 = 1.0 - sq;
    var s2: f64 = kappa * s1;
    var u: f64 = 1.0 + s2;
    var alpha: f64 = _km_powi(u, 2);
    var aa: f64 = a * alpha;
    var inbox = _km_pr_box(tc, pc, omega, t, v);
    if (inbox != 1) {
        var n1 = _km_ux_normal(c3) + _km_ux_normal(c4) + _km_ux_normal(a) + _km_ux_normal(d2) + _km_ux_normal(b);
        if (n1 != 5) { return (0.0, 0, 0); }
        if (omega != 0.0 && _km_ux_normal(k1) + _km_ux_normal(k3) + _km_ux_normal(k4) != 3) { return (0.0, 0, 0); }
        var dk: f64 = kappa - kappa;
        if (_km_ux_normal(tr) != 1 || dk != 0.0) { return (0.0, 0, 0); }
        if (kappa != 0.0 && s1 != 0.0 && _km_ux_normal(s2) != 1) { return (0.0, 0, 0); }
        if (u != 0.0 && _km_ux_normal(alpha) != 1) { return (0.0, 0, 0); }
        if (alpha != 0.0 && _km_ux_normal(aa) != 1) { return (0.0, 0, 0); }
    }
    if (v <= b) { return (0.0, KM_ERR_INVALID_INPUT, 1); }
    var rt: f64 = r * t;
    var vb: f64 = v - b;
    var t1: f64 = rt / vb;
    var vv: f64 = v * v;
    var b2: f64 = 2.0 * b;
    var b2v: f64 = b2 * v;
    var sm: f64 = vv + b2v;
    var bb: f64 = b * b;
    var den: f64 = sm - bb;
    var t2: f64 = aa / den;
    if (inbox != 1) {
        var n2 = _km_ux_normal(rt) + _km_ux_normal(t1) + _km_ux_normal(vv) + _km_ux_normal(b2) + _km_ux_normal(b2v);
        if (n2 != 5 || _km_ux_normal(bb) != 1 || sm == _KM_INF || vb == _KM_INF) { return (0.0, 0, 0); }
        if (aa != 0.0 && _km_ux_normal(t2) != 1) { return (0.0, 0, 0); }
    }
    var p: f64 = t1 - t2;
    return (p, KM_ERR_NONE, 1);
}

# 1 if every intermediate of peng_robinson_pressure's chain is provably normal or an exact zero, by the inputs alone
# (the fast path then skips its per-operation tests; ADR 0002 #31): Tc, Pc, T, V in [2⁻⁶⁰, 2⁶⁰] and ω = 0 or |ω| in
# [2⁻⁶⁰, 2⁶⁰]. Then a = 0.45724R²Tc²/Pc is in [2⁻¹⁷⁵, 2¹⁸⁵] and b = 0.0778RTc/Pc in [2⁻¹²¹, 2¹²⁰]; 1.54226ω, 0.26992ω
# and 0.26992ω² are 0 or within 2^±122, so κ is finite, and 0 or at least 2⁻¹⁷⁴ (a nonzero sum of these doubles is a
# multiple of the smallest ulp, 2⁻¹⁷⁴); T/Tc is in [2⁻¹²⁰, 2¹²⁰], 1 − √(T/Tc) 0 or at least 2⁻⁵³ (√(T/Tc) in [2⁻⁶⁰,
# 2⁶⁰]; near 1 the difference is exact), so κ·(1 − √) is 0 or in [2⁻²²⁷, 2¹⁸¹]; u = 1 + κ(1 − √) is 0 or at least 2⁻⁵³,
# α = u² 0 or in [2⁻¹⁰⁶, 2³⁶³], a·α 0 or in [2⁻²⁸¹, 2⁵⁴⁸]; RT is in [2⁻⁵⁷, 2⁶⁴], V − b (V > b) at least 2⁻¹⁷³ (ulp-close
# values subtract exactly), RT/(V − b) in [2⁻¹⁷⁸, 2²³⁷]; V², 2b, 2bV and b² within 2^±242, the denominator V² + 2bV − b²
# above 2b²·(1 − 2⁻⁵⁰) ≥ 2⁻²⁴³ and below 2¹²², a·α over it 0 or in [2⁻⁴⁰⁴, 2⁷⁹¹]: far inside [2⁻¹⁰²¹, DBL_MAX]. Every
# physical state is inside.
#must_use
fn _km_pr_box(tc: f64, pc: f64, omega: f64, t: f64, v: f64): i64 {
    var lo = 0x3C30000000000000;                # 2⁻⁶⁰
    var hi = 0x43B0000000000000;                # 2⁶⁰
    var a1 = load64(&tc);
    var a2 = load64(&pc);
    var a3 = load64(&t);
    var a4 = load64(&v);
    var a5 = load64(&omega) & 0x7FFFFFFFFFFFFFFF;
    if (a1 < lo || a1 > hi || a2 < lo || a2 > hi || a3 < lo || a3 > hi || a4 < lo || a4 > hi) { return 0; }
    if (a5 != 0 && (a5 < lo || a5 > hi)) { return 0; }
    return 1;
}

# peng_robinson_pressure with an unbounded exponent (ADR 0002 #31), for validated inputs and a finite V: (P,
# KM_ERR_NONE) or (0, KM_ERR_INVALID_INPUT) where V ≤ b on the unbounded b; Rust's pr_coefficients and RT/(V − b) −
# a·α/(V² + 2bV − b²) with every operation rounded to 53 bits and nothing over- or underflowing (src/mathx.cyr's
# _km_ux_*; α = u·u, as Rust's powi(2)), the final subtraction rounded once into binary64 (_km_ux_sub_f64).
#must_use
fn _km_pr_pressure_ux(tc: f64, pc: f64, omega: f64, t: f64, v: f64): (f64, i64) {
    var r: f64 = KM_GAS_CONSTANT;
    var rs, re = _km_ux_from(r);
    var tcs, tce = _km_ux_from(tc);
    var pcs, pce = _km_ux_from(pc);
    var c0: f64 = 0.45724;
    var cs, ce = _km_ux_from(c0);
    var c1s, c1e = _km_ux_mul(cs, ce, rs, re);
    var c2s, c2e = _km_ux_mul(c1s, c1e, rs, re);
    var c3s, c3e = _km_ux_mul(c2s, c2e, tcs, tce);
    var c4s, c4e = _km_ux_mul(c3s, c3e, tcs, tce);
    var as1, ae = _km_ux_div(c4s, c4e, pcs, pce);
    var d0: f64 = 0.07780;
    var ds, de = _km_ux_from(d0);
    var d1s, d1e = _km_ux_mul(ds, de, rs, re);
    var d2s, d2e = _km_ux_mul(d1s, d1e, tcs, tce);
    var bs, be = _km_ux_div(d2s, d2e, pcs, pce);
    var vs, ve = _km_ux_from(v);
    if (_km_ux_le(vs, ve, bs, be) == 1) { return (0.0, KM_ERR_INVALID_INPUT); }
    var os, oe = _km_ux_from(omega);
    var e1: f64 = 1.54226;
    var e1s, e1e = _km_ux_from(e1);
    var k1s, k1e = _km_ux_mul(e1s, e1e, os, oe);
    var e0: f64 = 0.37464;
    var e0s, e0e = _km_ux_from(e0);
    var k2s, k2e = _km_ux_add(e0s, e0e, k1s, k1e);
    var e3: f64 = 0.26992;
    var e3s, e3e = _km_ux_from(e3);
    var k3s, k3e = _km_ux_mul(e3s, e3e, os, oe);
    var k4s, k4e = _km_ux_mul(k3s, k3e, os, oe);
    var kas, kae = _km_ux_sub(k2s, k2e, k4s, k4e);
    var ts, te = _km_ux_from(t);
    var trs, tre = _km_ux_div(ts, te, tcs, tce);
    var sqs, sqe = _km_ux_sqrt(trs, tre);
    var one: f64 = 1.0;
    var ones, onee = _km_ux_from(one);
    var s1s, s1e = _km_ux_sub(ones, onee, sqs, sqe);
    var s2s, s2e = _km_ux_mul(kas, kae, s1s, s1e);
    var us, ue = _km_ux_add(ones, onee, s2s, s2e);
    var als, ale = _km_ux_mul(us, ue, us, ue);
    var aas, aae = _km_ux_mul(as1, ae, als, ale);
    var rts, rte = _km_ux_mul(rs, re, ts, te);
    var vbs, vbe = _km_ux_sub(vs, ve, bs, be);
    var t1s, t1e = _km_ux_div(rts, rte, vbs, vbe);
    var vvs, vve = _km_ux_mul(vs, ve, vs, ve);
    var two: f64 = 2.0;
    var twos, twoe = _km_ux_from(two);
    var b2s, b2e = _km_ux_mul(twos, twoe, bs, be);
    var bvs, bve = _km_ux_mul(b2s, b2e, vs, ve);
    var sms, sme = _km_ux_add(vvs, vve, bvs, bve);
    var bbs, bbe = _km_ux_mul(bs, be, bs, be);
    var dns, dne = _km_ux_sub(sms, sme, bbs, bbe);
    var t2s, t2e = _km_ux_div(aas, aae, dns, dne);
    var p: f64 = _km_ux_sub_f64(t1s, t1e, t2s, t2e);
    return (p, KM_ERR_NONE);
}

# All physical Peng–Robinson compressibility-factor roots, ascending: the cubic
# Z³ − (1−B)Z² + (A−3B²−2B)Z − (AB−B²−B³) = 0, A = a·α·P/(RT)², B = bP/(RT), solved analytically
# (Cardano, or the trigonometric form when there are three real roots), keeping the roots with
# Z > B (molar volume above the co-volume b). With three roots the smallest is liquid-like, the
# largest vapour-like and the middle one mechanically unstable; which phase is stable is decided by
# the fugacities (lower wins): water at 300 K and 1 atm has ≈ [0.00086, 0.0138, 0.985], and the
# liquid is stable. A repeated root (a spinodal, the critical point) is listed once per
# multiplicity. `out` is the caller's buffer of three f64 (`var roots[24];`): Ok(n), n = 1–3, with
# the roots in out[0 .. n − 1]; Err(KM_ERR_INVALID_TEMPERATURE) if T or Tc is not positive and
# finite, Err(KM_ERR_INVALID_INPUT) if P or Pc is not positive and finite or ω is not finite, or
# Err(KM_ERR_COMPUTATION_ERROR) if no root has Z > B (only when intermediate values overflow).
# Mirrors `gas::peng_robinson_z_roots`, whose Vec the buffer and count replace.
#must_use
fn peng_robinson_z_roots(params: KmPengRobinsonParams, temperature_k: f64, pressure_pa: f64, out): Result {
    var e, cap_a, cap_b = _km_pr_dimensionless(params, temperature_k, pressure_pa);
    if (e != KM_ERR_NONE) { return Err(e); }
    var n = _km_pr_physical_roots(cap_a, cap_b, out);
    if (n == 0) { return Err(KM_ERR_COMPUTATION_ERROR); }
    return Ok(n);
}

# The Peng–Robinson compressibility factor Z: the largest physical root of the cubic (see
# peng_robinson_z_roots), the vapour-like one. It is not necessarily the stable phase: below Tc the
# cubic can have a liquid root too, and the stable phase is the one with the lower fugacity (water
# at 300 K and 1 atm: vapour Z ≈ 0.985, stable liquid Z ≈ 0.00086). Ok(Z), or the errors of
# peng_robinson_z_roots. Mirrors `gas::peng_robinson_z`.
#must_use
fn peng_robinson_z(params: KmPengRobinsonParams, temperature_k: f64, pressure_pa: f64): Result {
    var e, cap_a, cap_b = _km_pr_dimensionless(params, temperature_k, pressure_pa);
    if (e != KM_ERR_NONE) { return Err(e); }
    var roots[24];
    var n = _km_pr_physical_roots(cap_a, cap_b, &roots);
    if (n == 0) { return Err(KM_ERR_COMPUTATION_ERROR); }
    var z: f64 = load64(&roots + (n - 1) * 8);
    return Ok(z);
}

# The Peng–Robinson fugacity coefficient φ (dimensionless) at the vapour (largest) root Z of
# peng_robinson_z: ln φ = (Z − 1) − ln(Z − B) − A/(2√2·B) × ln((Z + (1+√2)B) / (Z + (1−√2)B)). See
# peng_robinson_z for why this is not always the stable phase. Ok(φ), the errors of
# peng_robinson_z, or Err(KM_ERR_COMPUTATION_ERROR) if φ is not finite and positive. Mirrors
# `gas::fugacity_coefficient_pr`.
#must_use
fn fugacity_coefficient_pr(params: KmPengRobinsonParams, temperature_k: f64, pressure_pa: f64): Result {
    var e, cap_a, cap_b = _km_pr_dimensionless(params, temperature_k, pressure_pa);
    if (e != KM_ERR_NONE) { return Err(e); }
    var roots[24];
    var n = _km_pr_physical_roots(cap_a, cap_b, &roots);
    if (n == 0) { return Err(KM_ERR_COMPUTATION_ERROR); }
    var z: f64 = load64(&roots + (n - 1) * 8);
    var sqrt2: f64 = 0x3FF6A09E667F3BCD;  # std::f64::consts::SQRT_2
    var l1: f64 = _km_cr_ln(z - cap_b);
    var coef: f64 = cap_a / ((2.0 * sqrt2) * cap_b);
    var num: f64 = z + ((1.0 + sqrt2) * cap_b);
    var den: f64 = z + ((1.0 - sqrt2) * cap_b);
    var l2: f64 = _km_cr_ln(num / den);
    var ln_phi: f64 = ((z - 1.0) - l1) - (coef * l2);
    var phi: f64 = _km_cr_exp(ln_phi);
    if (_km_is_positive(phi) != 1) { return Err(KM_ERR_COMPUTATION_ERROR); }
    return Ok(phi);
}

# The Peng–Robinson fugacity f = φ × P in Pa, with φ from fugacity_coefficient_pr (vapour root).
# Ok(f), or that function's errors. Mirrors `gas::fugacity_pr`.
#must_use
fn fugacity_pr(params: KmPengRobinsonParams, temperature_k: f64, pressure_pa: f64): Result {
    var t, v = fugacity_coefficient_pr(params, temperature_k, pressure_pa);
    if (is_ok(t) != 1) { return Err(v); }
    var phi: f64 = v;
    var f: f64 = phi * pressure_pa;
    return Ok(f);
}

# ── Redlich–Kwong ───────────────────────────────────────────────────────────────────

# Redlich–Kwong pressure P = RT/(V − b) − a/(T^½ × V(V + b)) in Pa, from the critical temperature
# Tc (K) and pressure Pc (Pa), T in K and the molar volume V in m³/mol. Ok(P),
# Err(KM_ERR_INVALID_TEMPERATURE) if T or Tc is not positive and finite, or
# Err(KM_ERR_INVALID_INPUT) if Pc is not positive and finite or V is non-finite or not greater
# than b. ADR 0002 #31 (#20's semantics: a difference inside): Rust's chain where it stays in the normal range (Rust's
# bits), otherwise the same sequence with an unbounded exponent, the V ≤ b test on the unbounded b and the final
# subtraction rounded once (_km_rk_pressure_ux): Tc^2.5 past DBL_MAX for Tc above about 1.3·10¹²³ while a = 0.42748·R²·
# Tc^2.5/Pc is finite (Rust's −∞), (√T·V)·(V + b) past it, the products' underflow. Tc^2.5 with an unbounded exponent is
# RN₅₃(Tc^2.5), exactly _km_cr_pow(s, 2.5)·2^(5j) for Tc = s·2^(2j), s in [1, 4) (_km_rk_tc25_ux). Mirrors
# `gas::redlich_kwong_pressure`, with ADR 0002 #31.
#must_use
fn redlich_kwong_pressure(tc: f64, pc: f64, temperature_k: f64, molar_volume: f64): Result {
    if (_km_is_positive(temperature_k) != 1) { return Err(KM_ERR_INVALID_TEMPERATURE); }
    if (_km_is_positive(tc) != 1) { return Err(KM_ERR_INVALID_TEMPERATURE); }
    if (_km_is_positive(pc) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    if (_km_is_finite(molar_volume) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    var p, e, ok = _km_rk_pressure_fast(tc, pc, temperature_k, molar_volume);
    if (ok != 1) {
        var p2, e2 = _km_rk_pressure_ux(tc, pc, temperature_k, molar_volume);
        p = p2;
        e = e2;
    }
    if (e != KM_ERR_NONE) { return Err(e); }
    return Ok(p);
}

# redlich_kwong_pressure's fast path, for validated inputs and a finite V: (P, KM_ERR_NONE, 1) or (0, the Err, 1) while
# Rust's chain provably is the unbounded-exponent one (ADR 0002 #31), (0, 0, 0) otherwise. Inside the region Tc, Pc, T,
# V in [2⁻⁶⁰, 2⁶⁰] every intermediate is provably normal (Tc^2.5 within 2^±150, a in [2⁻²⁰⁶, 2²¹⁵], b in [2⁻¹²¹, 2¹²⁰],
# RT in [2⁻⁵⁷, 2⁶⁴], V − b at least 2⁻¹⁷³ (V > b: ulp-close values subtract exactly), RT/(V − b) in [2⁻¹¹⁷, 2²³⁷], √T·V
# within 2^±90, (√T·V)·(V + b) in [2⁻¹⁵⁰, 2²¹¹], a over it in [2⁻⁴¹⁷, 2³⁶⁵]), so the tests are skipped. Outside it:
# Tc^2.5 (the correctly rounded _km_cr_pow, RN₅₃(Tc^2.5) wherever it is normal) and every product and quotient normal
# (_km_ux_normal), the sums V − b and V + b finite (a subnormal sum of two doubles is exact), √T of a correct operand
# correct. b is then the unbounded b, so V ≤ b decides alike, and the final subtraction of two doubles is rounded once
# in both evaluations.
#must_use
fn _km_rk_pressure_fast(tc: f64, pc: f64, t: f64, v: f64): (f64, i64, i64) {
    var lo = 0x3C30000000000000;                # 2⁻⁶⁰
    var hi = 0x43B0000000000000;                # 2⁶⁰
    var b1 = load64(&tc);
    var b2 = load64(&pc);
    var b3 = load64(&t);
    var b4 = load64(&v);
    var inbox = 1;
    if (b1 < lo || b1 > hi || b2 < lo || b2 > hi || b3 < lo || b3 > hi || b4 < lo || b4 > hi) { inbox = 0; }
    var r: f64 = KM_GAS_CONSTANT;
    var tc25: f64 = _km_cr_pow(tc, 2.5);
    var c3: f64 = ((0.42748 * r) * r) * tc25;
    var a: f64 = c3 / pc;
    var d2: f64 = (0.08664 * r) * tc;
    var b: f64 = d2 / pc;
    if (inbox != 1) {
        var n1 = _km_ux_normal(tc25) + _km_ux_normal(c3) + _km_ux_normal(a) + _km_ux_normal(d2) + _km_ux_normal(b);
        if (n1 != 5) { return (0.0, 0, 0); }
    }
    if (v <= b) { return (0.0, KM_ERR_INVALID_INPUT, 1); }
    var rt: f64 = r * t;
    var vb: f64 = v - b;
    var t1: f64 = rt / vb;
    var st: f64 = f64_sqrt(t);
    var sv: f64 = st * v;
    var vpb: f64 = v + b;
    var den: f64 = sv * vpb;
    var t2: f64 = a / den;
    if (inbox != 1) {
        var n2 = _km_ux_normal(rt) + _km_ux_normal(t1) + _km_ux_normal(sv) + _km_ux_normal(den) + _km_ux_normal(t2);
        if (n2 != 5 || vb == _KM_INF || vpb == _KM_INF) { return (0.0, 0, 0); }
    }
    var p: f64 = t1 - t2;
    return (p, KM_ERR_NONE, 1);
}

# Tc^2.5 with an unbounded exponent (ADR 0002 #31): RN₅₃(Tc^2.5) as an (s, e) pair, for a positive finite Tc. With
# Tc = s·2^(2j), s in [1, 4) (Tc's (significand, exponent) pair, the significand doubled for an odd exponent: exact),
# Tc^2.5 = s^2.5·2^(5j) exactly, s^2.5 lies in [1, 32), inside binary64's normal range, where the correctly rounded
# _km_cr_pow(s, 2.5) is the 53-bit rounding of s^2.5, and 53-bit rounding commutes with scaling by 2^(5j) when the
# exponent is unbounded: so RN₅₃(Tc^2.5) = _km_cr_pow(s, 2.5)·2^(5j), the pair (its significand, its exponent + 5j).
#must_use
fn _km_rk_tc25_ux(tc: f64): (f64, i64) {
    var s0, e0 = _km_ux_from(tc);
    var s: f64 = s0;
    var j = e0 / 2;
    if ((e0 & 1) != 0) {
        s = s0 * 2.0;
        j = (e0 - 1) / 2;
    }
    var pw: f64 = _km_cr_pow(s, 2.5);
    var ps, pe = _km_ux_from(pw);
    return (ps, pe + 5 * j);
}

# redlich_kwong_pressure with an unbounded exponent (ADR 0002 #31), for validated inputs and a finite V: (P,
# KM_ERR_NONE) or (0, KM_ERR_INVALID_INPUT) where V ≤ b on the unbounded b; Rust's a = (((0.42748·R)·R)·Tc^2.5)/Pc, b =
# ((0.08664·R)·Tc)/Pc and RT/(V − b) − a/((√T·V)·(V + b)) with every operation rounded to 53 bits and nothing over- or
# underflowing (src/mathx.cyr's _km_ux_*; Tc^2.5 by _km_rk_tc25_ux), the final subtraction rounded once into binary64
# (_km_ux_sub_f64).
#must_use
fn _km_rk_pressure_ux(tc: f64, pc: f64, t: f64, v: f64): (f64, i64) {
    var r: f64 = KM_GAS_CONSTANT;
    var rs, re = _km_ux_from(r);
    var tcs, tce = _km_ux_from(tc);
    var pcs, pce = _km_ux_from(pc);
    var c0: f64 = 0.42748;
    var cs, ce = _km_ux_from(c0);
    var c1s, c1e = _km_ux_mul(cs, ce, rs, re);
    var c2s, c2e = _km_ux_mul(c1s, c1e, rs, re);
    var ws, we = _km_rk_tc25_ux(tc);
    var c3s, c3e = _km_ux_mul(c2s, c2e, ws, we);
    var as1, ae = _km_ux_div(c3s, c3e, pcs, pce);
    var d0: f64 = 0.08664;
    var ds, de = _km_ux_from(d0);
    var d1s, d1e = _km_ux_mul(ds, de, rs, re);
    var d2s, d2e = _km_ux_mul(d1s, d1e, tcs, tce);
    var bs, be = _km_ux_div(d2s, d2e, pcs, pce);
    var vs, ve = _km_ux_from(v);
    if (_km_ux_le(vs, ve, bs, be) == 1) { return (0.0, KM_ERR_INVALID_INPUT); }
    var ts, te = _km_ux_from(t);
    var rts, rte = _km_ux_mul(rs, re, ts, te);
    var vbs, vbe = _km_ux_sub(vs, ve, bs, be);
    var t1s, t1e = _km_ux_div(rts, rte, vbs, vbe);
    var sts, ste = _km_ux_sqrt(ts, te);
    var svs, sve = _km_ux_mul(sts, ste, vs, ve);
    var vps, vpe = _km_ux_add(vs, ve, bs, be);
    var dns, dne = _km_ux_mul(svs, sve, vps, vpe);
    var t2s, t2e = _km_ux_div(as1, ae, dns, dne);
    var p: f64 = _km_ux_sub_f64(t1s, t1e, t2s, t2e);
    return (p, KM_ERR_NONE);
}

# Joule–Thomson coefficient of an ideal gas: always 0.0 K/Pa. A real gas's needs the derivatives of
# an equation of state (Peng–Robinson). Mirrors `gas::joule_thomson_ideal`.
#must_use
fn joule_thomson_ideal(): f64 {
    return 0.0;
}
