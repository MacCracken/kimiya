# gas.cyr — gas laws: ideal gas, van der Waals, Peng–Robinson and Redlich–Kwong equations of
# state, Dalton's law, gas density and Peng–Robinson fugacity (port of rust-old/src/gas.rs).
#
# SI throughout: pressure in Pa, temperature in K, volume in m³ (molar volume in m³/mol), amount
# in mol. Fallible functions return a value-form Result whose Err payload is a KM_ERR_* code, and
# reject NaN and ±∞ inputs instead of returning Ok(NaN). The data — struct KmPengRobinsonParams,
# the KM_PR_* presets and KM_STP_* — is src/gas_data.cyr (generated).
#
# Every expression keeps Rust's operation order, constant by constant, including the private
# helpers (pr_coefficients, pr_dimensionless, pr_physical_roots, cubic_real_roots), which are
# transcribed as _km_* functions. The cubic is Rust's analytic solver: the trigonometric form when
# there are three real roots (acos, cos), Cardano's in the cancellation-free form of Numerical
# Recipes §5.6 otherwise (cbrt and sqrt, both correctly rounded on both sides), then two guarded
# Newton steps per root.
# - Rust's PengRobinsonParams is passed by value, as a KmPengRobinsonParams; a preset is the global
#   KM_PR_WATER, … (port plan §6.4).
# - peng_robinson_z_roots's Vec<f64> of 1–3 roots becomes a caller's buffer of three f64 (24
#   bytes), `var roots[24];`: the call returns Ok(n) with the n ascending roots in roots[0 .. n − 1].
# - Every transcendental is correctly rounded (ADR 0006): acos and cos are src/mathx.cyr's _km_acos and
#   _km_cos (ADR 0005), ln, exp and x^2.5 its _km_cr_ln, _km_cr_exp and _km_cr_pow(x, 2.5), so the class-C
#   rows are compared exactly against the corrected oracle (docs/development/port-parity.md §10). cbrt is
#   ganita_f64_cbrt, correctly rounded as the oracle's (Rust's compiler-builtins) is on every golden argument;
#   f64_clamp is lib/math.cyr's.

include "lib/math.cyr"
include "lib/ganita.cyr"

# Peng–Robinson validation of the critical constants (Rust's validate_pr_params): KM_ERR_NONE, or
# the error code (NaN and ±∞ rejected).
#must_use
fn _km_pr_validate(params: KmPengRobinsonParams): i64 {
    var tc: f64 = params.tc;
    var pc: f64 = params.pc;
    var omega: f64 = params.omega;
    if (_km_is_positive(tc) != 1) { return KM_ERR_INVALID_TEMPERATURE; }
    if (_km_is_positive(pc) != 1) { return KM_ERR_INVALID_INPUT; }
    if (_km_is_finite(omega) != 1) { return KM_ERR_INVALID_INPUT; }
    return KM_ERR_NONE;
}

# Peng–Robinson a·α(T) (Pa·m⁶/mol²) and b (m³/mol) from the critical constants, with the original
# 1976 κ(ω) polynomial (fitted for ω ≤ 0.49). The caller has run _km_pr_validate. Rust's
# pr_coefficients.
#must_use
fn _km_pr_coefficients(params: KmPengRobinsonParams, temperature_k: f64): (f64, f64) {
    var tc: f64 = params.tc;
    var pc: f64 = params.pc;
    var omega: f64 = params.omega;
    var a: f64 = ((((0.45724 * KM_GAS_CONSTANT) * KM_GAS_CONSTANT) * tc) * tc) / pc;
    var b: f64 = ((0.07780 * KM_GAS_CONSTANT) * tc) / pc;
    var kappa: f64 = (0.37464 + (1.54226 * omega)) - ((0.26992 * omega) * omega);
    var tr: f64 = temperature_k / tc;
    var sq: f64 = f64_sqrt(tr);
    var u: f64 = 1.0 + (kappa * (1.0 - sq));
    var alpha: f64 = _km_powi(u, 2);
    var a_alpha: f64 = a * alpha;
    return (a_alpha, b);
}

# The validated, dimensionless Peng–Robinson parameters A = a·α·P/(RT)² and B = bP/(RT): (code,
# A, B), the code KM_ERR_NONE or the error (the Rust order of checks: T, P, then the critical
# constants). Rust's pr_dimensionless.
#must_use
fn _km_pr_dimensionless(params: KmPengRobinsonParams, temperature_k: f64, pressure_pa: f64): (i64, f64, f64) {
    if (_km_is_positive(temperature_k) != 1) { return (KM_ERR_INVALID_TEMPERATURE, 0.0, 0.0); }
    if (_km_is_positive(pressure_pa) != 1) { return (KM_ERR_INVALID_INPUT, 0.0, 0.0); }
    var e = _km_pr_validate(params);
    if (e != KM_ERR_NONE) { return (e, 0.0, 0.0); }
    var a_alpha, b = _km_pr_coefficients(params, temperature_k);
    var rt: f64 = KM_GAS_CONSTANT * temperature_k;
    var cap_a: f64 = (a_alpha * pressure_pa) / (rt * rt);
    var cap_b: f64 = (b * pressure_pa) / rt;
    return (KM_ERR_NONE, cap_a, cap_b);
}

# The cubic z³ + c2·z² + c1·z + c0 at z, Horner's form as Rust's `poly` closure.
#must_use
fn _km_cubic_poly(z: f64, c2: f64, c1: f64, c0: f64): f64 {
    var p: f64 = ((((z + c2) * z) + c1) * z) + c0;
    return p;
}

# Up to two Newton steps on the cubic from z, each kept only if it lowers |poly| (Rust's guarded
# polish); stops at a zero value or a zero derivative.
#must_use
fn _km_cubic_polish(z0: f64, c2: f64, c1: f64, c0: f64): f64 {
    var z: f64 = z0;
    var it = 0;
    while (it < 2) {
        var f: f64 = _km_cubic_poly(z, c2, c1, c0);
        var df: f64 = (((3.0 * z) + (2.0 * c2)) * z) + c1;
        if (f == 0.0 || df == 0.0) { break; }
        var next: f64 = z - (f / df);
        var fnext: f64 = _km_cubic_poly(next, c2, c1, c0);
        var an: f64 = f64_abs(fnext);
        var af: f64 = f64_abs(f);
        if (an < af) { z = next; } else { break; }
        it = it + 1;
    }
    return z;
}

# Real roots of z³ + c2·z² + c1·z + c0 = 0, ascending, into `out` (three f64, 24 bytes); returns
# how many (1 or 3). The trigonometric form when there are three real roots (the discriminant
# within the 10⁻¹² relative degeneracy tolerance, so a double root lost to rounding is still
# reported), Cardano's formula otherwise, then each root polished by _km_cubic_polish. Rust's
# cubic_real_roots, operation for operation.
fn _km_cubic_real_roots(c2: f64, c1: f64, c0: f64, out): i64 {
    var shift: f64 = c2 / 3.0;
    var q: f64 = ((c2 * c2) - (3.0 * c1)) / 9.0;
    var r: f64 = ((c2 * (((2.0 * c2) * c2) - (9.0 * c1))) + (27.0 * c0)) / 54.0;
    var q3: f64 = (q * q) * q;
    var r2: f64 = r * r;
    var tol: f64 = 1.0 + 0.000000000001;   # 1.0 + CUBIC_DEGENERACY_TOL, folded in Rust
    var z0: f64 = 0.0;
    var z1: f64 = 0.0;
    var z2: f64 = 0.0;
    var n = 1;
    if (q > 0.0 && r2 <= (q3 * tol)) {
        # Three real roots (possibly coincident). Clamp: rounding can push |r|/√q³ slightly
        # above 1 near a double root.
        var sqrt_q: f64 = f64_sqrt(q);
        var ratio: f64 = r / (sqrt_q * q);
        var cl: f64 = f64_clamp(ratio, -1.0, 1.0);
        var theta: f64 = _km_acos(cl);
        var m: f64 = -2.0 * sqrt_q;
        var tau: f64 = 0x401921FB54442D18;  # std::f64::consts::TAU
        var k0: f64 = _km_cos(theta / 3.0);
        var k1: f64 = _km_cos((theta - tau) / 3.0);
        var k2: f64 = _km_cos((theta + tau) / 3.0);
        z0 = (m * k0) - shift;
        z1 = (m * k1) - shift;
        z2 = (m * k2) - shift;
        n = 3;
    } else {
        # One real root.
        var sg: f64 = _km_signum(r);
        var d: f64 = _km_max(r2 - q3, 0.0);
        var sd: f64 = f64_sqrt(d);
        var ar: f64 = f64_abs(r);
        var cb: f64 = ganita_f64_cbrt(ar + sd);
        var big_a: f64 = -sg * cb;
        var big_b: f64 = 0.0;
        if (big_a != 0.0) { big_b = q / big_a; }
        z0 = (big_a + big_b) - shift;
    }
    z0 = _km_cubic_polish(z0, c2, c1, c0);
    if (n == 3) {
        z1 = _km_cubic_polish(z1, c2, c1, c0);
        z2 = _km_cubic_polish(z2, c2, c1, c0);
        # Already ascending by construction; re-sort in case polishing swapped two nearly
        # coincident roots (Rust's three compare-and-swaps).
        var t: f64 = 0.0;
        if (z0 > z1) { t = z0; z0 = z1; z1 = t; }
        if (z1 > z2) { t = z1; z1 = z2; z2 = t; }
        if (z0 > z1) { t = z0; z0 = z1; z1 = t; }
    }
    store64(out, z0);
    store64(out + 8, z1);
    store64(out + 16, z2);
    return n;
}

# The roots of the Peng–Robinson Z-cubic Z³ − (1−B)Z² + (A−3B²−2B)Z − (AB−B²−B³) = 0 with Z > B
# and finite, ascending, into `out` (three f64); returns how many (0–3). Rust's pr_physical_roots.
fn _km_pr_physical_roots(cap_a: f64, cap_b: f64, out): i64 {
    var c2: f64 = cap_b - 1.0;
    var c1: f64 = (cap_a - ((3.0 * cap_b) * cap_b)) - (2.0 * cap_b);
    var c0: f64 = -(((cap_a * cap_b) - (cap_b * cap_b)) - ((cap_b * cap_b) * cap_b));
    var all[24];
    var n_real = _km_cubic_real_roots(c2, c1, c0, &all);
    var n = 0;
    var k = 0;
    while (k < n_real) {
        var z: f64 = load64(&all + k * 8);
        if (_km_is_finite(z) == 1 && z > cap_b) {
            store64(out + n * 8, z);
            n = n + 1;
        }
        k = k + 1;
    }
    return n;
}

# ── ideal gas, van der Waals, Dalton, density ───────────────────────────────────────

# Ideal gas law P = nRT/V in Pa, from n in mol, T in K and V in m³. Ok(P),
# Err(KM_ERR_INVALID_INPUT) if n is not finite or V is not positive and finite, or
# Err(KM_ERR_INVALID_TEMPERATURE) if T is not positive and finite. Mirrors `gas::ideal_gas_pressure`.
#must_use
fn ideal_gas_pressure(moles: f64, temperature_k: f64, volume_m3: f64): Result {
    if (_km_is_finite(moles) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    if (_km_is_positive(temperature_k) != 1) { return Err(KM_ERR_INVALID_TEMPERATURE); }
    if (_km_is_positive(volume_m3) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    var p: f64 = ((moles * KM_GAS_CONSTANT) * temperature_k) / volume_m3;
    return Ok(p);
}

# Ideal gas law V = nRT/P in m³, from n in mol, T in K and P in Pa. Ok(V),
# Err(KM_ERR_INVALID_INPUT) if n is not finite or P is not positive and finite, or
# Err(KM_ERR_INVALID_TEMPERATURE) if T is not positive and finite. Mirrors `gas::ideal_gas_volume`.
#must_use
fn ideal_gas_volume(moles: f64, temperature_k: f64, pressure_pa: f64): Result {
    if (_km_is_finite(moles) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    if (_km_is_positive(temperature_k) != 1) { return Err(KM_ERR_INVALID_TEMPERATURE); }
    if (_km_is_positive(pressure_pa) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    var v: f64 = ((moles * KM_GAS_CONSTANT) * temperature_k) / pressure_pa;
    return Ok(v);
}

# Van der Waals equation (P + a·n²/V²)(V − n·b) = nRT, solved for P in Pa, from n (mol), T (K),
# V (m³), the attraction constant a (Pa·m⁶/mol²; 1 L²·bar/mol² = 0.1 Pa·m⁶/mol²) and the excluded
# volume b (m³/mol; 1 L/mol = 10⁻³ m³/mol). Ok(P), Err(KM_ERR_INVALID_TEMPERATURE) if T is not
# positive and finite, or Err(KM_ERR_INVALID_INPUT) if n is not finite, a or b is negative or
# non-finite, V is not positive and finite, or V ≤ n·b. Mirrors `gas::van_der_waals_pressure`.
#must_use
fn van_der_waals_pressure(moles: f64, temperature_k: f64, volume_m3: f64, a: f64, b: f64): Result {
    if (_km_is_positive(temperature_k) != 1) { return Err(KM_ERR_INVALID_TEMPERATURE); }
    if (_km_is_finite(moles) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    if (_km_is_non_negative(a) != 1 || _km_is_non_negative(b) != 1) {
        return Err(KM_ERR_INVALID_INPUT);
    }
    if (_km_is_positive(volume_m3) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    var nb: f64 = moles * b;
    if (volume_m3 <= nb) { return Err(KM_ERR_INVALID_INPUT); }
    var n_over_v: f64 = moles / volume_m3;
    var p: f64 = (((moles * KM_GAS_CONSTANT) * temperature_k) / (volume_m3 - nb)) - ((a * n_over_v) * n_over_v);
    return Ok(p);
}

# Dalton's law: the partial pressure, total pressure × mole fraction, in the total's unit. Mirrors
# `gas::partial_pressure`.
#must_use
fn partial_pressure(total_pressure: f64, mole_fraction: f64): f64 {
    var p: f64 = total_pressure * mole_fraction;
    return p;
}

# Gas density ρ = PM/(RT) in kg/m³, from P in Pa, the molar mass M in kg/mol and T in K. Ok(ρ),
# Err(KM_ERR_INVALID_TEMPERATURE) if T is not positive and finite, or Err(KM_ERR_INVALID_INPUT) if P
# is negative or non-finite or M is not positive and finite. Mirrors `gas::gas_density`.
#must_use
fn gas_density(pressure_pa: f64, molar_mass_kg: f64, temperature_k: f64): Result {
    if (_km_is_positive(temperature_k) != 1) { return Err(KM_ERR_INVALID_TEMPERATURE); }
    if (_km_is_non_negative(pressure_pa) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    if (_km_is_positive(molar_mass_kg) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    var rho: f64 = (pressure_pa * molar_mass_kg) / (KM_GAS_CONSTANT * temperature_k);
    return Ok(rho);
}

# ── Peng–Robinson ───────────────────────────────────────────────────────────────────

# Peng–Robinson pressure P = RT/(V − b) − a·α(T)/(V² + 2bV − b²) in Pa, from the critical constants
# and acentric factor (`params`), T in K and the molar volume V in m³/mol. Ok(P),
# Err(KM_ERR_INVALID_TEMPERATURE) if T or Tc is not positive and finite, or
# Err(KM_ERR_INVALID_INPUT) if Pc is not positive and finite, ω is not finite, or V is non-finite or
# not greater than b. Mirrors `gas::peng_robinson_pressure`.
#must_use
fn peng_robinson_pressure(params: KmPengRobinsonParams, temperature_k: f64, molar_volume: f64): Result {
    if (_km_is_positive(temperature_k) != 1) { return Err(KM_ERR_INVALID_TEMPERATURE); }
    var e = _km_pr_validate(params);
    if (e != KM_ERR_NONE) { return Err(e); }
    var a_alpha, b = _km_pr_coefficients(params, temperature_k);
    if (_km_is_finite(molar_volume) != 1 || molar_volume <= b) { return Err(KM_ERR_INVALID_INPUT); }
    var v: f64 = molar_volume;
    var term1: f64 = (KM_GAS_CONSTANT * temperature_k) / (v - b);
    var term2: f64 = a_alpha / (((v * v) + ((2.0 * b) * v)) - (b * b));
    var p: f64 = term1 - term2;
    return Ok(p);
}

# All physical Peng–Robinson compressibility-factor roots, ascending: the cubic
# Z³ − (1−B)Z² + (A−3B²−2B)Z − (AB−B²−B³) = 0, A = a·α·P/(RT)², B = bP/(RT), solved analytically
# (Cardano, or the trigonometric form when there are three real roots), keeping the roots with
# Z > B (molar volume above the co-volume b). With three roots the smallest is liquid-like, the
# largest vapour-like and the middle one mechanically unstable; which phase is stable is decided by
# the fugacities (lower wins): water at 300 K and 1 atm has ≈ [0.00086, 0.0138, 0.985], and the
# liquid is stable. A repeated root (a spinodal, the critical point) is listed once per
# multiplicity. `out` is the caller's buffer of three f64 (`var roots[24];`): Ok(n), n = 1–3, with
# the roots in out[0 .. n − 1]; Err(KM_ERR_INVALID_TEMPERATURE) if T or Tc is not positive and
# finite, Err(KM_ERR_INVALID_INPUT) if P or Pc is not positive and finite or ω is not finite, or
# Err(KM_ERR_COMPUTATION_ERROR) if no root has Z > B (only when intermediate values overflow).
# Mirrors `gas::peng_robinson_z_roots`, whose Vec the buffer and count replace.
#must_use
fn peng_robinson_z_roots(params: KmPengRobinsonParams, temperature_k: f64, pressure_pa: f64, out): Result {
    var e, cap_a, cap_b = _km_pr_dimensionless(params, temperature_k, pressure_pa);
    if (e != KM_ERR_NONE) { return Err(e); }
    var n = _km_pr_physical_roots(cap_a, cap_b, out);
    if (n == 0) { return Err(KM_ERR_COMPUTATION_ERROR); }
    return Ok(n);
}

# The Peng–Robinson compressibility factor Z: the largest physical root of the cubic (see
# peng_robinson_z_roots), the vapour-like one. It is not necessarily the stable phase: below Tc the
# cubic can have a liquid root too, and the stable phase is the one with the lower fugacity (water
# at 300 K and 1 atm: vapour Z ≈ 0.985, stable liquid Z ≈ 0.00086). Ok(Z), or the errors of
# peng_robinson_z_roots. Mirrors `gas::peng_robinson_z`.
#must_use
fn peng_robinson_z(params: KmPengRobinsonParams, temperature_k: f64, pressure_pa: f64): Result {
    var e, cap_a, cap_b = _km_pr_dimensionless(params, temperature_k, pressure_pa);
    if (e != KM_ERR_NONE) { return Err(e); }
    var roots[24];
    var n = _km_pr_physical_roots(cap_a, cap_b, &roots);
    if (n == 0) { return Err(KM_ERR_COMPUTATION_ERROR); }
    var z: f64 = load64(&roots + (n - 1) * 8);
    return Ok(z);
}

# The Peng–Robinson fugacity coefficient φ (dimensionless) at the vapour (largest) root Z of
# peng_robinson_z: ln φ = (Z − 1) − ln(Z − B) − A/(2√2·B) × ln((Z + (1+√2)B) / (Z + (1−√2)B)). See
# peng_robinson_z for why this is not always the stable phase. Ok(φ), the errors of
# peng_robinson_z, or Err(KM_ERR_COMPUTATION_ERROR) if φ is not finite and positive. Mirrors
# `gas::fugacity_coefficient_pr`.
#must_use
fn fugacity_coefficient_pr(params: KmPengRobinsonParams, temperature_k: f64, pressure_pa: f64): Result {
    var e, cap_a, cap_b = _km_pr_dimensionless(params, temperature_k, pressure_pa);
    if (e != KM_ERR_NONE) { return Err(e); }
    var roots[24];
    var n = _km_pr_physical_roots(cap_a, cap_b, &roots);
    if (n == 0) { return Err(KM_ERR_COMPUTATION_ERROR); }
    var z: f64 = load64(&roots + (n - 1) * 8);
    var sqrt2: f64 = 0x3FF6A09E667F3BCD;  # std::f64::consts::SQRT_2
    var l1: f64 = _km_cr_ln(z - cap_b);
    var coef: f64 = cap_a / ((2.0 * sqrt2) * cap_b);
    var num: f64 = z + ((1.0 + sqrt2) * cap_b);
    var den: f64 = z + ((1.0 - sqrt2) * cap_b);
    var l2: f64 = _km_cr_ln(num / den);
    var ln_phi: f64 = ((z - 1.0) - l1) - (coef * l2);
    var phi: f64 = _km_cr_exp(ln_phi);
    if (_km_is_positive(phi) != 1) { return Err(KM_ERR_COMPUTATION_ERROR); }
    return Ok(phi);
}

# The Peng–Robinson fugacity f = φ × P in Pa, with φ from fugacity_coefficient_pr (vapour root).
# Ok(f), or that function's errors. Mirrors `gas::fugacity_pr`.
#must_use
fn fugacity_pr(params: KmPengRobinsonParams, temperature_k: f64, pressure_pa: f64): Result {
    var t, v = fugacity_coefficient_pr(params, temperature_k, pressure_pa);
    if (is_ok(t) != 1) { return Err(v); }
    var phi: f64 = v;
    var f: f64 = phi * pressure_pa;
    return Ok(f);
}

# ── Redlich–Kwong ───────────────────────────────────────────────────────────────────

# Redlich–Kwong pressure P = RT/(V − b) − a/(T^½ × V(V + b)) in Pa, from the critical temperature
# Tc (K) and pressure Pc (Pa), T in K and the molar volume V in m³/mol. Ok(P),
# Err(KM_ERR_INVALID_TEMPERATURE) if T or Tc is not positive and finite, or
# Err(KM_ERR_INVALID_INPUT) if Pc is not positive and finite or V is non-finite or not greater
# than b. Mirrors `gas::redlich_kwong_pressure`.
#must_use
fn redlich_kwong_pressure(tc: f64, pc: f64, temperature_k: f64, molar_volume: f64): Result {
    if (_km_is_positive(temperature_k) != 1) { return Err(KM_ERR_INVALID_TEMPERATURE); }
    if (_km_is_positive(tc) != 1) { return Err(KM_ERR_INVALID_TEMPERATURE); }
    if (_km_is_positive(pc) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    var tc25: f64 = _km_cr_pow(tc, 2.5);
    var a: f64 = (((0.42748 * KM_GAS_CONSTANT) * KM_GAS_CONSTANT) * tc25) / pc;
    var b: f64 = ((0.08664 * KM_GAS_CONSTANT) * tc) / pc;
    if (_km_is_finite(molar_volume) != 1 || molar_volume <= b) { return Err(KM_ERR_INVALID_INPUT); }
    var v: f64 = molar_volume;
    var term1: f64 = (KM_GAS_CONSTANT * temperature_k) / (v - b);
    var st: f64 = f64_sqrt(temperature_k);
    var term2: f64 = a / ((st * v) * (v + b));
    var p: f64 = term1 - term2;
    return Ok(p);
}

# Joule–Thomson coefficient of an ideal gas: always 0.0 K/Pa. A real gas's needs the derivatives of
# an equation of state (Peng–Robinson). Mirrors `gas::joule_thomson_ideal`.
#must_use
fn joule_thomson_ideal(): f64 {
    return 0.0;
}
