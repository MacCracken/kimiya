# Molecular geometry predicted by VSEPR theory.
enum KmGeometry {
    # Linear (180°): 2 bonding groups with 0 or 3 lone pairs (CO₂, XeF₂), or a diatomic.
    KM_GEOMETRY_LINEAR = 0;
    # Bent with 2 lone pairs (~104.5°): 2 bonding groups + 2 lone pairs (H₂O).
    KM_GEOMETRY_BENT_TWO_LONE_PAIRS = 1;
    # Bent with 1 lone pair (<120°): 2 bonding groups + 1 lone pair (SO₂).
    KM_GEOMETRY_BENT_ONE_LONE_PAIR = 2;
    # Trigonal planar (120°): 3 bonding groups, no lone pairs (BF₃).
    KM_GEOMETRY_TRIGONAL_PLANAR = 3;
    # Trigonal pyramidal (~107°): 3 bonding groups + 1 lone pair (NH₃).
    KM_GEOMETRY_TRIGONAL_PYRAMIDAL = 4;
    # Tetrahedral (109.5°): 4 bonding groups, no lone pairs (CH₄).
    KM_GEOMETRY_TETRAHEDRAL = 5;
    # Seesaw: 4 bonding groups + 1 lone pair (SF₄).
    KM_GEOMETRY_SEESAW_SHAPED = 6;
    # T-shaped (90°): 3 bonding groups + **2** lone pairs (ClF₃). The
    # variant name is a misnomer — there are two lone pairs, not three.
    # Rust: `Geometry::TShapedThreeLonePairs`, renamed by ADR 0002 #6 (docs/adr/0002-port-api-divergences.md).
    KM_GEOMETRY_T_SHAPED = 7;
    # Trigonal bipyramidal (120° equatorial, 90° axial): 5 bonding groups (PCl₅).
    KM_GEOMETRY_TRIGONAL_BIPYRAMIDAL = 8;
    # Square planar (90°): 4 bonding groups + 2 lone pairs (XeF₄).
    KM_GEOMETRY_SQUARE_PLANAR = 9;
    # Square pyramidal (~90°): 5 bonding groups + 1 lone pair (BrF₅).
    KM_GEOMETRY_SQUARE_PYRAMIDAL = 10;
    # Octahedral (90°): 6 bonding groups, no lone pairs (SF₆).
    KM_GEOMETRY_OCTAHEDRAL = 11;
}
const KM_GEOMETRY_COUNT = 12;

# Ideal bond angle in degrees (where applicable; equatorial angle for
# the trigonal-bipyramidal family).
# Indexed by KmGeometry value; mirrors `Geometry::ideal_bond_angle`.
var KM_GEOMETRY_IDEAL_BOND_ANGLE: f64[12] = {
    180.0,  # Linear
    104.5,  # BentTwoLonePairs
    117.0,  # BentOneLonePair: ~117° due to lone pair compression
    120.0,  # TrigonalPlanar
    107.0,  # TrigonalPyramidal
    109.5,  # Tetrahedral
    120.0,  # SeesawShaped: equatorial
    90.0,  # TShapedThreeLonePairs
    120.0,  # TrigonalBipyramidal: equatorial
    90.0,  # SquarePlanar
    90.0,  # SquarePyramidal
    90.0,  # Octahedral
};

# Common organic functional groups.
enum KmFunctionalGroup {
    # Alkane: saturated C–C/C–H framework (sp³).
    KM_FUNCTIONAL_GROUP_ALKANE = 0;
    # Alkene: C=C double bond (sp²).
    KM_FUNCTIONAL_GROUP_ALKENE = 1;
    # Alkyne: C≡C triple bond (sp).
    KM_FUNCTIONAL_GROUP_ALKYNE = 2;
    # Alcohol: –OH on an sp³ carbon.
    KM_FUNCTIONAL_GROUP_ALCOHOL = 3;
    # Aldehyde: terminal carbonyl, –CHO.
    KM_FUNCTIONAL_GROUP_ALDEHYDE = 4;
    # Ketone: internal carbonyl, C(=O)C.
    KM_FUNCTIONAL_GROUP_KETONE = 5;
    # Carboxylic acid: –COOH.
    KM_FUNCTIONAL_GROUP_CARBOXYLIC_ACID = 6;
    # Ester: –COO–R.
    KM_FUNCTIONAL_GROUP_ESTER = 7;
    # Ether: C–O–C.
    KM_FUNCTIONAL_GROUP_ETHER = 8;
    # Amine: primary, secondary or tertiary (–NH₂ / –NHR / –NR₂).
    KM_FUNCTIONAL_GROUP_AMINE = 9;
    # Amide: –CONH₂ (and N-substituted).
    KM_FUNCTIONAL_GROUP_AMIDE = 10;
    # Nitrile: –C≡N.
    KM_FUNCTIONAL_GROUP_NITRILE = 11;
    # Thiol: –SH.
    KM_FUNCTIONAL_GROUP_THIOL = 12;
    # Alkyl/aryl halide: –X (F, Cl, Br, I).
    KM_FUNCTIONAL_GROUP_HALIDE = 13;
    # Phenol: –OH on an aromatic ring.
    KM_FUNCTIONAL_GROUP_PHENOL = 14;
    # Aromatic ring: phenyl, C₆H₅–.
    KM_FUNCTIONAL_GROUP_AROMATIC_RING = 15;
}
const KM_FUNCTIONAL_GROUP_COUNT = 16;

