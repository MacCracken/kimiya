# GENERATED by scripts/oracle from kimiya 1.2.0 (rust-old/), hisab 1.4.0. Do not edit.
# Regenerate: cargo run --release --locked --manifest-path scripts/oracle/Cargo.toml
#
# KmLigand follows the Rust declaration order and is append-only; KM_LIGAND_FIELD_STRENGTH is indexed by
# its value. The d-electron tables are indexed by n = 0 ..= 10. IONIC_RADII rows are in Rust's order; a
# handle (src/inorganic.cyr) is row + 1, and 0 is None. f64 cells are the oracle's values as round-trip
# decimals; tests/golden/inorganic.tsv pins every cell (the tables through cfse_octahedral,
# unpaired_electrons_oct and the `inorganic::IONIC_RADII[]` rows) and tests/golden/constants.tsv the
# Madelung constants and Born exponents.

# Spectrochemical series — common ligands, ordered from weakest to
# strongest field.
#
# [`Ligand::field_strength`] gives a dimensionless ordinal rank (1–12), not
# a Δ_oct value; only the ordering is meaningful.
enum KmLigand {
    # I⁻ — weakest-field ligand in this list.
    KM_LIGAND_IODIDE = 0;
    # Br⁻.
    KM_LIGAND_BROMIDE = 1;
    # Cl⁻.
    KM_LIGAND_CHLORIDE = 2;
    # F⁻.
    KM_LIGAND_FLUORIDE = 3;
    # OH⁻.
    KM_LIGAND_HYDROXIDE = 4;
    # H₂O.
    KM_LIGAND_WATER = 5;
    # NH₃ — intermediate/borderline field strength.
    KM_LIGAND_AMMONIA = 6;
    # Ethylenediamine (en), bidentate.
    KM_LIGAND_ETHYLENEDIAMINE = 7;
    # NO₂⁻ (N-bound nitro).
    KM_LIGAND_NITRITE = 8;
    # CN⁻.
    KM_LIGAND_CYANIDE = 9;
    # CO — strongest-field ligand in this list.
    KM_LIGAND_CARBON_MONOXIDE = 10;
}
const KM_LIGAND_COUNT = 11;

# Relative field strength as an ordinal rank 1–12 (dimensionless;
