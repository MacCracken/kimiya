# --- phase.cyr ---

# phase.cyr — phase equilibria: Raoult's law, Henry's law, colligative properties,
# Clausius–Clapeyron, the Antoine equation and the Gibbs phase rule (port of rust-old/src/phase.rs).
#
# Fallible functions return a value-form Result whose Err payload is a KM_ERR_* code, and reject NaN
# and ±∞ inputs. Every expression keeps Rust's operation order, so the arithmetic functions are
# bit-identical (class B); clausius_clapeyron (one exp, _km_cr_exp) and the Antoine functions (one
# 10^x, _km_cr_exp10) are class C on src/mathx.cyr's correctly rounded primitives (ADR 0006), so
# they are compared exactly against the corrected oracle (docs/development/port-parity.md §10). The
# data — struct KmAntoineCoeffs, the 8 ANTOINE_DATA sets, the mmHg → Pa factor and the KM_KB_* /
# KM_KF_* constants — is src/phase_data.cyr (generated).
#
# ADR 0002 #4 (the one API change here): antoine_pressure_mmhg / antoine_pressure_pa return a
# Result, Err outside the coefficient set's fitted range t_min_c ..= t_max_c, at or below the pole
# (C + T ≤ 0) and for any non-finite input, where Rust 1.2 extrapolates silently or returns NaN.
# There is no extrapolating variant. In range the value is Rust's, operation for operation.
#
# ANTOINE_DATA rows are reached by handle (port plan §6.4): row + 1, and 0 for None.
# antoine_data_name(h) and antoine_data_coeffs(h) read row h − 1; an invalid handle gives "" and a
# set of NaN fields (which antoine_pressure_* reject).

include "lib/string.cyr"

# 1 if 0 ≤ x ≤ 1 (Rust's `(0.0..=1.0).contains(&x)`, false for NaN).
#must_use
fn _km_in_unit_interval(x: f64): i64 {
    if (x >= 0.0 && x <= 1.0) { return 1; }
    return 0;
}

# ── Raoult's law ────────────────────────────────────────────────────────────────────

# Raoult's law P = x × P°: the partial vapour pressure of a component of an ideal solution, from its
# mole fraction x (0 to 1) and the pure component's vapour pressure P° (Pa, or any unit, which the
# result keeps). Ok(P), or Err(KM_ERR_INVALID_INPUT) if x is not in [0, 1] or P° is negative or
# non-finite (NaN included). Mirrors `phase::raoult_pressure`.
#must_use
fn raoult_pressure(mole_fraction: f64, pure_vapor_pressure: f64): Result {
    if (_km_in_unit_interval(mole_fraction) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    if (_km_is_non_negative(pure_vapor_pressure) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    var p: f64 = mole_fraction * pure_vapor_pressure;
    return Ok(p);
}

# Total vapour pressure over a binary ideal solution, P = x_A × P°_A + (1 − x_A) × P°_B, in the
# pressures' (consistent) unit. Ok(P), or Err(KM_ERR_INVALID_INPUT) if x_A is not in [0, 1] or
# either pure-component pressure is negative or non-finite. Mirrors `phase::raoult_total_binary`.
#must_use
fn raoult_total_binary(x_a: f64, p_pure_a: f64, p_pure_b: f64): Result {
    if (_km_in_unit_interval(x_a) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    if (_km_is_non_negative(p_pure_a) != 1 || _km_is_non_negative(p_pure_b) != 1) {
        return Err(KM_ERR_INVALID_INPUT);
    }
    var p: f64 = (x_a * p_pure_a) + ((1.0 - x_a) * p_pure_b);
    return Ok(p);
}

# ── Henry's law ─────────────────────────────────────────────────────────────────────

# Henry's law P = K_H × x: the dissolved gas's partial pressure from Henry's constant K_H (Pa, or the
# output's unit) and its mole fraction x (0 to 1). Ok(P), or Err(KM_ERR_INVALID_INPUT) if K_H is not
# positive and finite or x is not in [0, 1] (NaN included). Mirrors `phase::henry_pressure`.
#must_use
fn henry_pressure(henry_constant: f64, mole_fraction: f64): Result {
    if (_km_is_positive(henry_constant) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    if (_km_in_unit_interval(mole_fraction) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    var p: f64 = henry_constant * mole_fraction;
    return Ok(p);
}

# A gas's solubility (mole fraction) from Henry's law, x = P / K_H, with P and K_H in the same
# pressure unit. Henry's law is a dilute-solution limit; results near 1 are outside its range.
# Ok(x), or Err(KM_ERR_INVALID_INPUT) if K_H is not positive and finite or P is negative or
# non-finite. Mirrors `phase::henry_solubility`.
#must_use
fn henry_solubility(partial_pressure: f64, henry_constant: f64): Result {
    if (_km_is_positive(henry_constant) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    if (_km_is_non_negative(partial_pressure) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    var x: f64 = partial_pressure / henry_constant;
    return Ok(x);
}

# ── colligative properties ──────────────────────────────────────────────────────────

# Boiling point elevation ΔT_b = K_b × m × i in K, from the ebullioscopic constant K_b (K·kg/mol,
# e.g. KM_KB_WATER), the molality m (mol solute / kg solvent) and the van 't Hoff factor i (1 for
# non-electrolytes). Mirrors `phase::boiling_point_elevation`.
#must_use
fn boiling_point_elevation(kb: f64, molality: f64, van_t_hoff_factor: f64): f64 {
    var dt: f64 = (kb * molality) * van_t_hoff_factor;
    return dt;
}

# Freezing point depression ΔT_f = K_f × m × i, the (positive) depression in K, from the cryoscopic
# constant K_f (K·kg/mol, e.g. KM_KF_WATER), the molality m and the van 't Hoff factor i. Mirrors
# `phase::freezing_point_depression`.
#must_use
fn freezing_point_depression(kf: f64, molality: f64, van_t_hoff_factor: f64): f64 {
    var dt: f64 = (kf * molality) * van_t_hoff_factor;
    return dt;
}

# Osmotic pressure π = i × M × R × T in Pa, from the van 't Hoff factor i, the molarity M (mol/L)
# and T in K (R in L·Pa/(mol·K) is KM_GAS_CONSTANT × 1000). Ok(π),
# Err(KM_ERR_INVALID_TEMPERATURE) if T is not positive and finite, or Err(KM_ERR_INVALID_INPUT) if
# i is not positive and finite or M is negative or non-finite. Mirrors `phase::osmotic_pressure`.
#must_use
fn osmotic_pressure(van_t_hoff_factor: f64, molarity: f64, temperature_k: f64): Result {
    if (_km_is_positive(temperature_k) != 1) { return Err(KM_ERR_INVALID_TEMPERATURE); }
    if (_km_is_positive(van_t_hoff_factor) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    if (_km_is_non_negative(molarity) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    var p: f64 = (((van_t_hoff_factor * molarity) * KM_GAS_CONSTANT) * 1000.0) * temperature_k;
    return Ok(p);
}

# ── Clausius–Clapeyron ──────────────────────────────────────────────────────────────

# The Clausius–Clapeyron equation ln(P₂/P₁) = −(ΔH_vap/R)(1/T₂ − 1/T₁): the vapour pressure P₂ at
# T₂ (K), in p1's unit, from P₁ at T₁ (K) and the enthalpy of vaporization ΔH_vap (J/mol). Ok(P₂),
# Err(KM_ERR_INVALID_INPUT) if P₁ is not positive and finite or ΔH_vap is not finite, or
# Err(KM_ERR_INVALID_TEMPERATURE) if either temperature is not positive and finite. Mirrors
# `phase::clausius_clapeyron`.
#must_use
fn clausius_clapeyron(p1: f64, t1_k: f64, t2_k: f64, delta_h_vap_j: f64): Result {
    if (_km_is_positive(p1) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    if (_km_is_positive(t1_k) != 1 || _km_is_positive(t2_k) != 1) {
        return Err(KM_ERR_INVALID_TEMPERATURE);
    }
    if (_km_is_finite(delta_h_vap_j) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    var h: f64 = delta_h_vap_j / KM_GAS_CONSTANT;
    var exponent: f64 = -h * ((1.0 / t2_k) - (1.0 / t1_k));
    var e: f64 = _km_cr_exp(exponent);
    var p2: f64 = p1 * e;
    return Ok(p2);
}

# ── Antoine equation ────────────────────────────────────────────────────────────────

# Vapour pressure from the Antoine equation, log₁₀(P) = A − B/(C + T), in mmHg, from a coefficient
# set (struct KmAntoineCoeffs: a built-in one from antoine_data_coeffs, or your own) and T in °C.
# Ok(P); Err(KM_ERR_INVALID_INPUT) if A, B, C, t_min_c or t_max_c is not finite;
# Err(KM_ERR_INVALID_TEMPERATURE) if T is outside t_min_c ..= t_max_c (NaN included) or at or below
# the pole, C + T ≤ 0. In range, P is Rust's 10^(A − B/(C + T)), which overflows to +∞ for an
# exponent past 308.25 (no built-in set comes near). Mirrors `phase::antoine_pressure_mmhg`, with
# ADR 0002 #4's Result.
#must_use
fn antoine_pressure_mmhg(coeffs: KmAntoineCoeffs, temperature_c: f64): Result {
    var a: f64 = coeffs.a;
    var b: f64 = coeffs.b;
    var c: f64 = coeffs.c;
    var lo: f64 = coeffs.t_min_c;
    var hi: f64 = coeffs.t_max_c;
    if (_km_is_finite(a) != 1 || _km_is_finite(b) != 1 || _km_is_finite(c) != 1) {
        return Err(KM_ERR_INVALID_INPUT);
    }
    if (_km_is_finite(lo) != 1 || _km_is_finite(hi) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    if (temperature_c >= lo && temperature_c <= hi) {
        var denom: f64 = c + temperature_c;
        if (_km_is_positive(denom) != 1) { return Err(KM_ERR_INVALID_TEMPERATURE); }
        var x: f64 = a - (b / denom);
        var p: f64 = _km_cr_exp10(x);
        return Ok(p);
    }
    return Err(KM_ERR_INVALID_TEMPERATURE);
}

# Vapour pressure from the Antoine equation in Pa: antoine_pressure_mmhg's value (and its Err
# cases) × 133.322 387 415 Pa/mmHg (_KM_PA_PER_MMHG). Mirrors `phase::antoine_pressure_pa`, with
# ADR 0002 #4's Result.
#must_use
fn antoine_pressure_pa(coeffs: KmAntoineCoeffs, temperature_c: f64): Result {
    var t, v = antoine_pressure_mmhg(coeffs, temperature_c);
    if (is_ok(t) != 1) { return Err(v); }
    var mmhg: f64 = v;
    var pa: f64 = mmhg * _KM_PA_PER_MMHG;
    return Ok(pa);
}

# The ANTOINE_DATA row of handle h (h − 1), or -1 if h is no handle.
#must_use
fn _km_antoine_row(h): i64 {
    if (h >= 1 && h <= KM_ANTOINE_COUNT) { return h - 1; }
    return 0 - 1;
}

# The built-in Antoine coefficients (P in mmHg, T in °C) of the solvent named by the C string
# `name`, exactly and case-sensitively ("water", "diethyl_ether"), as a handle (its ANTOINE_DATA
# row + 1); 0 when none matches (or `name` is 0). Mirrors `phase::lookup_antoine`.
#must_use
fn lookup_antoine(name): i64 {
    if (name == 0) { return 0; }
    var row = 0;
    while (row < KM_ANTOINE_COUNT) {
        if (streq(&_KM_ANTOINE_NAME_BYTES + _KM_ANTOINE_NAME_OFF[row], name) == 1) { return row + 1; }
        row = row + 1;
    }
    return 0;
}

# The solvent name of ANTOINE_DATA handle h ("water") as a C string in the baked table; "" for an
# invalid handle. With antoine_data_coeffs and KM_ANTOINE_COUNT, this mirrors iterating
# `phase::ANTOINE_DATA`.
#must_use
fn antoine_data_name(h): i64 {
    var row = _km_antoine_row(h);
    if (row < 0) { return ""; }
    return &_KM_ANTOINE_NAME_BYTES + _KM_ANTOINE_NAME_OFF[row];
}

# The coefficient set of ANTOINE_DATA handle h, by value; every field NaN for an invalid handle (so
# antoine_pressure_* give Err(KM_ERR_INVALID_INPUT)). Mirrors `phase::ANTOINE_DATA[h − 1].1`.
#must_use
fn antoine_data_coeffs(h): KmAntoineCoeffs {
    var c: KmAntoineCoeffs;
    var row = _km_antoine_row(h);
    if (row < 0) {
        var n: f64 = _km_nan();
        c.a = n;
        c.b = n;
        c.c = n;
        c.t_min_c = n;
        c.t_max_c = n;
        return c;
    }
    c.a = KM_ANTOINE_A[row];
    c.b = KM_ANTOINE_B[row];
    c.c = KM_ANTOINE_C[row];
    c.t_min_c = KM_ANTOINE_T_MIN_C[row];
    c.t_max_c = KM_ANTOINE_T_MAX_C[row];
    return c;
}

# ── Gibbs phase rule ────────────────────────────────────────────────────────────────

# The Gibbs phase rule F = C − P + 2: the degrees of freedom of a system of `components`
# independent components in `phases` phases, both Rust u32s (0 ..= 4294967295). Ok(F), or
# Err(KM_ERR_INVALID_INPUT) if phases is 0, phases > components + 2 (F would be negative), F does
# not fit a u32 (components = u32::MAX with one phase), or either count is outside the u32 range
# (Rust can't be given one; here it is refused, never wrapped). Mirrors `phase::phase_rule`.
#must_use
fn phase_rule(components, phases): Result {
    if (components < 0 || components > 0xFFFFFFFF || phases < 0 || phases > 0xFFFFFFFF) {
        return Err(KM_ERR_INVALID_INPUT);
    }
    if (phases == 0) { return Err(KM_ERR_INVALID_INPUT); }
    var f = (components - phases) + 2;     # |C − P + 2| ≤ 2³² + 1: no i64 overflow
    if (f < 0) { return Err(KM_ERR_INVALID_INPUT); }
    if (f > 0xFFFFFFFF) { return Err(KM_ERR_INVALID_INPUT); }
    return Ok(f);
}

# --- gas_data.cyr ---

# kimiya — gas data: STP and the Peng–Robinson parameters of five gases
#
# GENERATED by scripts/oracle from kimiya 1.2.0 (rust-old/), hisab 1.4.0. Do not edit.
# Regenerate: cargo run --release --locked --manifest-path scripts/oracle/Cargo.toml
#
# f64 values are the oracle's as round-trip decimals; tests/golden/constants.tsv pins the
# STP constants and tests/golden/gas.tsv every preset field (`gas::PR_*` rows).

# Standard temperature for [`STP_PRESSURE`]: 273.15 K (0 °C).
# Rust: kimiya::gas::STP_TEMPERATURE
const KM_STP_TEMPERATURE = 273.15;

# "Standard pressure" of the traditional STP convention: 1 atm = 101 325 Pa.
#
# This is the pre-1982 convention (with [`STP_TEMPERATURE`] it gives the
# familiar 22.414 L/mol ideal-gas molar volume). IUPAC has defined STP as
# 273.15 K and 100 kPa (1 bar) since 1982, which gives 22.711 L/mol; the
# 1 atm value is kept here for compatibility.
# Rust: kimiya::gas::STP_PRESSURE
const KM_STP_PRESSURE = 101325.0;

# Peng-Robinson EOS parameters for a substance.
#
# The α(T) function uses the original 1976 κ polynomial,
# κ = 0.37464 + 1.54226ω − 0.26992ω², which was fitted for
# ω ≤ 0.49. Heavier components (ω > 0.49) are accepted but are less
# accurate; the 1978 cubic κ(ω) correlation is not implemented.
struct KmPengRobinsonParams {
    # Critical temperature Tc (K). Must be positive and finite.
    tc: f64;
    # Critical pressure Pc (Pa). Must be positive and finite.
    pc: f64;
    # Acentric factor ω (dimensionless). Must be finite; the κ polynomial
    # is valid for ω ≤ 0.49.
    omega: f64;
}

# Water (H₂O): Tc = 647.1 K, Pc = 22.064 MPa, ω = 0.3443.
# Rust: kimiya::gas::PR_WATER
var KM_PR_WATER = KmPengRobinsonParams { tc: 647.1, pc: 22064000.0, omega: 0.3443 };

# Nitrogen (N₂): Tc = 126.2 K, Pc = 3.394 MPa, ω = 0.0377.
# Rust: kimiya::gas::PR_NITROGEN
var KM_PR_NITROGEN = KmPengRobinsonParams { tc: 126.2, pc: 3394000.0, omega: 0.0377 };

# Oxygen (O₂): Tc = 154.6 K, Pc = 5.043 MPa, ω = 0.0222.
# Rust: kimiya::gas::PR_OXYGEN
var KM_PR_OXYGEN = KmPengRobinsonParams { tc: 154.6, pc: 5043000.0, omega: 0.0222 };

# Carbon dioxide (CO₂): Tc = 304.1 K, Pc = 7.375 MPa, ω = 0.2236.
# Rust: kimiya::gas::PR_CO2
var KM_PR_CO2 = KmPengRobinsonParams { tc: 304.1, pc: 7375000.0, omega: 0.2236 };

# Methane (CH₄): Tc = 190.6 K, Pc = 4.599 MPa, ω = 0.0115.
# Rust: kimiya::gas::PR_METHANE
var KM_PR_METHANE = KmPengRobinsonParams { tc: 190.6, pc: 4599000.0, omega: 0.0115 };

# --- gas.cyr ---

# gas.cyr — gas laws: ideal gas, van der Waals, Peng–Robinson and Redlich–Kwong equations of
# state, Dalton's law, gas density and Peng–Robinson fugacity (port of rust-old/src/gas.rs).
#
# SI throughout: pressure in Pa, temperature in K, volume in m³ (molar volume in m³/mol), amount
# in mol. Fallible functions return a value-form Result whose Err payload is a KM_ERR_* code, and
# reject NaN and ±∞ inputs instead of returning Ok(NaN). The data — struct KmPengRobinsonParams,
# the KM_PR_* presets and KM_STP_* — is src/gas_data.cyr (generated).
#
# Every expression keeps Rust's operation order, constant by constant, including the private
# helpers (pr_coefficients, pr_dimensionless, pr_physical_roots, cubic_real_roots), which are
# transcribed as _km_* functions. The cubic is Rust's analytic solver: the trigonometric form when
# there are three real roots (acos, cos), Cardano's in the cancellation-free form of Numerical
# Recipes §5.6 otherwise (cbrt and sqrt, both correctly rounded on both sides), then two guarded
# Newton steps per root.
# - Rust's PengRobinsonParams is passed by value, as a KmPengRobinsonParams; a preset is the global
#   KM_PR_WATER, … (port plan §6.4).
# - peng_robinson_z_roots's Vec<f64> of 1–3 roots becomes a caller's buffer of three f64 (24
#   bytes), `var roots[24];`: the call returns Ok(n) with the n ascending roots in roots[0 .. n − 1].
# - Every transcendental is correctly rounded (ADR 0006): acos and cos are src/mathx.cyr's two-phase _km_cr_acos and
#   _km_cr_cos (M4a; M4d replaced ADR 0005's double-double _km_acos and _km_cos, which gave the same bits on every
#   golden argument), ln, exp and x^2.5 its _km_cr_ln, _km_cr_exp and _km_cr_pow(x, 2.5), so the class-C
#   rows are compared exactly against the corrected oracle (docs/development/port-parity.md §10). cbrt is
#   ganita_f64_cbrt, correctly rounded as the oracle's (Rust's compiler-builtins) is on every golden argument;
#   f64_clamp is lib/math.cyr's.

include "lib/math.cyr"
include "lib/ganita.cyr"

# Peng–Robinson validation of the critical constants (Rust's validate_pr_params): KM_ERR_NONE, or
# the error code (NaN and ±∞ rejected).
#must_use
fn _km_pr_validate(params: KmPengRobinsonParams): i64 {
    var tc: f64 = params.tc;
    var pc: f64 = params.pc;
    var omega: f64 = params.omega;
    if (_km_is_positive(tc) != 1) { return KM_ERR_INVALID_TEMPERATURE; }
    if (_km_is_positive(pc) != 1) { return KM_ERR_INVALID_INPUT; }
    if (_km_is_finite(omega) != 1) { return KM_ERR_INVALID_INPUT; }
    return KM_ERR_NONE;
}

# Peng–Robinson a·α(T) (Pa·m⁶/mol²) and b (m³/mol) from the critical constants, with the original
# 1976 κ(ω) polynomial (fitted for ω ≤ 0.49). The caller has run _km_pr_validate. Rust's
# pr_coefficients.
#must_use
fn _km_pr_coefficients(params: KmPengRobinsonParams, temperature_k: f64): (f64, f64) {
    var tc: f64 = params.tc;
    var pc: f64 = params.pc;
    var omega: f64 = params.omega;
    var a: f64 = ((((0.45724 * KM_GAS_CONSTANT) * KM_GAS_CONSTANT) * tc) * tc) / pc;
    var b: f64 = ((0.07780 * KM_GAS_CONSTANT) * tc) / pc;
    var kappa: f64 = (0.37464 + (1.54226 * omega)) - ((0.26992 * omega) * omega);
    var tr: f64 = temperature_k / tc;
    var sq: f64 = f64_sqrt(tr);
    var u: f64 = 1.0 + (kappa * (1.0 - sq));
    var alpha: f64 = _km_powi(u, 2);
    var a_alpha: f64 = a * alpha;
    return (a_alpha, b);
}

# The validated, dimensionless Peng–Robinson parameters A = a·α·P/(RT)² and B = bP/(RT): (code,
# A, B), the code KM_ERR_NONE or the error (the Rust order of checks: T, P, then the critical
# constants). Rust's pr_dimensionless.
#must_use
fn _km_pr_dimensionless(params: KmPengRobinsonParams, temperature_k: f64, pressure_pa: f64): (i64, f64, f64) {
    if (_km_is_positive(temperature_k) != 1) { return (KM_ERR_INVALID_TEMPERATURE, 0.0, 0.0); }
    if (_km_is_positive(pressure_pa) != 1) { return (KM_ERR_INVALID_INPUT, 0.0, 0.0); }
    var e = _km_pr_validate(params);
    if (e != KM_ERR_NONE) { return (e, 0.0, 0.0); }
    var a_alpha, b = _km_pr_coefficients(params, temperature_k);
    var rt: f64 = KM_GAS_CONSTANT * temperature_k;
    var cap_a: f64 = (a_alpha * pressure_pa) / (rt * rt);
    var cap_b: f64 = (b * pressure_pa) / rt;
    return (KM_ERR_NONE, cap_a, cap_b);
}

# The cubic z³ + c2·z² + c1·z + c0 at z, Horner's form as Rust's `poly` closure.
#must_use
fn _km_cubic_poly(z: f64, c2: f64, c1: f64, c0: f64): f64 {
    var p: f64 = ((((z + c2) * z) + c1) * z) + c0;
    return p;
}

# Up to two Newton steps on the cubic from z, each kept only if it lowers |poly| (Rust's guarded
# polish); stops at a zero value or a zero derivative.
#must_use
fn _km_cubic_polish(z0: f64, c2: f64, c1: f64, c0: f64): f64 {
    var z: f64 = z0;
    var it = 0;
    while (it < 2) {
        var f: f64 = _km_cubic_poly(z, c2, c1, c0);
        var df: f64 = (((3.0 * z) + (2.0 * c2)) * z) + c1;
        if (f == 0.0 || df == 0.0) { break; }
        var next: f64 = z - (f / df);
        var fnext: f64 = _km_cubic_poly(next, c2, c1, c0);
        var an: f64 = f64_abs(fnext);
        var af: f64 = f64_abs(f);
        if (an < af) { z = next; } else { break; }
        it = it + 1;
    }
    return z;
}

# Real roots of z³ + c2·z² + c1·z + c0 = 0, ascending, into `out` (three f64, 24 bytes); returns
# how many (1 or 3). The trigonometric form when there are three real roots (the discriminant
# within the 10⁻¹² relative degeneracy tolerance, so a double root lost to rounding is still
# reported), Cardano's formula otherwise, then each root polished by _km_cubic_polish. Rust's
# cubic_real_roots, operation for operation.
fn _km_cubic_real_roots(c2: f64, c1: f64, c0: f64, out): i64 {
    var shift: f64 = c2 / 3.0;
    var q: f64 = ((c2 * c2) - (3.0 * c1)) / 9.0;
    var r: f64 = ((c2 * (((2.0 * c2) * c2) - (9.0 * c1))) + (27.0 * c0)) / 54.0;
    var q3: f64 = (q * q) * q;
    var r2: f64 = r * r;
    var tol: f64 = 1.0 + 0.000000000001;   # 1.0 + CUBIC_DEGENERACY_TOL, folded in Rust
    var z0: f64 = 0.0;
    var z1: f64 = 0.0;
    var z2: f64 = 0.0;
    var n = 1;
    if (q > 0.0 && r2 <= (q3 * tol)) {
        # Three real roots (possibly coincident). Clamp: rounding can push |r|/√q³ slightly
        # above 1 near a double root.
        var sqrt_q: f64 = f64_sqrt(q);
        var ratio: f64 = r / (sqrt_q * q);
        var cl: f64 = f64_clamp(ratio, -1.0, 1.0);
        var theta: f64 = _km_cr_acos(cl);
        var m: f64 = -2.0 * sqrt_q;
        var tau: f64 = 0x401921FB54442D18;  # std::f64::consts::TAU
        var k0: f64 = _km_cr_cos(theta / 3.0);
        var k1: f64 = _km_cr_cos((theta - tau) / 3.0);
        var k2: f64 = _km_cr_cos((theta + tau) / 3.0);
        z0 = (m * k0) - shift;
        z1 = (m * k1) - shift;
        z2 = (m * k2) - shift;
        n = 3;
    } else {
        # One real root.
        var sg: f64 = _km_signum(r);
        var d: f64 = _km_max(r2 - q3, 0.0);
        var sd: f64 = f64_sqrt(d);
        var ar: f64 = f64_abs(r);
        var cb: f64 = ganita_f64_cbrt(ar + sd);
        var big_a: f64 = -sg * cb;
        var big_b: f64 = 0.0;
        if (big_a != 0.0) { big_b = q / big_a; }
        z0 = (big_a + big_b) - shift;
    }
    z0 = _km_cubic_polish(z0, c2, c1, c0);
    if (n == 3) {
        z1 = _km_cubic_polish(z1, c2, c1, c0);
        z2 = _km_cubic_polish(z2, c2, c1, c0);
        # Already ascending by construction; re-sort in case polishing swapped two nearly
        # coincident roots (Rust's three compare-and-swaps).
        var t: f64 = 0.0;
        if (z0 > z1) { t = z0; z0 = z1; z1 = t; }
        if (z1 > z2) { t = z1; z1 = z2; z2 = t; }
        if (z0 > z1) { t = z0; z0 = z1; z1 = t; }
    }
    store64(out, z0);
    store64(out + 8, z1);
    store64(out + 16, z2);
    return n;
}

# The roots of the Peng–Robinson Z-cubic Z³ − (1−B)Z² + (A−3B²−2B)Z − (AB−B²−B³) = 0 with Z > B
# and finite, ascending, into `out` (three f64); returns how many (0–3). Rust's pr_physical_roots.
fn _km_pr_physical_roots(cap_a: f64, cap_b: f64, out): i64 {
    var c2: f64 = cap_b - 1.0;
    var c1: f64 = (cap_a - ((3.0 * cap_b) * cap_b)) - (2.0 * cap_b);
    var c0: f64 = -(((cap_a * cap_b) - (cap_b * cap_b)) - ((cap_b * cap_b) * cap_b));
    var all[24];
    var n_real = _km_cubic_real_roots(c2, c1, c0, &all);
    var n = 0;
    var k = 0;
    while (k < n_real) {
        var z: f64 = load64(&all + k * 8);
        if (_km_is_finite(z) == 1 && z > cap_b) {
            store64(out + n * 8, z);
            n = n + 1;
        }
        k = k + 1;
    }
    return n;
}

# ── ideal gas, van der Waals, Dalton, density ───────────────────────────────────────

# Ideal gas law P = nRT/V in Pa, from n in mol, T in K and V in m³. Ok(P),
# Err(KM_ERR_INVALID_INPUT) if n is not finite or V is not positive and finite, or
# Err(KM_ERR_INVALID_TEMPERATURE) if T is not positive and finite. Mirrors `gas::ideal_gas_pressure`.
#must_use
fn ideal_gas_pressure(moles: f64, temperature_k: f64, volume_m3: f64): Result {
    if (_km_is_finite(moles) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    if (_km_is_positive(temperature_k) != 1) { return Err(KM_ERR_INVALID_TEMPERATURE); }
    if (_km_is_positive(volume_m3) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    var p: f64 = ((moles * KM_GAS_CONSTANT) * temperature_k) / volume_m3;
    return Ok(p);
}

# Ideal gas law V = nRT/P in m³, from n in mol, T in K and P in Pa. Ok(V),
# Err(KM_ERR_INVALID_INPUT) if n is not finite or P is not positive and finite, or
# Err(KM_ERR_INVALID_TEMPERATURE) if T is not positive and finite. Mirrors `gas::ideal_gas_volume`.
#must_use
fn ideal_gas_volume(moles: f64, temperature_k: f64, pressure_pa: f64): Result {
    if (_km_is_finite(moles) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    if (_km_is_positive(temperature_k) != 1) { return Err(KM_ERR_INVALID_TEMPERATURE); }
    if (_km_is_positive(pressure_pa) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    var v: f64 = ((moles * KM_GAS_CONSTANT) * temperature_k) / pressure_pa;
    return Ok(v);
}

# Van der Waals equation (P + a·n²/V²)(V − n·b) = nRT, solved for P in Pa, from n (mol), T (K),
# V (m³), the attraction constant a (Pa·m⁶/mol²; 1 L²·bar/mol² = 0.1 Pa·m⁶/mol²) and the excluded
# volume b (m³/mol; 1 L/mol = 10⁻³ m³/mol). Ok(P), Err(KM_ERR_INVALID_TEMPERATURE) if T is not
# positive and finite, or Err(KM_ERR_INVALID_INPUT) if n is not finite, a or b is negative or
# non-finite, V is not positive and finite, or V ≤ n·b. Mirrors `gas::van_der_waals_pressure`.
#must_use
fn van_der_waals_pressure(moles: f64, temperature_k: f64, volume_m3: f64, a: f64, b: f64): Result {
    if (_km_is_positive(temperature_k) != 1) { return Err(KM_ERR_INVALID_TEMPERATURE); }
    if (_km_is_finite(moles) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    if (_km_is_non_negative(a) != 1 || _km_is_non_negative(b) != 1) {
        return Err(KM_ERR_INVALID_INPUT);
    }
    if (_km_is_positive(volume_m3) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    var nb: f64 = moles * b;
    if (volume_m3 <= nb) { return Err(KM_ERR_INVALID_INPUT); }
    var n_over_v: f64 = moles / volume_m3;
    var p: f64 = (((moles * KM_GAS_CONSTANT) * temperature_k) / (volume_m3 - nb)) - ((a * n_over_v) * n_over_v);
    return Ok(p);
}

# Dalton's law: the partial pressure, total pressure × mole fraction, in the total's unit. Mirrors
# `gas::partial_pressure`.
#must_use
fn partial_pressure(total_pressure: f64, mole_fraction: f64): f64 {
    var p: f64 = total_pressure * mole_fraction;
    return p;
}

# Gas density ρ = PM/(RT) in kg/m³, from P in Pa, the molar mass M in kg/mol and T in K. Ok(ρ),
# Err(KM_ERR_INVALID_TEMPERATURE) if T is not positive and finite, or Err(KM_ERR_INVALID_INPUT) if P
# is negative or non-finite or M is not positive and finite. Mirrors `gas::gas_density`.
#must_use
fn gas_density(pressure_pa: f64, molar_mass_kg: f64, temperature_k: f64): Result {
    if (_km_is_positive(temperature_k) != 1) { return Err(KM_ERR_INVALID_TEMPERATURE); }
    if (_km_is_non_negative(pressure_pa) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    if (_km_is_positive(molar_mass_kg) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    var rho: f64 = (pressure_pa * molar_mass_kg) / (KM_GAS_CONSTANT * temperature_k);
    return Ok(rho);
}

# ── Peng–Robinson ───────────────────────────────────────────────────────────────────

# Peng–Robinson pressure P = RT/(V − b) − a·α(T)/(V² + 2bV − b²) in Pa, from the critical constants
# and acentric factor (`params`), T in K and the molar volume V in m³/mol. Ok(P),
# Err(KM_ERR_INVALID_TEMPERATURE) if T or Tc is not positive and finite, or
# Err(KM_ERR_INVALID_INPUT) if Pc is not positive and finite, ω is not finite, or V is non-finite or
# not greater than b. Mirrors `gas::peng_robinson_pressure`.
#must_use
fn peng_robinson_pressure(params: KmPengRobinsonParams, temperature_k: f64, molar_volume: f64): Result {
    if (_km_is_positive(temperature_k) != 1) { return Err(KM_ERR_INVALID_TEMPERATURE); }
    var e = _km_pr_validate(params);
    if (e != KM_ERR_NONE) { return Err(e); }
    var a_alpha, b = _km_pr_coefficients(params, temperature_k);
    if (_km_is_finite(molar_volume) != 1 || molar_volume <= b) { return Err(KM_ERR_INVALID_INPUT); }
    var v: f64 = molar_volume;
    var term1: f64 = (KM_GAS_CONSTANT * temperature_k) / (v - b);
    var term2: f64 = a_alpha / (((v * v) + ((2.0 * b) * v)) - (b * b));
    var p: f64 = term1 - term2;
    return Ok(p);
}

# All physical Peng–Robinson compressibility-factor roots, ascending: the cubic
# Z³ − (1−B)Z² + (A−3B²−2B)Z − (AB−B²−B³) = 0, A = a·α·P/(RT)², B = bP/(RT), solved analytically
# (Cardano, or the trigonometric form when there are three real roots), keeping the roots with
# Z > B (molar volume above the co-volume b). With three roots the smallest is liquid-like, the
# largest vapour-like and the middle one mechanically unstable; which phase is stable is decided by
# the fugacities (lower wins): water at 300 K and 1 atm has ≈ [0.00086, 0.0138, 0.985], and the
# liquid is stable. A repeated root (a spinodal, the critical point) is listed once per
# multiplicity. `out` is the caller's buffer of three f64 (`var roots[24];`): Ok(n), n = 1–3, with
# the roots in out[0 .. n − 1]; Err(KM_ERR_INVALID_TEMPERATURE) if T or Tc is not positive and
# finite, Err(KM_ERR_INVALID_INPUT) if P or Pc is not positive and finite or ω is not finite, or
# Err(KM_ERR_COMPUTATION_ERROR) if no root has Z > B (only when intermediate values overflow).
# Mirrors `gas::peng_robinson_z_roots`, whose Vec the buffer and count replace.
#must_use
fn peng_robinson_z_roots(params: KmPengRobinsonParams, temperature_k: f64, pressure_pa: f64, out): Result {
    var e, cap_a, cap_b = _km_pr_dimensionless(params, temperature_k, pressure_pa);
    if (e != KM_ERR_NONE) { return Err(e); }
    var n = _km_pr_physical_roots(cap_a, cap_b, out);
    if (n == 0) { return Err(KM_ERR_COMPUTATION_ERROR); }
    return Ok(n);
}

# The Peng–Robinson compressibility factor Z: the largest physical root of the cubic (see
# peng_robinson_z_roots), the vapour-like one. It is not necessarily the stable phase: below Tc the
# cubic can have a liquid root too, and the stable phase is the one with the lower fugacity (water
# at 300 K and 1 atm: vapour Z ≈ 0.985, stable liquid Z ≈ 0.00086). Ok(Z), or the errors of
# peng_robinson_z_roots. Mirrors `gas::peng_robinson_z`.
#must_use
fn peng_robinson_z(params: KmPengRobinsonParams, temperature_k: f64, pressure_pa: f64): Result {
    var e, cap_a, cap_b = _km_pr_dimensionless(params, temperature_k, pressure_pa);
    if (e != KM_ERR_NONE) { return Err(e); }
    var roots[24];
    var n = _km_pr_physical_roots(cap_a, cap_b, &roots);
    if (n == 0) { return Err(KM_ERR_COMPUTATION_ERROR); }
    var z: f64 = load64(&roots + (n - 1) * 8);
    return Ok(z);
}

# The Peng–Robinson fugacity coefficient φ (dimensionless) at the vapour (largest) root Z of
# peng_robinson_z: ln φ = (Z − 1) − ln(Z − B) − A/(2√2·B) × ln((Z + (1+√2)B) / (Z + (1−√2)B)). See
# peng_robinson_z for why this is not always the stable phase. Ok(φ), the errors of
# peng_robinson_z, or Err(KM_ERR_COMPUTATION_ERROR) if φ is not finite and positive. Mirrors
# `gas::fugacity_coefficient_pr`.
#must_use
fn fugacity_coefficient_pr(params: KmPengRobinsonParams, temperature_k: f64, pressure_pa: f64): Result {
    var e, cap_a, cap_b = _km_pr_dimensionless(params, temperature_k, pressure_pa);
    if (e != KM_ERR_NONE) { return Err(e); }
    var roots[24];
    var n = _km_pr_physical_roots(cap_a, cap_b, &roots);
    if (n == 0) { return Err(KM_ERR_COMPUTATION_ERROR); }
    var z: f64 = load64(&roots + (n - 1) * 8);
    var sqrt2: f64 = 0x3FF6A09E667F3BCD;  # std::f64::consts::SQRT_2
    var l1: f64 = _km_cr_ln(z - cap_b);
    var coef: f64 = cap_a / ((2.0 * sqrt2) * cap_b);
    var num: f64 = z + ((1.0 + sqrt2) * cap_b);
    var den: f64 = z + ((1.0 - sqrt2) * cap_b);
    var l2: f64 = _km_cr_ln(num / den);
    var ln_phi: f64 = ((z - 1.0) - l1) - (coef * l2);
    var phi: f64 = _km_cr_exp(ln_phi);
    if (_km_is_positive(phi) != 1) { return Err(KM_ERR_COMPUTATION_ERROR); }
    return Ok(phi);
}

# The Peng–Robinson fugacity f = φ × P in Pa, with φ from fugacity_coefficient_pr (vapour root).
# Ok(f), or that function's errors. Mirrors `gas::fugacity_pr`.
#must_use
fn fugacity_pr(params: KmPengRobinsonParams, temperature_k: f64, pressure_pa: f64): Result {
    var t, v = fugacity_coefficient_pr(params, temperature_k, pressure_pa);
    if (is_ok(t) != 1) { return Err(v); }
    var phi: f64 = v;
    var f: f64 = phi * pressure_pa;
    return Ok(f);
}

# ── Redlich–Kwong ───────────────────────────────────────────────────────────────────

# Redlich–Kwong pressure P = RT/(V − b) − a/(T^½ × V(V + b)) in Pa, from the critical temperature
# Tc (K) and pressure Pc (Pa), T in K and the molar volume V in m³/mol. Ok(P),
# Err(KM_ERR_INVALID_TEMPERATURE) if T or Tc is not positive and finite, or
# Err(KM_ERR_INVALID_INPUT) if Pc is not positive and finite or V is non-finite or not greater
# than b. Mirrors `gas::redlich_kwong_pressure`.
#must_use
fn redlich_kwong_pressure(tc: f64, pc: f64, temperature_k: f64, molar_volume: f64): Result {
    if (_km_is_positive(temperature_k) != 1) { return Err(KM_ERR_INVALID_TEMPERATURE); }
    if (_km_is_positive(tc) != 1) { return Err(KM_ERR_INVALID_TEMPERATURE); }
    if (_km_is_positive(pc) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    var tc25: f64 = _km_cr_pow(tc, 2.5);
    var a: f64 = (((0.42748 * KM_GAS_CONSTANT) * KM_GAS_CONSTANT) * tc25) / pc;
    var b: f64 = ((0.08664 * KM_GAS_CONSTANT) * tc) / pc;
    if (_km_is_finite(molar_volume) != 1 || molar_volume <= b) { return Err(KM_ERR_INVALID_INPUT); }
    var v: f64 = molar_volume;
    var term1: f64 = (KM_GAS_CONSTANT * temperature_k) / (v - b);
    var st: f64 = f64_sqrt(temperature_k);
    var term2: f64 = a / ((st * v) * (v + b));
    var p: f64 = term1 - term2;
    return Ok(p);
}

# Joule–Thomson coefficient of an ideal gas: always 0.0 K/Pa. A real gas's needs the derivatives of
# an equation of state (Peng–Robinson). Mirrors `gas::joule_thomson_ideal`.
#must_use
fn joule_thomson_ideal(): f64 {
    return 0.0;
}

# --- solution.cyr ---

# solution.cyr — solution chemistry: concentration units, pH, weak acid/base equilibria, ionic strength and
# activity coefficients, and electrolytic conductivity (port of rust-old/src/solution.rs).
#
# Concentrations are in mol/L (M) unless stated otherwise. The acid–base functions assume aqueous solution
# at 25 °C (Kw = KM_KW_WATER_25C, pH + pOH = 14). The constants — KM_KW_WATER_25C, KM_DH_A_WATER_25C,
# KM_DH_B_WATER_25C and the seven KM_LAMBDA_* — are src/constants.cyr's (generated; solution has no data file
# of its own). Fallible functions return a value-form Result whose Err payload is a KM_ERR_* code, and
# reject NaN and ±∞ inputs. Every expression keeps Rust's operation order, so the arithmetic functions are
# bit-identical (class B); the log10 and 10^x functions are class C (docs/development/port-parity.md §7,
# §10).
#
# - log10 is src/mathx.cyr's correctly rounded _km_cr_log10 and 10^x its _km_cr_exp10 (the same value as a
#   correctly rounded pow(10, x), Rust's 10.0_f64.powf(x)), as the Antoine equation's (ADR 0006). With both
#   sides on correctly rounded primitives in Rust's operation order the class-C rows are compared exactly
#   against the corrected oracle (docs/development/port-parity.md §10), henderson_hasselbalch's
#   near-cancellation rows (pKa + log10(ratio) ≈ 0) included.
# - weak_acid_ph / weak_base_ph: kimiya's own Newton iteration on the charge-balance cubic, transcribed
#   operation for operation as _km_charge_balance_root / _km_checked_root. Its iteration cap (Rust's
#   CHARGE_BALANCE_MAX_ITER = 50) and relative-step tolerance (CHARGE_BALANCE_REL_TOL = 10⁻¹²) are private
#   Rust consts, so they are typed formula constants inline here (port plan §6.4), pinned by the golden rows
#   and tests/solution.tcyr. The loop is + − × ÷ and √, so the root is bit-identical to Rust's; the pH is
#   class C only through its one log10.
# - Rust's `charge: i32` is a word here: one outside the i32 range is Err(KM_ERR_INVALID_INPUT), checked
#   first (Rust's type rejects it at compile time), never wrapped.
# - ionic_strength's `&[(f64, i32)]` is a pointer to n 16-byte records — the concentration's f64 bits, then
#   the charge as an i64 word — and the count n, as thermochem's species lists. It has no error channel (Rust
#   returns a bare f64): a negative n, a null pointer with n > 0, or a charge outside the i32 range gives NaN.

# 1 if the word z is a Rust i32 (−2³¹ ..= 2³¹ − 1).
#must_use
fn _km_is_i32(z): i64 {
    if (z < (0 - 0x80000000) || z > 0x7FFFFFFF) { return 0; }
    return 1;
}

# ── concentration units ─────────────────────────────────────────────────────────────

# Molarity M = moles / volume_liters in mol/L, from the amount of solute (mol) and the solution volume (L).
# Ok(M), or Err(KM_ERR_INVALID_INPUT) if the volume is not positive and finite or `moles` is not finite.
# Mirrors `solution::molarity`.
#must_use
fn molarity(moles: f64, volume_liters: f64): Result {
    if (_km_is_positive(volume_liters) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    if (_km_is_finite(moles) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    var m: f64 = moles / volume_liters;
    return Ok(m);
}

# Molality m = moles / solvent_kg in mol/kg, from the amount of solute (mol) and the solvent mass (kg).
# Ok(m), or Err(KM_ERR_INVALID_INPUT) if the solvent mass is not positive and finite or `moles` is not
# finite. Mirrors `solution::molality`.
#must_use
fn molality(moles: f64, solvent_kg: f64): Result {
    if (_km_is_positive(solvent_kg) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    if (_km_is_finite(moles) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    var m: f64 = moles / solvent_kg;
    return Ok(m);
}

# Dilution M₁V₁ = M₂V₂: the final concentration M₂ = M₁·V₁/V₂ in mol/L, from the initial concentration
# (mol/L) and the initial and final volumes (any one volume unit). Ok(M₂), or Err(KM_ERR_INVALID_INPUT) if
# V₂ is not positive and finite or M₁ or V₁ is not finite. Mirrors `solution::dilution`.
#must_use
fn dilution(m1: f64, v1: f64, v2: f64): Result {
    if (_km_is_positive(v2) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    if (_km_is_finite(m1) != 1 || _km_is_finite(v1) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    var m2: f64 = (m1 * v1) / v2;
    return Ok(m2);
}

# ── pH ──────────────────────────────────────────────────────────────────────────────

# pH from the hydrogen ion concentration, pH = −log₁₀[H⁺], [H⁺] in mol/L. Ok(pH), or
# Err(KM_ERR_INVALID_CONCENTRATION) if [H⁺] is not positive and finite. Mirrors
# `solution::ph_from_h_concentration`.
#must_use
fn ph_from_h_concentration(h_molar: f64): Result {
    if (_km_is_positive(h_molar) != 1) { return Err(KM_ERR_INVALID_CONCENTRATION); }
    var l: f64 = _km_cr_log10(h_molar);
    var ph: f64 = -l;
    return Ok(ph);
}

# pOH from the hydroxide ion concentration, pOH = −log₁₀[OH⁻], [OH⁻] in mol/L. Ok(pOH), or
# Err(KM_ERR_INVALID_CONCENTRATION) if [OH⁻] is not positive and finite. Mirrors
# `solution::poh_from_oh_concentration`.
#must_use
fn poh_from_oh_concentration(oh_molar: f64): Result {
    if (_km_is_positive(oh_molar) != 1) { return Err(KM_ERR_INVALID_CONCENTRATION); }
    var l: f64 = _km_cr_log10(oh_molar);
    var poh: f64 = -l;
    return Ok(poh);
}

# pH = 14 − pOH (pH + pOH = 14 at 25 °C). Non-finite input propagates to the result. Mirrors
# `solution::ph_from_poh`.
#must_use
fn ph_from_poh(poh: f64): f64 {
    var ph: f64 = 14.0 - poh;
    return ph;
}

# The Henderson–Hasselbalch equation pH = pKa + log₁₀([A⁻]/[HA]), from the acid's pKa = −log₁₀(Ka) and the
# conjugate base and acid concentrations (mol/L). Ok(pH); Err(KM_ERR_INVALID_CONCENTRATION) if either
# concentration is not positive and finite (the acid's checked first); Err(KM_ERR_INVALID_INPUT) if pKa is not
# finite. pKa + log10(ratio) cancels near pH 0, where one ulp of the log moves the pH by many: the log10 is the
# correctly rounded _km_cr_log10, so the pH is the corrected oracle's bit for bit there too (ADR 0006). Mirrors
# `solution::henderson_hasselbalch`.
#must_use
fn henderson_hasselbalch(pka: f64, conjugate_base: f64, acid: f64): Result {
    if (_km_is_positive(acid) != 1 || _km_is_positive(conjugate_base) != 1) {
        return Err(KM_ERR_INVALID_CONCENTRATION);
    }
    if (_km_is_finite(pka) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    var ratio: f64 = conjugate_base / acid;
    var l: f64 = _km_cr_log10(ratio);
    var ph: f64 = pka + l;
    return Ok(ph);
}

# The H⁺ concentration from pH, [H⁺] = 10^(−pH) in mol/L. Non-finite input propagates to the result. Mirrors
# `solution::h_concentration_from_ph`.
#must_use
fn h_concentration_from_ph(ph: f64): f64 {
    var x: f64 = -ph;
    var h: f64 = _km_cr_exp10(x);
    return h;
}

# ── weak acids and bases ────────────────────────────────────────────────────────────

# Accepts a charge-balance root only if it is a usable concentration: Ok(x) if x is positive and finite,
# else Err(KM_ERR_COMPUTATION_ERROR). Mirrors Rust's private `solution::checked_root`.
#must_use
fn _km_checked_root(x: f64): Result {
    if (_km_is_positive(x) == 1) { return Ok(x); }
    return Err(KM_ERR_COMPUTATION_ERROR);
}

# The positive root x of the monoprotic weak-electrolyte charge balance
# x³ + K·x² − (K·C + Kw)·x − K·Kw = 0, x = [H⁺] for an acid (K = Ka) or [OH⁻] for a base (K = Kb), from
# x = K·C/(K + x) + Kw/x. Newton from the smaller of the upper bounds √(K·C + Kw) and (C + √(C² + 4·Kw))/2,
# which decreases monotonically onto the root. Per iteration (at most 50, Rust's CHARGE_BALANCE_MAX_ITER):
# f(x) ≤ 0 accepts x (the root to within rounding); a non-finite step (only when K·C or x³ overflows) stops;
# else x −= f/f′, and a step ≤ 10⁻¹²·x (Rust's CHARGE_BALANCE_REL_TOL, the step against the updated x)
# accepts x. An accepted x goes through _km_checked_root; a stop or 50 iterations without acceptance is
# Err(KM_ERR_COMPUTATION_ERROR). Mirrors Rust's private `solution::charge_balance_root`, operation for
# operation.
#must_use
fn _km_charge_balance_root(k: f64, c: f64): Result {
    var kw: f64 = KM_KW_WATER_25C;
    var tol: f64 = 0.000000000001;          # CHARGE_BALANCE_REL_TOL = 1e-12
    var kc_kw: f64 = (k * c) + kw;
    var weak_bound: f64 = f64_sqrt(kc_kw);
    var disc: f64 = (c * c) + (4.0 * kw);
    var sq: f64 = f64_sqrt(disc);
    var strong_bound: f64 = 0.5 * (c + sq);
    var x: f64 = _km_min(weak_bound, strong_bound);
    var it = 0;
    while (it < 50) {                       # CHARGE_BALANCE_MAX_ITER = 50
        var fx: f64 = (((x * x) * (x + k)) - (k * ((c * x) + kw))) - (kw * x);
        if (fx <= 0.0) { return _km_checked_root(x); }
        var dfx: f64 = (x * ((3.0 * x) + (2.0 * k))) - kc_kw;
        var step: f64 = fx / dfx;
        if (_km_is_finite(step) != 1) { break; }
        x = x - step;
        var lim: f64 = tol * x;
        if (step <= lim) { return _km_checked_root(x); }
        it = it + 1;
    }
    return Err(KM_ERR_COMPUTATION_ERROR);
}

# The pH of a monoprotic weak acid solution at 25 °C, from Ka (mol/L) and the analytical acid concentration C
# (mol/L): the full charge balance [H⁺] = [A⁻] + [OH⁻], water's autoionisation included, solved for [H⁺] by
# _km_charge_balance_root (dilute solutions approach pH 7 from below; a very large Ka gives the strong-acid
# limit), then pH = −log₁₀[H⁺]. Ok(pH); Err(KM_ERR_INVALID_INPUT) if Ka is not positive and finite;
# Err(KM_ERR_INVALID_CONCENTRATION) if C is not; Err(KM_ERR_COMPUTATION_ERROR) if the root can't be
# represented (e.g. Ka·C overflows). Mirrors `solution::weak_acid_ph`.
#must_use
fn weak_acid_ph(ka: f64, concentration: f64): Result {
    if (_km_is_positive(ka) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    if (_km_is_positive(concentration) != 1) { return Err(KM_ERR_INVALID_CONCENTRATION); }
    var t, v = _km_charge_balance_root(ka, concentration);
    if (is_ok(t) != 1) { return Err(v); }
    var h: f64 = v;
    return ph_from_h_concentration(h);
}

# The pH of a monoprotic weak base solution at 25 °C, from Kb (mol/L) and the analytical base concentration C
# (mol/L): weak_acid_ph's mirror, the charge balance [OH⁻] = [BH⁺] + [H⁺] solved for [OH⁻], then
# pH = 14 − pOH (dilute solutions approach pH 7 from above). Ok(pH); Err(KM_ERR_INVALID_INPUT) if Kb is not
# positive and finite; Err(KM_ERR_INVALID_CONCENTRATION) if C is not; Err(KM_ERR_COMPUTATION_ERROR) if the root
# can't be represented (e.g. Kb·C overflows). Mirrors `solution::weak_base_ph`.
#must_use
fn weak_base_ph(kb: f64, concentration: f64): Result {
    if (_km_is_positive(kb) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    if (_km_is_positive(concentration) != 1) { return Err(KM_ERR_INVALID_CONCENTRATION); }
    var t, v = _km_charge_balance_root(kb, concentration);
    if (is_ok(t) != 1) { return Err(v); }
    var oh: f64 = v;
    var tp, vp = poh_from_oh_concentration(oh);
    if (is_ok(tp) != 1) { return Err(vp); }
    var poh: f64 = vp;
    var ph: f64 = ph_from_poh(poh);
    return Ok(ph);
}

# ── ionic strength and activity coefficients ────────────────────────────────────────

# Ionic strength I = ½ Σ cᵢ·zᵢ² in mol/L, over the n (concentration, charge) records at `ions`: each 16 bytes,
# the concentration's f64 bits (mol/L), then the charge zᵢ as an i64 word. The charge is squared in f64, so any
# i32 charge is accepted; the terms (c·z)·z are summed in list order from −0.0 (Rust's `.sum()`), so no ions give
# 0.5 × −0.0 = −0.0. Concentrations are not validated: negative or non-finite ones propagate. NaN if (ions, n)
# is no list or a charge is outside the i32 range (Rust's type), since there is no error channel. Mirrors
# `solution::ionic_strength`.
#must_use
fn ionic_strength(ions, n): f64 {
    if (n < 0 || (n > 0 && ions == 0)) { return _km_nan(); }
    var s: f64 = -0.0;
    var k = 0;
    while (k < n) {
        var c: f64 = load64(ions + k * 16);
        var zi = load64(ions + k * 16 + 8);
        if (_km_is_i32(zi) != 1) { return _km_nan(); }
        var z: f64 = f64_from(zi);
        var term: f64 = (c * z) * z;
        s = s + term;
        k = k + 1;
    }
    var i: f64 = 0.5 * s;
    return i;
}

# The checks shared by the activity-coefficient models: KM_ERR_INVALID_INPUT if the ionic strength is negative
# or not finite, or the Debye–Hückel A parameter is not finite; else KM_ERR_NONE. Mirrors Rust's private
# `solution::validate_ionic_strength_and_a`.
#must_use
fn _km_validate_ionic_strength_and_a(ionic_str: f64, a_constant: f64): i64 {
    if (_km_is_non_negative(ionic_str) != 1) { return KM_ERR_INVALID_INPUT; }
    if (_km_is_finite(a_constant) != 1) { return KM_ERR_INVALID_INPUT; }
    return KM_ERR_NONE;
}

# The Debye–Hückel limiting law log₁₀ γ = −A·z²·√I (valid for I < 0.01 M): the dimensionless activity
# coefficient γ of an ion of charge z (a Rust i32, as a word) at ionic strength I (mol/L), with the
# Debye–Hückel A parameter in (L/mol)^½ (KM_DH_A_WATER_25C = 0.509 for water at 25 °C). Ok(γ), or
# Err(KM_ERR_INVALID_INPUT) if z is outside the i32 range, I is negative or not finite, or A is not finite.
# Mirrors `solution::debye_huckel_limiting`.
#must_use
fn debye_huckel_limiting(charge, ionic_str: f64, a_constant: f64): Result {
    if (_km_is_i32(charge) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    var e = _km_validate_ionic_strength_and_a(ionic_str, a_constant);
    if (e != KM_ERR_NONE) { return Err(e); }
    var z: f64 = f64_from(charge);
    var sqrt_i: f64 = f64_sqrt(ionic_str);
    var log_gamma: f64 = (((-a_constant) * z) * z) * sqrt_i;
    var gamma: f64 = _km_cr_exp10(log_gamma);
    return Ok(gamma);
}

# The extended Debye–Hückel equation log₁₀ γ = −A·z²·√I / (1 + B·å·√I) (valid for I < 0.1 M): γ of an ion of
# charge z (a word) at ionic strength I (mol/L), with A in (L/mol)^½ (KM_DH_A_WATER_25C), B in Å⁻¹·(mol/L)^−½
# (KM_DH_B_WATER_25C = 0.328 for water at 25 °C) and the effective ion diameter å in Å (typically 3–9). Ok(γ),
# or Err(KM_ERR_INVALID_INPUT) if z is outside the i32 range, I is negative or not finite, A is not finite, or B
# or å is negative or not finite (a negative B·å could make 1 + B·å·√I zero). Mirrors
# `solution::debye_huckel_extended`.
#must_use
fn debye_huckel_extended(charge, ionic_str: f64, a_constant: f64, b_constant: f64, ion_size: f64): Result {
    if (_km_is_i32(charge) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    var e = _km_validate_ionic_strength_and_a(ionic_str, a_constant);
    if (e != KM_ERR_NONE) { return Err(e); }
    if (_km_is_non_negative(b_constant) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    if (_km_is_non_negative(ion_size) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    var sqrt_i: f64 = f64_sqrt(ionic_str);
    var z: f64 = f64_from(charge);
    var num: f64 = (((-a_constant) * z) * z) * sqrt_i;
    var den: f64 = 1.0 + ((b_constant * ion_size) * sqrt_i);
    var log_gamma: f64 = num / den;
    var gamma: f64 = _km_cr_exp10(log_gamma);
    return Ok(gamma);
}

# The Davies equation log₁₀ γ = −A·z²·(√I/(1 + √I) − 0.3·I) (valid for I < 0.5 M; no ion size): γ of an ion of
# charge z (a word) at ionic strength I (mol/L), with A in (L/mol)^½ (KM_DH_A_WATER_25C for water at 25 °C).
# Ok(γ), or Err(KM_ERR_INVALID_INPUT) if z is outside the i32 range, I is negative or not finite, or A is not
# finite. Mirrors `solution::davies_activity`.
#must_use
fn davies_activity(charge, ionic_str: f64, a_constant: f64): Result {
    if (_km_is_i32(charge) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    var e = _km_validate_ionic_strength_and_a(ionic_str, a_constant);
    if (e != KM_ERR_NONE) { return Err(e); }
    var sqrt_i: f64 = f64_sqrt(ionic_str);
    var z: f64 = f64_from(charge);
    var bracket: f64 = (sqrt_i / (1.0 + sqrt_i)) - (0.3 * ionic_str);
    var log_gamma: f64 = (((-a_constant) * z) * z) * bracket;
    var gamma: f64 = _km_cr_exp10(log_gamma);
    return Ok(gamma);
}

# ── conductivity ────────────────────────────────────────────────────────────────────

# Kohlrausch's law Λ_m = Λ°_m − K·√c: the molar conductivity (S·cm²/mol) at concentration c (mol/L), from the
# limiting molar conductivity at infinite dilution Λ°_m (S·cm²/mol) and the Kohlrausch constant K
# (S·cm²·L^½/mol^(3/2)). Ok(Λ_m); Err(KM_ERR_INVALID_CONCENTRATION) if c is negative or not finite;
# Err(KM_ERR_INVALID_INPUT) if Λ°_m or K is not finite. Mirrors `solution::kohlrausch_molar_conductivity`.
#must_use
fn kohlrausch_molar_conductivity(lambda_zero: f64, k_kohlrausch: f64, concentration: f64): Result {
    if (_km_is_non_negative(concentration) != 1) { return Err(KM_ERR_INVALID_CONCENTRATION); }
    if (_km_is_finite(lambda_zero) != 1 || _km_is_finite(k_kohlrausch) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    var sq: f64 = f64_sqrt(concentration);
    var lm: f64 = lambda_zero - (k_kohlrausch * sq);
    return Ok(lm);
}

# Kohlrausch's law of independent ion migration Λ°_m = ν₊·λ°₊ + ν₋·λ°₋ in S·cm²/mol, from the cation's and
# anion's limiting ionic conductivities λ° (S·cm²/mol, e.g. KM_LAMBDA_NA_PLUS) and stoichiometric numbers ν.
# Non-finite input propagates to the result. Mirrors `solution::limiting_molar_conductivity`.
#must_use
fn limiting_molar_conductivity(cation_conductivity: f64, cation_stoich: f64, anion_conductivity: f64,
    anion_stoich: f64): f64 {
    var l: f64 = (cation_stoich * cation_conductivity) + (anion_stoich * anion_conductivity);
    return l;
}

# The solution conductivity κ = Λ_m × c / 1000 in S/cm, from the molar conductivity Λ_m (S·cm²/mol) and the
# concentration c (mol/L). Non-finite input propagates to the result. Mirrors `solution::solution_conductivity`.
#must_use
fn solution_conductivity(molar_conductivity: f64, concentration: f64): f64 {
    var kappa: f64 = (molar_conductivity * concentration) / 1000.0;
    return kappa;
}

# --- electrochemistry_data.cyr ---

# kimiya — electrochemistry data: the standard reduction potentials
#
# GENERATED by scripts/oracle from kimiya 1.2.0 (rust-old/), hisab 1.4.0. Do not edit.
# Regenerate: cargo run --release --locked --manifest-path scripts/oracle/Cargo.toml
#
# STANDARD_POTENTIALS rows are in Rust's order (by E°, most negative first); a handle
# (src/electrochemistry.cyr) is row + 1, and 0 is None. f64 cells are the oracle's values as
# round-trip decimals; tests/golden/electrochemistry.tsv pins every cell (the
# `electrochemistry::STANDARD_POTENTIALS[]` rows). FARADAY and ELEMENTARY_CHARGE are
# src/constants.cyr's KM_FARADAY and KM_ELEMENTARY_CHARGE.

# A standard reduction half-reaction with its electrode potential.
#
# Rust's `HalfReaction` is no Cyrius struct: a row is a handle, its fields the accessors
# half_reaction_<field>(h) of src/electrochemistry.cyr:
# - equation: The reduction half-reaction equation (e.g., "Cu²⁺ + 2e⁻ → Cu").
# - couple: Species being reduced (e.g., "Cu2+/Cu").
# - electrons: Number of electrons transferred.
# - standard_potential: Standard reduction potential E° (V vs SHE).

# Built-in standard reduction potentials (V vs SHE at 25°C).
#
# Sorted by E° from most negative (strongest reductant) to most positive
# (strongest oxidant). Values largely follow the CRC Handbook of Chemistry
# and Physics, "Electrochemical Series" table (a few entries carry older
# textbook values).
# Look entries up by couple with [`lookup_half_reaction`] rather than by
# position.
#
# Notes on rows, from the Rust literal:
# - row 1, K+/K: standard_potential: CRC Handbook, Electrochemical Series
# - row 12, V2+/V: standard_potential: CRC Handbook, Electrochemical Series
# Rust: kimiya::electrochemistry::STANDARD_POTENTIALS (its length).
const KM_STANDARD_POTENTIALS_COUNT = 49;

# The reduction half-reaction equation (e.g., "Cu²⁺ + 2e⁻ → Cu").
# Indexed by STANDARD_POTENTIALS row; mirrors `HalfReaction::equation`.
# Offset of row i's C string in _KM_STANDARD_POTENTIALS_EQUATION_BYTES.
var _KM_STANDARD_POTENTIALS_EQUATION_OFF: u16[49] = {
    0,  # Li⁺ + e⁻ → Li
    20,  # K⁺ + e⁻ → K
