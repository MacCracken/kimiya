# Common ebullioscopic constants K_b and cryoscopic constants K_f (K·kg/mol).

# Ebullioscopic constant K_b of water (K·kg/mol).
# Rust: kimiya::phase::KB_WATER
const KM_KB_WATER = 0.512;

# Ebullioscopic constant K_b of benzene (K·kg/mol).
# Rust: kimiya::phase::KB_BENZENE
const KM_KB_BENZENE = 2.53;

# Ebullioscopic constant K_b of ethanol (K·kg/mol).
