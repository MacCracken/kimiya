    6,  # Cr+3
    6,  # Ti+4
    6,  # Pb+2
    8,  # Sn+2
};

# Effective ionic radius in pm.
# Indexed by IONIC_RADII row; mirrors `IonicRadius::radius_pm`.
var KM_IONIC_RADII_RADIUS_PM: f64[30] = {
    76.0,  # Li+1
    102.0,  # Na+1
    138.0,  # K+1
    152.0,  # Rb+1
    167.0,  # Cs+1
    45.0,  # Be+2
    72.0,  # Mg+2
    100.0,  # Ca+2
    118.0,  # Sr+2
    135.0,  # Ba+2
    53.5,  # Al+3
    78.0,  # Fe+2
    64.5,  # Fe+3
    77.0,  # Cu+1
    73.0,  # Cu+2
    74.0,  # Zn+2
    115.0,  # Ag+1
    133.0,  # F-1
    181.0,  # Cl-1
    196.0,  # Br-1
    220.0,  # I-1
    140.0,  # O-2
    184.0,  # S-2
    83.0,  # Mn+2
    69.0,  # Ni+2
    74.5,  # Co+2
    61.5,  # Cr+3
    60.5,  # Ti+4
    119.0,  # Pb+2
    122.0,  # Sn+2
};

# --- inorganic.cyr ---

# inorganic.cyr — inorganic chemistry: crystal field theory, the spectrochemical series, spin-only magnetic moments,
# lattice energies and ionic radii (port of rust-old/src/inorganic.rs).
#
# CFSE is in units of Δ_oct, moments in Bohr magnetons, the Born–Landé energy in J/mol and the Born–Haber one in
# kJ/mol, radii in pm. The data — KmLigand and its field strengths, Rust's private octahedral occupancy and
# unpaired-electron tables, the Madelung constants and Born exponents, the 30 Shannon IONIC_RADII rows — is
# src/inorganic_data.cyr (generated); AVOGADRO, ELEMENTARY_CHARGE and COULOMB_CONSTANT are src/constants.cyr's.
# Fallible functions return a value-form Result whose Err payload is a KM_ERR_* code, and reject NaN and ±∞ inputs.
# Every expression keeps Rust's operation order, so every result is bit-identical (classes A and B), but one: the CFSE
# is computed exactly, (3·e_g − 2·t₂g) / 5 in one correctly rounded division (ADR 0002 #12; the golden rows where Rust's
# −0.4·t₂g + 0.6·e_g misses it are mapped by the harness and reported as accepted under ADR 2), and Δ_tet is the
# correctly rounded 4Δ/9 also where Rust's Δ·4 overflows (ADR 0002 #15, mapped the same way).
#
# - Rust's integers are words here, never wrapped (port plan §6.4). A d-electron or unpaired-electron count (`u8`)
#   outside 0 ..= 255, an ion charge (`u32`) outside 0 ..= u32::MAX, an ionic-radius charge (`i8`) outside
#   −128 ..= 127: Err(KM_ERR_INVALID_INPUT) for a Result function (cfse_octahedral, unpaired_electrons_oct,
#   born_lande_lattice_energy), NaN for a bare f64 (spin_only_moment), None (0) for a lookup (lookup_ionic_radius).
# - Rust's `bool` is a word: 0 is false and 1 is true. Any other word is Err(KM_ERR_INVALID_INPUT) in a Result
#   function (`high_spin` of cfse_octahedral and unpaired_electrons_oct), checked where Rust picks its table, before
#   the count. (A non-Result function with a bool argument would return its "none", as for an out-of-type integer:
#   port plan §6.4; inorganic has none.)
# - KmLigand has explicit, append-only values in Rust variant order; Ligand's const methods are
#   ligand_field_strength(l) and ligand_is_strong_field(l), 0 for a word that is no KmLigand value.
#   is_strong_field is Rust's formula, field_strength ≥ 8 (the 8 typed inline, as in Rust).
# - lookup_ionic_radius(symbol, charge) returns a handle, IONIC_RADII row + 1, or 0 for None; IonicRadius's fields
#   are ionic_radius_symbol(h) ("" for an invalid handle), ionic_radius_charge(h) and ionic_radius_coordination(h) (0:
#   no row has a zero charge or coordination) and ionic_radius_radius_pm(h) (NaN).

include "lib/string.cyr"

# 1 if the word x is a Rust u8 (0 ..= 255).
#must_use
fn _km_is_u8(x): i64 {
    if (x < 0 || x > 255) { return 0; }
    return 1;
}

# 1 if the word x is a Rust bool: 0 (false) or 1 (true).
#must_use
fn _km_is_bool(x): i64 {
    if (x == 0 || x == 1) { return 1; }
    return 0;
}

# ── crystal field theory ────────────────────────────────────────────────────────────

# Crystal field stabilization energy (CFSE) of an octahedral dⁿ complex, in units of Δ_oct (a dimensionless
# multiplier; negative = stabilizing): CFSE = −0.4·n(t₂g) + 0.6·n(e_g) = (3·n(e_g) − 2·n(t₂g)) / 5, from the generated
# (t₂g, e_g) occupancy of dⁿ, high-spin (weak field, high_spin = 1: Hund's rule) or low-spin (strong field,
# high_spin = 0: t₂g filled first). Electron-pairing energy is not included, so for d⁴–d⁷ the low-spin value is more
# negative than the high-spin one even when the high-spin state is the ground state. Ok(CFSE) for n = 0 ..= 10;
# Err(KM_ERR_INVALID_INPUT) if high_spin is no bool (0 or 1) or d_electrons is outside 0 ..= 10 (a word outside Rust's
# u8 included). ADR 0002 #12: the value is exact — the integer numerator 3·e_g − 2·t₂g converted to f64, then one
# correctly rounded division by 5 — where Rust's `t2g * (−0.4) + eg * 0.6` misses it on 13 of the 22 cases (high-spin
# d⁵ gives −2⁻⁵² and d¹⁰ −2⁻⁵¹ rather than 0, d³ −1.2000000000000002). Mirrors `inorganic::cfse_octahedral`.
#must_use
fn cfse_octahedral(d_electrons, high_spin): Result {
    if (_km_is_bool(high_spin) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    if (d_electrons < 0 || d_electrons > 10) { return Err(KM_ERR_INVALID_INPUT); }
    var t2g = _KM_OCT_OCCUPANCY_LOW_SPIN_T2G[d_electrons];
    var eg = _KM_OCT_OCCUPANCY_LOW_SPIN_EG[d_electrons];
    if (high_spin == 1) {
        t2g = _KM_OCT_OCCUPANCY_HIGH_SPIN_T2G[d_electrons];
        eg = _KM_OCT_OCCUPANCY_HIGH_SPIN_EG[d_electrons];
    }
    var num = 3 * eg - 2 * t2g;
    var n: f64 = f64_from(num);
    var cfse: f64 = n / 5.0;
    return Ok(cfse);
}

# The tetrahedral crystal field splitting Δ_tet ≈ (4/9)·Δ_oct (same metal, ligands and metal–ligand distance), in the
# unit of delta_oct: the correctly rounded 4Δ/9. Computed as Rust's `delta_oct * 4.0 / 9.0` (Δ·4 is exact, so one
# rounding) except where Δ·4 overflows, |Δ| ≥ 2¹⁰²² (above DBL_MAX/4): there Rust gives ±∞, and ADR 0002 #15 (the user's
# decision, 2026-11-09) takes (Δ/9)·4 — one rounded division, then an exact ×4 that cannot overflow — which is again the
# correctly rounded 4Δ/9 (4·DBL_MAX/9 ≈ 7.99 × 10³⁰⁷, not +∞). ±∞ and NaN propagate as in Rust.
# Mirrors `inorganic::delta_tet_from_oct`, with ADR 0002 #15.
#must_use
fn delta_tet_from_oct(delta_oct: f64): f64 {
    var four: f64 = delta_oct * 4.0;
    if (_km_is_finite(four) != 1 && _km_is_finite(delta_oct) == 1) {
        var ninth: f64 = delta_oct / 9.0;          # ADR 0002 #15: Δ·4 overflowed
        var tet4: f64 = ninth * 4.0;
        return tet4;
    }
    var tet: f64 = four / 9.0;
    return tet;
}

# ── spectrochemical series ──────────────────────────────────────────────────────────

# The relative field strength of ligand l (a KmLigand value) as an ordinal rank 1–12 (dimensionless; higher =
# stronger field; gaps between ranks carry no meaning); 0 for a word that is no KmLigand value. Mirrors
# `Ligand::field_strength`.
#must_use
fn ligand_field_strength(l): i64 {
    if (l < 0 || l >= KM_LIGAND_COUNT) { return 0; }
    return KM_LIGAND_FIELD_STRENGTH[l];
}

# 1 if ligand l is a strong-field ligand (typically causes low spin), i.e. its rank is ≥ 8 (KM_LIGAND_AMMONIA and
# stronger); 0 otherwise and for a word that is no KmLigand value. NH₃ is borderline: whether its complexes are
# low-spin depends on the metal ion and its oxidation state ([Co(NH₃)₆]³⁺ is low-spin, [Co(NH₃)₆]²⁺ high-spin).
# Mirrors `Ligand::is_strong_field`.
#must_use
fn ligand_is_strong_field(l): i64 {
    if (l < 0 || l >= KM_LIGAND_COUNT) { return 0; }
    if (KM_LIGAND_FIELD_STRENGTH[l] >= 8) { return 1; }
    return 0;
}

# ── spin-only magnetic moment ───────────────────────────────────────────────────────

# The spin-only magnetic moment μ = √(n(n + 2)) in Bohr magnetons for n unpaired electrons (a Rust u8, as a word);
# NaN for a word outside 0 ..= 255 (there is no error channel). Mirrors `inorganic::spin_only_moment`.
#must_use
fn spin_only_moment(unpaired_electrons): f64 {
    if (_km_is_u8(unpaired_electrons) != 1) { return _km_nan(); }
    var n: f64 = f64_from(unpaired_electrons);
    var n2: f64 = n + 2.0;
    var p: f64 = n * n2;
    var mu: f64 = f64_sqrt(p);
    return mu;
}

# The number of unpaired electrons of an octahedral dⁿ complex, high-spin (high_spin = 1) or low-spin (0), from the
# generated tables. Ok(n unpaired) for d_electrons = 0 ..= 10; Err(KM_ERR_INVALID_INPUT) if high_spin is no bool or
# d_electrons is outside 0 ..= 10 (a word outside Rust's u8 included). Mirrors `inorganic::unpaired_electrons_oct`.
#must_use
fn unpaired_electrons_oct(d_electrons, high_spin): Result {
    if (_km_is_bool(high_spin) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    if (d_electrons < 0 || d_electrons > 10) { return Err(KM_ERR_INVALID_INPUT); }
    if (high_spin == 1) { return Ok(_KM_OCT_UNPAIRED_HIGH_SPIN[d_electrons]); }
    return Ok(_KM_OCT_UNPAIRED_LOW_SPIN[d_electrons]);
}

# ── lattice energy ──────────────────────────────────────────────────────────────────

# The Born–Landé lattice energy U = −(k_e·N_A·M·z⁺·z⁻·e²) / r₀ · (1 − 1/n) in J/mol (negative = stable), from the
# Madelung constant M (dimensionless, positive), the cation and anion charge magnitudes z⁺ and z⁻ (Rust u32s, as
# words; the anion's sign is handled by the formula), the nearest-neighbour distance r₀ in m and the Born exponent n
# (typically 5–12). Computed in Rust's order, `−k_e · N_A · M · z⁺ · z⁻ · e · e / r₀ · (1 − 1/n)` left to right.
# Ok(U); Err(KM_ERR_INVALID_INPUT) if r₀ is not positive and finite, n is not finite or ≤ 1, M is not positive and
# finite, or either charge is 0 or outside 0 ..= u32::MAX (in that order). Mirrors
# `inorganic::born_lande_lattice_energy`.
#must_use
fn born_lande_lattice_energy(madelung: f64, z_cation, z_anion, r0_m: f64, born_exponent: f64): Result {
    if (_km_is_positive(r0_m) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    if (_km_is_finite(born_exponent) != 1 || born_exponent <= 1.0) { return Err(KM_ERR_INVALID_INPUT); }
    if (_km_is_positive(madelung) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    if (z_cation < 1 || z_cation > 0xFFFFFFFF || z_anion < 1 || z_anion > 0xFFFFFFFF) {
        return Err(KM_ERR_INVALID_INPUT);
    }
    var ke: f64 = KM_COULOMB_CONSTANT;
    var na: f64 = KM_AVOGADRO;
    var e: f64 = KM_ELEMENTARY_CHARGE;
    var zc: f64 = f64_from(z_cation);
    var za: f64 = f64_from(z_anion);
    var u: f64 = -ke;
    u = u * na;
    u = u * madelung;
    u = u * zc;
    u = u * za;
    u = u * e;
    u = u * e;
    u = u / r0_m;
    var inv: f64 = 1.0 / born_exponent;
    var factor: f64 = 1.0 - inv;
    u = u * factor;
    return Ok(u);
}

# The Born–Haber lattice energy U = ΔH_f° − ΔH_sub − IE − ΔH_diss/2 − EA in kJ/mol (negative = stable), from the
# compound's formation enthalpy, the metal's sublimation enthalpy and ionization energy, the full X₂ → 2X
# dissociation enthalpy (halved here, for MX) and the nonmetal's electron affinity (negative = energy released), all
# in kJ/mol. Computed in Rust's order, left to right; inputs are not validated (NaN and ±∞ propagate). Mirrors
# `inorganic::born_haber_lattice_energy`.
#must_use
fn born_haber_lattice_energy(formation_enthalpy_kj: f64, sublimation_enthalpy_kj: f64, ionization_energy_kj: f64,
    dissociation_enthalpy_kj: f64, electron_affinity_kj: f64): f64 {
    var u: f64 = formation_enthalpy_kj - sublimation_enthalpy_kj;
    u = u - ionization_energy_kj;
    var half: f64 = dissociation_enthalpy_kj / 2.0;
    u = u - half;
    u = u - electron_affinity_kj;
    return u;
}

# ── ionic radii ─────────────────────────────────────────────────────────────────────

# The IONIC_RADII row of handle h (h − 1), or -1 if h is no handle.
#must_use
fn _km_ionic_radius_row(h): i64 {
    if (h >= 1 && h <= KM_IONIC_RADII_COUNT) { return h - 1; }
    return 0 - 1;
}

# The Shannon (1976) ionic radius of the ion with element symbol `symbol` (a C string, exact and case-sensitive:
# "Fe") and charge `charge` (in e, negative for anions; a Rust i8, as a word), as a handle (its IONIC_RADII row + 1),
# whatever its coordination number; 0 when no row matches, `symbol` is 0, or charge is outside −128 ..= 127. The first
# match in table order, as Rust's linear `find` (each ion has one row). Mirrors `inorganic::lookup_ionic_radius`.
#must_use
fn lookup_ionic_radius(symbol, charge): i64 {
    if (symbol == 0 || charge < (0 - 128) || charge > 127) { return 0; }
    var c0 = load8(symbol);
    if (c0 == 0) { return 0; }
    var n = strlen(symbol);
    var row = 0;
    while (row < KM_IONIC_RADII_COUNT) {
        var p = &_KM_IONIC_RADII_SYMBOL_BYTES + _KM_IONIC_RADII_SYMBOL_OFF[row];
        # The charge and the first byte decide most rows; memeq stops at p's NUL, which differs from symbol's byte.
        if (KM_IONIC_RADII_CHARGE[row] == charge && load8(p) == c0) {
            if (memeq(p, symbol, n) == 1 && load8(p + n) == 0) { return row + 1; }
        }
        row = row + 1;
    }
    return 0;
}

# The element symbol of IONIC_RADII handle h ("Fe") as a C string in the baked table; "" for an invalid handle.
# Mirrors `IonicRadius::symbol`.
#must_use
fn ionic_radius_symbol(h): i64 {
    var row = _km_ionic_radius_row(h);
    if (row < 0) { return ""; }
    return &_KM_IONIC_RADII_SYMBOL_BYTES + _KM_IONIC_RADII_SYMBOL_OFF[row];
}

# The ion charge of IONIC_RADII handle h in units of e (negative for anions); 0 for an invalid handle, which no row
# has. Mirrors `IonicRadius::charge`.
#must_use
fn ionic_radius_charge(h): i64 {
    var row = _km_ionic_radius_row(h);
    if (row < 0) { return 0; }
    return KM_IONIC_RADII_CHARGE[row];
}

# The coordination number the radius of IONIC_RADII handle h applies to (6 for every row but Sn²⁺, 8); 0 for an
# invalid handle. Mirrors `IonicRadius::coordination`.
#must_use
fn ionic_radius_coordination(h): i64 {
    var row = _km_ionic_radius_row(h);
    if (row < 0) { return 0; }
    return KM_IONIC_RADII_COORDINATION[row];
}

# The effective ionic radius of IONIC_RADII handle h in pm (Shannon 1976); NaN for an invalid handle. Mirrors
# `IonicRadius::radius_pm`.
#must_use
fn ionic_radius_radius_pm(h): f64 {
    var row = _km_ionic_radius_row(h);
    if (row < 0) { return _km_nan(); }
    var r: f64 = KM_IONIC_RADII_RADIUS_PM[row];
    return r;
}

# --- potential.cyr ---

# potential.cyr — intermolecular potentials (Lennard-Jones, Morse, Coulomb) and molecular geometry from 3D coordinates
# (distances, bond and dihedral angles) (port of rust-old/src/potential.rs).
#
# SI as Rust documents it: energies in the unit of the well depth (J), lengths in any consistent unit (m for
# Coulomb's law), charges in C. Fallible functions return a value-form Result whose Err payload is
# KM_ERR_INVALID_INPUT (Rust's only error here), and reject NaN and ±∞ inputs where Rust does. Every expression keeps
# Rust's operation order, constant by constant, including the private helpers sub3 / cross / dot3 (_km_sub3,
# _km_cross, _km_dot3, on scalars: Rust's [f64; 3] by value is three f64 here, and each helper returns its three
# results as a multi-value return). The arithmetic functions are bit-identical (class B: + − × ÷ and √); morse (exp),
# bond_angle and dihedral_angle (atan2) are class C on src/mathx.cyr's correctly rounded _km_cr_exp and _km_cr_atan2
# (ADR 0006), compared exactly against the corrected oracle (docs/development/port-parity.md §14).
#
# - Rust's `[f64; 3]` arguments are pointers to three contiguous f64 (24 bytes, `var p: f64[3];`): distance_3d(p1, p2),
#   bond_angle(a, b, c), dihedral_angle(a, b, c, d). A null pointer (0) gives NaN from distance_3d and
#   Err(KM_ERR_INVALID_INPUT) from the Result functions, checked before anything else (port plan §6.4).
# - COULOMB_CONSTANT is src/constants.cyr's KM_COULOMB_CONSTANT (generated, CODATA 2018). Rust's private
#   COINCIDENT_REL_TOL (10⁻¹²; bond_angle squares it, as Rust does, at run time) and COLLINEAR_SIN_SQ_TOL (10⁻²⁰) are
#   typed formula constants inline, as nuclear.cyr's EQUAL_RATE_REL_TOL: numerical tolerances, kept as Rust's, and each
#   pinned to the ulp by golden rows on the threshold (validate.py perturbs it one ulp, halves and doubles it, and
#   requires some row to change). π (dihedral_angle's −π → π mapping) is std::f64::consts::PI by its bits.
# - ADR 0002 #16, #17, #18 (M4d; the user's policy of 2026-11-09, "fix exactly" where Rust's rounding misses an exact
#   value):
#   - #16, lj_equilibrium_distance: Rust's `sigma * 2.0.powf(1.0 / 6.0)` rounds the exponent 1/6 and then the product,
#     two roundings; the port returns the correctly rounded σ·2^(1/6) (src/mathx.cyr's _km_cr_sixth_root2_mul, one
#     rounding of a triple-double product, proven sufficient by 2^(1/6)'s continued fraction);
#   - #17, lennard_jones: Rust's (4·ε)·d overflows to ±∞ (or ∞·0 = NaN) for ε ≥ 2¹⁰²² where 4·ε·d is representable;
#     there the port takes (ε·d)·4, the correctly rounded 4·ε·d (scaling by 4 is exact), Rust's form elsewhere;
#   - #18, morse_width_parameter: Rust's μ/(2·D_e) is μ/∞ = 0 for D_e ≥ 2¹⁰²³; there the port takes (μ·½)/D_e, the
#     correctly rounded μ/(2·D_e) (μ·½ is exact, or the quotient rounds to 0 either way), Rust's form elsewhere.
#   The golden rows keep the oracle's values; where the port's differ, the note names them and the harness maps the
#   two (accepted under ADR 2, counted).
# - ADR 0002 #20 (M4e-2; the user's decision of 2026-11-09, "Yes, prescale"): distance_3d, bond_angle and
#   dihedral_angle are Rust's own operation sequence evaluated in binary64 with an unbounded exponent range: every
#   + − × ÷ √ rounded to 53 bits, nothing over- or underflowing, the comparisons and Err checks on those values, and the
#   final √ or atan2 rounded once into binary64 (its subnormal grid, or ±∞). Rust squares raw coordinates, so above
#   about 10¹⁵⁴ (10⁷⁷ for the dihedral's fourth powers) or below their reciprocals its chain gave an Err, 0, ±∞ or a
#   degraded value where the distance or angle is representable. Each function runs Rust's chain (the fast path) with a
#   cheap test that proves it stayed in the normal range, and only otherwise, for finite coordinates, re-evaluates with
#   src/mathx.cyr's unbounded-exponent helpers (_km_*_ux below); non-finite coordinates keep Rust's results. So every
#   input whose chain stays normal gets Rust's bits, and the angles are exactly scale-invariant (every check is
#   homogeneous, atan2's two arguments have the same degree): bond_angle and dihedral_angle of 2^k times the
#   coordinates give the same bits for every k with the scaled coordinates exact, and distance_3d scales by exactly
#   2^k wherever it is normal.
# - Kept as Rust's (reviewed in M4d, reported to the user; the library-wide audit after M4 revisits each with
#   src/mathx.cyr's unbounded-exponent helpers): the over- and underflow of (σ/r)⁶ and (σ/r)¹², of k·q₁·q₂ and r·r, and
#   a subnormal D_e·x in morse: each a chain of rounded operations whose intermediates can leave the normal range where
#   the result is representable (ADR 0002's policy until then: Rust's sequence is the definition).

# ── private helpers ─────────────────────────────────────────────────────────────────────────────────

# a − b, componentwise (Rust's sub3).
#must_use
fn _km_sub3(a0: f64, a1: f64, a2: f64, b0: f64, b1: f64, b2: f64): (f64, f64, f64) {
    var d0: f64 = a0 - b0;
    var d1: f64 = a1 - b1;
    var d2: f64 = a2 - b2;
    return (d0, d1, d2);
}

# a × b (Rust's cross): [a1·b2 − a2·b1, a2·b0 − a0·b2, a0·b1 − a1·b0].
#must_use
fn _km_cross(a0: f64, a1: f64, a2: f64, b0: f64, b1: f64, b2: f64): (f64, f64, f64) {
    var c0: f64 = (a1 * b2) - (a2 * b1);
    var c1: f64 = (a2 * b0) - (a0 * b2);
    var c2: f64 = (a0 * b1) - (a1 * b0);
    return (c0, c1, c2);
}

# a · b (Rust's dot3): (a0·b0 + a1·b1) + a2·b2.
#must_use
fn _km_dot3(a0: f64, a1: f64, a2: f64, b0: f64, b1: f64, b2: f64): f64 {
    var d: f64 = ((a0 * b0) + (a1 * b1)) + (a2 * b2);
    return d;
}

# ── the geometry with an unbounded exponent (ADR 0002 #20, M4e-2) ───────────────────────────────────────────────
#
# Rust's sub3 / cross / dot3 on src/mathx.cyr's unbounded-exponent values, in Rust's operation order. A vector is six
# words, the three (s, e) pairs (48 bytes: `var v[48];`).

# The vector of the three f64 at p, exactly (each _km_ux_from).
fn _km_load3_ux(out, p) {
    var k = 0;
    while (k < 3) {
        var x: f64 = load64(p + 8 * k);
        var s, e = _km_ux_from(x);
        store64(out + 16 * k, s);
        store64(out + 16 * k + 8, e);
        k = k + 1;
    }
}

# out = a − b, componentwise (Rust's sub3).
fn _km_sub3_ux(out, a, b) {
    var k = 0;
    while (k < 3) {
        var xs: f64 = load64(a + 16 * k);
        var ys: f64 = load64(b + 16 * k);
        var s, e = _km_ux_sub(xs, load64(a + 16 * k + 8), ys, load64(b + 16 * k + 8));
        store64(out + 16 * k, s);
        store64(out + 16 * k + 8, e);
        k = k + 1;
    }
}

# a_i·b_j − a_j·b_i as an (s, e) pair (one component of Rust's cross).
#must_use
fn _km_cross1_ux(a, b, i, j): (f64, i64) {
    var ais: f64 = load64(a + 16 * i);
    var ajs: f64 = load64(a + 16 * j);
    var bis: f64 = load64(b + 16 * i);
    var bjs: f64 = load64(b + 16 * j);
    var ps, pe = _km_ux_mul(ais, load64(a + 16 * i + 8), bjs, load64(b + 16 * j + 8));
    var qs, qe = _km_ux_mul(ajs, load64(a + 16 * j + 8), bis, load64(b + 16 * i + 8));
    var s, e = _km_ux_sub(ps, pe, qs, qe);
    return (s, e);
}

# out = a × b (Rust's cross): [a1·b2 − a2·b1, a2·b0 − a0·b2, a0·b1 − a1·b0].
fn _km_cross_ux(out, a, b) {
    var s0, e0 = _km_cross1_ux(a, b, 1, 2);
    var s1, e1 = _km_cross1_ux(a, b, 2, 0);
    var s2, e2 = _km_cross1_ux(a, b, 0, 1);
    store64(out, s0);
    store64(out + 8, e0);
    store64(out + 16, s1);
    store64(out + 24, e1);
    store64(out + 32, s2);
    store64(out + 40, e2);
}

# a · b (Rust's dot3): (a0·b0 + a1·b1) + a2·b2.
#must_use
fn _km_dot3_ux(a, b): (f64, i64) {
    var a0: f64 = load64(a);
    var b0: f64 = load64(b);
    var a1: f64 = load64(a + 16);
    var b1: f64 = load64(b + 16);
    var a2: f64 = load64(a + 32);
    var b2: f64 = load64(b + 32);
    var p0, f0 = _km_ux_mul(a0, load64(a + 8), b0, load64(b + 8));
    var p1, f1 = _km_ux_mul(a1, load64(a + 24), b1, load64(b + 24));
    var p2, f2 = _km_ux_mul(a2, load64(a + 40), b2, load64(b + 40));
    var s01, e01 = _km_ux_add(p0, f0, p1, f1);
    var s, e = _km_ux_add(s01, e01, p2, f2);
    return (s, e);
}

# 1 if every coordinate of the three f64 at each of the n pointers (in order: p0, p1, p2, p3) is finite.
#must_use
fn _km_points_finite(p0, p1, p2, p3, n): i64 {
    var k = 0;
    while (k < 3 * n) {
        var q = p0;
        if (k >= 3) { q = p1; }
        if (k >= 6) { q = p2; }
        if (k >= 9) { q = p3; }
        var x: f64 = load64(q + 8 * (k % 3));
        if (_km_is_finite(x) != 1) { return 0; }
        k = k + 1;
    }
    return 1;
}

# distance_3d with an unbounded exponent (ADR 0002 #20), for finite coordinates: Rust's √((dx² + dy²) + dz²) with every
# operation rounded to 53 bits and nothing over- or underflowing, the √ rounded once into binary64.
#must_use
fn _km_distance_3d_ux(p1, p2): f64 {
    var u[48];
    var v[48];
    var d[48];
    _km_load3_ux(&u, p1);
    _km_load3_ux(&v, p2);
    _km_sub3_ux(&d, &v, &u);
    var ss, se = _km_dot3_ux(&d, &d);
    var r: f64 = _km_ux_sqrt_f64(ss, se);
    return r;
}

# bond_angle with an unbounded exponent (ADR 0002 #20), for finite coordinates: Rust's sequence, every check on the
# exact values (|ba|², |bc|² > 0; the coincidence tests against (10⁻¹²)²·max(|a|², |b|²) and (10⁻¹²)²·max(|c|², |b|²)),
# then atan2(√|ba × bc|², ba · bc) rounded once.
#must_use
fn _km_bond_angle_ux(a, b, c): Result {
    var ua[48];
    var ub[48];
    var uc[48];
    var ba[48];
    var bc[48];
    var cr[48];
    _km_load3_ux(&ua, a);
    _km_load3_ux(&ub, b);
    _km_load3_ux(&uc, c);
    _km_sub3_ux(&ba, &ua, &ub);
    _km_sub3_ux(&bc, &uc, &ub);
    var bas, bae = _km_dot3_ux(&ba, &ba);
    var bcs, bce = _km_dot3_ux(&bc, &bc);
    var tol: f64 = 0.000000000001;          # COINCIDENT_REL_TOL, 10⁻¹²
    var tol_sq: f64 = tol * tol;
    var ts, te = _km_ux_from(tol_sq);
    var bs, be = _km_dot3_ux(&ub, &ub);
    if (_km_ux_is_positive(bas, bae) != 1 || _km_ux_is_positive(bcs, bce) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    var aqs, aqe = _km_dot3_ux(&ua, &ua);
    var mas, mae = _km_ux_max(aqs, aqe, bs, be);
    var tas, tae = _km_ux_mul(ts, te, mas, mae);
    if (_km_ux_le(bas, bae, tas, tae) == 1) { return Err(KM_ERR_INVALID_INPUT); }
    var cs, ce = _km_dot3_ux(&uc, &uc);
    var mcs, mce = _km_ux_max(cs, ce, bs, be);
    var tcs, tce = _km_ux_mul(ts, te, mcs, mce);
    if (_km_ux_le(bcs, bce, tcs, tce) == 1) { return Err(KM_ERR_INVALID_INPUT); }
    _km_cross_ux(&cr, &ba, &bc);
    var cns, cne = _km_dot3_ux(&cr, &cr);
    var ys, ye = _km_ux_sqrt(cns, cne);
    var xs, xe = _km_dot3_ux(&ba, &bc);
    var ang: f64 = _km_ux_atan2_f64(ys, ye, xs, xe);
    return Ok(ang);
}

# dihedral_angle with an unbounded exponent (ADR 0002 #20), for finite coordinates: Rust's sequence, every check on the
# exact values (|n₁|², |n₂|² > 0; the collinearity tests against (10⁻²⁰·|b₁|²)·|b₂|² and (10⁻²⁰·|b₂|²)·|b₃|²), then
# atan2(√|b₂|²·(b₁ · n₂), n₁ · n₂) rounded once, and Rust's −π → π.
#must_use
fn _km_dihedral_angle_ux(a, b, c, d): Result {
    var ua[48];
    var ub[48];
    var uc[48];
    var ud[48];
    var u[48];
    var v[48];
    var w[48];
    var n1[48];
    var n2[48];
    _km_load3_ux(&ua, a);
    _km_load3_ux(&ub, b);
    _km_load3_ux(&uc, c);
    _km_load3_ux(&ud, d);
    _km_sub3_ux(&u, &ub, &ua);              # b₁
    _km_sub3_ux(&v, &uc, &ub);              # b₂
    _km_sub3_ux(&w, &ud, &uc);              # b₃
    _km_cross_ux(&n1, &u, &v);
    _km_cross_ux(&n2, &v, &w);
    var n1s, n1e = _km_dot3_ux(&n1, &n1);
    var n2s, n2e = _km_dot3_ux(&n2, &n2);
    var b2s, b2e = _km_dot3_ux(&v, &v);
    if (_km_ux_is_positive(n1s, n1e) != 1 || _km_ux_is_positive(n2s, n2e) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    var tol: f64 = 0.00000000000000000001;  # COLLINEAR_SIN_SQ_TOL, 10⁻²⁰
    var ts, te = _km_ux_from(tol);
    var b1s, b1e = _km_dot3_ux(&u, &u);
    var p1s, p1e = _km_ux_mul(ts, te, b1s, b1e);
    var t1s, t1e = _km_ux_mul(p1s, p1e, b2s, b2e);
    if (_km_ux_le(n1s, n1e, t1s, t1e) == 1) { return Err(KM_ERR_INVALID_INPUT); }
    var b3s, b3e = _km_dot3_ux(&w, &w);
    var p2s, p2e = _km_ux_mul(ts, te, b2s, b2e);
    var t2s, t2e = _km_ux_mul(p2s, p2e, b3s, b3e);
    if (_km_ux_le(n2s, n2e, t2s, t2e) == 1) { return Err(KM_ERR_INVALID_INPUT); }
    var sbs, sbe = _km_ux_sqrt(b2s, b2e);
    var dns, dne = _km_dot3_ux(&u, &n2);
    var yvs, yve = _km_ux_mul(sbs, sbe, dns, dne);
    var xvs, xve = _km_dot3_ux(&n1, &n2);
    var phi: f64 = _km_ux_atan2_f64(yvs, yve, xvs, xve);
    var pi: f64 = 0x400921FB54442D18;       # std::f64::consts::PI
    if (phi <= -pi) { return Ok(pi); }
    return Ok(phi);
}

# ── intermolecular potentials ───────────────────────────────────────────────────────────────────────

# The Lennard-Jones 6-12 potential V(r) = 4ε[(σ/r)¹² − (σ/r)⁶], in the unit of ε (J), from the well depth ε, the
# collision diameter σ and the separation r (any consistent length unit). Ok(V), or Err(KM_ERR_INVALID_INPUT) if ε, σ
# or r is not positive and finite (checked in that order). (σ/r)⁶ is Rust's five multiplications, (σ/r)¹² its square,
# then (4·ε)·d; ADR 0002 #17: for ε ≥ 2¹⁰²², where Rust's 4·ε overflows, (ε·d)·4, the correctly rounded 4·ε·d (Rust:
# ±∞, or NaN at r = σ). Mirrors `potential::lennard_jones`, with ADR 0002 #17.
#must_use
fn lennard_jones(epsilon: f64, sigma: f64, r: f64): Result {
    if (_km_is_positive(epsilon) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    if (_km_is_positive(sigma) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    if (_km_is_positive(r) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    var sr: f64 = sigma / r;
    var sr6: f64 = ((((sr * sr) * sr) * sr) * sr) * sr;
    var sr12: f64 = sr6 * sr6;
    var d: f64 = sr12 - sr6;
    var edge: f64 = 0x7FD0000000000000;    # 2¹⁰²²: from here 4·ε overflows (ADR 0002 #17)
    if (epsilon >= edge) {
        var w: f64 = (epsilon * d) * 4.0;
        return Ok(w);
    }
    var v: f64 = (4.0 * epsilon) * d;
    return Ok(v);
}

# The Lennard-Jones equilibrium distance r_min = 2^(1/6)·σ ≈ 1.122σ, in the unit of σ. ADR 0002 #16: the correctly
# rounded σ·2^(1/6) (one rounding; Rust's σ·2.0.powf(1.0 / 6.0) rounds twice and is one ulp off on about a fifth of all
# σ); NaN, ±0 and ±∞ give σ. Inputs are not validated. Mirrors `potential::lj_equilibrium_distance`, with ADR 0002 #16.
#must_use
fn lj_equilibrium_distance(sigma: f64): f64 {
    var r: f64 = _km_cr_sixth_root2_mul(sigma);
    return r;
}

# The Morse potential V(r) = D_e·(1 − exp(−a(r − r_e)))², in the unit of D_e (J), zero at r = r_e, from the well depth
# D_e, the width parameter a (m⁻¹), the equilibrium distance r_e and the separation r. Ok(V), or
# Err(KM_ERR_INVALID_INPUT) if D_e or a is not positive and finite (in that order); r_e and r are not validated
# (non-finite ones propagate). Computed as Rust's x = 1 − exp(−a·(r − r_e)), then (D_e·x)·x, on the correctly rounded
# _km_cr_exp. Mirrors `potential::morse`.
#must_use
fn morse(d_e: f64, a: f64, r_e: f64, r: f64): Result {
    if (_km_is_positive(d_e) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    if (_km_is_positive(a) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    var na: f64 = -a;
    var dr: f64 = r - r_e;
    var y: f64 = na * dr;
    var ey: f64 = _km_cr_exp(y);
    var x: f64 = 1.0 - ey;
    var v: f64 = (d_e * x) * x;
    return Ok(v);
}

# The Morse width parameter a = ω_e·√(μ/(2·D_e)), in m⁻¹, from the harmonic angular frequency ω_e (rad/s), the reduced
# mass μ (kg) and the well depth D_e (J). Ok(a), or Err(KM_ERR_INVALID_INPUT) if any parameter is not positive and
# finite. ADR 0002 #18: for D_e ≥ 2¹⁰²³, where Rust's 2·D_e overflows (μ/∞ = 0), (μ·½)/D_e, the correctly rounded
# μ/(2·D_e); Rust's form elsewhere. Mirrors `potential::morse_width_parameter`, with ADR 0002 #18.
#must_use
fn morse_width_parameter(omega_e: f64, reduced_mass: f64, d_e: f64): Result {
    if (_km_is_positive(d_e) != 1 || _km_is_positive(reduced_mass) != 1 || _km_is_positive(omega_e) != 1) {
        return Err(KM_ERR_INVALID_INPUT);
    }
    var q: f64 = 0.0;
    var edge: f64 = 0x7FE0000000000000;    # 2¹⁰²³: from here 2·D_e overflows (ADR 0002 #18)
    if (d_e >= edge) {
        var hm: f64 = reduced_mass * 0.5;
        q = hm / d_e;
    } else {
        var td: f64 = 2.0 * d_e;
        q = reduced_mass / td;
    }
    var sq: f64 = f64_sqrt(q);
    var w: f64 = omega_e * sq;
    return Ok(w);
}

# The Coulomb potential energy V(r) = k_e·q₁·q₂/r, in J, of two point charges (C) at a separation r (m). Ok(V), or
# Err(KM_ERR_INVALID_INPUT) if r is not positive and finite; the charges are not validated. Computed as Rust's
# ((k_e·q₁)·q₂)/r. Mirrors `potential::coulomb`.
#must_use
fn coulomb(q1: f64, q2: f64, r: f64): Result {
    if (_km_is_positive(r) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    var k: f64 = KM_COULOMB_CONSTANT;
    var v: f64 = ((k * q1) * q2) / r;
    return Ok(v);
}

# The Coulomb force F = k_e·q₁·q₂/r², in N (positive: repulsion), of two point charges (C) at a separation r (m).
# Ok(F), or Err(KM_ERR_INVALID_INPUT) if r is not positive and finite. Computed as Rust's ((k_e·q₁)·q₂)/(r·r).
# Mirrors `potential::coulomb_force`.
#must_use
fn coulomb_force(q1: f64, q2: f64, r: f64): Result {
    if (_km_is_positive(r) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    var k: f64 = KM_COULOMB_CONSTANT;
    var rr: f64 = r * r;
    var v: f64 = ((k * q1) * q2) / rr;
    return Ok(v);
}

# ── molecular geometry from 3D coordinates ──────────────────────────────────────────────────────────

# The distance between two points p1 and p2 (pointers to three f64), √((x₂ − x₁)² + (y₂ − y₁)² + (z₂ − z₁)²), in the
# unit of the coordinates; NaN for a null pointer. Inputs are not validated (non-finite coordinates propagate as in
# Rust). ADR 0002 #20: Rust's sequence with an unbounded exponent, the √ rounded once (|(DBL_MAX, 0, 0)| is DBL_MAX,
# |(2⁻¹⁰⁷⁴, 0, 0)| is 2⁻¹⁰⁷⁴, where Rust's squares give +∞ and 0). Mirrors `potential::distance_3d`, with ADR 0002 #20.
#must_use
fn distance_3d(p1, p2): f64 {
    if (p1 == 0 || p2 == 0) {
        var nan: f64 = _km_nan();
        return nan;
    }
    var x1: f64 = load64(p1);
    var y1: f64 = load64(p1 + 8);
    var z1: f64 = load64(p1 + 16);
    var x2: f64 = load64(p2);
    var y2: f64 = load64(p2 + 8);
    var z2: f64 = load64(p2 + 16);
    var dx: f64 = x2 - x1;
    var dy: f64 = y2 - y1;
    var dz: f64 = z2 - z1;
    var s: f64 = ((dx * dx) + (dy * dy)) + (dz * dz);
    var d: f64 = f64_sqrt(s);
    # Rust's chain while it provably is the unbounded-exponent one (ADR 0002 #20): s in [2^-900, DBL_MAX] (no square
    # overflowed, and a sum of squares that large absorbs any underflowed one exactly where it is added: each is
    # below 2^-1022, under a quarter ulp of the partial sum it meets, or the sum would be smaller), or all three
    # differences 0. Otherwise, for finite coordinates, the unbounded evaluation; non-finite ones keep Rust's NaN or
    # +∞.
    var lo: f64 = 0x07B0000000000000;       # 2^-900
    var hi: f64 = 0x7FEFFFFFFFFFFFFF;       # DBL_MAX
    if (s >= lo && s <= hi) { return d; }
    if (dx == 0.0 && dy == 0.0 && dz == 0.0) { return d; }
    if (_km_points_finite(p1, p2, 0, 0, 2) != 1) { return d; }
    var u: f64 = _km_distance_3d_ux(p1, p2);
    return u;
}

# The bond angle A-B-C (B the central atom; a, b, c pointers to three f64), in radians in [0, π], as Rust's
# atan2(|ba × bc|, ba · bc) (accurate near 0 and π, unlike acos) on the correctly rounded _km_cr_atan2. Ok(θ), or
# Err(KM_ERR_INVALID_INPUT) for a null pointer, a non-finite coordinate (|ba|² or |bc|² is then NaN or ∞), or A or C
# coinciding with B: |ba|² ≤ (10⁻¹²)²·max(|a|², |b|²), or the same for C, so a bond below the coordinates' resolution
# counts as zero (Rust's COINCIDENT_REL_TOL, squared at run time as Rust does). ADR 0002 #20: Rust's sequence with an
# unbounded exponent (the checks on the exact values, atan2 rounded once), so θ is scale-invariant bit for bit, as Rust
# documents it in exact arithmetic. Mirrors `potential::bond_angle`, with ADR 0002 #20.
#must_use
fn bond_angle(a, b, c): Result {
    if (a == 0 || b == 0 || c == 0) { return Err(KM_ERR_INVALID_INPUT); }
    var a0: f64 = load64(a);
    var a1: f64 = load64(a + 8);
    var a2: f64 = load64(a + 16);
    var b0: f64 = load64(b);
    var b1: f64 = load64(b + 8);
    var b2: f64 = load64(b + 16);
    var c0: f64 = load64(c);
    var c1: f64 = load64(c + 8);
    var c2: f64 = load64(c + 16);
    var ba0, ba1, ba2 = _km_sub3(a0, a1, a2, b0, b1, b2);
    var bc0, bc1, bc2 = _km_sub3(c0, c1, c2, b0, b1, b2);
    var ba_sq: f64 = _km_dot3(ba0, ba1, ba2, ba0, ba1, ba2);
    var bc_sq: f64 = _km_dot3(bc0, bc1, bc2, bc0, bc1, bc2);
    var tol: f64 = 0.000000000001;          # COINCIDENT_REL_TOL, 10⁻¹²
    var tol_sq: f64 = tol * tol;
    var b_sq: f64 = _km_dot3(b0, b1, b2, b0, b1, b2);
    # Rust's chain while it provably stays the unbounded-exponent one (ADR 0002 #20): |ba|², |bc|², max(|a|², |b|²),
    # max(|c|², |b|²) and |ba × bc|² in [2^-900, DBL_MAX], ba · bc finite. A sum of squares of at least 2^-900 is exact
    # of any underflowed term (each below 2^-1022 absorbed where it is added), so these and the thresholds are the
    # unbounded values; |ba · bc| below 2^-510 against |ba × bc| ≥ 2^-450 leaves atan2 at RN(π/2) either way.
    var lo: f64 = 0x07B0000000000000;       # 2^-900
    var hi: f64 = 0x7FEFFFFFFFFFFFFF;       # DBL_MAX
    if (ba_sq >= lo && ba_sq <= hi && bc_sq >= lo && bc_sq <= hi) {
        var a_sq: f64 = _km_dot3(a0, a1, a2, a0, a1, a2);
        var ma: f64 = _km_max(a_sq, b_sq);
        var c_sq: f64 = _km_dot3(c0, c1, c2, c0, c1, c2);
        var mc: f64 = _km_max(c_sq, b_sq);
        if (ma >= lo && ma <= hi && mc >= lo && mc <= hi) {
            var ta: f64 = tol_sq * ma;
            if (ba_sq <= ta) { return Err(KM_ERR_INVALID_INPUT); }
            var tc: f64 = tol_sq * mc;
            if (bc_sq <= tc) { return Err(KM_ERR_INVALID_INPUT); }
            var cr0, cr1, cr2 = _km_cross(ba0, ba1, ba2, bc0, bc1, bc2);
            var cn: f64 = _km_dot3(cr0, cr1, cr2, cr0, cr1, cr2);
            var x: f64 = _km_dot3(ba0, ba1, ba2, bc0, bc1, bc2);
            var dxx: f64 = x - x;
            if (cn >= lo && cn <= hi && dxx == 0.0) {
                var y: f64 = f64_sqrt(cn);
                var ang: f64 = _km_cr_atan2(y, x);
                return Ok(ang);
            }
            # An exactly linear or zero-angle geometry (CO₂ on an axis): ba × bc is exactly 0, so |ba × bc|² = 0 fails
            # the test above. When every component of ba and bc is 0 or at least 2^-511 in magnitude, each product in
            # the cross and dot products is 0 or normal (one that overflows leaves a cross component or x non-finite,
            # which fails here), and a sum or difference of such is exact wherever it is subnormal: the cross
            # components and x are the unbounded ones, y is +0 in both evaluations, and atan2(+0, x) is the result.
            if (cr0 == 0.0 && cr1 == 0.0 && cr2 == 0.0 && dxx == 0.0) {
                var m: f64 = 0x2000000000000000;    # 2^-511
                var tiny = 0;
                if (ba0 != 0.0 && ba0 < m && ba0 > -m) { tiny = 1; }
                if (ba1 != 0.0 && ba1 < m && ba1 > -m) { tiny = 1; }
                if (ba2 != 0.0 && ba2 < m && ba2 > -m) { tiny = 1; }
                if (bc0 != 0.0 && bc0 < m && bc0 > -m) { tiny = 1; }
                if (bc1 != 0.0 && bc1 < m && bc1 > -m) { tiny = 1; }
                if (bc2 != 0.0 && bc2 < m && bc2 > -m) { tiny = 1; }
                if (tiny == 0) {
                    var z: f64 = 0.0;
                    var ang0: f64 = _km_cr_atan2(z, x);
                    return Ok(ang0);
                }
            }
        }
    }
    # A non-finite coordinate makes |ba|² or |bc|² NaN or +∞: Rust's Err. Finite ones: the unbounded evaluation.
    if (_km_points_finite(a, b, c, 0, 3) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    var tx, vx = _km_bond_angle_ux(a, b, c);
    if (is_ok(tx) == 1) { return Ok(vx); }
    return Err(vx);
}

# The dihedral (torsion) angle A-B-C-D (a, b, c, d pointers to three f64), in radians in (−π, π]: the angle between the
# ABC and BCD planes with the IUPAC sign (positive when, viewed along B→C, B–A turns clockwise to eclipse C–D); planar
# trans is π, cis 0. With b₁ = B − A, b₂ = C − B, b₃ = D − C, n₁ = b₁ × b₂ and n₂ = b₂ × b₃: φ = atan2(|b₂|·(b₁ · n₂),
# n₁ · n₂) on the correctly rounded _km_cr_atan2, and atan2's −π (a trans geometry whose y-term is −0.0) reported as π.
# Ok(φ), or Err(KM_ERR_INVALID_INPUT) for a null pointer, a non-finite coordinate, two consecutive atoms coinciding, or
# A-B-C or B-C-D collinear: |n₁|² ≤ 10⁻²⁰·|b₁|²·|b₂|² (a bond angle within about 10⁻¹⁰ rad of 0 or π; Rust's
# COLLINEAR_SIN_SQ_TOL), or the same for n₂. ADR 0002 #20: Rust's sequence with an unbounded exponent (the checks on the
# exact values, atan2 rounded once, then the −π → π mapping), so φ is scale-invariant bit for bit. Mirrors
# `potential::dihedral_angle`, with ADR 0002 #20.
#must_use
fn dihedral_angle(a, b, c, d): Result {
    if (a == 0 || b == 0 || c == 0 || d == 0) { return Err(KM_ERR_INVALID_INPUT); }
    var a0: f64 = load64(a);
    var a1: f64 = load64(a + 8);
    var a2: f64 = load64(a + 16);
    var b0: f64 = load64(b);
    var b1: f64 = load64(b + 8);
    var b2: f64 = load64(b + 16);
    var c0: f64 = load64(c);
    var c1: f64 = load64(c + 8);
    var c2: f64 = load64(c + 16);
    var d0: f64 = load64(d);
    var d1: f64 = load64(d + 8);
    var d2: f64 = load64(d + 16);
    var u0, u1, u2 = _km_sub3(b0, b1, b2, a0, a1, a2);       # b₁
    var v0, v1, v2 = _km_sub3(c0, c1, c2, b0, b1, b2);       # b₂
    var w0, w1, w2 = _km_sub3(d0, d1, d2, c0, c1, c2);       # b₃
    # |b₁|², |b₂|², |b₃|² as Rust's dot3 (inline: the squares are the fast path's test), b₁ = (u0, u1, u2) and so on.
    var q0: f64 = u0 * u0;
    var q1: f64 = u1 * u1;
    var q2: f64 = u2 * u2;
    var q3: f64 = v0 * v0;
    var q4: f64 = v1 * v1;
    var q5: f64 = v2 * v2;
    var q6: f64 = w0 * w0;
    var q7: f64 = w1 * w1;
    var q8: f64 = w2 * w2;
    var b1_sq: f64 = (q0 + q1) + q2;
    var b2_sq: f64 = (q3 + q4) + q5;
    var b3_sq: f64 = (q6 + q7) + q8;
    # Rust's chain while it provably stays the unbounded-exponent one (ADR 0002 #20): every component of b₁, b₂, b₃
    # zero or of magnitude in [2^-229, 2^254). From below: a component's square is below 2^-458 exactly when
    # 0 ≤ |x| < 2^-229 (the double below 2^-229 squares to 2^-458·(1 − 2^-52)), and then the component must be 0; from
    # above, |b|² ≤ 2^506. Then the cross components are 0 or in [2^-510, 2^509] (each nonzero product is at least
    # 2^-458, a multiple of 2^-510), b₁ · n₂ is 0 or at least 2^-791, and every product is in [2^-1020, 2^1020]: no
    # intermediate leaves the normal range.
    var lo: f64 = 0x2350000000000000;       # 2^-458
    var hi: f64 = 0x5F90000000000000;       # 2^506
    var bad = 0;
    if (q0 < lo) { if (u0 != 0.0) { bad = 1; } }
    if (q1 < lo) { if (u1 != 0.0) { bad = 1; } }
    if (q2 < lo) { if (u2 != 0.0) { bad = 1; } }
    if (q3 < lo) { if (v0 != 0.0) { bad = 1; } }
    if (q4 < lo) { if (v1 != 0.0) { bad = 1; } }
    if (q5 < lo) { if (v2 != 0.0) { bad = 1; } }
    if (q6 < lo) { if (w0 != 0.0) { bad = 1; } }
    if (q7 < lo) { if (w1 != 0.0) { bad = 1; } }
    if (q8 < lo) { if (w2 != 0.0) { bad = 1; } }
    if (bad != 0 || !(b1_sq <= hi) || !(b2_sq <= hi) || !(b3_sq <= hi)) {
        # A non-finite coordinate makes |n₁|² or |n₂|² NaN or +∞: Rust's Err. Finite ones: the unbounded evaluation.
        if (_km_points_finite(a, b, c, d, 4) != 1) { return Err(KM_ERR_INVALID_INPUT); }
        var tx, vx = _km_dihedral_angle_ux(a, b, c, d);
        if (is_ok(tx) == 1) { return Ok(vx); }
        return Err(vx);
    }
    var n10, n11, n12 = _km_cross(u0, u1, u2, v0, v1, v2);
    var n20, n21, n22 = _km_cross(v0, v1, v2, w0, w1, w2);
    var n1_sq: f64 = _km_dot3(n10, n11, n12, n10, n11, n12);
    var n2_sq: f64 = _km_dot3(n20, n21, n22, n20, n21, n22);
    if (_km_is_positive(n1_sq) != 1 || _km_is_positive(n2_sq) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    var tol: f64 = 0.00000000000000000001;  # COLLINEAR_SIN_SQ_TOL, 10⁻²⁰
    var t1: f64 = (tol * b1_sq) * b2_sq;
    if (n1_sq <= t1) { return Err(KM_ERR_INVALID_INPUT); }
    var t2: f64 = (tol * b2_sq) * b3_sq;
    if (n2_sq <= t2) { return Err(KM_ERR_INVALID_INPUT); }
    var sb: f64 = f64_sqrt(b2_sq);
    var dn: f64 = _km_dot3(u0, u1, u2, n20, n21, n22);
    var yv: f64 = sb * dn;
    var xv: f64 = _km_dot3(n10, n11, n12, n20, n21, n22);
    var phi: f64 = _km_cr_atan2(yv, xv);
    var pi: f64 = 0x400921FB54442D18;       # std::f64::consts::PI
    if (phi <= -pi) { return Ok(pi); }
    return Ok(phi);
}

# --- nuclear_data.cyr ---

# kimiya — nuclear data: the ISOTOPES table
#
# GENERATED by scripts/oracle from kimiya 1.2.0 (rust-old/), hisab 1.4.0. Do not edit.
# Regenerate: cargo run --release --locked --manifest-path scripts/oracle/Cargo.toml
#
# ISOTOPES rows are in Rust's order; a handle (src/nuclear.cyr) is row + 1, and 0 is None. f64 cells
# are the oracle's values as round-trip decimals; tests/golden/nuclear.tsv pins every cell (the
# `nuclear::ISOTOPES[]` rows) and tests/golden/constants.tsv the four nuclear constants, which are
# src/constants.cyr's (KM_AMU_MEV, KM_PROTON_MASS_U, KM_NEUTRON_MASS_U, KM_HYDROGEN_ATOM_MASS_U).

# A radioactive isotope with its half-life.
#
# Rust's `Isotope` is no Cyrius struct: a row is a handle, its fields the accessors
# isotope_<field>(h) of src/nuclear.cyr:
# - symbol: Nuclide label, element symbol and mass number (e.g. `"C-14"`,
#   `"Tc-99m"` for a metastable state).
# - z: Atomic number Z (protons).
# - a: Mass number A (protons + neutrons).
# - half_life_s: Half-life in seconds. Use f64::INFINITY for stable isotopes.
# - decay_mode: Principal decay mode(s): `"α"`, `"β⁻"`, `"β⁺"`, `"EC"` (electron
#   capture), `"IT"` (isomeric transition); multiple modes are `/`-separated.

# Built-in isotope data for common radioisotopes.
