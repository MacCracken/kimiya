# Whether the group can act as a hydrogen-bond **donor** (has an O–H,
# N–H or S–H).
#
# Acceptor-only groups (ethers, aldehydes, ketones, esters, nitriles)
# return `false` even though they accept hydrogen bonds. [`Self::Amine`]
# returns `true` for primary/secondary amines; tertiary amines (–NR₂)
# have no N–H and cannot donate. S–H is only a weak donor.
# Indexed by KmFunctionalGroup value; mirrors `FunctionalGroup::hydrogen_bonding`.
# ADR 0002 #6: Rust's `hydrogen_bonding` is functional_group_is_hydrogen_bond_donor here.
var KM_FUNCTIONAL_GROUP_IS_HYDROGEN_BOND_DONOR: bool[16] = {
    false,  # Alkane
    false,  # Alkene
    false,  # Alkyne
    true,  # Alcohol
    false,  # Aldehyde
    false,  # Ketone
    true,  # CarboxylicAcid
    false,  # Ester
    false,  # Ether
    true,  # Amine
    true,  # Amide
    false,  # Nitrile
    true,  # Thiol
    false,  # Halide
    true,  # Phenol
    false,  # AromaticRing
};

# ADR 0002 #6 adds this property: whether the group can act as a hydrogen-bond acceptor. The oracle has no
# such data, so this column is scripts/oracle/src/t_organic.rs's classification, not the oracle's API.
# - The criterion is IUPAC's (Recommendations 2011: E. Arunan et al., "Definition of the hydrogen bond",
#   Pure Appl. Chem. 83 (2011) 1637–1641, doi:10.1351/PAC-REC-10-01-02). In X–H···Y–Z, X–H is the donor and
#   "the acceptor is an electron-rich region such as, but not limited to, a lone pair in Y or a π-bonded
#   pair in Y–Z" (the wording as reproduced from the Recommendation in S. M. Bachrach's Computational
#   Organic Chemistry blog, comporgchem.com/blog/archives/1402: the published PDF was not reachable to
#   check it against). The definition also asks for evidence of bond formation; each weak family has it:
# - O and N lone pairs, the conventional acceptors (J. McMurry, Organic Chemistry, OpenStax 2023, §2.12;
#   the oracle's own doc of `hydrogen_bonding` names ethers, aldehydes, ketones, esters and nitriles as
#   acceptors that cannot donate).
# - π-bonded pairs, X–H···π to C=C, C≡C and aromatic rings: T. Steiner, "The hydrogen bond in the solid
#   state", Angew. Chem. Int. Ed. 41 (2002) 48–76, doi:10.1002/1521-3773(20020104)41:1<48::AID-ANIE48>3.0.CO;2-U.
# - Divalent sulfur, the thiol's S: a weak acceptor (F. H. Allen, C. M. Bird, R. S. Rowland, P. R. Raithby,
#   "Hydrogen-bond acceptor and donor properties of divalent sulfur (Y–S–Z and R–S–H)", Acta Cryst. B53
#   (1997) 696–701, doi:10.1107/S0108768197002644).
# - Carbon-bound halogens: weak acceptors (L. Brammer, E. A. Bruton, P. Sherwood, "Understanding the
#   behavior of halogens as hydrogen bond acceptors", Cryst. Growth Des. 1 (2001) 277–290,
#   doi:10.1021/cg015522k), organic fluorine the weakest (J. D. Dunitz, R. Taylor, "Organic fluorine hardly
#   ever accepts hydrogen bonds", Chem. Eur. J. 3 (1997) 89–98, doi:10.1002/chem.19970030115).
# - An alkane has no lone pair and no π bond, only C–C and C–H σ bonds, so it is the one group that does
#   not accept. No strength is implied: a 1 here can be a carbonyl O or the π face of a benzene ring.
# Indexed by KmFunctionalGroup value; no Rust counterpart.
var KM_FUNCTIONAL_GROUP_IS_HYDROGEN_BOND_ACCEPTOR: bool[16] = {
    false,  # Alkane: no lone pair and no π bond: C–C and C–H σ bonds only
    true,  # Alkene: the C=C π-bonded pair, a weak X–H···π acceptor (Steiner 2002)
    true,  # Alkyne: the C≡C π-bonded pairs, weak X–H···π acceptors (Steiner 2002)
    true,  # Alcohol: the O–H oxygen's two lone pairs
    true,  # Aldehyde: the carbonyl O's lone pairs (Rust: acceptor-only)
    true,  # Ketone: the carbonyl O's lone pairs (Rust: acceptor-only)
    true,  # CarboxylicAcid: the C=O and O–H oxygens' lone pairs
    true,  # Ester: the carbonyl and ether-type O's lone pairs (Rust: acceptor-only)
    true,  # Ether: the C–O–C oxygen's two lone pairs (Rust: acceptor-only)
    true,  # Amine: the N's lone pair, tertiary amines included
    true,  # Amide: chiefly the carbonyl O's lone pairs (the N pair is delocalised)
    true,  # Nitrile: the sp N's lone pair (Rust: acceptor-only)
    true,  # Thiol: the divalent S's lone pairs, a weak acceptor (Allen et al. 1997)
    true,  # Halide: the C–X halogen's lone pairs, weak; C–F the weakest (Brammer 2001, Dunitz 1997)
    true,  # Phenol: the O–H oxygen's lone pairs, and the ring's π face
    true,  # AromaticRing: the ring's π face, a weak X–H···π acceptor (Steiner 2002)
};

# --- organic.cyr ---

# organic.cyr — organic chemistry: average bond energies, VSEPR geometry and functional groups (port of
# rust-old/src/organic.rs).
#
# Energies are in kJ/mol, angles in degrees. The data — the enums KmBondType, KmGeometry and KmFunctionalGroup
# and their per-variant properties — is src/organic_data.cyr (generated). Every function is a table read or
# + − × of table values in Rust's operation order, so every result is bit-identical (classes A and B).
#
# - The enums have explicit, append-only values in Rust variant order (KM_BOND_TYPE_CH = 0, …). Rust's const
#   property methods are free functions of the value, named <enum>_<method>: bond_type_energy_kj(b),
#   geometry_ideal_bond_angle(g), functional_group_pattern(g), functional_group_is_polar(g). Rust's type admits
#   only its variants; here any word can arrive, and one that is no value of the enum gets the property's
#   documented "none" (NaN, "" or 0), never an out-of-bounds read.
# - ADR 0002 #6: Rust's `Geometry::TShapedThreeLonePairs` (three bonding groups and two lone pairs, ClF₃) is
#   KM_GEOMETRY_T_SHAPED, at its Rust position (7); `FunctionalGroup::hydrogen_bonding` is
#   functional_group_is_hydrogen_bond_donor; functional_group_is_hydrogen_bond_acceptor is new, its column a cited
#   classification: IUPAC 2011's electron-rich region, a lone pair or a π-bonded pair, the weak acceptors included,
#   so every group but the alkane accepts (the sources, one per weak family, are in src/organic_data.cyr).
# - predict_geometry(bonding_groups, lone_pairs) takes Rust's two u8s as words and returns the value-form Option of
#   a KmGeometry value. A word outside 0 ..= 255 is None (there is no error channel), never wrapped mod 256.
# - enthalpy_from_bonds(broken, nb, formed, nf): Rust's `&[(BondType, u32)]` is a pointer to n 16-byte records —
#   the KmBondType value as a word, then the count as a word — and n, as thermochem's species lists. Each list is
#   Σ energy·count in list order from −0.0 (Rust's `.sum()`), so two empty lists give −0.0 − −0.0 = +0.0. It has
#   no error channel (Rust returns a bare f64): a negative n, a null pointer with n > 0, an invalid KmBondType
#   value or a count outside 0 ..= u32::MAX (never wrapped) gives NaN.

# 1 if the word v is a value of an enum with `count` members (0 ..= count − 1).
#must_use
fn _km_is_enum_value(v, count): i64 {
    if (v < 0 || v >= count) { return 0; }
    return 1;
}

# ── bond energies ───────────────────────────────────────────────────────────────────

# Average bond dissociation energy of bond type b (a KmBondType value) in kJ/mol (gas phase, averaged over typical
# compounds); NaN for a word that is no KmBondType value. Mirrors `BondType::energy_kj`.
#must_use
fn bond_type_energy_kj(b): f64 {
    if (_km_is_enum_value(b, KM_BOND_TYPE_COUNT) != 1) { return _km_nan(); }
    var e: f64 = KM_BOND_TYPE_ENERGY_KJ[b];
    return e;
}

# Σ energy × count over the n (KmBondType, count) records at `bonds`, in list order from −0.0 (Rust's
# `.map(|(b, n)| b.energy_kj() * *n as f64).sum()`); NaN if (bonds, n) is no list, a type is no KmBondType value or
# a count is outside 0 ..= u32::MAX.
#must_use
fn _km_bond_energy_sum(bonds, n): f64 {
    if (n < 0 || (n > 0 && bonds == 0)) { return _km_nan(); }
    var s: f64 = -0.0;
    var k = 0;
    while (k < n) {
        var b = load64(bonds + k * 16);
        var count = load64(bonds + k * 16 + 8);
        if (_km_is_enum_value(b, KM_BOND_TYPE_COUNT) != 1) { return _km_nan(); }
        if (count < 0 || count > 0xFFFFFFFF) { return _km_nan(); }
        var e: f64 = KM_BOND_TYPE_ENERGY_KJ[b];
        var c: f64 = f64_from(count);
        var term: f64 = e * c;
        s = s + term;
        k = k + 1;
    }
    return s;
}

# Reaction enthalpy estimated from average bond energies, in kJ (per mole of reaction as written):
# ΔH ≈ Σ(bonds broken) − Σ(bonds formed), negative = exothermic. `broken` and `formed` each point to their n
# (KmBondType value, count) records of 16 bytes (the value as a word, then the count). NaN if either is no list,
# names a word that is no KmBondType value, or has a count outside 0 ..= u32::MAX (Rust's type). Mirrors
# `organic::enthalpy_from_bonds`.
#must_use
fn enthalpy_from_bonds(broken, nb, formed, nf): f64 {
    var sb: f64 = _km_bond_energy_sum(broken, nb);
    var sf: f64 = _km_bond_energy_sum(formed, nf);
    var dh: f64 = sb - sf;
    return dh;
}

# ── VSEPR geometry ──────────────────────────────────────────────────────────────────

# The ideal bond angle of geometry g (a KmGeometry value) in degrees (where applicable; the equatorial angle for
# the trigonal-bipyramidal family); NaN for a word that is no KmGeometry value. Mirrors
# `Geometry::ideal_bond_angle`.
#must_use
fn geometry_ideal_bond_angle(g): f64 {
    if (_km_is_enum_value(g, KM_GEOMETRY_COUNT) != 1) { return _km_nan(); }
    var a: f64 = KM_GEOMETRY_IDEAL_BOND_ANGLE[g];
    return a;
}

# The molecular geometry VSEPR theory predicts for a central atom with `bonding_groups` bonding electron groups
# (atoms bonded to it) and `lone_pairs` lone pairs, as Some(KmGeometry value); None for an arrangement it doesn't
# cover. A single bonding group (a diatomic such as HCl, or a terminal atom) is always linear for 0–3 lone pairs.
# Read it with `var t, g = predict_geometry(b, lp); if (is_some(t) == 1) { .. }`. Rust's arguments are u8s: a word
# outside 0 ..= 255 is None, never wrapped. Mirrors `organic::predict_geometry`.
#must_use
fn predict_geometry(bonding_groups, lone_pairs): Option {
    if (bonding_groups == 1) {
        if (lone_pairs >= 0 && lone_pairs <= 3) { return Some(KM_GEOMETRY_LINEAR); }  # diatomic: HCl, N₂, F₂
        return None();
    }
    if (bonding_groups == 2) {
        if (lone_pairs == 0) { return Some(KM_GEOMETRY_LINEAR); }
        if (lone_pairs == 1) { return Some(KM_GEOMETRY_BENT_ONE_LONE_PAIR); }
        if (lone_pairs == 2) { return Some(KM_GEOMETRY_BENT_TWO_LONE_PAIRS); }
        if (lone_pairs == 3) { return Some(KM_GEOMETRY_LINEAR); }  # XeF2-like
        return None();
    }
    if (bonding_groups == 3) {
        if (lone_pairs == 0) { return Some(KM_GEOMETRY_TRIGONAL_PLANAR); }
        if (lone_pairs == 1) { return Some(KM_GEOMETRY_TRIGONAL_PYRAMIDAL); }
        if (lone_pairs == 2) { return Some(KM_GEOMETRY_T_SHAPED); }
        return None();
    }
    if (bonding_groups == 4) {
        if (lone_pairs == 0) { return Some(KM_GEOMETRY_TETRAHEDRAL); }
        if (lone_pairs == 1) { return Some(KM_GEOMETRY_SEESAW_SHAPED); }
        if (lone_pairs == 2) { return Some(KM_GEOMETRY_SQUARE_PLANAR); }
        return None();
    }
    if (bonding_groups == 5) {
        if (lone_pairs == 0) { return Some(KM_GEOMETRY_TRIGONAL_BIPYRAMIDAL); }
        if (lone_pairs == 1) { return Some(KM_GEOMETRY_SQUARE_PYRAMIDAL); }
        return None();
    }
    if (bonding_groups == 6 && lone_pairs == 0) { return Some(KM_GEOMETRY_OCTAHEDRAL); }
    return None();
}

# ── functional groups ───────────────────────────────────────────────────────────────

# The general formula or identifying pattern of functional group g (a KmFunctionalGroup value) as a C string of
# UTF-8 bytes in the baked table ("C≡C (sp)", "-NH₂ / -NHR / -NR₂"); "" for a word that is no KmFunctionalGroup
# value. Mirrors `FunctionalGroup::pattern`.
#must_use
fn functional_group_pattern(g): i64 {
    if (_km_is_enum_value(g, KM_FUNCTIONAL_GROUP_COUNT) != 1) { return ""; }
    return &_KM_FUNCTIONAL_GROUP_PATTERN_BYTES + _KM_FUNCTIONAL_GROUP_PATTERN_OFF[g];
}

# 1 if functional group g is typically polar (qualitative): every group but alkane, alkene, alkyne and the
# aromatic ring; 0 otherwise and for a word that is no KmFunctionalGroup value. Mirrors `FunctionalGroup::is_polar`.
#must_use
fn functional_group_is_polar(g): i64 {
    if (_km_is_enum_value(g, KM_FUNCTIONAL_GROUP_COUNT) != 1) { return 0; }
    if (KM_FUNCTIONAL_GROUP_IS_POLAR[g]) { return 1; }
    return 0;
}

# 1 if functional group g can act as a hydrogen-bond donor (has an O–H, N–H or S–H): alcohol, carboxylic acid,
# amine (primary and secondary; a tertiary amine has no N–H), amide, phenol and thiol (S–H is only a weak donor);
# 0 otherwise and for a word that is no KmFunctionalGroup value. The acceptor-only groups (ethers, aldehydes,
# ketones, esters, nitriles) give 0: see functional_group_is_hydrogen_bond_acceptor. Mirrors
# `FunctionalGroup::hydrogen_bonding` (renamed by ADR 0002 #6).
#must_use
fn functional_group_is_hydrogen_bond_donor(g): i64 {
    if (_km_is_enum_value(g, KM_FUNCTIONAL_GROUP_COUNT) != 1) { return 0; }
    if (KM_FUNCTIONAL_GROUP_IS_HYDROGEN_BOND_DONOR[g]) { return 1; }
    return 0;
}

# 1 if functional group g can act as a hydrogen-bond acceptor, by the IUPAC 2011 criterion (Arunan et al., Pure Appl.
# Chem. 83, 1637): it has an electron-rich region, a lone pair or a π-bonded pair — the O and N lone pairs of
# alcohol, aldehyde, ketone, carboxylic acid, ester, ether, amine (tertiary included), amide, nitrile and phenol, and
# the weak acceptors: the π electrons of alkenes, alkynes and aromatic rings (Steiner 2002), thiol S (Allen et al.
# 1997) and C–X halogens (Brammer et al. 2001; organic F the weakest, Dunitz & Taylor 1997). 0 for the alkane (σ bonds
# only) and for a word that is no KmFunctionalGroup value. No strength is implied. New in the Cyrius API (ADR 0002 #6);
# the classification and its sources are in src/organic_data.cyr. No Rust counterpart.
#must_use
fn functional_group_is_hydrogen_bond_acceptor(g): i64 {
    if (_km_is_enum_value(g, KM_FUNCTIONAL_GROUP_COUNT) != 1) { return 0; }
    if (KM_FUNCTIONAL_GROUP_IS_HYDROGEN_BOND_ACCEPTOR[g]) { return 1; }
    return 0;
}

# --- inorganic_data.cyr ---

# kimiya — inorganic-chemistry data: ligands, d-electron tables, Madelung and Born constants, ionic radii
#
# GENERATED by scripts/oracle from kimiya 1.2.0 (rust-old/), hisab 1.4.0. Do not edit.
# Regenerate: cargo run --release --locked --manifest-path scripts/oracle/Cargo.toml
#
# KmLigand follows the Rust declaration order and is append-only; KM_LIGAND_FIELD_STRENGTH is indexed by
# its value. The d-electron tables are indexed by n = 0 ..= 10. IONIC_RADII rows are in Rust's order; a
# handle (src/inorganic.cyr) is row + 1, and 0 is None. f64 cells are the oracle's values as round-trip
# decimals; tests/golden/inorganic.tsv pins every cell (the tables through cfse_octahedral,
# unpaired_electrons_oct and the `inorganic::IONIC_RADII[]` rows) and tests/golden/constants.tsv the
# Madelung constants and Born exponents.

# Spectrochemical series — common ligands, ordered from weakest to
# strongest field.
#
# [`Ligand::field_strength`] gives a dimensionless ordinal rank (1–12), not
# a Δ_oct value; only the ordering is meaningful.
enum KmLigand {
    # I⁻ — weakest-field ligand in this list.
    KM_LIGAND_IODIDE = 0;
    # Br⁻.
    KM_LIGAND_BROMIDE = 1;
    # Cl⁻.
    KM_LIGAND_CHLORIDE = 2;
    # F⁻.
    KM_LIGAND_FLUORIDE = 3;
    # OH⁻.
    KM_LIGAND_HYDROXIDE = 4;
    # H₂O.
    KM_LIGAND_WATER = 5;
    # NH₃ — intermediate/borderline field strength.
    KM_LIGAND_AMMONIA = 6;
    # Ethylenediamine (en), bidentate.
    KM_LIGAND_ETHYLENEDIAMINE = 7;
    # NO₂⁻ (N-bound nitro).
    KM_LIGAND_NITRITE = 8;
    # CN⁻.
    KM_LIGAND_CYANIDE = 9;
    # CO — strongest-field ligand in this list.
    KM_LIGAND_CARBON_MONOXIDE = 10;
}
const KM_LIGAND_COUNT = 11;

# Relative field strength as an ordinal rank 1–12 (dimensionless;
# higher = stronger field). Gaps between ranks carry no meaning.
# Indexed by KmLigand value; mirrors `Ligand::field_strength` (a u8).
var KM_LIGAND_FIELD_STRENGTH: u8[11] = {
    1,  # Iodide
    2,  # Bromide
    3,  # Chloride
    4,  # Fluoride
    5,  # Hydroxide
    6,  # Water
    8,  # Ammonia
    9,  # Ethylenediamine
    10,  # Nitrite
    11,  # Cyanide
    12,  # CarbonMonoxide
};

