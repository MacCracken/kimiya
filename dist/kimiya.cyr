# --- electrochemistry.cyr ---

# electrochemistry.cyr — electrode potentials, the Nernst equation and Faraday's laws (port of
# rust-old/src/electrochemistry.rs).
#
# Standard electrode potentials are for reduction half-reactions at 25 °C, 1 atm and 1 M, against the standard
# hydrogen electrode (SHE). Potentials are in volts, charges in coulombs, masses in grams. The data — the 49
# STANDARD_POTENTIALS rows — is src/electrochemistry_data.cyr (generated); FARADAY and ELEMENTARY_CHARGE are
# src/constants.cyr's KM_FARADAY and KM_ELEMENTARY_CHARGE. Fallible functions return a value-form Result whose
# Err payload is a KM_ERR_* code, and reject NaN and ±∞ inputs. Every expression keeps Rust's operation order,
# so everything but the Nernst equation is + − × ÷ and bit-identical (class B); the Nernst functions are class
# C through one ln (docs/development/port-parity.md §7, §10).
#
# - Rows are reached by handle (port plan §6.4): STANDARD_POTENTIALS row + 1, 0 for None. HalfReaction's
#   fields are half_reaction_equation(h) / half_reaction_couple(h) ("" for an invalid handle),
#   half_reaction_electrons(h) (0: no row has 0) and half_reaction_standard_potential(h) (NaN).
# - Rust's `n_electrons: u8` is a word here: one outside 0 ..= 255 is Err(KM_ERR_INVALID_INPUT) at the position
#   of Rust's `== 0` check (one test, n < 1 || n > 255), never wrapped mod 256.
# - The Nernst equation's ln is src/mathx.cyr's correctly rounded _km_cr_ln (ADR 0006): E° − (RT/nF)·ln Q
#   cancels where E° ≈ (RT/nF)·ln Q, and there one ulp of the log moves E by many, so the rows are compared
#   exactly against the corrected oracle.

include "lib/string.cyr"

# The STANDARD_POTENTIALS row of handle h (h − 1), or -1 if h is no handle.
#must_use
fn _km_half_reaction_row(h): i64 {
    if (h >= 1 && h <= KM_STANDARD_POTENTIALS_COUNT) { return h - 1; }
    return 0 - 1;
}

# 1 if the word n is a valid electron count: a Rust u8 (0 ..= 255) that is not 0.
#must_use
fn _km_is_electron_count(n): i64 {
    if (n < 1 || n > 255) { return 0; }
    return 1;
}

# ── standard electrode potentials ───────────────────────────────────────────────────

# The half-reaction whose couple is the C string `couple`, exactly and case-sensitively ("Cu2+/Cu"), as a
# handle (its STANDARD_POTENTIALS row + 1); 0 when none matches (or `couple` is 0). The first match in table
# order, as Rust's linear `find` (the couples are unique). Mirrors `electrochemistry::lookup_half_reaction`.
#must_use
fn lookup_half_reaction(couple): i64 {
    if (couple == 0) { return 0; }
    var c0 = load8(couple);
    if (c0 == 0) { return 0; }
    var n = strlen(couple);
    var row = 0;
    while (row < KM_STANDARD_POTENTIALS_COUNT) {
        var p = &_KM_STANDARD_POTENTIALS_COUPLE_BYTES + _KM_STANDARD_POTENTIALS_COUPLE_OFF[row];
        # The first byte decides most rows; memeq stops at p's NUL, which differs from couple's byte.
        if (load8(p) == c0) {
            if (memeq(p, couple, n) == 1 && load8(p + n) == 0) { return row + 1; }
        }
        row = row + 1;
    }
    return 0;
}

# The reduction half-reaction equation of STANDARD_POTENTIALS handle h ("Cu²⁺ + 2e⁻ → Cu") as a C string of
# UTF-8 bytes in the baked table; "" for an invalid handle. Mirrors `HalfReaction::equation`.
#must_use
fn half_reaction_equation(h): i64 {
    var row = _km_half_reaction_row(h);
    if (row < 0) { return ""; }
    return &_KM_STANDARD_POTENTIALS_EQUATION_BYTES + _KM_STANDARD_POTENTIALS_EQUATION_OFF[row];
}

# The couple (the species reduced) of STANDARD_POTENTIALS handle h ("Cu2+/Cu"); "" for an invalid handle.
# Mirrors `HalfReaction::couple`.
#must_use
fn half_reaction_couple(h): i64 {
    var row = _km_half_reaction_row(h);
    if (row < 0) { return ""; }
    return &_KM_STANDARD_POTENTIALS_COUPLE_BYTES + _KM_STANDARD_POTENTIALS_COUPLE_OFF[row];
}

# The number of electrons transferred in STANDARD_POTENTIALS handle h (1 ..= 5); 0 for an invalid handle, which
# no row has. Mirrors `HalfReaction::electrons`.
#must_use
fn half_reaction_electrons(h): i64 {
    var row = _km_half_reaction_row(h);
    if (row < 0) { return 0; }
    return KM_STANDARD_POTENTIALS_ELECTRONS[row];
}

# The standard reduction potential E° of STANDARD_POTENTIALS handle h, in V vs SHE; NaN for an invalid handle.
# Mirrors `HalfReaction::standard_potential`.
#must_use
fn half_reaction_standard_potential(h): f64 {
    var row = _km_half_reaction_row(h);
    if (row < 0) { return _km_nan(); }
    var e: f64 = KM_STANDARD_POTENTIALS_STANDARD_POTENTIAL[row];
    return e;
}

# ── the Nernst equation ─────────────────────────────────────────────────────────────

# The Nernst equation E = E° − (RT/nF)·ln Q: the electrode potential in V under non-standard conditions, from
# the standard potential E° (V), the electron count n (a Rust u8, as a word), T in K and the reaction quotient
# Q (product over reactant activities). Ok(E); Err(KM_ERR_INVALID_TEMPERATURE) if T is not positive and finite;
# Err(KM_ERR_INVALID_INPUT) if n is 0 or outside 0 ..= 255, Q is not positive and finite, or E° is not finite
# (in that order). ln Q is correctly rounded (_km_cr_ln, ADR 0006). Mirrors
# `electrochemistry::nernst_potential`.
#must_use
fn nernst_potential(standard_potential: f64, n_electrons, temperature_k: f64, reaction_quotient: f64): Result {
    if (_km_is_positive(temperature_k) != 1) { return Err(KM_ERR_INVALID_TEMPERATURE); }
    if (_km_is_electron_count(n_electrons) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    if (_km_is_positive(reaction_quotient) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    if (_km_is_finite(standard_potential) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    var r: f64 = KM_GAS_CONSTANT;
    var f: f64 = KM_FARADAY;
    var n: f64 = f64_from(n_electrons);
    var factor: f64 = (r * temperature_k) / (n * f);
    var l: f64 = _km_cr_ln(reaction_quotient);
    var e: f64 = standard_potential - (factor * l);
    return Ok(e);
}

# The Nernst equation at 25 °C, E = E° − (0.05916/n)·log₁₀ Q: nernst_potential at T = 298.15 K, so the
# 0.05916 V factor is not rounded. Ok(E), or Err(KM_ERR_INVALID_INPUT) if n is 0 or outside 0 ..= 255, Q is not
# positive and finite, or E° is not finite. Mirrors `electrochemistry::nernst_potential_25c`.
#must_use
fn nernst_potential_25c(standard_potential: f64, n_electrons, reaction_quotient: f64): Result {
    return nernst_potential(standard_potential, n_electrons, 298.15, reaction_quotient);
}

# ── cell potentials ─────────────────────────────────────────────────────────────────

# The standard cell potential E°_cell = E°_cathode − E°_anode, both standard reduction potentials in V; returns
# V. Non-finite input propagates to the result. Mirrors `electrochemistry::standard_cell_potential`.
#must_use
fn standard_cell_potential(e_cathode: f64, e_anode: f64): f64 {
    var e: f64 = e_cathode - e_anode;
    return e;
}

# The standard cell potential E°_cell in V from two couples (C strings, as lookup_half_reaction takes them):
# the cathode's couple is reduced (gains electrons), the anode's oxidised. Ok(E°_cell), or
# Err(KM_ERR_INVALID_REACTION) if a couple is not in STANDARD_POTENTIALS (the cathode's checked first). Mirrors
# `electrochemistry::cell_potential_from_couples`.
#must_use
fn cell_potential_from_couples(cathode_couple, anode_couple): Result {
    var hc = lookup_half_reaction(cathode_couple);
    if (hc == 0) { return Err(KM_ERR_INVALID_REACTION); }
    var ha = lookup_half_reaction(anode_couple);
    if (ha == 0) { return Err(KM_ERR_INVALID_REACTION); }
    var ec: f64 = half_reaction_standard_potential(hc);
    var ea: f64 = half_reaction_standard_potential(ha);
    var e: f64 = standard_cell_potential(ec, ea);
    return Ok(e);
}

# 1 if a galvanic cell of potential E°_cell (V) is spontaneous, E°_cell > 0; NaN is not. Mirrors
# `electrochemistry::is_spontaneous_cell`.
#must_use
fn is_spontaneous_cell(e_cell: f64): i64 {
    if (e_cell > 0.0) { return 1; }
    return 0;
}

# The Gibbs free energy of an electrochemical cell, ΔG = −nFE, in J per mole of reaction, from the electrons
# transferred per reaction n (a word) and the cell potential E (V). Ok(ΔG), or Err(KM_ERR_INVALID_INPUT) if n is
# 0 or outside 0 ..= 255 or E is not finite. Mirrors `electrochemistry::cell_gibbs_energy`.
#must_use
fn cell_gibbs_energy(n_electrons, cell_potential: f64): Result {
    if (_km_is_electron_count(n_electrons) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    if (_km_is_finite(cell_potential) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    var f: f64 = KM_FARADAY;
    var n: f64 = f64_from(n_electrons);
    var g: f64 = ((-n) * f) * cell_potential;
    return Ok(g);
}

# ── Faraday's laws ──────────────────────────────────────────────────────────────────

# Faraday's first law m = (Q × M)/(n × F): the mass deposited in g (negative for a negative charge, i.e.
# dissolution), from the charge passed Q (C), the molar mass M (g/mol) and the electrons per ion n (a word).
# Ok(m), or Err(KM_ERR_INVALID_INPUT) if n is 0 or outside 0 ..= 255, M is not positive and finite, or Q is not
# finite. Mirrors `electrochemistry::faraday_mass_deposited`.
#must_use
fn faraday_mass_deposited(charge_c: f64, molar_mass_g: f64, n_electrons): Result {
    if (_km_is_electron_count(n_electrons) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    if (_km_is_positive(molar_mass_g) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    if (_km_is_finite(charge_c) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    var f: f64 = KM_FARADAY;
    var n: f64 = f64_from(n_electrons);
    var m: f64 = (charge_c * molar_mass_g) / (n * f);
    return Ok(m);
}

# The charge needed to deposit a mass, Q = (m × n × F)/M, in C, from the mass m (g), the molar mass M (g/mol) and
# the electrons per ion n (a word). Ok(Q), or Err(KM_ERR_INVALID_INPUT) if n is 0 or outside 0 ..= 255, M is not
# positive and finite, or m is not finite. Mirrors `electrochemistry::faraday_charge_required`.
#must_use
fn faraday_charge_required(mass_g: f64, molar_mass_g: f64, n_electrons): Result {
    if (_km_is_electron_count(n_electrons) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    if (_km_is_positive(molar_mass_g) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    if (_km_is_finite(mass_g) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    var f: f64 = KM_FARADAY;
    var n: f64 = f64_from(n_electrons);
    var q: f64 = ((mass_g * n) * f) / molar_mass_g;
    return Ok(q);
}

# Faraday's second law: the same charge deposits masses in the ratio of the equivalent weights M/n. The mass of
# substance B in g deposited while mass_a_g grams of A are, from the molar masses (g/mol) and electron counts
# (words) of A and B. Ok(m_B), or Err(KM_ERR_INVALID_INPUT) if an electron count is 0 or outside 0 ..= 255, either
# molar mass is not positive and finite (A's checked first), or mass_a_g is not finite. Mirrors
# `electrochemistry::faraday_mass_ratio`.
#must_use
fn faraday_mass_ratio(mass_a_g: f64, molar_mass_a: f64, n_electrons_a, molar_mass_b: f64, n_electrons_b): Result {
    if (_km_is_electron_count(n_electrons_a) != 1 || _km_is_electron_count(n_electrons_b) != 1) {
        return Err(KM_ERR_INVALID_INPUT);
    }
    if (_km_is_positive(molar_mass_a) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    if (_km_is_positive(molar_mass_b) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    if (_km_is_finite(mass_a_g) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    var na: f64 = f64_from(n_electrons_a);
    var nb: f64 = f64_from(n_electrons_b);
    var equiv_a: f64 = molar_mass_a / na;
    var equiv_b: f64 = molar_mass_b / nb;
    var m: f64 = (mass_a_g * equiv_b) / equiv_a;
    return Ok(m);
}

# ── utility ─────────────────────────────────────────────────────────────────────────

# Charge Q (C) to moles of electrons, n_e = Q / F. Non-finite input propagates to the result. Mirrors
# `electrochemistry::charge_to_moles_electrons`.
#must_use
fn charge_to_moles_electrons(charge_c: f64): f64 {
    var f: f64 = KM_FARADAY;
    var n: f64 = charge_c / f;
    return n;
}

# Moles of electrons to charge (C), Q = n_e × F. Non-finite input propagates to the result. Mirrors
# `electrochemistry::moles_electrons_to_charge`.
#must_use
fn moles_electrons_to_charge(moles: f64): f64 {
    var f: f64 = KM_FARADAY;
    var q: f64 = moles * f;
    return q;
}

# --- kinetics.cyr ---

# kinetics.cyr — chemical kinetics: rate constants, integrated rate laws, half-lives, the steady-state and
# pre-equilibrium approximations, Michaelis–Menten enzyme kinetics, collision theory and transition-state
# (Eyring) theory (port of rust-old/src/kinetics.rs).
#
# Units: concentrations in mol/L, time in s, energies in J/mol, temperatures in K. Rate constants carry the
# units of their reaction order n, (mol/L)^(1−n)·s⁻¹: zero order mol·L⁻¹·s⁻¹, first order s⁻¹, second order
# L·mol⁻¹·s⁻¹. Any consistent time unit may be used instead of seconds, except in the Eyring functions, whose
# prefactor k_B·T/h is in s⁻¹. The constants KM_GAS_CONSTANT, KM_BOLTZMANN (Rust's kinetics::BOLTZMANN) and
# KM_PLANCK are src/constants.cyr's (generated). Fallible functions return a value-form Result whose Err payload
# is a KM_ERR_* code, and reject NaN and ±∞ inputs where Rust does. Every expression keeps Rust's operation
# order, so the arithmetic functions are bit-identical (class B); the exp, exp_m1 and pow functions are class C
# (docs/development/port-parity.md §8, §10).
#
# - exp, exp_m1 and powf are src/mathx.cyr's correctly rounded _km_cr_exp, _km_cr_expm1 and _km_cr_pow
#   (ADR 0006), subnormal results and exact ties included. Where an exp or pow result is subnormal and a prefactor
#   scales it back into the normal range (A·e^x with x below −708, [A]₀^(n−1) in the nth-order denominator), one
#   ulp of it is a large relative change, so only correctly rounded primitives can match the reference there:
#   the six class-C functions are compared exactly against the corrected oracle, the oracle's operations with
#   every primitive result correctly rounded (glibc's pow misrounds exact ties such as (3·2⁻²¹⁵)⁵, where the
#   port is right and the oracle is not).
# - Rust's std::f64::consts::LN_2 and its private FIRST_ORDER_TOLERANCE (10⁻¹²) are typed formula constants
#   inline (port plan §6.4): LN_2 by its bits, 0x3FE62E42FEFA39EF, as src/mathx.cyr writes ln 2's high part. Both
#   are pinned by golden rows (half_life_first_order(1) is LN_2 exactly; orders at 1 ± 10⁻¹² and the ulps
#   either side) and by tests/kinetics.tcyr.
# - lineweaver_burk's (slope, intercept) tuple becomes the caller's buffer of two f64 (16 bytes,
#   `var lb[16];`), as peng_robinson_z_roots's Vec: Ok(2), the count written, with the slope at out and the
#   intercept at out + 8; on Err the buffer is untouched.

# Arrhenius rate constant k = A·exp(−Ea/(R·T)), from the pre-exponential factor A (in the units of the
# returned rate constant), the activation energy Ea in J/mol and T in K. Ok(k) in the units of A;
# Err(KM_ERR_INVALID_TEMPERATURE) if T is not positive and finite; Err(KM_ERR_INVALID_INPUT) if A or Ea is not
# finite. exp may overflow (Ok(+∞), or Ok(NaN) for A = 0) or underflow to 0, as in Rust. Mirrors
# `kinetics::arrhenius_rate`.
#must_use
fn arrhenius_rate(pre_exponential: f64, activation_energy_j: f64, temperature_k: f64): Result {
    if (_km_is_positive(temperature_k) != 1) { return Err(KM_ERR_INVALID_TEMPERATURE); }
    if (_km_is_finite(pre_exponential) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    if (_km_is_finite(activation_energy_j) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    var nea: f64 = -activation_energy_j;
    var x: f64 = nea / (KM_GAS_CONSTANT * temperature_k);
    var e: f64 = _km_cr_exp(x);
    var k: f64 = pre_exponential * e;
    return Ok(k);
}

# Half-life of a first-order reaction t½ = ln 2 / k in s, from the rate constant k in s⁻¹. Ok(t½), or
# Err(KM_ERR_INVALID_INPUT) if k is not positive and finite. Mirrors `kinetics::half_life_first_order`.
#must_use
fn half_life_first_order(rate_constant: f64): Result {
    if (_km_is_positive(rate_constant) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    var ln2: f64 = 0x3FE62E42FEFA39EF;     # std::f64::consts::LN_2
    var t: f64 = ln2 / rate_constant;
    return Ok(t);
}

# The concentration remaining after first-order decay, [A] = [A]₀·exp(−k·t) in mol/L, from [A]₀ in mol/L, k in
# s⁻¹ and t in s. Inputs are not validated: non-finite input propagates to the result. Mirrors
# `kinetics::first_order_concentration`.
#must_use
fn first_order_concentration(initial: f64, rate_constant: f64, time: f64): f64 {
    var nk: f64 = -rate_constant;
    var x: f64 = nk * time;
    var e: f64 = _km_cr_exp(x);
    var c: f64 = initial * e;
    return c;
}

# The concentration remaining after second-order decay, 1/[A] = 1/[A]₀ + k·t, in mol/L (in (0, [A]₀]), from
# [A]₀ in mol/L, k in L·mol⁻¹·s⁻¹ and t in s. Ok([A]); Err(KM_ERR_INVALID_CONCENTRATION) if [A]₀ is not positive
# and finite; Err(KM_ERR_INVALID_INPUT) if k or t is negative or not finite (k·t ≤ −1/[A]₀ would give an infinite
# or negative concentration). Mirrors `kinetics::second_order_concentration`.
#must_use
fn second_order_concentration(initial: f64, rate_constant: f64, time: f64): Result {
    if (_km_is_positive(initial) != 1) { return Err(KM_ERR_INVALID_CONCENTRATION); }
    if (_km_is_non_negative(rate_constant) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    if (_km_is_non_negative(time) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    var inv: f64 = (1.0 / initial) + (rate_constant * time);
    var c: f64 = 1.0 / inv;
    return Ok(c);
}

# The zero-order concentration [A] = [A]₀ − k·t in mol/L, from [A]₀ in mol/L, k in mol·L⁻¹·s⁻¹ and t in s, or
# +0.0 if that would be negative (the reaction is complete). Inputs are not validated: NaN propagates (Rust's
# `if remaining < 0.0 { 0.0 } else { remaining }`, not f64::max, which would turn NaN into 0.0), and −0.0
# stays −0.0. Mirrors `kinetics::zero_order_concentration`.
#must_use
fn zero_order_concentration(initial: f64, rate_constant: f64, time: f64): f64 {
    var remaining: f64 = initial - (rate_constant * time);
    if (remaining < 0.0) { return 0.0; }
    return remaining;
}

# The zero-order half-life t½ = [A]₀/(2k) in s, from [A]₀ in mol/L and k in mol·L⁻¹·s⁻¹. Ok(t½);
# Err(KM_ERR_INVALID_INPUT) if k is not positive and finite; Err(KM_ERR_INVALID_CONCENTRATION) if [A]₀ is not
# positive and finite (k checked first). Mirrors `kinetics::zero_order_half_life`.
#must_use
fn zero_order_half_life(initial: f64, rate_constant: f64): Result {
    if (_km_is_positive(rate_constant) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    if (_km_is_positive(initial) != 1) { return Err(KM_ERR_INVALID_CONCENTRATION); }
    var t: f64 = initial / (2.0 * rate_constant);
    return Ok(t);
}

# The general nth-order half-life t½ = (2^(n−1) − 1) / ((n − 1)·k·[A]₀^(n−1)) in s, for any finite order n ≠ 1,
# integer or fractional (n = 0 gives [A]₀/(2k), n = 2 gives 1/(k·[A]₀)); for n = 1 use half_life_first_order.
# 2^(n−1) − 1 is expm1((n − 1)·ln 2), so orders close to 1 keep full precision. From [A]₀ in mol/L, k in
# (mol/L)^(1−n)·s⁻¹ and n. Ok(t½); Err(KM_ERR_INVALID_INPUT) if n is not finite or |n − 1| ≤ 10⁻¹² (Rust's private
# FIRST_ORDER_TOLERANCE), or k is not positive and finite; Err(KM_ERR_INVALID_CONCENTRATION) if [A]₀ is not
# positive and finite; Err(KM_ERR_COMPUTATION_ERROR) if t½ is not positive and finite (extreme orders overflow or
# underflow). Mirrors `kinetics::nth_order_half_life`.
#must_use
fn nth_order_half_life(initial: f64, rate_constant: f64, order: f64): Result {
    var tol: f64 = 0.000000000001;          # FIRST_ORDER_TOLERANCE = 1e-12
    var n_minus_1: f64 = order - 1.0;
    var ad1: f64 = f64_abs(n_minus_1);
    if (_km_is_finite(order) != 1 || ad1 <= tol) { return Err(KM_ERR_INVALID_INPUT); }
    if (_km_is_positive(rate_constant) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    if (_km_is_positive(initial) != 1) { return Err(KM_ERR_INVALID_CONCENTRATION); }
    var ln2: f64 = 0x3FE62E42FEFA39EF;     # std::f64::consts::LN_2
    var numerator: f64 = _km_cr_expm1(n_minus_1 * ln2);
    var p: f64 = _km_cr_pow(initial, n_minus_1);
    var t_half: f64 = numerator / ((n_minus_1 * rate_constant) * p);
    if (_km_is_positive(t_half) == 1) { return Ok(t_half); }
    return Err(KM_ERR_COMPUTATION_ERROR);
}

# ── the steady-state and pre-equilibrium approximations ─────────────────────────────

# The steady-state concentration of the intermediate B in A →(k₁) B →(k₂) C: d[B]/dt = 0 gives
# [B]_ss = k₁·[A]/k₂ in mol/L, valid only when the intermediate is consumed much faster than it is formed
# (k₂ ≫ k₁). From the first-order rate constants k₁, k₂ in s⁻¹ and [A] in mol/L. Ok([B]_ss);
# Err(KM_ERR_INVALID_INPUT) if k₂ is not positive and finite or k₁ is negative or not finite;
# Err(KM_ERR_INVALID_CONCENTRATION) if [A] is negative or not finite. Mirrors
# `kinetics::steady_state_intermediate`.
#must_use
fn steady_state_intermediate(k1: f64, concentration_a: f64, k2: f64): Result {
    if (_km_is_positive(k2) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    if (_km_is_non_negative(k1) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    if (_km_is_non_negative(concentration_a) != 1) { return Err(KM_ERR_INVALID_CONCENTRATION); }
    var b: f64 = (k1 * concentration_a) / k2;
    return Ok(b);
}

# The rate of the rate-limiting step, rate = k_slow·[X] in mol·L⁻¹·s⁻¹, from k_slow in s⁻¹ and the
# concentration in mol/L. For A →(k₁) B →(k₂) C: if k₂ ≫ k₁ the first step is rate-determining (pass k₁ and
# [A]); if k₂ ≪ k₁, B accumulates and the second step is (pass k₂ and the actual [B]). Inputs are not
# validated: non-finite input propagates to the result. Mirrors `kinetics::steady_state_rate`.
#must_use
fn steady_state_rate(k_slow: f64, concentration: f64): f64 {
    var r: f64 = k_slow * concentration;
    return r;
}

# The pre-equilibrium approximation for A ⇌(K_eq) B →(k₂) C, K_eq = k₁/k₋₁: rate = k₂·(k₁/k₋₁)·[A] in
# mol·L⁻¹·s⁻¹, from the fast equilibrium's k₁ (`k_forward`) and k₋₁ (`k_reverse`, same units), k₂ (`k_slow`,
# s⁻¹) and [A] in mol/L. Ok(rate); Err(KM_ERR_INVALID_INPUT) if k₋₁ is not positive and finite or k₁ or k₂ is
# negative or not finite; Err(KM_ERR_INVALID_CONCENTRATION) if [A] is negative or not finite. Mirrors
# `kinetics::pre_equilibrium_rate`.
#must_use
fn pre_equilibrium_rate(k_forward: f64, k_reverse: f64, k_slow: f64, concentration_a: f64): Result {
    if (_km_is_positive(k_reverse) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    if (_km_is_non_negative(k_forward) != 1 || _km_is_non_negative(k_slow) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    if (_km_is_non_negative(concentration_a) != 1) { return Err(KM_ERR_INVALID_CONCENTRATION); }
    var rate: f64 = (k_slow * (k_forward / k_reverse)) * concentration_a;
    return Ok(rate);
}

# ── Michaelis–Menten enzyme kinetics ────────────────────────────────────────────────

# The Michaelis–Menten rate v = Vmax·[S]/(Km + [S]), from the maximum rate Vmax in mol·L⁻¹·s⁻¹, the Michaelis
# constant Km (the substrate concentration at half Vmax) in mol/L and the substrate concentration [S] in mol/L.
# Ok(v) in the units of Vmax; Err(KM_ERR_INVALID_INPUT) if Vmax or Km is not positive and finite (Vmax checked
# first); Err(KM_ERR_INVALID_CONCENTRATION) if [S] is negative or not finite. Mirrors
# `kinetics::michaelis_menten`.
#must_use
fn michaelis_menten(v_max: f64, km: f64, substrate: f64): Result {
    if (_km_is_positive(v_max) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    if (_km_is_positive(km) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    if (_km_is_non_negative(substrate) != 1) { return Err(KM_ERR_INVALID_CONCENTRATION); }
    var v: f64 = (v_max * substrate) / (km + substrate);
    return Ok(v);
}

# The Lineweaver–Burk linearisation 1/v = (Km/Vmax)·(1/[S]) + 1/Vmax: the plot's slope Km/Vmax (s) and intercept
# 1/Vmax (L·s/mol), from Vmax in mol·L⁻¹·s⁻¹ and Km in mol/L. `out` is the caller's buffer of two f64 (16 bytes,
# `var lb[16];`): Ok(2), the count written, with the slope at out and the intercept at out + 8; or
# Err(KM_ERR_INVALID_INPUT) if Vmax or Km is not positive and finite (Vmax checked first), and the buffer is
# untouched. Mirrors `kinetics::lineweaver_burk`, whose (slope, intercept) tuple the buffer replaces.
#must_use
fn lineweaver_burk(v_max: f64, km: f64, out): Result {
    if (_km_is_positive(v_max) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    if (_km_is_positive(km) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    var slope: f64 = km / v_max;
    var intercept: f64 = 1.0 / v_max;
    store64(out, slope);
    store64(out + 8, intercept);
    return Ok(2);
}

# ── collision theory ────────────────────────────────────────────────────────────────

# The collision-theory rate constant k = Z·p·exp(−Ea/(R·T)), from the collision frequency factor Z (in the units
# of the returned rate constant, e.g. L·mol⁻¹·s⁻¹ for a bimolecular reaction), the steric factor p (the
# probability of a correct orientation, 0 < p ≤ 1), Ea in J/mol and T in K. Ok(k) in the units of Z;
# Err(KM_ERR_INVALID_TEMPERATURE) if T is not positive and finite; Err(KM_ERR_INVALID_INPUT) if p is outside
# (0, 1] (NaN included: the check is Rust's positive form), Z is not positive and finite, or Ea is not finite.
# Mirrors `kinetics::collision_theory_rate`.
#must_use
fn collision_theory_rate(collision_frequency: f64, steric_factor: f64, activation_energy_j: f64,
    temperature_k: f64): Result {
    if (_km_is_positive(temperature_k) != 1) { return Err(KM_ERR_INVALID_TEMPERATURE); }
    var steric_ok = 0;
    if (steric_factor > 0.0 && steric_factor <= 1.0) { steric_ok = 1; }
    if (steric_ok != 1) { return Err(KM_ERR_INVALID_INPUT); }
    if (_km_is_positive(collision_frequency) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    if (_km_is_finite(activation_energy_j) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    var nea: f64 = -activation_energy_j;
    var x: f64 = nea / (KM_GAS_CONSTANT * temperature_k);
    var e: f64 = _km_cr_exp(x);
    var k: f64 = (collision_frequency * steric_factor) * e;
    return Ok(k);
}

# ── transition-state theory (the Eyring equation) ───────────────────────────────────

# The Eyring equation k = (k_B·T/h)·exp(−ΔG‡/(R·T)) in s⁻¹ (transmission coefficient κ = 1), from the Gibbs
# energy of activation ΔG‡ in J/mol and T in K. Ok(k); Err(KM_ERR_INVALID_TEMPERATURE) if T is not positive and
# finite; Err(KM_ERR_INVALID_INPUT) if ΔG‡ is not finite. Mirrors `kinetics::eyring_rate`.
#must_use
fn eyring_rate(delta_g_activation_j: f64, temperature_k: f64): Result {
    if (_km_is_positive(temperature_k) != 1) { return Err(KM_ERR_INVALID_TEMPERATURE); }
    if (_km_is_finite(delta_g_activation_j) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    var prefactor: f64 = (KM_BOLTZMANN * temperature_k) / KM_PLANCK;
    var ndg: f64 = -delta_g_activation_j;
    var x: f64 = ndg / (KM_GAS_CONSTANT * temperature_k);
    var e: f64 = _km_cr_exp(x);
    var k: f64 = prefactor * e;
    return Ok(k);
}

# The Eyring equation from the enthalpy and entropy of activation, k = (k_B·T/h)·exp(ΔS‡/R)·exp(−ΔH‡/(R·T)) in
# s⁻¹ (κ = 1), from ΔH‡ in J/mol, ΔS‡ in J/(mol·K) and T in K. Ok(k); Err(KM_ERR_INVALID_TEMPERATURE) if T is not
# positive and finite; Err(KM_ERR_INVALID_INPUT) if ΔH‡ or ΔS‡ is not finite (ΔH‡ checked first). The two exps
# are separate factors, as in Rust: one can overflow while the other underflows (Ok(NaN) for ∞·0). Mirrors
# `kinetics::eyring_rate_from_activation`.
#must_use
fn eyring_rate_from_activation(delta_h_activation_j: f64, delta_s_activation_j_per_k: f64,
    temperature_k: f64): Result {
    if (_km_is_positive(temperature_k) != 1) { return Err(KM_ERR_INVALID_TEMPERATURE); }
    if (_km_is_finite(delta_h_activation_j) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    if (_km_is_finite(delta_s_activation_j_per_k) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    var prefactor: f64 = (KM_BOLTZMANN * temperature_k) / KM_PLANCK;
    var xs: f64 = delta_s_activation_j_per_k / KM_GAS_CONSTANT;
    var es: f64 = _km_cr_exp(xs);
    var ndh: f64 = -delta_h_activation_j;
    var xh: f64 = ndh / (KM_GAS_CONSTANT * temperature_k);
    var eh: f64 = _km_cr_exp(xh);
    var k: f64 = (prefactor * es) * eh;
    return Ok(k);
}

