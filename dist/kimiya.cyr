var _KM_CR_SC_P4 = 0x384129024E088A68;   # 1.0085854035872483e-37
var _KM_CR_SC_P5 = 0xB4D9C5FEFA20ACE2;   # -4.2044856255549717e-54
var _KM_CR_SC_INVPIO2 = 0x3FE45F306DC9C883;   # 0.6366197723675814
var _KM_CR_SC_PIH = 0x400921FB54442D18;   # 3.141592653589793
var _KM_CR_SC_PIM = 0x3CA1A62633145C07;   # 1.2246467991473532e-16
var _KM_CR_SC_PIL = 0xB92F1976B7ED8FBC;   # -2.9947698097183397e-33
var _KM_CR_SC_PIO2H = 0x3FF921FB54442D18;   # 1.5707963267948966
var _KM_CR_SC_PIO2M = 0x3C91A62633145C07;   # 6.123233995736766e-17
var _KM_CR_SC_PIO2L = 0xB91F1976B7ED8FBC;   # -1.4973849048591698e-33
