# --- element.cyr ---

# element.cyr — elements: periodic-table lookups and the extended properties of 32 elements
# (port of rust-old/src/element.rs).
#
# Rust's lookups return `Option<&'static Element>` / `Option<&'static ElementProperties>`. Here
# they return a handle, 0 for None (port plan §6.4):
# - an element handle is its table row + 1, which is the atomic number Z (1–118);
# - a property handle is its row of ELEMENT_PROPERTIES + 1 (1–32).
# The Rust struct fields become accessors of the handle, reading the generated
# element_data.cyr columns (IUPAC/CIAAW weights, Pauling electronegativities), so no value is
# typed here. Rust can't hold a dangling reference; a Cyrius caller can pass any word, and an
# out-of-range handle never reads out of bounds: it gets the field's "none" value (0, "", NaN,
# None or -1, as each accessor says). AVOGADRO and GAS_CONSTANT are KM_AVOGADRO and
# KM_GAS_CONSTANT in src/constants.cyr.

include "lib/string.cyr"

# The element row of handle h (h − 1), or -1 if h is no element handle.
#must_use
fn _km_element_row(h): i64 {
    if (h >= 1 && h <= KM_ELEMENT_COUNT) { return h - 1; }
    return 0 - 1;
}

# The property row of handle p (p − 1), or -1 if p is no property handle.
#must_use
fn _km_properties_row(p): i64 {
    if (p >= 1 && p <= KM_ELEMENT_PROPERTIES_COUNT) { return p - 1; }
    return 0 - 1;
}

# ── lookups ─────────────────────────────────────────────────────────────────────────

# The element with atomic number z, as a handle (z itself), or 0 for z outside 1–118. O(1):
# indexes the table directly and checks the row's atomic number, as Rust does. Mirrors
# `element::lookup_by_number`.
#must_use
fn element_lookup_by_number(z): i64 {
    if (z < 1 || z > KM_ELEMENT_COUNT) { return 0; }
    if (KM_ELEMENT_ATOMIC_NUMBER[z - 1] != z) { return 0; }
    return z;
}

# The element whose symbol is the C string `sym`, exactly and case-sensitively ("Fe", not
# "fe" or "FE"), as a handle; 0 when none matches (or `sym` is 0). The first match in Z order,
# as Rust's linear `find`. Mirrors `element::lookup_by_symbol`.
#must_use
fn element_lookup_by_symbol(sym): i64 {
    if (sym == 0) { return 0; }
    var c0 = load8(sym);
    if (c0 == 0) { return 0; }
    var n = strlen(sym);
    var row = 0;
    while (row < KM_ELEMENT_COUNT) {
        var p = &_KM_ELEMENT_SYMBOL_BYTES + _KM_ELEMENT_SYMBOL_OFF[row];
        # The first byte decides most rows. memeq stops at the first differing byte, so it reads
        # no further than p's NUL (sym has no NUL in its first n bytes).
        if (load8(p) == c0) {
            if (memeq(p, sym, n) == 1 && load8(p + n) == 0) { return row + 1; }
        }
        row = row + 1;
    }
    return 0;
}

# The extended properties of the element with atomic number z, as a property handle, or 0 when
# none are tabulated (32 elements: Z = 1–20, 24–30, 35, 47, 53, 79, 82). Mirrors
# `element::lookup_properties`.
#must_use
fn element_lookup_properties(z): i64 {
    var row = 0;
    while (row < KM_ELEMENT_PROPERTIES_COUNT) {
        if (KM_ELEMENT_PROPERTIES_ATOMIC_NUMBER[row] == z) { return row + 1; }
        row = row + 1;
    }
    return 0;
}

# ── Element fields ──────────────────────────────────────────────────────────────────

# Atomic number Z, 1–118; 0 for an invalid handle. Mirrors `Element::atomic_number`.
#must_use
fn element_atomic_number(h): i64 {
    var row = _km_element_row(h);
    if (row < 0) { return 0; }
    return KM_ELEMENT_ATOMIC_NUMBER[row];
}

# IUPAC chemical symbol (`"Fe"`) as a C string in the baked table; "" for an invalid handle.
# Mirrors `Element::symbol`.
#must_use
fn element_symbol(h): i64 {
    var row = _km_element_row(h);
    if (row < 0) { return ""; }
    return &_KM_ELEMENT_SYMBOL_BYTES + _KM_ELEMENT_SYMBOL_OFF[row];
}

# English element name (`"Iron"`) as a C string in the baked table; "" for an invalid handle.
# Mirrors `Element::name`.
#must_use
fn element_name(h): i64 {
    var row = _km_element_row(h);
    if (row < 0) { return ""; }
    return &_KM_ELEMENT_NAME_BYTES + _KM_ELEMENT_NAME_OFF[row];
}

# Standard atomic weight in g/mol (IUPAC/CIAAW abridged or conventional value; the mass number
# of a long-lived isotope for elements without stable isotopes); NaN for an invalid handle.
# Mirrors `Element::atomic_mass`.
#must_use
fn element_atomic_mass(h): f64 {
    var row = _km_element_row(h);
    if (row < 0) { return _km_nan(); }
    var m: f64 = KM_ELEMENT_ATOMIC_MASS[row];
    return m;
}

# Pauling electronegativity: Some(f64), or None where no value is established (He, Ne, Ar and
# most superheavy elements) and for an invalid handle. Read it with
# `var t, v = element_electronegativity(h); if (is_some(t) == 1) { var en: f64 = v; .. }`.
# Mirrors `Element::electronegativity`.
#must_use
fn element_electronegativity(h): Option {
    var row = _km_element_row(h);
    if (row < 0) { return None(); }
    if (KM_ELEMENT_HAS_ELECTRONEGATIVITY[row]) {
        var en: f64 = KM_ELEMENT_ELECTRONEGATIVITY[row];
        return Some(en);
    }
    return None();
}

# Periodic-table category, a KmElementCategory value; -1 for an invalid handle. Mirrors
# `Element::category`.
#must_use
fn element_category(h): i64 {
    var row = _km_element_row(h);
    if (row < 0) { return 0 - 1; }
    return KM_ELEMENT_CATEGORY[row];
}

# ── ElementProperties fields ────────────────────────────────────────────────────────

# Atomic number Z of the element the properties describe; 0 for an invalid handle. Mirrors
# `ElementProperties::atomic_number`.
#must_use
fn element_properties_atomic_number(p): i64 {
    var row = _km_properties_row(p);
    if (row < 0) { return 0; }
    return KM_ELEMENT_PROPERTIES_ATOMIC_NUMBER[row];
}

# First ionization energy, kJ/mol; NaN for an invalid handle. Mirrors
# `ElementProperties::ionization_energy_1`.
#must_use
fn element_properties_ionization_energy_1(p): f64 {
    var row = _km_properties_row(p);
    if (row < 0) { return _km_nan(); }
    var v: f64 = KM_ELEMENT_PROPERTIES_IONIZATION_ENERGY_1[row];
    return v;
}

# Electron affinity, kJ/mol (negative = energy released); NaN for an invalid handle. Mirrors
# `ElementProperties::electron_affinity`.
#must_use
fn element_properties_electron_affinity(p): f64 {
    var row = _km_properties_row(p);
    if (row < 0) { return _km_nan(); }
    var v: f64 = KM_ELEMENT_PROPERTIES_ELECTRON_AFFINITY[row];
    return v;
}

# Covalent radius, pm; NaN for an invalid handle. Mirrors `ElementProperties::covalent_radius_pm`.
#must_use
fn element_properties_covalent_radius_pm(p): f64 {
    var row = _km_properties_row(p);
    if (row < 0) { return _km_nan(); }
    var v: f64 = KM_ELEMENT_PROPERTIES_COVALENT_RADIUS_PM[row];
    return v;
}

# How many common oxidation states are listed; 0 for an invalid handle. With
# element_properties_oxidation_state, this mirrors the slice `ElementProperties::oxidation_states`.
#must_use
fn element_properties_oxidation_state_count(p): i64 {
    var row = _km_properties_row(p);
    if (row < 0) { return 0; }
    return KM_ELEMENT_PROPERTIES_OXIDATION_STATE_COUNT[row];
}

# The k-th common oxidation state (most common first), as Some(state); None when k is outside
# 0 .. count − 1 or the handle is invalid (a state can be 0 or negative, so there is no sentinel).
# Mirrors `ElementProperties::oxidation_states[k]`.
#must_use
fn element_properties_oxidation_state(p, k): Option {
    if (k < 0 || k >= element_properties_oxidation_state_count(p)) { return None(); }
    var row = p - 1;
    var at = KM_ELEMENT_PROPERTIES_OXIDATION_STATE_START[row] + k;
    var state = KM_ELEMENT_PROPERTIES_OXIDATION_STATES[at];
    return Some(state);
}

# --- molecule.cyr ---

# molecule.cyr — molecules: composition as (element, count) pairs, molecular weight and
# formula strings (port of rust-old/src/molecule.rs).
#
# Rust's `Molecule { atoms: Vec<Atom> }` is `struct KmMolecule` over a vec (lib/vec.cyr) that
# holds two words per atom: its atomic number, then its count. Methods are called on the value,
# `m.molecular_weight()`; constructors are `KmMolecule_new(pairs, n)` and the presets
# (`KmMolecule_water()`, …), port plan §6.4.
# - Rust's `Atom::count` is a u32, so a count is stored mod 2^32 (as `as u32`). An atomic number
#   is stored as given: outside 1–118 it names no element, so molecular_weight and formula give
#   Err(KM_ERR_INVALID_ELEMENT), as Rust does for an unknown u8.
# - The library never aborts: if the atom vec can't be allocated the molecule has no atoms
#   (`atoms` is 0), and molecular_weight and formula give Err(KM_ERR_COMPUTATION_ERROR).
# - Every expression keeps Rust's operation order, so molecular_weight is bit-identical (class B,
#   0 ulp expected).
# - The three methods walk the vec's buffer directly (lib/vec.cyr documents its layout,
#   { data, len, cap }): per-atom vec_get calls made molecular_weight 4× slower (M1 bench).

include "lib/vec.cyr"
include "lib/str.cyr"

struct KmMolecule {
    atoms;   # vec of 2 words per atom (atomic number, count), or 0 if allocation failed
}

# The presets' (Z, count) pairs, as in rust-old/src/molecule.rs (the golden rows pin them).
var _KM_MOLECULE_WATER: i64[4] = { 1, 2, 8, 1 };
var _KM_MOLECULE_CARBON_DIOXIDE: i64[4] = { 6, 1, 8, 2 };
var _KM_MOLECULE_METHANE: i64[4] = { 6, 1, 1, 4 };
var _KM_MOLECULE_GLUCOSE: i64[6] = { 6, 6, 1, 12, 8, 6 };

# The largest pair count a molecule takes: the vec's capacity limit, halved (2 words per atom).
const _KM_MOLECULE_MAX_ATOMS = 0x4000000;

impl KmMolecule {
    # A molecule from `n` (atomic number, count) pairs at `pairs`, a flat array of 2n words
    # (Z0, count0, Z1, count1, …), kept in the order given; repeated elements stay separate
    # entries. Mirrors `Molecule::new`.
    #must_use
    fn new(pairs, n): KmMolecule {
        var m: KmMolecule;
        m.atoms = 0;
        if (n < 0 || n > _KM_MOLECULE_MAX_ATOMS || (n > 0 && pairs == 0)) { return m; }
        var a = default_alloc();
        var v = vec_new_a(a);
        if (v == 0) { return m; }
        var k = 0;
        while (k < n) {
            var z = load64(pairs + k * 16);
            var c = load64(pairs + k * 16 + 8) & 0xFFFFFFFF;
            if (vec_push_a(a, v, z) != 0) { return m; }
            if (vec_push_a(a, v, c) != 0) { return m; }
            k = k + 1;
        }
        m.atoms = v;
        return m;
    }

    # Water: H₂O. Mirrors `Molecule::water`.
    #must_use
    fn water(): KmMolecule { return KmMolecule_new(&_KM_MOLECULE_WATER, 2); }

    # Carbon dioxide: CO₂. Mirrors `Molecule::carbon_dioxide`.
    #must_use
    fn carbon_dioxide(): KmMolecule { return KmMolecule_new(&_KM_MOLECULE_CARBON_DIOXIDE, 2); }

    # Methane: CH₄. Mirrors `Molecule::methane`.
    #must_use
    fn methane(): KmMolecule { return KmMolecule_new(&_KM_MOLECULE_METHANE, 2); }

    # Glucose: C₆H₁₂O₆. Mirrors `Molecule::glucose`.
    #must_use
    fn glucose(): KmMolecule { return KmMolecule_new(&_KM_MOLECULE_GLUCOSE, 3); }

    # How many atom entries the molecule holds (Rust: `atoms.len()`).
    #must_use
    fn atoms_len(self): i64 {
        if (self.atoms == 0) { return 0; }
        return vec_len(self.atoms) / 2;
    }

    # Atom entry k's atomic number (Rust: `atoms[k].element_number`); -1 when k is out of range.
    #must_use
    fn atom_element_number(self, k): i64 {
        if (k < 0 || k >= self.atoms_len()) { return 0 - 1; }
        return vec_get(self.atoms, 2 * k);
    }

    # Atom entry k's count (Rust: `atoms[k].count`, a u32); -1 when k is out of range.
    #must_use
    fn atom_count(self, k): i64 {
        if (k < 0 || k >= self.atoms_len()) { return 0 - 1; }
        return vec_get(self.atoms, 2 * k + 1);
    }

    # Molecular weight in g/mol, Σ atomic mass × count in atom order: Ok(f64), or
    # Err(KM_ERR_INVALID_ELEMENT) if an atom names no element (even with count 0). Mirrors
    # `Molecule::molecular_weight`.
    #must_use
    fn molecular_weight(self): Result {
        if (self.atoms == 0) { return Err(KM_ERR_COMPUTATION_ERROR); }
        var total: f64 = 0.0;
        var data = load64(self.atoms);      # lib/vec.cyr's layout: { data, len, cap }
        var end = data + vec_len(self.atoms) * 8;
        var at = data;
        while (at < end) {
            var h = element_lookup_by_number(load64(at));
            if (h == 0) { return Err(KM_ERR_INVALID_ELEMENT); }
            var mass: f64 = KM_ELEMENT_ATOMIC_MASS[h - 1];   # row h − 1, checked above
            var count: f64 = f64_from(load64(at + 8));
            total = total + (mass * count);
            at = at + 16;
        }
        return Ok(total);
    }

    # Molecular formula ("H2O", "CO2", "C6H12O6") as Ok(Str): atoms in stored order (no Hill
    # ordering, no merging of repeated elements, no reduction to the empirical formula), a count
    # of 1 without a digit, and atoms with a count of 0 omitted, but only after their element is
    # looked up, so an unknown element is Err(KM_ERR_INVALID_ELEMENT) whatever its count.
    # Err(KM_ERR_COMPUTATION_ERROR) if the string can't be allocated. Mirrors `Molecule::formula`.
    #must_use
    fn formula(self): Result {
        if (self.atoms == 0) { return Err(KM_ERR_COMPUTATION_ERROR); }
        var a = default_alloc();
        var sb = str_builder_new_a(a);
        if (sb == 0) { return Err(KM_ERR_COMPUTATION_ERROR); }
        var data = load64(self.atoms);
        var end = data + vec_len(self.atoms) * 8;
        var at = data;
        while (at < end) {
            var h = element_lookup_by_number(load64(at));
            if (h == 0) { return Err(KM_ERR_INVALID_ELEMENT); }
            var count = load64(at + 8);
            if (count != 0) {
                if (str_builder_add_cstr_a(a, sb, element_symbol(h)) != 0) {
                    return Err(KM_ERR_COMPUTATION_ERROR);
                }
                if (count > 1) {
                    if (str_builder_add_int_a(a, sb, count) != 0) {
                        return Err(KM_ERR_COMPUTATION_ERROR);
                    }
                }
            }
            at = at + 16;
        }
        var s = str_builder_build_a(a, sb);
        if (s == 0) { return Err(KM_ERR_COMPUTATION_ERROR); }
        return Ok(s);
    }

    # Total number of atoms, saturating at u32::MAX (4294967295) instead of overflowing.
    # Mirrors `Molecule::total_atoms`.
    #must_use
    fn total_atoms(self): i64 {
        if (self.atoms == 0) { return 0; }
        var total = 0;
        var data = load64(self.atoms);
        var end = data + vec_len(self.atoms) * 8;
        var at = data + 8;
        while (at < end) {
            total = total + load64(at);
            if (total > 0xFFFFFFFF) { total = 0xFFFFFFFF; }
            at = at + 16;
        }
        return total;
    }
}

# --- reaction.cyr ---

# reaction.cyr — reaction thermodynamics: Gibbs free energy (ΔG = ΔH − TΔS), the equilibrium
# constant K = exp(−ΔG/RT) and spontaneity (port of rust-old/src/reaction.rs).
#
# SI units throughout: J/mol, J/(mol·K), K. Fallible functions return a value-form Result whose
# Err payload is a KM_ERR_* code, and reject NaN and ±∞ inputs instead of returning Ok(NaN).
# Every expression keeps Rust's operation order: gibbs_free_energy is bit-identical (class B);
# equilibrium_constant's one exp is f64_exp (class C, docs/development/port-parity.md), which
# lib/math.cyr supplies on aarch64 (its polyfill).

include "lib/math.cyr"

# Gibbs free energy ΔG = ΔH − T·ΔS in J/mol, from ΔH in J/mol, T in K and ΔS in J/(mol·K):
# Ok(ΔG), Err(KM_ERR_INVALID_TEMPERATURE) if T is not positive and finite, or
# Err(KM_ERR_INVALID_INPUT) if ΔH or ΔS is not finite. Mirrors `reaction::gibbs_free_energy`.
#must_use
fn gibbs_free_energy(enthalpy_j: f64, temperature_k: f64, entropy_j_per_k: f64): Result {
    if (_km_is_positive(temperature_k) != 1) { return Err(KM_ERR_INVALID_TEMPERATURE); }
    if (_km_is_finite(enthalpy_j) != 1 || _km_is_finite(entropy_j_per_k) != 1) {
        return Err(KM_ERR_INVALID_INPUT);
    }
    var g: f64 = enthalpy_j - (temperature_k * entropy_j_per_k);
    return Ok(g);
}

# Equilibrium constant K = exp(−ΔG / (R·T)), dimensionless, from ΔG in J/mol and T in K. For
# ΔG/RT above ≈ 745 it underflows to 0.0. Ok(K), Err(KM_ERR_INVALID_TEMPERATURE) if T is not
# positive and finite, Err(KM_ERR_INVALID_INPUT) if ΔG is not finite, or
# Err(KM_ERR_COMPUTATION_ERROR) if K overflows f64 (−ΔG/RT > ≈ 709.8, e.g. ΔG = −2 MJ/mol at
# 298 K); work with ln K = −ΔG/RT instead. Mirrors `reaction::equilibrium_constant`.
#must_use
fn equilibrium_constant(delta_g_j: f64, temperature_k: f64): Result {
    if (_km_is_positive(temperature_k) != 1) { return Err(KM_ERR_INVALID_TEMPERATURE); }
    if (_km_is_finite(delta_g_j) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    var x: f64 = -delta_g_j / (KM_GAS_CONSTANT * temperature_k);
    var k: f64 = f64_exp(x);
    if (_km_is_finite(k) != 1) { return Err(KM_ERR_COMPUTATION_ERROR); }
    return Ok(k);
}

# 1 if a reaction with this ΔG (any energy unit) is spontaneous, ΔG < 0; 0 otherwise, NaN
# included. Mirrors `reaction::is_spontaneous`.
#must_use
fn is_spontaneous(delta_g: f64): i64 {
    if (delta_g < 0.0) { return 1; }
    return 0;
}

# --- thermo.cyr ---

# thermo.cyr — basic calorimetry and thermochemistry: heat transfer (q = m·c·ΔT), Hess's law,
# reaction enthalpy from formation enthalpies, and specific heat from calorimetry (port of
# rust-old/src/thermo.rs).
#
# Calorimetry functions use grams and J/(g·°C) (a temperature *difference* in °C equals one in K);
# enthalpies are in J or J/mol as passed in. Every function is + − × ÷ in Rust's operation order,
# so every result is bit-identical (class B). WATER_SPECIFIC_HEAT is KM_WATER_SPECIFIC_HEAT in
# src/constants.cyr (generated; thermo has no data file of its own).
# - A Rust slice `&[f64]` is a pointer to n f64 values and the count n. Rust's f64 `sum` folds from
#   −0.0, so the sum of no values is −0.0, as here. A count below 0, or a null pointer with values,
#   is no slice: the result is NaN (these functions have no error channel).
# - specific_heat_from_calorimetry's zero-ΔT threshold is hisab's EPSILON_F64 (10⁻¹²), the same
#   constant as Rust hisab 1.4.0's (port plan §6.2). hisab is included explicitly: `cyrius distlib`
#   keeps a non-stdlib include in place in dist/kimiya.cyr, so a consumer needs kimiya's
#   [deps.hisab] (port plan §6.4).

include "lib/hisab.cyr"

# Σ of the n f64 values at xs in order, from −0.0 (Rust's `iter().sum()`); NaN if (xs, n) is no slice.
#must_use
fn _km_sum(xs, n): f64 {
    if (n < 0 || (n > 0 && xs == 0)) { return _km_nan(); }
    var s: f64 = -0.0;
    var k = 0;
    while (k < n) {
        var x: f64 = load64(xs + k * 8);
        s = s + x;
        k = k + 1;
    }
    return s;
}

# Heat transfer q = m × c × ΔT in J, from the mass in g, the specific heat in J/(g·°C) and ΔT in °C.
# Mirrors `thermo::heat_transfer`.
#must_use
fn heat_transfer(mass_g: f64, specific_heat: f64, delta_t: f64): f64 {
    var q: f64 = (mass_g * specific_heat) * delta_t;
    return q;
}

# Hess's law: the total enthalpy change, the sum of the n step enthalpies at `enthalpies_j` in
# order, in their unit (e.g. J/mol); −0.0 for no steps, NaN if (enthalpies_j, n) is no slice.
# Mirrors `thermo::hess_law`.
#must_use
fn hess_law(enthalpies_j, n): f64 {
    var s: f64 = _km_sum(enthalpies_j, n);
    return s;
}

# Enthalpy of reaction from formation enthalpies, ΔH_rxn = Σ ΔH_f(products) − Σ ΔH_f(reactants):
# `products_hf` holds np values and `reactants_hf` nr, each ΔH_f already multiplied by its
# stoichiometric coefficient (e.g. J/mol of reaction); the result is in the same unit. NaN if
# either is no slice. Mirrors `thermo::enthalpy_from_formation`.
#must_use
fn enthalpy_from_formation(products_hf, np, reactants_hf, nr): f64 {
    var sum_products: f64 = _km_sum(products_hf, np);
    var sum_reactants: f64 = _km_sum(reactants_hf, nr);
    var d: f64 = sum_products - sum_reactants;
    return d;
}

# Specific heat at constant pressure from calorimetry, c_p = q / (m × ΔT) in J/(g·°C), from q in J,
# m in g and ΔT in °C (or K): Ok(c_p), or Err(KM_ERR_INVALID_INPUT) if q is not finite, m is not
# positive and finite, or ΔT is non-finite or zero (|ΔT| < 10⁻¹², hisab's EPSILON_F64). Mirrors
# `thermo::specific_heat_from_calorimetry`.
#must_use
fn specific_heat_from_calorimetry(energy_j: f64, mass_g: f64, delta_t: f64): Result {
    if (_km_is_finite(energy_j) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    if (_km_is_positive(mass_g) != 1) { return Err(KM_ERR_INVALID_INPUT); }
    var eps: f64 = EPSILON_F64;
    var adt: f64 = f64_abs(delta_t);
    if (_km_is_finite(delta_t) != 1 || adt < eps) { return Err(KM_ERR_INVALID_INPUT); }
    var c: f64 = energy_j / (mass_g * delta_t);
    return Ok(c);
}

# --- thermochem_data.cyr ---

# kimiya — thermochemical data: formation enthalpies, Gibbs energies, entropies, Shomate segments
#
# GENERATED by scripts/oracle from kimiya 1.2.0 (rust-old/), hisab 1.4.0. Do not edit.
# Regenerate: cargo run --release --locked --manifest-path scripts/oracle/Cargo.toml
#
# THERMOCHEM_DATA and SHOMATE_DATA rows are in Rust's order; a handle (src/thermochem.cyr)
# is row + 1, and 0 is None. f64 cells are the oracle's values as round-trip decimals;
# tests/golden/thermochem.tsv pins every cell (the `thermochem::THERMOCHEM_DATA[]` and
# `thermochem::SHOMATE_DATA[]` rows).

# Shomate equation coefficients for one temperature segment.
#
# Cp(T) = A + B·t + C·t² + D·t³ + E/t²  in J/(mol·K), where t = T(K) / 1000.
#
# The fit is valid only for `t_min ≤ T ≤ t_max`.
struct KmShomate {
    # Coefficient A, J/(mol·K).
    a: f64;
    # Coefficient B (multiplies t), J/(mol·K) per kK.
    b: f64;
    # Coefficient C (multiplies t²), J/(mol·K) per kK².
    c: f64;
    # Coefficient D (multiplies t³), J/(mol·K) per kK³.
    d: f64;
    # Coefficient E (multiplies 1/t²), J/(mol·K)·kK².
    e: f64;
    # Lower bound of the fit's valid temperature range (K).
    t_min: f64;
    # Upper bound of the fit's valid temperature range (K).
    t_max: f64;
}

# Built-in thermochemical data for common substances at 298.15 K, 1 bar.
#
# ΔH_f° and ΔG_f° in kJ/mol, S° in J/(mol·K). Values from the NBS tables
# (Wagman et al. 1982), NIST/JANAF, CODATA, and the CRC Handbook.
# Elements in standard state have ΔH_f° = 0 and ΔG_f° = 0.
#
# Sections of the Rust literal:
# - rows 0–6 (H2(g) … Al(s)): Elements in standard state
# - rows 7–30 (H2O(l) … NaOH(s)): Common compounds
# - rows 31–45 (S(rhombic) … F2(g)): Elements in standard state (additional)
# - rows 46–68 (MgO(s) … PCl5(g)): Inorganic compounds (additional)
# - rows 69–75 (CH3OH(l) … HCHO(g)): Organic compounds (additional)
#
# Notes on rows, from the Rust literal:
# - row 41, Zn(s): S° from CODATA key values (Zn, Ti, Ag, F2) and the CRC Handbook (Ba).
# - row 48, K2O(s): CRC Handbook / NBS (94.14); 102.00 was not a tabulated value.
# - row 73, C4H10(g): n-Butane: all three values from the NBS tables (Wagman et al. 1982), which
#   are mutually consistent (ΔG = ΔH − TΔS within 0.05 kJ/mol).
# Rust: kimiya::thermochem::THERMOCHEM_DATA (its length).
const KM_THERMOCHEM_COUNT = 76;

# Chemical formula (e.g., "H2O(l)").
# Indexed by THERMOCHEM_DATA row; mirrors `ThermochemData::formula`.
# Offset of row i's C string in _KM_THERMOCHEM_FORMULA_BYTES.
var _KM_THERMOCHEM_FORMULA_OFF: u16[76] = {
    0,  # H2(g)
    6,  # O2(g)
    12,  # N2(g)
    18,  # C(graphite)
    30,  # Fe(s)
    36,  # Cu(s)
    42,  # Al(s)
    48,  # H2O(l)
    55,  # H2O(g)
    62,  # CO2(g)
    69,  # CO(g)
    75,  # CH4(g)
    82,  # C2H6(g)
    90,  # C2H4(g)
    98,  # C2H2(g)
    106,  # C6H12O6(s)
    117,  # C2H5OH(l)
    127,  # NH3(g)
    134,  # NO(g)
    140,  # NO2(g)
    147,  # SO2(g)
    154,  # SO3(g)
    161,  # HCl(g)
    168,  # NaCl(s)
    176,  # CaCO3(s)
    185,  # Fe2O3(s)
    194,  # Al2O3(s)
    203,  # CaO(s)
    210,  # H2SO4(l)
    219,  # HNO3(l)
    227,  # NaOH(s)
    235,  # S(rhombic)
    246,  # Cl2(g)
    253,  # Br2(l)
    260,  # I2(s)
    266,  # Na(s)
    272,  # K(s)
    277,  # Ca(s)
    283,  # Mg(s)
    289,  # P(white)
    298,  # Si(s)
    304,  # Zn(s)
    310,  # Ti(s)
    316,  # Ba(s)
    322,  # Ag(s)
    328,  # F2(g)
