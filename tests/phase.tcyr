    test_group("antoine_lookup_nonexistent");
    assert_eq(lookup_antoine("unobtainium"), 0, "None");
}

fn _t_phase_rule_water_triple_point() {
    test_group("phase_rule_water_triple_point");
    # C=1, P=3 → F = 0 (invariant)
    var t, v = phase_rule(1, 3);
    assert(is_ok(t) == 1 && v == 0, "F = 0");
}

fn _t_phase_rule_water_liquid_vapor() {
    test_group("phase_rule_water_liquid_vapor");
    var t, v = phase_rule(1, 2);
    assert(is_ok(t) == 1 && v == 1, "F = 1");
}

fn _t_phase_rule_single_phase() {
    test_group("phase_rule_single_phase");
    var t, v = phase_rule(1, 1);
    assert(is_ok(t) == 1 && v == 2, "F = 2");
}

fn _t_phase_rule_too_many_phases() {
    test_group("phase_rule_too_many_phases");
    var t, v = phase_rule(1, 4);
    assert_eq(is_err_result(t), 1, "C=1, P=4");
}

fn _t_phase_rule_rejects_zero_phases() {
    test_group("phase_rule_rejects_zero_phases");
    var t1, v1 = phase_rule(2, 0);
    assert_eq(is_err_result(t1), 1, "P = 0");
    # Used to overflow i32 (panic in debug builds).
    var t2, v2 = phase_rule(0x7FFFFFFF, 0);
    assert_eq(is_err_result(t2), 1, "i32::MAX, P = 0");
}

fn _t_phase_rule_large_counts() {
    test_group("phase_rule_large_counts");
    # `as i32` used to wrap: u32::MAX → −1 gave Ok(0) here.
    var t1, v1 = phase_rule(0xFFFFFFFF, 1);
    assert_eq(is_err_result(t1), 1, "u32::MAX, 1: F > u32::MAX");
    var t2, v2 = phase_rule(0xFFFFFFFF, 2);
    assert(is_ok(t2) == 1 && v2 == 0xFFFFFFFF, "u32::MAX, 2");
    var t3, v3 = phase_rule(0xFFFFFFFF, 0xFFFFFFFF);
    assert(is_ok(t3) == 1 && v3 == 2, "u32::MAX, u32::MAX");
    var t4, v4 = phase_rule(3000000000, 1);
    assert(is_ok(t4) == 1 && v4 == 3000000001, "3e9, 1");
    var t5, v5 = phase_rule(0, 0xFFFFFFFF);
    assert_eq(is_err_result(t5), 1, "0, u32::MAX");
}

# Cyrius-only, ADR 0002 #4: the range ends are inclusive and one ulp outside is
# Err(INVALID_TEMPERATURE); a non-finite coefficient or range end is Err(INVALID_INPUT); a custom set
# whose pole lies inside its range is Err(INVALID_TEMPERATURE) at and below the pole and Ok above
# it; a value past f64 is Ok(+inf), as Rust returns (no built-in set comes near).
fn _t_cyrius_antoine_result() {
    test_group("cyrius_antoine_result");
    var c = coeffs_of("water");
    var lo: f64 = c.t_min_c;
    var hi: f64 = c.t_max_c;
    var t1, v1 = antoine_pressure_mmhg(c, lo);
    assert_eq(is_ok(t1), 1, "t_min is in range");
    var t2, v2 = antoine_pressure_mmhg(c, hi);
    assert_eq(is_ok(t2), 1, "t_max is in range");
    var below: f64 = 0.9999999999999999;   # one ulp below t_min = 1
    var t3, v3 = antoine_pressure_mmhg(c, below);
    assert(is_err_code(t3, v3, KM_ERR_INVALID_TEMPERATURE), "one ulp below t_min");
    var above: f64 = 100.00000000000001;   # one ulp above t_max = 100
    var t4, v4 = antoine_pressure_pa(c, above);
    assert(is_err_code(t4, v4, KM_ERR_INVALID_TEMPERATURE), "one ulp above t_max");
    var nan: f64 = _km_nan();
    var inf: f64 = 1.0 / 0.0;
    var t5, v5 = antoine_pressure_mmhg(c, nan);
    assert(is_err_code(t5, v5, KM_ERR_INVALID_TEMPERATURE), "NaN T is InvalidTemperature");
    var open = KmAntoineCoeffs { a: c.a, b: c.b, c: c.c, t_min_c: lo, t_max_c: inf };
    var t6, v6 = antoine_pressure_mmhg(open, 50.0);
    assert(is_err_code(t6, v6, KM_ERR_INVALID_INPUT), "an infinite range end is InvalidInput");
    var nb = KmAntoineCoeffs { a: c.a, b: nan, c: c.c, t_min_c: lo, t_max_c: hi };
    var t7, v7 = antoine_pressure_pa(nb, 50.0);
    assert(is_err_code(t7, v7, KM_ERR_INVALID_INPUT), "NaN B is InvalidInput");
    var pole = KmAntoineCoeffs { a: c.a, b: c.b, c: -10.0, t_min_c: 0.0, t_max_c: 100.0 };
    var t8, v8 = antoine_pressure_mmhg(pole, 10.0);
    assert(is_err_code(t8, v8, KM_ERR_INVALID_TEMPERATURE), "at the pole inside the range");
    var t9, v9 = antoine_pressure_mmhg(pole, 5.0);
    assert(is_err_code(t9, v9, KM_ERR_INVALID_TEMPERATURE), "below the pole inside the range");
    var t10, v10 = antoine_pressure_mmhg(pole, 50.0);
    assert_eq(is_ok(t10), 1, "above the pole inside the range");
    var huge = KmAntoineCoeffs { a: 400.0, b: c.b, c: c.c, t_min_c: lo, t_max_c: hi };
    var t11, v11 = antoine_pressure_mmhg(huge, 50.0);
    assert(is_ok(t11) == 1 && v11 == 0x7FF0000000000000, "10^400 overflows to Ok(+inf)");
    var unit = KmAntoineCoeffs { a: 0.0, b: 0.0, c: 1.0, t_min_c: 0.0, t_max_c: 0.0 };
    var t12, v12 = antoine_pressure_pa(unit, 0.0);
    var pa: f64 = v12;
    var f: f64 = _KM_PA_PER_MMHG;
    assert_eq(is_ok(t12), 1, "the unit set at T = 0 is Ok");
    assert_bits_eq(pa, f, "10^0 x the factor is the factor, exactly");
}

# Cyrius-only: ANTOINE_DATA handles run 1 .. KM_ANTOINE_COUNT; 0 and past the end are no handle
# ("" and every field NaN, which antoine_pressure_* reject); lookup is exact and case-sensitive;
# phase_rule refuses counts outside Rust's u32 instead of wrapping them.
fn _t_cyrius_handles_and_counts() {
    test_group("cyrius_handles_and_counts");
    assert_eq(KM_ANTOINE_COUNT, 8, "8 sets");
    assert_eq(lookup_antoine("water"), 1, "water is row 0");
    assert_eq(lookup_antoine("chloroform"), 8, "chloroform is row 7");
    assert_eq(lookup_antoine("Water"), 0, "case-sensitive");
    assert_eq(lookup_antoine(""), 0, "empty name");
    assert_eq(lookup_antoine(0), 0, "null name");
    assert(streq(antoine_data_name(7), "diethyl_ether") == 1, "row 6 name");
    assert(streq(antoine_data_name(0), "") == 1, "handle 0 has no name");
    assert(streq(antoine_data_name(9), "") == 1, "handle 9 has no name");
    var none = antoine_data_coeffs(9);
    var na: f64 = none.a;
    assert_eq(ulp_is_nan(na), 1, "handle 9: NaN fields");
    var t1, v1 = antoine_pressure_mmhg(none, 50.0);
    assert(is_err_code(t1, v1, KM_ERR_INVALID_INPUT), "handle 9: Err");
    var t2, v2 = phase_rule(0 - 1, 1);
    assert(is_err_code(t2, v2, KM_ERR_INVALID_INPUT), "components = -1");
    var t3, v3 = phase_rule(1, 0x100000001);
    assert(is_err_code(t3, v3, KM_ERR_INVALID_INPUT), "phases = 2^32 + 1 (not 1)");
}

# Runs every test group; returns the failure count from assert_summary().
fn main() {
    _t_raoult_basic();
    _t_raoult_pure_component();
    _t_raoult_invalid_fraction();
    _t_raoult_binary_total();
    _t_raoult_rejects_bad_pressures_and_nan();
    _t_henry_basic();
    _t_henry_roundtrip();
    _t_henry_rejects_invalid_inputs();
    _t_bp_elevation_water();
    _t_fp_depression_water();
    _t_osmotic_pressure_basic();
    _t_osmotic_pressure_zero_temp_is_error();
    _t_osmotic_pressure_rejects_invalid_inputs();
    _t_clausius_clapeyron_water();
    _t_clausius_clapeyron_rejects_nan();
    _t_clausius_clapeyron_same_temp();
    _t_clausius_clapeyron_zero_temp_is_error();
    _t_antoine_water_100c();
    _t_antoine_water_pa();
    _t_antoine_mmhg_to_pa_factor();
    _t_antoine_pole_and_non_finite_give_nan();
    _t_antoine_methanol_matches_nist();
    _t_antoine_data_ranges_are_ordered();
    _t_antoine_ethanol_78c();
    _t_antoine_lookup_nonexistent();
    _t_phase_rule_water_triple_point();
    _t_phase_rule_water_liquid_vapor();
    _t_phase_rule_single_phase();
    _t_phase_rule_too_many_phases();
    _t_phase_rule_rejects_zero_phases();
    _t_phase_rule_large_counts();
    _t_cyrius_antoine_result();
    _t_cyrius_handles_and_counts();
    return assert_summary();
}

var exit_code = main();
if (exit_code > 0) { exit_code = 1; }
sys_exit_group(exit_code);
