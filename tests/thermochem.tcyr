}

fn _t_br2_cp_at_lower_bound() {
    test_group("br2_cp_at_lower_bound");
    # JANAF Cp(Br2, g, 298.15 K) = 36.06 J/(mol·K), rising with T: Cp(332.5) ≥ 36.06
    var s = shomate_of("Br2(g)");
    var lo: f64 = s.t_min;
