    assert_eq(is_err_result(t1), 1, "NaN dH");
    var t2, v2 = adiabatic_flame_temperature(ninf, p, 2, 298.15);
    assert_eq(is_err_result(t2), 1, "-inf dH");
}

fn _t_adiabatic_flame_invalid_inputs_are_errors() {
    test_group("adiabatic_flame_invalid_inputs_are_errors");
    var p = sp1("CO2(g)", 1.0);
    var nan: f64 = _km_nan();
    var inf: f64 = 1.0 / 0.0;
    var t1, v1 = adiabatic_flame_temperature(-100000.0, p, 1, nan);
    assert_eq(is_err_result(t1), 1, "NaN T0");
    var t2, v2 = adiabatic_flame_temperature(-100000.0, p, 1, inf);
    assert_eq(is_err_result(t2), 1, "inf T0");
    var t3, v3 = adiabatic_flame_temperature(-100000.0, 0, 0, 298.15);
    assert_eq(is_err_result(t3), 1, "no products");
    var t4, v4 = adiabatic_flame_temperature(-100000.0, sp1("CO2(g)", 0.0), 1, 298.15);
    assert_eq(is_err_result(t4), 1, "moles = 0");
    var t5, v5 = adiabatic_flame_temperature(-100000.0, sp1("CO2(g)", -1.0), 1, 298.15);
    assert_eq(is_err_result(t5), 1, "moles = -1");
    var t6, v6 = adiabatic_flame_temperature(-100000.0, sp1("CO2(g)", nan), 1, 298.15);
    assert_eq(is_err_result(t6), 1, "moles = NaN");
    var t7, v7 = adiabatic_flame_temperature(-100000.0, sp1("CO2(g)", inf), 1, 298.15);
    assert_eq(is_err_result(t7), 1, "moles = inf");
    # Endothermic / zero ΔH: no flame temperature above T₀.
    var t8, v8 = adiabatic_flame_temperature(100000.0, p, 1, 298.15);
    assert_eq(is_err_result(t8), 1, "dH > 0");
    var t9, v9 = adiabatic_flame_temperature(0.0, p, 1, 298.15);
    assert_eq(is_err_result(t9), 1, "dH = 0");
}

fn _t_adiabatic_flame_root_outside_data_range_is_error() {
    test_group("adiabatic_flame_root_outside_data_range_is_error");
    # NH3(g) data end at 1400 K; the root lies far above.
    var t1, v1 = adiabatic_flame_temperature(-200000.0, sp1("NH3(g)", 1.0), 1, 298.15);
    assert_eq(is_err_result(t1), 1, "NH3 past 1400 K");
    # Mixed products: the common range ends at SO2's 1200 K.
    var t2, v2 = adiabatic_flame_temperature(-241820.0, sp2("H2O(g)", 1.0, "SO2(g)", 1.0), 2, 298.15);
    assert_eq(is_err_result(t2), 1, "H2O + SO2 past 1200 K");
    # Below the products' data range (CO2 starts at 298 K).
    var t3, v3 = adiabatic_flame_temperature(-100000.0, sp1("CO2(g)", 1.0), 1, 250.0);
    assert_eq(is_err_result(t3), 1, "T0 = 250 K");
}

