    var t8, v8 = vant_hoff_k(1.0, ninf, 298.15, 400.0);
    assert_eq(is_err_result(t8), 1, "-inf dH");
}

# Σ n·ΔH(298.15 → t) over a species list (the energy-balance checks).
#must_use
fn absorbed(p, n, t: f64): f64 {
    var total: f64 = -0.0;
    var k = 0;
    while (k < n) {
        var tt, v = enthalpy_change_cp(load64(p + k * 16), 298.15, t);
        var dh: f64 = v;
        if (is_ok(tt) != 1) { dh = _km_nan(); }
        var moles: f64 = load64(p + k * 16 + 8);
        total = total + (moles * dh);
        k = k + 1;
    }
    return total;
}

fn _t_adiabatic_flame_satisfies_energy_balance() {
    test_group("adiabatic_flame_satisfies_energy_balance");
    var p = sp3("CO2(g)", 1.0, "H2O(g)", 2.0, "N2(g)", 7.52);
    var t, v = adiabatic_flame_temperature(-802300.0, p, 3, 298.15);
    var tf: f64 = v;
    assert_eq(is_ok(t), 1, "Ok");
    var a: f64 = absorbed(p, 3, tf);
    assert(near(a, 802300.0, 1.0), "the residual is below 1 J/mol");
}

fn _t_adiabatic_flame_nan_enthalpy_is_error() {
    test_group("adiabatic_flame_nan_enthalpy_is_error");
    # 1.1 returned Ok(≈299.5 K) here: NaN.signum() == NaN.signum() is false.
    var p = sp2("CO2(g)", 1.0, "N2(g)", 3.76);
    var nan: f64 = _km_nan();
    var inf: f64 = 1.0 / 0.0;
    var ninf: f64 = -inf;
