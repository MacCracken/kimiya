    assert(near(dg_calc, gf, 0.2), "butane: dG_calc matches the table");
}

# One standard-state element of added_standard_state_elements.
fn _element_row(formula, s: f64) {
    var d = lookup_thermochem(formula);
    assert(d != 0, formula);
    var hf: f64 = thermochem_data_delta_hf_kj(d);
    var gf: f64 = thermochem_data_delta_gf_kj(d);
    var s0: f64 = thermochem_data_s_standard_j(d);
    var ahf: f64 = f64_abs(hf);
    var agf: f64 = f64_abs(gf);
    var e: f64 = eps64();
    assert(ahf < e && agf < e, "dHf = dGf = 0");
    assert(near(s0, s, 0.01), formula);
    return 0;
}

# ADR 0002 #1: Rust's ΔG = −320.48 kJ/mol ± 0.01 is −320 480 J/mol ± 10.
fn _t_added_standard_state_elements() {
    test_group("added_standard_state_elements");
    _element_row("Zn(s)", 41.63);
    _element_row("Ti(s)", 30.72);
    _element_row("Ba(s)", 62.5);
    _element_row("Ag(s)", 42.55);
    _element_row("F2(g)", 202.79);
    # Formation reactions that needed them now resolve.
    var t, v = reaction_gibbs_energy(sp1("ZnO(s)", 1.0), 1, sp2("Zn(s)", 1.0, "O2(g)", 0.5), 2);
    var dg: f64 = v;
    assert(is_ok(t) == 1 && near(dg, -320480.0, 10.0), "ZnO formation dG, in J/mol");
}

# The two-byte code of an element symbol (its first two bytes; one-letter symbols end in NUL).
#must_use
fn sym_code(s): i64 {
    var c1 = load8(s + 1);
    return load8(s) + c1 * 256;
}

# The reference standard state of an element symbol code: (formula, atoms per formula unit), or
# (0, 0) — the Rust test's reference_state.
#must_use
fn reference_state(code): (i64, f64) {
    if (code == sym_code("H")) { return ("H2(g)", 2.0); }
    if (code == sym_code("O")) { return ("O2(g)", 2.0); }
    if (code == sym_code("N")) { return ("N2(g)", 2.0); }
    if (code == sym_code("F")) { return ("F2(g)", 2.0); }
    if (code == sym_code("Cl")) { return ("Cl2(g)", 2.0); }
    if (code == sym_code("Br")) { return ("Br2(l)", 2.0); }
    if (code == sym_code("I")) { return ("I2(s)", 2.0); }
    if (code == sym_code("C")) { return ("C(graphite)", 1.0); }
    if (code == sym_code("S")) { return ("S(rhombic)", 1.0); }
    if (code == sym_code("P")) { return ("P(white)", 1.0); }
    if (code == sym_code("Fe")) { return ("Fe(s)", 1.0); }
    if (code == sym_code("Cu")) { return ("Cu(s)", 1.0); }
    if (code == sym_code("Al")) { return ("Al(s)", 1.0); }
    if (code == sym_code("Na")) { return ("Na(s)", 1.0); }
    if (code == sym_code("K")) { return ("K(s)", 1.0); }
    if (code == sym_code("Ca")) { return ("Ca(s)", 1.0); }
    if (code == sym_code("Mg")) { return ("Mg(s)", 1.0); }
    if (code == sym_code("Si")) { return ("Si(s)", 1.0); }
    if (code == sym_code("Zn")) { return ("Zn(s)", 1.0); }
    if (code == sym_code("Ti")) { return ("Ti(s)", 1.0); }
    if (code == sym_code("Ba")) { return ("Ba(s)", 1.0); }
    if (code == sym_code("Ag")) { return ("Ag(s)", 1.0); }
    return (0, 0.0);
}

# Parses a parenthesis-free formula ("CH3COOH(l)") into (symbol code, count) pairs, merged per
# symbol in first-appearance order, the phase suffix ignored (the Rust test's parse_simple_formula):
# codes into `codes` (i64[8]), counts into `counts` (f64[8]). Returns the number of symbols.
fn parse_simple_formula(formula, codes, counts): i64 {
    var n = 0;
    var i = 0;
    var c = load8(formula);
    while (c != 0 && c != 40) {
        var code = c;
        i = i + 1;
        c = load8(formula + i);
        if (c >= 97 && c <= 122) {
            code = code + c * 256;
            i = i + 1;
            c = load8(formula + i);
        }
        var digits = 0;
        var have = 0;
        while (c >= 48 && c <= 57) {
            digits = digits * 10 + (c - 48);
            have = 1;
            i = i + 1;
            c = load8(formula + i);
        }
        if (have == 0) { digits = 1; }
        var cnt: f64 = f64_from(digits);
        var k = 0;
        var found = 0;
        while (k < n) {
            if (load64(codes + k * 8) == code) {
                var old: f64 = load64(counts + k * 8);
                var sum: f64 = old + cnt;
                store64(counts + k * 8, sum);
                found = 1;
            }
            k = k + 1;
        }
        if (found == 0) {
            store64(codes + n * 8, code);
            store64(counts + n * 8, cnt);
            n = n + 1;
        }
    }
    return n;
}

fn _t_table_gibbs_enthalpy_entropy_consistency() {
    test_group("table_gibbs_enthalpy_entropy_consistency");
    # ΔG_f° ≈ ΔH_f° − 298.15·ΔS_f°, ΔS_f° = S°(compound) − Σ S°(elements). Na2CO3(s)'s source values are
    # themselves inconsistent: its deviation is pinned at −2.55 kJ/mol (Rust's KNOWN_INCONSISTENT).
    var codes: i64[8];
    var counts: f64[8];
    var checked = 0;
    var h = 1;
    while (h <= KM_THERMOCHEM_COUNT) {
        var fo = thermochem_data_formula(h);
        var n = parse_simple_formula(fo, &codes, &counts);
        var skip = 0;
        if (n == 1) {
            var rf, ra = reference_state(codes[0]);
            if (rf != 0 && streq(rf, fo) == 1) { skip = 1; }
        }
        var s_elements: f64 = 0.0;
        var all_present = 1;
        var k = 0;
        while (k < n && skip == 0) {
            var ref, atoms = reference_state(codes[k]);
            var rh = 0;
            if (ref != 0) { rh = lookup_thermochem(ref); }
            if (rh == 0) {
                all_present = 0;
            } else {
                var cnt: f64 = counts[k];
                var at: f64 = atoms;
                var rs: f64 = thermochem_data_s_standard_j(rh);
                s_elements = s_elements + ((cnt / at) * rs);
            }
            k = k + 1;
        }
        if (skip == 0 && all_present == 1) {
            checked = checked + 1;
            var hf: f64 = thermochem_data_delta_hf_kj(h);
            var gf: f64 = thermochem_data_delta_gf_kj(h);
            var s0: f64 = thermochem_data_s_standard_j(h);
            var dg_calc: f64 = hf - ((298.15 * (s0 - s_elements)) / 1000.0);
            var diff: f64 = dg_calc - gf;
            if (streq(fo, "Na2CO3(s)") == 1) {
                assert(near(diff, -2.55, 0.05), "Na2CO3(s): the pinned deviation");
            } else {
                assert(near(diff, 0.0, 2.0), fo);
            }
        }
        h = h + 1;
    }
    # Every non-element row has all its elements in the table.
    assert_eq(checked, KM_THERMOCHEM_COUNT - 22, "rows checked");
}

fn _t_high_temperature_segments_match_janaf() {
    test_group("high_temperature_segments_match_janaf");
    # JANAF Cp° at 2000 K: H2 34.280, CO 36.250, CH4 94.399; H2 at 3000 K 37.087.
    _cp_case("H2(g)", 2000.0, 34.280);
    _cp_case("H2(g)", 3000.0, 37.087);
    _cp_case("CO(g)", 2000.0, 36.250);
    _cp_case("CH4(g)", 2000.0, 94.399);
}

fn _t_adiabatic_flame_rich_methane_with_co_product() {
    test_group("adiabatic_flame_rich_methane_with_co_product");
    # CH4 + 1.5 O2 (+ 5.64 N2) → CO + 2 H2O (+ 5.64 N2): ΔH = −519.32 kJ/mol; CO must be usable above 1300 K.
    var p = sp3("CO(g)", 1.0, "H2O(g)", 2.0, "N2(g)", 5.64);
    var t, v = adiabatic_flame_temperature(-519320.0, p, 3, 298.15);
    var tf: f64 = v;
    assert(is_ok(t) == 1 && tf > 1300.0 && tf < 3000.0, "rich CH4 flame T");
    var a: f64 = absorbed(p, 3, tf);
    assert(near(a, 519320.0, 1.0), "energy balance");
}

# ── Cyrius-only ─────────────────────────────────────────────────────────────────────

# Species lists are a pointer and a count: a negative count, or a null pointer with values, is
# Err(INVALID_INPUT); null with 0 values is the empty list; a null formula is unknown; the products are
# read before the reactants; an empty sum is +0.0 (Rust's `total = 0.0`); a NaN coefficient gives Ok(NaN)
# (no guard, as Rust).
fn _t_cyrius_species_lists() {
    test_group("cyrius_species_lists");
    var good = sp1("CO2(g)", 1.0);
    var t1, v1 = reaction_enthalpy(good, 0 - 1, 0, 0);
    assert(is_err_code(t1, v1, KM_ERR_INVALID_INPUT), "products count -1");
    var t2, v2 = reaction_entropy(good, 1, 0, 2);
    assert(is_err_code(t2, v2, KM_ERR_INVALID_INPUT), "null reactants with 2 values");
    var t3, v3 = reaction_gibbs_energy(0, 0, good, 1);
    var g: f64 = v3;
    assert(is_ok(t3) == 1 && near(g, 394360.0, 0.001), "null products with 0 values: 0 - (-394.36) kJ, in J");
    var t4, v4 = reaction_enthalpy(sp1(0, 1.0), 1, good, 1);
    assert(is_err_code(t4, v4, KM_ERR_INVALID_REACTION), "a null formula is unknown");
    var t5, v5 = reaction_enthalpy(sp1("XeF6(g)", 1.0), 1, good, 0 - 1);
    assert(is_err_code(t5, v5, KM_ERR_INVALID_REACTION), "the products' error comes first");
    var t6, v6 = reaction_entropy(0, 0, 0, 0);
    assert(is_ok(t6) == 1 && v6 == 0, "an empty reaction is +0.0");
    var nan: f64 = _km_nan();
    var t7, v7 = reaction_enthalpy(sp1("CO2(g)", nan), 1, 0, 0);
    assert(is_ok(t7) == 1 && ulp_is_nan(v7) == 1, "a NaN coefficient is Ok(NaN)");
    var t8, v8 = adiabatic_flame_temperature(-100000.0, 0, 3, 298.15);
    assert(is_err_code(t8, v8, KM_ERR_INVALID_INPUT), "flame: null products with 3 values");
    var t9, v9 = adiabatic_flame_temperature(-100000.0, good, 0 - 1, 298.15);
    assert(is_err_code(t9, v9, KM_ERR_INVALID_INPUT), "flame: count -1");
    var t10, v10 = adiabatic_flame_temperature(-100000.0, sp1(0, 1.0), 1, 298.15);
    assert(is_err_code(t10, v10, KM_ERR_INVALID_REACTION), "flame: a null formula is unknown");
    # The error codes, in Rust's order of checks.
    var t11, v11 = adiabatic_flame_temperature(nan, 0, 0, nan);
    assert(is_err_code(t11, v11, KM_ERR_INVALID_TEMPERATURE), "T0 is checked first");
    var t12, v12 = adiabatic_flame_temperature(-1000.0, sp2("XeF6(g)", 1.0, "CO2(g)", -1.0), 2, 298.15);
    assert(is_err_code(t12, v12, KM_ERR_INVALID_REACTION), "the first bad product decides: unknown");
    var t13, v13 = adiabatic_flame_temperature(-1000.0, sp2("CO2(g)", -1.0, "XeF6(g)", 1.0), 2, 298.15);
    assert(is_err_code(t13, v13, KM_ERR_INVALID_INPUT), "the first bad product decides: moles");
    var t14, v14 = adiabatic_flame_temperature(100000.0, good, 1, 298.15);
    assert(is_err_code(t14, v14, KM_ERR_COMPUTATION_ERROR), "not bracketable");
    var t15, v15 = adiabatic_flame_temperature(-100000.0, good, 1, 6000.0);
    assert(is_err_code(t15, v15, KM_ERR_INVALID_TEMPERATURE), "T0 = range_max");
}

# THERMOCHEM_DATA and SHOMATE_DATA handles run 1 .. KM_*_COUNT; 0 and past the end are no handle ("" and
# NaN); lookups are exact and case-sensitive; a long string matches nothing.
fn _t_cyrius_handles() {
    test_group("cyrius_handles");
    assert_eq(KM_THERMOCHEM_COUNT, 76, "76 rows");
    assert_eq(lookup_thermochem("H2(g)"), 1, "H2(g) is row 0");
    assert_eq(lookup_thermochem("HCHO(g)"), 76, "HCHO(g) is row 75");
    assert_eq(lookup_thermochem("h2o(l)"), 0, "case-sensitive");
    assert_eq(lookup_thermochem("H2O"), 0, "the phase is part of the key");
    assert_eq(lookup_thermochem(""), 0, "empty");
    assert_eq(lookup_thermochem(0), 0, "null");
    assert(streq(thermochem_data_name(8), "Water (liquid)") == 1, "row 7's name");
    assert(streq(thermochem_data_formula(0), "") == 1, "handle 0 has no formula");
    assert(streq(thermochem_data_name(77), "") == 1, "handle 77 has no name");
    var x: f64 = thermochem_data_delta_hf_kj(77);
    assert_eq(ulp_is_nan(x), 1, "handle 77: NaN");
    var y: f64 = thermochem_data_s_standard_j(0);
    assert_eq(ulp_is_nan(y), 1, "handle 0: NaN");
    assert_eq(lookup_shomate("H2O(g)"), 1, "H2O(g) is segment 0");
    assert_eq(lookup_shomate("Ne(g)"), 34, "Ne(g) is segment 33");
    assert_eq(lookup_shomate_at("H2(g)", 2500.0), 16, "H2 at 2500 K: the 1000-2500 K segment (row 15)");
    assert_eq(lookup_shomate_at("H2(g)", 2500.0000000000005), 17, "one ulp above: the next segment");
    assert_eq(lookup_shomate_at(0, 300.0), 0, "null formula");
    assert(streq(shomate_data_formula(35), "") == 1, "handle 35 has no formula");
    var none = shomate_data_coeffs(0);
    var na: f64 = none.a;
    var nt: f64 = none.t_max;
    assert(ulp_is_nan(na) == 1 && ulp_is_nan(nt) == 1, "handle 0: NaN fields");
    var cpn: f64 = none.cp(500.0);
    assert_eq(ulp_is_nan(cpn), 1, "and a NaN Cp");
}

# ADR 0002 #1: reaction_enthalpy / reaction_gibbs_energy are Rust's kJ/mol difference × 1000.0 (one multiply,
# so bit-identical to the oracle's value × 1000), and pass straight to the J/mol functions; reaction_entropy
# is unchanged.
fn _t_cyrius_adr_0002_1_joules() {
    test_group("cyrius_adr_0002_1_joules");
    var p = sp2("CO2(g)", 1.0, "H2O(g)", 2.0);
    var r = sp2("CH4(g)", 1.0, "O2(g)", 2.0);
    var co2: f64 = hf_of("CO2(g)");
    var h2o: f64 = hf_of("H2O(g)");
    var ch4: f64 = hf_of("CH4(g)");
    var o2: f64 = hf_of("O2(g)");
    var sp: f64 = (0.0 + (1.0 * co2)) + (2.0 * h2o);
    var sr: f64 = (0.0 + (1.0 * ch4)) + (2.0 * o2);
    var kj: f64 = sp - sr;
    var want: f64 = kj * 1000.0;
    var t, v = reaction_enthalpy(p, 2, r, 2);
    var j: f64 = v;
    assert_eq(is_ok(t), 1, "Ok");
    assert_bits_eq(j, want, "(sum products - sum reactants) kJ x 1000.0, bit for bit");
    var tf, vf = adiabatic_flame_temperature(j, sp3("CO2(g)", 1.0, "H2O(g)", 2.0, "N2(g)", 7.52), 3, 298.15);
    var tflame: f64 = vf;
    assert(is_ok(tf) == 1 && near(tflame, 2327.0, 10.0), "the J/mol result feeds the flame directly");
    var ts, vs = reaction_entropy(p, 2, r, 2);
    var ds: f64 = vs;
    assert(is_ok(ts) == 1 && near(ds, -5.11, 0.01), "entropy stays J/(mol K)");
}

# The products' resolved segments for the private solver helpers (as adiabatic_flame_temperature
# fills its stack table).
fn fill_cache(p, n, cache) {
    var k = 0;
    while (k < n) {
        var start, count = _km_segments_lookup(load64(p + k * 16));
        store64(cache + k * 16, start);
        store64(cache + k * 16 + 8, count);
        k = k + 1;
    }
    return 0;
}

# The transcribed hisab 1.4.0 loops pin Rust's typed constants: Newton stops when |f| < 1e-3 exactly
# (f(T₀) = −ΔH exactly, so ΔH = −(1e-3 − 1 ulp) stops at x0 and ΔH = −1e-3 steps); it fails when
# |f′| < 10⁻¹² (EPSILON_F64); bisection stops when |hi − lo| < 1e-6; it fails without a sign change.
fn _t_cyrius_flame_solver() {
    test_group("cyrius_flame_solver");
    var cache: i64[64];
    var p = sp1("N2(g)", 1.0);
    fill_cache(p, 1, &cache);
    var t0: f64 = 298.15;
    var below: f64 = 0x3F50624DD2F1A9FB;    # 1e-3, one ulp down
    var nb: f64 = -below;
    var e1, x1 = _km_flame_newton(nb, p, 1, &cache, t0, t0);
    var r1: f64 = x1;
    assert(e1 == KM_ERR_NONE && r1 == t0, "|f| = 1e-3 - 1 ulp: accepted at x0");
    var e2, x2 = _km_flame_newton(-0.001, p, 1, &cache, t0, t0);
    var r2: f64 = x2;
    assert(e2 == KM_ERR_NONE && r2 != t0, "|f| = 1e-3: Newton steps");
    # |f'| = n·Cp(298.15) ≈ 29.1·n against EPSILON_F64 = 1e-12.
    var lo_n: f64 = 0.99 / 29.124;
    var hi_n: f64 = 1.01 / 29.124;
    var tiny: f64 = 0.000000000001;
    var m_lo: f64 = lo_n * tiny;
    var m_hi: f64 = hi_n * tiny;
    var e3, x3 = _km_flame_newton(-1.0, sp1("N2(g)", m_lo), 1, &cache, t0, t0);
    assert_eq(e3, KM_ERR_INVALID_INPUT, "|f'| = 0.99e-12: derivative is zero");
    var e4, x4 = _km_flame_newton(-1.0, sp1("N2(g)", m_hi), 1, &cache, t0, t0);
    assert(e4 != KM_ERR_INVALID_INPUT, "|f'| = 1.01e-12: Newton steps");
    # Bisection on a CH4/air flame scaled by 10¹² (|f′| ≈ 4·10¹⁴, so f's sign is sure 10⁻⁷ K away).
    var big = sp3("CO2(g)", 1000000000000.0, "H2O(g)", 2000000000000.0, "N2(g)", 7520000000000.0);
    var cb: i64[64];
    fill_cache(big, 3, &cb);
    var dh: f64 = -802300000000000000.0;
    var tr, vr = adiabatic_flame_temperature(dh, big, 3, t0);
    var root: f64 = vr;
    assert_eq(is_ok(tr), 1, "scaled flame is Ok");
    var a: f64 = root - 0.0000005;
    var b1: f64 = a + 0.000000999;
    var b2: f64 = a + 0.000001001;
    var fa: f64 = _km_flame_f(dh, big, 3, &cb, t0, a);
    var fb: f64 = _km_flame_f(dh, big, 3, &cb, t0, b1);
    assert(fa > 0.0 && fb < 0.0, "the bracket straddles the root");
    var e5, x5 = _km_flame_bisection(dh, big, 3, &cb, t0, a, b1);
    var r5: f64 = x5;
    var mid1: f64 = (a + b1) * 0.5;
    assert(e5 == KM_ERR_NONE && r5 == mid1, "|hi - lo| = 0.999e-6: the first midpoint");
    var e6, x6 = _km_flame_bisection(dh, big, 3, &cb, t0, a, b2);
    var r6: f64 = x6;
    var mid2: f64 = (a + b2) * 0.5;
    assert(e6 == KM_ERR_NONE && r6 != mid2, "|hi - lo| = 1.001e-6: bisects on");
    var c: f64 = root - 1.0;
    var e7, x7 = _km_flame_bisection(dh, big, 3, &cb, t0, a, c);
    assert_eq(e7, KM_ERR_INVALID_INPUT, "no sign change: hisab's opposite-signs error");
    # Bisection over the whole range lands within its 1e-6 K tolerance of the flame's root.
    var e8, x8 = _km_flame_bisection(dh, big, 3, &cb, t0, t0, 6000.0);
    var r8: f64 = x8;
    assert(e8 == KM_ERR_NONE && near(r8, root, 0.000001), "bisection's root");
}

# More products than the stack table holds (_KM_FLAME_CACHED = 32): the rest are resolved again at each
# evaluation, checked in the same first pass.
fn _t_cyrius_long_product_list() {
    test_group("cyrius_long_product_list");
    var n = 40;
    var p = alloc(n * 16);
    var k = 0;
    while (k < n) {
        store64(p + k * 16, "N2(g)");
        var m: f64 = 0.25;
        store64(p + k * 16 + 8, m);
        k = k + 1;
    }
    var t, v = adiabatic_flame_temperature(-200000.0, p, n, 298.15);
    var tf: f64 = v;
    assert_eq(is_ok(t), 1, "40 products: Ok");
    var a: f64 = absorbed(p, n, tf);
    assert(near(a, 200000.0, 1.0), "40 products: energy balance");
    store64(p + 35 * 16, "XeF6(g)");
    var t2, v2 = adiabatic_flame_temperature(-200000.0, p, n, 298.15);
    assert(is_err_code(t2, v2, KM_ERR_INVALID_REACTION), "an unknown product past the table");
    store64(p + 35 * 16, "N2(g)");
    var neg: f64 = -1.0;
    store64(p + 39 * 16 + 8, neg);
    var t3, v3 = adiabatic_flame_temperature(-200000.0, p, n, 298.15);
    assert(is_err_code(t3, v3, KM_ERR_INVALID_INPUT), "bad moles past the table");
}

# KmShomate's methods take the struct by value (port plan §6.4): s.cp(t) is KmShomate_cp(s, t); a custom
# set works; there is no range check (extrapolation, T = 0 gives ±inf or NaN as Rust).
fn _t_cyrius_shomate_struct() {
    test_group("cyrius_shomate_struct");
    var s = shomate_of("CO2(g)");
    var a: f64 = s.cp(500.0);
    var b: f64 = KmShomate_cp(s, 500.0);
    assert_bits_eq(a, b, "s.cp(t) is KmShomate_cp(s, t)");
    var ar = KmShomate { a: 20.786, b: 0.0, c: 0.0, d: 0.0, e: 0.0, t_min: 298.0, t_max: 6000.0 };
    var c: f64 = ar.cp(10000.0);
    assert(c == 20.786, "a monatomic gas, extrapolated");
    var h1: f64 = ar.enthalpy_antiderivative(1000.0);
    var h0: f64 = ar.enthalpy_antiderivative(0.0);
    assert(near(h1, 20786.0, 0.000000001), "1000 x 20.786 x 1");
    assert_eq(ulp_is_nan(h0), 1, "T = 0: 0 - 0/0 is NaN");
    var cp0: f64 = s.cp(0.0);
    assert_eq(ulp_is_inf(cp0), 1, "CO2 at T = 0: E/0 is infinite");
}

