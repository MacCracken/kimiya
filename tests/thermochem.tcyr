fn _t_vant_hoff_nan_inf_is_error() {
    test_group("vant_hoff_nan_inf_is_error");
    var nan: f64 = _km_nan();
    var inf: f64 = 1.0 / 0.0;
    var ninf: f64 = -inf;
    var t1, v1 = vant_hoff_k(1.0, -50000.0, nan, 400.0);
    assert_eq(is_err_result(t1), 1, "NaN T_ref");
