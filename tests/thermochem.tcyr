    assert_eq(is_err_result(t2), 1, "NaN T_new");
    var t3, v3 = vant_hoff_k(1.0, -50000.0, inf, 400.0);
    assert_eq(is_err_result(t3), 1, "inf T_ref");
    var t4, v4 = vant_hoff_k(1.0, -50000.0, 298.15, inf);
