fn _t_butane_row_is_self_consistent() {
    test_group("butane_row_is_self_consistent");
    # NBS: ΔHf −126.15, ΔGf −17.03, S° 310.23.
    var d = lookup_thermochem("C4H10(g)");
    var s_c: f64 = s_of("C(graphite)");
    var s_h2: f64 = s_of("H2(g)");
    var elements: f64 = (4.0 * s_c) + (5.0 * s_h2);
    var hf: f64 = thermochem_data_delta_hf_kj(d);
    var gf: f64 = thermochem_data_delta_gf_kj(d);
    var s0: f64 = thermochem_data_s_standard_j(d);
