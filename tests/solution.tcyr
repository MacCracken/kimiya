    var d: f64 = f64_abs(h - 1.0);
    assert(d < eps64(), "pH 0");
}

fn _t_non_finite_inputs_are_rejected() {
    test_group("non_finite_inputs_are_rejected");
    var nan: f64 = _km_nan();
    var inf: f64 = 1.0 / 0.0;
    var t1, v1 = molarity(1.0, nan);
    assert_eq(is_err_result(t1), 1, "molarity V NaN");
    var t2, v2 = molarity(1.0, inf);
    assert_eq(is_err_result(t2), 1, "molarity V inf");
    var t3, v3 = molarity(nan, 1.0);
    assert_eq(is_err_result(t3), 1, "molarity n NaN");
    var t4, v4 = molality(1.0, nan);
    assert_eq(is_err_result(t4), 1, "molality kg NaN");
    var t5, v5 = molality(inf, 1.0);
    assert_eq(is_err_result(t5), 1, "molality n inf");
    var t6, v6 = dilution(1.0, 0.1, nan);
    assert_eq(is_err_result(t6), 1, "dilution V2 NaN");
    var t7, v7 = dilution(nan, 0.1, 1.0);
    assert_eq(is_err_result(t7), 1, "dilution M1 NaN");
    var t8, v8 = dilution(1.0, inf, 1.0);
    assert_eq(is_err_result(t8), 1, "dilution V1 inf");
    var t9, v9 = ph_from_h_concentration(nan);
    assert_eq(is_err_result(t9), 1, "pH NaN");
    var t10, v10 = ph_from_h_concentration(inf);
    assert_eq(is_err_result(t10), 1, "pH inf");
    var t11, v11 = poh_from_oh_concentration(nan);
    assert_eq(is_err_result(t11), 1, "pOH NaN");
    var t12, v12 = henderson_hasselbalch(nan, 0.1, 0.1);
    assert_eq(is_err_result(t12), 1, "HH pKa NaN");
    var t13, v13 = henderson_hasselbalch(4.75, nan, 0.1);
    assert_eq(is_err_result(t13), 1, "HH base NaN");
    var t14, v14 = henderson_hasselbalch(4.75, 0.1, inf);
    assert_eq(is_err_result(t14), 1, "HH acid inf");
    var t15, v15 = kohlrausch_molar_conductivity(126.4, 10.0, nan);
    assert_eq(is_err_result(t15), 1, "Kohlrausch c NaN");
    var t16, v16 = kohlrausch_molar_conductivity(nan, 10.0, 0.1);
    assert_eq(is_err_result(t16), 1, "Kohlrausch Λ° NaN");
    var t17, v17 = kohlrausch_molar_conductivity(126.4, inf, 0.1);
    assert_eq(is_err_result(t17), 1, "Kohlrausch K inf");
}

# ── weak acids and bases (reference values: the cubic's root by 400-step bisection in 50-digit decimal) ──

# Asserts weak_acid_ph(ka, c) (base = 0) or weak_base_ph(ka, c) (base = 1) is Ok and within 1e-12 of want.
fn weak_close(base, ka: f64, c: f64, want: f64, name) {
    var t = 0;
    var v = 0;
    if (base == 1) {
        var tb, vb = weak_base_ph(ka, c);
        t = tb;
        v = vb;
    } else {
        var ta, va = weak_acid_ph(ka, c);
        t = ta;
        v = va;
    }
    var ph: f64 = v;
    assert(is_ok(t) == 1 && close(ph, want, tol12()) == 1, name);
    return 0;
}

fn _t_acetic_acid_ph() {
    test_group("acetic_acid_ph");
    weak_close(0, 0.000018, 0.1, 2.8752770603192665, "0.1 M acetic acid");
}

fn _t_hf_weak_acid_ph() {
    test_group("hf_weak_acid_ph");
    weak_close(0, 0.00068, 0.1, 2.101646894217442, "0.1 M HF");
}

fn _t_weak_acid_dilute() {
    test_group("weak_acid_dilute");
    weak_close(0, 0.000018, 0.00001, 5.145294329911299, "1e-5 M acetic acid");
}

fn _t_weak_acid_very_dilute_stays_acidic() {
    test_group("weak_acid_very_dilute_stays_acidic");
    var t, v = weak_acid_ph(0.000018, 0.00000001);
    var ph: f64 = v;
    assert(is_ok(t) == 1 && ph < 7.0, "an acid can never be basic");
    weak_close(0, 0.000018, 0.00000001, 6.978420204421044, "1e-8 M acetic acid");
}

fn _t_weak_acid_tiny_ka_times_c_converges() {
    test_group("weak_acid_tiny_ka_times_c_converges");
    weak_close(0, 0.0000005, 0.000002, 6.103103512160274, "Ka 5e-7, C 2e-6");
}

fn _t_weak_acid_very_weak() {
    test_group("weak_acid_very_weak");
    weak_close(0, 0.000000000001, 0.01, 6.849485769896728, "Ka 1e-12, C 0.01");
    weak_close(0, 0.00000000000000000001, 1.0, 6.999999782852868, "Ka 1e-20, C 1");
    var tiny: f64 = 0.000000000000000000000000000001;
    weak_close(0, tiny, tiny, 7.0, "negligible acid → neutral water");
}

fn _t_weak_acid_large_ka_approaches_strong() {
    test_group("weak_acid_large_ka_approaches_strong");
    weak_close(0, 1.0, 0.1, 1.0380667011667924, "Ka 1, C 0.1");
    weak_close(0, 1000.0, 0.1, 1.000043422934786, "Ka 1e3, C 0.1");
    weak_close(0, 10000000000.0, 0.001, 2.999999995657099, "Ka 1e10, C 1e-3");
}

fn _t_weak_acid_zero_ka_is_error() {
    test_group("weak_acid_zero_ka_is_error");
    var t, v = weak_acid_ph(0.0, 0.1);
    assert_eq(is_err_result(t), 1, "Ka = 0");
}

fn _t_weak_acid_zero_concentration_is_error() {
    test_group("weak_acid_zero_concentration_is_error");
    var t, v = weak_acid_ph(0.000018, 0.0);
    assert_eq(is_err_result(t), 1, "C = 0");
}

fn _t_weak_acid_base_non_finite_is_error() {
    test_group("weak_acid_base_non_finite_is_error");
    var nan: f64 = _km_nan();
    var inf: f64 = 1.0 / 0.0;
    var ks: f64[4];
    var cs: f64[4];
    ks[0] = nan;
    cs[0] = 0.1;
    ks[1] = 0.000018;
    cs[1] = nan;
    ks[2] = inf;
    cs[2] = 0.1;
    ks[3] = 0.000018;
    cs[3] = inf;
    var k = 0;
    while (k < 4) {
        var ka: f64 = ks[k];
        var c: f64 = cs[k];
        var ta, va = weak_acid_ph(ka, c);
        assert_eq(is_err_result(ta), 1, "acid");
        var tb, vb = weak_base_ph(ka, c);
        assert_eq(is_err_result(tb), 1, "base");
        k = k + 1;
    }
}

fn _t_weak_acid_overflow_is_error_not_garbage() {
    test_group("weak_acid_overflow_is_error_not_garbage");
    var big: f64 = 0x7E37E43C8800759C;   # 1e300
    var t, v = weak_acid_ph(big, big);
    assert(is_err_code(t, v, KM_ERR_COMPUTATION_ERROR) == 1, "Ka·C overflows: ComputationError");
}

