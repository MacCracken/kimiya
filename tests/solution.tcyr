    test_group("ammonia_weak_base_ph");
    weak_close(1, 0.000018, 0.1, 11.124722939680733, "0.1 M ammonia");
}

fn _t_weak_base_very_dilute_stays_basic() {
    test_group("weak_base_very_dilute_stays_basic");
    var t, v = weak_base_ph(0.000018, 0.00000001);
    var ph: f64 = v;
    assert(is_ok(t) == 1 && ph > 7.0, "a base can never be acidic");
    weak_close(1, 0.000018, 0.00000001, 7.021579795578956, "1e-8 M base");
}

fn _t_weak_base_tiny_kb_times_c_converges() {
    test_group("weak_base_tiny_kb_times_c_converges");
    weak_close(1, 0.0000005, 0.000002, 7.896896487839726, "Kb 5e-7, C 2e-6");
}

fn _t_weak_base_zero_kb_is_error() {
    test_group("weak_base_zero_kb_is_error");
    var t, v = weak_base_ph(0.0, 0.1);
    assert_eq(is_err_result(t), 1, "Kb = 0");
}

fn _t_weak_acid_base_symmetry() {
    test_group("weak_acid_base_symmetry");
    var ks: f64[4];
    var cs: f64[4];
    ks[0] = 0.000018;
    cs[0] = 0.1;
    ks[1] = 0.000018;
    cs[1] = 0.00000001;
    ks[2] = 1.0;
    cs[2] = 0.1;
    ks[3] = 0.000000000001;
    cs[3] = 0.01;
    var k = 0;
    while (k < 4) {
        var ka: f64 = ks[k];
        var c: f64 = cs[k];
        var ta, va = weak_acid_ph(ka, c);
        var tb, vb = weak_base_ph(ka, c);
        var a: f64 = va;
        var b: f64 = vb;
        var sum: f64 = a + b;
        assert(is_ok(ta) == 1 && is_ok(tb) == 1 && close(sum, 14.0, tol12()) == 1, "acid + base pH = 14");
        k = k + 1;
    }
}

# ── activity coefficients ───────────────────────────────────────────────────────────

fn _t_ionic_strength_nacl() {
    test_group("ionic_strength_nacl");
    var i: f64 = ionic_strength(ions2(0.1, 1, 0.1, 0 - 1), 2);
    var d: f64 = f64_abs(i - 0.1);
    assert(d < eps64(), "0.1 M NaCl: I = 0.1");
}

fn _t_ionic_strength_cacl2() {
    test_group("ionic_strength_cacl2");
    var i: f64 = ionic_strength(ions2(0.1, 2, 0.2, 0 - 1), 2);
    var d: f64 = f64_abs(i - 0.3);
    assert(d < eps64(), "0.1 M CaCl2: I = 0.3");
}

fn _t_large_charges_do_not_overflow() {
    test_group("large_charges_do_not_overflow");
    var i32_min = 0 - 2147483648;
    var i: f64 = ionic_strength(ions2(1.0, 50000, 1.0, i32_min), 2);
    var zmin: f64 = f64_from(i32_min);
    var sq: f64 = _km_powi(zmin, 2);
    var expected: f64 = 0.5 * (2500000000.0 + sq);
    var tol: f64 = expected * 0.000000000000001;
    assert(close(i, expected, tol) == 1, "ionic strength");
    # γ underflows to 0 for absurd charges, but nothing panics.
    var t1, v1 = debye_huckel_limiting(2147483647, 0.01, 0.509);
    assert(is_ok(t1) == 1 && okf(t1, v1) == 0.0, "limiting, i32::MAX");
    var t2, v2 = debye_huckel_extended(i32_min, 0.01, 0.509, 0.328, 3.0);
    assert(is_ok(t2) == 1 && okf(t2, v2) == 0.0, "extended, i32::MIN");
    var t3, v3 = davies_activity(50000, 0.01, 0.509);
    assert(is_ok(t3) == 1 && okf(t3, v3) == 0.0, "Davies, 50 000");
}

fn _t_debye_huckel_limiting_monovalent() {
    test_group("debye_huckel_limiting_monovalent");
    var t, v = debye_huckel_limiting(1, 0.01, KM_DH_A_WATER_25C);
    var g: f64 = v;
    assert(is_ok(t) == 1 && close(g, 0.8894058875558917, tol12()) == 1, "γ(z=1, I=0.01)");
}

fn _t_debye_huckel_limiting_divalent() {
    test_group("debye_huckel_limiting_divalent");
    var t, v = debye_huckel_limiting(2, 0.01, KM_DH_A_WATER_25C);
    var g: f64 = v;
    assert(is_ok(t) == 1 && close(g, 0.6257487633544406, tol12()) == 1, "γ(z=2, I=0.01)");
}

fn _t_debye_huckel_zero_ionic_strength() {
    test_group("debye_huckel_zero_ionic_strength");
    var t, v = debye_huckel_limiting(1, 0.0, KM_DH_A_WATER_25C);
    var g: f64 = v;
    var d: f64 = f64_abs(g - 1.0);
    assert(is_ok(t) == 1 && d < eps64(), "I = 0: γ = 1");
}

fn _t_extended_dh_larger_than_limiting() {
    test_group("extended_dh_larger_than_limiting");
    var tl, vl = debye_huckel_limiting(1, 0.05, KM_DH_A_WATER_25C);
    var te, ve = debye_huckel_extended(1, 0.05, KM_DH_A_WATER_25C, KM_DH_B_WATER_25C, 3.0);
    var lim: f64 = vl;
    var ext: f64 = ve;
    assert(is_ok(tl) == 1 && is_ok(te) == 1 && ext > lim, "extended DH should give larger γ");
    assert(close(ext, 0.80669717443588, tol12()) == 1, "extended DH");
}

fn _t_extended_dh_rejects_bad_parameters() {
    test_group("extended_dh_rejects_bad_parameters");
    var a: f64 = KM_DH_A_WATER_25C;
    var b: f64 = KM_DH_B_WATER_25C;
    var nan: f64 = _km_nan();
    var inf: f64 = 1.0 / 0.0;
    var singular_size: f64 = -1.0 / (b * 0.1);   # 1 + B·å·√I = 0 for å = −1/(0.328·0.1)
    var t1, v1 = debye_huckel_extended(1, 0.01, a, b, singular_size);
    assert_eq(is_err_result(t1), 1, "singular size");
    var t2, v2 = debye_huckel_extended(1, 0.01, a, b, -3.0);
    assert_eq(is_err_result(t2), 1, "negative size");
    var t3, v3 = debye_huckel_extended(1, 0.01, a, b, nan);
    assert_eq(is_err_result(t3), 1, "NaN size");
    var t4, v4 = debye_huckel_extended(1, 0.01, a, b, inf);
    assert_eq(is_err_result(t4), 1, "inf size");
    var t5, v5 = debye_huckel_extended(1, 0.01, a, nan, 3.0);
    assert_eq(is_err_result(t5), 1, "NaN B");
    var nb: f64 = -b;
    var t6, v6 = debye_huckel_extended(1, 0.01, a, nb, 3.0);
    assert_eq(is_err_result(t6), 1, "negative B");
    var t7, v7 = debye_huckel_extended(1, 0.01, nan, b, 3.0);
    assert_eq(is_err_result(t7), 1, "NaN A");
    # å = 0 reduces to the limiting law
    var te, ve = debye_huckel_extended(1, 0.01, a, b, 0.0);
    var tl, vl = debye_huckel_limiting(1, 0.01, a);
    var ext: f64 = ve;
    var lim: f64 = vl;
    assert(is_ok(te) == 1 && is_ok(tl) == 1 && close(ext, lim, 0.000000000000001) == 1, "å = 0");
}

