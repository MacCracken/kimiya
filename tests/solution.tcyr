# solution.tcyr — the tests of rust-old/src/solution.rs, ported one for one (each test_group is the Rust test's
# name; all 49), plus Cyrius-only tests of the ion-record convention, out-of-i32 charges, the private
# charge-balance Newton (its exits and Rust's relative-step tolerance, pinned on the helper) and henderson_
# hasselbalch's log10, and of ADR 0002 #29 (the overflow audit's B2: dilution and solution_conductivity rounded once;
# no Rust test changes with it, each compares within a tolerance). No Rust test needed adapting beyond the literals: a
# value Rust writes with an exponent
# (1e-7, 1.8e-5, 1e300) is written positionally here, or as its bit pattern, since the Cyrius lexer has no
# exponent notation; `assert_close(a, e, tol)` is `close(a, e, tol)`. The golden corpus separately checks every
# function over its grid (tests/parity.tcyr).

include "tests/ulp.cyr"
include "src/error.cyr"
include "src/constants.cyr"
include "src/mathx_data.cyr"
include "src/mathx.cyr"
include "src/validate.cyr"
include "src/solution.cyr"

alloc_init();

# 1 if |actual − expected| ≤ tol (Rust's assert_close).
#must_use
fn close(actual: f64, expected: f64, tol: f64): i64 {
    var d: f64 = f64_abs(actual - expected);
    if (d <= tol) { return 1; }
    return 0;
}

# 1 if the Result (t, v) is Err(code).
#must_use
fn is_err_code(t, v, code): i64 {
    if (is_err_result(t) == 1 && v == code) { return 1; }
    return 0;
}

# f64::EPSILON.
#must_use
fn eps64(): f64 {
    var e: f64 = 0.0000000000000002220446049250313;
    return e;
}

# 1e-12, the Rust tests' usual tolerance.
#must_use
fn tol12(): f64 {
    var t: f64 = 0.000000000001;
    return t;
}

# An ion list of two (concentration, charge) records.
#must_use
fn ions2(c1: f64, z1, c2: f64, z2): i64 {
    var b = alloc(32);
    store64(b, c1);
    store64(b + 8, z1);
    store64(b + 16, c2);
    store64(b + 24, z2);
    return b;
}

# The Ok payload of a Result as an f64 (the caller asserts is_ok).
#must_use
fn okf(t, v): f64 {
    var x: f64 = v;
    return x;
}

# ── pH ──────────────────────────────────────────────────────────────────────────────

fn _t_pure_water_ph() {
    test_group("pure_water_ph");
    var t, v = ph_from_h_concentration(0.0000001);
    var ph: f64 = v;
    assert(is_ok(t) == 1 && close(ph, 7.0, tol12()) == 1, "pure water pH");
}

fn _t_strong_acid_ph() {
    test_group("strong_acid_ph");
    var t, v = ph_from_h_concentration(0.1);
    var ph: f64 = v;
    assert(is_ok(t) == 1 && close(ph, 1.0, tol12()) == 1, "0.1 M strong acid pH");
}

fn _t_ph_poh_sum_14() {
    test_group("ph_poh_sum_14");
    var ph: f64 = 3.0;
    var poh: f64 = 14.0 - ph;
    var back: f64 = ph_from_poh(poh);
    var d: f64 = f64_abs(back - ph);
    assert(d < eps64(), "pH + pOH = 14");
}

fn _t_ph_h_roundtrip() {
    test_group("ph_h_roundtrip");
    var ph: f64 = 4.5;
    var h: f64 = h_concentration_from_ph(ph);
    var t, v = ph_from_h_concentration(h);
    var back: f64 = v;
    assert(is_ok(t) == 1 && close(back, ph, tol12()) == 1, "pH round trip");
}

