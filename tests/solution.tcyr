    test_group("negative_ionic_strength_is_error");
    var t1, v1 = debye_huckel_limiting(1, -0.1, 0.509);
    assert_eq(is_err_result(t1), 1, "limiting");
    var t2, v2 = debye_huckel_extended(1, -0.1, 0.509, 0.328, 3.0);
    assert_eq(is_err_result(t2), 1, "extended");
    var t3, v3 = davies_activity(1, -0.1, 0.509);
    assert_eq(is_err_result(t3), 1, "Davies");
}

fn _t_non_finite_ionic_strength_or_a_is_error() {
    test_group("non_finite_ionic_strength_or_a_is_error");
    var nan: f64 = _km_nan();
    var inf: f64 = 1.0 / 0.0;
    var ivals: f64[2];
    ivals[0] = nan;
    ivals[1] = inf;
    var k = 0;
    while (k < 2) {
        var i: f64 = ivals[k];
        var t1, v1 = debye_huckel_limiting(1, i, 0.509);
        assert_eq(is_err_result(t1), 1, "limiting I");
        var t2, v2 = debye_huckel_extended(1, i, 0.509, 0.328, 3.0);
        assert_eq(is_err_result(t2), 1, "extended I");
        var t3, v3 = davies_activity(1, i, 0.509);
        assert_eq(is_err_result(t3), 1, "Davies I");
        k = k + 1;
    }
    var t4, v4 = debye_huckel_limiting(1, 0.01, nan);
    assert_eq(is_err_result(t4), 1, "limiting A NaN");
    var t5, v5 = davies_activity(1, 0.01, inf);
    assert_eq(is_err_result(t5), 1, "Davies A inf");
}

# ── conductivity ────────────────────────────────────────────────────────────────────

fn _t_limiting_molar_conductivity_nacl() {
    test_group("limiting_molar_conductivity_nacl");
    var l: f64 = limiting_molar_conductivity(KM_LAMBDA_NA_PLUS, 1.0, KM_LAMBDA_CL_MINUS, 1.0);
    assert(close(l, 126.4, tol12()) == 1, "Λ°(NaCl)");
}

fn _t_limiting_molar_conductivity_hcl() {
    test_group("limiting_molar_conductivity_hcl");
    var l: f64 = limiting_molar_conductivity(KM_LAMBDA_H_PLUS, 1.0, KM_LAMBDA_CL_MINUS, 1.0);
    assert(close(l, 426.1, tol12()) == 1, "Λ°(HCl)");
}

fn _t_kohlrausch_decreases_with_concentration() {
    test_group("kohlrausch_decreases_with_concentration");
    var t1, v1 = kohlrausch_molar_conductivity(126.4, 10.0, 0.01);
    var t2, v2 = kohlrausch_molar_conductivity(126.4, 10.0, 0.1);
    var lm1: f64 = v1;
    var lm2: f64 = v2;
    assert(is_ok(t1) == 1 && is_ok(t2) == 1 && lm2 < lm1, "higher c should give lower Λ_m");
    assert(close(lm1, 125.4, tol12()) == 1, "Λ_m at 0.01 M");
}

fn _t_solution_conductivity_basic() {
    test_group("solution_conductivity_basic");
    var kappa: f64 = solution_conductivity(126.4, 0.1);
    assert(close(kappa, 0.01264, 0.000000000000001) == 1, "κ");
}

# ── Cyrius-only ─────────────────────────────────────────────────────────────────────

# ionic_strength's records: n 16-byte (f64 bits, i64 charge) records. No ions is Rust's 0.5 × −0.0 = −0.0; no
# list (n < 0, or a null pointer with n > 0) and a charge outside the i32 range are NaN (no error channel); a
# null pointer with n = 0 is the empty list.
fn _t_cyrius_ion_records() {
    test_group("cyrius_ion_records");
    var e: f64 = ionic_strength(0, 0);
    assert_eq(_km_bits(e), 0x8000000000000000, "no ions: -0.0");
    var p = ions2(0.1, 1, 0.1, 0 - 1);
    var e2: f64 = ionic_strength(p, 0);
    assert_eq(_km_bits(e2), 0x8000000000000000, "n = 0 reads nothing");
    var n1: f64 = ionic_strength(p, 0 - 1);
    assert_eq(ulp_is_nan(n1), 1, "n < 0: NaN");
    var n2: f64 = ionic_strength(0, 2);
    assert_eq(ulp_is_nan(n2), 1, "null pointer with n > 0: NaN");
    var n3: f64 = ionic_strength(ions2(0.1, 2147483648, 0.1, 1), 2);
    assert_eq(ulp_is_nan(n3), 1, "charge 2^31: NaN, not wrapped");
    var n4: f64 = ionic_strength(ions2(0.1, 1, 0.1, 0 - 2147483649), 2);
    assert_eq(ulp_is_nan(n4), 1, "charge -2^31 - 1: NaN");
    var ok: f64 = ionic_strength(ions2(0.1, 2147483647, 0.1, 0 - 2147483648), 2);
    assert(ulp_is_nan(ok) == 0 && ok > 0.0, "i32::MAX and i32::MIN are charges");
}

# The activity models take Rust's i32 charge as a word: outside the i32 range is Err(InvalidInput), checked
# before anything else (a valid charge with a bad I gives the same code, after it).
fn _t_cyrius_i32_charges() {
    test_group("cyrius_i32_charges");
    var big = 2147483648;
    var small = 0 - 2147483649;
    var t1, v1 = debye_huckel_limiting(big, 0.01, 0.509);
    assert(is_err_code(t1, v1, KM_ERR_INVALID_INPUT) == 1, "limiting 2^31");
    var t2, v2 = debye_huckel_extended(small, 0.01, 0.509, 0.328, 3.0);
    assert(is_err_code(t2, v2, KM_ERR_INVALID_INPUT) == 1, "extended -2^31 - 1");
    var t3, v3 = davies_activity(big, 0.01, 0.509);
    assert(is_err_code(t3, v3, KM_ERR_INVALID_INPUT) == 1, "Davies 2^31");
    var t4, v4 = davies_activity(4294967297, 0.01, 0.509);
    assert(is_err_code(t4, v4, KM_ERR_INVALID_INPUT) == 1, "2^32 + 1 is not charge 1");
    var t5, v5 = debye_huckel_limiting(2147483647, 0.0, 0.509);
    var g: f64 = v5;
    assert(is_ok(t5) == 1 && g == 1.0, "i32::MAX at I = 0: γ = 1");
}

# The private charge-balance Newton (Rust's charge_balance_root / checked_root), transcribed. Its exits: f(x) ≤ 0
# at the starting bound (water dominates: the root is √Kw), the relative step, and a non-finite step (Ka·C
# overflows) → ComputationError. Rust's CHARGE_BALANCE_REL_TOL = 1e-12 is pinned from both sides by two golden
# decade rows whose roots differ by one ulp with 2e-12 (Ka 1e-16, C 1e7) and with 0.5e-12 (Ka 1e-13, C 1e11).
# CHARGE_BALANCE_MAX_ITER = 50 can't be reached by any input: Newton from the bound converges in at most 7
# updates (port-parity.md §7), so the cap is transcribed but unobservable, as the flame solver's (ADR 0003).
fn _t_cyrius_charge_balance_root() {
    test_group("cyrius_charge_balance_root");
    var tiny: f64 = 0.0000000000000000000000000000000000000001;   # 1e-40
    var t1, v1 = _km_charge_balance_root(tiny, tiny);
    assert(is_ok(t1) == 1 && _km_bits(v1) == 0x3E7AD7F29ABCAF48, "f(x0) <= 0: the root is sqrt(Kw) = 1e-7");
    var t2, v2 = _km_charge_balance_root(0.000018, 0.1);
    assert(is_ok(t2) == 1 && _km_bits(v2) == 0x3F55D5A090C34EBA, "acetic acid: 4 updates, relative step");
    var big: f64 = 0x7E37E43C8800759C;   # 1e300
    var t3, v3 = _km_charge_balance_root(big, big);
    assert(is_err_code(t3, v3, KM_ERR_COMPUTATION_ERROR) == 1, "non-finite step: ComputationError");
    var t4, v4 = _km_charge_balance_root(0.0000000000000001, 10000000.0);
    assert(is_ok(t4) == 1 && _km_bits(v4) == 0x3F00945BC363B0FF, "tol 1e-12, not 2e-12 (...b100)");
    var t5, v5 = _km_charge_balance_root(0.0000000000001, 100000000000.0);
    assert(is_ok(t5) == 1 && _km_bits(v5) == 0x3FB999999999999A, "tol 1e-12, not 0.5e-12 (...999)");
    # checked_root accepts only a positive, finite x.
    var nan: f64 = _km_nan();
    var inf: f64 = 1.0 / 0.0;
    var z: f64 = -0.0;
    var t6, v6 = _km_checked_root(0.0);
    assert(is_err_code(t6, v6, KM_ERR_COMPUTATION_ERROR) == 1, "checked_root(0)");
    var t7, v7 = _km_checked_root(z);
    assert(is_err_code(t7, v7, KM_ERR_COMPUTATION_ERROR) == 1, "checked_root(-0)");
    var t8, v8 = _km_checked_root(nan);
    assert(is_err_code(t8, v8, KM_ERR_COMPUTATION_ERROR) == 1, "checked_root(NaN)");
    var t9, v9 = _km_checked_root(inf);
    assert(is_err_code(t9, v9, KM_ERR_COMPUTATION_ERROR) == 1, "checked_root(inf)");
    var t10, v10 = _km_checked_root(-0.000001);
    assert(is_err_code(t10, v10, KM_ERR_COMPUTATION_ERROR) == 1, "checked_root(-1e-6)");
    var t11, v11 = _km_checked_root(0.0000001);
    assert(is_ok(t11) == 1 && okf(t11, v11) == 0.0000001, "checked_root(1e-7)");
}

# henderson_hasselbalch's log10 is the correctly rounded _km_cr_log10 (ADR 0006; M3a's _km_log10_ln, glibc's
# e_log10.c composition, until M3c-3). On the golden near-cancellation row with base/acid = 0.8068…/2.6858… glibc's
# log10 is not correctly rounded (…69da; correctly rounded, MPFR: …69db), so the oracle's pH is +0.0 and the
# corrected oracle's (tests/golden/solution.cr.tsv) is −2⁻⁵³, one step of the log's ulp below: the port returns
# the corrected value. Plus log10's exact and special cases.
fn _t_cyrius_henderson_log10() {
    test_group("cyrius_henderson_log10");
    var t, v = henderson_hasselbalch(0.5222965678797735, 0.8068231517516123, 2.6858077314049895);
    assert(is_ok(t) == 1 && _km_bits(v) == 0xBCA0000000000000, "pKa + log10(ratio) = -2^-53, the corrected oracle's");
    var r: f64 = 0.8068231517516123 / 2.6858077314049895;
    var l: f64 = _km_cr_log10(r);
    assert_eq(_km_bits(l), 0xBFE0B6A74ABB69DB, "the correctly rounded log10 bits (glibc's are ...69DA)");
    var one: f64 = _km_cr_log10(1.0);
    assert_eq(_km_bits(one), 0, "log10(1) = +0");
    var k: f64 = _km_cr_log10(1000.0);
    assert(k == 3.0, "log10(1000) = 3");
    var dmin: f64 = 0.0;
    store64(&dmin, 1);                   # the smallest subnormal, 5e-324
    var sub: f64 = _km_cr_log10(dmin);
    var subw: f64 = 0.0;
    store64(&subw, 0xC07434E6420F4374);  # log10(5e-324), correctly rounded (MPFR; glibc's too)
    assert_bits_eq(sub, subw, "the smallest subnormal");
    var zero: f64 = _km_cr_log10(0.0);
    assert(ulp_is_inf(zero) == 1 && zero < 0.0, "log10(0) = -inf");
    var neg: f64 = _km_cr_log10(-1.0);
    assert_eq(ulp_is_nan(neg), 1, "log10(-1) = NaN");
}

# The generated constants (src/constants.cyr) hold the oracle's bits; KW is written positionally.
fn _t_cyrius_constants() {
    test_group("cyrius_constants");
    var kw: f64 = KM_KW_WATER_25C;
    assert_eq(_km_bits(kw), 0x3D06849B86A12B9B, "KW = 1e-14");
    var a: f64 = KM_DH_A_WATER_25C;
    var b: f64 = KM_DH_B_WATER_25C;
    assert(a == 0.509 && b == 0.328, "Debye–Hückel A, B");
    var so4: f64 = KM_LAMBDA_SO4_2MINUS;
    var oh: f64 = KM_LAMBDA_OH_MINUS;
    assert(so4 == 160.0 && oh == 198.0, "λ°");
}

# The f64 whose bit pattern is `bits` (store64, so no hex literal is read as an integer).
#must_use
fn fbits(bits): f64 {
    var x: f64 = 0.0;
    store64(&x, bits);
    return x;
}

# ADR 0002 #29 (the overflow audit's B2): dilution's M₁·V₁/V₂ and solution_conductivity's Λ·c/1000 rounded once, where
# Rust rounds twice and a partial product over- or underflows; Rust's expression for a non-finite input of the
# unvalidated conductivity; the public functions against the monomial's exact path on 5,000 seeded triples.
fn _t_cyrius_adr29() {
    test_group("cyrius_adr29");
    var t1, v1 = dilution(1.5, 0.2, 0.6);
    assert(is_ok(t1) == 1 && v1 == 0x3FE0000000000000, "1.5·0.2/0.6 = 0.5 (Rust's 0.5000000000000001)");
    var e200: f64 = fbits(0x6974E718D7D7625A);      # 1e200
    var t2, v2 = dilution(e200, e200, e200);
    assert(is_ok(t2) == 1 && v2 == 0x6974E718D7D7625A, "1e200·1e200/1e200 = 1e200 (Rust's ∞)");
    var y: f64 = 3002399751580331.0;                # 3y = 2^53 + 1
    var t3, v3 = dilution(y, 3.0, 2.0);
    assert(is_ok(t3) == 1 && v3 == 0x4330000000000000, "y·3/2 = 2^52 + ½, a tie: 2^52 (even)");
    var mz: f64 = -0.0;
    var big: f64 = fbits(0x7E37E43C8800759C);       # 1e300
    var tiny: f64 = fbits(0x01A56E1FC2F8F359);      # 1e-300
    var t4, v4 = dilution(mz, big, tiny);
    assert(is_ok(t4) == 1 && v4 == 0x8000000000000000, "−0·1e300/1e-300 = −0");
    var dmax: f64 = fbits(0x7FEFFFFFFFFFFFFF);
    var c1: f64 = solution_conductivity(126.4, dmax);
    assert_eq(_km_bits(c1), 0x7FC02DE00D1B7175, "126.4·DBL_MAX/1000 = 2.27·10³⁰⁷ (Rust's ∞)");
    var c2: f64 = solution_conductivity(126.4, 0.01);
    assert_eq(_km_bits(c2), 0x3F54B599AA60913B, "126.4·0.01/1000 rounded once (Rust's one ulp below)");
    var inf: f64 = 1.0 / 0.0;
    var c3: f64 = solution_conductivity(inf, 0.0);
    assert_eq(ulp_is_nan(_km_bits(c3)), 1, "∞·0/1000: Rust's NaN (a non-finite input keeps Rust's expression)");
    var c4: f64 = solution_conductivity(mz, 1.0);
    assert_eq(_km_bits(c4), 0x8000000000000000, "−0·1/1000 = −0");
    var st = 0x2545F4914F6CDD1D;
    var bad = 0;
    var nb: f64[2];
    var db: f64[1];
    var k = 0;
    while (k < 5000) {
        var w: f64[3];
        var j = 0;
        while (j < 3) {
            st = st ^ (st << 13);
            st = st ^ (st >> 7);
            st = st ^ (st << 17);
            var bb = 0x3000000000000000 + ((st >> 3) % 0x1C00000000000000);
            if (j < 2) { bb = bb | (st & 0x8000000000000000); }
            store64(&w + 8 * j, bb);
            j = j + 1;
        }
        var a: f64 = load64(&w);
        var b: f64 = load64(&w + 8);
        var c: f64 = load64(&w + 16);
        store64(&nb, a);
        store64(&nb + 8, b);
        store64(&db, c);
        var td, vd = dilution(a, b, c);
        var xd: f64 = _km_cr_mono_acc(&nb, 2, &db, 1);
        if (is_ok(td) != 1 || vd != _km_bits(xd)) { bad = bad + 1; }
        var th: f64 = 1000.0;
        store64(&db, th);
        var rc: f64 = solution_conductivity(a, b);
        var xc: f64 = _km_cr_mono_acc(&nb, 2, &db, 1);
        if (_km_bits(rc) != _km_bits(xc)) { bad = bad + 1; }
        k = k + 1;
    }
    assert_eq(bad, 0, "dilution and solution_conductivity = the exact path on 5,000 seeded triples");
}

# ADR 0002 #33 (the overflow audit's B4): ionic_strength's term past DBL_MAX whose half is finite (Rust's ∞), terms of
# opposite infinities (Rust's NaN, the value 0); kohlrausch_molar_conductivity's K·√c past DBL_MAX (Rust's −∞);
# limiting_molar_conductivity's products past DBL_MAX that cancel (Rust's ∞); the fast paths against the slow paths on
# 3,000 seeded inputs.
fn _t_cyrius_adr33_solution() {
    test_group("cyrius_adr33_solution");
    var dmax: f64 = fbits(0x7FEFFFFFFFFFFFFF);
    var ions: i64[6];
    var c: f64 = 0.4 * dmax;
    store64(&ions, _km_bits(c));
    store64(&ions + 8, 2);
    var i1: f64 = ionic_strength(&ions, 1);
    assert_eq(_km_bits(i1), 0x7FE9999999999999, "½·(0.4·DBL_MAX)·2² = 1.44·10³⁰⁸ (Rust's ∞)");
    var nd: f64 = -dmax;
    store64(&ions, _km_bits(dmax));
    store64(&ions + 16, _km_bits(nd));
    store64(&ions + 24, 2);
    var i2: f64 = ionic_strength(&ions, 2);
    assert_eq(_km_bits(i2), 0, "½·(4·DBL_MAX − 4·DBL_MAX) = +0 (Rust's ∞ − ∞ = NaN)");
    var t1, v1 = kohlrausch_molar_conductivity(dmax, dmax, 1.21);
    assert(is_ok(t1) == 1 && v1 == 0xFFB9999999999998, "DBL_MAX − 1.1·DBL_MAX = −1.80·10³⁰⁷ (Rust's −∞)");
    var l1: f64 = limiting_molar_conductivity(dmax, 1.5, nd, 1.0);
    assert_eq(_km_bits(l1), 0x7FDFFFFFFFFFFFFE, "1.5·DBL_MAX − DBL_MAX = 8.99·10³⁰⁷ (Rust's ∞)");
    var inf: f64 = 1.0 / 0.0;
    var l2: f64 = limiting_molar_conductivity(inf, 0.0, 1.0, 1.0);
    assert_eq(ulp_is_nan(_km_bits(l2)), 1, "0·∞: Rust's NaN (a non-finite input keeps Rust's expression)");
    var st = 0x2545F4914F6CDD1D;
    var bad = 0;
    var took = 0;
    var w: f64[4];
    var k = 0;
    while (k < 3000) {
        var j = 0;
        while (j < 4) {
            st = st ^ (st << 13);
            st = st ^ (st >> 7);
            st = st ^ (st << 17);
            store64(&w + 8 * j, ((st >> 2) % 0x7FE0000000000000) | ((st & 1) << 63));
            j = j + 1;
        }
        var a: f64 = load64(&w);
        var b: f64 = load64(&w + 8);
        var cc: f64 = f64_abs(load64(&w + 16));
        var d: f64 = load64(&w + 24);
        var kf, ko = _km_kohlrausch_fast(a, b, cc);
        if (ko == 1) {
            took = took + 1;
            var ku: f64 = _km_kohlrausch_ux(a, b, cc);
            if (_km_bits(kf) != _km_bits(ku)) { bad = bad + 1; }
        }
        var lf, lo = _km_limiting_fast(a, b, cc, d);
        if (lo == 1) {
            took = took + 1;
            var lu: f64 = _km_limiting_ux(a, b, cc, d);
            if (_km_bits(lf) != _km_bits(lu)) { bad = bad + 1; }
        }
        k = k + 1;
    }
    assert_eq(bad, 0, "Rust's chain = the unbounded-exponent evaluation wherever the fast tests pass");
    assert(took > 2000, "the fast tests pass on most seeded inputs");
}

