        fmt_int(_par_adr22);
        print(" reduced_mass rows where the port's correctly rounded m1*m2/(m1 + m2) differs from Rust's", 89);
        println(" (accepted, ADR 2, counted, not listed)");
        print("  ADR 0002 #23 AME2020 / TICE 2009 isotope table: ", 50);
        fmt_int(_par_adr23_abund + _par_adr23_pattern);
        print(" rows (isotope_abundances ", 26);
        fmt_int(_par_adr23_abund);
