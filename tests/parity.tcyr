# The enum value whose golden name (by `which`: 0 BondType, 1 Geometry, 2 FunctionalGroup) is input token k, an
# `e:` token; -1 for none.
#must_use
fn _par_in_enum(k, which): i64 {
    var at = k * 8;
    if (k >= _par_in_n || load64(_par_in_k + at) != 101) { return 0 - 1; }
    var p = load64(_par_in_v + at);
    var len = load64(_par_in_l + at);
    var count = KM_BOND_TYPE_COUNT;
    if (which == 1) { count = KM_GEOMETRY_COUNT; }
    if (which == 2) { count = KM_FUNCTIONAL_GROUP_COUNT; }
    var v = 0;
    while (v < count) {
        var name = _par_bond_name(v);
        if (which == 1) { name = _par_geometry_name(v); }
        if (which == 2) { name = _par_group_name(v); }
        if (_par_eq(p, len, name) == 1) { return v; }
        v = v + 1;
    }
    return 0 - 1;
}

# The bond list at input token k (`v:n`, then n pairs `e:BondType.<Variant> i:count`) as n 16-byte records (the
# KmBondType value, the count), the layout src/organic.cyr's enthalpy_from_bonds takes; its count is _par_in(k), and
# the list spans 1 + 2n tokens. 0 for an empty list, -1 for an unknown variant.
fn _par_in_bonds(k): i64 {
    var n = _par_in(k);
    if (n <= 0) { return 0; }
    var buf = alloc(n * 16);
    var j = 0;
    while (j < n) {
        var bt = _par_in_enum(k + 1 + 2 * j, 0);
        if (bt < 0) { return 0 - 1; }
        store64(buf + j * 16, bt);
        store64(buf + j * 16 + 8, _par_in(k + 2 + 2 * j));
        j = j + 1;
    }
    return buf;
}

# ADR 0002 #6: the renamed items' rows, compared exactly under the new names (class A) and counted for the summary.
var _par_adr6_donor = 0;      # FunctionalGroup::hydrogen_bonding rows, through functional_group_is_hydrogen_bond_donor
var _par_adr6_tshaped = 0;    # rows whose input or output is Geometry.TShapedThreeLonePairs, KM_GEOMETRY_T_SHAPED

# `organic` rows: src/organic.cyr and the generated src/organic_data.cyr. An enum input is an `e:` token, read
# through the golden names above; predict_geometry's two u8s are `i:` words.
fn _par_organic(fp, fl): i64 {
    if (_par_eq(fp, fl, "organic::enthalpy_from_bonds") == 1) {
        var nb = _par_in(0);
        var nf = _par_in(1 + 2 * nb);
        var broken = _par_in_bonds(0);
        var formed = _par_in_bonds(1 + 2 * nb);
        if (broken < 0 || formed < 0) { return 0 - 1; }
        var dh: f64 = enthalpy_from_bonds(broken, nb, formed, nf);
        _par_got_f(dh);
        return 1;
    }
    if (_par_eq(fp, fl, "organic::predict_geometry") == 1) {
        var t, g = predict_geometry(_par_in(0), _par_in(1));
        if (is_some(t) != 1) { _par_got_none(); return 1; }
        if (g == KM_GEOMETRY_T_SHAPED) { _par_adr6_tshaped = _par_adr6_tshaped + 1; }
        _par_got_e(_par_geometry_name(g));
        return 1;
    }
    if (_par_eq(fp, fl, "BondType::energy_kj") == 1) {
        var bt = _par_in_enum(0, 0);
        if (bt < 0) { return 0 - 1; }
        var e: f64 = bond_type_energy_kj(bt);
        _par_got_f(e);
        return 1;
    }
    if (_par_eq(fp, fl, "Geometry::ideal_bond_angle") == 1) {
        var ge = _par_in_enum(0, 1);
        if (ge < 0) { return 0 - 1; }
        if (ge == KM_GEOMETRY_T_SHAPED) { _par_adr6_tshaped = _par_adr6_tshaped + 1; }
        var a: f64 = geometry_ideal_bond_angle(ge);
        _par_got_f(a);
        return 1;
    }
    var fg = _par_in_enum(0, 2);
    if (fg < 0) { return 0 - 1; }
    if (_par_eq(fp, fl, "FunctionalGroup::pattern") == 1) {
        var pat = functional_group_pattern(fg);
        _par_got_text(pat, strlen(pat));
        return 1;
    }
    if (_par_eq(fp, fl, "FunctionalGroup::is_polar") == 1) { _par_got_i(functional_group_is_polar(fg)); return 1; }
    if (_par_eq(fp, fl, "FunctionalGroup::hydrogen_bonding") == 1) {
        _par_adr6_donor = _par_adr6_donor + 1;
        _par_got_i(functional_group_is_hydrogen_bond_donor(fg));
        return 1;
    }
    return 0;
}

# ── inorganic (M4b) ─────────────────────────────────────────────────────────────────

# The golden name of a KmLigand value ("Ligand.Water").
#must_use
fn _par_ligand_name(v): i64 {
    if (v == KM_LIGAND_IODIDE) { return "Ligand.Iodide"; }
    if (v == KM_LIGAND_BROMIDE) { return "Ligand.Bromide"; }
    if (v == KM_LIGAND_CHLORIDE) { return "Ligand.Chloride"; }
    if (v == KM_LIGAND_FLUORIDE) { return "Ligand.Fluoride"; }
    if (v == KM_LIGAND_HYDROXIDE) { return "Ligand.Hydroxide"; }
    if (v == KM_LIGAND_WATER) { return "Ligand.Water"; }
    if (v == KM_LIGAND_AMMONIA) { return "Ligand.Ammonia"; }
    if (v == KM_LIGAND_ETHYLENEDIAMINE) { return "Ligand.Ethylenediamine"; }
    if (v == KM_LIGAND_NITRITE) { return "Ligand.Nitrite"; }
    if (v == KM_LIGAND_CYANIDE) { return "Ligand.Cyanide"; }
    if (v == KM_LIGAND_CARBON_MONOXIDE) { return "Ligand.CarbonMonoxide"; }
    return "Ligand.?";
}

# The KmLigand value whose golden name is input token k, an `e:` token; -1 for none.
#must_use
fn _par_in_ligand(k): i64 {
    var at = k * 8;
    if (k >= _par_in_n || load64(_par_in_k + at) != 101) { return 0 - 1; }
    var p = load64(_par_in_v + at);
    var len = load64(_par_in_l + at);
    var v = 0;
    while (v < KM_LIGAND_COUNT) {
        if (_par_eq(p, len, _par_ligand_name(v)) == 1) { return v; }
        v = v + 1;
    }
    return 0 - 1;
}

# ADR 0002 #12, the exact CFSE: Ok rows where the port's (3·eg − 2·t2g)/5 equals the oracle's value (plain ok) and where
# it is the exact value the oracle's misses (mapped: _par_mapped = 12, accepted under ADR 2 and printed by name).
var _par_adr12_same = 0;
var _par_adr12_mapped = 0;

# Appends an IonicRadius's four fields (symbol, charge, coordination, radius), in declaration order.
fn _par_got_ionic_radius(h) {
    var sym = ionic_radius_symbol(h);
    _par_got_text(sym, strlen(sym));
    _par_got_i(ionic_radius_charge(h));
    _par_got_i(ionic_radius_coordination(h));
    var r: f64 = ionic_radius_radius_pm(h);
    _par_got_f(r);
}

# `inorganic` rows: src/inorganic.cyr and the generated src/inorganic_data.cyr. Rust's u8, u32, i8 and bool inputs are
# `i:` words (a bool 0 / 1); the ligand an `e:` token.
fn _par_inorganic(fp, fl): i64 {
    if (_par_eq(fp, fl, "inorganic::IONIC_RADII") == 1) { _par_got_seq(KM_IONIC_RADII_COUNT); return 1; }
    if (_par_eq(fp, fl, "inorganic::IONIC_RADII[]") == 1) { _par_got_ionic_radius(_par_in(0) + 1); return 1; }
    if (_par_eq(fp, fl, "inorganic::lookup_ionic_radius") == 1) {
        var sym = _par_in_text(0);
        if (sym == 0) { return 0 - 1; }
        var h = lookup_ionic_radius(sym, _par_in(1));
        if (h == 0) { _par_got_none(); } else { _par_got_ionic_radius(h); }
        return 1;
    }
    if (_par_eq(fp, fl, "Ligand::field_strength") == 1 || _par_eq(fp, fl, "Ligand::is_strong_field") == 1) {
        var l = _par_in_ligand(0);
        if (l < 0) { return 0 - 1; }
        if (_par_eq(fp, fl, "Ligand::field_strength") == 1) { _par_got_i(ligand_field_strength(l)); return 1; }
        _par_got_i(ligand_is_strong_field(l));
        return 1;
    }
    if (_par_eq(fp, fl, "inorganic::cfse_octahedral") == 1) {
        var t, v = cfse_octahedral(_par_in(0), _par_in(1));
        _par_got_res(t, v);
        if (is_ok(t) != 1 || _par_want_n != 1 || load64(_par_want_k) != 102) { return 1; }
        var oracle: f64 = load64(_par_want_v);
        if (_km_bits(v) == _km_bits(oracle)) { _par_adr12_same = _par_adr12_same + 1; return 1; }
        # ADR 0002 #12: the oracle's t2g·(−0.4) + eg·0.6 is within a few ulps of q/5 for the integer q = 3·eg − 2·t2g;
        # the port must return q / 5 correctly rounded. q comes from the oracle's value (round(5v), + 0.0 for a +0
        # numerator), not from the port's tables, so a wrong occupancy or formula fails the row.
        var w5: f64 = oracle * 5.0;
        var q0: f64 = _km_round_half_away(w5);
        var q: f64 = q0 + 0.0;
        var dq: f64 = f64_abs(w5 - q);
        var exact: f64 = q / 5.0;
        if (dq < 0.000000001 && _km_bits(v) == _km_bits(exact)) {
            # The row's reference is the exact value, 0 ulp from the port's: kept out of the histogram, which shows the
            # oracle-equal rows; the accepted line prints the port's and the oracle's bits.
            _par_mapped = 12;
            _par_hist_on = 0;
            _par_adr12_mapped = _par_adr12_mapped + 1;
        }
        return 1;
    }
    if (_par_eq(fp, fl, "inorganic::unpaired_electrons_oct") == 1) {
        var tu, vu = unpaired_electrons_oct(_par_in(0), _par_in(1));
        if (is_ok(tu) == 1) { _par_got_i(vu); } else { _par_got_err(vu); }
        return 1;
    }
    if (_par_eq(fp, fl, "inorganic::spin_only_moment") == 1) {
        var mu: f64 = spin_only_moment(_par_in(0));
        _par_got_f(mu);
        return 1;
    }
    var x: f64 = _par_in(0);
    if (_par_eq(fp, fl, "inorganic::delta_tet_from_oct") == 1) {
        var tet: f64 = delta_tet_from_oct(x);
        if (_par_note_has("[ADR 0002 #15:") == 1) {
            _par_map_exact(15, _km_bits(tet), 102);
            return 1;
        }
        _par_got_f(tet);
        return 1;
    }
    if (_par_eq(fp, fl, "inorganic::born_lande_lattice_energy") == 1) {
        var r0: f64 = _par_in(3);
        var n: f64 = _par_in(4);
        var tl, vl = born_lande_lattice_energy(x, _par_in(1), _par_in(2), r0, n);
        _par_got_noted(32, "[ADR 0002 #32:", tl, vl);
        if (_par_mapped == 32) { _par_adr32_bl = _par_adr32_bl + 1; }
        return 1;
    }
    if (_par_eq(fp, fl, "inorganic::born_haber_lattice_energy") == 1) {
        var y: f64 = _par_in(1);
        var z: f64 = _par_in(2);
        var w: f64 = _par_in(3);
        var q: f64 = _par_in(4);
        var u: f64 = born_haber_lattice_energy(x, y, z, w, q);
        _par_got_noted_f(33, "[ADR 0002 #33:", u);
        if (_par_mapped == 33) { _par_adr33_haber = _par_adr33_haber + 1; }
        return 1;
    }
    return 0;
}

# ── ADR 0002 #13 … #22: an exact value named in the note ───────────────────────────────
# Where the port's value is the exact one and the oracle's is not, and the exact value can't be derived from the
# oracle's (unlike #12's q/5), the golden row keeps the oracle's value and its note names the port's, `[ADR 0002 #N: …
# (f:<bits>)]` or `(i:<0|1>)]`; scripts/oracle writes it and validate.py proves it with exact rational arithmetic. A
# noted row's port value must be that one, bit for bit: then it is mapped (_par_mapped = N, accepted under ADR 2,
# printed by name); any other value fails. A row without the note is compared with the oracle as usual.
var _par_adr13 = 0;
var _par_adr14 = 0;
var _par_adr15 = 0;
var _par_adr16 = 0;
var _par_adr19 = 0;
var _par_adr20 = 0;
var _par_adr21 = 0;
var _par_adr22 = 0;
var _par_adr21_level = 0;                   # #21 per function: bohr_energy_level, bohr_transition_energy,
var _par_adr21_trans = 0;                   # rydberg_wavelength, SpectralSeries::wavelength
var _par_adr21_ryd = 0;
var _par_adr21_series = 0;

# 1 if the current row's note contains the C string `tag`.
#must_use
fn _par_note_has(tag): i64 {
    var n = strlen(tag);
    var k = 0;
    while (k + n <= _par_note_l) {
        if (load8(_par_note_p + k) == load8(tag)) {
            if (memeq(_par_note_p + k, tag, n) == 1) { return 1; }
        }
        k = k + 1;
    }
    return 0;
}

# The value of the note's trailing `(f:<16 hex>)]` (f64 bits) or `(i:<decimal>)]` token; *ok is 1 when there is one.
fn _par_note_value(ok): i64 {
    store64(ok, 0);
    var p = _par_note_p;
    var l = _par_note_l;
    if (l < 6 || load8(p + l - 1) != 93 || load8(p + l - 2) != 41) { return 0; }
    var k = l - 3;
    while (k >= 0 && load8(p + k) != 40) { k = k - 1; }
    if (k < 0 || load8(p + k + 2) != 58) { return 0; }
    var kind = load8(p + k + 1);
    var vp = p + k + 3;
    var vl = (l - 2) - (k + 3);
    var okw[8];
    store64(&okw, 1);
    var v = 0;
    if (kind == 102 && vl == 16) {
        v = _par_parse_hex(vp, vl, &okw);
    } elif (kind == 105 && vl > 0) {
        v = _par_parse_int(vp, vl, &okw);
    } else {
        return 0;
    }
    if (load64(&okw) != 1) { return 0; }
    store64(ok, 1);
    return v;
}

# The got list for a noted row of ADR 0002 #`adr`: the port's value v (f64 bits for kind 102 'f', an integer for 105
# 'i') when it is the note's, the row mapped; "Unknown" (which matches nothing) otherwise.
fn _par_map_exact(adr, v, kind) {
    var okw[8];
    var want = _par_note_value(&okw);
    var same = 0;
    if (load64(&okw) == 1 && want == v) { same = 1; }
    if (kind == 102 && load64(&okw) == 1 && ulp_is_nan(want) == 1 && ulp_is_nan(v) == 1) { same = 1; }
    if (same != 1) {
        _par_got_err(0 - 1);
        return 0;
    }
    if (kind == 102) { _par_got_f(v); } else { _par_got_i(v); }
    _par_mapped = adr;
    _par_force_map = 1;                     # accepted even within the class's tolerance (#19's one-ulp class-B rows)
    _par_hist_on = 0;
    if (adr == 13) { _par_adr13 = _par_adr13 + 1; }
    if (adr == 14) { _par_adr14 = _par_adr14 + 1; }
    if (adr == 15) { _par_adr15 = _par_adr15 + 1; }
    if (adr == 16) { _par_adr16 = _par_adr16 + 1; }
    if (adr == 19) { _par_adr19 = _par_adr19 + 1; }
    if (adr == 20) { _par_adr20 = _par_adr20 + 1; }
    if (adr == 21) { _par_adr21 = _par_adr21 + 1; }
    if (adr == 22) { _par_adr22 = _par_adr22 + 1; }
    return 0;
}

# ADR 0002 #23 (M4e-4): a Vec row whose note names the port's whole result, `[ADR 0002 #23: … (<golden tokens>)]` (the
# isotope table's slices and patterns, from the cited AME2020 / TICE 2009 table: scripts/oracle/README.md); since M4f
# also ADR 0002 #7's oxidation-state rows, `[ADR 0002 #7: … (v:n i:z i:p i:q …)]` (the exact rational states), so the
# note's tag is the C string `tag`. The got list, already the port's result, must be those tokens exactly (a float bit
# for bit, a length or an integer equal, a name's text equal); then the row is mapped (_par_mapped = adr, accepted
# under ADR 2, counted) and its comparison with the oracle's outputs is moot. Any other result becomes "Unknown", which
# matches nothing. Returns 1 when the row is noted.
var _par_adr23_abund = 0;
var _par_adr23_pattern = 0;
var _par_nt_k = 0;                          # the note's token list, _PAR_MAX tokens (allocated on first use)
var _par_nt_v = 0;
var _par_nt_l = 0;
fn _par_map_toks(adr, tag): i64 {
    if (_par_note_has(tag) != 1) { return 0; }
    if (_par_nt_k == 0) {
        _par_nt_k = _par_words(_PAR_MAX);
        _par_nt_v = _par_words(_PAR_MAX);
        _par_nt_l = _par_words(_PAR_MAX);
    }
    var p = _par_note_p;
    var l = _par_note_l;
    var same = 0;
    if (_par_nt_l != 0 && l >= 4 && load8(p + l - 1) == 93 && load8(p + l - 2) == 41) {
        var k = l - 3;
        while (k >= 0 && load8(p + k) != 40) { k = k - 1; }
        var n = 0 - 1;
        if (k >= 0) { n = _par_tokens(p + k + 1, (l - 2) - (k + 1), _par_nt_k, _par_nt_v, _par_nt_l); }
        if (n >= 0 && n == _par_got_n) {
            same = 1;
            var j = 0;
            while (j < n) {
                var at = j * 8;
                var kind = load64(_par_nt_k + at);
                var nv = load64(_par_nt_v + at);
                var gv = load64(_par_got_v + at);
                if (kind != load64(_par_got_k + at)) { same = 0; }
                elif (kind == 102 || kind == 105 || kind == 118) {
                    if (nv != gv) { same = 0; }
                } elif (kind != 110) {
                    var nl = load64(_par_nt_l + at);
                    if (nl != load64(_par_got_l + at) || memeq(nv, gv, nl) != 1) { same = 0; }
                }
                j = j + 1;
            }
        }
    }
    if (same != 1) {
        _par_got_n = 0;
        _par_got_err(0 - 1);
        return 1;
    }
    _par_mapped = adr;
    _par_force_map = 1;
    _par_hist_on = 0;
    return 1;
}

# ── nuclear (M4c) ───────────────────────────────────────────────────────────────────

# ADR 0002 #3: semi_empirical_binding_energy rows where the oracle's NaN (z > a or a = 0) is the port's
# Err(InvalidInput) (mapped: _par_mapped = 3, accepted under ADR 2 and printed by name), and the finite rows compared as
# values (class B).
var _par_adr3_mapped = 0;
var _par_adr3_ok = 0;

# Appends an Isotope's five fields (symbol, z, a, half-life, decay mode), in declaration order.
fn _par_got_isotope(h) {
    var sym = isotope_symbol(h);
    _par_got_text(sym, strlen(sym));
    _par_got_i(isotope_z(h));
    _par_got_i(isotope_a(h));
    var t: f64 = isotope_half_life_s(h);
    _par_got_f(t);
    var mode = isotope_decay_mode(h);
    _par_got_text(mode, strlen(mode));
}

# `nuclear` rows: src/nuclear.cyr and the generated src/nuclear_data.cyr. Rust's u32 inputs (z, n, a) are `i:` words;
# q_value's two slices are `v:n` + n floats each; decay_chain_two_step's Ok output is N_A, N_B and N_C, which the port
# writes to the caller's buffer (the Rust tuple, port plan §6.4); its count must be 3.
fn _par_nuclear(fp, fl): i64 {
    if (_par_eq(fp, fl, "nuclear::ISOTOPES") == 1) { _par_got_seq(KM_ISOTOPES_COUNT); return 1; }
    if (_par_eq(fp, fl, "nuclear::ISOTOPES[]") == 1) { _par_got_isotope(_par_in(0) + 1); return 1; }
    if (_par_eq(fp, fl, "nuclear::lookup_isotope") == 1) {
        var sym = _par_in_text(0);
        if (sym == 0) { return 0 - 1; }
        var h = lookup_isotope(sym);
        if (h == 0) { _par_got_none(); } else { _par_got_isotope(h); }
        return 1;
    }
    if (_par_eq(fp, fl, "nuclear::q_value") == 1) {
        var nr = _par_in(0);
        var np = _par_in(1 + nr);
        var reac = _par_in_slice(0);
        var prod = _par_in_slice(1 + nr);
        var q: f64 = q_value(reac, nr, prod, np);
        _par_got_noted_f(33, "[ADR 0002 #33:", q);
        if (_par_mapped == 33) { _par_adr33_q = _par_adr33_q + 1; }
        return 1;
    }
    if (_par_eq(fp, fl, "nuclear::semi_empirical_binding_energy") == 1) {
        var ts, vs = semi_empirical_binding_energy(_par_in(0), _par_in(1));
        var oracle_nan = 0;
        if (_par_want_n == 1 && load64(_par_want_k) == 102 && ulp_is_nan(load64(_par_want_v)) == 1) { oracle_nan = 1; }
        if (oracle_nan == 1) {
            # ADR 0002 #3: the oracle's NaN must be the port's Err(InvalidInput); an Ok, or another code, fails.
            if (is_ok(ts) == 1) {
                _par_got_err(0 - 1);    # "Unknown" matches nothing
                return 1;
            }
            _par_got_err(vs);
            if (vs == KM_ERR_INVALID_INPUT) {
                _par_mapped = 3;
                _par_adr3_mapped = _par_adr3_mapped + 1;
            }
            return 1;
        }
        _par_adr3_ok = _par_adr3_ok + 1;
        _par_got_res(ts, vs);
        return 1;
    }
    if (_par_eq(fp, fl, "nuclear::mass_defect") == 1) {
        var m: f64 = _par_in(2);
        var md: f64 = mass_defect(_par_in(0), _par_in(1), m);
        _par_got_f(md);
        return 1;
    }
    if (_par_eq(fp, fl, "nuclear::binding_energy_per_nucleon") == 1) {
        var mb: f64 = _par_in(2);
        var tb, vb = binding_energy_per_nucleon(_par_in(0), _par_in(1), mb);
        _par_got_noted(32, "[ADR 0002 #32:", tb, vb);
        if (_par_mapped == 32) { _par_adr32_bea = _par_adr32_bea + 1; }
        return 1;
    }
    var x: f64 = _par_in(0);
    if (_par_eq(fp, fl, "nuclear::decay_constant") == 1) {
        var t, v = decay_constant(x);
        _par_got_res(t, v);
        return 1;
    }
    if (_par_eq(fp, fl, "nuclear::binding_energy_mev") == 1) {
        var be: f64 = binding_energy_mev(x);
        _par_got_f(be);
        return 1;
    }
    var y: f64 = _par_in(1);
    if (_par_eq(fp, fl, "nuclear::activity") == 1) {
        var a: f64 = activity(x, y);
        _par_got_f(a);
        return 1;
    }
    if (_par_eq(fp, fl, "nuclear::atoms_after_half_lives") == 1) {
        var r: f64 = atoms_after_half_lives(x, y);
        if (_par_note_has("[ADR 0002 #13:") == 1) {
            _par_map_exact(13, _km_bits(r), 102);
            return 1;
        }
        _par_got_f(r);
        return 1;
    }
    if (_par_eq(fp, fl, "nuclear::time_for_fraction") == 1) {
        var tt, vt = time_for_fraction(x, y);
        _par_got_res(tt, vt);
        return 1;
    }
    if (_par_eq(fp, fl, "nuclear::is_secular_equilibrium") == 1) {
        var sv = is_secular_equilibrium(x, y);
        if (_par_note_has("[ADR 0002 #14:") == 1) {
            _par_map_exact(14, sv, 105);
            return 1;
        }
        _par_got_i(sv);
        return 1;
    }
    var z: f64 = _par_in(2);
    if (_par_eq(fp, fl, "nuclear::atoms_remaining") == 1) {
        var n: f64 = atoms_remaining(x, y, z);
        _par_got_f(n);
        return 1;
    }
    var w: f64 = _par_in(3);
    if (_par_eq(fp, fl, "nuclear::decay_chain_two_step") == 1) {
        var nabc[24];
        var tc, vc = decay_chain_two_step(x, y, z, w, &nabc);
        if (is_ok(tc) != 1) { _par_got_err(vc); return 1; }
        if (vc != 3) { return 0 - 1; }
        _par_got_f(load64(&nabc));
        _par_got_f(load64(&nabc + 8));
        _par_got_f(load64(&nabc + 16));
        return 1;
    }
    return 0;
}

# ── potential (M4d) ─────────────────────────────────────────────────────────────────

# Reads `n` points (three f64 tokens each) from input token `k` on into buf (24 bytes a point); returns buf.
fn _par_in_points(k, n, buf): i64 {
    var j = 0;
    while (j < 3 * n) {
        store64(buf + 8 * j, _par_in(k + j));
        j = j + 1;
    }
    return buf;
}

# The got list for a row whose note may name the port's exact value under ADR 0002 #`adr` (#16; the overflow audit's #27
# … #32): mapped when it does (_par_map_exact), compared with the oracle as usual otherwise.
fn _par_got_noted(adr, tag, t, v) {
    if (_par_note_has(tag) == 1) {
        if (is_ok(t) != 1) {
            _par_got_err(0 - 1);    # a noted row is an Ok row: an Err fails
            return 0;
        }
        _par_map_exact(adr, v, 102);
        return 0;
    }
    _par_got_res(t, v);
    return 0;
}

# ADR 0002 #20 (M4e-2): the got list for a geometry row (distance_3d's value when isres = 0, or bond_angle's /
# dihedral_angle's Result) whose note may name the port's result, Rust's sequence evaluated with an unbounded exponent:
# `= <x> (f:<bits>)]`, `= Ok(<x>) (f:<bits>)]` or `= Err(InvalidInput) (E:InvalidInput)]`. A noted row's port result
# must be that one (then mapped, accepted under ADR 2, counted); a row without the note is compared with the oracle as
# usual.
fn _par_got_noted20(isres, t, v) {
    if (_par_note_has("[ADR 0002 #20:") != 1) {
        if (isres == 1) { _par_got_res(t, v); } else { _par_got_f(v); }
        return 0;
    }
    if (_par_note_has("(E:InvalidInput)]") == 1) {
        if (isres != 1 || is_ok(t) == 1 || v != KM_ERR_INVALID_INPUT) {
            _par_got_err(0 - 1);    # the note's Err, and the port gave anything else: "Unknown" matches nothing
            return 0;
        }
        _par_got_err(v);
        _par_mapped = 20;
        _par_force_map = 1;
        _par_hist_on = 0;
        _par_adr20 = _par_adr20 + 1;
        return 0;
    }
    if (isres == 1 && is_ok(t) != 1) {
        _par_got_err(0 - 1);
        return 0;
    }
    _par_map_exact(20, v, 102);
    return 0;
}

# `potential` rows: src/potential.cyr. Rust's [f64; 3] points are three f64 tokens each, which the port reads through
# pointers to three contiguous f64 (port plan §6.4). ADR 0002 #16 (lj_equilibrium_distance), #20 (distance_3d,
# bond_angle, dihedral_angle) and #32 (the overflow audit's B3: lennard_jones, morse_width_parameter, coulomb,
# coulomb_force; it folds M4d's #17 and #18 in): a noted row's port result must be the note's.
fn _par_potential(fp, fl): i64 {
    var pts: f64[12];
    if (_par_eq(fp, fl, "potential::distance_3d") == 1) {
        _par_in_points(0, 2, &pts);
        var dd: f64 = distance_3d(&pts, &pts + 24);
        _par_got_noted20(0, 0, _km_bits(dd));
        return 1;
    }
    if (_par_eq(fp, fl, "potential::bond_angle") == 1) {
        _par_in_points(0, 3, &pts);
        var ta, va = bond_angle(&pts, &pts + 24, &pts + 48);
        _par_got_noted20(1, ta, va);
        return 1;
    }
    if (_par_eq(fp, fl, "potential::dihedral_angle") == 1) {
        _par_in_points(0, 4, &pts);
        var td, vd = dihedral_angle(&pts, &pts + 24, &pts + 48, &pts + 72);
        _par_got_noted20(1, td, vd);
        return 1;
    }
    var x: f64 = _par_in(0);
    if (_par_eq(fp, fl, "potential::lj_equilibrium_distance") == 1) {
        var r: f64 = lj_equilibrium_distance(x);
        if (_par_note_has("[ADR 0002 #16:") == 1) {
            _par_map_exact(16, _km_bits(r), 102);
            return 1;
        }
        _par_got_f(r);
        return 1;
    }
    var y: f64 = _par_in(1);
    var z: f64 = _par_in(2);
    if (_par_eq(fp, fl, "potential::lennard_jones") == 1) {
        var tl, vl = lennard_jones(x, y, z);
        _par_got_noted(32, "[ADR 0002 #32:", tl, vl);
        if (_par_mapped == 32) {
            _par_adr32_lj = _par_adr32_lj + 1;
            var e22: f64 = 0x7FD0000000000000;      # 2¹⁰²²: ADR 0002 #17's region, folded into #32
            if (x >= e22) { _par_adr32_lj17 = _par_adr32_lj17 + 1; }
        }
        return 1;
    }
    if (_par_eq(fp, fl, "potential::morse_width_parameter") == 1) {
        var tw, vw = morse_width_parameter(x, y, z);
        _par_got_noted(32, "[ADR 0002 #32:", tw, vw);
        if (_par_mapped == 32) {
            _par_adr32_width = _par_adr32_width + 1;
            var e23: f64 = 0x7FE0000000000000;      # 2¹⁰²³: ADR 0002 #18's region, folded into #32
            if (z >= e23) { _par_adr32_width18 = _par_adr32_width18 + 1; }
        }
        return 1;
    }
    if (_par_eq(fp, fl, "potential::coulomb") == 1) {
        var tc, vc = coulomb(x, y, z);
        _par_got_noted(32, "[ADR 0002 #32:", tc, vc);
        if (_par_mapped == 32) { _par_adr32_coul = _par_adr32_coul + 1; }
        return 1;
    }
    if (_par_eq(fp, fl, "potential::coulomb_force") == 1) {
        var tf, vf = coulomb_force(x, y, z);
        _par_got_noted(32, "[ADR 0002 #32:", tf, vf);
        if (_par_mapped == 32) { _par_adr32_force = _par_adr32_force + 1; }
        return 1;
    }
    var w: f64 = _par_in(3);
    if (_par_eq(fp, fl, "potential::morse") == 1) {
        var tm, vm = morse(x, y, z, w);
        _par_got_res(tm, vm);
        return 1;
    }
    return 0;
}

# ── spectroscopy (M4e) ──────────────────────────────────────────────────────────────

# The golden name of a KmSpectralSeries value ("SpectralSeries.Lyman"), "" for a word that is no value.
#must_use
fn _par_series_name(v): i64 {
    if (v == KM_SPECTRAL_SERIES_LYMAN) { return "SpectralSeries.Lyman"; }
    if (v == KM_SPECTRAL_SERIES_BALMER) { return "SpectralSeries.Balmer"; }
    if (v == KM_SPECTRAL_SERIES_PASCHEN) { return "SpectralSeries.Paschen"; }
    if (v == KM_SPECTRAL_SERIES_BRACKETT) { return "SpectralSeries.Brackett"; }
    if (v == KM_SPECTRAL_SERIES_PFUND) { return "SpectralSeries.Pfund"; }
    return "";
}

# The KmSpectralSeries value whose golden name is input token k, an `e:` token; -1 for none.
#must_use
fn _par_in_series(k): i64 {
    var at = k * 8;
    if (k >= _par_in_n || load64(_par_in_k + at) != 101) { return 0 - 1; }
    var p = load64(_par_in_v + at);
    var len = load64(_par_in_l + at);
    var v = 0;
    while (v < KM_SPECTRAL_SERIES_COUNT) {
        if (_par_eq(p, len, _par_series_name(v)) == 1) { return v; }
        v = v + 1;
    }
    return 0 - 1;
}

# The spectroscopy rows' work buffers, allocated once (_par_spec_alloc): the input slice (_PAR_MAX words, the
# isotope_pattern atoms' records too) and the output (2·_PAR_MAX words: fft_spectrum's in-place transform).
var _par_spec_in = 0;
var _par_spec_out = 0;
fn _par_spec_alloc(): i64 {
    if (_par_spec_in == 0) { _par_spec_in = _par_words(_PAR_MAX); }
    if (_par_spec_out == 0) { _par_spec_out = _par_words(2 * _PAR_MAX); }
    if (_par_spec_in == 0 || _par_spec_out == 0) { return 0; }
    return 1;
}

# Appends a Result whose Ok payload is a count of f64 values at buf (`v:n` and the n values), or its Err.
fn _par_got_f64s(t, v, buf) {
    if (is_err_result(t) == 1) { _par_got_err(v); return 0; }
    _par_got_seq(v);
    var j = 0;
    while (j < v) {
        _par_got_f(load64(buf + 8 * j));
        j = j + 1;
    }
    return 0;
}

# `spectroscopy` rows: src/spectroscopy.cyr and the generated src/spectroscopy_data.cyr. Rust's u8 / u32 are `i:` words,
# SpectralSeries an `e:` token; slices are `v:n` + n elements, read into the work buffer (isotope_pattern's atoms as
# 16-byte (z, count) records), and a Vec result is the caller's buffer's count and contents (port plan §6.4).
# fft_spectrum runs with a buffer of n/2 + 1 values up to n = 64 (the heap work table) and of 2n above (the in-place
# transform), so both paths replay the corpus. ADR 0002 #19 (the wavenumber conversions), #21 (the Bohr levels, the
# transition energy, the Rydberg formula and the series) and #22 (the reduced mass): a noted row's port value must be
# the note's; #23 (the isotope abundances and patterns, M4e-4): a noted row's whole result must be the note's tokens;
# #30 (the overflow audit's B2: the Beer–Lambert, rotor and moment-of-inertia monomials, √(k/μ)): as #19's; #36 and
# #37 (B6: the unbounded FFT, find_peaks' exact threshold): a noted row's whole result must be the note's tokens.
fn _par_spectroscopy(fp, fl): i64 {
    if (_par_spec_alloc() != 1) { return 0 - 1; }
    if (_par_eq(fp, fl, "SpectralSeries::n_lower") == 1) {
        var s = _par_in_series(0);
        if (s < 0) { return 0 - 1; }
        _par_got_i(spectral_series_n_lower(s));
        return 1;
    }
    if (_par_eq(fp, fl, "SpectralSeries::wavelength") == 1) {
        var s2 = _par_in_series(0);
        if (s2 < 0) { return 0 - 1; }
        var ts, vs = spectral_series_wavelength(s2, _par_in(1));
        _par_got_noted(21, "[ADR 0002 #21:", ts, vs);
        if (_par_mapped == 21) { _par_adr21_series = _par_adr21_series + 1; }
        return 1;
    }
    if (_par_eq(fp, fl, "spectroscopy::bohr_energy_level") == 1) {
        var tb, vb = bohr_energy_level(_par_in(0), _par_in(1));
        _par_got_noted(21, "[ADR 0002 #21:", tb, vb);
        if (_par_mapped == 21) { _par_adr21_level = _par_adr21_level + 1; }
        return 1;
    }
    if (_par_eq(fp, fl, "spectroscopy::bohr_transition_energy") == 1) {
        var tt, vt = bohr_transition_energy(_par_in(0), _par_in(1), _par_in(2));
        _par_got_noted(21, "[ADR 0002 #21:", tt, vt);
        if (_par_mapped == 21) { _par_adr21_trans = _par_adr21_trans + 1; }
        return 1;
    }
    if (_par_eq(fp, fl, "spectroscopy::rydberg_wavelength") == 1) {
        var tr, vr = rydberg_wavelength(_par_in(0), _par_in(1), _par_in(2));
        _par_got_noted(21, "[ADR 0002 #21:", tr, vr);
        if (_par_mapped == 21) { _par_adr21_ryd = _par_adr21_ryd + 1; }
        return 1;
    }
    if (_par_eq(fp, fl, "spectroscopy::isotope_abundances") == 1) {
        var ap, an = isotope_abundances(_par_in(0));
        _par_got_seq(an);
        var j = 0;
        while (j < 2 * an) {
            _par_got_f(load64(ap + 8 * j));
            j = j + 1;
        }
        _par_map_toks(23, "[ADR 0002 #23:");
        if (_par_mapped == 23) { _par_adr23_abund = _par_adr23_abund + 1; }
        return 1;
    }
    if (_par_eq(fp, fl, "spectroscopy::isotope_pattern") == 1) {
        var na = _par_in(0);
        var k = 0;
        while (k < 2 * na) {
            store64(_par_spec_in + 8 * k, _par_in(1 + k));
            k = k + 1;
        }
        var tp, vp = isotope_pattern(_par_spec_in, na, _par_spec_out, _PAR_MAX);
        if (is_err_result(tp) == 1) {
            _par_got_err(vp);
        } else {
            _par_got_seq(vp);
            k = 0;
            while (k < 2 * vp) {
                _par_got_f(load64(_par_spec_out + 8 * k));
                k = k + 1;
            }
        }
        _par_map_toks(23, "[ADR 0002 #23:");
        if (_par_mapped == 23) { _par_adr23_pattern = _par_adr23_pattern + 1; }
        return 1;
    }
    if (_par_eq(fp, fl, "spectroscopy::fft_spectrum") == 1) {
        var n = _par_in_f64s(0, _par_spec_in);
        var cap = 2 * n;
        if (n <= 64) { cap = n / 2 + 1; }
        var tf, vf = fft_spectrum(_par_spec_in, n, _par_spec_out, cap);
        _par_got_f64s(tf, vf, _par_spec_out);
        _par_map_toks(36, "[ADR 0002 #36:");
        if (_par_mapped == 36) { _par_adr36_fft = _par_adr36_fft + 1; }
        return 1;
    }
    if (_par_eq(fp, fl, "spectroscopy::find_peaks") == 1) {
        var nd = _par_in_f64s(0, _par_spec_in);
        var th: f64 = _par_in(1 + nd);
        var tk, vk = find_peaks(_par_spec_in, nd, th, _par_spec_out, nd);
        if (is_err_result(tk) == 1) { _par_got_err(vk); return 1; }
        _par_got_seq(vk);
        var q = 0;
        while (q < vk) {
            _par_got_i(load64(_par_spec_out + 8 * q));
            q = q + 1;
        }
        _par_map_toks(37, "[ADR 0002 #37:");
        if (_par_mapped == 37) { _par_adr37_peaks = _par_adr37_peaks + 1; }
        return 1;
    }
    var x: f64 = _par_in(0);
    if (_par_eq(fp, fl, "spectroscopy::transmittance") == 1) {
        var r1: f64 = transmittance(x);
        _par_got_f(r1);
        return 1;
    }
    if (_par_eq(fp, fl, "spectroscopy::absorbance_from_transmittance") == 1) {
        var t2, v2 = absorbance_from_transmittance(x);
        _par_got_res(t2, v2);
        return 1;
    }
    if (_par_eq(fp, fl, "spectroscopy::photon_energy_from_frequency") == 1) {
        var r3: f64 = photon_energy_from_frequency(x);
        _par_got_f(r3);
        return 1;
    }
    if (_par_eq(fp, fl, "spectroscopy::photon_energy_from_wavelength") == 1) {
        var t4, v4 = photon_energy_from_wavelength(x);
        _par_got_res(t4, v4);
        return 1;
    }
    if (_par_eq(fp, fl, "spectroscopy::wavelength_from_energy") == 1) {
        var t5, v5 = wavelength_from_energy(x);
        _par_got_res(t5, v5);
        return 1;
    }
    if (_par_eq(fp, fl, "spectroscopy::frequency_from_wavelength") == 1) {
        var t6, v6 = frequency_from_wavelength(x);
        _par_got_res(t6, v6);
        return 1;
    }
    if (_par_eq(fp, fl, "spectroscopy::joules_to_ev") == 1) {
        var r7: f64 = joules_to_ev(x);
        _par_got_f(r7);
        return 1;
    }
    if (_par_eq(fp, fl, "spectroscopy::ev_to_joules") == 1) {
        var r8: f64 = ev_to_joules(x);
        _par_got_f(r8);
        return 1;
    }
    if (_par_eq(fp, fl, "spectroscopy::wavenumber_from_wavelength") == 1) {
        var t9, v9 = wavenumber_from_wavelength(x);
        _par_got_noted(19, "[ADR 0002 #19:", t9, v9);
        return 1;
    }
    if (_par_eq(fp, fl, "spectroscopy::wavelength_from_wavenumber") == 1) {
        var t10, v10 = wavelength_from_wavenumber(x);
        _par_got_noted(19, "[ADR 0002 #19:", t10, v10);
        return 1;
    }
    if (_par_eq(fp, fl, "spectroscopy::rotational_constant") == 1) {
        var t11, v11 = rotational_constant(x);
        _par_got_noted(30, "[ADR 0002 #30:", t11, v11);
        if (_par_mapped == 30) { _par_adr30_rot = _par_adr30_rot + 1; }
        return 1;
    }
    if (_par_eq(fp, fl, "spectroscopy::harmonic_oscillator_energy") == 1) {
        var w12: f64 = _par_in(1);
        var r12: f64 = harmonic_oscillator_energy(_par_in(0), w12);
        _par_got_f(r12);
        return 1;
    }
    if (_par_eq(fp, fl, "spectroscopy::rigid_rotor_energy") == 1) {
        var b13: f64 = _par_in(1);
        var r13: f64 = rigid_rotor_energy(_par_in(0), b13);
        _par_got_noted_f(30, "[ADR 0002 #30:", r13);
        if (_par_mapped == 30) { _par_adr30_rotor = _par_adr30_rotor + 1; }
        return 1;
    }
    var y: f64 = _par_in(1);
    if (_par_eq(fp, fl, "spectroscopy::reduced_mass") == 1) {
        var t14, v14 = reduced_mass(x, y);
        _par_got_noted(22, "[ADR 0002 #22:", t14, v14);
        return 1;
    }
    if (_par_eq(fp, fl, "spectroscopy::vibrational_frequency") == 1) {
        var t15, v15 = vibrational_frequency(x, y);
        _par_got_noted(30, "[ADR 0002 #30:", t15, v15);
        if (_par_mapped == 30) { _par_adr30_vib = _par_adr30_vib + 1; }
        return 1;
    }
    if (_par_eq(fp, fl, "spectroscopy::diatomic_moment_of_inertia") == 1) {
        var r16: f64 = diatomic_moment_of_inertia(x, y);
        _par_got_noted_f(30, "[ADR 0002 #30:", r16);
        if (_par_mapped == 30) { _par_adr30_moment = _par_adr30_moment + 1; }
        return 1;
    }
    var z: f64 = _par_in(2);
    if (_par_eq(fp, fl, "spectroscopy::absorbance") == 1) {
        var r17: f64 = absorbance(x, y, z);
        _par_got_noted_f(30, "[ADR 0002 #30:", r17);
        if (_par_mapped == 30) { _par_adr30_abs = _par_adr30_abs + 1; }
        return 1;
    }
    if (_par_eq(fp, fl, "spectroscopy::concentration_from_absorbance") == 1) {
        var t18, v18 = concentration_from_absorbance(x, y, z);
        _par_got_noted(30, "[ADR 0002 #30:", t18, v18);
        if (_par_mapped == 30) { _par_adr30_conc = _par_adr30_conc + 1; }
        return 1;
    }
    return 0;
}

# ── stoichiometry (M4f) ─────────────────────────────────────────────────────────────

# ADR 0002 #7 (M4f), the integer matrix: a balance_equation row's matrix, Rust's `&[Vec<f64>]` (`v:m`, then each row
# `v:len` and its `f:` entries), converted entry by entry as Rust accepts it — finite, within 10⁻⁹ of round(v) (halves
# away from zero) — to that rounded integer, which must be an i64 (|r| < 2⁶³). Such a row is replayed on the port's
# integer matrix and compared class A (_par_adr7_int, _par_adr7_round of them with a near-integer entry); a row without
# a counterpart (an entry Rust's test refuses, an integer beyond i64, ragged rows) must be noted `[ADR 0002 #7: no
# integer-matrix counterpart` and hold the oracle's Err(InvalidInput), its only result: then it is mapped (accepted
# under ADR 2, counted: _par_adr7_none). The oxidation states: an oracle Ok(n) row is the port's n/1 (every denominator
# 1, compared as Rust's pairs); a row noted `[ADR 0002 #7:` (the oracle's "non-integer average" Err) must be the note's
# whole result, (Z, numerator, denominator) per entry (_par_map_toks, _par_adr7_ox). ADR 0002 #24–#26 (M4f-2): a
# percent_yield or theoretical_yield_moles row noted `[ADR 0002 #24:` must be the note's value bit for bit
# (_par_got_noted), a limiting_reagent row noted `[ADR 0002 #25:` the note's index (_par_map_exact), a
# percent_composition row noted `[ADR 0002 #24:` or an empirical_formula row noted `[ADR 0002 #26:` the note's whole
# result (_par_map_toks); each is mapped and counted per function.
var _par_adr7_ox = 0;
var _par_adr24_yield = 0;                   # ADR 0002 #24 (M4f-2) per function: percent_yield,
var _par_adr24_moles = 0;                   # theoretical_yield_moles, percent_composition; #25 limiting_reagent,
var _par_adr24_comp = 0;                    # #26 empirical_formula
var _par_adr25 = 0;
var _par_adr26 = 0;
var _par_adr7_int = 0;
var _par_adr7_round = 0;
var _par_adr7_none = 0;
var _par_st_round = 0;                      # set by _par_in_matrix: an entry was a near-integer f64
# The overflow audit's B7 (ADR 0002 #39): balance_equation rows where Rust's checked i64 elimination overflows (its
# ComputationError) and the port's unbounded integers give the noted whole result (_par_map_toks), mapped and counted.
var _par_adr39 = 0;

# The matrix at input token 0 as integers, row-major, into buf (_PAR_MAX words): (1, m, n) when every entry has an
# integer counterpart (ADR 0002 #7), (0, 0, 0) when one has none or the rows are ragged, (-1, 0, 0) when the tokens
# are malformed. _par_st_round is 1 when an entry was rounded (Rust's 10⁻⁹ tolerance).
fn _par_in_matrix(buf): (i64, i64, i64) {
    _par_st_round = 0;
    if (_par_in_n < 1 || load64(_par_in_k) != 118) { return (0 - 1, 0, 0); }
    var m = _par_in(0);
    var tol: f64 = 0x3E112E0BE826D695;     # 1e-9, Rust's INTEGER_TOLERANCE
    var lim: f64 = 9223372036854775808.0;  # 2⁶³
    var n = 0;
    var t = 1;
    var w = 0;
    var none = 0;
    var i = 0;
    while (i < m) {
        if (t >= _par_in_n || load64(_par_in_k + 8 * t) != 118) { return (0 - 1, 0, 0); }
        var len = _par_in(t);
        if (i == 0) { n = len; }
        if (len != n) { none = 1; }
        var j = 0;
        while (j < len) {
            var at = t + 1 + j;
            if (at >= _par_in_n || load64(_par_in_k + 8 * at) != 102) { return (0 - 1, 0, 0); }
            var v: f64 = _par_in(at);
            if (_km_is_finite(v) != 1) {
                none = 1;
            } else {
                var r: f64 = _km_round_half_away(v);
                var d: f64 = v - r;
                var ad: f64 = f64_abs(d);
                var ar: f64 = f64_abs(r);
                if (ad > tol || ar >= lim) {
                    none = 1;
                } elif (none == 0 && w < _PAR_MAX) {
                    if (ad != 0.0) { _par_st_round = 1; }
                    store64(buf + 8 * w, f64_to(r));
                    w = w + 1;
                }
            }
            j = j + 1;
        }
        t = t + 1 + len;
        i = i + 1;
    }
    if (t != _par_in_n) { return (0 - 1, 0, 0); }
    if (none == 1) { return (0, 0, 0); }
    if (w != m * n) { return (0 - 1, 0, 0); }
    return (1, m, n);
}

# `stoichiometry` rows: src/stoichiometry.cyr. balance_equation's matrix is replayed as integers (ADR 0002 #7, above);
# the species, element and molecule lists are `v:n` and n pairs, read into 16-byte (Z, count) or (Z, f64 bits) records;
# the two limiting-reagent slices are `v:n` and n floats each; a Vec result is the caller's buffer's count and records
# (port plan §6.4): the coefficients `v:n i:…`, the oxidation states `v:n i:z i:os …` (Rust's pairs, every
# denominator 1) or, on a noted row, the port's triples `i:z i:p i:q`.
fn _par_stoichiometry(fp, fl): i64 {
    if (_par_spec_alloc() != 1) { return 0 - 1; }
    if (_par_eq(fp, fl, "stoichiometry::balance_equation") == 1) {
        var st, bm, bn = _par_in_matrix(_par_spec_in);
        if (st < 0) { return 0 - 1; }
        var noted = _par_note_has("[ADR 0002 #7: no integer-matrix counterpart");
        if (st == 0) {
            # No integer counterpart: the oracle's Err(InvalidInput) must be the row's output, and the note must say so.
            var inv = 0;
            if (_par_want_n == 1 && load64(_par_want_k) == 69) {
                inv = _par_eq(load64(_par_want_v), load64(_par_want_l), "InvalidInput");
            }
            if (noted != 1 || inv != 1) { _par_got_err(0 - 1); return 1; }
            _par_got_err(KM_ERR_INVALID_INPUT);
            _par_mapped = 7;
            _par_force_map = 1;
            _par_hist_on = 0;
            _par_adr7_none = _par_adr7_none + 1;
            return 1;
        }
        if (noted == 1) { _par_got_err(0 - 1); return 1; }
        _par_adr7_int = _par_adr7_int + 1;
        _par_adr7_round = _par_adr7_round + _par_st_round;
        var tb, vb = balance_equation(_par_spec_in, bm, bn, _par_spec_out, bn);
        if (is_err_result(tb) == 1) {
            _par_got_err(vb);
        } else {
            _par_got_seq(vb);
            var kb = 0;
            while (kb < vb) {
                _par_got_i(load64(_par_spec_out + 8 * kb));
                kb = kb + 1;
            }
        }
        _par_map_toks(39, "[ADR 0002 #39:");
        if (_par_mapped == 39) { _par_adr39 = _par_adr39 + 1; }
        return 1;
    }
    if (_par_eq(fp, fl, "stoichiometry::assign_oxidation_states") == 1) {
        var na = _par_in(0);
        if (_par_in_n != 2 + 2 * na) { return 0 - 1; }
        var k = 0;
        while (k < 2 * na) {
            store64(_par_spec_in + 8 * k, _par_in(1 + k));
            k = k + 1;
        }
        var to, vo = assign_oxidation_states(_par_spec_in, na, _par_in(1 + 2 * na), _par_spec_out, na);
        if (is_err_result(to) == 1) {
            _par_got_err(vo);
        } else {
            var whole = 1;                  # every denominator 1: Rust's pairs
            k = 0;
            while (k < vo) {
                if (load64(_par_spec_out + 24 * k + 16) != 1) { whole = 0; }
                k = k + 1;
            }
            if (_par_note_has("[ADR 0002 #7:") == 1) { whole = 0; }
            _par_got_seq(vo);
            k = 0;
            while (k < vo) {
                _par_got_i(load64(_par_spec_out + 24 * k));
                _par_got_i(load64(_par_spec_out + 24 * k + 8));
                if (whole != 1) { _par_got_i(load64(_par_spec_out + 24 * k + 16)); }
                k = k + 1;
            }
        }
        _par_map_toks(7, "[ADR 0002 #7:");
        if (_par_mapped == 7) { _par_adr7_ox = _par_adr7_ox + 1; }
        return 1;
    }
    if (_par_eq(fp, fl, "stoichiometry::limiting_reagent") == 1) {
        var n1 = _par_in_f64s(0, _par_spec_in);
        var c1 = _par_spec_in + 8 * (n1 + 1);
        var n2 = _par_in_f64s(1 + n1, c1);
        var tl, vl = limiting_reagent(_par_spec_in, n1, c1, n2);
        if (_par_note_has("[ADR 0002 #25:") == 1) {
            if (is_err_result(tl) == 1) { _par_got_err(0 - 1); return 1; }    # a noted row is an Ok row
            _par_map_exact(25, vl, 105);
            if (_par_mapped == 25) { _par_adr25 = _par_adr25 + 1; }
            return 1;
        }
        if (is_err_result(tl) == 1) { _par_got_err(vl); } else { _par_got_i(vl); }
        return 1;
    }
    if (_par_eq(fp, fl, "stoichiometry::theoretical_yield_moles") == 1) {
        var n3 = _par_in_f64s(0, _par_spec_in);
        var c3 = _par_spec_in + 8 * (n3 + 1);
        var n4 = _par_in_f64s(1 + n3, c3);
        var p3: f64 = _par_in(2 + n3 + n4);
        var ty, vy = theoretical_yield_moles(_par_spec_in, n3, c3, n4, p3);
        _par_got_noted(24, "[ADR 0002 #24:", ty, vy);
        if (_par_mapped == 24) { _par_adr24_moles = _par_adr24_moles + 1; }
        return 1;
    }
    if (_par_eq(fp, fl, "stoichiometry::percent_yield") == 1) {
        var ya: f64 = _par_in(0);
        var yt: f64 = _par_in(1);
        var tp, vp = percent_yield(ya, yt);
        _par_got_noted(24, "[ADR 0002 #24:", tp, vp);
        if (_par_mapped == 24) { _par_adr24_yield = _par_adr24_yield + 1; }
        return 1;
    }
    if (_par_eq(fp, fl, "stoichiometry::percent_composition") == 1) {
        if (_par_in_n < 1 || _par_in_n != 1 + 2 * _par_in(0)) { return 0 - 1; }
        var mol = _par_molecule_in(0);
        var tc, vc = percent_composition(mol, _par_spec_out, _PAR_MAX);
        if (is_err_result(tc) == 1) {
            _par_got_err(vc);
        } else {
            _par_got_seq(vc);
            var kc = 0;
            while (kc < vc) {
                _par_got_i(load64(_par_spec_out + 16 * kc));
                _par_got_f(load64(_par_spec_out + 16 * kc + 8));
                kc = kc + 1;
            }
        }
        _par_map_toks(24, "[ADR 0002 #24:");
        if (_par_mapped == 24) { _par_adr24_comp = _par_adr24_comp + 1; }
        return 1;
    }
    if (_par_eq(fp, fl, "stoichiometry::empirical_formula") == 1) {
        var ne = _par_in(0);
        if (_par_in_n != 1 + 2 * ne) { return 0 - 1; }
        var ke = 0;
        while (ke < 2 * ne) {
            store64(_par_spec_in + 8 * ke, _par_in(1 + ke));
            ke = ke + 1;
        }
        var te, ve = empirical_formula(_par_spec_in, ne, _par_spec_out, ne);
        if (is_err_result(te) == 1) {
            _par_got_err(ve);
        } else {
            _par_got_seq(ve);
            ke = 0;
            while (ke < ve) {
                _par_got_i(load64(_par_spec_out + 16 * ke));
                _par_got_i(load64(_par_spec_out + 16 * ke + 8));
                ke = ke + 1;
            }
        }
        _par_map_toks(26, "[ADR 0002 #26:");
        if (_par_mapped == 26) { _par_adr26 = _par_adr26 + 1; }
        return 1;
    }
    return 0;
}

# Routes a row to its module's dispatcher. 0 (pending) for a module with none yet.
fn _par_dispatch(mp, ml, fp, fl): i64 {
    _par_got_n = 0;
    _par_mapped = 0;
    _par_hist_on = 1;
    if (_par_eq(mp, ml, "constants") == 1) { return _par_constants(fp, fl); }
    if (_par_eq(mp, ml, "electrochemistry") == 1) { return _par_electrochemistry(fp, fl); }
    if (_par_eq(mp, ml, "element") == 1) { return _par_element(fp, fl); }
    if (_par_eq(mp, ml, "math") == 1) { return _par_math(fp, fl); }
    if (_par_eq(mp, ml, "molecule") == 1) { return _par_molecule(fp, fl); }
    if (_par_eq(mp, ml, "reaction") == 1) { return _par_reaction(fp, fl); }
    if (_par_eq(mp, ml, "thermo") == 1) { return _par_thermo(fp, fl); }
    if (_par_eq(mp, ml, "thermochem") == 1) { return _par_thermochem(fp, fl); }
    if (_par_eq(mp, ml, "phase") == 1) { return _par_phase(fp, fl); }
    if (_par_eq(mp, ml, "gas") == 1) { return _par_gas(fp, fl); }
    if (_par_eq(mp, ml, "solution") == 1) { return _par_solution(fp, fl); }
    if (_par_eq(mp, ml, "kinetics") == 1) { return _par_kinetics(fp, fl); }
    if (_par_eq(mp, ml, "organic") == 1) { return _par_organic(fp, fl); }
    if (_par_eq(mp, ml, "inorganic") == 1) { return _par_inorganic(fp, fl); }
    if (_par_eq(mp, ml, "nuclear") == 1) { return _par_nuclear(fp, fl); }
    if (_par_eq(mp, ml, "potential") == 1) { return _par_potential(fp, fl); }
    if (_par_eq(mp, ml, "spectroscopy") == 1) { return _par_spectroscopy(fp, fl); }
    if (_par_eq(mp, ml, "stoichiometry") == 1) { return _par_stoichiometry(fp, fl); }
    return 0;
}

# Shadow comparisons, never gated: the same golden rows through another Cyrius candidate, against the row's
# reference (since ADR 0006 the corrected outputs on a corrected row, so a correctly rounded candidate is 0 ulp
# everywhere and a glibc-like one differs where glibc misrounds).
# - (M3c-3, ADR 0006) the stdlib primitives the modules called before they moved to the correctly rounded ones:
#   f64_exp and f64_ln (x87 on x86_64, the fdlibm polyfills on aarch64), ganita_f64_acos and ganita_f64_pow,
#   whose pow(-1, DBL_MAX) is ADR 0004's +inf (the record of why the port no longer calls them);
# - 10.0.powf(y) through _km_cr_pow(10, y), the same correctly rounded value as the _km_cr_exp10 the modules
#   call;
# - (M4d) the stdlib trigonometry the port never calls: f64_sin and f64_cos (the fdlibm polyfills on aarch64,
#   x87 on x86_64) and ganita_f64_atan2, against the corrected oracle, beside M4a's correctly rounded
#   _km_cr_sin, _km_cr_cos and _km_cr_atan2 that the rows are gated on;
# - the stdlib functions the M1 helpers replace, to show where their semantics differ.
fn _par_shadows(mp, ml, fp, fl, cls) {
    if (_par_eq(mp, ml, "math") != 1) { return 0; }
    var x: f64 = _par_in(0);
    if (_par_eq(fp, fl, "f64::exp") == 1) {
        _par_got_n = 0;
        var r: f64 = f64_exp(x);
        _par_got_f(r);
        _par_shadow_record("f64::exp ~ f64_exp", cls);
        return 0;
    }
    if (_par_eq(fp, fl, "f64::ln") == 1) {
        _par_got_n = 0;
        var r: f64 = f64_ln(x);
        _par_got_f(r);
        _par_shadow_record("f64::ln ~ f64_ln", cls);
        return 0;
    }
    if (_par_eq(fp, fl, "f64::acos") == 1) {
        _par_got_n = 0;
        var r: f64 = ganita_f64_acos(x);
        _par_got_f(r);
        _par_shadow_record("f64::acos ~ ganita_f64_acos", cls);
        return 0;
    }
    if (_par_eq(fp, fl, "f64::sin") == 1) {
        _par_got_n = 0;
        var r: f64 = f64_sin(x);
        _par_got_f(r);
        _par_shadow_record("f64::sin ~ f64_sin", cls);
        return 0;
    }
    if (_par_eq(fp, fl, "f64::cos") == 1) {
        _par_got_n = 0;
        var r: f64 = f64_cos(x);
        _par_got_f(r);
        _par_shadow_record("f64::cos ~ f64_cos", cls);
        return 0;
    }
    if (_par_eq(fp, fl, "f64::powf_base10") == 1) {
        _par_got_n = 0;
        var r: f64 = _km_cr_pow(10.0, x);
        _par_got_f(r);
        _par_shadow_record("f64::powf_base10 ~ _km_cr_pow(10, y)", cls);
        return 0;
    }
    if (_par_eq(fp, fl, "f64::round") == 1) {
        _par_got_n = 0;
        var r: f64 = f64_round(x);
        _par_got_f(r);
        _par_shadow_record("f64::round ~ f64_round", cls);
        return 0;
    }
    if (_par_eq(fp, fl, "f64::signum") == 1) {
        _par_got_n = 0;
        var r: f64 = f64_sign(x);
        _par_got_f(r);
        _par_shadow_record("f64::signum ~ f64_sign", cls);
        return 0;
    }
    var y: f64 = _par_in(1);
    if (_par_eq(fp, fl, "f64::powf") == 1) {
        _par_got_n = 0;
        var r: f64 = ganita_f64_pow(x, y);
        _par_got_f(r);
        _par_shadow_record("f64::powf ~ ganita_f64_pow", cls);
        return 0;
    }
    if (_par_eq(fp, fl, "f64::atan2") == 1) {
        _par_got_n = 0;
        var r: f64 = ganita_f64_atan2(x, y);
        _par_got_f(r);
        _par_shadow_record("f64::atan2 ~ ganita_f64_atan2", cls);
        return 0;
    }
    if (_par_eq(fp, fl, "f64::max") == 1) {
        _par_got_n = 0;
        var r: f64 = f64_max(x, y);
        _par_got_f(r);
        _par_shadow_record("f64::max ~ f64_max", cls);
        return 0;
    }
    if (_par_eq(fp, fl, "f64::min") == 1) {
        _par_got_n = 0;
        var r: f64 = f64_min(x, y);
        _par_got_f(r);
        _par_shadow_record("f64::min ~ f64_min", cls);
        return 0;
    }
    return 0;
}

# The class-C bound for a function, in ulps; -1 when none is set yet (the rows would be measured). A bound is set
# BEFORE the function's first gated comparison and never raised to make a row pass.
#
# ADR 0006 (M3c-3): every class-C function the port has ported is on correctly rounded primitives (src/mathx.cyr:
# _km_cr_exp, _km_cr_expm1, _km_cr_exp10, _km_cr_ln, _km_cr_log10, _km_cr_pow, and since M4d _km_cr_sin, _km_cr_cos,
# _km_cr_atan2 and _km_cr_acos), in Rust's operation order, and each row's reference is the corrected oracle: the
# oracle's operations with every primitive result correctly rounded (tests/golden/<module>.cr.tsv where that differs
# from the oracle's outputs). Both sides then evaluate the same correctly rounded values in the same order, so the bound
# is 0 and any difference is a port defect (ADR 0006 item 3). The sensitivity rule (K = 2·S·c + 2) that set the
# M0–M3a bounds retires for them (docs/development/port-parity.md §5–§8 keep its history; §10 the result).
#
# Until M4d, f64::sin and f64::atan2 (f64_sin, ganita_f64_atan2) and the f64::cos rows with a finite |x| > 8 (past
# ADR 0005's _km_cos) kept the stdlib's bound of 2 ulp; M4a's correctly rounded trigonometry removed the last
# exception, so no bound here is above 0.
#must_use
fn _par_c_bound(fp, fl): i64 {
    # The math primitives (M0, M1; ADR 0006 since M3c-3).
    if (_par_eq(fp, fl, "f64::exp") == 1) { return 0; }
    if (_par_eq(fp, fl, "f64::exp_m1") == 1) { return 0; }
    if (_par_eq(fp, fl, "f64::log10") == 1) { return 0; }
    if (_par_eq(fp, fl, "f64::ln") == 1) { return 0; }
    if (_par_eq(fp, fl, "f64::powf") == 1) { return 0; }
    if (_par_eq(fp, fl, "f64::powf_base10") == 1) { return 0; }
    if (_par_eq(fp, fl, "f64::powf_base2") == 1) { return 0; }
    if (_par_eq(fp, fl, "f64::acos") == 1) { return 0; }                              # M4d: _km_cr_acos
    if (_par_eq(fp, fl, "f64::cos") == 1) { return 0; }                               # M4d: _km_cr_cos, every x
    if (_par_eq(fp, fl, "f64::sin") == 1) { return 0; }                               # M4d: _km_cr_sin
    if (_par_eq(fp, fl, "f64::atan2") == 1) { return 0; }                             # M4d: _km_cr_atan2
    # kimiya's own class-C functions (M2a reaction, phase, gas; M2b thermochem; M3a solution, electrochemistry; M3b
    # kinetics; M4c nuclear; M4d potential), each on correctly rounded primitives only (named per line; cbrt and sqrt
    # are correctly rounded too).
    # The kinetics six were measured, unbounded, from M3b until M3c-3 (port-parity.md §8).
    if (_par_eq(fp, fl, "reaction::equilibrium_constant") == 1) { return 0; }          # ADR 0006: exp
    if (_par_eq(fp, fl, "phase::clausius_clapeyron") == 1) { return 0; }               # ADR 0006: exp
    if (_par_eq(fp, fl, "phase::antoine_pressure_mmhg") == 1) { return 0; }            # ADR 0006: exp10
    if (_par_eq(fp, fl, "phase::antoine_pressure_pa") == 1) { return 0; }              # ADR 0006: exp10
    if (_par_eq(fp, fl, "gas::peng_robinson_z") == 1) { return 0; }                    # ADR 0006: acos, cos
    if (_par_eq(fp, fl, "gas::peng_robinson_z_roots") == 1) { return 0; }              # ADR 0006: acos, cos
    if (_par_eq(fp, fl, "gas::fugacity_coefficient_pr") == 1) { return 0; }            # ADR 0006: acos, cos, ln, exp
    if (_par_eq(fp, fl, "gas::fugacity_pr") == 1) { return 0; }                        # ADR 0006: acos, cos, ln, exp
    if (_par_eq(fp, fl, "gas::redlich_kwong_pressure") == 1) { return 0; }             # ADR 0006: pow(x, 2.5)
    if (_par_eq(fp, fl, "thermochem::vant_hoff_k") == 1) { return 0; }                 # ADR 0006: exp
    if (_par_eq(fp, fl, "solution::ph_from_h_concentration") == 1) { return 0; }       # ADR 0006: log10
    if (_par_eq(fp, fl, "solution::poh_from_oh_concentration") == 1) { return 0; }     # ADR 0006: log10
    if (_par_eq(fp, fl, "solution::henderson_hasselbalch") == 1) { return 0; }         # ADR 0006: log10
    if (_par_eq(fp, fl, "solution::h_concentration_from_ph") == 1) { return 0; }       # ADR 0006: exp10
    if (_par_eq(fp, fl, "solution::weak_acid_ph") == 1) { return 0; }                  # ADR 0006: log10
    if (_par_eq(fp, fl, "solution::weak_base_ph") == 1) { return 0; }                  # ADR 0006: log10
    if (_par_eq(fp, fl, "solution::debye_huckel_limiting") == 1) { return 0; }         # ADR 0006: exp10
    if (_par_eq(fp, fl, "solution::debye_huckel_extended") == 1) { return 0; }         # ADR 0006: exp10
    if (_par_eq(fp, fl, "solution::davies_activity") == 1) { return 0; }               # ADR 0006: exp10
    if (_par_eq(fp, fl, "electrochemistry::nernst_potential") == 1) { return 0; }      # ADR 0006: ln
    if (_par_eq(fp, fl, "electrochemistry::nernst_potential_25c") == 1) { return 0; }  # ADR 0006: ln
    if (_par_eq(fp, fl, "kinetics::arrhenius_rate") == 1) { return 0; }                # ADR 0006: exp
    if (_par_eq(fp, fl, "kinetics::first_order_concentration") == 1) { return 0; }     # ADR 0006: exp
    if (_par_eq(fp, fl, "kinetics::nth_order_half_life") == 1) { return 0; }           # ADR 0006: expm1, pow
    if (_par_eq(fp, fl, "kinetics::collision_theory_rate") == 1) { return 0; }         # ADR 0006: exp
    if (_par_eq(fp, fl, "kinetics::eyring_rate") == 1) { return 0; }                   # ADR 0006: exp
    if (_par_eq(fp, fl, "kinetics::eyring_rate_from_activation") == 1) { return 0; }   # ADR 0006: exp ×2
    if (_par_eq(fp, fl, "nuclear::atoms_remaining") == 1) { return 0; }                # ADR 0006: exp (M4c)
    if (_par_eq(fp, fl, "nuclear::atoms_after_half_lives") == 1) { return 0; }         # ADR 0006: pow(2, ·)
    if (_par_eq(fp, fl, "nuclear::time_for_fraction") == 1) { return 0; }             # ADR 0006: ln
    if (_par_eq(fp, fl, "nuclear::decay_chain_two_step") == 1) { return 0; }          # ADR 0006: exp ×2, expm1 ×1–2
    if (_par_eq(fp, fl, "potential::lj_equilibrium_distance") == 1) { return 0; }     # M4d: exp2 (ADR 0002 #16)
    if (_par_eq(fp, fl, "potential::morse") == 1) { return 0; }                       # M4d: exp
    if (_par_eq(fp, fl, "potential::bond_angle") == 1) { return 0; }                  # M4d: atan2
    if (_par_eq(fp, fl, "potential::dihedral_angle") == 1) { return 0; }              # M4d: atan2
    if (_par_eq(fp, fl, "spectroscopy::transmittance") == 1) { return 0; }            # M4e: exp10
    if (_par_eq(fp, fl, "spectroscopy::absorbance_from_transmittance") == 1) { return 0; }   # M4e: log10
    if (_par_eq(fp, fl, "spectroscopy::fft_spectrum") == 1) { return 0; }             # M4e: sincos (the twiddles)
    return 0 - 1;
}

# The ADR accepting a divergent row (function and raw input field), or 0. Each entry names
# its ADR; an accepted row is reported on every run and doesn't fail its module. The ADR 0002
# divergences (port plan §2.3) arrive with their modules' golden rows: #4 (Antoine) in M2a.
# ADR 0004's row, f64::powf(-1, DBL_MAX) (ganita's pow gives +inf for 1), had an entry here until M3c-3:
# the row now goes through _km_cr_pow, which gives 1, and is a plain ok. The `f64::powf ~ ganita_f64_pow`
# shadow line keeps the record of ganita's defect (ADR 0004 stays as its record).
#must_use
fn _par_accepted(fp, fl, ip, il): i64 {
    # ADR 0002 #4: an Antoine row the dispatcher mapped (oracle NaN or T out of range ↔ port Err).
    if (_par_mapped == 2) { return 2; }
    # ADR 0002 #12: a CFSE row where the port returns the exact (3·eg − 2·t2g)/5 the oracle's value misses.
    if (_par_mapped == 12) { return 2; }
    # ADR 0002 #3: a SEMF row where the oracle's NaN (z > a or a = 0) is the port's Err(InvalidInput).
    if (_par_mapped == 3) { return 2; }
    # ADR 0002 #13 … #22: a row whose note names the port's exact value, which the port returned; #23 its whole result;
    # #24 … #26 (M4f-2) stoichiometry's exact value, index or whole result; #27, #28 (the overflow audit's B1) thermo's,
    # phase's and kinetics' rounded-once or unbounded-exponent value; #29, #30 (B2) solution's, electrochemistry's and
    # spectroscopy's; #31, #32 (B3) gas's, potential's, inorganic's and nuclear's; #33, #34 (B4) the sums' and the
    # Shomate polynomials'; #35 (B5) the exp / exp10 arguments'; #36 … #38 (B6) the FFT's, find_peaks' and the flame's;
    # #39 (B7) balance_equation's whole result on unbounded integers.
    if (_par_mapped >= 13 && _par_mapped <= 39) { return 2; }
    # ADR 0002 #7 (M4f): an oxidation-state row whose note names the port's exact rational states, or a balancing row
    # whose f64 matrix has no integer counterpart (the oracle's Err(InvalidInput)).
    if (_par_mapped == 7) { return 2; }
    return 0;
}

# 1 for an ADR whose accepted rows are counted but not printed row by row: ADR 0002 #4's Antoine mapping, #13 … #22's
# exact-value rows (M4c … M4e-3; about 17,000 rows between them), #23's isotope rows (M4e-4), #7's oxidation-state
# and balancing rows (M4f), #24 … #26's stoichiometry rows (M4f-2), #27 / #28's (the overflow audit's B1), #29 /
# #30's (B2), #31 / #32's (B3), #33 / #34's (B4), #35's (B5), #36 … #38's (B6) and #39's (B7), each
# summarised by _par_module_done with its count; the validate.py proofs check every one of them. ADR 0002 #12's CFSE
# rows (13) and #3's SEMF rows (23) are printed by name.
#must_use
fn _par_accepted_quiet(adr): i64 {
    if (adr == 2 && _par_mapped == 2) { return 1; }
    if (adr == 2 && _par_mapped >= 13 && _par_mapped <= 39) { return 1; }
    if (adr == 2 && _par_mapped == 7) { return 1; }
    return 0;
}

# 1 when a printed accepted row also gets its got / want bit pair: ADR 0002 #12's CFSE rows (the note gives the exact
# value in decimal). #3's port value is an Err, and #13 / #15's notes name both values, the oracle's and the port's.
#must_use
fn _par_accepted_bits(adr): i64 {
    if (adr == 2 && _par_mapped == 12) { return 1; }
    return 0;
}

# After the phase module: the ADR 0002 #27 (per function) and #4 mapping summaries; after thermo, #27's (per function);
# after kinetics, #28's (per function); after solution and electrochemistry, #29's (per function); after thermochem, ADR
# 0002 #1's; after gas, #31's (per function); after organic, #6's; after inorganic, #12's, #15's and #32's
# (born_lande_lattice_energy); after nuclear, #3's, #13's, #14's and #32's (binding_energy_per_nucleon); after
# potential, #16's, #20's and #32's (per function, #17's and #18's regions among them); after spectroscopy, #19's, #21's
# (per function), #22's, #23's (per function) and #30's (per function); after stoichiometry, #7's (the oxidation states,
# the integer matrix) and #24's (per function), #25's and #26's. The overflow audit's B4: #33's after thermo, reaction,
# thermochem, solution, kinetics, inorganic and nuclear (per function), #34's after thermochem (per function); B5: #35's
# after reaction and solution (per function); B6: #36's and #37's after spectroscopy, #38's after thermochem; B7: #39's
# after stoichiometry.
fn _par_module_done(mp, ml) {
    if (_par_eq(mp, ml, "reaction") == 1) {
        _par_b4_line(33, _par_adr33_gibbs, "gibbs_free_energy");
        _par_puts("  ADR 0002 #35 the exp argument unbounded: ");
        fmt_int(_par_adr35_keq);
        _par_puts(" equilibrium_constant rows (");
        fmt_int(_par_adr35_kerr);
        _par_puts(" of them the port's ComputationError where Rust's K is finite, ");
        fmt_int(_par_adr35_kok);
        _par_puts(" the port's K where Rust's overflows) where the port's result differs from Rust's");
        println(" (accepted, ADR 2, counted, not listed)");
        return 0;
    }
    if (_par_eq(mp, ml, "gas") == 1) {
        print("  ADR 0002 #31 rounded once, unbounded exponent: ", 49);
        var n31 = _par_adr31_igp + _par_adr31_igv + _par_adr31_dens + _par_adr31_vdw + _par_adr31_pr;
        fmt_int(n31 + _par_adr31_rk);
        print(" rows (ideal_gas_pressure ", 26);
        fmt_int(_par_adr31_igp);
        print(", ideal_gas_volume ", 19);
        fmt_int(_par_adr31_igv);
        print(", gas_density ", 14);
        fmt_int(_par_adr31_dens);
        print(", van_der_waals_pressure ", 25);
        fmt_int(_par_adr31_vdw);
        print(", peng_robinson_pressure ", 25);
        fmt_int(_par_adr31_pr);
        print(", redlich_kwong_pressure ", 25);
        fmt_int(_par_adr31_rk);
        print("; ", 2);
        fmt_int(_par_adr31_err);
        print(" of them the port's Err where Rust's rounded co-volume accepts) where the port's rounded-once", 93);
        println(" or unbounded-exponent result differs from Rust's (accepted, ADR 2, counted, not listed)");
        return 0;
    }
    if (_par_eq(mp, ml, "solution") == 1) {
        print("  ADR 0002 #29 rounded once: ", 29);
        fmt_int(_par_adr29_dil + _par_adr29_cond);
        print(" rows (dilution ", 16);
        fmt_int(_par_adr29_dil);
        print(", solution_conductivity ", 24);
        fmt_int(_par_adr29_cond);
        print(") where the port's correctly rounded value differs from Rust's", 62);
        println(" (accepted, ADR 2, counted, not listed)");
        _par_puts("  ADR 0002 #33 unbounded exponent: ");
        fmt_int(_par_adr33_ionic + _par_adr33_kohl + _par_adr33_lim);
        _par_puts(" rows (ionic_strength ");
        fmt_int(_par_adr33_ionic);
        _par_puts(", kohlrausch_molar_conductivity ");
        fmt_int(_par_adr33_kohl);
        _par_puts(", limiting_molar_conductivity ");
        fmt_int(_par_adr33_lim);
        _par_puts(") where an intermediate of Rust's chain leaves the normal range and the port's result is the");
        println(" noted one (accepted, ADR 2, counted, not listed)");
        _par_puts("  ADR 0002 #35 the 10^x argument unbounded: ");
        fmt_int(_par_adr35_lim + _par_adr35_ext + _par_adr35_dav);
        _par_puts(" rows (debye_huckel_limiting ");
        fmt_int(_par_adr35_lim);
        _par_puts(", debye_huckel_extended ");
        fmt_int(_par_adr35_ext);
        _par_puts(", davies_activity ");
        fmt_int(_par_adr35_dav);
        _par_puts(") where the port's γ differs from Rust's (accepted, ADR 2, counted, not listed)");
        println("");
        return 0;
    }
    if (_par_eq(mp, ml, "electrochemistry") == 1) {
        print("  ADR 0002 #29 Faraday rounded once, Nernst unbounded: ", 55);
        fmt_int(_par_adr29_fmass + _par_adr29_fcharge + _par_adr29_fratio + _par_adr29_nernst);
        print(" rows (faraday_mass_deposited ", 30);
        fmt_int(_par_adr29_fmass);
        print(", faraday_charge_required ", 26);
        fmt_int(_par_adr29_fcharge);
        print(", faraday_mass_ratio ", 21);
        fmt_int(_par_adr29_fratio);
        print(", nernst_potential ", 19);
        fmt_int(_par_adr29_nernst);
        print(") where the port's rounded-once or unbounded-exponent value differs from Rust's", 79);
        println(" (accepted, ADR 2, counted, not listed)");
        return 0;
    }
    if (_par_eq(mp, ml, "thermo") == 1) {
        print("  ADR 0002 #27 rounded once: ", 29);
