include "src/electrochemistry.cyr"
include "src/kinetics.cyr"

alloc_init();

include "tests/parity_core.cyr"

# ── dispatch ────────────────────────────────────────────────────────────────────────
# Each module's dispatcher fills the got list for one row. It returns 1 when it handled
# the function, 0 when the function is pending (not ported), or -1 when the inputs are
# unusable (a defect, counted as a failure). Add a function the moment it's ported.

# `const` rows (input `s:<module>::<NAME>`). The physical constants, thermo::WATER_SPECIFIC_HEAT and
# the solution constants (M3a) are src/constants.cyr's KM_ consts; the module data constants are
# generated with their module's data (M2a: src/phase_data.cyr, src/gas_data.cyr; M4 later) and
# are pending until then. Any other name is a defect.
fn _par_constants(fp, fl): i64 {
    if (_par_eq(fp, fl, "const") != 1 || _par_in_n != 1) { return 0 - 1; }
    var np = load64(_par_in_v);
    var nl = load64(_par_in_l);
    var x: f64 = 0.0;
    if (_par_eq(np, nl, "electrochemistry::FARADAY") == 1) { x = KM_FARADAY; }
    elif (_par_eq(np, nl, "electrochemistry::ELEMENTARY_CHARGE") == 1) { x = KM_ELEMENTARY_CHARGE; }
    elif (_par_eq(np, nl, "element::AVOGADRO") == 1) { x = KM_AVOGADRO; }
    elif (_par_eq(np, nl, "element::GAS_CONSTANT") == 1) { x = KM_GAS_CONSTANT; }
    elif (_par_eq(np, nl, "kinetics::BOLTZMANN") == 1) { x = KM_BOLTZMANN; }
    elif (_par_eq(np, nl, "nuclear::AMU_MEV") == 1) { x = KM_AMU_MEV; }
    elif (_par_eq(np, nl, "nuclear::PROTON_MASS_U") == 1) { x = KM_PROTON_MASS_U; }
    elif (_par_eq(np, nl, "nuclear::NEUTRON_MASS_U") == 1) { x = KM_NEUTRON_MASS_U; }
    elif (_par_eq(np, nl, "nuclear::HYDROGEN_ATOM_MASS_U") == 1) { x = KM_HYDROGEN_ATOM_MASS_U; }
    elif (_par_eq(np, nl, "potential::COULOMB_CONSTANT") == 1) { x = KM_COULOMB_CONSTANT; }
    elif (_par_eq(np, nl, "spectroscopy::PLANCK") == 1) { x = KM_PLANCK; }
    elif (_par_eq(np, nl, "spectroscopy::SPEED_OF_LIGHT") == 1) { x = KM_SPEED_OF_LIGHT; }
    elif (_par_eq(np, nl, "spectroscopy::RYDBERG") == 1) { x = KM_RYDBERG; }
    elif (_par_eq(np, nl, "spectroscopy::RYDBERG_EV") == 1) { x = KM_RYDBERG_EV; }
    elif (_par_eq(np, nl, "thermo::WATER_SPECIFIC_HEAT") == 1) { x = KM_WATER_SPECIFIC_HEAT; }
    elif (_par_eq(np, nl, "solution::KW_WATER_25C") == 1) { x = KM_KW_WATER_25C; }
    elif (_par_eq(np, nl, "solution::DH_A_WATER_25C") == 1) { x = KM_DH_A_WATER_25C; }
    elif (_par_eq(np, nl, "solution::DH_B_WATER_25C") == 1) { x = KM_DH_B_WATER_25C; }
    elif (_par_eq(np, nl, "solution::LAMBDA_H_PLUS") == 1) { x = KM_LAMBDA_H_PLUS; }
    elif (_par_eq(np, nl, "solution::LAMBDA_OH_MINUS") == 1) { x = KM_LAMBDA_OH_MINUS; }
    elif (_par_eq(np, nl, "solution::LAMBDA_NA_PLUS") == 1) { x = KM_LAMBDA_NA_PLUS; }
    elif (_par_eq(np, nl, "solution::LAMBDA_K_PLUS") == 1) { x = KM_LAMBDA_K_PLUS; }
    elif (_par_eq(np, nl, "solution::LAMBDA_CL_MINUS") == 1) { x = KM_LAMBDA_CL_MINUS; }
    elif (_par_eq(np, nl, "solution::LAMBDA_NO3_MINUS") == 1) { x = KM_LAMBDA_NO3_MINUS; }
    elif (_par_eq(np, nl, "solution::LAMBDA_SO4_2MINUS") == 1) { x = KM_LAMBDA_SO4_2MINUS; }
    elif (_par_eq(np, nl, "gas::STP_TEMPERATURE") == 1) { x = KM_STP_TEMPERATURE; }
    elif (_par_eq(np, nl, "gas::STP_PRESSURE") == 1) { x = KM_STP_PRESSURE; }
    elif (_par_eq(np, nl, "phase::KB_WATER") == 1) { x = KM_KB_WATER; }
    elif (_par_eq(np, nl, "phase::KB_BENZENE") == 1) { x = KM_KB_BENZENE; }
    elif (_par_eq(np, nl, "phase::KB_ETHANOL") == 1) { x = KM_KB_ETHANOL; }
    elif (_par_eq(np, nl, "phase::KB_CHLOROFORM") == 1) { x = KM_KB_CHLOROFORM; }
    elif (_par_eq(np, nl, "phase::KF_WATER") == 1) { x = KM_KF_WATER; }
    elif (_par_eq(np, nl, "phase::KF_BENZENE") == 1) { x = KM_KF_BENZENE; }
    elif (_par_eq(np, nl, "phase::KF_CYCLOHEXANE") == 1) { x = KM_KF_CYCLOHEXANE; }
    elif (_par_eq(np, nl, "phase::KF_CAMPHOR") == 1) { x = KM_KF_CAMPHOR; }
    else { return _par_constant_pending(np, nl); }
    _par_got_f(x);
    return 1;
}

# The module data constants of later milestones: 0 (pending) for each, -1 for a name that is no kimiya
# constant.
#must_use
fn _par_constant_pending(np, nl): i64 {
    # M4: inorganic
    if (_par_eq(np, nl, "inorganic::MADELUNG_NACL") == 1) { return 0; }
    if (_par_eq(np, nl, "inorganic::MADELUNG_CSCL") == 1) { return 0; }
    if (_par_eq(np, nl, "inorganic::MADELUNG_ZNS") == 1) { return 0; }
    if (_par_eq(np, nl, "inorganic::MADELUNG_FLUORITE") == 1) { return 0; }
    if (_par_eq(np, nl, "inorganic::MADELUNG_RUTILE") == 1) { return 0; }
    if (_par_eq(np, nl, "inorganic::BORN_EXP_HE") == 1) { return 0; }
    if (_par_eq(np, nl, "inorganic::BORN_EXP_NE") == 1) { return 0; }
    if (_par_eq(np, nl, "inorganic::BORN_EXP_AR") == 1) { return 0; }
    if (_par_eq(np, nl, "inorganic::BORN_EXP_KR") == 1) { return 0; }
    if (_par_eq(np, nl, "inorganic::BORN_EXP_XE") == 1) { return 0; }
    return 0 - 1;
}

# `f64::` rows: the Cyrius counterpart of each Rust std method (port plan §6.1). Where the
# stdlib's nearest function differs from Rust (probed 2026-11-09; the shadow lines below show
# it), the counterpart is a src/mathx.cyr helper:
# - min / max: f64_min / f64_max return their second operand when it is NaN; Rust ignores a
#   NaN on either side (_km_min / _km_max);
# - round: f64_round ties to even; Rust rounds half away from zero (_km_round_half_away);
# - signum: f64_sign gives 0 for ±0 and NaN; Rust gives ±1 and NaN (_km_signum);
# - powi, total_cmp, is_finite: no stdlib function (_km_powi, _km_total_cmp, _km_is_finite).
# The transcendental primitives are the correctly rounded ones the modules call (ADR 0006, M3c-3):
# exp, exp_m1, ln, log10 and powf are _km_cr_exp / _km_cr_expm1 / _km_cr_ln / _km_cr_log10 /
# _km_cr_pow; 10.0.powf(y) is _km_cr_exp10 (the modules' 10^x; a correctly rounded pow(10, y) is the
# same value, a shadow line shows it) and 2.0.powf(y) (glibc's exp2 in the oracle) _km_cr_pow(2, y);
# cos and acos are ADR 0005's _km_cos and _km_acos. _km_cos is correctly rounded for |x| ≤ 8 and is
# f64_cos beyond, so the cos rows past 8 keep the stdlib's bound (_par_c_bound), as sin and atan2,
# which have no correctly rounded port primitive yet (M4 brings them, ADR 0006 item 1).
# clamp is dispatched: f64_clamp has Rust's semantics for valid bounds (min ≤ max, no NaN
# bound, which Rust asserts), so it is compared rather than assumed.
fn _par_math(fp, fl): i64 {
    var x: f64 = _par_in(0);
    if (_par_eq(fp, fl, "f64::sqrt") == 1) { var r: f64 = f64_sqrt(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::abs") == 1) { var r: f64 = f64_abs(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::floor") == 1) { var r: f64 = f64_floor(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::trunc") == 1) { var r: f64 = f64_trunc(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::round") == 1) { var r: f64 = _km_round_half_away(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::signum") == 1) { var r: f64 = _km_signum(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::is_finite") == 1) { _par_got_i(_km_is_finite(x)); return 1; }
    if (_par_eq(fp, fl, "f64::cbrt") == 1) { var r: f64 = ganita_f64_cbrt(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::exp") == 1) { var r: f64 = _km_cr_exp(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::exp_m1") == 1) { var r: f64 = _km_cr_expm1(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::ln") == 1) { var r: f64 = _km_cr_ln(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::log10") == 1) { var r: f64 = _km_cr_log10(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::sin") == 1) { var r: f64 = f64_sin(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::cos") == 1) { var r: f64 = _km_cos(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::acos") == 1) { var r: f64 = _km_acos(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::powf_base10") == 1) { var r: f64 = _km_cr_exp10(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::powf_base2") == 1) {
        var r: f64 = _km_cr_pow(2.0, x);
        _par_got_f(r);
        return 1;
    }
    # powi's second input is the i32 exponent (`i:n`), an integer word.
    if (_par_eq(fp, fl, "f64::powi") == 1) { var r: f64 = _km_powi(x, _par_in(1)); _par_got_f(r); return 1; }
    var y: f64 = _par_in(1);
    if (_par_eq(fp, fl, "f64::max") == 1) { var r: f64 = _km_max(x, y); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::min") == 1) { var r: f64 = _km_min(x, y); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::total_cmp") == 1) { _par_got_i(_km_total_cmp(x, y)); return 1; }
    if (_par_eq(fp, fl, "f64::powf") == 1) { var r: f64 = _km_cr_pow(x, y); _par_got_f(r); return 1; }
    # Rust's y.atan2(x) is the golden f64::atan2(y, x): inputs in C order.
    if (_par_eq(fp, fl, "f64::atan2") == 1) { var r: f64 = ganita_f64_atan2(x, y); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::clamp") == 1) {
        var hi: f64 = _par_in(2);
        var r: f64 = f64_clamp(x, y, hi);
        _par_got_f(r);
        return 1;
    }
    return 0;
}

# The golden name of a KmElementCategory value ("ElementCategory.NobleGas").
#must_use
fn _par_category_name(c): i64 {
    if (c == KM_ELEMENT_CATEGORY_ALKALI_METAL) { return "ElementCategory.AlkaliMetal"; }
    if (c == KM_ELEMENT_CATEGORY_ALKALINE_EARTH) { return "ElementCategory.AlkalineEarth"; }
    if (c == KM_ELEMENT_CATEGORY_TRANSITION_METAL) { return "ElementCategory.TransitionMetal"; }
    if (c == KM_ELEMENT_CATEGORY_POST_TRANSITION_METAL) { return "ElementCategory.PostTransitionMetal"; }
    if (c == KM_ELEMENT_CATEGORY_METALLOID) { return "ElementCategory.Metalloid"; }
    if (c == KM_ELEMENT_CATEGORY_NONMETAL) { return "ElementCategory.Nonmetal"; }
    if (c == KM_ELEMENT_CATEGORY_HALOGEN) { return "ElementCategory.Halogen"; }
    if (c == KM_ELEMENT_CATEGORY_NOBLE_GAS) { return "ElementCategory.NobleGas"; }
    if (c == KM_ELEMENT_CATEGORY_LANTHANIDE) { return "ElementCategory.Lanthanide"; }
    if (c == KM_ELEMENT_CATEGORY_ACTINIDE) { return "ElementCategory.Actinide"; }
    return "ElementCategory.?";
}

# Appends an Option<&Element>: `n:` for the 0 handle, else its fields in declaration order.
fn _par_got_element(h) {
    if (h == 0) { _par_got_none(); return 0; }
    _par_got_i(element_atomic_number(h));
    var sym = element_symbol(h);
    _par_got_text(sym, strlen(sym));
    var nm = element_name(h);
    _par_got_text(nm, strlen(nm));
    var m: f64 = element_atomic_mass(h);
    _par_got_f(m);
    var t, v = element_electronegativity(h);
    if (is_some(t) == 1) { _par_got_f(v); } else { _par_got_none(); }
    _par_got_e(_par_category_name(element_category(h)));
    return 0;
}

# Appends an Option<&ElementProperties>: `n:` for the 0 handle, else its fields, the
# oxidation states as `v:n` and n integers.
fn _par_got_properties(p) {
    if (p == 0) { _par_got_none(); return 0; }
    _par_got_i(element_properties_atomic_number(p));
    var ie: f64 = element_properties_ionization_energy_1(p);
    _par_got_f(ie);
    var ea: f64 = element_properties_electron_affinity(p);
    _par_got_f(ea);
    var r: f64 = element_properties_covalent_radius_pm(p);
    _par_got_f(r);
    var n = element_properties_oxidation_state_count(p);
    _par_got_seq(n);
    var k = 0;
    while (k < n) {
        var t, v = element_properties_oxidation_state(p, k);
        if (is_some(t) == 1) { _par_got_i(v); } else { _par_got_none(); }
        k = k + 1;
    }
    return 0;
}

# `element` rows: src/element.cyr. Every row has one input, Z (`i:`) or a symbol (`s:`).
fn _par_element(fp, fl): i64 {
    if (_par_in_n != 1) { return 0 - 1; }
    if (_par_eq(fp, fl, "element::lookup_by_number") == 1) {
        _par_got_element(element_lookup_by_number(_par_in(0)));
        return 1;
    }
    if (_par_eq(fp, fl, "element::lookup_properties") == 1) {
        _par_got_properties(element_lookup_properties(_par_in(0)));
        return 1;
    }
    if (_par_eq(fp, fl, "element::lookup_by_symbol") == 1) {
        var sym = _par_in_cstr(0);
        if (sym == 0) { return 0 - 1; }
        _par_got_element(element_lookup_by_symbol(sym));
        return 1;
    }
    return 0;
}

# The molecule in inputs k .. : `v:n`, then n (Z, count) pairs as `i:` tokens.
fn _par_molecule_in(k): KmMolecule {
    var n = _par_in(k);
    var buf = alloc(n * 16 + 16);
    var j = 0;
    while (j < n) {
        store64(buf + j * 16, _par_in(k + 1 + 2 * j));
        store64(buf + j * 16 + 8, _par_in(k + 2 + 2 * j));
        j = j + 1;
    }
    var m = KmMolecule_new(buf, n);
    return m;
}

# Appends a molecule's atoms: `v:n`, then each atom's Z and count.
fn _par_got_atoms(m: KmMolecule) {
    var n = m.atoms_len();
    _par_got_seq(n);
    var k = 0;
    while (k < n) {
        _par_got_i(m.atom_element_number(k));
        _par_got_i(m.atom_count(k));
        k = k + 1;
    }
}

# `molecule` rows: src/molecule.cyr. The presets have no input; every other row's input is a
# molecule (the receiver, or Molecule::new's pairs).
fn _par_molecule(fp, fl): i64 {
    if (_par_eq(fp, fl, "Molecule::water") == 1) { _par_got_atoms(KmMolecule_water()); return 1; }
    if (_par_eq(fp, fl, "Molecule::carbon_dioxide") == 1) { _par_got_atoms(KmMolecule_carbon_dioxide()); return 1; }
    if (_par_eq(fp, fl, "Molecule::methane") == 1) { _par_got_atoms(KmMolecule_methane()); return 1; }
    if (_par_eq(fp, fl, "Molecule::glucose") == 1) { _par_got_atoms(KmMolecule_glucose()); return 1; }
    if (_par_in_n < 1 || _par_in_n != 1 + 2 * _par_in(0)) { return 0 - 1; }
    var m = _par_molecule_in(0);
    if (_par_eq(fp, fl, "Molecule::new") == 1) { _par_got_atoms(m); return 1; }
    if (_par_eq(fp, fl, "Molecule::molecular_weight") == 1) {
        var t, v = m.molecular_weight();
        if (is_ok(t) == 1) { _par_got_f(v); } else { _par_got_err(v); }
        return 1;
    }
    if (_par_eq(fp, fl, "Molecule::formula") == 1) {
        var t, v = m.formula();
        if (is_ok(t) == 1) { _par_got_text(str_data(v), str_len(v)); } else { _par_got_err(v); }
        return 1;
    }
    if (_par_eq(fp, fl, "Molecule::total_atoms") == 1) { _par_got_i(m.total_atoms()); return 1; }
    return 0;
}

# Appends a Result: the f64 payload of Ok, or `E:Variant` for Err.
fn _par_got_res(t, v) {
    if (is_ok(t) == 1) { _par_got_f(v); } else { _par_got_err(v); }
}

# `reaction` rows: src/reaction.cyr. Every input is an f64.
fn _par_reaction(fp, fl): i64 {
    var x: f64 = _par_in(0);
    if (_par_eq(fp, fl, "reaction::is_spontaneous") == 1) { _par_got_i(is_spontaneous(x)); return 1; }
    var y: f64 = _par_in(1);
    if (_par_eq(fp, fl, "reaction::equilibrium_constant") == 1) {
        var t, v = equilibrium_constant(x, y);
        _par_got_res(t, v);
        return 1;
    }
    var z: f64 = _par_in(2);
    if (_par_eq(fp, fl, "reaction::gibbs_free_energy") == 1) {
        var t, v = gibbs_free_energy(x, y, z);
        _par_got_res(t, v);
        return 1;
    }
    return 0;
}

# The slice at input token k (`v:n`, then n `f:` tokens) as a fresh buffer; its length is
# _par_in(k). 0 for an empty slice (the length is still read from the token).
fn _par_in_slice(k): i64 {
    var n = _par_in(k);
    if (n <= 0) { return 0; }
    var buf = alloc(n * 8);
    _par_in_f64s(k, buf);
    return buf;
}

# `thermo` rows: src/thermo.cyr. hess_law's input is one slice, enthalpy_from_formation's two.
fn _par_thermo(fp, fl): i64 {
    if (_par_eq(fp, fl, "thermo::hess_law") == 1) {
        var r: f64 = hess_law(_par_in_slice(0), _par_in(0));
        _par_got_f(r);
        return 1;
    }
    if (_par_eq(fp, fl, "thermo::enthalpy_from_formation") == 1) {
        var np = _par_in(0);
        var nr = _par_in(np + 1);
        var r: f64 = enthalpy_from_formation(_par_in_slice(0), np, _par_in_slice(np + 1), nr);
        _par_got_f(r);
        return 1;
    }
    var x: f64 = _par_in(0);
    var y: f64 = _par_in(1);
    var z: f64 = _par_in(2);
    if (_par_eq(fp, fl, "thermo::heat_transfer") == 1) {
        var r: f64 = heat_transfer(x, y, z);
        _par_got_f(r);
        return 1;
    }
    if (_par_eq(fp, fl, "thermo::specific_heat_from_calorimetry") == 1) {
        var t, v = specific_heat_from_calorimetry(x, y, z);
        _par_got_res(t, v);
        return 1;
    }
    return 0;
}

# A species list at input token k (`v:n`, then n pairs `s:formula f:coefficient`) as n 16-byte records
# (C-string pointer, f64 bits), the layout src/thermochem.cyr takes; its count is _par_in(k), and the
# list spans 1 + 2n tokens. 0 for an empty list, -1 for a malformed formula token.
fn _par_in_species(k): i64 {
    var n = _par_in(k);
    if (n <= 0) { return 0; }
    var buf = alloc(n * 16);
    var j = 0;
    while (j < n) {
        var at = k + 1 + 2 * j;
        var fo = _par_in_cstr(at);
        if (fo == 0) {
            # "" decodes to an empty C string; only a malformed token gives 0.
            if (load64(_par_in_l + at * 8) == 0) { fo = ""; } else { return 0 - 1; }
        }
        store64(buf + j * 16, fo);
        store64(buf + j * 16 + 8, _par_in(at + 1));
        j = j + 1;
    }
    return buf;
}

# Appends a THERMOCHEM_DATA row's five fields (formula, name, ΔH_f°, ΔG_f°, S°).
fn _par_got_thermochem(h) {
    var fo = thermochem_data_formula(h);
    _par_got_text(fo, strlen(fo));
    var nm = thermochem_data_name(h);
    _par_got_text(nm, strlen(nm));
    var hf: f64 = thermochem_data_delta_hf_kj(h);
    var gf: f64 = thermochem_data_delta_gf_kj(h);
    var s0: f64 = thermochem_data_s_standard_j(h);
    _par_got_f(hf);
    _par_got_f(gf);
    _par_got_f(s0);
}

# Appends a Shomate segment's seven fields, in declaration order.
fn _par_got_shomate(s: KmShomate) {
    var a: f64 = s.a;
    var b: f64 = s.b;
    var c: f64 = s.c;
    var d: f64 = s.d;
    var e: f64 = s.e;
    var lo: f64 = s.t_min;
    var hi: f64 = s.t_max;
    _par_got_f(a);
    _par_got_f(b);
    _par_got_f(c);
    _par_got_f(d);
    _par_got_f(e);
    _par_got_f(lo);
    _par_got_f(hi);
}

# ADR 0002 #1: the reaction_enthalpy / reaction_gibbs_energy rows hold J/mol (the generator multiplies
# the oracle's kJ/mol by 1000.0, the port's one multiply), compared as class B; counted for the summary.
var _par_adr1_ok = 0;
var _par_adr1_err = 0;

# `thermochem` rows: src/thermochem.cyr and the generated src/thermochem_data.cyr.
fn _par_thermochem(fp, fl): i64 {
    if (_par_eq(fp, fl, "thermochem::THERMOCHEM_DATA") == 1) { _par_got_seq(KM_THERMOCHEM_COUNT); return 1; }
    if (_par_eq(fp, fl, "thermochem::THERMOCHEM_DATA[]") == 1) { _par_got_thermochem(_par_in(0) + 1); return 1; }
    if (_par_eq(fp, fl, "thermochem::SHOMATE_DATA") == 1) { _par_got_seq(KM_SHOMATE_COUNT); return 1; }
    if (_par_eq(fp, fl, "thermochem::SHOMATE_DATA[]") == 1) {
        var h = _par_in(0) + 1;
        var fo = shomate_data_formula(h);
        _par_got_text(fo, strlen(fo));
        _par_got_shomate(shomate_data_coeffs(h));
        return 1;
    }
    var is_h = _par_eq(fp, fl, "thermochem::reaction_enthalpy");
    var is_g = _par_eq(fp, fl, "thermochem::reaction_gibbs_energy");
    if (is_h == 1 || is_g == 1 || _par_eq(fp, fl, "thermochem::reaction_entropy") == 1) {
        var np = _par_in(0);
        var nr = _par_in(1 + 2 * np);
        var p = _par_in_species(0);
        var r = _par_in_species(1 + 2 * np);
        if (p < 0 || r < 0) { return 0 - 1; }
        var tag = 0;
        var val = 0;
        if (is_h != 1 && is_g != 1) {
            var t0, v0 = reaction_entropy(p, np, r, nr);
            tag = t0;
            val = v0;
        } else {
            if (is_h == 1) {
                var t1, v1 = reaction_enthalpy(p, np, r, nr);
                tag = t1;
                val = v1;
            } else {
                var t2, v2 = reaction_gibbs_energy(p, np, r, nr);
                tag = t2;
                val = v2;
            }
            if (is_ok(tag) == 1) { _par_adr1_ok = _par_adr1_ok + 1; } else { _par_adr1_err = _par_adr1_err + 1; }
        }
        _par_got_res(tag, val);
        return 1;
    }
    if (_par_eq(fp, fl, "thermochem::adiabatic_flame_temperature") == 1) {
        var dh: f64 = _par_in(0);
        var n = _par_in(1);
        var prods = _par_in_species(1);
        if (prods < 0) { return 0 - 1; }
        var t0k: f64 = _par_in(2 + 2 * n);
        var tf, vf = adiabatic_flame_temperature(dh, prods, n, t0k);
        _par_got_res(tf, vf);
        return 1;
    }
    var named = 0;
    if (_par_eq(fp, fl, "thermochem::lookup_thermochem") == 1 || _par_eq(fp, fl, "thermochem::lookup_shomate") == 1) {
        named = 1;
    }
    if (_par_eq(fp, fl, "thermochem::lookup_shomate_at") == 1) { named = 1; }
    if (_par_eq(fp, fl, "thermochem::enthalpy_change_cp") == 1) { named = 1; }
    if (named == 1) {
        var name = _par_in_cstr(0);
        if (name == 0) {
            if (load64(_par_in_l) == 0) { name = ""; } else { return 0 - 1; }
        }
        if (_par_eq(fp, fl, "thermochem::lookup_thermochem") == 1) {
            var ht = lookup_thermochem(name);
            if (ht == 0) { _par_got_none(); } else { _par_got_thermochem(ht); }
            return 1;
        }
        if (_par_eq(fp, fl, "thermochem::lookup_shomate") == 1) {
            var hs = lookup_shomate(name);
            if (hs == 0) { _par_got_none(); } else { _par_got_shomate(shomate_data_coeffs(hs)); }
            return 1;
        }
        var t1k: f64 = _par_in(1);
        if (_par_eq(fp, fl, "thermochem::lookup_shomate_at") == 1) {
            var ha = lookup_shomate_at(name, t1k);
            if (ha == 0) { _par_got_none(); } else { _par_got_shomate(shomate_data_coeffs(ha)); }
            return 1;
        }
        var t2k: f64 = _par_in(2);
        var tc, vc = enthalpy_change_cp(name, t1k, t2k);
        _par_got_res(tc, vc);
        return 1;
    }
    var x: f64 = _par_in(0);
    var y: f64 = _par_in(1);
    var z: f64 = _par_in(2);
    var w: f64 = _par_in(3);
    if (_par_eq(fp, fl, "thermochem::vant_hoff_k") == 1) {
        var tv, vv = vant_hoff_k(x, y, z, w);
        _par_got_res(tv, vv);
        return 1;
    }
    # A Shomate receiver: its seven fields, then T.
    var e5: f64 = _par_in(4);
    var lo: f64 = _par_in(5);
    var hi: f64 = _par_in(6);
    var sh = KmShomate { a: x, b: y, c: z, d: w, e: e5, t_min: lo, t_max: hi };
    var tk: f64 = _par_in(7);
    if (_par_eq(fp, fl, "Shomate::cp") == 1) { var cp: f64 = sh.cp(tk); _par_got_f(cp); return 1; }
    if (_par_eq(fp, fl, "Shomate::enthalpy_antiderivative") == 1) {
        var hh: f64 = sh.enthalpy_antiderivative(tk);
        _par_got_f(hh);
        return 1;
    }
    return 0;
}

# Appends an Antoine coefficient set's five fields, in declaration order.
fn _par_got_coeffs(c: KmAntoineCoeffs) {
    var a: f64 = c.a;
    var b: f64 = c.b;
    var cc: f64 = c.c;
    var lo: f64 = c.t_min_c;
    var hi: f64 = c.t_max_c;
    _par_got_f(a);
    _par_got_f(b);
    _par_got_f(cc);
    _par_got_f(lo);
    _par_got_f(hi);
}

# ADR 0002 #4, the Antoine mapping. Rust 1.2 returns a value (or NaN) for every input; the port
# returns Err outside the set's t_min_c ..= t_max_c, at or below the pole and for non-finite input.
# Per row (inputs: the set's five fields, then T):
# - oracle finite and T in range: the port must be Ok, compared under the row's class (C, or A for
#   the unit set's exact row);
# - oracle NaN, or T out of range (a non-finite range end is no range): the port must be Err. The
#   row is then *mapped*, counted as accepted under ADR 2 (_par_mapped = 2) and tallied below; an
#   Ok there is a FAIL.
# _par_mapped is cleared for every row by _par_dispatch.
var _par_mapped = 0;
var _par_map_nan = 0;     # rows mapped because the oracle is NaN (pole, non-finite input)
var _par_map_range = 0;   # rows mapped because T is out of range (oracle finite: extrapolation)
var _par_map_ok = 0;      # in-range, finite rows compared as values

fn _par_antoine(fp, fl): i64 {
    var a: f64 = _par_in(0);
    var b: f64 = _par_in(1);
    var c: f64 = _par_in(2);
    var lo: f64 = _par_in(3);
    var hi: f64 = _par_in(4);
    var temp: f64 = _par_in(5);
    var coeffs = KmAntoineCoeffs { a: a, b: b, c: c, t_min_c: lo, t_max_c: hi };
    var tag = 0;
    var val = 0;
    if (_par_eq(fp, fl, "phase::antoine_pressure_mmhg") == 1) {
        var t, v = antoine_pressure_mmhg(coeffs, temp);
        tag = t;
        val = v;
    } else {
        var t2, v2 = antoine_pressure_pa(coeffs, temp);
        tag = t2;
        val = v2;
    }
    var oracle_nan = 0;
    if (_par_want_n == 1 && load64(_par_want_k) == 102 && ulp_is_nan(load64(_par_want_v)) == 1) { oracle_nan = 1; }
    # A non-finite range end is no range (ADR 0002 #4: any non-finite input is Err).
    var in_range = 0;
    if (_km_is_finite(lo) == 1 && _km_is_finite(hi) == 1 && temp >= lo && temp <= hi) { in_range = 1; }
    if (oracle_nan == 1 || in_range == 0) {
        if (is_ok(tag) == 1) {
            _par_got_err(0 - 1);    # an Ok where ADR 0002 #4 wants Err: "Unknown" matches nothing
            return 1;
        }
        _par_got_err(val);
        _par_mapped = 2;
        if (oracle_nan == 1) { _par_map_nan = _par_map_nan + 1; } else { _par_map_range = _par_map_range + 1; }
        return 1;
    }
    _par_map_ok = _par_map_ok + 1;
    _par_got_res(tag, val);
    return 1;
}

# `phase` rows: src/phase.cyr and the generated src/phase_data.cyr.
fn _par_phase(fp, fl): i64 {
    if (_par_eq(fp, fl, "phase::ANTOINE_DATA") == 1) { _par_got_seq(KM_ANTOINE_COUNT); return 1; }
    if (_par_eq(fp, fl, "phase::ANTOINE_DATA[]") == 1) {
        var h = _par_in(0) + 1;
        var nm = antoine_data_name(h);
        _par_got_text(nm, strlen(nm));
        _par_got_coeffs(antoine_data_coeffs(h));
        return 1;
    }
    if (_par_eq(fp, fl, "phase::lookup_antoine") == 1) {
        var name = _par_in_cstr(0);
        if (name == 0) {
            # "" decodes to an empty C string; only a malformed token gives 0.
            if (_par_in_n == 1 && load64(_par_in_l) == 0) { name = ""; } else { return 0 - 1; }
        }
        var hh = lookup_antoine(name);
        if (hh == 0) { _par_got_none(); } else { _par_got_coeffs(antoine_data_coeffs(hh)); }
        return 1;
    }
    if (_par_eq(fp, fl, "phase::phase_rule") == 1) {
        var t, v = phase_rule(_par_in(0), _par_in(1));
        if (is_ok(t) == 1) { _par_got_i(v); } else { _par_got_err(v); }
        return 1;
    }
    if (_par_eq(fp, fl, "phase::antoine_pressure_mmhg") == 1 || _par_eq(fp, fl, "phase::antoine_pressure_pa") == 1) {
        return _par_antoine(fp, fl);
    }
    var x: f64 = _par_in(0);
    var y: f64 = _par_in(1);
    if (_par_eq(fp, fl, "phase::raoult_pressure") == 1) {
        var t, v = raoult_pressure(x, y);
        _par_got_res(t, v);
        return 1;
    }
    if (_par_eq(fp, fl, "phase::henry_pressure") == 1) {
        var t, v = henry_pressure(x, y);
        _par_got_res(t, v);
        return 1;
    }
    if (_par_eq(fp, fl, "phase::henry_solubility") == 1) {
        var t, v = henry_solubility(x, y);
        _par_got_res(t, v);
        return 1;
    }
    var z: f64 = _par_in(2);
    if (_par_eq(fp, fl, "phase::raoult_total_binary") == 1) {
        var t, v = raoult_total_binary(x, y, z);
        _par_got_res(t, v);
        return 1;
    }
    if (_par_eq(fp, fl, "phase::boiling_point_elevation") == 1) {
        var r: f64 = boiling_point_elevation(x, y, z);
        _par_got_f(r);
        return 1;
    }
    if (_par_eq(fp, fl, "phase::freezing_point_depression") == 1) {
        var r: f64 = freezing_point_depression(x, y, z);
        _par_got_f(r);
        return 1;
    }
    if (_par_eq(fp, fl, "phase::osmotic_pressure") == 1) {
        var t, v = osmotic_pressure(x, y, z);
        _par_got_res(t, v);
        return 1;
    }
    var w: f64 = _par_in(3);
    if (_par_eq(fp, fl, "phase::clausius_clapeyron") == 1) {
        var t, v = clausius_clapeyron(x, y, z, w);
        _par_got_res(t, v);
        return 1;
    }
    return 0;
}

# Appends a Peng–Robinson preset's three fields.
fn _par_got_pr(p: KmPengRobinsonParams) {
    var tc: f64 = p.tc;
    var pc: f64 = p.pc;
    var om: f64 = p.omega;
    _par_got_f(tc);
    _par_got_f(pc);
    _par_got_f(om);
}

# `gas` rows: src/gas.cyr and the generated src/gas_data.cyr. A PengRobinsonParams input is the
# first three tokens (tc, pc, omega).
fn _par_gas(fp, fl): i64 {
    if (_par_eq(fp, fl, "gas::PR_WATER") == 1) { _par_got_pr(KM_PR_WATER); return 1; }
    if (_par_eq(fp, fl, "gas::PR_NITROGEN") == 1) { _par_got_pr(KM_PR_NITROGEN); return 1; }
    if (_par_eq(fp, fl, "gas::PR_OXYGEN") == 1) { _par_got_pr(KM_PR_OXYGEN); return 1; }
    if (_par_eq(fp, fl, "gas::PR_CO2") == 1) { _par_got_pr(KM_PR_CO2); return 1; }
    if (_par_eq(fp, fl, "gas::PR_METHANE") == 1) { _par_got_pr(KM_PR_METHANE); return 1; }
    if (_par_eq(fp, fl, "gas::joule_thomson_ideal") == 1) {
        var j: f64 = joule_thomson_ideal();
        _par_got_f(j);
        return 1;
    }
    var x: f64 = _par_in(0);
    var y: f64 = _par_in(1);
    if (_par_eq(fp, fl, "gas::partial_pressure") == 1) { var r: f64 = partial_pressure(x, y); _par_got_f(r); return 1; }
    var z: f64 = _par_in(2);
    if (_par_eq(fp, fl, "gas::ideal_gas_pressure") == 1) {
        var t, v = ideal_gas_pressure(x, y, z);
        _par_got_res(t, v);
        return 1;
    }
    if (_par_eq(fp, fl, "gas::ideal_gas_volume") == 1) {
        var t, v = ideal_gas_volume(x, y, z);
        _par_got_res(t, v);
        return 1;
    }
    if (_par_eq(fp, fl, "gas::gas_density") == 1) { var t, v = gas_density(x, y, z); _par_got_res(t, v); return 1; }
    var w: f64 = _par_in(3);
    if (_par_eq(fp, fl, "gas::redlich_kwong_pressure") == 1) {
        var t, v = redlich_kwong_pressure(x, y, z, w);
        _par_got_res(t, v);
        return 1;
    }
    var u: f64 = _par_in(4);
    if (_par_eq(fp, fl, "gas::van_der_waals_pressure") == 1) {
        var t, v = van_der_waals_pressure(x, y, z, w, u);
        _par_got_res(t, v);
        return 1;
    }
    var p = KmPengRobinsonParams { tc: x, pc: y, omega: z };
    if (_par_eq(fp, fl, "gas::peng_robinson_pressure") == 1) {
        var t, v = peng_robinson_pressure(p, w, u);
        _par_got_res(t, v);
        return 1;
    }
    if (_par_eq(fp, fl, "gas::peng_robinson_z") == 1) {
        var t, v = peng_robinson_z(p, w, u);
        _par_got_res(t, v);
        return 1;
    }
    if (_par_eq(fp, fl, "gas::fugacity_coefficient_pr") == 1) {
        var t, v = fugacity_coefficient_pr(p, w, u);
        _par_got_res(t, v);
        return 1;
    }
    if (_par_eq(fp, fl, "gas::fugacity_pr") == 1) { var t, v = fugacity_pr(p, w, u); _par_got_res(t, v); return 1; }
    if (_par_eq(fp, fl, "gas::peng_robinson_z_roots") == 1) {
        var roots[24];
        var t, v = peng_robinson_z_roots(p, w, u, &roots);
        if (is_ok(t) != 1) { _par_got_err(v); return 1; }
        _par_got_seq(v);
        var k = 0;
        while (k < v) { _par_got_f(load64(&roots + k * 8)); k = k + 1; }
        return 1;
    }
    return 0;
}

# The ion list at input token k (`v:n`, then n pairs `f:c i:z`) as n 16-byte records (the concentration's f64
# bits, the charge as an i64 word), the layout src/solution.cyr's ionic_strength takes; its count is
# _par_in(k). 0 for an empty list.
fn _par_in_ions(k): i64 {
    var n = _par_in(k);
    if (n <= 0) { return 0; }
    var buf = alloc(n * 16);
    var j = 0;
    while (j < n) {
        store64(buf + j * 16, _par_in(k + 1 + 2 * j));
        store64(buf + j * 16 + 8, _par_in(k + 2 + 2 * j));
        j = j + 1;
    }
    return buf;
}

# `solution` rows: src/solution.cyr. The activity models' first input is the charge (`i:z`).
fn _par_solution(fp, fl): i64 {
    if (_par_eq(fp, fl, "solution::ionic_strength") == 1) {
        var r: f64 = ionic_strength(_par_in_ions(0), _par_in(0));
        _par_got_f(r);
        return 1;
    }
    if (_par_eq(fp, fl, "solution::debye_huckel_limiting") == 1) {
        var ii: f64 = _par_in(1);
        var a: f64 = _par_in(2);
        var t, v = debye_huckel_limiting(_par_in(0), ii, a);
        _par_got_res(t, v);
        return 1;
    }
    if (_par_eq(fp, fl, "solution::davies_activity") == 1) {
        var ii: f64 = _par_in(1);
        var a: f64 = _par_in(2);
        var t, v = davies_activity(_par_in(0), ii, a);
        _par_got_res(t, v);
        return 1;
    }
    if (_par_eq(fp, fl, "solution::debye_huckel_extended") == 1) {
        var ii: f64 = _par_in(1);
        var a: f64 = _par_in(2);
        var b: f64 = _par_in(3);
        var sz: f64 = _par_in(4);
        var t, v = debye_huckel_extended(_par_in(0), ii, a, b, sz);
        _par_got_res(t, v);
        return 1;
    }
    var x: f64 = _par_in(0);
    if (_par_eq(fp, fl, "solution::ph_from_h_concentration") == 1) {
        var t, v = ph_from_h_concentration(x);
        _par_got_res(t, v);
        return 1;
    }
    if (_par_eq(fp, fl, "solution::poh_from_oh_concentration") == 1) {
        var t, v = poh_from_oh_concentration(x);
        _par_got_res(t, v);
        return 1;
    }
    if (_par_eq(fp, fl, "solution::ph_from_poh") == 1) { var r: f64 = ph_from_poh(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "solution::h_concentration_from_ph") == 1) {
        var r: f64 = h_concentration_from_ph(x);
        _par_got_f(r);
        return 1;
    }
    var y: f64 = _par_in(1);
    if (_par_eq(fp, fl, "solution::molarity") == 1) { var t, v = molarity(x, y); _par_got_res(t, v); return 1; }
    if (_par_eq(fp, fl, "solution::molality") == 1) { var t, v = molality(x, y); _par_got_res(t, v); return 1; }
    if (_par_eq(fp, fl, "solution::weak_acid_ph") == 1) { var t, v = weak_acid_ph(x, y); _par_got_res(t, v); return 1; }
    if (_par_eq(fp, fl, "solution::weak_base_ph") == 1) { var t, v = weak_base_ph(x, y); _par_got_res(t, v); return 1; }
    if (_par_eq(fp, fl, "solution::solution_conductivity") == 1) {
        var r: f64 = solution_conductivity(x, y);
        _par_got_f(r);
        return 1;
    }
    var z: f64 = _par_in(2);
    if (_par_eq(fp, fl, "solution::dilution") == 1) { var t, v = dilution(x, y, z); _par_got_res(t, v); return 1; }
    if (_par_eq(fp, fl, "solution::henderson_hasselbalch") == 1) {
        var t, v = henderson_hasselbalch(x, y, z);
        _par_got_res(t, v);
        return 1;
    }
    if (_par_eq(fp, fl, "solution::kohlrausch_molar_conductivity") == 1) {
        var t, v = kohlrausch_molar_conductivity(x, y, z);
        _par_got_res(t, v);
        return 1;
    }
    var w: f64 = _par_in(3);
    if (_par_eq(fp, fl, "solution::limiting_molar_conductivity") == 1) {
        var r: f64 = limiting_molar_conductivity(x, y, z, w);
        _par_got_f(r);
        return 1;
    }
    return 0;
}

# Appends a HalfReaction's four fields (equation, couple, electrons, E°), in declaration order.
fn _par_got_half_reaction(h) {
    var eq = half_reaction_equation(h);
    _par_got_text(eq, strlen(eq));
    var cp = half_reaction_couple(h);
    _par_got_text(cp, strlen(cp));
    _par_got_i(half_reaction_electrons(h));
    var e0: f64 = half_reaction_standard_potential(h);
    _par_got_f(e0);
}

# Input token k as a C string, "" for an empty `s:` token; 0 only for a malformed one.
fn _par_in_text(k): i64 {
    var p = _par_in_cstr(k);
    if (p == 0 && load64(_par_in_l + k * 8) == 0) { return ""; }
    return p;
}

# `electrochemistry` rows: src/electrochemistry.cyr and the generated src/electrochemistry_data.cyr. An electron
# count is an `i:` token (Rust's u8), passed as the word.
fn _par_electrochemistry(fp, fl): i64 {
    if (_par_eq(fp, fl, "electrochemistry::STANDARD_POTENTIALS") == 1) {
        _par_got_seq(KM_STANDARD_POTENTIALS_COUNT);
        return 1;
    }
    if (_par_eq(fp, fl, "electrochemistry::STANDARD_POTENTIALS[]") == 1) {
        _par_got_half_reaction(_par_in(0) + 1);
        return 1;
    }
    if (_par_eq(fp, fl, "electrochemistry::lookup_half_reaction") == 1) {
        var name = _par_in_text(0);
        if (name == 0) { return 0 - 1; }
        var h = lookup_half_reaction(name);
        if (h == 0) { _par_got_none(); } else { _par_got_half_reaction(h); }
        return 1;
    }
    if (_par_eq(fp, fl, "electrochemistry::cell_potential_from_couples") == 1) {
        var c = _par_in_text(0);
        var a = _par_in_text(1);
        if (c == 0 || a == 0) { return 0 - 1; }
        var t, v = cell_potential_from_couples(c, a);
        _par_got_res(t, v);
        return 1;
    }
    if (_par_eq(fp, fl, "electrochemistry::cell_gibbs_energy") == 1) {
        var e: f64 = _par_in(1);
        var t, v = cell_gibbs_energy(_par_in(0), e);
        _par_got_res(t, v);
        return 1;
    }
    var x: f64 = _par_in(0);
    if (_par_eq(fp, fl, "electrochemistry::is_spontaneous_cell") == 1) { _par_got_i(is_spontaneous_cell(x)); return 1; }
    if (_par_eq(fp, fl, "electrochemistry::charge_to_moles_electrons") == 1) {
        var r: f64 = charge_to_moles_electrons(x);
        _par_got_f(r);
        return 1;
    }
    if (_par_eq(fp, fl, "electrochemistry::moles_electrons_to_charge") == 1) {
        var r: f64 = moles_electrons_to_charge(x);
        _par_got_f(r);
        return 1;
    }
    if (_par_eq(fp, fl, "electrochemistry::nernst_potential_25c") == 1) {
        var q: f64 = _par_in(2);
        var t, v = nernst_potential_25c(x, _par_in(1), q);
        _par_got_res(t, v);
        return 1;
    }
    if (_par_eq(fp, fl, "electrochemistry::nernst_potential") == 1) {
        var tk: f64 = _par_in(2);
        var q: f64 = _par_in(3);
        var t, v = nernst_potential(x, _par_in(1), tk, q);
        _par_got_res(t, v);
        return 1;
    }
    var y: f64 = _par_in(1);
    if (_par_eq(fp, fl, "electrochemistry::standard_cell_potential") == 1) {
        var r: f64 = standard_cell_potential(x, y);
        _par_got_f(r);
        return 1;
    }
    if (_par_eq(fp, fl, "electrochemistry::faraday_mass_deposited") == 1) {
        var t, v = faraday_mass_deposited(x, y, _par_in(2));
        _par_got_res(t, v);
        return 1;
    }
    if (_par_eq(fp, fl, "electrochemistry::faraday_charge_required") == 1) {
        var t, v = faraday_charge_required(x, y, _par_in(2));
        _par_got_res(t, v);
        return 1;
    }
    if (_par_eq(fp, fl, "electrochemistry::faraday_mass_ratio") == 1) {
        var mb: f64 = _par_in(3);
        var t, v = faraday_mass_ratio(x, y, _par_in(2), mb, _par_in(4));
        _par_got_res(t, v);
        return 1;
    }
    return 0;
}

# `kinetics` rows: src/kinetics.cyr. Every input is an f64. lineweaver_burk's Ok output is the slope and the
# intercept the port writes to the caller's buffer (the Rust tuple, port plan §6.4); its count must be 2.
fn _par_kinetics(fp, fl): i64 {
    var x: f64 = _par_in(0);
    if (_par_eq(fp, fl, "kinetics::half_life_first_order") == 1) {
        var t, v = half_life_first_order(x);
        _par_got_res(t, v);
        return 1;
    }
    var y: f64 = _par_in(1);
    if (_par_eq(fp, fl, "kinetics::steady_state_rate") == 1) {
        var r: f64 = steady_state_rate(x, y);
        _par_got_f(r);
        return 1;
    }
    if (_par_eq(fp, fl, "kinetics::zero_order_half_life") == 1) {
        var t, v = zero_order_half_life(x, y);
        _par_got_res(t, v);
        return 1;
    }
    if (_par_eq(fp, fl, "kinetics::eyring_rate") == 1) {
        var t, v = eyring_rate(x, y);
        _par_got_res(t, v);
        return 1;
    }
    if (_par_eq(fp, fl, "kinetics::lineweaver_burk") == 1) {
        var lb[16];
        var t, v = lineweaver_burk(x, y, &lb);
        if (is_ok(t) != 1) { _par_got_err(v); return 1; }
        if (v != 2) { return 0 - 1; }
        _par_got_f(load64(&lb));
        _par_got_f(load64(&lb + 8));
        return 1;
    }
    var z: f64 = _par_in(2);
    if (_par_eq(fp, fl, "kinetics::arrhenius_rate") == 1) {
        var t, v = arrhenius_rate(x, y, z);
        _par_got_res(t, v);
        return 1;
    }
    if (_par_eq(fp, fl, "kinetics::first_order_concentration") == 1) {
        var r: f64 = first_order_concentration(x, y, z);
        _par_got_f(r);
        return 1;
    }
    if (_par_eq(fp, fl, "kinetics::second_order_concentration") == 1) {
        var t, v = second_order_concentration(x, y, z);
        _par_got_res(t, v);
        return 1;
    }
    if (_par_eq(fp, fl, "kinetics::zero_order_concentration") == 1) {
        var r: f64 = zero_order_concentration(x, y, z);
        _par_got_f(r);
        return 1;
    }
    if (_par_eq(fp, fl, "kinetics::nth_order_half_life") == 1) {
        var t, v = nth_order_half_life(x, y, z);
        _par_got_res(t, v);
        return 1;
    }
    if (_par_eq(fp, fl, "kinetics::steady_state_intermediate") == 1) {
        var t, v = steady_state_intermediate(x, y, z);
        _par_got_res(t, v);
        return 1;
    }
    if (_par_eq(fp, fl, "kinetics::michaelis_menten") == 1) {
        var t, v = michaelis_menten(x, y, z);
        _par_got_res(t, v);
        return 1;
    }
    if (_par_eq(fp, fl, "kinetics::eyring_rate_from_activation") == 1) {
        var t, v = eyring_rate_from_activation(x, y, z);
        _par_got_res(t, v);
        return 1;
    }
    var w: f64 = _par_in(3);
    if (_par_eq(fp, fl, "kinetics::collision_theory_rate") == 1) {
        var t, v = collision_theory_rate(x, y, z, w);
        _par_got_res(t, v);
        return 1;
    }
    if (_par_eq(fp, fl, "kinetics::pre_equilibrium_rate") == 1) {
        var t, v = pre_equilibrium_rate(x, y, z, w);
        _par_got_res(t, v);
        return 1;
    }
    return 0;
}

# Routes a row to its module's dispatcher. 0 (pending) for a module with none yet.
fn _par_dispatch(mp, ml, fp, fl): i64 {
    _par_got_n = 0;
    _par_mapped = 0;
    if (_par_eq(mp, ml, "constants") == 1) { return _par_constants(fp, fl); }
    if (_par_eq(mp, ml, "electrochemistry") == 1) { return _par_electrochemistry(fp, fl); }
    if (_par_eq(mp, ml, "element") == 1) { return _par_element(fp, fl); }
    if (_par_eq(mp, ml, "math") == 1) { return _par_math(fp, fl); }
    if (_par_eq(mp, ml, "molecule") == 1) { return _par_molecule(fp, fl); }
    if (_par_eq(mp, ml, "reaction") == 1) { return _par_reaction(fp, fl); }
    if (_par_eq(mp, ml, "thermo") == 1) { return _par_thermo(fp, fl); }
    if (_par_eq(mp, ml, "thermochem") == 1) { return _par_thermochem(fp, fl); }
    if (_par_eq(mp, ml, "phase") == 1) { return _par_phase(fp, fl); }
    if (_par_eq(mp, ml, "gas") == 1) { return _par_gas(fp, fl); }
    if (_par_eq(mp, ml, "solution") == 1) { return _par_solution(fp, fl); }
    if (_par_eq(mp, ml, "kinetics") == 1) { return _par_kinetics(fp, fl); }
    return 0;
}

# Shadow comparisons, never gated: the same golden rows through another Cyrius candidate, against the row's
# reference (since ADR 0006 the corrected outputs on a corrected row, so a correctly rounded candidate is 0 ulp
# everywhere and a glibc-like one differs where glibc misrounds).
# - (M3c-3, ADR 0006) the stdlib primitives the modules called before they moved to the correctly rounded ones:
#   f64_exp and f64_ln (x87 on x86_64, the fdlibm polyfills on aarch64), ganita_f64_acos and ganita_f64_pow,
#   whose pow(-1, DBL_MAX) is ADR 0004's +inf (the record of why the port no longer calls them);
# - 10.0.powf(y) through _km_cr_pow(10, y), the same correctly rounded value as the _km_cr_exp10 the modules
#   call;
# - the cos rows past |x| = 8, where _km_cos is f64_cos (not correctly rounded) and the row keeps the stdlib's
#   bound, on a line of their own;
# - the stdlib functions the M1 helpers replace, to show where their semantics differ.
fn _par_shadows(mp, ml, fp, fl, cls) {
    if (_par_eq(mp, ml, "math") != 1) { return 0; }
    var x: f64 = _par_in(0);
    if (_par_eq(fp, fl, "f64::exp") == 1) {
        _par_got_n = 0;
        var r: f64 = f64_exp(x);
        _par_got_f(r);
        _par_shadow_record("f64::exp ~ f64_exp", cls);
        return 0;
    }
    if (_par_eq(fp, fl, "f64::ln") == 1) {
        _par_got_n = 0;
        var r: f64 = f64_ln(x);
        _par_got_f(r);
        _par_shadow_record("f64::ln ~ f64_ln", cls);
        return 0;
    }
    if (_par_eq(fp, fl, "f64::acos") == 1) {
        _par_got_n = 0;
        var r: f64 = ganita_f64_acos(x);
        _par_got_f(r);
        _par_shadow_record("f64::acos ~ ganita_f64_acos", cls);
        return 0;
    }
    if (_par_eq(fp, fl, "f64::cos") == 1 && _par_cos_wide() == 1) {
        _par_got_n = 0;
        var r: f64 = f64_cos(x);
        _par_got_f(r);
        _par_shadow_record("f64::cos, |x| > 8 ~ f64_cos (bound 2)", cls);
        return 0;
    }
    if (_par_eq(fp, fl, "f64::powf_base10") == 1) {
        _par_got_n = 0;
        var r: f64 = _km_cr_pow(10.0, x);
        _par_got_f(r);
        _par_shadow_record("f64::powf_base10 ~ _km_cr_pow(10, y)", cls);
        return 0;
    }
    if (_par_eq(fp, fl, "f64::round") == 1) {
        _par_got_n = 0;
        var r: f64 = f64_round(x);
        _par_got_f(r);
        _par_shadow_record("f64::round ~ f64_round", cls);
        return 0;
    }
    if (_par_eq(fp, fl, "f64::signum") == 1) {
        _par_got_n = 0;
        var r: f64 = f64_sign(x);
        _par_got_f(r);
        _par_shadow_record("f64::signum ~ f64_sign", cls);
        return 0;
    }
    var y: f64 = _par_in(1);
    if (_par_eq(fp, fl, "f64::powf") == 1) {
        _par_got_n = 0;
        var r: f64 = ganita_f64_pow(x, y);
        _par_got_f(r);
        _par_shadow_record("f64::powf ~ ganita_f64_pow", cls);
        return 0;
    }
    if (_par_eq(fp, fl, "f64::max") == 1) {
        _par_got_n = 0;
        var r: f64 = f64_max(x, y);
        _par_got_f(r);
        _par_shadow_record("f64::max ~ f64_max", cls);
        return 0;
    }
    if (_par_eq(fp, fl, "f64::min") == 1) {
        _par_got_n = 0;
        var r: f64 = f64_min(x, y);
        _par_got_f(r);
        _par_shadow_record("f64::min ~ f64_min", cls);
        return 0;
    }
    return 0;
}

# 1 when the current row's first input is a finite x with |x| > 8: past _km_cos's correctly rounded range,
# where it returns f64_cos (ADR 0005; the Peng–Robinson arguments are in [−2π/3, π]).
#must_use
fn _par_cos_wide(): i64 {
    var x: f64 = _par_in(0);
    var ax: f64 = f64_abs(x);
    if (ax > 8.0 && _km_is_finite(x) == 1) { return 1; }
    return 0;
}

# The class-C bound for a function, in ulps; -1 when none is set yet (the rows would be measured). A bound is set
# BEFORE the function's first gated comparison and never raised to make a row pass.
#
# ADR 0006 (M3c-3): every class-C function the port has ported is on correctly rounded primitives (src/mathx.cyr:
# _km_cr_exp, _km_cr_expm1, _km_cr_exp10, _km_cr_ln, _km_cr_log10, _km_cr_pow, and ADR 0005's _km_cos and
# _km_acos), in Rust's operation order, and each row's reference is the corrected oracle: the oracle's operations
# with every primitive result correctly rounded (tests/golden/<module>.cr.tsv where that differs from the
# oracle's outputs). Both sides then evaluate the same correctly rounded values in the same order, so the bound
# is 0 and any difference is a port defect (ADR 0006 item 3). The sensitivity rule (K = 2·S·c + 2) that set the
# M0–M3a bounds retires for them (docs/development/port-parity.md §5–§8 keep its history; §10 the result).
#
# The exceptions keep the stdlib's bound of 2 ulp (glibc and the stdlib counterpart each document < 1 ulp;
# measured max 1 on every target, port-parity.md §2): f64::sin and f64::atan2 (f64_sin, ganita_f64_atan2), for
# which the port has no correctly rounded primitive yet (M4 adds them with their first callers, ADR 0006
# item 1), and the f64::cos rows with a finite |x| > 8, outside _km_cos's correctly rounded range.
#must_use
fn _par_c_bound(fp, fl): i64 {
    # The math primitives (M0, M1; ADR 0006 since M3c-3).
    if (_par_eq(fp, fl, "f64::exp") == 1) { return 0; }
    if (_par_eq(fp, fl, "f64::exp_m1") == 1) { return 0; }
    if (_par_eq(fp, fl, "f64::log10") == 1) { return 0; }
    if (_par_eq(fp, fl, "f64::ln") == 1) { return 0; }
    if (_par_eq(fp, fl, "f64::powf") == 1) { return 0; }
    if (_par_eq(fp, fl, "f64::powf_base10") == 1) { return 0; }
    if (_par_eq(fp, fl, "f64::powf_base2") == 1) { return 0; }
    if (_par_eq(fp, fl, "f64::acos") == 1) { return 0; }
    if (_par_eq(fp, fl, "f64::cos") == 1) {
        if (_par_cos_wide() == 1) { return 2; }
        return 0;
    }
    if (_par_eq(fp, fl, "f64::sin") == 1) { return 2; }
    if (_par_eq(fp, fl, "f64::atan2") == 1) { return 2; }
    # kimiya's own class-C functions (M2a reaction, phase, gas; M2b thermochem; M3a solution, electrochemistry; M3b
    # kinetics), each on correctly rounded primitives only (named per line; cbrt and sqrt are correctly rounded too).
    # The kinetics six were measured, unbounded, from M3b until M3c-3 (port-parity.md §8).
    if (_par_eq(fp, fl, "reaction::equilibrium_constant") == 1) { return 0; }          # ADR 0006: exp
    if (_par_eq(fp, fl, "phase::clausius_clapeyron") == 1) { return 0; }               # ADR 0006: exp
    if (_par_eq(fp, fl, "phase::antoine_pressure_mmhg") == 1) { return 0; }            # ADR 0006: exp10
    if (_par_eq(fp, fl, "phase::antoine_pressure_pa") == 1) { return 0; }              # ADR 0006: exp10
    if (_par_eq(fp, fl, "gas::peng_robinson_z") == 1) { return 0; }                    # ADR 0006: acos, cos
    if (_par_eq(fp, fl, "gas::peng_robinson_z_roots") == 1) { return 0; }              # ADR 0006: acos, cos
    if (_par_eq(fp, fl, "gas::fugacity_coefficient_pr") == 1) { return 0; }            # ADR 0006: acos, cos, ln, exp
    if (_par_eq(fp, fl, "gas::fugacity_pr") == 1) { return 0; }                        # ADR 0006: acos, cos, ln, exp
    if (_par_eq(fp, fl, "gas::redlich_kwong_pressure") == 1) { return 0; }             # ADR 0006: pow(x, 2.5)
    if (_par_eq(fp, fl, "thermochem::vant_hoff_k") == 1) { return 0; }                 # ADR 0006: exp
    if (_par_eq(fp, fl, "solution::ph_from_h_concentration") == 1) { return 0; }       # ADR 0006: log10
    if (_par_eq(fp, fl, "solution::poh_from_oh_concentration") == 1) { return 0; }     # ADR 0006: log10
    if (_par_eq(fp, fl, "solution::henderson_hasselbalch") == 1) { return 0; }         # ADR 0006: log10
    if (_par_eq(fp, fl, "solution::h_concentration_from_ph") == 1) { return 0; }       # ADR 0006: exp10
    if (_par_eq(fp, fl, "solution::weak_acid_ph") == 1) { return 0; }                  # ADR 0006: log10
    if (_par_eq(fp, fl, "solution::weak_base_ph") == 1) { return 0; }                  # ADR 0006: log10
    if (_par_eq(fp, fl, "solution::debye_huckel_limiting") == 1) { return 0; }         # ADR 0006: exp10
    if (_par_eq(fp, fl, "solution::debye_huckel_extended") == 1) { return 0; }         # ADR 0006: exp10
    if (_par_eq(fp, fl, "solution::davies_activity") == 1) { return 0; }               # ADR 0006: exp10
    if (_par_eq(fp, fl, "electrochemistry::nernst_potential") == 1) { return 0; }      # ADR 0006: ln
    if (_par_eq(fp, fl, "electrochemistry::nernst_potential_25c") == 1) { return 0; }  # ADR 0006: ln
    if (_par_eq(fp, fl, "kinetics::arrhenius_rate") == 1) { return 0; }                # ADR 0006: exp
    if (_par_eq(fp, fl, "kinetics::first_order_concentration") == 1) { return 0; }     # ADR 0006: exp
    if (_par_eq(fp, fl, "kinetics::nth_order_half_life") == 1) { return 0; }           # ADR 0006: expm1, pow
    if (_par_eq(fp, fl, "kinetics::collision_theory_rate") == 1) { return 0; }         # ADR 0006: exp
    if (_par_eq(fp, fl, "kinetics::eyring_rate") == 1) { return 0; }                   # ADR 0006: exp
    if (_par_eq(fp, fl, "kinetics::eyring_rate_from_activation") == 1) { return 0; }   # ADR 0006: exp ×2
    return 0 - 1;
}

# The ADR accepting a divergent row (function and raw input field), or 0. Each entry names
# its ADR; an accepted row is reported on every run and doesn't fail its module. The ADR 0002
# divergences (port plan §2.3) arrive with their modules' golden rows: #4 (Antoine) in M2a.
# ADR 0004's row, f64::powf(-1, DBL_MAX) (ganita's pow gives +inf for 1), had an entry here until M3c-3:
# the row now goes through _km_cr_pow, which gives 1, and is a plain ok. The `f64::powf ~ ganita_f64_pow`
# shadow line keeps the record of ganita's defect (ADR 0004 stays as its record).
#must_use
fn _par_accepted(fp, fl, ip, il): i64 {
    # ADR 0002 #4: an Antoine row the dispatcher mapped (oracle NaN or T out of range ↔ port Err).
    if (_par_mapped == 2) { return 2; }
    return 0;
}

# 1 for an ADR whose accepted rows are counted but not printed row by row: ADR 0002 #4's Antoine
# mapping (hundreds of rows, summarised by _par_module_done).
#must_use
fn _par_accepted_quiet(adr): i64 {
    if (adr == 2) { return 1; }
    return 0;
}

# After the phase module: the ADR 0002 #4 mapping summary; after thermochem, ADR 0002 #1's.
fn _par_module_done(mp, ml) {
    if (_par_eq(mp, ml, "thermochem") == 1) {
        print("  ADR 0002 #1 kJ -> J: ", 23);
        fmt_int(_par_adr1_ok);
        print(" reaction_enthalpy / reaction_gibbs_energy Ok rows compared in J/mol", 68);
        print(" (the oracle's kJ/mol x 1000.0), ", 33);
        fmt_int(_par_adr1_err);
        println(" Err rows");
        return 0;
    }
    if (_par_eq(mp, ml, "phase") != 1) { return 0; }
    print("  ADR 0002 #4 Antoine mapping: ", 31);
    fmt_int(_par_map_ok);
    print(" in-range rows compared as values; accepted (ADR 2), port Err for ", 66);
    fmt_int(_par_map_nan);
    print(" oracle-NaN rows and ", 21);
    fmt_int(_par_map_range);
    println(" out-of-range rows (oracle extrapolated)");
    return 0;
}

# kimiya has one harness: no module is skipped.
#must_use
fn _par_skip(mp, ml): i64 {
    return 0;
}

var exit_code = _par_main();
sys_exit_group(exit_code);
