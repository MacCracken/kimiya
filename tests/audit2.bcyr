include "src/nuclear_data.cyr"
include "src/nuclear.cyr"
include "src/spectroscopy_data.cyr"
include "src/spectroscopy.cyr"

# A sink the timed loops write to, so their results are used.
var _bench_sink = 0;

var _bench_b5 = 0;          # the audit's B5 (ADR 0002 #35): 10 × 6 input words (bench_audit_b5)
var _bench_b6_sig = 0;      # the audit's B6 (ADR 0002 #36, #37): 4 × 1024 signal words (bench_audit_b6)
var _bench_b6_out = 0;      # fft_spectrum's out buffer (2 × 256 f64: the in-place transform), find_peaks' indices
var _bench_b6_flame = 0;    # [("CO2(g)", 10⁻²⁰⁰), ("H2O(g)", 2·10⁻²⁰⁰), ("N2(g)", 7.52·10⁻²⁰⁰)]
var _bench_b7_dense = 0;    # the audit's B7 (ADR 0002 #39): a 30 × 31 dense matrix (bench_audit_b7)
var _bench_b7_out = 0;      # balance_equation's coefficients (31 words)
# The survey's 2 × 3 (Rust's first product 3037000500² overflows; x = [1, 1, 1]) and a 10 × 9 golden row whose Rust
# elimination overflows (x = [561, 420, 549, 115, 621, 712, 173, 710, 41]).
var _bench_b7_survey: i64[6] = { 3037000500, 1, -3037000501, 1, 3037000500, -3037000501 };
var _bench_b7_m109: i64[90] = { -634, 0, 0, 561, 0, 0, 1683, 0, 0, 0, 0, 0, 123, 0, -82, 0, 0, 1079, 1424, 519, 0, 0, 0,
    -1122, -1260, 0, 0, 0, 0, 0, 346, 0, 0, -230, 0, 0, -41, 0, -1424, 0, 0, 1098, 0, 0, 561, 0, 0, 0, 0, 1424, -1242,
    0, 0, 0, -1420, 621, 0, 0, -420, 0, 0, 1122, 0, 345, 115, 0, -2103, 0, 0, 0, 0, 0, 0, -1098, 840, 2136, 0, -345, 0,
    0, 0, -82, 0, 0, 0, 0, 0, 0, 0, 1122 };

# Cyrius-only, the overflow audit's B5 (ADR 0002 #35): the exp / exp10 arguments, on typical inputs, then on the edges
# that take each one's unbounded-exponent slow path. which: 0 equilibrium_constant (−5000 J/mol, 298 K),
# 1 debye_huckel_limiting (2, 0.01 M, 0.509), 2 debye_huckel_extended (1, 0.05 M, 0.509, 0.328, 3 Å), 3 davies_activity
# (1, 0.1 M, 0.509); the edges: 4 equilibrium_constant_edge (−DBL_MAX, DBL_MAX: R·T past DBL_MAX),
# 5 equilibrium_constant_subnormal (−10⁻³²⁰, 10⁻³²²: R·T subnormal), 6 debye_huckel_limiting_edge (100000, 0, 10³⁰⁰:
# A·z² past DBL_MAX at I = 0), 7 debye_huckel_extended_edge (1, 1, 10³⁰⁸, 10¹⁵⁵, 10¹⁵⁵: B·å past DBL_MAX),
# 8 debye_huckel_extended_overflow (100000, 1, 10³⁰⁰, 10¹⁵⁴, 10¹⁵⁴: A·z² past DBL_MAX), 9 davies_activity_edge
# (100000, 0, 10³⁰⁰). The charge is the first word of the DH rows, an integer.
fn bench_audit_b5(name, which, per_batch, batches) {
    var x = _bench_b5 + 48 * which;
    var w0 = load64(x);
    var a0: f64 = load64(x);
    var a1: f64 = load64(x + 8);
    var a2: f64 = load64(x + 16);
    var a3: f64 = load64(x + 24);
    var a4: f64 = load64(x + 32);
    var b = bench_new(name);
    var k = 0;
    while (k < batches) {
        bench_batch_start(b);
        var i = 0;
        while (i < per_batch) {
            if (which == 0 || which == 4 || which == 5) {
                var t0, v0 = equilibrium_constant(a0, a1);
                _bench_sink = v0;
            } elif (which == 1 || which == 6) {
                var t1, v1 = debye_huckel_limiting(w0, a1, a2);
                _bench_sink = v1;
            } elif (which == 2 || which == 7 || which == 8) {
                var t2, v2 = debye_huckel_extended(w0, a1, a2, a3, a4);
                _bench_sink = v2;
            } else {
                var t3, v3 = davies_activity(w0, a1, a2);
                _bench_sink = v3;
            }
            i = i + 1;
        }
        bench_batch_stop(b, per_batch);
        k = k + 1;
    }
    bench_report(b);
}

# The B5 input words (bench_audit_b5): 10 rows of 6 words, the DH rows' charge an integer word.
fn _bench_b5_setup() {
    _bench_b5 = alloc(60 * 8);
    var b5 = _bench_b5;
    var q = 0;
    while (q < 60) {
        store64(b5 + 8 * q, 0);
        q = q + 1;
    }
    var dg: f64 = -5000.0;                  # 0 equilibrium_constant
    var t298: f64 = 298.0;
    store64(b5, _km_bits(dg));
    store64(b5 + 8, _km_bits(t298));
    var i01: f64 = 0.01;                    # 1 debye_huckel_limiting
    var a509: f64 = 0.509;
    store64(b5 + 48, 2);
    store64(b5 + 56, _km_bits(i01));
    store64(b5 + 64, _km_bits(a509));
    var i05: f64 = 0.05;                    # 2 debye_huckel_extended
    var b328: f64 = 0.328;
    var s3: f64 = 3.0;
    store64(b5 + 96, 1);
    store64(b5 + 104, _km_bits(i05));
    store64(b5 + 112, _km_bits(a509));
    store64(b5 + 120, _km_bits(b328));
    store64(b5 + 128, _km_bits(s3));
    var i1: f64 = 0.1;                      # 3 davies_activity
    store64(b5 + 144, 1);
    store64(b5 + 152, _km_bits(i1));
    store64(b5 + 160, _km_bits(a509));
    var dmax: f64 = 0x7FEFFFFFFFFFFFFF;     # 4 equilibrium_constant_edge: −DBL_MAX, DBL_MAX
    var ndmax: f64 = -dmax;
    store64(b5 + 192, _km_bits(ndmax));
    store64(b5 + 200, _km_bits(dmax));
    var s320: f64 = 0x00000000000007E8;     # 5 equilibrium_constant_subnormal: −10⁻³²⁰, 10⁻³²²
    var ns320: f64 = -s320;
    store64(b5 + 240, _km_bits(ns320));
    store64(b5 + 248, 0x0000000000000014);
    store64(b5 + 288, 100000);              # 6 debye_huckel_limiting_edge: (100000, 0, 10³⁰⁰)
    store64(b5 + 304, 0x7E37E43C8800759C);
    var one: f64 = 1.0;                     # 7 debye_huckel_extended_edge: (1, 1, 10³⁰⁸, 10¹⁵⁵, 10¹⁵⁵)
    store64(b5 + 336, 1);
    store64(b5 + 344, _km_bits(one));
    store64(b5 + 352, 0x7FE1CCF385EBC8A0);
    store64(b5 + 360, 0x601DD55745CBB7ED);
    store64(b5 + 368, 0x601DD55745CBB7ED);
    store64(b5 + 384, 100000);              # 8 debye_huckel_extended_overflow: (100000, 1, 10³⁰⁰, 10¹⁵⁴, 10¹⁵⁴)
    store64(b5 + 392, _km_bits(one));
    store64(b5 + 400, 0x7E37E43C8800759C);
    store64(b5 + 408, 0x5FE7DDDF6B095FF1);
    store64(b5 + 416, 0x5FE7DDDF6B095FF1);
    store64(b5 + 432, 100000);              # 9 davies_activity_edge: (100000, 0, 10³⁰⁰)
    store64(b5 + 448, 0x7E37E43C8800759C);
}

# Cyrius-only, the overflow audit's B6 (ADR 0002 #36 … #38): the edges that take the FFT's, find_peaks' and the flame's
# other paths (the typical inputs are tests/kimiya.bcyr's fft_spectrum_256 … _4096, find_peaks_1000 and
# adiabatic_flame_ch4_air). which: 0 spectroscopy/fft_spectrum_256_huge (kimiya.bcyr's seeded signal × 10³⁰⁷: the
# butterflies' sums pass DBL_MAX, the unbounded-exponent transform), 1 fft_spectrum_256_subnormal (× 10⁻³¹⁰: the data
# below the fast test's 2⁻⁹²¹, the same), 2 fft_spectrum_256_squares (× 10²⁰⁰: Rust's transform in range, every bin's
# re² + im² past DBL_MAX, the per-bin unbounded magnitude), 3 find_peaks_1000_subnormal (the signal's 1,000 values as
# subnormal multiples k·2⁻¹⁰⁷⁴, k < 16, threshold ½: the candidates within 4·2⁻¹⁰⁷⁴ of Rust's threshold, about half,
# decided by the exact predicate), 4 thermochem/adiabatic_flame_tiny (CH₄/air × 10⁻²⁰⁰, ADR 0002 #38's golden row:
# Rust's bracket product underflows to −0, here bracketed and Newton accepts its guess).
fn bench_audit_b6(name, which, per_batch, batches) {
    var sig = _bench_b6_sig + 8 * 1024 * which;
    if (which >= 3) { sig = _bench_b6_sig + 8 * 1024 * 3; }
    var th: f64 = 0.5;
    var dh: f64 = 0x97A2BDD1E669466D;       # −802,300 × 10⁻²⁰⁰ J/mol
    var t0: f64 = 298.15;
    var b = bench_new(name);
    var k = 0;
    while (k < batches) {
        bench_batch_start(b);
        var i = 0;
        while (i < per_batch) {
            if (which <= 2) {
                var t1, v1 = fft_spectrum(sig, 256, _bench_b6_out, 512);
                _bench_sink = load64(_bench_b6_out + 8);
            } elif (which == 3) {
                var t2, v2 = find_peaks(sig, 1000, th, _bench_b6_out, 1000);
                _bench_sink = v2;
            } else {
                var t3, v3 = adiabatic_flame_temperature(dh, _bench_b6_flame, 3, t0);
                _bench_sink = v3;
            }
            i = i + 1;
        }
        bench_batch_stop(b, per_batch);
        k = k + 1;
    }
    bench_report(b);
}

# The B6 inputs (bench_audit_b6): kimiya.bcyr's seeded signal (u in [0, 1), 40-bit) scaled three ways, its subnormal
# multiples, and the flame's products.
fn _bench_b6_setup() {
    _bench_b6_sig = alloc(4 * 1024 * 8);
    _bench_b6_out = alloc(1024 * 8);
    var e307: f64 = 0x7FAC7B1F3CAC7433;     # 10³⁰⁷
    var e300: f64 = 0x01A56E1FC2F8F359;     # 10⁻³⁰⁰
    var e10: f64 = 0x3DDB7CDFD9D7BDBB;      # 10⁻¹⁰
    var e310: f64 = e300 * e10;             # 10⁻³¹⁰, subnormal
    var e200: f64 = 0x6974E718D7D7625A;     # 10²⁰⁰
    var seed = 0x2545F4914F6CDD1D;
    var j = 0;
    while (j < 1024) {
        seed = seed ^ (seed << 13);
        seed = seed ^ (seed >> 7);
        seed = seed ^ (seed << 17);
        var u: f64 = f64_from((seed >> 11) & 0xFFFFFFFFFF);
        var x: f64 = u / 1099511627776.0;
        var x0: f64 = x * e307;
        var x1: f64 = x * e310;
        var x2: f64 = x * e200;
        store64(_bench_b6_sig + 8 * j, x0);
        store64(_bench_b6_sig + 8 * 1024 + 8 * j, x1);
        store64(_bench_b6_sig + 8 * 2048 + 8 * j, x2);
        store64(_bench_b6_sig + 8 * 3072 + 8 * j, (seed >> 20) & 15);
        j = j + 1;
    }
    _bench_b6_flame = alloc(48);
    store64(_bench_b6_flame, "CO2(g)");
    store64(_bench_b6_flame + 8, 0x16687E92154EF7AC);  # 10⁻²⁰⁰
    store64(_bench_b6_flame + 16, "H2O(g)");
    store64(_bench_b6_flame + 24, 0x16787E92154EF7AC); # 2·10⁻²⁰⁰
    store64(_bench_b6_flame + 32, "N2(g)");
    store64(_bench_b6_flame + 40, 0x169706561E451C03); # 7.52·10⁻²⁰⁰
}

# Cyrius-only, the overflow audit's B7 (ADR 0002 #39): balance_equation where Rust's checked i64 elimination overflows
# (Rust's ComputationError), here the multi-word path from the original matrix after the i64 attempt. which:
# 0 balance_survey_2x3 (the survey's example), 1 balance_overflow_10x9 (the golden row above), 2 balance_dense_30x31
# (30 × 31, seeded entries in [−2⁴⁵, 2⁴⁵), the last column solved for x[j] = 1 + j mod 3: intermediates past 3,000
# bits).
fn bench_audit_b7(name, which, per_batch, batches) {
    var mat = &_bench_b7_survey;
    var m = 2;
    var n = 3;
    if (which == 1) {
        mat = &_bench_b7_m109;
        m = 10;
        n = 9;
    }
    if (which == 2) {
        mat = _bench_b7_dense;
        m = 30;
        n = 31;
    }
    var b = bench_new(name);
    var k = 0;
    while (k < batches) {
        bench_batch_start(b);
        var i = 0;
        while (i < per_batch) {
            var t, v = balance_equation(mat, m, n, _bench_b7_out, 31);
            _bench_sink = v;
            i = i + 1;
        }
        bench_batch_stop(b, per_batch);
        k = k + 1;
    }
    bench_report(b);
}

# The B7 inputs (bench_audit_b7): the 30 × 31 matrix, tests/stoichiometry.tcyr's seeded construction (xorshift64).
fn _bench_b7_setup() {
    var n = 31;
    _bench_b7_dense = alloc(8 * (n - 1) * n);
    _bench_b7_out = alloc(8 * n);
    var seed = 0x2545F4914F6CDD1D;
    var i = 0;
    while (i < n - 1) {
        var s = 0;
        var j = 0;
        while (j < n - 1) {
            seed = seed ^ (seed << 13);
            seed = seed ^ (seed >> 7);
            seed = seed ^ (seed << 17);
            var e = ((seed >> 11) & 0x3FFFFFFFFFFF) - 0x200000000000;
            store64(_bench_b7_dense + 8 * (i * n + j), e);
            s = s + e * (1 + j % 3);
            j = j + 1;
        }
        store64(_bench_b7_dense + 8 * (i * n + n - 1), 0 - s);
        i = i + 1;
    }
}

# Runs every bench.
fn main(): i64 {
    alloc_init();
    _bench_b5_setup();
    bench_audit_b5("reaction/equilibrium_constant", 0, 1000000, 20);
    bench_audit_b5("solution/debye_huckel_limiting", 1, 1000000, 20);
    bench_audit_b5("solution/debye_huckel_extended", 2, 1000000, 20);
    bench_audit_b5("solution/davies_activity", 3, 1000000, 20);
    bench_audit_b5("reaction/equilibrium_constant_edge", 4, 1000000, 20);
    bench_audit_b5("reaction/equilibrium_constant_subnormal", 5, 1000000, 20);
    bench_audit_b5("solution/debye_huckel_limiting_edge", 6, 1000000, 20);
    bench_audit_b5("solution/debye_huckel_extended_edge", 7, 1000000, 20);
    bench_audit_b5("solution/debye_huckel_extended_overflow", 8, 1000000, 20);
    bench_audit_b5("solution/davies_activity_edge", 9, 1000000, 20);
    _bench_b6_setup();
    bench_audit_b6("spectroscopy/fft_spectrum_256_huge", 0, 100, 20);
    bench_audit_b6("spectroscopy/fft_spectrum_256_subnormal", 1, 100, 20);
    bench_audit_b6("spectroscopy/fft_spectrum_256_squares", 2, 1000, 20);
    bench_audit_b6("spectroscopy/find_peaks_1000_subnormal", 3, 10000, 20);
    bench_audit_b6("thermochem/adiabatic_flame_tiny", 4, 100000, 20);
    _bench_b7_setup();
    bench_audit_b7("stoichiometry/balance_survey_2x3", 0, 10000, 20);
    bench_audit_b7("stoichiometry/balance_overflow_10x9", 1, 1000, 20);
    bench_audit_b7("stoichiometry/balance_dense_30x31", 2, 1, 10);
    return 0;
}

var r = main();
sys_exit_group(r);
