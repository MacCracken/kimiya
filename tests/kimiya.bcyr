}

# molecule/molecular_weight_glucose: glucose built once outside the loop, as the Rust bench
# does, then `molecular_weight()` per call (3 element lookups, 3 multiply-adds).
fn bench_molecular_weight_glucose(per_batch, batches) {
    var glucose = KmMolecule_glucose();
    var b = bench_new("molecule/molecular_weight_glucose");
    var k = 0;
    while (k < batches) {
        bench_batch_start(b);
        var i = 0;
        while (i < per_batch) {
            var t, v = glucose.molecular_weight();
            _bench_sink = v;
            i = i + 1;
        }
        bench_batch_stop(b, per_batch);
        k = k + 1;
    }
    bench_report(b);
}

# The f64 input slot k.
#must_use
fn _bench_in(k): f64 {
    var x: f64 = load64(_bench_f + k * 8);
    return x;
}

