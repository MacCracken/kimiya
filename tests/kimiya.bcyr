# Cyrius-only (rust-old/benches has no other stoichiometry bench): stoichiometry/limiting_reagent ((3, 2) mol over
# (2, 1)), theoretical_yield_moles (the same, × 2), percent_yield (8 of 10), percent_composition_glucose,
# empirical_formula_glucose (40.00 / 6.71 / 53.29 %: CH₂O at k = 1).
fn bench_stoich_small(name, which, per_batch, batches) {
    var mo = _bench_st_f;
    var co = _bench_st_f + 16;
    var p: f64 = load64(_bench_st_f + 32);
    var a: f64 = load64(_bench_st_f + 40);
    var th: f64 = load64(_bench_st_f + 48);
    var mol: KmMolecule;
    mol.atoms = _bench_mol;
    var b = bench_new(name);
    var k = 0;
    while (k < batches) {
        bench_batch_start(b);
        var i = 0;
        while (i < per_batch) {
            if (which == 0) {
                var t0, v0 = limiting_reagent(mo, 2, co, 2);
                _bench_sink = v0;
            } elif (which == 1) {
                var t1, v1 = theoretical_yield_moles(mo, 2, co, 2, p);
                _bench_sink = v1;
            } elif (which == 2) {
                var t2, v2 = percent_yield(a, th);
                _bench_sink = v2;
            } elif (which == 3) {
                var t3, v3 = percent_composition(mol, _bench_st_out, 4);
                _bench_sink = v3;
            } else {
                var t4, v4 = empirical_formula(_bench_emp, 3, _bench_st_out, 4);
                _bench_sink = v4;
            }
            i = i + 1;
        }
        bench_batch_stop(b, per_batch);
        k = k + 1;
    }
    bench_report(b);
}

# Cyrius-only, ADR 0002 #24–#26's exact paths (M4f-2): stoichiometry/theoretical_yield_moles_tie (y·3/2 with
# 3y = 2⁵³ + 1, a midpoint: the fast path's exact midpoint resolution, _km_mul_div_tie), percent_yield_subnormal
# (100·3·2⁻¹⁰⁷⁴/200, a subnormal tie: the exact path, _km_mul_div_acc), limiting_reagent_tie ((1, 2) over (1, 2): equal
# rounded ratios, the exact comparison _km_ratio_lt), empirical_formula_edge (C 12.011 %, O 17.5989 %: the fast
# tolerance test undecided at k = 1, the exact one decides: CO).
fn bench_stoich_exact(name, which, per_batch, batches) {
    var x = _bench_st_x;
    var p: f64 = load64(x + 16);
    var a: f64 = load64(x + 24);
    var th: f64 = load64(x + 32);
    var b = bench_new(name);
    var k = 0;
    while (k < batches) {
        bench_batch_start(b);
        var i = 0;
        while (i < per_batch) {
            if (which == 0) {
                var t0, v0 = theoretical_yield_moles(x, 1, x + 8, 1, p);
                _bench_sink = v0;
            } elif (which == 1) {
                var t1, v1 = percent_yield(a, th);
                _bench_sink = v1;
            } elif (which == 2) {
                var t2, v2 = limiting_reagent(x + 40, 2, x + 56, 2);
                _bench_sink = v2;
            } else {
                var t3, v3 = empirical_formula(_bench_emp2, 2, _bench_st_out, 4);
                _bench_sink = v3;
            }
            i = i + 1;
        }
        bench_batch_stop(b, per_batch);
        k = k + 1;
    }
    bench_report(b);
}

# Cyrius-only, the overflow audit's B1 (ADR 0002 #27, #28): the colligative, calorimetry and kinetics functions without
# a Rust bench, on typical inputs, then on the edges that take each one's other paths. which: 0 specific_heat
# (4184 J, 1000 g, 1 K), 1 boiling_point_elevation (0.512, 1, 2), 2 freezing_point_depression (1.86, 0.5, 2),
# 3 osmotic_pressure (2, 0.1 M, 298.15 K), 4 second_order_concentration (1, 0.1, 10), 5 zero_order_half_life (1, 0.1),
# 6 steady_state_intermediate (0.1, 1, 10), 7 pre_equilibrium_rate (10, 2, 0.1, 1); the edges: 8 heat_transfer_tie
# (3·y·1 with 3y = 2⁵³ + 1, a midpoint), 9 osmotic_pressure_subnormal (5·10⁻³²⁴ M: a subnormal result),
# 10 second_order_concentration_edge (1, DBL_MAX, 10: k·t overflows), 11 michaelis_menten_edge (100, DBL_MAX, DBL_MAX:
# Vmax·[S] and Km + [S] overflow).
fn bench_audit_b1(name, which, per_batch, batches) {
    var x = _bench_b1;
    var a0: f64 = load64(x + 8 * (4 * which));
    var a1: f64 = load64(x + 8 * (4 * which + 1));
    var a2: f64 = load64(x + 8 * (4 * which + 2));
    var a3: f64 = load64(x + 8 * (4 * which + 3));
    var b = bench_new(name);
    var k = 0;
    while (k < batches) {
        bench_batch_start(b);
        var i = 0;
        while (i < per_batch) {
            if (which == 0) {
                var t0, v0 = specific_heat_from_calorimetry(a0, a1, a2);
                _bench_sink = v0;
            } elif (which == 1) {
                var r1: f64 = boiling_point_elevation(a0, a1, a2);
                _bench_sink = r1;
            } elif (which == 2) {
                var r2: f64 = freezing_point_depression(a0, a1, a2);
                _bench_sink = r2;
            } elif (which == 3 || which == 9) {
                var t3, v3 = osmotic_pressure(a0, a1, a2);
                _bench_sink = v3;
            } elif (which == 4 || which == 10) {
                var t4, v4 = second_order_concentration(a0, a1, a2);
                _bench_sink = v4;
            } elif (which == 5) {
                var t5, v5 = zero_order_half_life(a0, a1);
                _bench_sink = v5;
            } elif (which == 6) {
                var t6, v6 = steady_state_intermediate(a0, a1, a2);
                _bench_sink = v6;
            } elif (which == 7) {
                var t7, v7 = pre_equilibrium_rate(a0, a1, a2, a3);
                _bench_sink = v7;
            } elif (which == 8) {
                var r8: f64 = heat_transfer(a0, a1, a2);
                _bench_sink = r8;
            } else {
                var t11, v11 = michaelis_menten(a0, a1, a2);
                _bench_sink = v11;
            }
            i = i + 1;
        }
        bench_batch_stop(b, per_batch);
        k = k + 1;
    }
    bench_report(b);
}

# Cyrius-only, the overflow audit's B2 (ADR 0002 #29, #30): solution's, electrochemistry's and spectroscopy's functions
# without a Rust bench (nernst_potential and absorbance have theirs above), on typical inputs, then on the edges that
# take each one's other paths. Five words per bench, an electron count or J as its integer word. which: 0 dilution
# (2 M, 0.1 L, 0.5 L), 1 solution_conductivity (126.4 S·cm²/mol, 0.01 M), 2 faraday_mass_deposited (9648.5 C, Cu
# 63.546 g/mol, 2), 3 faraday_charge_required (1 g, 63.546, 2), 4 faraday_mass_ratio (1 g of Cu, 2 → Ag 107.868, 1),
# 5 concentration_from_absorbance (0.5, 100, 1 cm), 6 vibrational_frequency (HCl: 516 N/m, 1.6266·10⁻²⁷ kg),
# 7 rigid_rotor_energy (J = 2, B = 3.19·10¹¹ Hz), 8 rotational_constant (2.64·10⁻⁴⁷ kg·m²), 9 diatomic_moment_of_inertia
# (1.6266·10⁻²⁷ kg, 1.2746·10⁻¹⁰ m); the edges: 10 nernst_potential_edge (0.342, 2, DBL_MAX, 0.1: R·T overflows, the
# unbounded-exponent slow path), 11 vibrational_frequency_edge (500, 2⁻¹⁰²²: k/μ overflows in Rust; the √ fast path),
# 12 vibrational_frequency_subnormal (10⁻³⁰⁰, 5·10⁻³²⁴: a subnormal μ, the exact path), 13 faraday_mass_ratio_tie
# (y·3 with 3y = 2⁵³ + 1, a midpoint the 3/2 shape's test leaves to _km_mono_tie).
fn bench_audit_b2(name, which, per_batch, batches) {
    var x = _bench_b2 + 40 * which;
    var a0: f64 = load64(x);
    var a1: f64 = load64(x + 8);
    var a2: f64 = load64(x + 16);
    var a3: f64 = load64(x + 24);
    var w2 = load64(x + 16);
    var w4 = load64(x + 32);
    var b = bench_new(name);
    var k = 0;
    while (k < batches) {
        bench_batch_start(b);
        var i = 0;
        while (i < per_batch) {
            if (which == 0) {
                var t0, v0 = dilution(a0, a1, a2);
                _bench_sink = v0;
            } elif (which == 1) {
                var r1: f64 = solution_conductivity(a0, a1);
                _bench_sink = r1;
            } elif (which == 2) {
                var t2, v2 = faraday_mass_deposited(a0, a1, w2);
                _bench_sink = v2;
            } elif (which == 3) {
                var t3, v3 = faraday_charge_required(a0, a1, w2);
                _bench_sink = v3;
            } elif (which == 4 || which == 13) {
                var t4, v4 = faraday_mass_ratio(a0, a1, w2, a3, w4);
                _bench_sink = v4;
            } elif (which == 5) {
                var t5, v5 = concentration_from_absorbance(a0, a1, a2);
                _bench_sink = v5;
            } elif (which == 6 || which == 11 || which == 12) {
                var t6, v6 = vibrational_frequency(a0, a1);
                _bench_sink = v6;
            } elif (which == 7) {
                var r7: f64 = rigid_rotor_energy(load64(x), a1);
                _bench_sink = r7;
            } elif (which == 8) {
                var t8, v8 = rotational_constant(a0);
                _bench_sink = v8;
            } elif (which == 9) {
                var r9: f64 = diatomic_moment_of_inertia(a0, a1);
                _bench_sink = r9;
            } else {
                var t10, v10 = nernst_potential(a0, load64(x + 8), a2, a3);
                _bench_sink = v10;
            }
            i = i + 1;
        }
        bench_batch_stop(b, per_batch);
        k = k + 1;
    }
    bench_report(b);
}

# Cyrius-only, the overflow audit's B3 (ADR 0002 #31, #32): gas's, potential's, inorganic's and nuclear's functions
# without a Rust bench (ideal_gas_pressure, binding_energy_per_nucleon and lennard_jones have theirs above), on typical
# inputs, then on the edges that take each one's other paths. Six words per bench, a charge or a count as its integer
# word. which: 0 ideal_gas_volume (1 mol, 273.15 K, 101325 Pa), 1 gas_density (air at STP: 101325 Pa, 0.029 kg/mol,
# 273.15 K), 2 van_der_waals_pressure (CO₂: 1 mol, 300 K, 1 L, a = 0.364, b = 4.267·10⁻⁵), 3 peng_robinson_pressure
# (N₂ at 300 K, 0.025 m³/mol), 4 redlich_kwong_pressure (N₂'s Tc and Pc, 300 K, 0.025 m³/mol), 5 coulomb (e, −e at
# 1 Å), 6 coulomb_force (the same), 7 morse_width_parameter (HCl: 5.634·10¹⁴ rad/s, 1.6267·10⁻²⁷ kg, 7.399·10⁻¹⁹ J),
# 8 born_lande_lattice_energy (NaCl: 1.748, 1, 1, 2.82 Å, 8); the edges: 9 van_der_waals_pressure_edge (n = 10³⁰⁶:
# n·R·T overflows, the unbounded-exponent slow path), 10 peng_robinson_pressure_edge (Tc = 2⁻¹⁰²²: T/Tc overflows,
# Rust's NaN), 11 redlich_kwong_pressure_edge (Tc = 10¹³⁰: Tc^2.5 overflows, the exact rescale), 12
# lennard_jones_edge (ε = 10⁻³⁰⁰, σ/r = 5.8·10²⁵: (σ/r)¹² overflows), 13 morse_width_parameter_subnormal (1, 2⁻¹⁰⁷⁴,
# 2¹⁰²³: the exact root), 14 born_lande_lattice_energy_edge (DBL_MAX, 1, 1, DBL_MAX, DBL_MAX: the prefix overflows),
# 15 binding_energy_per_nucleon_edge (1000, 1000, DBL_MAX: Δm·931.494 overflows), 16 morse_width_parameter_tie
# (ω = y with 3y = 2⁵³ + 1, μ = 9, D_e = ½: a midpoint the fast test leaves to the exact root). Each runs 100,000 × 20
# calls, the size of this file's slow rows: at 1,000,000 × 20 the file passes `cyrius bench`'s default deadline of 300 s
# per bench file (it takes about 255 s without B3's rows).
fn bench_audit_b3(name, which, per_batch, batches) {
    var x = _bench_b3 + 48 * which;
    var a0: f64 = load64(x);
    var a1: f64 = load64(x + 8);
    var a2: f64 = load64(x + 16);
    var a3: f64 = load64(x + 24);
    var a4: f64 = load64(x + 32);
    var w0 = load64(x);
    var w1 = load64(x + 8);
    var w2 = load64(x + 16);
    var pr = KmPengRobinsonParams { tc: a0, pc: a1, omega: a2 };
    var b = bench_new(name);
    var k = 0;
    while (k < batches) {
        bench_batch_start(b);
        var i = 0;
        while (i < per_batch) {
            if (which == 0) {
                var t0, v0 = ideal_gas_volume(a0, a1, a2);
                _bench_sink = v0;
            } elif (which == 1) {
                var t1, v1 = gas_density(a0, a1, a2);
                _bench_sink = v1;
            } elif (which == 2 || which == 9) {
                var t2, v2 = van_der_waals_pressure(a0, a1, a2, a3, a4);
                _bench_sink = v2;
            } elif (which == 3 || which == 10) {
                var t3, v3 = peng_robinson_pressure(pr, a3, a4);
                _bench_sink = v3;
            } elif (which == 4 || which == 11) {
                var t4, v4 = redlich_kwong_pressure(a0, a1, a2, a3);
                _bench_sink = v4;
            } elif (which == 5) {
                var t5, v5 = coulomb(a0, a1, a2);
                _bench_sink = v5;
            } elif (which == 6) {
                var t6, v6 = coulomb_force(a0, a1, a2);
                _bench_sink = v6;
            } elif (which == 7 || which == 13 || which == 16) {
                var t7, v7 = morse_width_parameter(a0, a1, a2);
                _bench_sink = v7;
            } elif (which == 8 || which == 14) {
                var t8, v8 = born_lande_lattice_energy(a0, w1, w2, a3, a4);
                _bench_sink = v8;
            } elif (which == 12) {
                var t12, v12 = lennard_jones(a0, a1, a2);
                _bench_sink = v12;
            } else {
                var t15, v15 = binding_energy_per_nucleon(w0, w1, a2);
                _bench_sink = v15;
            }
            i = i + 1;
        }
        bench_batch_stop(b, per_batch);
        k = k + 1;
    }
    bench_report(b);
}

