# mathx/cr_<f> (M3c-2a, Cyrius-only; ADR 0006): the correctly rounded primitives on typical arguments, one
# call per iteration. cr_exp at the Arrhenius exponent −Ea/(RT) = −50000/(8.314·300) (Rust's
# kinetics/arrhenius_rate is one glibc exp and a few flops), cr_expm1 at (n − 1)·ln 2 for a second-order
# nth_order_half_life, cr_exp10 at −4.75 (10^-pKa), cr_ln at 0.1, cr_log10 at 1e-4 (ph_from_h's argument).
fn bench_cr(name, slot, fid, per_batch, batches) {
    var x: f64 = load64(_bench_m + slot * 8);
    var b = bench_new(name);
    var k = 0;
    while (k < batches) {
        bench_batch_start(b);
        var i = 0;
        if (fid == 0) { while (i < per_batch) { var r0: f64 = _km_cr_exp(x); _bench_sink = r0; i = i + 1; } }
        if (fid == 1) { while (i < per_batch) { var r1: f64 = _km_cr_expm1(x); _bench_sink = r1; i = i + 1; } }
        if (fid == 2) { while (i < per_batch) { var r2: f64 = _km_cr_exp10(x); _bench_sink = r2; i = i + 1; } }
        if (fid == 3) { while (i < per_batch) { var r3: f64 = _km_cr_ln(x); _bench_sink = r3; i = i + 1; } }
        if (fid == 4) { while (i < per_batch) { var r4: f64 = _km_cr_log10(x); _bench_sink = r4; i = i + 1; } }
        bench_batch_stop(b, per_batch);
        k = k + 1;
    }
    bench_report(b);
}

# mathx/cr_pow (M3c-2b, Cyrius-only; ADR 0006) beside ganita_f64_pow, what the M2/M3 modules called until M3c-3:
# pow(0.1, 1.5) and pow(1.409e-132, 2.451) (a result near the subnormal range).
fn bench_pow(name, sx, sy, fid, per_batch, batches) {
    var x: f64 = load64(_bench_m + sx * 8);
    var y: f64 = load64(_bench_m + sy * 8);
    var b = bench_new(name);
    var k = 0;
    while (k < batches) {
        bench_batch_start(b);
        var i = 0;
        if (fid == 0) { while (i < per_batch) { var r0: f64 = _km_cr_pow(x, y); _bench_sink = r0; i = i + 1; } }
        if (fid == 1) { while (i < per_batch) { var r1: f64 = ganita_f64_pow(x, y); _bench_sink = r1; i = i + 1; } }
        bench_batch_stop(b, per_batch);
        k = k + 1;
    }
    bench_report(b);
}

# mathx/cr_sin, cr_cos, cr_sincos, cr_atan2, cr_acos (M4a, Cyrius-only; ADR 0006) beside the stdlib's f64_sin /
# f64_cos (x87 on x86_64, the fdlibm polyfills on aarch64; not correctly rounded) and ganita_f64_atan2. sin and cos at
# 2π/3 + 0.1 (a Peng–Robinson angle), atan2 at (0.866, −0.5) (a 120° bond angle: |ba × bc|, ba·bc), acos at −0.35.
# (M4a also benched M2a's double-double _km_cos, 1.68 µs, and _km_acos, 5.8 µs, which gas.cyr called until M4d moved it
# to _km_cr_cos and _km_cr_acos and removed them.)
fn bench_trig(name, fid, per_batch, batches) {
    var x: f64 = load64(_bench_t);
    var ty: f64 = load64(_bench_t + 8);
    var tx: f64 = load64(_bench_t + 16);
    var c: f64 = load64(_bench_t + 24);
    var b = bench_new(name);
    var k = 0;
    while (k < batches) {
        bench_batch_start(b);
        var i = 0;
        if (fid == 0) { while (i < per_batch) { var r0: f64 = _km_cr_sin(x); _bench_sink = r0; i = i + 1; } }
        if (fid == 1) { while (i < per_batch) { var r1: f64 = f64_sin(x); _bench_sink = r1; i = i + 1; } }
        if (fid == 2) { while (i < per_batch) { var r2: f64 = _km_cr_cos(x); _bench_sink = r2; i = i + 1; } }
        if (fid == 3) { while (i < per_batch) { var r3: f64 = f64_cos(x); _bench_sink = r3; i = i + 1; } }
        if (fid == 5) {
            while (i < per_batch) {
                var s5, c5 = _km_cr_sincos(x);
                _bench_sink = s5;
                _bench_sink = c5;
                i = i + 1;
            }
        }
        if (fid == 6) { while (i < per_batch) { var r6: f64 = _km_cr_atan2(ty, tx); _bench_sink = r6; i = i + 1; } }
        if (fid == 7) { while (i < per_batch) { var r7: f64 = ganita_f64_atan2(ty, tx); _bench_sink = r7; i = i + 1; } }
        if (fid == 8) { while (i < per_batch) { var r8: f64 = _km_cr_acos(c); _bench_sink = r8; i = i + 1; } }
        bench_batch_stop(b, per_batch);
        k = k + 1;
    }
    bench_report(b);
}

# A species list of up to three records (formula, coefficient), on the heap.
#must_use
fn _bench_species(f1, c1: f64, f2, c2: f64, f3, c3: f64): i64 {
    var buf = alloc(48);
    store64(buf, f1);
    store64(buf + 8, c1);
    store64(buf + 16, f2);
    store64(buf + 24, c2);
    store64(buf + 32, f3);
    store64(buf + 40, c3);
    return buf;
}

