# M4e-3 (ADR 0002 #21, #22; Cyrius-only: rust-old/benches has none of these): the Rydberg family and the reduced mass,
# rounded once. spectroscopy/bohr_transition_energy and rydberg_wavelength (Z = 1, n = 2 → 3, Hα),
# series_wavelength_balmer_alpha (SpectralSeries::Balmer.wavelength(1)), reduced_mass_hcl (¹H and ³⁵Cl in u); the
# exact slow path on the exact ties: bohr_transition_energy_tie (Z = 255, n = 58,055 → 524,544) and reduced_mass_tie
# (2²⁷ − 1, 2²⁷ + 1).
fn bench_rydberg(name, fid, per_batch, batches) {
    var m1: f64 = load64(_bench_s + 40);
    var m2: f64 = load64(_bench_s + 48);
    var t1: f64 = load64(_bench_s + 56);
    var t2: f64 = load64(_bench_s + 64);
    var b = bench_new(name);
    var k = 0;
    while (k < batches) {
        bench_batch_start(b);
        var i = 0;
        if (fid == 0) {
            while (i < per_batch) {
                var t0, v0 = bohr_transition_energy(_bench_sz, _bench_sn3 - 1, _bench_sn3);
                _bench_sink = v0;
                i = i + 1;
            }
        }
        if (fid == 1) {
            while (i < per_batch) {
                var tr, vr = rydberg_wavelength(_bench_sz, _bench_sn3 - 1, _bench_sn3);
                _bench_sink = vr;
                i = i + 1;
            }
        }
        if (fid == 2) {
            while (i < per_batch) {
                var ts, vs = spectral_series_wavelength(KM_SPECTRAL_SERIES_BALMER, _bench_sz);
                _bench_sink = vs;
                i = i + 1;
            }
        }
        if (fid == 3) {
            while (i < per_batch) {
                var tm, vm = reduced_mass(m1, m2);
                _bench_sink = vm;
                i = i + 1;
            }
        }
        if (fid == 4) {
            while (i < per_batch) {
                var tt, vt = bohr_transition_energy(_bench_sz * 255, _bench_sn3 * 19352 - 1, _bench_sn3 * 174848);
                _bench_sink = vt;
                i = i + 1;
            }
        }
        if (fid == 5) {
            while (i < per_batch) {
                var tq, vq = reduced_mass(t1, t2);
                _bench_sink = vq;
                i = i + 1;
            }
        }
        bench_batch_stop(b, per_batch);
        k = k + 1;
    }
    bench_report(b);
}

