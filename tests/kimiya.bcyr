# Cyrius-only (rust-old/benches has no other potential bench): potential/bond_angle (water at metre scale),
# potential/lennard_jones (Ar at r_min), potential/lj_equilibrium_distance (ADR 0002 #16's correctly rounded σ·2^(1/6)),
# potential/morse (HCl at 1.1·r_e), and mathx/cr_exp2_scaled (ADR 0002 #13's N₀·2⁻ⁿ, 1000 after 1075.3 half-lives);
# potential/distance_3d (water's H–H distance in metres), and the slow path of ADR 0002 #20 (M4e-2):
# potential/distance_3d_2p600, bond_angle_2p600 and dihedral_angle_2p600, the same geometries scaled by 2⁶⁰⁰ (exact),
# whose squares overflow; potential/bond_angle_linear, CO₂ in metres on an axis (ba × bc exactly 0: #20's linear
# shortcut, not the slow path).
fn bench_potential(name, fid, per_batch, batches) {
    var e: f64 = load64(_bench_p);
    var s: f64 = load64(_bench_p + 8);
    var r: f64 = load64(_bench_p + 16);
    var a: f64 = load64(_bench_p + 24);
    var re: f64 = load64(_bench_p + 32);
    var nn: f64 = load64(_bench_p + 40);
    var b = bench_new(name);
    var k = 0;
    while (k < batches) {
        bench_batch_start(b);
        var i = 0;
        if (fid == 0) {
            while (i < per_batch) {
                var t0, v0 = bond_angle(_bench_pts + 96, _bench_pts + 120, _bench_pts + 144);
                _bench_sink = v0;
                i = i + 1;
            }
        }
        if (fid == 1) {
            while (i < per_batch) {
                var t1, v1 = lennard_jones(e, s, r);
                _bench_sink = v1;
                i = i + 1;
            }
        }
        if (fid == 2) {
            while (i < per_batch) {
                var v2: f64 = lj_equilibrium_distance(s);
                _bench_sink = v2;
                i = i + 1;
            }
        }
        if (fid == 3) {
            while (i < per_batch) {
                var t3, v3 = morse(e, a, re, r);
                _bench_sink = v3;
                i = i + 1;
            }
        }
        if (fid == 4) {
            while (i < per_batch) {
                var v4: f64 = _km_cr_exp2_scaled(e, nn);
                _bench_sink = v4;
                i = i + 1;
            }
        }
        if (fid == 5) {
            while (i < per_batch) {
                var v5: f64 = distance_3d(_bench_pts + 96, _bench_pts + 144);
                _bench_sink = v5;
                i = i + 1;
            }
        }
        if (fid == 6) {
            while (i < per_batch) {
                var v6: f64 = distance_3d(_bench_pts + 264, _bench_pts + 312);
                _bench_sink = v6;
                i = i + 1;
            }
        }
        if (fid == 7) {
            while (i < per_batch) {
                var t7, v7 = bond_angle(_bench_pts + 264, _bench_pts + 288, _bench_pts + 312);
                _bench_sink = v7;
                i = i + 1;
            }
        }
        if (fid == 8) {
            while (i < per_batch) {
                var t8, v8 = dihedral_angle(_bench_pts + 168, _bench_pts + 192, _bench_pts + 216, _bench_pts + 240);
                _bench_sink = v8;
                i = i + 1;
            }
        }
        if (fid == 9) {
            while (i < per_batch) {
                var t9, v9 = bond_angle(_bench_pts + 336, _bench_pts + 360, _bench_pts + 384);
                _bench_sink = v9;
                i = i + 1;
            }
        }
        bench_batch_stop(b, per_batch);
        k = k + 1;
    }
    bench_report(b);
}

