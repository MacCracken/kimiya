# A sink the timed loops write to, so their results are used.
var _bench_sink = 0;

# The inputs, read at run time (Rust black-boxes them). f64 inputs are stored as their bits and
# read back into typed locals, so no call sees a compile-time constant.
var _bench_fe = 0;
var _bench_z = 0;
var _bench_f = 0;   # 17 f64 input slots, filled by main()
var _bench_co2 = 0;     # "CO2(g)"
var _bench_products = 0;    # [("CO2(g)", 1), ("H2O(l)", 2)]: 2 species records
var _bench_reactants = 0;   # [("CH4(g)", 1), ("O2(g)", 2)]
var _bench_flame = 0;       # [("CO2(g)", 1), ("H2O(g)", 2), ("N2(g)", 7.52)]
var _bench_g = 0;           # M3a: 5 f64 input slots, filled by main()
var _bench_cu = 0;          # "Cu2+/Cu"
var _bench_n = 0;           # 2 electrons (Rust's black_box(2) u8)
var _bench_k = 0;           # M3b: 8 f64 input slots, filled by main()
var _bench_m = 0;           # M3c-2a / M3c-2b: 9 f64 input slots, filled by main()
var _bench_bonds_b = 0;     # M4b: [(CH, 4), (OODouble, 2)], 2 bond records (CH₄ + 2O₂ → CO₂ + 2H₂O)
var _bench_bonds_f = 0;     # [(CODouble, 2), (OH, 4)]
var _bench_sn = 0;          # "Sn"
var _bench_q = 0;           # 2 (Sn²⁺, the table's last row)
var _bench_nz = 0;          # M4c: 26 (Rust's black_box(26) u32)
var _bench_nn = 0;          # 30
var _bench_na = 0;          # 56
var _bench_nu = 0;          # 6 f64 input slots, filled by main()
var _bench_chain = 0;       # the decay chain's 24-byte out buffer
var _bench_t = 0;           # M4a: 4 f64 input slots, filled by main()
var _bench_pts = 0;         # M4d: the gauche dihedral's four points (12 f64), filled by main()
var _bench_p = 0;           # M4d: 6 f64 input slots, filled by main()
var _bench_s = 0;           # M4e: 5 f64 input slots, filled by main()
var _bench_sz = 0;          # 1 (Rust's black_box(1) u8)
var _bench_sn3 = 0;         # 3 (Rust's black_box(3) u32)
var _bench_glucose = 0;     # [(6, 6), (1, 12), (8, 6)]: 3 (z, count) records
var _bench_cystine = 0;     # M4e-4: [(6, 6), (1, 12), (7, 2), (8, 4), (16, 2)]: 5 records
var _bench_s8 = 0;          # [(16, 8)]: 1 record
var _bench_iso_out = 0;     # isotope_pattern's out buffer (64 records)
var _bench_sig = 0;         # fft_spectrum's signal (4096 f64) and find_peaks' data (1000 of them)
var _bench_spec = 0;        # fft_spectrum's out buffer (2 × 4096 f64: the in-place transform), find_peaks' indices
# M4f: CH₄ + 2O₂ → CO₂ + 2H₂O's 3 × 4 matrix (Rust's bench, as ADR 0002 #7's integers); 2KMnO₄ + 16HCl → …'s 5 × 6.
var _bench_ch4: i64[12] = { 1, 0, -1, 0, 4, 0, 0, -2, 0, 2, -2, -1 };
var _bench_kmno4m: i64[30] = { 1, 0, -1, 0, 0, 0, 1, 0, 0, -1, 0, 0, 4, 0, 0, 0, -1, 0, 0, 1, 0, 0, -2, 0, 0, 1, -1, -2,
    0, -2 };
var _bench_kmno4: i64[6] = { 19, 1, 25, 1, 8, 4 };     # KMnO₄: 3 (z, count) records
var _bench_fe3o4: i64[4] = { 26, 3, 8, 4 };            # Fe₃O₄: an average, ADR 0002 #7's rational path
var _bench_st_out = 0;      # the coefficients' / states' / records' out buffer (32 words)
var _bench_st_f = 0;        # 7 f64 input slots: moles (3, 2), coefficients (2, 1), the product's 2, the yields (8, 10)
var _bench_emp = 0;         # glucose's mass percents: [(6, 40.00), (1, 6.71), (8, 53.29)], 3 (z, f64) records
var _bench_mol = 0;         # glucose as a KmMolecule (its atoms vec)
var _bench_st_x = 0;        # ADR 0002 #24–#26's exact paths: 9 f64 slots (bench_stoich_exact)
var _bench_emp2 = 0;        # [(6, 12.011), (8, 17.5989)]: r − 1 within 1/(10·9·10¹⁵) of 1/10
var _bench_b1 = 0;          # the audit's B1 (ADR 0002 #27, #28): 12 × 4 f64 input slots (bench_audit_b1)
var _bench_b2 = 0;          # the audit's B2 (ADR 0002 #29, #30): 14 × 5 input words (bench_audit_b2)
var _bench_b3 = 0;          # the audit's B3 (ADR 0002 #31, #32): 17 × 6 input words (bench_audit_b3)

# element/lookup_by_symbol: `lookup_by_symbol(black_box("Fe"))`, a linear scan to row 26.
fn bench_lookup_by_symbol(per_batch, batches) {
    var b = bench_new("element/lookup_by_symbol");
    var k = 0;
    while (k < batches) {
        bench_batch_start(b);
        var i = 0;
        while (i < per_batch) { _bench_sink = element_lookup_by_symbol(_bench_fe); i = i + 1; }
        bench_batch_stop(b, per_batch);
        k = k + 1;
    }
    bench_report(b);
}

