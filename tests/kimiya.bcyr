# kimiya.bcyr — benchmarks, mirroring rust-old/benches/benchmarks.rs (criterion).
#
# A bench that has a Rust counterpart keeps its name and body, so the two numbers compare
# directly (docs/benchmarks-rust-v-cyrius.md). Each timed batch is a tight loop of `per_batch`
# calls, as criterion's `b.iter` loop is, so the per-op time is the call alone: one clock read
# costs ~1 µs on an HPET host, and lib/bench.cyr subtracts its measured floor. Inputs come from
# globals (Rust's `black_box`); results go to a sink, so every call is made and used. Port
# milestones append their benches.

include "src/error.cyr"
include "src/constants.cyr"
include "src/mathx_data.cyr"
include "src/mathx.cyr"
