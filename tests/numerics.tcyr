# numerics.tcyr — src/numerics.cyr, the hisab 1.4.0 routines kimiya transcribes (ADR 0003; M5a), against the Rust
# oracle: the golden rows of tests/golden/numerics.tsv (scripts/oracle/src/m_numerics.rs calls hisab 1.4.0 directly),
# replayed through tests/parity_core.cyr's machinery (tests/parity.tcyr skips this module), then Cyrius-only groups.
#
# The rows: `num::Pcg32::next_u32` (class A: hisab 3.4.1's pcg32_new / pcg32_next against 1.4.0's
# `Pcg32::new(seed, 1)`, bit for bit), `num::Pcg32::next_normal` (C: the Box–Muller draws, ln and cos correctly
# rounded), `num::rk4_trajectory` and `num::gaussian_elimination` (B), `num::dopri45` and `num::euler_maruyama` (C at
# bound 0). Systems are named by `s:` tokens (tests/rd_systems.cyr); a trajectory is replayed as `v:points` + each
# point's `f:t v:n f:y…`, the elimination's output as the solution `v:n f:…` then the eliminated matrix `v:n(n+1)
# f:…`, an error as hisab's variant (`E:ZeroSteps`, `E:InvalidInput`, `E:NoConvergence`, `E:SingularPivot`). The
# Cyrius-only groups cover what no oracle row reaches: work tables past the stack ones (the heap path), the trajectory
# capacity (points stored while k < cap, the final state in `fin`), the Neumaier compensation's two branches, and the
# scratch reuse that leaves an unwritten derivative at its previous value.

include "tests/ulp.cyr"
include "src/error.cyr"
include "src/constants.cyr"
include "src/mathx_data.cyr"
include "src/mathx.cyr"
include "src/validate.cyr"
include "src/numerics.cyr"

alloc_init();

include "tests/parity_core.cyr"
include "tests/rd_systems.cyr"
include "tests/rd_rows.cyr"

# `numerics` rows. Every other module is replayed by tests/parity.tcyr.
fn _par_numerics(fp, fl): i64 {
    if (_rd_alloc() != 1) { return 0 - 1; }
    var out = _rd_out;
    if (_par_eq(fp, fl, "num::Pcg32::next_u32") == 1 || _par_eq(fp, fl, "num::Pcg32::next_normal") == 1) {
        if (_par_in_n != 2) { return 0 - 1; }
        var rng = pcg32_new(_par_in(0));
        if (rng == 0) { return 0 - 1; }
        var count = _par_in(1);
        _par_got_seq(count);
        var normal = _par_eq(fp, fl, "num::Pcg32::next_normal");
        var k = 0;
        while (k < count) {
            if (normal == 1) {
                var z: f64 = _km_pcg32_next_normal(rng);
                _par_got_f(z);
            } else {
                _par_got_i(pcg32_next(rng));
            }
            k = k + 1;
        }
        return 1;
    }
    if (_par_eq(fp, fl, "num::rk4_trajectory") == 1) {
        var k1 = _rd_in_sys(0, _rd_p);
        if (k1 < 0) { return 0 - 1; }
        var f1 = _rd_rhs(_rd_name_p, _rd_name_l);
        if (f1 == 0 || k1 >= _par_in_n) { return 0 - 1; }
        var t0: f64 = _par_in(k1);
        k1 = _rd_in_vec(k1 + 1, _rd_y);
        if (k1 < 0 || k1 + 2 != _par_in_n) { return 0 - 1; }
        var n1 = _rd_vec_n;
        var te: f64 = _par_in(k1);
        var steps = _par_in(k1 + 1);
        if (steps >= _rd_cap(n1)) { return 0 - 1; }
        var r1, v1 = _km_rk4_trajectory(f1, _rd_p, t0, _rd_y, n1, te, steps, out, _rd_cap(n1), 0);
        _rd_got_traj(r1, v1, out, n1, 1);
        return 1;
    }
    if (_par_eq(fp, fl, "num::dopri45") == 1) {
        var k2 = _rd_in_sys(0, _rd_p);
        if (k2 < 0) { return 0 - 1; }
        var f2 = _rd_rhs(_rd_name_p, _rd_name_l);
        if (f2 == 0 || k2 >= _par_in_n) { return 0 - 1; }
        var t02: f64 = _par_in(k2);
        k2 = _rd_in_vec(k2 + 1, _rd_y);
        if (k2 < 0 || k2 + 3 != _par_in_n) { return 0 - 1; }
        var n2 = _rd_vec_n;
        var te2: f64 = _par_in(k2);
        var tol: f64 = _par_in(k2 + 1);
        var h: f64 = _par_in(k2 + 2);
        var r2, v2 = _km_dopri45(f2, _rd_p, t02, _rd_y, n2, te2, tol, h, out, _rd_cap(n2));
        if (is_ok(r2) == 1 && v2 > _rd_cap(n2)) { return 0 - 1; }
        _rd_got_traj(r2, v2, out, n2, 1);
        return 1;
    }
    if (_par_eq(fp, fl, "num::euler_maruyama") == 1) {
        var k3 = _rd_in_sys(0, _rd_p);
        if (k3 < 0) { return 0 - 1; }
        var f3 = _rd_rhs(_rd_name_p, _rd_name_l);
        k3 = _rd_in_sys(k3, _rd_q);
        if (k3 < 0) { return 0 - 1; }
        var g3 = _rd_diffusion(_rd_name_p, _rd_name_l);
        if (f3 == 0 || g3 == 0 || k3 >= _par_in_n) { return 0 - 1; }
        var t03: f64 = _par_in(k3);
        k3 = _rd_in_vec(k3 + 1, _rd_y);
        if (k3 < 0 || k3 + 3 != _par_in_n) { return 0 - 1; }
        var n3 = _rd_vec_n;
        var te3: f64 = _par_in(k3);
        var steps3 = _par_in(k3 + 1);
        if (steps3 >= _rd_cap(n3)) { return 0 - 1; }
        var rng3 = pcg32_new(_par_in(k3 + 2));
        if (rng3 == 0) { return 0 - 1; }
        var c3 = _rd_cap(n3);
        var r3, v3 = _km_euler_maruyama_system(f3, _rd_p, g3, _rd_q, t03, _rd_y, n3, te3, steps3, rng3, out, c3, 0);
        _rd_got_traj(r3, v3, out, n3, 1);
        return 1;
    }
    if (_par_eq(fp, fl, "num::gaussian_elimination") == 1) {
        if (_par_in_n < 1 || load64(_par_in_k) != 118) { return 0 - 1; }
        var n4 = _par_in(0);
        if (n4 < 0 || n4 * (n4 + 1) > _PAR_MAX) { return 0 - 1; }
        var at = 1;
        var row = 0;
        while (row < n4) {
            if (at >= _par_in_n || _par_in(at) != n4 + 1) { return 0 - 1; }
            var c = 0;
            while (c <= n4) {
                store64(_rd_mat + 8 * (row * (n4 + 1) + c), _par_in(at + 1 + c));
                c = c + 1;
            }
            at = at + n4 + 2;
            row = row + 1;
        }
        if (at != _par_in_n) { return 0 - 1; }
        var r4, v4 = _km_gaussian_elimination(_rd_mat, n4, _rd_x);
        if (is_err_result(r4) == 1) {
            _rd_got_herr(v4);
            return 1;
        }
        _par_got_seq(n4);
        var i = 0;
        while (i < n4) {
            _par_got_f(load64(_rd_x + 8 * i));
            i = i + 1;
        }
        _par_got_seq(n4 * (n4 + 1));
        i = 0;
        while (i < n4 * (n4 + 1)) {
            _par_got_f(load64(_rd_mat + 8 * i));
            i = i + 1;
        }
        return 1;
    }
    return 0;
}

# Routes a row to its dispatcher: only the numerics module's here.
fn _par_dispatch(mp, ml, fp, fl): i64 {
    _par_got_n = 0;
    _par_hist_on = 1;
    if (_par_eq(mp, ml, "numerics") == 1) { return _par_numerics(fp, fl); }
    return 0;
}

fn _par_shadows(mp, ml, fp, fl, cls) {
    return 0;
}

# The class-C rows: dopri45's err^(−0.2) and the Box–Muller ln and cos are correctly rounded (_km_cr_pow, _km_cr_ln,
# _km_cr_cos), so they are compared exactly against the corrected oracle (ADR 0006).
#must_use
fn _par_c_bound(fp, fl): i64 {
    if (_par_eq(fp, fl, "num::dopri45") == 1) { return 0; }
    if (_par_eq(fp, fl, "num::euler_maruyama") == 1) { return 0; }
    if (_par_eq(fp, fl, "num::Pcg32::next_normal") == 1) { return 0; }
    return 0 - 1;
}

