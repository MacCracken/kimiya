# kimiya.tcyr — smoke test of the published bundle, as a consumer sees it.
# Stdlib auto-included via cyrius.cyml
#
# It includes dist/kimiya.cyr (written by `cyrius distlib --all`; `cyrius distlib --check` proves it
# current), not src/, so the bundle compiles warning-free as one unit and its modules work
# together. The reference tests are tests/{error,validate,element,molecule,reaction,thermo,thermochem,
# phase,gas,solution,electrochemistry,kinetics,stoichiometry,organic,inorganic,potential,nuclear,spectroscopy,
# reaction_dynamics,network,fitting,sensitivity}.tcyr;
# the golden corpus is tests/parity.tcyr.

include "dist/kimiya.cyr"

# One call into each module of the bundle.
fn main() {
    alloc_init();
    test_group("bundle");
    assert(streq(km_error_name(KM_ERR_INVALID_ELEMENT), "InvalidElement"), "error");
    var r: f64 = KM_GAS_CONSTANT;
    assert(r > 8.3 && r < 8.4, "constants");
    var m: f64 = _km_max(1.0, 2.0);
    assert(m == 2.0, "mathx");
    assert_eq(_km_is_positive(1.0), 1, "validate");
    assert_eq(KM_ELEMENT_COUNT, 118, "element_data");
    assert_eq(element_lookup_by_symbol("Og"), 118, "element");
    var t, v = KmMolecule_glucose().formula();
    assert(is_ok(t) == 1 && str_eq_cstr(v, "C6H12O6") == 1, "molecule");
    var tg, vg = gibbs_free_energy(-100000.0, 298.0, -200.0);
    var g: f64 = vg;
    assert(is_ok(tg) == 1 && g == -40400.0, "reaction");
    var tc, vc = specific_heat_from_calorimetry(4184.0, 1000.0, 1.0);
    var c: f64 = vc;
    assert(is_ok(tc) == 1 && c == KM_WATER_SPECIFIC_HEAT, "thermo (hisab EPSILON_F64)");
    var pp: i64[6];
    store64(&pp, "CO2(g)");
    var one: f64 = 1.0;
    var two: f64 = 2.0;
    var n2: f64 = 7.52;
    store64(&pp + 8, one);
    store64(&pp + 16, "H2O(g)");
    store64(&pp + 24, two);
    store64(&pp + 32, "N2(g)");
    store64(&pp + 40, n2);
    var rr: i64[4];
    store64(&rr, "CH4(g)");
    store64(&rr + 8, one);
    store64(&rr + 16, "O2(g)");
    store64(&rr + 24, two);
    var th, vh = reaction_enthalpy(&pp, 2, &rr, 2);
    var dh: f64 = vh;
    assert(is_ok(th) == 1 && dh > -802400.0 && dh < -802300.0, "thermochem (J/mol, ADR 0002 #1)");
    var tf, vf = adiabatic_flame_temperature(dh, &pp, 3, 298.15);
    var tflame: f64 = vf;
    assert(is_ok(tf) == 1 && tflame > 2317.0 && tflame < 2337.0, "thermochem (flame, hisab EPSILON_F64)");
    var hs: f64 = shomate_data_coeffs(lookup_shomate("N2(g)")).t_min;
    assert(hs == 100.0 && KM_THERMOCHEM_COUNT == 76, "thermochem_data");
    var kb: f64 = KM_KB_WATER;
    assert(kb == 0.512 && KM_ANTOINE_COUNT == 8, "phase_data");
    var ta, va = antoine_pressure_mmhg(antoine_data_coeffs(lookup_antoine("water")), 100.0);
    var p: f64 = va;
    assert(is_ok(ta) == 1 && p > 750.0 && p < 770.0, "phase");
    var tcn: f64 = KM_PR_NITROGEN.tc;
    assert(tcn == 126.2, "gas_data");
    var tz, vz = peng_robinson_z(KM_PR_NITROGEN, 300.0, 1000000.0);
    var z: f64 = vz;
    assert(is_ok(tz) == 1 && z > 0.996 && z < 0.997, "gas");
    var tw, vw = weak_acid_ph(0.000018, 0.1);
    var ph: f64 = vw;
    assert(is_ok(tw) == 1 && ph > 2.875 && ph < 2.876, "solution (the charge-balance Newton)");
    var th2, vh2 = henderson_hasselbalch(4.75, 1.0, 0.1);
    var ph2: f64 = vh2;
    var kw: f64 = KM_KW_WATER_25C;
    assert(is_ok(th2) == 1 && ph2 == 5.75 && kw < 0.0000000000001, "solution (log10 over _km_ln; KW)");
    var he = lookup_half_reaction("Cu2+/Cu");
    var e0: f64 = half_reaction_standard_potential(he);
    assert(e0 == 0.342 && half_reaction_electrons(he) == 2, "electrochemistry_data");
    var tn, vn = nernst_potential_25c(0.342, 2, 0.01);
    var en: f64 = vn;
    assert(is_ok(tn) == 1 && en > 0.4011 && en < 0.4012, "electrochemistry (Nernst, _km_ln)");
    var tcell, vcell = cell_potential_from_couples("Cu2+/Cu", "Zn2+/Zn");
    var ecell: f64 = vcell;
    assert(is_ok(tcell) == 1 && ecell > 1.103 && ecell < 1.105, "electrochemistry (Daniell cell)");
    var tk, vk = arrhenius_rate(10000000000000.0, 100000.0, 300.0);
    var kr: f64 = vk;
    assert(is_ok(tk) == 1 && kr > 0.0000387965 && kr < 0.0000387966, "kinetics (Arrhenius, exp)");
    var tn2, vn2 = nth_order_half_life(2.0, 0.1, 3.0);
    var th3: f64 = vn2;
    assert(is_ok(tn2) == 1 && th3 > 3.7499999 && th3 < 3.7500001, "kinetics (nth order: exp_m1, pow)");
    var lb[16];
    var tl, vl = lineweaver_burk(100.0, 5.0, &lb);
    var slope: f64 = load64(&lb);
    assert(is_ok(tl) == 1 && vl == 2 && slope == 0.05, "kinetics (Lineweaver–Burk buffer)");
    var ch4: i64[12];
    ch4[0] = 1;
    ch4[1] = 0;
    ch4[2] = 0 - 1;
    ch4[3] = 0;
    ch4[4] = 4;
    ch4[5] = 0;
    ch4[6] = 0;
    ch4[7] = 0 - 2;
    ch4[8] = 0;
    ch4[9] = 2;
    ch4[10] = 0 - 2;
    ch4[11] = 0 - 1;
    var co: i64[4];
    var tbal, vbal = balance_equation(&ch4, 3, 4, &co, 4);
    assert(is_ok(tbal) == 1 && vbal == 4 && load64(&co + 8) == 2 && load64(&co + 24) == 2,
        "stoichiometry (CH4 + 2 O2 -> CO2 + 2 H2O, ADR 0002 #7's integer matrix)");
    var fe3o4: i64[4];
    fe3o4[0] = 26;
    fe3o4[1] = 3;
    fe3o4[2] = 8;
    fe3o4[3] = 4;
    var os: i64[6];
    var tox, vox = assign_oxidation_states(&fe3o4, 2, 0, &os, 2);
    assert(is_ok(tox) == 1 && vox == 2 && load64(&os + 8) == 8 && load64(&os + 16) == 3,
        "stoichiometry (Fe3O4: Fe +8/3, ADR 0002 #7's rational state)");
    var eo: f64 = bond_type_energy_kj(KM_BOND_TYPE_NN_TRIPLE);
    assert(eo == 945.0 && KM_GEOMETRY_T_SHAPED == 7, "organic_data (ADR 0002 #6: KM_GEOMETRY_T_SHAPED)");
    var bonds: i64[4];
    bonds[0] = KM_BOND_TYPE_HH;
    bonds[1] = 2;
    bonds[2] = KM_BOND_TYPE_OO_DOUBLE;
    bonds[3] = 1;
    var oh: i64[2];
    oh[0] = KM_BOND_TYPE_OH;
    oh[1] = 4;
    var dho: f64 = enthalpy_from_bonds(&bonds, 2, &oh, 1);
    var tg, vg2 = predict_geometry(3, 2);
    assert(dho == -482.0 && is_some(tg) == 1 && vg2 == KM_GEOMETRY_T_SHAPED, "organic (bond records, VSEPR)");
    var acc = functional_group_is_hydrogen_bond_acceptor(KM_FUNCTIONAL_GROUP_ETHER);
    var don = functional_group_is_hydrogen_bond_donor(KM_FUNCTIONAL_GROUP_ETHER);
    assert(acc == 1 && don == 0, "organic (ADR 0002 #6 donor / acceptor)");
    var md: f64 = KM_MADELUNG_NACL;
    assert(md == 1.747565 && KM_IONIC_RADII_COUNT == 30, "inorganic_data (the last pending constants)");
    var tb, vb = born_lande_lattice_energy(KM_MADELUNG_NACL, 1, 1, 0.000000000282, 8.0);
    var ub: f64 = vb;
    var tc5, vc5 = cfse_octahedral(6, 0);
    var c6: f64 = vc5;
    assert(is_ok(tb) == 1 && ub > -753900.0 && ub < -752900.0, "inorganic (Born–Landé)");
    assert(is_ok(tc5) == 1 && c6 == -2.4, "inorganic (CFSE, low-spin d⁶: exactly −2.4, ADR 0002 #12)");
    var rna: f64 = ionic_radius_radius_pm(lookup_ionic_radius("Na", 1));
    assert(rna == 102.0, "inorganic (ionic radii handle)");
    var hc14 = lookup_isotope("C-14");
    var tc14: f64 = isotope_half_life_s(hc14);
    assert(KM_ISOTOPES_COUNT == 18 && isotope_z(hc14) == 6 && tc14 == 179880000000.0, "nuclear_data (ISOTOPES handle)");
    assert(streq(isotope_decay_mode(lookup_isotope("K-40")), "β⁻/β⁺/EC") == 1, "nuclear_data (UTF-8 decay mode)");
    var tse, vse = semi_empirical_binding_energy(26, 56);
    var bse: f64 = vse;
    var tsx, vsx = semi_empirical_binding_energy(3, 2);
    assert(is_ok(tse) == 1 && bse > 493.0 && bse < 495.0, "nuclear (SEMF: cbrt, sqrt)");
    assert(is_err_result(tsx) == 1 && vsx == KM_ERR_INVALID_INPUT, "nuclear (SEMF z > a: Err, ADR 0002 #3)");
    var nabc[24];
    var tdc, vdc = decay_chain_two_step(1000.0, 0.1, 0.05, 10.0, &nabc);
    var nc: f64 = load64(&nabc + 16);
    assert(is_ok(tdc) == 1 && vdc == 3 && nc > 154.0 && nc < 156.0, "nuclear (decay chain buffer: exp, expm1)");
    var qr[16];
    var qp[16];
    var mdeu: f64 = 2.0141;
    var mt: f64 = 3.01605;
    var mhe: f64 = 4.0026;
    var mn: f64 = 1.00866;
    store64(&qr, mdeu);
    store64(&qr + 8, mt);
    store64(&qp, mhe);
    store64(&qp + 8, mn);
    var qv: f64 = q_value(&qr, 2, &qp, 2);
    assert(qv > 17.1 && qv < 18.1, "nuclear (q_value slices, thermo's _km_sum)");
    var tlj, vlj = lennard_jones(1.0, 1.0, 1.0);
    var vlv: f64 = vlj;
    assert(is_ok(tlj) == 1 && vlv == 0.0, "potential (Lennard-Jones at r = σ)");
    var rm: f64 = lj_equilibrium_distance(1.0);
    assert(_km_bits(rm) == 0x3FF1F59AC3C7D6C0, "potential (r_min = RN(2^(1/6)), ADR 0002 #16)");
    var gpts: f64[12];
    gpts[0] = 1.0;
    gpts[1] = 1.0;
    gpts[2] = 0.0;
    gpts[3] = 0.0;
    gpts[4] = 0.0;
    gpts[5] = 0.0;
    gpts[6] = 1.5;
    gpts[7] = 0.0;
    gpts[8] = 0.0;
    gpts[9] = 2.5;
    gpts[10] = 0.0;
    gpts[11] = 1.0;
    var tdh, vdh = dihedral_angle(&gpts, &gpts + 24, &gpts + 48, &gpts + 72);
    var dhv: f64 = vdh;
    assert(is_ok(tdh) == 1 && dhv > 1.5707963 && dhv < 1.5707964, "potential (gauche dihedral: atan2, +90°)");
    var tma, vma = morse(5.0, 1.0, 1.5, 3.0);
    var ma: f64 = vma;
    assert(is_ok(tma) == 1 && ma > 3.0 && ma < 3.05, "potential (Morse: exp, 5·(1 − e^−1.5)²)");
    var tha, vha = spectral_series_wavelength(KM_SPECTRAL_SERIES_BALMER, 1);
    var ha: f64 = vha;
    assert(is_ok(tha) == 1 && ha > 0.000000656 && ha < 0.000000657, "spectroscopy_data (series, R_H): Hα 656.47 nm");
    var twn, vwn = wavenumber_from_wavelength(17.0);
    assert(is_ok(twn) == 1 && vwn == 0x3F434679ACE01346, "spectroscopy (ADR 0002 #19: 1/(100x) correctly rounded)");
    var cl2: i64[2];
    cl2[0] = 17;
    cl2[1] = 2;
    var iso: f64[16];
    var tip, vip = isotope_pattern(&cl2, 1, &iso, 8);
    assert(is_ok(tip) == 1 && vip == 3, "spectroscopy (isotope pattern: Cl₂'s three peaks)");
    var sig: f64[8];
    sig[0] = 1.0;
    sig[1] = 0.0;
    sig[2] = 0.0;
    sig[3] = 0.0;
    var spec: f64[8];
    var tff, vff = fft_spectrum(&sig, 4, &spec, 8);
    var s0: f64 = spec[0];
    var s2: f64 = spec[2];
    assert(is_ok(tff) == 1 && vff == 3 && s0 == 1.0 && s2 == 1.0, "spectroscopy (FFT of an impulse: flat)");
    var trd, vrd = simulate_first_order(1.0, 0.1, 10.0, 10, 0, 0);
    assert(is_err_result(trd) == 1 && vrd == KM_ERR_INVALID_INPUT, "reaction_dynamics (no buffer for the 11 points)");
    var mab: f64[2];
    mab[0] = -1.0;
    mab[1] = 1.0;
    var trk, vrk = reaction_network_rank(&mab, 2, 1);
    assert(is_ok(trk) == 1 && vrk == 1, "network (the rank of A → B)");
    var px: f64[3];
    px[0] = 0.0;
    px[1] = 1.0;
    px[2] = 2.0;
    var pc: f64[2];
    var tpf, vpf = fit_polynomial(&px, 3, &px, 3, 1, &pc, 2);
    assert(is_ok(tpf) == 1 && vpf == 2, "fitting (y = x)");
    var gg: f64[3];
    var tgr, vgr = arrhenius_gradient(10000000000000.0, 80000.0, 300.0, &gg);
    var g0: f64 = gg[0];
    assert(is_ok(tgr) == 1 && vgr == 3 && g0 > 0.0, "sensitivity (the closed-form Arrhenius gradient)");
    return assert_summary();
}

var exit_code = main();
# Clamp before exiting: assert_summary() returns the raw failure COUNT, and a
# wait status is only 8 bits — an unclamped 256 / 512 / 768 failures would exit
# 0 and score PASS. Any failure at all is exit 1.
if (exit_code > 0) { exit_code = 1; }
sys_exit_group(exit_code);
