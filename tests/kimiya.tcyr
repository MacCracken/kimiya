# kimiya.tcyr — smoke test of the published bundle, as a consumer sees it.
# Stdlib auto-included via cyrius.cyml
#
# It includes dist/kimiya.cyr (written by `cyrius distlib --all`; `cyrius distlib --check` proves it
# current), not src/, so the bundle compiles warning-free as one unit and its modules work
# together. The reference tests are tests/{error,validate,element,molecule,reaction,thermo,thermochem,
# phase,gas,solution,electrochemistry,kinetics}.tcyr; the golden corpus is tests/parity.tcyr.

include "dist/kimiya.cyr"

# One call into each module of the bundle.
fn main() {
    alloc_init();
    test_group("bundle");
    assert(streq(km_error_name(KM_ERR_INVALID_ELEMENT), "InvalidElement"), "error");
    var r: f64 = KM_GAS_CONSTANT;
    assert(r > 8.3 && r < 8.4, "constants");
    var m: f64 = _km_max(1.0, 2.0);
    assert(m == 2.0, "mathx");
    assert_eq(_km_is_positive(1.0), 1, "validate");
    assert_eq(KM_ELEMENT_COUNT, 118, "element_data");
    assert_eq(element_lookup_by_symbol("Og"), 118, "element");
    var t, v = KmMolecule_glucose().formula();
    assert(is_ok(t) == 1 && str_eq_cstr(v, "C6H12O6") == 1, "molecule");
    var tg, vg = gibbs_free_energy(-100000.0, 298.0, -200.0);
    var g: f64 = vg;
    assert(is_ok(tg) == 1 && g == -40400.0, "reaction");
    var tc, vc = specific_heat_from_calorimetry(4184.0, 1000.0, 1.0);
    var c: f64 = vc;
    assert(is_ok(tc) == 1 && c == KM_WATER_SPECIFIC_HEAT, "thermo (hisab EPSILON_F64)");
    var pp: i64[6];
    store64(&pp, "CO2(g)");
    var one: f64 = 1.0;
    var two: f64 = 2.0;
    var n2: f64 = 7.52;
    store64(&pp + 8, one);
    store64(&pp + 16, "H2O(g)");
    store64(&pp + 24, two);
    store64(&pp + 32, "N2(g)");
    store64(&pp + 40, n2);
    var rr: i64[4];
    store64(&rr, "CH4(g)");
    store64(&rr + 8, one);
    store64(&rr + 16, "O2(g)");
    store64(&rr + 24, two);
    var th, vh = reaction_enthalpy(&pp, 2, &rr, 2);
    var dh: f64 = vh;
    assert(is_ok(th) == 1 && dh > -802400.0 && dh < -802300.0, "thermochem (J/mol, ADR 0002 #1)");
    var tf, vf = adiabatic_flame_temperature(dh, &pp, 3, 298.15);
    var tflame: f64 = vf;
    assert(is_ok(tf) == 1 && tflame > 2317.0 && tflame < 2337.0, "thermochem (flame, hisab EPSILON_F64)");
    var hs: f64 = shomate_data_coeffs(lookup_shomate("N2(g)")).t_min;
    assert(hs == 100.0 && KM_THERMOCHEM_COUNT == 76, "thermochem_data");
    var kb: f64 = KM_KB_WATER;
    assert(kb == 0.512 && KM_ANTOINE_COUNT == 8, "phase_data");
    var ta, va = antoine_pressure_mmhg(antoine_data_coeffs(lookup_antoine("water")), 100.0);
    var p: f64 = va;
    assert(is_ok(ta) == 1 && p > 750.0 && p < 770.0, "phase");
    var tcn: f64 = KM_PR_NITROGEN.tc;
    assert(tcn == 126.2, "gas_data");
    var tz, vz = peng_robinson_z(KM_PR_NITROGEN, 300.0, 1000000.0);
    var z: f64 = vz;
    assert(is_ok(tz) == 1 && z > 0.996 && z < 0.997, "gas");
    var tw, vw = weak_acid_ph(0.000018, 0.1);
    var ph: f64 = vw;
    assert(is_ok(tw) == 1 && ph > 2.875 && ph < 2.876, "solution (the charge-balance Newton)");
    var th2, vh2 = henderson_hasselbalch(4.75, 1.0, 0.1);
    var ph2: f64 = vh2;
    var kw: f64 = KM_KW_WATER_25C;
    assert(is_ok(th2) == 1 && ph2 == 5.75 && kw < 0.0000000000001, "solution (log10 over _km_ln; KW)");
    var he = lookup_half_reaction("Cu2+/Cu");
    var e0: f64 = half_reaction_standard_potential(he);
    assert(e0 == 0.342 && half_reaction_electrons(he) == 2, "electrochemistry_data");
    var tn, vn = nernst_potential_25c(0.342, 2, 0.01);
    var en: f64 = vn;
    assert(is_ok(tn) == 1 && en > 0.4011 && en < 0.4012, "electrochemistry (Nernst, _km_ln)");
    var tcell, vcell = cell_potential_from_couples("Cu2+/Cu", "Zn2+/Zn");
    var ecell: f64 = vcell;
    assert(is_ok(tcell) == 1 && ecell > 1.103 && ecell < 1.105, "electrochemistry (Daniell cell)");
    var tk, vk = arrhenius_rate(10000000000000.0, 100000.0, 300.0);
    var kr: f64 = vk;
    assert(is_ok(tk) == 1 && kr > 0.0000387965 && kr < 0.0000387966, "kinetics (Arrhenius, exp)");
    var tn2, vn2 = nth_order_half_life(2.0, 0.1, 3.0);
    var th3: f64 = vn2;
    assert(is_ok(tn2) == 1 && th3 > 3.7499999 && th3 < 3.7500001, "kinetics (nth order: exp_m1, pow)");
    var lb[16];
    var tl, vl = lineweaver_burk(100.0, 5.0, &lb);
    var slope: f64 = load64(&lb);
    assert(is_ok(tl) == 1 && vl == 2 && slope == 0.05, "kinetics (Lineweaver–Burk buffer)");
    return assert_summary();
}

var exit_code = main();
# Clamp before exiting: assert_summary() returns the raw failure COUNT, and a
# wait status is only 8 bits — an unclamped 256 / 512 / 768 failures would exit
# 0 and score PASS. Any failure at all is exit 1.
if (exit_code > 0) { exit_code = 1; }
sys_exit_group(exit_code);
