fn _t_gas_density_air_at_stp() {
    test_group("gas_density_air_at_stp");
    var t, v = gas_density(KM_STP_PRESSURE, 0.029, KM_STP_TEMPERATURE);
    # 101325 × 0.029 / (8.314462618 × 273.15) = 1.293 86 kg/m³
    var rho: f64 = okf(t, v);
    assert(near(rho, 1.29386, 0.0001), "air density at STP should be ~1.294");
}

fn _t_gas_density_rejects_nan() {
    test_group("gas_density_rejects_nan");
    var nan: f64 = _km_nan();
    var t1, v1 = gas_density(nan, 0.029, 300.0);
    assert_eq(is_err_result(t1), 1, "NaN P");
    var t2, v2 = gas_density(101325.0, nan, 300.0);
    assert_eq(is_err_result(t2), 1, "NaN M");
    var t3, v3 = gas_density(101325.0, 0.029, nan);
    assert_eq(is_err_result(t3), 1, "NaN T");
    var t4, v4 = gas_density(-1.0, 0.029, 300.0);
    assert_eq(is_err_result(t4), 1, "negative P");
}

fn _t_stp_pressure_is_one_atm() {
