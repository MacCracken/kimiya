fn _t_pr_rejects_nan_state() {
    test_group("pr_rejects_nan_state");
    var nan: f64 = _km_nan();
    var inf: f64 = 1.0 / 0.0;
    var roots[24];
    var t1, v1 = peng_robinson_z(KM_PR_NITROGEN, nan, 101325.0);
    assert_eq(is_err_result(t1), 1, "Z: NaN T");
    var t2, v2 = peng_robinson_z(KM_PR_NITROGEN, 300.0, nan);
    assert_eq(is_err_result(t2), 1, "Z: NaN P");
    var t3, v3 = peng_robinson_z(KM_PR_NITROGEN, 300.0, inf);
    assert_eq(is_err_result(t3), 1, "Z: inf P");
    var t4, v4 = peng_robinson_z_roots(KM_PR_NITROGEN, 300.0, -1.0, &roots);
    assert_eq(is_err_result(t4), 1, "roots: negative P");
    var t5, v5 = peng_robinson_pressure(KM_PR_NITROGEN, nan, 0.025);
    assert_eq(is_err_result(t5), 1, "P: NaN T");
    var t6, v6 = peng_robinson_pressure(KM_PR_NITROGEN, 300.0, nan);
    assert_eq(is_err_result(t6), 1, "P: NaN V");
    var t7, v7 = peng_robinson_pressure(KM_PR_NITROGEN, 300.0, inf);
    assert_eq(is_err_result(t7), 1, "P: inf V");
    var t8, v8 = fugacity_coefficient_pr(KM_PR_NITROGEN, nan, 100000.0);
    assert_eq(is_err_result(t8), 1, "phi: NaN T");
}

# One case of pr_rejects_bad_critical_constants: all four PR functions refuse `p`.
fn rejects_all(p: KmPengRobinsonParams) {
    var roots[24];
    var t1, v1 = peng_robinson_z(p, 300.0, 100000.0);
    assert_eq(is_err_result(t1), 1, "Z");
    var t2, v2 = peng_robinson_z_roots(p, 300.0, 100000.0, &roots);
    assert_eq(is_err_result(t2), 1, "roots");
    var t3, v3 = peng_robinson_pressure(p, 300.0, 0.025);
    assert_eq(is_err_result(t3), 1, "P");
    var t4, v4 = fugacity_coefficient_pr(p, 300.0, 100000.0);
    assert_eq(is_err_result(t4), 1, "phi");
}

fn _t_pr_rejects_bad_critical_constants() {
    test_group("pr_rejects_bad_critical_constants");
    var nan: f64 = _km_nan();
    var inf: f64 = 1.0 / 0.0;
    rejects_all(with_field(KM_PR_NITROGEN, 0, 0.0));
    rejects_all(with_field(KM_PR_NITROGEN, 0, nan));
    rejects_all(with_field(KM_PR_NITROGEN, 1, -1.0));
    rejects_all(with_field(KM_PR_NITROGEN, 1, inf));
    rejects_all(with_field(KM_PR_NITROGEN, 2, nan));
}

fn _t_fugacity_coefficient_ideal_at_low_p() {
    test_group("fugacity_coefficient_ideal_at_low_p");
    # At low pressure, φ → 1
    var t, v = fugacity_coefficient_pr(KM_PR_NITROGEN, 300.0, 1000.0);
    var phi: f64 = okf(t, v);
    assert(near(phi, 1.0, 0.0001), "phi at low P should be ~1.0");
}

fn _t_fugacity_equals_pressure_at_low_p() {
    test_group("fugacity_equals_pressure_at_low_p");
    var t, v = fugacity_pr(KM_PR_NITROGEN, 300.0, 1000.0);
    var f: f64 = okf(t, v);
    assert(near(f, 1000.0, 0.1), "fugacity should ~ P at low P");
}

# One case of fugacity_finite_positive_at_high_pressure.
fn fugacity_case(p: KmPengRobinsonParams, tk: f64, pk: f64, want: f64) {
    var t, v = fugacity_coefficient_pr(p, tk, pk);
    var phi: f64 = okf(t, v);
    assert(_km_is_finite(phi) == 1 && phi > 0.0, "finite and positive");
    assert(near(phi, want, 0.000001), "reference phi");
    var tf, vf = fugacity_pr(p, tk, pk);
    var f: f64 = okf(tf, vf);
    var d: f64 = f64_abs(f - (phi * pk));
    assert(d <= (0.000000001 * f), "f = phi P");
}

fn _t_fugacity_finite_positive_at_high_pressure() {
    test_group("fugacity_finite_positive_at_high_pressure");
    # Used to be Ok(NaN): ln(Z − B) of the negative root. Reference φ from the physical root:
    # 1.418 438, 1.529 092, 1.755 352.
    fugacity_case(KM_PR_NITROGEN, 300.0, 90000000.0, 1.4184383);
    fugacity_case(KM_PR_NITROGEN, 300.0, 100000000.0, 1.5290917);
    fugacity_case(KM_PR_METHANE, 1000.0, 200000000.0, 1.7553522);
}

fn _t_fugacity_water_vapor_root() {
    test_group("fugacity_water_vapor_root");
    # φ at the vapor root of water, 300 K / 1 atm: 0.984 806.
    var t, v = fugacity_coefficient_pr(KM_PR_WATER, 300.0, 101325.0);
    var phi: f64 = okf(t, v);
    assert(near(phi, 0.984806, 0.00001), "0.984806");
}

fn _t_joule_thomson_ideal_is_zero() {
    test_group("joule_thomson_ideal_is_zero");
    var j: f64 = joule_thomson_ideal();
    assert(near(j, 0.0, 0.0000000000000002220446049250313), "0 K/Pa");
}

fn _t_rk_approaches_ideal_at_high_v() {
    test_group("rk_approaches_ideal_at_high_v");
    # N₂: Tc=126.2, Pc=3394000
    var t1, v1 = ideal_gas_pressure(1.0, 300.0, 1.0);
    var t2, v2 = redlich_kwong_pressure(126.2, 3394000.0, 300.0, 1.0);
    var pi: f64 = okf(t1, v1);
    var pr: f64 = okf(t2, v2);
    var rel: f64 = f64_abs(pr - pi) / pi;
    assert(rel < 0.0001, "RK should approach ideal at large V");
}

fn _t_rk_zero_temp_is_error() {
    test_group("rk_zero_temp_is_error");
    var t, v = redlich_kwong_pressure(126.2, 3394000.0, 0.0, 0.025);
    assert_eq(is_err_result(t), 1, "T = 0");
}

fn _t_rk_rejects_nan_inputs() {
    test_group("rk_rejects_nan_inputs");
    var nan: f64 = _km_nan();
    var inf: f64 = 1.0 / 0.0;
    var t1, v1 = redlich_kwong_pressure(126.2, 3394000.0, nan, 0.025);
    assert_eq(is_err_result(t1), 1, "NaN T");
    var t2, v2 = redlich_kwong_pressure(nan, 3394000.0, 300.0, 0.025);
    assert_eq(is_err_result(t2), 1, "NaN Tc");
    var t3, v3 = redlich_kwong_pressure(126.2, nan, 300.0, 0.025);
    assert_eq(is_err_result(t3), 1, "NaN Pc");
    var t4, v4 = redlich_kwong_pressure(126.2, 0.0, 300.0, 0.025);
    assert_eq(is_err_result(t4), 1, "Pc = 0");
    var t5, v5 = redlich_kwong_pressure(126.2, 3394000.0, 300.0, nan);
    assert_eq(is_err_result(t5), 1, "NaN V");
    var t6, v6 = redlich_kwong_pressure(126.2, 3394000.0, 300.0, inf);
    assert_eq(is_err_result(t6), 1, "inf V");
}

# Cyrius-only: the presets are Rust's values; a struct passes by value (the callee's copy);
# peng_robinson_z_roots writes only its n roots and reports n in Ok; each guard's error code, in
# Rust's order (T, P, then the critical constants); overflow is ComputationError.
fn _t_cyrius_presets_and_roots() {
    test_group("cyrius_presets_and_roots");
    var w: KmPengRobinsonParams = KM_PR_WATER;
    var wtc: f64 = w.tc;
    var wpc: f64 = w.pc;
    var wom: f64 = w.omega;
    assert(wtc == 647.1 && wpc == 22064000.0 && wom == 0.3443, "PR_WATER");
    var n2: KmPengRobinsonParams = KM_PR_NITROGEN;
    var bad = with_field(n2, 0, -1.0);
    var ntc: f64 = KM_PR_NITROGEN.tc;
    assert(ntc == 126.2, "with_field copied, the preset is unchanged");
    var roots[24];
    store64(&roots + 16, 0x7FF8000000000001);
    var t, n = peng_robinson_z_roots(KM_PR_NITROGEN, 300.0, 1000000.0, &roots);
    assert(is_ok(t) == 1 && n == 1, "one root at 300 K, 1 MPa");
    assert_eq(load64(&roots + 16), 0x7FF8000000000001, "slot 2 untouched");
    var nan: f64 = _km_nan();
    var t1, v1 = peng_robinson_z(bad, nan, -1.0);
    assert(is_err_code(t1, v1, KM_ERR_INVALID_TEMPERATURE), "T first");
    var t2, v2 = peng_robinson_z(bad, 300.0, -1.0);
    assert(is_err_code(t2, v2, KM_ERR_INVALID_INPUT), "then P");
    var t3, v3 = peng_robinson_z(bad, 300.0, 100000.0);
    assert(is_err_code(t3, v3, KM_ERR_INVALID_TEMPERATURE), "then Tc");
    var pcbad = with_field(n2, 1, 0.0);
    var t4, v4 = peng_robinson_pressure(pcbad, 300.0, 0.025);
    assert(is_err_code(t4, v4, KM_ERR_INVALID_INPUT), "Pc = 0 is InvalidInput");
    var huge: f64 = 0x7FEFFFFFFFFFFFFF;
    var t5, v5 = peng_robinson_z(KM_PR_NITROGEN, 300.0, huge);
    assert(is_err_code(t5, v5, KM_ERR_COMPUTATION_ERROR), "P = DBL_MAX overflows: ComputationError");
}

# Cyrius-only, ADR 0005 and ADR 0006: the gas functions' acos, cos, ln and x^2.5 (_km_acos, _km_cos, _km_cr_ln
# and, since M3c-3, _km_cr_pow(x, 2.5) for Redlich–Kwong's Tc^2.5) are correctly rounded. At these arguments glibc
# 2.44 (the oracle) is 1 ulp off the correctly rounded value (MPFR, scripts/oracle/mpfr_ref.py); the port returns
# the correctly rounded bits. Plus the special values each mirrors from Rust.
fn _t_cyrius_correctly_rounded_primitives() {
    test_group("cyrius_correctly_rounded_primitives");
    var a: f64 = 0.9063776739144427;
    var ra: f64 = _km_acos(a);
    assert_bits_eq(ra, 0x3FDBEA28A544ED43, "acos(0.9063776739144427)");
    var c: f64 = 2.3734367101827383;
    var rc: f64 = _km_cos(c);
    assert_bits_eq(rc, 0xBFE703A1604251B1, "cos(2.3734367101827383)");
    var l: f64 = 1.7602758701689474;
    var rl: f64 = _km_cr_ln(l);
    assert_bits_eq(rl, 0x3FE21855AD272D79, "ln(1.7602758701689474)");
    var p: f64 = 443.38094864525084;
    var rp: f64 = _km_cr_pow(p, 2.5);
    assert_bits_eq(rp, 0x414F94DCA9F5C8F0, "443.38094864525084^2.5");
    var one: f64 = 1.0;
    var m1: f64 = -1.0;
    var r1: f64 = _km_acos(one);
    assert_bits_eq(r1, 0, "acos(1) = +0");
    var r2: f64 = _km_acos(m1);
    assert_bits_eq(r2, 0x400921FB54442D18, "acos(-1) = pi");
    var two: f64 = 2.0;
    var r3: f64 = _km_acos(two);
    assert_eq(ulp_is_nan(r3), 1, "acos(2) = NaN");
    var zero: f64 = 0.0;
    var r4: f64 = _km_cos(zero);
    assert_bits_eq(r4, 0x3FF0000000000000, "cos(0) = 1");
    var inf: f64 = 1.0 / 0.0;
    var r5: f64 = _km_cos(inf);
    assert_eq(ulp_is_nan(r5), 1, "cos(inf) = NaN");
    var r6: f64 = _km_cr_ln(one);
    assert_bits_eq(r6, 0, "ln(1) = +0");
    var r7: f64 = _km_cr_ln(zero);
    assert_bits_eq(r7, 0xFFF0000000000000, "ln(0) = -inf");
    var r8: f64 = _km_cr_ln(m1);
    assert_eq(ulp_is_nan(r8), 1, "ln(-1) = NaN");
    var sub: f64 = from_bits(1);   # the smallest subnormal, 5e-324
    var r9: f64 = _km_cr_ln(sub);
    assert_bits_eq(r9, 0xC0874385446D71C3, "ln(5e-324) = -744.44007192138126");
    var four: f64 = 4.0;
    var r10: f64 = _km_cr_pow(four, 2.5);
    assert_bits_eq(r10, 0x4040000000000000, "4^2.5 = 32");
    var r11: f64 = _km_cr_pow(m1, 2.5);
    assert_eq(ulp_is_nan(r11), 1, "(-1)^2.5 = NaN");
    var big: f64 = 0x7FEFFFFFFFFFFFFF;
    var r12: f64 = _km_cr_pow(big, 2.5);
    assert_bits_eq(r12, 0x7FF0000000000000, "DBL_MAX^2.5 = +inf");
}

# Runs every test group; returns the failure count from assert_summary().
fn main() {
    _t_ideal_gas_stp_volume();
    _t_ideal_gas_roundtrip();
    _t_van_der_waals_approaches_ideal();
    _t_van_der_waals_co2_value();
    _t_van_der_waals_rejects_bad_temperature();
    _t_van_der_waals_rejects_nan_inputs();
    _t_partial_pressure_basic();
    _t_gas_density_air_at_stp();
    _t_gas_density_rejects_nan();
    _t_stp_pressure_is_one_atm();
    _t_zero_volume_is_error();
    _t_zero_pressure_is_error();
    _t_zero_temp_density_is_error();
    _t_negative_temp_pressure_is_error();
    _t_negative_temp_volume_is_error();
    _t_van_der_waals_volume_too_small_is_error();
    _t_nan_inputs_are_rejected();
    _t_pr_z_ideal_at_low_pressure();
    _t_pr_z_nitrogen_at_stp();
    _t_pr_z_nitrogen_1mpa();
    _t_pr_z_high_pressure_takes_physical_root();
    _t_pr_z_consistent_with_pr_pressure();
    _t_pr_z_roots_water_three_roots();
    _t_pr_z_roots_co2_subcritical_three_roots();
    _t_pr_z_near_critical_point();
    _t_cubic_double_and_triple_roots();
    _t_pr_pressure_positive();
    _t_pr_approaches_ideal_at_high_v();
    _t_pr_zero_temp_is_error();
    _t_pr_rejects_nan_state();
    _t_pr_rejects_bad_critical_constants();
    _t_fugacity_coefficient_ideal_at_low_p();
    _t_fugacity_equals_pressure_at_low_p();
    _t_fugacity_finite_positive_at_high_pressure();
    _t_fugacity_water_vapor_root();
    _t_joule_thomson_ideal_is_zero();
    _t_rk_approaches_ideal_at_high_v();
    _t_rk_zero_temp_is_error();
    _t_rk_rejects_nan_inputs();
    _t_cyrius_presets_and_roots();
    _t_cyrius_correctly_rounded_primitives();
    return assert_summary();
}

var exit_code = main();
if (exit_code > 0) { exit_code = 1; }
sys_exit_group(exit_code);
