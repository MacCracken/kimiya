fn _t_nan_inputs_are_rejected() {
    test_group("nan_inputs_are_rejected");
    var nan: f64 = _km_nan();
    var inf: f64 = 1.0 / 0.0;
    var t1, v1 = ideal_gas_pressure(nan, 300.0, 0.025);
    assert_eq(is_err_result(t1), 1, "P: NaN n");
    var t2, v2 = ideal_gas_pressure(1.0, nan, 0.025);
    assert_eq(is_err_result(t2), 1, "P: NaN T");
    var t3, v3 = ideal_gas_pressure(1.0, 300.0, nan);
    assert_eq(is_err_result(t3), 1, "P: NaN V");
    var t4, v4 = ideal_gas_pressure(1.0, inf, 0.025);
    assert_eq(is_err_result(t4), 1, "P: inf T");
    var t5, v5 = ideal_gas_volume(nan, 300.0, 101325.0);
    assert_eq(is_err_result(t5), 1, "V: NaN n");
    var t6, v6 = ideal_gas_volume(1.0, nan, 101325.0);
    assert_eq(is_err_result(t6), 1, "V: NaN T");
    var t7, v7 = ideal_gas_volume(1.0, 300.0, nan);
    assert_eq(is_err_result(t7), 1, "V: NaN P");
    var t8, v8 = ideal_gas_volume(1.0, 300.0, inf);
    assert_eq(is_err_result(t8), 1, "V: inf P");
}

fn _t_pr_z_ideal_at_low_pressure() {
    test_group("pr_z_ideal_at_low_pressure");
    # At very low pressure, Z → 1 (ideal gas behavior)
    var t, v = peng_robinson_z(KM_PR_NITROGEN, 300.0, 1000.0);
    var z: f64 = okf(t, v);
    assert(near(z, 1.0, 0.0001), "Z at low P should approach 1.0");
}

fn _t_pr_z_nitrogen_at_stp() {
    test_group("pr_z_nitrogen_at_stp");
    # N₂ at 273.15 K / 1 atm: PR gives Z = 0.999 230 (reference: numpy.roots on the same cubic).
    var t, v = peng_robinson_z(KM_PR_NITROGEN, 273.15, 101325.0);
    var z: f64 = okf(t, v);
    assert(near(z, 0.99923019, 0.0000001), "N2 Z at STP should be 0.99923");
}

fn _t_pr_z_nitrogen_1mpa() {
    test_group("pr_z_nitrogen_1mpa");
    # Benchmark case. Reference root: 0.996 007 28.
    var t, v = peng_robinson_z(KM_PR_NITROGEN, 300.0, 1000000.0);
    var z: f64 = okf(t, v);
    assert(near(z, 0.99600728, 0.0000001), "0.99600728");
}

# One case of pr_z_high_pressure_takes_physical_root.
fn high_pressure_case(p: KmPengRobinsonParams, tk: f64, pk: f64, want: f64) {
    var t, v = peng_robinson_z(p, tk, pk);
    var z: f64 = okf(t, v);
    assert(near(z, want, 0.0000001), "expected Z");
    var roots[24];
    var tr, n = peng_robinson_z_roots(p, tk, pk, &roots);
    assert(is_ok(tr) == 1 && n == 1, "only one root has Z > B");
    var res: f64 = pr_residual(p, tk, pk, z);
    var ares: f64 = f64_abs(res);
    assert(ares < 0.000000000001, "residual < 1e-12");
}

fn _t_pr_z_high_pressure_takes_physical_root() {
    test_group("pr_z_high_pressure_takes_physical_root");
    # Newton from Z = 1 used to converge to the negative roots (−1.65, −1.87, −1.49). Reference
    # physical roots from numpy.roots.
    high_pressure_case(KM_PR_NITROGEN, 300.0, 90000000.0, 1.66363553);
    high_pressure_case(KM_PR_NITROGEN, 300.0, 100000000.0, 1.76408716);
    high_pressure_case(KM_PR_METHANE, 1000.0, 200000000.0, 1.60490783);
}

# One case of pr_z_consistent_with_pr_pressure: every root's V = ZRT/P gives P back.
fn consistent_case(p: KmPengRobinsonParams, tk: f64, pk: f64) {
    var roots[24];
    var t, n = peng_robinson_z_roots(p, tk, pk, &roots);
    assert_eq(is_ok(t), 1, "roots Ok");
    var j = 0;
    while (j < n) {
        var z: f64 = load64(&roots + j * 8);
        var vm: f64 = ((z * KM_GAS_CONSTANT) * tk) / pk;
        var tb, vb = peng_robinson_pressure(p, tk, vm);
        var back: f64 = okf(tb, vb);
        var rel: f64 = f64_abs((back - pk) / pk);
        assert(rel < 0.00000001, "P(V) = P");
        j = j + 1;
    }
}

fn _t_pr_z_consistent_with_pr_pressure() {
    test_group("pr_z_consistent_with_pr_pressure");
    # V = ZRT/P fed back into the explicit PR pressure must give P back.
    consistent_case(KM_PR_NITROGEN, 300.0, 1000000.0);
    consistent_case(KM_PR_NITROGEN, 300.0, 90000000.0);
    consistent_case(KM_PR_METHANE, 1000.0, 200000000.0);
    consistent_case(KM_PR_CO2, 304.1, 7375000.0);
    consistent_case(KM_PR_WATER, 300.0, 101325.0);
    consistent_case(KM_PR_OXYGEN, 200.0, 10000000.0);
}

fn _t_pr_z_roots_water_three_roots() {
    test_group("pr_z_roots_water_three_roots");
    # Water at 300 K / 1 atm: liquid 0.000 863 44, unstable 0.013 783 68, vapor 0.984 582 22
    # (numpy.roots).
    var roots[24];
    var t, n = peng_robinson_z_roots(KM_PR_WATER, 300.0, 101325.0, &roots);
    assert(is_ok(t) == 1 && n == 3, "three roots");
    var ex: f64[3];
    ex[0] = 0.0008634408;
    ex[1] = 0.013783678;
    ex[2] = 0.984582222;
    var k = 0;
    while (k < 3) {
        var z: f64 = load64(&roots + k * 8);
        var e: f64 = ex[k];
        var rel: f64 = f64_abs((z - e) / e);
        assert(rel < 0.0000001, "root within 1e-7");
        k = k + 1;
    }
    var z0: f64 = load64(&roots);
    var z1: f64 = load64(&roots + 8);
    var z2: f64 = load64(&roots + 16);
    assert(z0 < z1 && z1 < z2, "ascending");
    var tz, vz = peng_robinson_z(KM_PR_WATER, 300.0, 101325.0);
    var z: f64 = okf(tz, vz);
    var e2: f64 = ex[2];
    assert(near(z, e2, 0.00000001), "vapor root returned");
}

fn _t_pr_z_roots_co2_subcritical_three_roots() {
    test_group("pr_z_roots_co2_subcritical_three_roots");
    # CO₂ at 280 K / 4 MPa: 0.089 225 14, 0.202 907 08, 0.662 039 25.
    var roots[24];
    var t, n = peng_robinson_z_roots(KM_PR_CO2, 280.0, 4000000.0, &roots);
    assert(is_ok(t) == 1 && n == 3, "three roots");
    var ex: f64[3];
    ex[0] = 0.08922514;
    ex[1] = 0.20290708;
    ex[2] = 0.66203925;
    var k = 0;
    while (k < 3) {
        var z: f64 = load64(&roots + k * 8);
        var e: f64 = ex[k];
        assert(near(z, e, 0.0000001), "root within 1e-7");
        k = k + 1;
    }
}

fn _t_pr_z_near_critical_point() {
    test_group("pr_z_near_critical_point");
    # At (Tc, Pc) the cubic is nearly a triple root (A = 0.45724, B = 0.0778); the solver must
    # still return a valid root.
    var p: KmPengRobinsonParams = KM_PR_CO2;
    var tc: f64 = p.tc;
    var pc: f64 = p.pc;
    var t, v = peng_robinson_z(p, tc, pc);
    var z: f64 = okf(t, v);
    assert(near(z, 0.32137903, 0.000001), "Z = 0.32138");
    var res: f64 = pr_residual(p, tc, pc, z);
    var ares: f64 = f64_abs(res);
    assert(ares < 0.00000000000001, "residual < 1e-14");
}

fn _t_cubic_double_and_triple_roots() {
    test_group("cubic_double_and_triple_roots");
    var r[24];
    # (z − 1)²(z − 2) = z³ − 4z² + 5z − 2
    var n = _km_cubic_real_roots(-4.0, 5.0, -2.0, &r);
    assert_eq(n, 3, "three roots");
    var r0: f64 = load64(&r);
    var r1: f64 = load64(&r + 8);
    var r2: f64 = load64(&r + 16);
    assert(near(r0, 1.0, 0.0000001) && near(r1, 1.0, 0.0000001), "double root 1");
    assert(near(r2, 2.0, 0.000000000001), "root 2");
    # (z − 0.5)³ = z³ − 1.5z² + 0.75z − 0.125
    var m = _km_cubic_real_roots(-1.5, 0.75, -0.125, &r);
    assert(m >= 1, "at least one root");
    var k = 0;
    while (k < m) {
        var z: f64 = load64(&r + k * 8);
        assert(near(z, 0.5, 0.00001), "triple root 0.5");
        k = k + 1;
    }
    # z³ + z = 0 → single real root 0
    var o = _km_cubic_real_roots(0.0, 1.0, 0.0, &r);
    assert_eq(o, 1, "one root");
    var z0: f64 = load64(&r);
    var az: f64 = f64_abs(z0);
    assert(az < 0.000000000000001, "root 0");
}

fn _t_pr_pressure_positive() {
    test_group("pr_pressure_positive");
    # V = 0.025 m³/mol at 300K for N₂
    var t, v = peng_robinson_pressure(KM_PR_NITROGEN, 300.0, 0.025);
    var p: f64 = okf(t, v);
    assert(p > 0.0, "pressure should be positive");
}

fn _t_pr_approaches_ideal_at_high_v() {
    test_group("pr_approaches_ideal_at_high_v");
    # At very large molar volume, PR should approach ideal gas
    var t1, v1 = ideal_gas_pressure(1.0, 300.0, 1.0);   # 1 m³/mol — very dilute
    var t2, v2 = peng_robinson_pressure(KM_PR_NITROGEN, 300.0, 1.0);
    var pi: f64 = okf(t1, v1);
    var pp: f64 = okf(t2, v2);
    var rel: f64 = f64_abs(pp - pi) / pi;
    assert(rel < 0.0001, "PR should approach ideal at large V");
}

fn _t_pr_zero_temp_is_error() {
    test_group("pr_zero_temp_is_error");
    var t1, v1 = peng_robinson_z(KM_PR_NITROGEN, 0.0, 101325.0);
    assert_eq(is_err_result(t1), 1, "Z at T = 0");
    var t2, v2 = peng_robinson_pressure(KM_PR_NITROGEN, 0.0, 0.025);
    assert_eq(is_err_result(t2), 1, "P at T = 0");
