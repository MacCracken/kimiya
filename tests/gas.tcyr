# gas.tcyr — the tests of rust-old/src/gas.rs, ported one for one (each test_group is the Rust test's
# name), plus Cyrius-only tests of the roots buffer and presets and of the correctly rounded
# primitives the Peng–Robinson and Redlich–Kwong functions use (ADR 0005). Rust's private
# cubic_real_roots and pr_dimensionless are _km_cubic_real_roots and _km_pr_dimensionless here
# (one namespace). peng_robinson_z_roots fills a caller's buffer of three f64 and returns Ok(n). The
# golden corpus separately checks every function over its grid (tests/parity.tcyr).

include "tests/ulp.cyr"
include "src/error.cyr"
include "src/constants.cyr"
include "src/mathx_data.cyr"
include "src/mathx.cyr"
include "src/validate.cyr"
include "src/gas_data.cyr"
include "src/gas.cyr"

alloc_init();

# 1 if |a - b| < eps.
#must_use
fn near(a: f64, b: f64, eps: f64): i64 {
    var d: f64 = f64_abs(a - b);
    if (d < eps) { return 1; }
    return 0;
}

# 1 if the Result (t, v) is Err(code).
#must_use
fn is_err_code(t, v, code): i64 {
    if (is_err_result(t) == 1 && v == code) { return 1; }
    return 0;
}

# A copy of `p` with field k (0 tc, 1 pc, 2 omega) set to x (Rust's `{ field: x, ..p }`).
#must_use
fn with_field(p: KmPengRobinsonParams, k, x: f64): KmPengRobinsonParams {
    var q: KmPengRobinsonParams = p;
    if (k == 0) { q.tc = x; }
    if (k == 1) { q.pc = x; }
    if (k == 2) { q.omega = x; }
    return q;
}

# The residual of the PR cubic at Z, for checking roots (the Rust test helper pr_residual).
#must_use
fn pr_residual(params: KmPengRobinsonParams, t: f64, p: f64, z: f64): f64 {
    var e, a, b = _km_pr_dimensionless(params, t, p);
    var z3: f64 = (z * z) * z;
    var t2: f64 = ((1.0 - b) * z) * z;
    var t1: f64 = ((a - ((3.0 * b) * b)) - (2.0 * b)) * z;
    var t0: f64 = ((a * b) - (b * b)) - ((b * b) * b);
    var r: f64 = ((z3 - t2) + t1) - t0;
    return r;
}

# The f64 with bit pattern b (for a pattern the compiler would read as an integer literal).
#must_use
fn from_bits(b): f64 {
    var x: f64 = 0.0;
    store64(&x, b);
    return x;
}

# The Ok f64 payload of a Result, NaN for Err.
#must_use
fn okf(t, v): f64 {
    if (is_ok(t) != 1) { return _km_nan(); }
    var x: f64 = v;
    return x;
}

fn _t_ideal_gas_stp_volume() {
    test_group("ideal_gas_stp_volume");
    var t, v = ideal_gas_volume(1.0, KM_STP_TEMPERATURE, KM_STP_PRESSURE);
    var vl: f64 = okf(t, v) * 1000.0;
    # 1 mol at 273.15 K / 101 325 Pa = 22.413 97 L (CODATA molar volume).
    assert(near(vl, 22.413969, 0.00001), "1 mol at STP should be 22.414 L");
}

fn _t_ideal_gas_roundtrip() {
    test_group("ideal_gas_roundtrip");
    var t1, v1 = ideal_gas_pressure(2.0, 300.0, 0.05);
    var p: f64 = okf(t1, v1);
    var t2, v2 = ideal_gas_volume(2.0, 300.0, p);
    var v: f64 = okf(t2, v2);
    assert(near(v, 0.05, 0.0000000001), "roundtrip should recover volume");
}

fn _t_van_der_waals_approaches_ideal() {
    test_group("van_der_waals_approaches_ideal");
    var t1, v1 = ideal_gas_pressure(1.0, 300.0, 0.025);
    var t2, v2 = van_der_waals_pressure(1.0, 300.0, 0.025, 0.0, 0.0);
    var pi: f64 = okf(t1, v1);
    var pv: f64 = okf(t2, v2);
    assert(near(pi, pv, 0.000000001), "a=0 b=0 should match ideal gas");
}

fn _t_van_der_waals_co2_value() {
    test_group("van_der_waals_co2_value");
    # CO₂: a = 0.3640 Pa·m⁶/mol², b = 4.267e-5 m³/mol, 1 mol in 1 L at 300 K.
    # P = RT/(V−b) − a/V² = 2494.34/9.5733e-4 − 0.364/1e-6 = 2.2416 MPa.
    var t, v = van_der_waals_pressure(1.0, 300.0, 0.001, 0.3640, 0.00004267);
    var p: f64 = okf(t, v);
    var expected: f64 = ((KM_GAS_CONSTANT * 300.0) / (0.001 - 0.00004267)) - (0.3640 / (0.001 * 0.001));
    assert(near(p, expected, 0.000001), "the formula");
    assert(near(p, 2241600.0, 1000.0), "2.2416 MPa");
}

fn _t_van_der_waals_rejects_bad_temperature() {
    test_group("van_der_waals_rejects_bad_temperature");
    var ts: f64[4];
    ts[0] = 0.0;
    ts[1] = -10.0;
    ts[2] = _km_nan();
    ts[3] = 1.0 / 0.0;
    var k = 0;
    while (k < 4) {
        var x: f64 = ts[k];
        var t, v = van_der_waals_pressure(1.0, x, 0.025, 0.1, 0.00001);
        assert(is_err_code(t, v, KM_ERR_INVALID_TEMPERATURE), "T should be rejected");
        k = k + 1;
    }
}

fn _t_van_der_waals_rejects_nan_inputs() {
    test_group("van_der_waals_rejects_nan_inputs");
    var nan: f64 = _km_nan();
    var t1, v1 = van_der_waals_pressure(nan, 300.0, 0.025, 0.1, 0.00001);
    assert_eq(is_err_result(t1), 1, "NaN n");
    var t2, v2 = van_der_waals_pressure(1.0, 300.0, nan, 0.1, 0.00001);
    assert_eq(is_err_result(t2), 1, "NaN V");
    var t3, v3 = van_der_waals_pressure(1.0, 300.0, 0.025, nan, 0.00001);
    assert_eq(is_err_result(t3), 1, "NaN a");
    var t4, v4 = van_der_waals_pressure(1.0, 300.0, 0.025, 0.1, nan);
    assert_eq(is_err_result(t4), 1, "NaN b");
    var t5, v5 = van_der_waals_pressure(1.0, 300.0, 0.025, -0.1, 0.00001);
    assert_eq(is_err_result(t5), 1, "negative a");
}

