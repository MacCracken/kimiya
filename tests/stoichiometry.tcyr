# stoichiometry.tcyr — the tests of rust-old/src/stoichiometry.rs, ported one for one (each test_group is the Rust
# test's name; all 63, in Rust's order; rust-old/tests/integration.rs has none for this module), plus Cyrius-only tests
# of ADR 0002 #7 (the exact rational oxidation states and their i32 range, the integer matrix and its 2⁵³ bound), the
# checked i64 and signed 128-bit helpers at their edges, Rust's integer types as words, the caller buffers and slices,
# the work tables' heap path, and since M4f-2 ADR 0002 #24–#26 (the yields and percent composition rounded once, the
# exact limiting reagent, the exact empirical formula: cyrius_adr24_rounded_once, cyrius_adr25_exact_comparison,
# cyrius_adr26_exact_tolerance, which replaced M4f's cyrius_empirical_tolerance on Rust's 0.1), and since the overflow
# audit's B7 ADR 0002 #39 (balancing on unbounded integers where Rust's i64 overflows). The golden corpus separately
# checks every function over its grid (tests/parity.tcyr).
#
# ADR 0002 #24–#26 adapt no Rust test: every assertion holds for the exact values (empirical_formula_nan_inf_are_errors'
# subnormal case is still the ComputationError, its exact ratio about 3.75·10³²⁰ being past 2³²; only its comment says
# so). ADR 0002 #39 (the overflow audit's B7: balancing on unbounded integers) adapts none either: the matrices of
# balance_intermediate_overflow_is_error and balance_large_entries_do_not_panic overflow Rust's i64, and their exact
# null vectors exceed u32 (x = [1, 1, 2⁵³] for the first), so both are still the ComputationError; only the comments say
# why, as cyrius_integer_matrix's for its gcd-2⁶³ row (now a zero coefficient). Its own groups are
# cyrius_adr39_unbounded_integers, cyrius_adr39_size_and_forced and cyrius_adr39_multiword.
#
# Adapted beyond the port's form (port plan §6.4: `Result::unwrap` is `is_ok` + the payload, a slice a pointer and a
# count, a Vec result the caller's buffer), for ADR 0002 #7, seven tests:
# - balance_non_integer_entry_is_error: 1.5, NaN and ∞ have no integer counterpart (the corpus counts those rows);
#   the test asserts Err(InvalidInput) for the integers Rust's 2⁵³ bound refuses (1e300's counterpart is beyond i64:
#   i64::MAX and i64::MIN stand in for it).
# - balance_near_integer_entry_accepted: 2 + 10⁻¹² and −1 − 10⁻¹² are the integers 2 and −1 Rust rounds them to.
# - oxidation_state_superoxide_is_error, oxidation_state_propane_non_integer_is_error and
#   oxidation_state_magnetite_non_integer_is_error assert Ok with the exact averages (KO₂'s O −1/2, C₃H₈'s C −8/3,
#   Fe₃O₄'s Fe +8/3, ADR 0002 #7's reference tests) where Rust asserted Err; oxidation_state_single_element's O₂⁻ is
#   −1/2, and oxidation_state_huge_count_does_not_panic's (O, u32::MAX)×2 at i32::MIN is −2³⁰/(2³² − 1).

include "src/error.cyr"
include "src/constants.cyr"
include "src/mathx_data.cyr"
include "src/mathx.cyr"
include "src/validate.cyr"
include "src/element_data.cyr"
include "src/element.cyr"
include "src/molecule.cyr"
include "src/stoichiometry.cyr"

alloc_init();

# f64::EPSILON.
#must_use
fn eps64(): f64 {
    var e: f64 = 0.0000000000000002220446049250313;
    return e;
}

# |x|.
#must_use
fn absf(x: f64): f64 {
    var a: f64 = f64_abs(x);
    return a;
}

# ── balancing helpers ───────────────────────────────────────────────────────────────

var _bal_out: i64[128];

# balance_equation(mat, m, n).unwrap(): the coefficients at the returned buffer.
#must_use
fn bal(mat, m, n): i64 {
    var t, v = balance_equation(mat, m, n, &_bal_out, 128);
    assert(is_ok(t) == 1 && v == n, "balance_equation: Ok(n)");
    return &_bal_out;
}

# The Err code of balance_equation(mat, m, n), or -1 when it is Ok.
#must_use
fn bal_err(mat, m, n): i64 {
    var out[1024];
    var t, v = balance_equation(mat, m, n, &out, 128);
    if (is_err_result(t) == 1) { return v; }
    return 0 - 1;
}

# 1 if the n coefficients at c equal the n words at want.
#must_use
fn same_words(c, want, n): i64 {
    var k = 0;
    while (k < n) {
        if (load64(c + 8 * k) != load64(want + 8 * k)) { return 0; }
        k = k + 1;
    }
    return 1;
}

# 1 if every row of the m × n matrix times the n coefficients at x is 0 (Rust's `residuals`, exactly in integers:
# every corpus test's entries are small).
#must_use
fn residuals_zero(mat, m, n, x): i64 {
    var i = 0;
    while (i < m) {
        var s = 0;
        var j = 0;
        while (j < n) {
            s = s + load64(mat + 8 * (i * n + j)) * load64(x + 8 * j);
            j = j + 1;
        }
        if (s != 0) { return 0; }
        i = i + 1;
    }
    return 1;
}

