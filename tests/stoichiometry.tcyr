# ── oxidation-state helpers ─────────────────────────────────────────────────────────

var _ox_out: i64[96];

# assign_oxidation_states(atoms, n, charge).unwrap(): the (Z, numerator, denominator) records at _ox_out.
fn ox(atoms, n, charge) {
    var t, v = assign_oxidation_states(atoms, n, charge, &_ox_out, 32);
    assert(is_ok(t) == 1 && v == n, "assign_oxidation_states: Ok(n)");
}

# 1 if assign_oxidation_states(atoms, n, charge) is an Err (its code in *code when code is not 0).
#must_use
fn ox_err(atoms, n, charge): i64 {
    var out[768];
    var t, v = assign_oxidation_states(atoms, n, charge, &out, 32);
    if (is_err_result(t) == 1) { return 1; }
    return 0;
}

# The Err code of assign_oxidation_states, or -1 when it is Ok.
#must_use
fn ox_code(atoms, n, charge): i64 {
    var out[768];
    var t, v = assign_oxidation_states(atoms, n, charge, &out, 32);
    if (is_err_result(t) == 1) { return v; }
    return 0 - 1;
}

# 1 if record k of the last ox() is (z, num, den).
#must_use
fn ox_is(k, z, num, den): i64 {
    var rec = &_ox_out + 24 * k;
    if (load64(rec) == z && load64(rec + 8) == num && load64(rec + 16) == den) { return 1; }
    return 0;
}

# The state of element z in the last ox() as an integer (Rust's `os_of`): asserts its denominator is 1.
#must_use
fn os_of(n, z): i64 {
    var k = 0;
    while (k < n) {
        var rec = &_ox_out + 24 * k;
        if (load64(rec) == z) {
            assert(load64(rec + 16) == 1, "os_of: an integer state");
            return load64(rec + 8);
        }
        k = k + 1;
    }
    assert(0 == 1, "os_of: element present");
    return 0;
}

