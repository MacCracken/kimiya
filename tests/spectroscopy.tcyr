    var n = peaks_of(&_t_data_basic, 8, 0.1, out);
    assert(contains(out, n, 2) == 1, "peak at 2 (3.0)");
    assert(contains(out, n, 5) == 1, "peak at 5 (2.0)");
}

fn _t_find_peaks_threshold_filters() {
    test_group("find_peaks_threshold_filters");
    var out = buf(8);
    var n = peaks_of(&_t_data_filter, 8, 0.5, out);
    assert(contains(out, n, 2) == 1, "3.0 > 1.5");
    assert(contains(out, n, 5) == 0, "0.6 < 1.5");
}

fn _t_find_peaks_empty() {
    test_group("find_peaks_empty");
    var out = buf(4);
    assert(peaks_of(&_t_data_two, 2, 0.1, out) == 0, "two points");
    assert(peaks_of(&_t_data_two, 0, 0.1, out) == 0, "no points");
}

fn _t_find_peaks_all_negative() {
    test_group("find_peaks_all_negative");
    var out = buf(7);
    var n = peaks_of(&_t_data_neg, 7, 0.5, out);
    assert(n == 1 && load64(out) == 2, "[2]: −4 < −5 + 0.5·4");
    var m = peaks_of(&_t_data_neg, 7, 0.0, out);
    assert(m == 2 && load64(out) == 2 && load64(out + 8) == 5, "[2, 5]");
}

fn _t_find_peaks_threshold_relative_to_range() {
    test_group("find_peaks_threshold_relative_to_range");
    var out = buf(5);
    var n = peaks_of(&_t_data_offset, 5, 0.5, out);
    assert(n == 1 && load64(out) == 3, "[3]: 10.2 < 10.5");
}

fn _t_find_peaks_invalid_threshold_is_empty() {
    test_group("find_peaks_invalid_threshold_is_empty");
    var out = buf(5);
    var inf: f64 = _KM_INF;
    assert(peaks_of(&_t_data_small, 5, _km_nan(), out) == 0, "NaN");
    assert(peaks_of(&_t_data_small, 5, -0.1, out) == 0, "−0.1");
    assert(peaks_of(&_t_data_small, 5, 1.5, out) == 0, "1.5");
    assert(peaks_of(&_t_data_small, 5, inf, out) == 0, "∞");
    assert(peaks_of(&_t_data_small, 5, 1.0, out) == 0, "1.0: nothing exceeds max");
}

fn _t_find_peaks_ignores_non_finite() {
    test_group("find_peaks_ignores_non_finite");
    var d = buf(7);
    put(d, 0, 0.0);
    put(d, 1, _km_nan());
    put(d, 2, 0.0);
    put(d, 3, 2.0);
    put(d, 4, 0.0);
    put(d, 5, 1.0);
    put(d, 6, 0.0);
    var out = buf(7);
    var n = peaks_of(d, 7, 0.25, out);
    assert(n == 2 && load64(out) == 3 && load64(out + 8) == 5, "[3, 5]");
    var nans = buf(4);
    var k = 0;
    while (k < 4) { put(nans, k, _km_nan()); k = k + 1; }
    assert(peaks_of(nans, 4, 0.5, out) == 0, "all NaN");
}

