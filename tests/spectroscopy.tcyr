# ── Cyrius-only ──

# Rust's integers as words: never wrapped (port plan §6.4).
fn _t_cyrius_out_of_type() {
    test_group("cyrius: u8 / u32 arguments outside their types");
    var t1, v1 = bohr_energy_level(256, 1);
    assert(is_invalid(t1, v1) == 1, "Z = 256 (not Z = 0 mod 256)");
    var t2, v2 = bohr_energy_level(0 - 1, 1);
    assert(is_invalid(t2, v2) == 1, "Z = −1");
    var t3, v3 = bohr_energy_level(1, 0x100000000);
    assert(is_invalid(t3, v3) == 1, "n = 2³² (not n = 0)");
    var t3b, v3b = bohr_energy_level(1, 0x100000001);
    assert(is_invalid(t3b, v3b) == 1, "n = 2³² + 1 (not n = 1)");
    var t4, v4 = bohr_energy_level(255, 0xFFFFFFFF);
    assert(is_ok(t4) == 1, "Z = 255, n = u32::MAX: in range");
    var t5, v5 = rydberg_wavelength(257, 1, 2);
    assert(is_invalid(t5, v5) == 1, "rydberg Z = 257");
    var t6, v6 = rydberg_wavelength(1, 1, 0x100000002);
    assert(is_invalid(t6, v6) == 1, "rydberg n_upper = 2³² + 2");
    var t7, v7 = bohr_transition_energy(1, 1, 0 - 3);
    assert(is_invalid(t7, v7) == 1, "transition n_upper = −3");
    var t8, v8 = spectral_series_wavelength(KM_SPECTRAL_SERIES_LYMAN, 0x100000000);
    assert(is_invalid(t8, v8) == 1, "line = 2³²");
    var t9, v9 = spectral_series_wavelength(KM_SPECTRAL_SERIES_COUNT, 1);
    assert(is_invalid(t9, v9) == 1, "a word that is no KmSpectralSeries value");
    var t10, v10 = spectral_series_wavelength(0 - 1, 0);
    assert(is_invalid(t10, v10) == 1, "an invalid series is checked first");
    assert(spectral_series_n_lower(KM_SPECTRAL_SERIES_COUNT) == 0, "n_lower of no series: 0");
    assert(spectral_series_n_lower(KM_SPECTRAL_SERIES_PFUND) == 5, "Pfund: 5");
    assert(is_nan(harmonic_oscillator_energy(0 - 1, 1.0)) == 1, "oscillator n = −1: NaN");
    assert(is_nan(harmonic_oscillator_energy(0x100000000, 1.0)) == 1, "oscillator n = 2³²: NaN");
    assert(is_nan(rigid_rotor_energy(0x100000000, 1.0)) == 1, "rotor J = 2³²: NaN");
    var e: f64 = rigid_rotor_energy(0xFFFFFFFF, 1.0);
    assert(is_nan(e) == 0, "rotor J = u32::MAX: a value");
    var p1, n1 = isotope_abundances(256 + 1);
    assert(p1 == 0 && n1 == 0, "isotope_abundances(257): empty (not Z = 1)");
    var p2, n2 = isotope_abundances(0 - 1);
    assert(p2 == 0 && n2 == 0, "isotope_abundances(−1): empty");
    var p3, n3 = isotope_abundances(26);
    assert(p3 == 0 && n3 == 0, "isotope_abundances(26): no data");
    var p4, n4 = isotope_abundances(35);
    assert(p4 != 0 && n4 == 2, "isotope_abundances(35): Br's two");
    var out = alloc(16 * 64);
    var ta, va = pattern_of(&_t_a1, 1, out, 64);
    assert(is_err_code(ta, va, KM_ERR_INVALID_ELEMENT) == 1, "pattern Z = 262 (not C): InvalidElement");
    var tb, vb = pattern_of(&_t_a2, 1, out, 64);
    assert(is_invalid(tb, vb) == 1, "pattern count = 2³² (not 0): InvalidInput");
    var tc, vc = pattern_of(&_t_a3, 1, out, 64);
    assert(is_invalid(tc, vc) == 1, "pattern count = −1 on an element without data");
    var td, vd = pattern_of(&_t_a4, 2, out, 64);
    assert(is_err_code(td, vd, KM_ERR_INVALID_ELEMENT) == 1, "Z first, then the count, per atom in order");
}

# The caller buffers and slices.
fn _t_cyrius_buffers() {
    test_group("cyrius: caller buffers, slices");
    # isotope_pattern: Cl₂ has 3 peaks.
    var out = alloc(16 * 8);
    store64(out, 0x1234);
    var t1, v1 = pattern_of(&_t_cl2, 1, out, 2);
    assert(is_invalid(t1, v1) == 1 && load64(out) == 0x1234, "cap 2 < 3 peaks: Err, buffer untouched");
    var t2, v2 = pattern_of(&_t_cl2, 1, 0, 0);
    assert(is_invalid(t2, v2) == 1, "no buffer");
    var t3, v3 = pattern_of(&_t_cl2, 1, out, 0 - 5);
    assert(is_invalid(t3, v3) == 1, "negative cap");
    var t4, v4 = pattern_of(&_t_cl2, 1, out, 3);
    assert(is_ok(t4) == 1 && v4 == 3, "cap 3: Ok(3)");
    var t5, v5 = isotope_pattern(0, 1, out, 8);
    assert(is_invalid(t5, v5) == 1, "null atoms with n = 1");
    var t6, v6 = isotope_pattern(out, 0 - 1, out, 8);
    assert(is_invalid(t6, v6) == 1, "n = −1");
    var t7, v7 = pattern_of(&_t_a0, 1, out, 8);
    assert(is_ok(t7) == 1 && v7 == 1 && bits(pm(out, 0)) == 0 && bits(pi_(out, 0)) == bits(1.0),
      "C₀: the initial peak (0, 1) unconvolved");
    # fft_spectrum
    var sig = buf(16);
    var k = 0;
    while (k < 16) { put(sig, k, 1.0 + f64_from(k)); k = k + 1; }
    var o = buf(64);
    store64(o, 0x5678);
    var f1, w1 = fft_spectrum(sig, 16, o, 8);
    assert(is_invalid(f1, w1) == 1 && load64(o) == 0x5678, "cap 8 < 9 bins: Err, untouched");
    var f2, w2 = fft_spectrum(0, 16, o, 64);
    assert(is_invalid(f2, w2) == 1, "null signal");
    var f3, w3 = fft_spectrum(sig, 16, 0, 64);
    assert(is_invalid(f3, w3) == 1, "null out");
    var f4, w4 = fft_spectrum(sig, 0 - 16, o, 64);
    assert(is_invalid(f4, w4) == 1, "n = −16");
    var f5, w5 = fft_spectrum(sig, 0, o, 64);
    assert(is_invalid(f5, w5) == 1, "n = 0");
    var heap = buf(16);
    var f6, w6 = fft_spectrum(sig, 16, heap, 9);
    assert(is_ok(f6) == 1 && w6 == 9, "cap 9: the heap work table");
    var inpl = buf(32);
    var f7, w7 = fft_spectrum(sig, 16, inpl, 32);
    assert(is_ok(f7) == 1 && w7 == 9, "cap 32 = 2n: in place");
    var same = 1;
    k = 0;
    while (k < 9) {
        if (load64(heap + 8 * k) != load64(inpl + 8 * k)) { same = 0; }
        k = k + 1;
    }
    assert(same == 1, "the heap and in-place paths give the same bits");
    var self_ = buf(32);
    k = 0;
    while (k < 16) { put(self_, k, 1.0 + f64_from(k)); k = k + 1; }
    var f8, w8 = fft_spectrum(self_, 16, self_, 32);
    assert(is_ok(f8) == 1 && w8 == 9, "signal = out: in place");
    same = 1;
    k = 0;
    while (k < 9) {
        if (load64(self_ + 8 * k) != load64(inpl + 8 * k)) { same = 0; }
        k = k + 1;
    }
    assert(same == 1, "signal = out gives the same bits");
    var one = buf(1);
    put(one, 0, -3.0);
    var f9, w9 = fft_spectrum(one, 1, o, 1);
    assert(is_ok(f9) == 1 && w9 == 1 && bits(at(o, 0)) == bits(3.0), "n = 1: |x|");
    # find_peaks: _t_data_basic has peaks 2 and 5.
    var pk = buf(8);
    store64(pk, 0x9abc);
    var p1, q1 = find_peaks(&_t_data_basic, 8, 0.1, pk, 1);
    assert(is_invalid(p1, q1) == 1 && load64(pk) == 0x9abc, "cap 1 < 2 peaks: Err, untouched");
    var p2, q2 = find_peaks(&_t_data_basic, 8, 0.1, pk, 2);
    assert(is_ok(p2) == 1 && q2 == 2 && load64(pk) == 2 && load64(pk + 8) == 5, "cap 2: Ok(2), counted first");
    var p3, q3 = find_peaks(&_t_data_basic, 8, 0.1, pk, 3);
    assert(is_ok(p3) == 1 && q3 == 2, "cap 3 = (n − 1)/2: written in one pass");
    var p4, q4 = find_peaks(&_t_data_basic, 8, 1.0, 0, 0);
    assert(is_ok(p4) == 1 && q4 == 0, "no peak above the maximum: Ok(0) with no buffer");
    var p5, q5 = find_peaks(&_t_data_basic, 8, 0.1, 0, 0);
    assert(is_invalid(p5, q5) == 1, "peaks but no buffer");
    var p6, q6 = find_peaks(0, 3, 0.1, pk, 8);
    assert(is_invalid(p6, q6) == 1, "null data with n = 3");
    var p7, q7 = find_peaks(&_t_data_basic, 0 - 1, 0.1, pk, 8);
    assert(is_invalid(p7, q7) == 1, "n = −1");
    var p8, q8 = find_peaks(0, 0, 0.1, 0, 0);
    assert(is_ok(p8) == 1 && q8 == 0, "the empty slice: Ok(0)");
}

# The isotope pattern's private helpers: the stable total-order sort and the typed thresholds, to the ulp.
fn _t_cyrius_isotope_helpers() {
    test_group("cyrius: isotope helpers (stable sort, thresholds)");
    var r = alloc(16 * 8);
    var nz: f64 = from_bits(0x8000000000000000);    # −0.0
    var pz: f64 = from_bits(0x0000000000000000);    # +0.0
    var pn: f64 = from_bits(0x7FF8000000000000);    # +NaN
    var mn: f64 = from_bits(0xFFF8000000000000);    # −NaN
    rec(r, 0, 2.0, 0.1);
    rec(r, 1, 1.0, 0.2);
    rec(r, 2, 2.0, 0.3);
    rec(r, 3, nz, 0.4);
    rec(r, 4, pz, 0.5);
    rec(r, 5, pn, 0.6);
    rec(r, 6, mn, 0.7);
    rec(r, 7, 2.0, 0.8);
    _km_isotope_sort(r, 8);
    var ok = 1;
    var k = 0;
    while (k < 8) {
        if (bits(pi_(r, k)) != bits(_t_want[k])) { ok = 0; }
        k = k + 1;
    }
    assert(ok == 1, "total_cmp order, equal masses in input order (Rust's stable sort)");
    # The binned mean depends on the order of equal masses: (m, a) then (m, b) is (m·a + m·b)/(a + b).
    var s1 = alloc(16 * 2);
    var d1 = alloc(16 * 2);
    var mm: f64 = 0.1;
    rec(s1, 0, mm, 0.3);
    rec(s1, 1, mm, 0.7);
    assert(_km_isotope_bin(s1, 2, d1) == 1, "equal masses merge");
    var ia: f64 = 0.3;
    var ib: f64 = 0.7;
    var tot: f64 = ia + ib;
    var mean: f64 = ((mm * ia) + (mm * ib)) / tot;
    assert(bits(pm(d1, 0)) == bits(mean) && bits(pi_(d1, 0)) == bits(tot), "Rust's mean, in order");
    # ISOTOPE_BIN_WIDTH_U = 0.5: |Δm| = 0.5 starts a bin, its predecessor merges.
    var s2 = alloc(16 * 2);
    rec(s2, 0, 0.0, 1.0);
    rec(s2, 1, 0.5, 1.0);
    assert(_km_isotope_bin(s2, 2, d1) == 2, "Δm = 0.5: two bins (0.5 + 1 ulp would merge)");
    rec(s2, 1, from_bits(0x3FDFFFFFFFFFFFFF), 1.0);    # 0.5 − 1 ulp
    assert(_km_isotope_bin(s2, 2, d1) == 1, "Δm = 0.5 − 1 ulp: one bin (0.5 − 1 ulp would not)");
    # total ≤ 0 keeps the bin's mass; NaN starts a bin.
    rec(s2, 0, 1.0, 0.0);
    rec(s2, 1, 1.25, 0.0);
    assert(_km_isotope_bin(s2, 2, d1) == 1 && bits(pm(d1, 0)) == bits(1.0) && bits(pi_(d1, 0)) == 0,
      "total 0: the mass is kept");
    rec(s2, 1, pn, 0.0);
    assert(_km_isotope_bin(s2, 2, d1) == 2, "a NaN mass starts a bin");
    # ISOTOPE_PRUNE_REL = 1e-12: kept from RN(1e-12) on (>=), its predecessor dropped.
    var b = alloc(16 * 3);
    var tol: f64 = 0.000000000001;
    rec(b, 0, 1.0, 1.0);
    rec(b, 1, 2.0, tol);
    assert(_km_isotope_normalize(b, 2) == 2, "RN(1e-12) is kept");
    rec(b, 0, 1.0, 1.0);
    rec(b, 1, 2.0, from_bits(bits(tol) - 1));
    assert(_km_isotope_normalize(b, 2) == 1, "RN(1e-12) − 1 ulp is pruned");
    rec(b, 0, 1.0, pn);
    rec(b, 1, 2.0, 0.5);
    assert(_km_isotope_normalize(b, 2) == 1 && bits(pi_(b, 0)) == bits(1.0) && bits(pm(b, 0)) == bits(2.0),
      "fold(0.0, max) ignores NaN; NaN / max is pruned");
    rec(b, 0, 1.0, 0.0);
    rec(b, 1, 2.0, 0.0);
    assert(_km_isotope_normalize(b, 2) == 0, "all-zero intensities: no division, all pruned");
    # ISOTOPE_REPORT_REL = 0.001: dropped at RN(0.001) (>), kept from its successor.
    var rep: f64 = 0.001;
    rec(b, 0, 1.0, 1.0);
    rec(b, 1, 2.0, rep);
    assert(_km_isotope_report(b, 2) == 1, "RN(0.001) is dropped");
    rec(b, 0, 1.0, 1.0);
    rec(b, 1, 2.0, from_bits(bits(rep) + 1));
    assert(_km_isotope_report(b, 2) == 2, "RN(0.001) + 1 ulp is reported");
    assert(_km_total_key(0x8000000000000000) < _km_total_key(0), "total_cmp: −0 < +0");
}

# The FFT transcription: exact transforms, the two work-table paths, Parseval, larger n.
fn _t_cyrius_fft() {
    test_group("cyrius: the FFT (hisab 1.4.0's num::fft)");
    var e = 0;
    while (e <= 16) {
        var n = 1 << e;
        var sig = buf(n);
        var k = 0;
        while (k < n) { put(sig, k, 0.0); k = k + 1; }
        put(sig, 0, 1.0);
        var out = buf(2 * n);
        var t, m = fft_spectrum(sig, n, out, 2 * n);
        var flat = 1;
        k = 0;
        while (k < m) {
            if (bits(at(out, k)) != bits(1.0)) { flat = 0; }
            k = k + 1;
        }
        assert(is_ok(t) == 1 && m == n / 2 + 1 && flat == 1, "an impulse: every bin exactly 1");
        k = 0;
        while (k < n) { put(sig, k, 2.5); k = k + 1; }
        var t2, m2 = fft_spectrum(sig, n, out, 2 * n);
        var dc: f64 = 2.5 * f64_from(n);
        var lim: f64 = dc * 0.000000000000001;
        var small = 1;
        k = 1;
        while (k < m2) {
            var ak: f64 = at(out, k);
            if (ak > lim) { small = 0; }
            k = k + 1;
        }
        assert(bits(at(out, 0)) == bits(dc) && small == 1, "a constant: DC = n·c exactly, the rest below 10⁻¹⁵ of it");
        e = e + 2;
    }
    # random signals: heap and in-place paths bit-identical; Parseval to 1e-10
    var seed = 0x2545F4914F6CDD1D;
    e = 1;
    while (e <= 14) {
        var n2 = 1 << e;
        var s2 = buf(n2);
        var energy: f64 = 0.0;
        var j = 0;
        while (j < n2) {
            seed = seed ^ (seed << 13);
            seed = seed ^ (seed >> 7);
            seed = seed ^ (seed << 17);
            var u: f64 = f64_from((seed >> 11) & 0xFFFFFFFFFF);
            var x: f64 = u / 1099511627776.0 - 0.5;
            put(s2, j, x);
            energy = energy + x * x;
            j = j + 1;
        }
        var oh = buf(n2 / 2 + 1);
        var oi = buf(2 * n2);
        var th, mh = fft_spectrum(s2, n2, oh, n2 / 2 + 1);
        var ti, mi = fft_spectrum(s2, n2, oi, 2 * n2);
        var same = 1;
        j = 0;
        while (j < mh) {
            if (load64(oh + 8 * j) != load64(oi + 8 * j)) { same = 0; }
            j = j + 1;
        }
        assert(is_ok(th) == 1 && is_ok(ti) == 1 && same == 1, "heap and in-place paths bit-identical");
        var a0: f64 = at(oh, 0);
        var an: f64 = at(oh, n2 / 2);
        var ps: f64 = (a0 * a0) + (an * an);
        j = 1;
        while (j < n2 / 2) {
            var aj: f64 = at(oh, j);
            ps = ps + 2.0 * (aj * aj);
            j = j + 1;
        }
        var want: f64 = f64_from(n2) * energy;
        var rel: f64 = absf(ps - want) / want;
        assert(rel < 0.0000000001, "Parseval: Σ|X|² = n·Σx²");
        e = e + 1;
    }
    # The transcription's twiddles: the n = 4 stage's wn is (cos(−π/2), sin(−π/2)) correctly rounded (6.1e-17, −1).
    var s4 = buf(4);
    put(s4, 0, 1.0);
    put(s4, 1, 2.0);
    put(s4, 2, 3.0);
    put(s4, 3, 4.0);
    var o4 = buf(8);
    var t4, m4 = fft_spectrum(s4, 4, o4, 8);
    assert(is_ok(t4) == 1 && m4 == 3 && bits(at(o4, 0)) == bits(10.0) && bits(at(o4, 2)) == bits(2.0),
      "[1, 2, 3, 4]: |X₀| = 10, |X₂| = 2");
    var x1: f64 = at(o4, 1);
    assert(near(x1, 2.8284271247461903, 0.000000000000001) == 1, "|X₁| = 2√2");
    var hp: f64 = pi();
    var ang: f64 = -hp / 2.0;
    var s, c = _km_cr_sincos(ang);
    assert(bits(s) == bits(-1.0) && bits(c) == 0x3C91A62633145C07, "the twiddle is correctly rounded");
}

# ADR 0002 #19: the correctly rounded 1/(100·x), against Rust's 0.01/x.
fn _t_cyrius_adr19() {
    test_group("cyrius: ADR 0002 #19 (1/(100·x))");
    var t1, v1 = wavenumber_from_wavelength(17.0);
    assert(is_ok(t1) == 1 && v1 == 0x3F434679ACE01346, "1/1700: RN (Rust's 0.01/17 is 0x…47)");
    var r1: f64 = 0.01 / 17.0;
    assert(bits(r1) == 0x3F434679ACE01347, "Rust's value, one ulp off");
    var t2, v2 = wavelength_from_wavenumber(29.0);
    assert(is_ok(t2) == 1 && v2 == 0x3F36993F349CC726, "1/2900");
    var t3, v3 = wavenumber_from_wavelength(0.0000005);
    assert(is_ok(t3) == 1 && v3 == 0x40D3880000000000, "500 nm → 20000 cm⁻¹ (equal in both)");
    var big: f64 = 0x7FEFFFFFFFFFFFFF;
    var t4, v4 = wavenumber_from_wavelength(big);
    assert(is_ok(t4) == 1 && v4 == 0x00000A3D70A3D70A, "DBL_MAX: a subnormal result, rounded once");
    var tiny: f64 = from_bits(1);
    var t5, v5 = wavenumber_from_wavelength(tiny);
    assert(is_ok(t5) == 1 && v5 == 0x7FF0000000000000, "the smallest subnormal: +∞, as Rust");
    var nz: f64 = -0.0;
    var z1: f64 = _km_cr_hundredth_div(nz);
    assert(bits(z1) == 0xFFF0000000000000, "−0 → −∞");
    var inf: f64 = _KM_INF;
    var z2: f64 = _km_cr_hundredth_div(inf);
    assert(bits(z2) == 0, "+∞ → +0");
    var z3: f64 = _km_cr_hundredth_div(-17.0);
    assert(bits(z3) == (0x3F434679ACE01346 | 0x8000000000000000), "the sign is x's");
    var z4: f64 = _km_cr_hundredth_div(_km_nan());
    assert(is_nan(z4) == 1, "NaN → NaN");
    # the fast path agrees with the exact integer path wherever its test passes
    var seed = 0x9E3779B97F4A7C15;
    var agree = 1;
    var passed = 0;
    var k = 0;
    while (k < 20000) {
        seed = seed ^ (seed << 13);
        seed = seed ^ (seed >> 7);
        seed = seed ^ (seed << 17);
        var b = (seed & 0x7FFFFFFFFFFFFFFF) % 0x7FF0000000000000;
        var x: f64 = from_bits(b);
        var f, ok = _km_cr_hundredth_div_fast(x);
        var a: f64 = _km_cr_hundredth_div_acc(x);
        if (ok == 1) {
            passed = passed + 1;
            if (bits(f) != bits(a)) { agree = 0; }
        }
        k = k + 1;
    }
    assert(agree == 1 && passed > 10000, "fast = accurate on 20,000 seeded doubles");
}

# ADR 0002 #21: the Bohr levels, the transition energy and the Rydberg formula, correctly rounded (rounded once).
fn _t_cyrius_adr21() {
    test_group("cyrius: ADR 0002 #21 (exact Rydberg rationals)");
    var rr: f64 = KM_RYDBERG_EV;
    var nr: f64 = -rr;
    # −R exactly at n = Z (Rust's ((−R·Z)·Z)/(n·n) misses it at 86 of the 255 Z: 5 first), and −R/4^k at n = 2^k·Z
    var exact_all = 1;
    var z = 1;
    while (z <= 255) {
        var t0, v0 = bohr_energy_level(z, z);
        if (is_ok(t0) != 1 || v0 != bits(nr)) { exact_all = 0; }
        var k = 1;
        var sc: f64 = 0.25;
        while ((z << k) <= 0xFFFFFFFF) {
            var t1, v1 = bohr_energy_level(z, z << k);
            var want: f64 = nr * sc;
            if (is_ok(t1) != 1 || v1 != bits(want)) { exact_all = 0; }
            sc = sc * 0.25;
            k = k + 1;
        }
        z = z + 1;
    }
    assert(exact_all == 1, "bohr_energy_level(Z, 2^k·Z) = −R/4^k exactly, every Z");
    var five: f64 = 5.0;
    var rust5: f64 = ((nr * five) * five) / (five * five);
    assert(bits(rust5) != bits(nr), "Rust's chain misses −R at Z = n = 5");
    var t2, v2 = bohr_energy_level(1, 1);
    assert(is_ok(t2) == 1 && v2 == bits(nr), "hydrogen's ground state: −R");
    # exact transition energies (the search's families) and the 13 ties, which the fast path must decline
    var t3, v3 = bohr_transition_energy(15, 3, 5);
    var w3: f64 = rr * 16.0;
    assert(is_ok(t3) == 1 && v3 == bits(w3), "E(15; 3 → 5) = R·225·(25 − 9)/225 = 16R exactly");
    var t4, v4 = bohr_transition_energy(17, 3, 51);
    var w4: f64 = rr * 32.0;
    assert(is_ok(t4) == 1 && v4 == bits(w4), "E(17; 3 → 51) = 32R exactly");
    var ties_ok = 1;
    var k2 = 0;
    var sc2: f64 = 1.0;
    while (k2 <= 12) {
        var lo = 58055 << k2;
        var hi = 524544 << k2;
        var t5, v5 = bohr_transition_energy(255, lo, hi);
        var w5: f64 = from_bits(0x3F30FDFF3FB2D524);
        var w5k: f64 = w5 * sc2;
        if (is_ok(t5) != 1 || v5 != bits(w5k)) { ties_ok = 0; }
        var f5, o5 = _km_bohr_transition_fast(255, lo, hi);
        if (o5 != 0) { ties_ok = 0; }
        var a5: f64 = _km_bohr_transition_acc(255, lo, hi);
        if (bits(a5) != bits(w5k)) { ties_ok = 0; }
        sc2 = sc2 * 0.25;
        k2 = k2 + 1;
    }
    assert(ties_ok == 1, "the 13 ties (255; 2^k·(58055 → 524544)): the fast path declines, the exact path: to even");
    var t6, v6 = bohr_transition_energy(1, 1, 2);
    assert(is_ok(t6) == 1 && v6 == 0x402468960E8801CB, "Lyman α: RN(3R/4)");
    var t7, v7 = rydberg_wavelength(1, 2, 3);
    assert(is_ok(t7) == 1 && v7 == 0x3EA603F627730C4F, "Hα (R∞): RN(36/(5R∞))");
    var t8, v8 = rydberg_wavelength(255, 0x80000000, 0x80000007);
    assert(is_ok(t8) == 1 && v8 == 0x430C2D04AB1E7CE8, "(255, 2³¹, 2³¹ + 7): Rust's cancellation is 3.9·10⁷ ulp off");
    # the fast paths agree with the exact paths wherever their tests pass (seeded Z, n₁, n₂ at every scale)
    var seed = 0x2545F4914F6CDD1D;
    var agree = 1;
    var passed = 0;
    var k = 0;
    while (k < 6000) {
        seed = seed ^ (seed << 13);
        seed = seed ^ (seed >> 7);
        seed = seed ^ (seed << 17);
        var zz = 1 + (seed & 0xFF) % 255;
        var sh = (seed >> 8) % 33;
        var nl = 1 + ((seed >> 16) & 0xFFFFFFFF) % (1 << sh);
        if (nl > 0xFFFFFFFE) { nl = 0xFFFFFFFE; }
        var dd = 1 + (seed >> 48) % 64;
        if ((seed & 0x100) != 0) { dd = 1 + (seed >> 40) % 0xFFFFFF; }
        var nu = nl + dd;
        if (nu > 0xFFFFFFFF) { nu = 0xFFFFFFFF; }
        var nn = nl;
        if (nn > 0xFFFFFFFF) { nn = 0xFFFFFFFF; }
        var fl, ol = _km_bohr_level_fast(zz, nn);
        var al: f64 = _km_bohr_level_acc(zz, nn);
        if (ol == 1) {
            passed = passed + 1;
            if (bits(fl) != bits(al)) { agree = 0; }
        }
        if (nu > nl) {
            var ft, ot = _km_bohr_transition_fast(zz, nl, nu);
            var at: f64 = _km_bohr_transition_acc(zz, nl, nu);
            if (ot == 1) {
                passed = passed + 1;
                if (bits(ft) != bits(at)) { agree = 0; }
            }
            var ri: f64 = KM_RYDBERG;
            var fw, ow = _km_rydberg_fast(ri, zz, nl, nu);
            var aw: f64 = _km_rydberg_acc(ri, zz, nl, nu);
            if (ow == 1) {
                passed = passed + 1;
                if (bits(fw) != bits(aw)) { agree = 0; }
            }
        }
        k = k + 1;
    }
    assert(agree == 1 && passed > 15000, "fast = exact on 6,000 seeded (Z, n₁, n₂) × 3 functions");
}

# ADR 0002 #22: the reduced mass, correctly rounded (rounded once, subnormal results included).
fn _t_cyrius_adr22() {
    test_group("cyrius: ADR 0002 #22 (exact reduced mass)");
    # m/2 for a homonuclear diatomic, every seeded normal mass (Rust's m·m/(m + m) misses it on 8.6 %)
    var seed = 0x9E3779B97F4A7C15;
    var half_ok = 1;
    var rust_miss = 0;
    var k = 0;
    while (k < 10000) {
        seed = seed ^ (seed << 13);
        seed = seed ^ (seed >> 7);
        seed = seed ^ (seed << 17);
        var b = 0x0020000000000000 + (seed & 0x7FFFFFFFFFFFFFFF) % (0x7FE0000000000000 - 0x0020000000000000);
        var m: f64 = from_bits(b);
        var t, v = reduced_mass(m, m);
        var h: f64 = m * 0.5;
        if (is_ok(t) != 1 || v != bits(h)) { half_ok = 0; }
        var rust: f64 = (m * m) / (m + m);
        if (bits(rust) != bits(h)) { rust_miss = rust_miss + 1; }
        k = k + 1;
    }
    assert(half_ok == 1, "reduced_mass(m, m) = m/2 exactly, 10,000 seeded normal masses");
    assert(rust_miss > 0, "Rust's chain misses m/2 on some of them (and over- or underflows at the ends)");
    var t1, v1 = reduced_mass(134217727.0, 134217729.0);
    assert(is_ok(t1) == 1 && v1 == 0x4190000000000000, "(2²⁷ − 1, 2²⁷ + 1): the tie 2²⁶ − 2⁻²⁸ to even, 2²⁶");
    var f1, o1 = _km_reduced_mass_fast(134217727.0, 134217729.0);
    assert(o1 == 0, "the fast path declines the tie");
    var s3: f64 = from_bits(3);
    var t2, v2 = reduced_mass(s3, s3);
    assert(is_ok(t2) == 1 && v2 == 2, "(3·2⁻¹⁰⁷⁴, 3·2⁻¹⁰⁷⁴): the subnormal tie 1.5·2⁻¹⁰⁷⁴ to even");
    var s6: f64 = from_bits(6);
    var s2: f64 = from_bits(2);
    var t3, v3 = reduced_mass(s6, s2);
    assert(is_ok(t3) == 1 && v3 == 2, "(6·2⁻¹⁰⁷⁴, 2·2⁻¹⁰⁷⁴): 1.5·2⁻¹⁰⁷⁴ to even");
    var s1: f64 = from_bits(1);
    var t4, v4 = reduced_mass(s1, s1);
    assert(is_ok(t4) == 1 && v4 == 0, "(2⁻¹⁰⁷⁴, 2⁻¹⁰⁷⁴): the tie 2⁻¹⁰⁷⁵ to +0");
    var big: f64 = 0x7FEFFFFFFFFFFFFF;
    var t5, v5 = reduced_mass(big, big);
    var hb: f64 = big * 0.5;
    assert(is_ok(t5) == 1 && v5 == bits(hb), "(DBL_MAX, DBL_MAX) = DBL_MAX/2 (Rust: ∞/∞ = NaN)");
    var t6, v6 = reduced_mass(1.0, 0x3C80000000000000);
    assert(is_ok(t6) == 1 && v6 == 0x3C80000000000000, "(1, 2⁻⁵⁵): the gap of 55, the smaller mass");
    var t7, v7 = reduced_mass(1.007825, 34.968853);
    assert(is_ok(t7) == 1 && v7 == 0x3FEF58D263CD8D68, "H³⁵Cl in u");
    var e300: f64 = from_bits(0x7E37E43C8800759C);
    var t8, v8 = reduced_mass(e300, e300);
    var w8: f64 = e300 * 0.5;
    assert(is_ok(t8) == 1 && v8 == bits(w8), "(10³⁰⁰, 10³⁰⁰) = 10³⁰⁰/2 (Rust: ∞/(2·10³⁰⁰) = ∞)");
    # the fast path agrees with the exact path wherever its test passes (binade-uniform pairs, subnormals included)
    var agree = 1;
    var passed = 0;
    k = 0;
    while (k < 20000) {
        seed = seed ^ (seed << 13);
        seed = seed ^ (seed >> 7);
        seed = seed ^ (seed << 17);
        var b1 = 1 + (seed & 0x7FFFFFFFFFFFFFFF) % 0x7FEFFFFFFFFFFFFF;
        seed = seed ^ (seed << 13);
        seed = seed ^ (seed >> 7);
        seed = seed ^ (seed << 17);
        var b2 = 1 + (seed & 0x7FFFFFFFFFFFFFFF) % 0x7FEFFFFFFFFFFFFF;
        if ((seed & 3) == 0) { b2 = b1 + (seed >> 40) % 0x40000000000000; }
        if (b2 > 0x7FEFFFFFFFFFFFFF) { b2 = 0x7FEFFFFFFFFFFFFF; }
        var x: f64 = from_bits(b1);
        var y: f64 = from_bits(b2);
        var f, ok = _km_reduced_mass_fast(x, y);
        var a: f64 = _km_reduced_mass_acc(x, y);
        if (ok == 1) {
            passed = passed + 1;
            if (bits(f) != bits(a)) { agree = 0; }
        }
        k = k + 1;
    }
    assert(agree == 1 && passed > 15000, "fast = exact on 20,000 seeded pairs");
}

# ADR 0002 #23's table, cell by cell: the seven elements' counts, ¹H's full AME2020 mass, sulfur's four pairs (³⁶S
# included) and their sum, which is exactly 1 in decimal (validate.py) and one ulp below 1.0 in Rust's f64 `.sum()` from
# −0.0 (0.9499 + 0.0075 + 0.0425 + 0.0001 = 0.9999999999999999).
var _t_iso_zs: i64[7] = { 1, 6, 7, 8, 16, 17, 35 };
var _t_iso_ns: i64[7] = { 2, 2, 2, 3, 4, 2, 2 };
var _t_iso_s: f64[8] = { 31.97207117354, 0.9499, 32.97145890862, 0.0075, 33.967867011, 0.0425, 35.967080692, 0.0001 };

fn _t_cyrius_adr23_table() {
    test_group("cyrius: ADR 0002 #23 (the AME2020 / TICE 2009 table)");
    var k = 0;
    while (k < 7) {
        var q, m = isotope_abundances(_t_iso_zs[k]);
        assert(m == _t_iso_ns[k] && q != 0, "isotope count");
        k = k + 1;
    }
    var h, nh = isotope_abundances(1);
    assert(nh == 2 && bits(at(h, 0)) == 0x3FF0200D2401791B, "¹H 1.007825031898 u (AME2020), not Rust's 1.00783");
    var p, n = isotope_abundances(16);
    assert(n == 4, "sulfur: ³²S, ³³S, ³⁴S, ³⁶S");
    var total: f64 = -0.0;
    var j = 0;
    while (j < 8) {
        assert(bits(at(p, j)) == bits(_t_iso_s[j]), "sulfur pair cell (AME2020 mass, TICE 2009 abundance)");
        if (j % 2 == 1) { total = total + at(p, j); }
        j = j + 1;
    }
    assert(bits(at(p, 6)) == bits(35.967080692) && bits(at(p, 7)) == bits(0.0001), "³⁶S (35.967080692, 0.0001)");
    assert(bits(total) == 0x3FEFFFFFFFFFFFFF, "Σ sulfur = 1 − 2⁻⁵³ in f64 (1 exactly in decimal)");
    var b, nb = isotope_abundances(35);
    assert(nb == 2 && bits(at(b, 2)) == bits(80.916288197) && bits(at(b, 3)) == bits(0.4931), "⁸¹Br");
}

# S₈ through ADR 0002 #23's table, every peak bit for bit as validate.py's replica (r_pattern on scripts/oracle/
# isotopes.tsv) gives it. ³⁶S shows from M+4 on: the M+4 bin (³²S₆³⁴S₂, merged with ³²S₇³⁶S) has 0.05736163020920976
# where the table without ³⁶S gives 0.05651943629406078 (the same replica), +1.5 %, and its mass moves up; M+5 (+1.7 %)
# and M+6 (+5.2 %) likewise; M … M+3 are the three-isotope values.
var _t_s8: i64[2] = { 16, 8 };
var _t_s8_want: i64[14] = {
    0x406FF8D9A80BBD18, 0x3FF0000000000000,     # M    255.77656938832, 1
    0x40700C6A520441A0, 0x3FB02B8D312F22CB,     # M+1  256.7759571234001, 0.06316454363617223
    0x40701C5BAACD34BC, 0x3FD704F698A386A7,     # M+2  257.7723796859607, 0.3596779337513944
    0x40702C591DFADC82, 0x3F94491AC1FD3347,     # M+3  258.77175710671156, 0.019810121622231305
    0x40703C4AB16D2E93, 0x3FAD5E80EB966D28,     # M+4  259.7682356133384, 0.05736163020920976
    0x40704C4825F80148, 0x3F662F2251E1B227,     # M+5  260.76761433484035, 0.002708022147137851
    0x40705C39FC47FEF5, 0x3F75D7F686977F62      # M+6  261.76415660975846, 0.005332911483009047
};
var _t_s8_no36: i64[3] = { 0x3FACF01D94F15454, 0x3F65CD847C1C9356, 0x3F74C23A079C36DE };   # M+4 … M+6 without ³⁶S

fn _t_cyrius_adr23_s8() {
    test_group("cyrius: ADR 0002 #23 (S₈, ³⁶S)");
    var out = alloc(16 * 64);
    var t, n = pattern_of(&_t_s8, 1, out, 64);
    assert(is_ok(t) == 1 && n == 7, "S₈: M … M+6");
    var k = 0;
    while (k < 14) {
        assert(load64(out + 8 * k) == _t_s8_want[k], "S₈ peak bits (validate.py's replica)");
        k = k + 1;
    }
    k = 0;
    while (k < 3) {
        var with: f64 = pi_(out, 4 + k);
        var without: f64 = from_bits(_t_s8_no36[k]);
        assert(with > without, "³⁶S raises M+4 … M+6");
        k = k + 1;
    }
}

# The generated constants: R_H is Rust's const evaluation; the thresholds are pinned above.
fn _t_cyrius_constants() {
    test_group("cyrius: R_H and the generated data");
    var one: f64 = 1.0;
    var den: f64 = one + _KM_ELECTRON_PROTON_MASS_RATIO;
    var rh: f64 = KM_RYDBERG / den;
    var g: f64 = _KM_RYDBERG_HYDROGEN;
    assert(bits(rh) == bits(g), "_KM_RYDBERG_HYDROGEN = RYDBERG / (1 + mₑ/mₚ), Rust's const evaluation");
    var t, v = spectral_series_wavelength(KM_SPECTRAL_SERIES_LYMAN, 0xFFFFFFFE);
    var inv: f64 = 1.0 / g;
    assert(is_ok(t) == 1 && v == bits(inv), "Lyman line u32::MAX − 1 = 1/R_H exactly");
    assert(KM_SPECTRAL_SERIES_COUNT == 5 && KM_SPECTRAL_SERIES_LYMAN == 0 && KM_SPECTRAL_SERIES_PFUND == 4,
      "KmSpectralSeries: append-only values in Rust's order");
    var z = 0;
    var with_data = 0;
    while (z < 256) {
        var p, n = isotope_abundances(z);
        if (n > 0) { with_data = with_data + 1; }
        z = z + 1;
    }
    assert(with_data == 7, "seven elements with isotope data (H, C, N, O, S, Cl, Br)");
}

# ADR 0002 #30 (the overflow audit's B2): the Beer–Lambert, rotor and moment-of-inertia monomials rounded once and
# vibrational_frequency's correctly rounded √(k/μ) — ordinary inputs where Rust's two to four roundings miss (HCl's ω),
# Rust's ∞, 0 and NaN where the value is representable, its degraded subnormal products, Rust's expression for a
# non-finite unvalidated input — and the public functions against their exact paths on 5,000 seeded inputs.
fn _t_cyrius_adr30() {
    test_group("cyrius: ADR 0002 #30 (rounded once; √(k/μ))");
    var dmax: f64 = from_bits(0x7FEFFFFFFFFFFFFF);
    var nmin: f64 = from_bits(0x0010000000000000);
    var tiny: f64 = from_bits(0x01A56E1FC2F8F359);      # 1e-300
    var e200: f64 = from_bits(0x6974E718D7D7625A);      # 1e200
    var em200: f64 = from_bits(0x16687E92154EF7AC);     # 1e-200
    var big: f64 = from_bits(0x7E37E43C8800759C);       # 1e300
    var inf: f64 = 1.0 / 0.0;
    var a1: f64 = absorbance(18716.0, 0.1, 0.0007);
    assert_eq(_km_bits(a1), 0x3FF4F640639D5E4A, "ε·l·c rounded once (Rust's one ulp above)");
    var a2: f64 = absorbance(e200, e200, em200);
    assert_eq(_km_bits(a2), 0x6974E718D7D7625A, "1e200·1e200·1e-200 = 1e200 (Rust's ∞)");
    var a3: f64 = absorbance(big, big, 0.0);
    assert_eq(_km_bits(a3), 0, "1e300·1e300·0 = +0 (Rust's ∞·0 = NaN)");
    var a4: f64 = absorbance(inf, 0.0, 1.0);
    assert_eq(ulp_is_nan(_km_bits(a4)), 1, "∞·0·1: Rust's NaN (a non-finite input keeps Rust's expression)");
    var t5, v5 = concentration_from_absorbance(1.33, 1272.0, 0.1);
    assert(is_ok(t5) == 1 && v5 == 0x3F8569F12FFAD909, "A/(ε·l) rounded once (Rust's one ulp above)");
    var t6, v6 = concentration_from_absorbance(big, e200, e200);
    assert(is_ok(t6) == 1 && v6 == 0x2B2BFF2EE48E0531, "1e300/(1e200·1e200) = 1e-100 (Rust's 1e300/∞ = 0)");
    var t7, v7 = concentration_from_absorbance(inf, e200, e200);
    assert(is_ok(t7) == 1 && ulp_is_nan(v7) == 1, "A = ∞, ε·l = ∞: Rust's ∞/∞ = NaN, kept");
    var hm: f64 = from_bits(0x3A601BEBC23E3327);        # 1.6266e-27 kg
    var t8, v8 = vibrational_frequency(516.0, hm);
    assert(is_ok(t8) == 1 && v8 == 0x43000206751AA800, "HCl: √(516/1.6266·10⁻²⁷) rounded once (Rust's one ulp below)");
    var t9, v9 = vibrational_frequency(500.0, nmin);
    assert(is_ok(t9) == 1 && v9 == 0x60265C55827DF1D2, "√(500/2^-1022) = 1.50·10¹⁵⁵ (Rust's k/μ = ∞)");
    var e30: f64 = from_bits(0x46293E5939A08CEA);       # 1e30
    var t10, v10 = vibrational_frequency(tiny, e30);
    assert(is_ok(t10) == 1 && v10 == 0x1DAD7BECC2F23AC2, "√(10⁻³⁰⁰/10³⁰) = 10⁻¹⁶⁵ (Rust's k/μ = 0)");
    var t11, v11 = vibrational_frequency(dmax, from_bits(1));
    assert(is_ok(t11) == 1 && v11 == 0x7FF0000000000000, "√(DBL_MAX/2^-1074) is past DBL_MAX: +∞, as Rust's");
    var hk: f64 = from_bits(0x3E57E3046A1F3250);
    var hq: f64 = from_bits(0x3DD3D9DC063D8070);
    var t12, v12 = vibrational_frequency(hk, hq);
    assert(is_ok(t12) == 1 && v12 == 0x40318D1D41DCE77F, "√(k/μ) 10⁻³² from a midpoint: the exact root (Rust's above)");
    var r13: f64 = rigid_rotor_energy(3, 156913000000.0);
    assert_eq(_km_bits(r13), 0x3B97915016DEF43B, "h·B·J·(J + 1) rounded once (Rust's one ulp above)");
    var r14: f64 = rigid_rotor_energy(4294967295, tiny);
    assert_eq(_km_bits(r14), 0x0000000093757F20, "J = 2³² − 1, B = 10⁻³⁰⁰: 1.22·10⁻³¹⁴ (Rust's h·B underflows: 0)");
    var r15: f64 = rigid_rotor_energy(0, inf);
    assert_eq(ulp_is_nan(_km_bits(r15)), 1, "J = 0, B = ∞: Rust's (h·∞)·0·1 = NaN, kept");
    var mone: f64 = -1.0;
    var r16: f64 = rigid_rotor_energy(0, mone);
    assert_eq(_km_bits(r16), 0x8000000000000000, "J = 0, B = −1: −0, as Rust's");
    var hi: f64 = from_bits(0x366A7D5E1AD9E233);        # 1.45e-46 kg·m²
    var t17, v17 = rotational_constant(hi);
    assert(is_ok(t17) == 1 && v17 == 0x422AF35A7C14D236, "h/(8π²·I) rounded once (Rust's one ulp above)");
    var e320: f64 = from_bits(0x00000000000007E8);      # 1e-320
    var t18, v18 = rotational_constant(e320);
    assert(is_ok(t18) == 1 && v18 == 0x7B16930879281B34, "8π²·10⁻³²⁰ subnormal: 8.392109·10²⁸⁴ (Rust's …090·10²⁸⁴)");
    var mu: f64 = from_bits(0x3A601C2CA997C94D);        # 1.6267e-27 kg
    var rr: f64 = from_bits(0x3DE184999DF45214);        # 1.2746e-10 m
    var r19: f64 = diatomic_moment_of_inertia(mu, rr);
    assert_eq(_km_bits(r19), 0x36434FD78475C3EC, "HCl's μ·r·r rounded once (Rust's one ulp above)");
    var r20: f64 = diatomic_moment_of_inertia(3.0, 67108865.0);
    assert_eq(_km_bits(r20), 0x434800000C000002, "3·r·r with r = 2²⁶ + 1: 3r² of 54 bits, a tie to even");
    var st = 0x2545F4914F6CDD1D;
    var bad = 0;
    var w: f64[4];
    var k = 0;
    while (k < 5000) {
        var j = 0;
        while (j < 3) {
            st = st ^ (st << 13);
            st = st ^ (st >> 7);
            st = st ^ (st << 17);
            var bb = 0x3000000000000000 + ((st >> 3) % 0x1C00000000000000);
            if (j == 0) { bb = bb | (st & 0x8000000000000000); }
            store64(&w + 8 * j, bb);
            j = j + 1;
        }
        var x: f64 = load64(&w);
        var y: f64 = load64(&w + 8);
        var z: f64 = load64(&w + 16);
        var ra: f64 = absorbance(x, y, z);
        var xa: f64 = _km_cr_mono_acc(&w, 3, 0, 0);
        if (_km_bits(ra) != _km_bits(xa)) { bad = bad + 1; }
        var tc, vc = concentration_from_absorbance(x, y, z);
        var xc: f64 = _km_cr_mono_acc(&w, 1, &w + 8, 2);
        if (is_ok(tc) != 1 || vc != _km_bits(xc)) { bad = bad + 1; }
        var tv, vv = vibrational_frequency(y, z);
        var xv: f64 = _km_sqrt_div_acc(y, z);
        if (is_ok(tv) != 1 || vv != _km_bits(xv)) { bad = bad + 1; }
        k = k + 1;
    }
    assert_eq(bad, 0, "absorbance, concentration_from_absorbance and vibrational_frequency = the exact paths (5,000)");
}

# find_peaks' scan with min / max folded as find_peaks folds them: the count (−1 when more than n), and the number of
# candidates the exact predicate decided.
fn _t_peaks_run(data, n, t: f64, out, force): (i64, i64) {
    var lo: f64 = 1.0 / 0.0;
    var hi: f64 = -lo;
    var k = 0;
    while (k < n) {
        var v: f64 = load64(data + 8 * k);
        if (_km_is_finite(v) == 1) {
            lo = _km_min(lo, v);
            hi = _km_max(hi, v);
        }
        k = k + 1;
    }
    var c, s = _km_find_peaks_run(data, n, t, lo, hi, out, n, force);
    return (c, s);
}

# The spectrum of a signal by fft_spectrum (cap 2n, in place) and by the slow path forced: 1 when the two agree bit
# for bit.
fn _t_fft_same(sig, n, o1, o2): i64 {
    var t, m = fft_spectrum(sig, n, o1, 2 * n);
    if (is_ok(t) != 1) { return 0; }
    if (_km_fft_spectrum_ux(sig, n, o2) != 1) { return 0; }
    var k = 0;
    while (k < m) {
        if (load64(o1 + 8 * k) != load64(o2 + 8 * k)) { return 0; }
        k = k + 1;
    }
    return 1;
}

# ADR 0002 #36 (the overflow audit's B6): the FFT with an unbounded exponent. The survey's examples (golden rows: Rust's
# ∞, 0 and [∞, ∞]); the fast test's data bound 2⁻⁹²¹ (passing exactly at it, refused one ulp below, the same spectrum
# both ways); a product the fast test must refuse — n = 4's w = (cos(−π/2), −1) times d = 3.63·10⁻²⁹², exactly below
# 2⁻¹⁰²², which IEEE rounds up to 2⁻¹⁰²² and 53 bits do not (so no test on a product's IEEE value at 2⁻¹⁰²² would do);
# an aliased signal on the slow path; a non-finite sample (Rust's IEEE spectrum); 3,000 seeded signals of every
# length to 64 over every binade, the public function against the slow path forced (equal wherever the fast test
# passes, and the slow path everywhere else); and a bin whose square sum alone passes DBL_MAX.
fn _t_cyrius_adr36_fft() {
    test_group("cyrius: ADR 0002 #36 (the FFT, unbounded)");
    var sig = buf(128);
    var o1 = buf(256);
    var o2 = buf(256);
    put(sig, 0, from_bits(0x7F198DAE8FF94A54));        # 1.75·10³⁰⁴
    var t1, m1 = fft_spectrum(sig, 1, o1, 2);
    assert(is_ok(t1) == 1 && m1 == 1 && load64(o1) == 0x7F198DAE8FF94A54, "[1.75·10³⁰⁴]: itself (Rust's ∞)");
    put(sig, 0, from_bits(0x8000000008641C75));        # −6.96·10⁻³¹⁶
    var t2, m2 = fft_spectrum(sig, 1, o1, 2);
    assert(is_ok(t2) == 1 && load64(o1) == 0x0000000008641C75, "[−6.96·10⁻³¹⁶]: 6.96·10⁻³¹⁶ (Rust's 0)");
    put(sig, 0, from_bits(0x7EBF03C39DA5BE54));        # 3.3·10³⁰²
    put(sig, 1, from_bits(0x7F25D7F8859AC5C4));        # 3.0·10³⁰⁴
    var t3, m3 = fft_spectrum(sig, 2, o1, 4);
    assert(is_ok(t3) == 1 && m3 == 2 && load64(o1) == 0x7F2616000CD61141 && load64(o1 + 8) == 0x7F2599F0FE5F7A47,
      "[3.3·10³⁰², 3·10³⁰⁴]: [3.03·10³⁰⁴, 2.96·10³⁰⁴] (Rust's [∞, ∞])");
    var dmax: f64 = from_bits(0x7FEFFFFFFFFFFFFF);
    put(sig, 0, dmax);
    var t4, m4 = fft_spectrum(sig, 1, o1, 2);
    assert(is_ok(t4) == 1 && load64(o1) == 0x7FEFFFFFFFFFFFFF, "[DBL_MAX]: DBL_MAX (√ of DBL_MAX² rounded once)");
    # the data bound
    var dat = buf(16);
    var bnd: f64 = from_bits(0x0660000000000000);      # 2⁻⁹²¹
    var k = 0;
    while (k < 8) { put(dat, k, 0.0); k = k + 1; }
    put(dat, 2, 1.0);
    put(dat, 6, bnd);                                   # z₃ = (2⁻⁹²¹, 0): d of n = 4's second butterfly
    assert_eq(_km_fft(dat, 4), 1, "d = 2⁻⁹²¹: the fast test passes");
    k = 0;
    while (k < 8) { put(dat, k, 0.0); k = k + 1; }
    put(dat, 2, 1.0);
    put(dat, 6, from_bits(0x065FFFFFFFFFFFFF));
    assert_eq(_km_fft(dat, 4), 0, "d one ulp below 2⁻⁹²¹: refused");
    put(sig, 0, 0.0);
    put(sig, 1, 1.0);
    put(sig, 2, 0.0);
    put(sig, 3, bnd);
    assert_eq(_t_fft_same(sig, 4, o1, o2), 1, "… the spectrum at the bound is the slow path's");
    put(sig, 3, from_bits(0x065FFFFFFFFFFFFF));
    assert_eq(_t_fft_same(sig, 4, o1, o2), 1, "… and one ulp below");
    # a product just below 2⁻¹⁰²²
    k = 0;
    while (k < 8) { put(dat, k, 0.0); k = k + 1; }
    var c: f64 = from_bits(0x036D02967C31CDB4);        # 3.63·10⁻²⁹²: cos(−π/2)·c in [2⁻¹⁰²² − 2⁻¹⁰⁷⁵, 2⁻¹⁰²²)
    put(dat, 2, c);                                     # z₁ = (c, 0): d of the second butterfly of n = 4
    assert_eq(_km_fft(dat, 4), 0, "d = 3.63·10⁻²⁹²: refused (below 2⁻⁹²¹)");
    assert_eq(load64(dat + 16), 0x0010000000000000, "… where IEEE's w·d is 2⁻¹⁰²² exactly (rounded up)");
    var ws, we = _km_ux_from(from_bits(0x3C91A62633145C07));
    var cs, ce = _km_ux_from(c);
    var ps, pe = _km_ux_mul(ws, we, cs, ce);
    assert(bits(ps) == 0x3FFFFFFFFFFFFFFF && pe == 0 - 1023, "… and the 53-bit product 2⁻¹⁰²² − 2⁻¹⁰⁷⁵");
    put(sig, 0, 0.0);
    put(sig, 1, c);
    put(sig, 2, 0.0);
    put(sig, 3, 0.0);
    var t5, m5 = fft_spectrum(sig, 4, o1, 8);
    assert(is_ok(t5) == 1 && load64(o1 + 8) == 0x036D02967C31CDB4, "[0, c, 0, 0]: |X₁| = c (Rust's 0: c² underflows)");
    # aliased: the signal is out itself, on the slow path
    var al = buf(8);
    put(al, 0, from_bits(0x7EBF03C39DA5BE54));
    put(al, 1, from_bits(0x7F25D7F8859AC5C4));
    var t6, m6 = fft_spectrum(al, 2, al, 4);
    assert(is_ok(t6) == 1 && load64(al) == 0x7F2616000CD61141 && load64(al + 8) == 0x7F2599F0FE5F7A47,
      "an aliased signal on the slow path: the same spectrum");
    # a non-finite sample: Rust's IEEE spectrum
    var inf: f64 = 1.0 / 0.0;
    put(sig, 0, inf);
    put(sig, 1, from_bits(0x7E37E43C8800759C));        # 1e300
    var t7, m7 = fft_spectrum(sig, 2, o1, 4);
    var x0: f64 = at(o1, 0);
    var x1: f64 = at(o1, 1);
    assert(is_ok(t7) == 1 && x0 == inf && x1 == inf, "[∞, 10³⁰⁰]: Rust's [∞, ∞]");
    # seeded signals: the public function = the slow path forced
    var st = 0x2545F4914F6CDD1D;
    var bad = 0;
    var slowc = 0;
    var binc = 0;
    var dd = buf(256);
    var r = 0;
    while (r < 3000) {
        st = st ^ (st << 13);
        st = st ^ (st >> 7);
        st = st ^ (st << 17);
        var n = 1 << (((st >> 3) & 0xFF) % 7);
        var e0 = ((st >> 16) & 0xFFFF) % 2040;
        var spread = 1 + ((st >> 40) & 0xFF) % 140;
        var j = 0;
        while (j < n) {
            st = st ^ (st << 13);
            st = st ^ (st >> 7);
            st = st ^ (st << 17);
            var e = e0 + ((st >> 1) & 0xFFFF) % spread;
            if (e > 2046) { e = 2046; }
            var b = (e << 52) | (st & 0x000FFFFFFFFFFFFF);
            if (((st >> 62) & 1) == 1) { b = b | 0x8000000000000000; }
            if (((st >> 58) & 15) == 0) { b = 0; }
            store64(sig + 8 * j, b);
            j = j + 1;
        }
        if (_t_fft_same(sig, n, o1, o2) != 1) { bad = bad + 1; }
        var fr = _km_fft_spectrum_fast(sig, n, dd);
        if (fr == 0) { slowc = slowc + 1; }
        if (fr == 1) { binc = binc + 1; }
        r = r + 1;
    }
    assert_eq(bad, 0, "3,000 seeded signals: fft_spectrum = the unbounded-exponent spectrum forced, bit for bit");
    var msg = "… with every path taken (the unbounded transform 165 times, a bin's unbounded magnitude 1,451)";
    assert(slowc > 100 && binc > 100 && slowc + binc < 2700, msg);
    # Rust's transform in range, the squares past DBL_MAX: the unbounded magnitude per bin, the transform kept
    put(sig, 0, from_bits(0x6974E718D7D7625A));        # 10²⁰⁰
    put(sig, 1, 1.0);
    var f9 = _km_fft_spectrum_fast(sig, 2, dd);
    assert(f9 == 1 && load64(dd) == 0x6974E718D7D7625A && load64(dd + 8) == 0x6974E718D7D7625A,
      "[10²⁰⁰, 1]: Rust's transform, each bin's √ of a square sum past DBL_MAX rounded once (Rust's ∞)");
}

# ADR 0002 #37 (the overflow audit's B6): find_peaks' threshold test is exact. The survey's subnormal cases and the
# golden 1 − 2⁻⁵³ row (Rust's rounded threshold 11 against the exact 11 − 2⁻⁵³), a 53-bit tie (θ = 2 + 2⁻⁵², Rust's
# 2 + 2⁻⁵¹), ±DBL_MAX ends where Rust's threshold is 2⁵² ulps off (its 1 − t rounded by 2⁻⁵⁴, times DBL_MAX), a +∞
# candidate, _km_sign_scaled across rounds, and 20,000 seeded arrays with near-ties: the fast test against the exact
# predicate forced on every candidate.
fn _t_cyrius_adr37_find_peaks() {
    test_group("cyrius: ADR 0002 #37 (find_peaks' exact threshold)");
    var out = buf(64);
    var d = buf(64);
    var one_m: f64 = from_bits(0x3FEFFFFFFFFFFFFF);    # 1 − 2⁻⁵³
    put(d, 0, -0.0);
    put(d, 1, from_bits(1));
    put(d, 2, 0.0);
    assert(peaks_of(d, 3, 0.75, out) == 1 && load64(out) == 1, "[−0, 5·10⁻³²⁴, 0] at 0.75: [1] (Rust's [])");
    assert(peaks_of(d, 3, one_m, out) == 1 && load64(out) == 1, "… at 1 − 2⁻⁵³: [1] (Rust's [])");
    assert(peaks_of(d, 3, 1.0, out) == 0, "… at 1: θ = 5·10⁻³²⁴ itself, no peak");
    put(d, 0, 10.0);
    put(d, 1, 10.2);
    put(d, 2, 10.0);
    put(d, 3, 11.0);
    put(d, 4, 10.0);
    assert(peaks_of(d, 5, one_m, out) == 1 && load64(out) == 3, "[10, 10.2, 10, 11, 10] at 1 − 2⁻⁵³: [3] (Rust's [])");
    assert(peaks_of(d, 5, 1.0, out) == 0, "… at 1: none");
    var half_up: f64 = from_bits(0x3FE0000000000001);  # ½ + 2⁻⁵³
    put(d, 0, 1.0);
    put(d, 1, from_bits(0x4000000000000001));          # 2 + 2⁻⁵¹
    put(d, 2, 1.0);
    put(d, 3, 3.0);
    put(d, 4, 1.0);
    assert(peaks_of(d, 5, half_up, out) == 2 && load64(out) == 1, "θ = 2 + 2⁻⁵²: 2 + 2⁻⁵¹ is a peak (Rust's T is it)");
    put(d, 1, 2.0);
    assert(peaks_of(d, 5, half_up, out) == 1 && load64(out) == 3, "… 2 is not");
    var dmax: f64 = from_bits(0x7FEFFFFFFFFFFFFF);
    var ndmax: f64 = -dmax;
    var half_dn: f64 = from_bits(0x3FDFFFFFFFFFFFFF);  # ½ − 2⁻⁵⁴
    put(d, 0, ndmax);
    put(d, 1, from_bits(0xFC980CCE21B6FF77));          # −1.5·10²⁹²: between θ and Rust's T
    put(d, 2, ndmax);
    put(d, 3, dmax);
    put(d, 4, 0.0);
    var c1 = peaks_of(d, 5, half_dn, out);
    assert(c1 == 2 && load64(out) == 1 && load64(out + 8) == 3, "±DBL_MAX at ½ − 2⁻⁵⁴: θ = −DBL_MAX·2⁻⁵³, [1, 3]");
    var inf: f64 = 1.0 / 0.0;
    put(d, 0, dmax);
    put(d, 1, inf);
    put(d, 2, dmax);
    assert(peaks_of(d, 3, 1.0, out) == 1 && load64(out) == 1, "a +∞ candidate is above every finite threshold");
    var cs: f64[4];
    var ks: i64[4];
    store64(&cs, 1.0);
    store64(&ks, 1000);
    var m1: f64 = -1.0;
    store64(&cs + 8, m1);
    store64(&ks + 8, 1000);
    store64(&cs + 16, m1);
    store64(&ks + 16, 0 - 2100);
    assert(_km_sign_scaled(&cs, &ks, 3) == 0 - 1, "2¹⁰⁰⁰ − 2¹⁰⁰⁰ − 2⁻²¹⁰⁰: the tiny term decides, rounds later");
    store64(&cs + 16, 0.0);
    assert(_km_sign_scaled(&cs, &ks, 3) == 0, "… without it, 0");
    store64(&cs + 16, from_bits(0x39B0000000000000));  # 2⁻¹⁰⁰·2¹⁰⁰ = 1: in the first round, 2⁻¹⁰⁰⁰ of its scale
    store64(&ks + 16, 100);
    store64(&cs + 24, m1);
    store64(&ks + 24, 99);
    var msg_d = "2¹⁰⁰⁰ − 2¹⁰⁰⁰ + 1 − 2⁹⁹: the round's sum, 2⁻¹⁰⁰⁰ of its scale, defers to the larger deferred term";
    assert(_km_sign_scaled(&cs, &ks, 4) == 0 - 1, msg_d);
    store64(&ks + 24, 0 - 100);
    assert(_km_sign_scaled(&cs, &ks, 4) == 1, "… and 1 − 2⁻¹⁰⁰ is positive");
    var st = 0x2545F4914F6CDD1D;
    var bad = 0;
    var slow = 0;
    var o2 = buf(64);
    var k = 0;
    while (k < 20000) {
        st = st ^ (st << 13);
        st = st ^ (st >> 7);
        st = st ^ (st << 17);
        var n = 3 + ((st >> 1) & 0xFFFFFF) % 30;
        var ex = ((st >> 8) & 0xFFFFFF) % 2046;                      # one binade for the array, its sign mixed
        var j = 0;
        while (j < n) {
            st = st ^ (st << 13);
            st = st ^ (st >> 7);
            st = st ^ (st << 17);
            var e2 = ex + ((st >> 58) & 3);
            if (e2 > 2046) { e2 = 2046; }
            var b = (e2 << 52) | (st & 0x000FFFFFFFFFFFFF);
            if (((st >> 55) & 1) == 1) { b = b | 0x8000000000000000; }
            if (((st >> 56) & 7) == 0) { b = load64(d + 8 * (j / 2)); }   # repeats: ties and plateaus
            store64(d + 8 * j, b);
            j = j + 1;
        }
        st = st ^ (st << 13);
        st = st ^ (st >> 7);
        st = st ^ (st << 17);
        var t: f64 = f64_from((st >> 11) & 0x1FFFFFFFFFFFFF);
        t = t / 9007199254740992.0;
        # a candidate at Rust's threshold ± a few ulps
        var i = 1 + ((st >> 3) & 0xFFFF) % (n - 2);
        var lo: f64 = inf;
        var hi: f64 = -inf;
        j = 0;
        while (j < n) {
            var v: f64 = at(d, j);
            lo = _km_min(lo, v);
            hi = _km_max(hi, v);
            j = j + 1;
        }
        var omt: f64 = 1.0 - t;
        var thr: f64 = (lo * omt) + (hi * t);
        var tb = bits(thr) + ((st >> 40) & 0xFF) % 5 - 2;
        if (thr == 0.0) { tb = ((st >> 40) & 0xFF) % 3; }
        var w: f64 = from_bits(tb);
        if (w >= lo && w <= hi) { put(d, i, w); }
        var ca, sa = _t_peaks_run(d, n, t, out, 0);
        var cb, sb = _t_peaks_run(d, n, t, o2, 1);
        if (ca != cb) { bad = bad + 1; }
        j = 0;
        while (j < ca && j < cb) {
            if (load64(out + 8 * j) != load64(o2 + 8 * j)) { bad = bad + 1; }
            j = j + 1;
        }
        slow = slow + sa;
        k = k + 1;
    }
    assert_eq(bad, 0, "20,000 seeded arrays: the fast test's indices = the exact predicate's on every candidate");
    assert(slow > 100, "… and the near-ties reach the exact predicate");
}

# Runs every test group; returns the failure count from assert_summary().
fn main(): i64 {
    _t_beer_lambert_basic();
    _t_transmittance_at_a1();
