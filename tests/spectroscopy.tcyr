# ── isotope patterns ──

var _t_ch4: i64[4] = { 6, 1, 1, 4 };
var _t_cl2: i64[2] = { 17, 2 };
var _t_h88: i64[2] = { 1, 88 };
var _t_c168: i64[2] = { 6, 168 };
var _t_big: i64[10] = { 6, 1000, 1, 2000, 8, 500, 16, 50, 35, 20 };
var _t_z0: i64[2] = { 0, 1 };
var _t_z119: i64[4] = { 6, 1, 119, 2 };
var _t_fe2: i64[2] = { 26, 2 };

fn _t_isotope_pattern_ch4() {
    test_group("isotope_pattern_ch4");
    var out = alloc(16 * 64);
    var t, n = pattern_of(&_t_ch4, 2, out, 64);
    assert(is_ok(t) == 1 && n > 0, "Ok, not empty");
    assert(near(pm(out, 0), 16.0, 0.1) == 1, "base peak near 16");
    assert(near(pi_(out, 0), 1.0, eps64()) == 1, "normalised to 1");
    assert(n == 2, "M and M+1 only");
    assert(near(pi_(out, 1), 0.011276, 0.000001) == 1, "M+1/M = 0.011276 (IUPAC 2009)");
}

fn _t_hydrogen_abundances_iupac_2009() {
    test_group("hydrogen_abundances_iupac_2009");
    var p, n = isotope_abundances(1);
    assert(n == 2, "two hydrogen isotopes");
    assert(bits(at(p, 0)) == bits(1.00783) && bits(at(p, 1)) == bits(0.999885), "¹H (1.00783, 0.999885)");
    assert(bits(at(p, 2)) == bits(2.0141) && bits(at(p, 3)) == bits(0.000115), "²H (2.01410, 0.000115)");
    var k = 0;
    while (k < 6) {
        var q, m = isotope_abundances(_t_zs[k]);
        var total: f64 = -0.0;              # Rust's `.sum()`
        var j = 0;
        while (j < m) {
            total = total + at(q, 2 * j + 1);
            j = j + 1;
        }
        assert(near(total, 1.0, 0.000000001) == 1, "Σ abundances = 1");
        k = k + 1;
    }
}

fn _t_isotope_pattern_chlorine_doublet() {
    test_group("isotope_pattern_chlorine_doublet");
    var out = alloc(16 * 64);
    var t, n = pattern_of(&_t_cl2, 1, out, 64);
    assert(is_ok(t) == 1 && n == 3, "three peaks");
    var k = 0;
    while (k < 3) {
        assert(near(pm(out, k), _t_em[k], 0.001) == 1, "mass");
        assert(near(pi_(out, k), _t_ei[k], 0.0001) == 1, "intensity");
        k = k + 1;
    }
}

fn _t_isotope_pattern_empty_is_error() {
    test_group("isotope_pattern_empty_is_error");
    var out = alloc(16 * 8);
    var t, v = isotope_pattern(out, 0, out, 8);
    assert(is_invalid(t, v) == 1, "no atoms");
}

fn _t_isotope_pattern_large_molecules_do_not_panic() {
    test_group("isotope_pattern_large_molecules_do_not_panic");
    var out = alloc(16 * 1024);
    var which = 0;
    while (which < 3) {
        var pairs = &_t_h88;
        var np = 1;
        if (which == 1) { pairs = &_t_c168; }
        if (which == 2) {
            pairs = &_t_big;
            np = 5;
        }
        var t, n = pattern_of(pairs, np, out, 1024);
        assert(is_ok(t) == 1 && n > 0, "Ok, not empty");
        var finite = 1;
        var sorted = 1;
        var base: f64 = 0.0;
        var k = 0;
        while (k < n) {
            if (_km_is_finite(pm(out, k)) != 1 || _km_is_finite(pi_(out, k)) != 1) { finite = 0; }
            if (k > 0) {
                var m0: f64 = pm(out, k - 1);
                var m1: f64 = pm(out, k);
                if (m0 >= m1) { sorted = 0; }
            }
            base = _km_max(base, pi_(out, k));
            k = k + 1;
        }
        assert(finite == 1, "every mass and intensity finite");
        assert(sorted == 1, "sorted by mass");
        assert(near(base, 1.0, eps64()) == 1, "base peak 1");
        which = which + 1;
    }
}

fn _t_isotope_pattern_c168_matches_binomial() {
    test_group("isotope_pattern_c168_matches_binomial");
    var out = alloc(16 * 256);
    var t, n = pattern_of(&_t_c168, 1, out, 256);
    assert(is_ok(t) == 1 && n >= 2, "Ok");
    var r: f64 = 0.0107 / 0.9893;
    var m0: f64 = 1.0 / (168.0 * r);
    assert(near(pi_(out, 0), m0, 0.000000001) == 1, "M = 1/(168·r)");
    assert(near(pi_(out, 1), 1.0, eps64()) == 1, "M+1 is the base peak");
}

fn _t_isotope_pattern_unknown_element_is_error() {
    test_group("isotope_pattern_unknown_element_is_error");
    var out = alloc(16 * 8);
    var t1, v1 = pattern_of(&_t_z0, 1, out, 8);
    assert(is_err_code(t1, v1, KM_ERR_INVALID_ELEMENT) == 1, "Z = 0");
    var t2, v2 = pattern_of(&_t_z119, 2, out, 8);
    assert(is_err_code(t2, v2, KM_ERR_INVALID_ELEMENT) == 1, "Z = 119");
}

fn _t_isotope_pattern_element_without_data_uses_standard_weight() {
    test_group("isotope_pattern_element_without_data_uses_standard_weight");
    var fe: f64 = element_atomic_mass(element_lookup_by_number(26));
    var out = alloc(16 * 8);
    var t, n = pattern_of(&_t_fe2, 1, out, 8);
    assert(is_ok(t) == 1 && n == 1, "one peak");
    var d: f64 = pm(out, 0) - (2.0 * fe);
    assert(absf(d) < 0.000000000001, "at 2 × 55.845");
}

# ── FFT spectroscopy, peak detection ──

fn _t_fft_spectrum_sine_wave() {
    test_group("fft_spectrum_sine_wave");
    var n = 64;
    var freq: f64 = 4.0;
    var sig = buf(n);
    var i = 0;
    while (i < n) {
        var tp: f64 = 2.0 * pi();
        var fi: f64 = f64_from(i);
        var fn_: f64 = f64_from(n);
        var x: f64 = ((tp * freq) * fi) / fn_;
        put(sig, i, _km_cr_sin(x));
        i = i + 1;
    }
    var out = buf(n);
    var t, m = fft_spectrum(sig, n, out, n);
    assert(is_ok(t) == 1 && m == 33, "n/2 + 1 bins");
    var best = 0;
    var k = 1;
    while (k < m) {
        if (at(out, k) >= at(out, best)) { best = k; }     # Rust's max_by: the last maximum
        k = k + 1;
    }
    assert(best == 4, "peak at frequency bin 4");
}

fn _t_fft_spectrum_non_power_of_2_is_error() {
    test_group("fft_spectrum_non_power_of_2_is_error");
    var sig = buf(10);
    var k = 0;
    while (k < 10) { put(sig, k, 1.0); k = k + 1; }
    var out = buf(20);
    var t, v = fft_spectrum(sig, 10, out, 20);
    assert(is_invalid(t, v) == 1, "n = 10");
}

fn _t_find_peaks_basic() {
    test_group("find_peaks_basic");
