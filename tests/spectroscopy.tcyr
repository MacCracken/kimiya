    _t_find_peaks_all_negative();
    _t_find_peaks_threshold_relative_to_range();
    _t_find_peaks_invalid_threshold_is_empty();
    _t_find_peaks_ignores_non_finite();
    _t_beer_lambert_and_transmittance();
    _t_hydrogen_balmer_series_visible();
    _t_cyrius_out_of_type();
    _t_cyrius_buffers();
