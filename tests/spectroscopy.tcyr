# spectroscopy.tcyr — the tests of rust-old/src/spectroscopy.rs, ported one for one (each test_group is the Rust test's
# name; all 62), the two spectroscopy tests of rust-old/tests/integration.rs, plus Cyrius-only tests of Rust's integers
# as words (u8 Z, u32 n / line / count outside their types), the caller buffers (too small, null, the FFT's in-place
# work table), the private helpers (the isotope pattern's stable sort, its typed thresholds on the ulp, the FFT
# transcription), ADR 0002 #19's correctly rounded 1/(100·x) and the generated R_H. The golden corpus separately checks
# every function over its grid (tests/parity.tcyr).
#
# Adapted beyond the port's form (port plan §6.4: `Result::unwrap` is `is_ok` + the payload, a Vec the caller's buffer
# and its count, a slice a pointer and a count, `SpectralSeries::X.wavelength(l)` spectral_series_wavelength(KM_…, l),
# `x.sin()` the correctly rounded _km_cr_sin, `RYDBERG_HYDROGEN` the generated _KM_RYDBERG_HYDROGEN); no test needed
# more. ADR 0002 #19 changes none of the Rust tests' cases (500 nm, 10 µm and their round trips are equal in both).

include "tests/ulp.cyr"
include "src/error.cyr"
include "src/constants.cyr"
include "src/mathx_data.cyr"
include "src/mathx.cyr"
include "src/validate.cyr"
include "src/element_data.cyr"
include "src/element.cyr"
include "src/thermo.cyr"
include "src/organic_data.cyr"
include "src/organic.cyr"
include "src/inorganic_data.cyr"
include "src/inorganic.cyr"
include "src/nuclear_data.cyr"
include "src/nuclear.cyr"
include "src/spectroscopy_data.cyr"
include "src/spectroscopy.cyr"

alloc_init();

# |x|.
#must_use
fn absf(x: f64): f64 {
    var a: f64 = f64_abs(x);
    return a;
}

# 1 if |a − b| < eps.
#must_use
fn near(a: f64, b: f64, eps: f64): i64 {
    var d: f64 = f64_abs(a - b);
    if (d < eps) { return 1; }
    return 0;
}

# f64::EPSILON.
#must_use
fn eps64(): f64 {
    var e: f64 = 0.0000000000000002220446049250313;
    return e;
}

# 1 if x is NaN.
#must_use
fn is_nan(x: f64): i64 {
    if (x != x) { return 1; }
    return 0;
}

# The f64 with bit pattern b.
#must_use
fn from_bits(b): f64 {
    var x: f64 = 0.0;
    store64(&x, b);
    return x;
}

# The bit pattern of x.
#must_use
fn bits(x: f64): i64 {
    return load64(&x);
}

# std::f64::consts::PI.
#must_use
fn pi(): f64 {
    var p: f64 = 0x400921FB54442D18;
    return p;
}

# A Result's Ok payload as an f64 (the test fails on Err).
#must_use
fn ok_f(t, v, name): f64 {
    assert(is_ok(t) == 1, name);
    var x: f64 = v;
    return x;
}

# 1 if the Result (t, v) is Err(code).
#must_use
fn is_err_code(t, v, code): i64 {
    if (is_err_result(t) == 1 && v == code) { return 1; }
    return 0;
}

# 1 if the Result (t, v) is Err(InvalidInput).
#must_use
fn is_invalid(t, v): i64 {
    return is_err_code(t, v, KM_ERR_INVALID_INPUT);
}

# A buffer of n f64 / words.
#must_use
fn buf(n): i64 {
    return alloc(8 * n + 8);
}

# The f64 at index k of buf p.
#must_use
fn at(p, k): f64 {
    var x: f64 = load64(p + 8 * k);
    return x;
}

# Stores the f64 x at index k of buf p.
fn put(p, k, x: f64) {
    store64(p + 8 * k, x);
    return 0;
}

# Stores the record (m, i) at index k of a 16-byte-record buffer p.
fn rec(p, k, m: f64, i: f64) {
    store64(p + 16 * k, m);
    store64(p + 16 * k + 8, i);
    return 0;
}

# The isotope pattern of the n (z, count) pairs at pairs (a flat array of 2n words), into out (cap records): its Result.
#must_use
fn pattern_of(pairs, n, out, cap): Result {
    var recs = alloc(16 * n + 16);
    var k = 0;
    while (k < n) {
        store64(recs + 16 * k, load64(pairs + 16 * k));
        store64(recs + 16 * k + 8, load64(pairs + 16 * k + 8));
        k = k + 1;
    }
    return isotope_pattern(recs, n, out, cap);
}

# The mass of record k of a pattern buffer.
#must_use
fn pm(p, k): f64 {
    var x: f64 = load64(p + 16 * k);
    return x;
}

# The intensity of record k of a pattern buffer.
#must_use
fn pi_(p, k): f64 {
    var x: f64 = load64(p + 16 * k + 8);
    return x;
}

# The peaks of find_peaks(data, n, t) into out (cap n); its count, -1 on Err.
#must_use
fn peaks_of(data, n, t: f64, out): i64 {
    var tk, vk = find_peaks(data, n, t, out, n);
    if (is_err_result(tk) == 1) { return 0 - 1; }
    return vk;
}

# 1 if the word k is among the first n words at p.
#must_use
fn contains(p, n, k): i64 {
    var j = 0;
    while (j < n) {
        if (load64(p + 8 * j) == k) { return 1; }
        j = j + 1;
    }
    return 0;
}

# The data of the Rust tests, as f64 buffers.
var _t_data_basic: f64[8] = { 0.0, 1.0, 3.0, 1.0, 0.5, 2.0, 0.5, 0.0 };
var _t_data_filter: f64[8] = { 0.0, 1.0, 3.0, 1.0, 0.5, 0.6, 0.5, 0.0 };
var _t_data_neg: f64[7] = { -5.0, -3.0, -1.0, -3.0, -5.0, -4.0, -5.0 };
var _t_data_offset: f64[5] = { 10.0, 10.2, 10.0, 11.0, 10.0 };
var _t_data_small: f64[5] = { 0.0, 1.0, 3.0, 1.0, 0.0 };
var _t_data_two: f64[2] = { 1.0, 2.0 };

# Test inputs (a local array can't have an initializer).
var _t_zs: i64[6] = { 1, 6, 7, 8, 17, 35 };
var _t_em: f64[3] = { 69.9377, 71.9348, 73.9318 };
var _t_ei: f64[3] = { 1.0, 0.6399, 0.1024 };
var _t_a1: i64[2] = { 262, 1 };
var _t_a2: i64[2] = { 6, 0x100000000 };
var _t_a3: i64[2] = { 26, -1 };
var _t_a4: i64[4] = { 0, -1, 6, 1 };
var _t_a0: i64[2] = { 6, 0 };
var _t_want: f64[8] = { 0.7, 0.4, 0.5, 0.2, 0.1, 0.3, 0.8, 0.6 };   # −NaN, −0, +0, 1, 2 (in input order), +NaN

# ── Beer–Lambert ──

fn _t_beer_lambert_basic() {
    test_group("beer_lambert_basic");
    var a: f64 = absorbance(100.0, 1.0, 0.01);
    assert(near(a, 1.0, eps64()) == 1, "ε=100, l=1, c=0.01 → A = 1");
}

fn _t_transmittance_at_a1() {
    test_group("transmittance_at_a1");
    var t: f64 = transmittance(1.0);
    assert(near(t, 0.1, 0.001) == 1, "A = 1 → T = 0.1");
}

fn _t_transmittance_at_a0() {
    test_group("transmittance_at_a0");
    var t: f64 = transmittance(0.0);
    assert(near(t, 1.0, eps64()) == 1, "A = 0 → T = 1");
}

fn _t_absorbance_transmittance_roundtrip() {
    test_group("absorbance_transmittance_roundtrip");
    var a: f64 = 0.75;
    var t: f64 = transmittance(a);
    var tb, vb = absorbance_from_transmittance(t);
    var back: f64 = ok_f(tb, vb, "absorbance_from_transmittance: Ok");
    assert(near(back, a, 0.0000000001) == 1, "A → T → A");
}

fn _t_absorbance_from_transmittance_zero_is_error() {
    test_group("absorbance_from_transmittance_zero_is_error");
    var t, v = absorbance_from_transmittance(0.0);
    assert(is_err_result(t) == 1, "T = 0");
}

fn _t_absorbance_from_transmittance_over_one_is_error() {
    test_group("absorbance_from_transmittance_over_one_is_error");
    var t, v = absorbance_from_transmittance(1.5);
    assert(is_err_result(t) == 1, "T = 1.5");
}

fn _t_concentration_from_absorbance_basic() {
    test_group("concentration_from_absorbance_basic");
    var t, v = concentration_from_absorbance(1.0, 100.0, 1.0);
    var c: f64 = ok_f(t, v, "Ok");
    assert(near(c, 0.01, 0.0000000001) == 1, "c = A/(εl) = 0.01");
}

fn _t_beer_lambert_nan_is_error() {
    test_group("beer_lambert_nan_is_error");
    var inf: f64 = _KM_INF;
    var t1, v1 = absorbance_from_transmittance(_km_nan());
    assert(is_err_result(t1) == 1, "T = NaN");
    var t2, v2 = concentration_from_absorbance(1.0, _km_nan(), 1.0);
    assert(is_err_result(t2) == 1, "ε = NaN");
    var t3, v3 = concentration_from_absorbance(1.0, 100.0, _km_nan());
    assert(is_err_result(t3) == 1, "l = NaN");
    var t4, v4 = concentration_from_absorbance(1.0, inf, 1.0);
    assert(is_err_result(t4) == 1, "ε = ∞");
}

# ── photon conversions ──

fn _t_photon_energy_wavelength_roundtrip() {
    test_group("photon_energy_wavelength_roundtrip");
    var lambda: f64 = 0.0000005;
    var te, ve = photon_energy_from_wavelength(lambda);
    var e: f64 = ok_f(te, ve, "E(λ): Ok");
    var tb, vb = wavelength_from_energy(e);
    var back: f64 = ok_f(tb, vb, "λ(E): Ok");
    var rel: f64 = absf(back - lambda) / lambda;
    assert(rel < 0.0000000001, "λ → E → λ");
}

fn _t_visible_light_energy_range() {
    test_group("visible_light_energy_range");
    var tr, vr = photon_energy_from_wavelength(0.0000007);
    var er: f64 = ok_f(tr, vr, "700 nm: Ok");
    var e_red: f64 = joules_to_ev(er);
    var tv, vv = photon_energy_from_wavelength(0.0000004);
    var ev: f64 = ok_f(tv, vv, "400 nm: Ok");
    var e_violet: f64 = joules_to_ev(ev);
    assert(e_red > 1.7 && e_red < 1.85, "red ≈ 1.77 eV");
    assert(e_violet > 3.0 && e_violet < 3.2, "violet ≈ 3.10 eV");
}

fn _t_ev_joules_roundtrip() {
    test_group("ev_joules_roundtrip");
    var ev: f64 = 13.6;
    var j: f64 = ev_to_joules(ev);
    var back: f64 = joules_to_ev(j);
    assert(near(back, ev, 0.0000000001) == 1, "eV → J → eV");
}

fn _t_frequency_wavelength_roundtrip() {
    test_group("frequency_wavelength_roundtrip");
    var lambda: f64 = 0.0000005;
    var tf, vf = frequency_from_wavelength(lambda);
    var freq: f64 = ok_f(tf, vf, "ν(λ): Ok");
    var back: f64 = KM_SPEED_OF_LIGHT / freq;
    var rel: f64 = absf(back - lambda) / lambda;
    assert(rel < 0.0000000001, "λ → ν → λ");
}

fn _t_zero_wavelength_is_error() {
    test_group("zero_wavelength_is_error");
    var t1, v1 = photon_energy_from_wavelength(0.0);
    assert(is_err_result(t1) == 1, "E(0)");
    var t2, v2 = frequency_from_wavelength(0.0);
    assert(is_err_result(t2) == 1, "ν(0)");
}

fn _t_zero_energy_is_error() {
    test_group("zero_energy_is_error");
    var t, v = wavelength_from_energy(0.0);
    assert(is_err_result(t) == 1, "λ(0)");
}

fn _t_photon_nan_inf_is_error() {
    test_group("photon_nan_inf_is_error");
    var inf: f64 = _KM_INF;
    var nan: f64 = _km_nan();
    var t1, v1 = photon_energy_from_wavelength(nan);
    assert(is_err_result(t1) == 1, "E(NaN)");
    var t2, v2 = photon_energy_from_wavelength(inf);
    assert(is_err_result(t2) == 1, "E(∞)");
    var t3, v3 = wavelength_from_energy(nan);
    assert(is_err_result(t3) == 1, "λ(NaN)");
    var t4, v4 = frequency_from_wavelength(nan);
    assert(is_err_result(t4) == 1, "ν(NaN)");
    var t5, v5 = wavenumber_from_wavelength(nan);
    assert(is_err_result(t5) == 1, "ν̃(NaN)");
    var t6, v6 = wavelength_from_wavenumber(nan);
    assert(is_err_result(t6) == 1, "λ(ν̃ = NaN)");
    var t7, v7 = wavelength_from_wavenumber(inf);
    assert(is_err_result(t7) == 1, "λ(ν̃ = ∞)");
}

# ── Bohr model ──

fn _t_hydrogen_ground_state() {
    test_group("hydrogen_ground_state");
    var t, v = bohr_energy_level(1, 1);
    var e: f64 = ok_f(t, v, "Ok");
    assert(near(e, -13.6, 0.01) == 1, "H ground state ≈ −13.6 eV");
}

fn _t_hydrogen_n2() {
    test_group("hydrogen_n2");
    var t, v = bohr_energy_level(1, 2);
    var e: f64 = ok_f(t, v, "Ok");
    assert(near(e, -3.4, 0.01) == 1, "H n = 2 ≈ −3.4 eV");
}

fn _t_helium_ion_ground_state() {
    test_group("helium_ion_ground_state");
    var t, v = bohr_energy_level(2, 1);
    var e: f64 = ok_f(t, v, "Ok");
    assert(near(e, -54.4, 0.1) == 1, "He⁺ ground state ≈ −54.4 eV");
}

fn _t_bohr_zero_n_is_error() {
    test_group("bohr_zero_n_is_error");
    var t, v = bohr_energy_level(1, 0);
    assert(is_err_result(t) == 1, "n = 0");
}

fn _t_bohr_zero_z_is_error() {
    test_group("bohr_zero_z_is_error");
    var t, v = bohr_energy_level(0, 1);
    assert(is_err_result(t) == 1, "Z = 0");
}

fn _t_hydrogen_lyman_alpha() {
    test_group("hydrogen_lyman_alpha");
    var t, v = rydberg_wavelength(1, 1, 2);
    var lambda: f64 = ok_f(t, v, "Ok");
    var nm: f64 = lambda * 1000000000.0;
    assert(near(nm, 121.502, 0.01) == 1, "R∞ Lyman-α = 121.502 nm");
}

fn _t_hydrogen_balmer_alpha() {
    test_group("hydrogen_balmer_alpha");
    var t, v = rydberg_wavelength(1, 2, 3);
    var lambda: f64 = ok_f(t, v, "Ok");
    var nm: f64 = lambda * 1000000000.0;
    assert(near(nm, 656.112, 0.01) == 1, "R∞ Hα = 656.112 nm");
}

fn _t_rydberg_invalid_quantum_numbers() {
    test_group("rydberg_invalid_quantum_numbers");
    var t1, v1 = rydberg_wavelength(1, 0, 2);
    assert(is_err_result(t1) == 1, "n_lower = 0");
    var t2, v2 = rydberg_wavelength(1, 2, 2);
    assert(is_err_result(t2) == 1, "n_upper = n_lower");
    var t3, v3 = rydberg_wavelength(1, 3, 2);
    assert(is_err_result(t3) == 1, "n_upper < n_lower");
}

fn _t_transition_energy_emission_positive() {
    test_group("transition_energy_emission_positive");
    var t, v = bohr_transition_energy(1, 1, 3);
    var e: f64 = ok_f(t, v, "Ok");
    assert(e > 0.0, "emission energy > 0");
}

fn _t_transition_energy_requires_upper_above_lower() {
    test_group("transition_energy_requires_upper_above_lower");
    var t1, v1 = bohr_transition_energy(1, 3, 1);
    assert(is_err_result(t1) == 1, "3 → 1 as lower 3");
    var t2, v2 = bohr_transition_energy(1, 2, 2);
    assert(is_err_result(t2) == 1, "2 → 2");
    var t3, v3 = bohr_transition_energy(1, 0, 2);
    assert(is_err_result(t3) == 1, "n_lower = 0");
}

# ── spectral series ──

fn _t_lyman_alpha_from_series() {
    test_group("lyman_alpha_from_series");
    var t, v = spectral_series_wavelength(KM_SPECTRAL_SERIES_LYMAN, 1);
    var nm_ok: f64 = ok_f(t, v, "Ok");
    var nm: f64 = nm_ok * 1000000000.0;
    assert(near(nm, 121.568, 0.01) == 1, "Lyα = 121.568 nm (R_H)");
}

fn _t_balmer_alpha_from_series() {
    test_group("balmer_alpha_from_series");
    var t, v = spectral_series_wavelength(KM_SPECTRAL_SERIES_BALMER, 1);
    var nm_ok: f64 = ok_f(t, v, "Ok");
    var nm: f64 = nm_ok * 1000000000.0;
    assert(near(nm, 656.470, 0.01) == 1, "Hα = 656.470 nm (R_H)");
}

fn _t_balmer_beta_and_paschen_alpha_from_series() {
    test_group("balmer_beta_and_paschen_alpha_from_series");
    var tb, vb = spectral_series_wavelength(KM_SPECTRAL_SERIES_BALMER, 2);
    var hb_ok: f64 = ok_f(tb, vb, "Hβ: Ok");
    var hb: f64 = hb_ok * 1000000000.0;
    assert(near(hb, 486.274, 0.01) == 1, "Hβ = 486.274 nm");
    var tp, vp = spectral_series_wavelength(KM_SPECTRAL_SERIES_PASCHEN, 1);
    var pa_ok: f64 = ok_f(tp, vp, "Paα: Ok");
    var pa: f64 = pa_ok * 1000000000.0;
    assert(near(pa, 1875.627, 0.01) == 1, "Paα = 1875.627 nm");
}

fn _t_rydberg_hydrogen_value() {
    test_group("rydberg_hydrogen_value");
    var rh: f64 = _KM_RYDBERG_HYDROGEN;
    assert(near(rh, 10967758.34, 0.01) == 1, "R_H = 10 967 758.34 m⁻¹");
}

fn _t_series_zero_line_is_error() {
    test_group("series_zero_line_is_error");
    var t, v = spectral_series_wavelength(KM_SPECTRAL_SERIES_LYMAN, 0);
    assert(is_err_result(t) == 1, "line 0");
}

fn _t_series_line_overflow_is_error() {
    test_group("series_line_overflow_is_error");
    var t1, v1 = spectral_series_wavelength(KM_SPECTRAL_SERIES_PFUND, 0xFFFFFFFF);
    assert(is_err_result(t1) == 1, "Pfund, u32::MAX: 5 + line overflows");
    var t2, v2 = spectral_series_wavelength(KM_SPECTRAL_SERIES_LYMAN, 0xFFFFFFFE);
    assert(is_ok(t2) == 1, "Lyman, u32::MAX − 1: 1 + line = u32::MAX");
}

fn _t_balmer_series_is_visible() {
    test_group("balmer_series_is_visible");
    var line = 1;
    while (line <= 4) {
        var t, v = spectral_series_wavelength(KM_SPECTRAL_SERIES_BALMER, line);
        var nm_ok: f64 = ok_f(t, v, "Ok");
        var nm: f64 = nm_ok * 1000000000.0;
        assert(nm > 380.0 && nm < 700.0, "Balmer line visible");
        line = line + 1;
    }
}

# ── wavenumber ──

fn _t_wavenumber_roundtrip() {
    test_group("wavenumber_roundtrip");
    var lambda: f64 = 0.0000005;
    var tw, vw = wavenumber_from_wavelength(lambda);
    var wn: f64 = ok_f(tw, vw, "ν̃(λ): Ok");
    var tb, vb = wavelength_from_wavenumber(wn);
    var back: f64 = ok_f(tb, vb, "λ(ν̃): Ok");
    var rel: f64 = absf(back - lambda) / lambda;
    assert(rel < 0.0000000001, "λ → ν̃ → λ");
}

fn _t_wavenumber_ir_range() {
    test_group("wavenumber_ir_range");
    var t, v = wavenumber_from_wavelength(0.00001);
    var wn: f64 = ok_f(t, v, "Ok");
    assert(near(wn, 1000.0, 0.1) == 1, "10 µm → 1000 cm⁻¹");
}

# ── harmonic oscillator ──

fn _t_reduced_mass_equal_masses() {
    test_group("reduced_mass_equal_masses");
    var t, v = reduced_mass(1.0, 1.0);
    var mu: f64 = ok_f(t, v, "Ok");
    assert(near(mu, 0.5, eps64()) == 1, "μ(1, 1) = 0.5");
}

fn _t_oscillator_rotor_nan_is_error() {
    test_group("oscillator_rotor_nan_is_error");
    var inf: f64 = _KM_INF;
    var nan: f64 = _km_nan();
    var t1, v1 = reduced_mass(nan, 1.0);
    assert(is_err_result(t1) == 1, "μ(NaN, 1)");
    var t2, v2 = reduced_mass(1.0, inf);
    assert(is_err_result(t2) == 1, "μ(1, ∞)");
    var t3, v3 = vibrational_frequency(nan, 1.0);
    assert(is_err_result(t3) == 1, "ω(k = NaN)");
    var t4, v4 = vibrational_frequency(1.0, nan);
    assert(is_err_result(t4) == 1, "ω(μ = NaN)");
    var t5, v5 = rotational_constant(nan);
    assert(is_err_result(t5) == 1, "B(NaN)");
}

fn _t_reduced_mass_heavy_light() {
    test_group("reduced_mass_heavy_light");
    var t, v = reduced_mass(1.0, 1000000.0);
    var mu: f64 = ok_f(t, v, "Ok");
    assert(near(mu, 1.0, 0.001) == 1, "μ ≈ m_light");
}

fn _t_harmonic_oscillator_ground_state() {
    test_group("harmonic_oscillator_ground_state");
    var tp: f64 = 2.0 * pi();
    var hbar: f64 = KM_PLANCK / tp;
    var omega: f64 = 100000000000000.0;
    var e0: f64 = harmonic_oscillator_energy(0, omega);
    var want: f64 = (0.5 * hbar) * omega;
    assert(near(e0, want, 0.000000000000000000000000000001) == 1, "E₀ = ½ħω");
}

fn _t_harmonic_oscillator_spacing() {
    test_group("harmonic_oscillator_spacing");
    var omega: f64 = 100000000000000.0;
    var e0: f64 = harmonic_oscillator_energy(0, omega);
    var e1: f64 = harmonic_oscillator_energy(1, omega);
    var e2: f64 = harmonic_oscillator_energy(2, omega);
    var d: f64 = (e1 - e0) - (e2 - e1);
    assert(absf(d) < 0.000000000000000000000000000001, "equal spacing");
}

fn _t_vibrational_frequency_basic() {
    test_group("vibrational_frequency_basic");
    var t, v = vibrational_frequency(500.0, 0.00000000000000000000000000166);
    var omega: f64 = ok_f(t, v, "Ok");
    assert(omega > 500000000000000.0 && omega < 600000000000000.0, "5e14 < ω < 6e14");
}

