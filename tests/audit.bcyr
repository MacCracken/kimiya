# audit.bcyr — benchmarks of the library-wide overflow audit (ADR 0002 #27 … #34), Cyrius-only: the functions each batch
# fixed, on typical inputs and on the edges that take their other paths (the unbounded-exponent slow paths, the exact
# paths, the midpoint ties). tests/kimiya.bcyr mirrors rust-old/benches/benchmarks.rs; these have no Rust counterpart
# (docs/benchmarks-rust-v-cyrius.md lists them by batch). They lived in kimiya.bcyr until the audit's B4, which moved
# them here so each file stays well inside `cyrius bench`'s default deadline of 300 s per bench file (the user's
# decision of 2026-11-11); the names are unchanged. The method is kimiya.bcyr's: each timed batch is a tight loop of
# `per_batch` calls, inputs from globals (Rust's `black_box`), results to a sink.

include "src/error.cyr"
include "src/constants.cyr"
include "src/mathx_data.cyr"
include "src/mathx.cyr"
include "src/validate.cyr"
include "src/element_data.cyr"
include "src/element.cyr"
include "src/molecule.cyr"
include "src/reaction.cyr"
include "src/thermo.cyr"
include "src/thermochem_data.cyr"
include "src/thermochem.cyr"
include "src/phase_data.cyr"
include "src/phase.cyr"
include "src/gas_data.cyr"
include "src/gas.cyr"
include "src/solution.cyr"
include "src/electrochemistry_data.cyr"
include "src/electrochemistry.cyr"
include "src/kinetics.cyr"
include "src/stoichiometry.cyr"
include "src/organic_data.cyr"
include "src/organic.cyr"
include "src/inorganic_data.cyr"
include "src/inorganic.cyr"
include "src/potential.cyr"
include "src/nuclear_data.cyr"
include "src/nuclear.cyr"
include "src/spectroscopy_data.cyr"
include "src/spectroscopy.cyr"

# A sink the timed loops write to, so their results are used.
var _bench_sink = 0;

var _bench_b1 = 0;          # the audit's B1 (ADR 0002 #27, #28): 12 × 4 f64 input slots (bench_audit_b1)
var _bench_b2 = 0;          # the audit's B2 (ADR 0002 #29, #30): 14 × 5 input words (bench_audit_b2)
var _bench_b3 = 0;          # the audit's B3 (ADR 0002 #31, #32): 17 × 6 input words (bench_audit_b3)
var _bench_b4 = 0;          # the audit's B4 (ADR 0002 #33, #34): 23 × 6 input words (bench_audit_b4)
var _bench_b4s = 0;         # B4's slices, species lists and ion records (bench_audit_b4)

# Cyrius-only, the overflow audit's B1 (ADR 0002 #27, #28): the colligative, calorimetry and kinetics functions without
# a Rust bench, on typical inputs, then on the edges that take each one's other paths. which: 0 specific_heat
# (4184 J, 1000 g, 1 K), 1 boiling_point_elevation (0.512, 1, 2), 2 freezing_point_depression (1.86, 0.5, 2),
# 3 osmotic_pressure (2, 0.1 M, 298.15 K), 4 second_order_concentration (1, 0.1, 10), 5 zero_order_half_life (1, 0.1),
# 6 steady_state_intermediate (0.1, 1, 10), 7 pre_equilibrium_rate (10, 2, 0.1, 1); the edges: 8 heat_transfer_tie
# (3·y·1 with 3y = 2⁵³ + 1, a midpoint), 9 osmotic_pressure_subnormal (5·10⁻³²⁴ M: a subnormal result),
# 10 second_order_concentration_edge (1, DBL_MAX, 10: k·t overflows), 11 michaelis_menten_edge (100, DBL_MAX, DBL_MAX:
# Vmax·[S] and Km + [S] overflow).
fn bench_audit_b1(name, which, per_batch, batches) {
    var x = _bench_b1;
    var a0: f64 = load64(x + 8 * (4 * which));
    var a1: f64 = load64(x + 8 * (4 * which + 1));
    var a2: f64 = load64(x + 8 * (4 * which + 2));
    var a3: f64 = load64(x + 8 * (4 * which + 3));
    var b = bench_new(name);
    var k = 0;
    while (k < batches) {
        bench_batch_start(b);
        var i = 0;
        while (i < per_batch) {
            if (which == 0) {
                var t0, v0 = specific_heat_from_calorimetry(a0, a1, a2);
                _bench_sink = v0;
            } elif (which == 1) {
                var r1: f64 = boiling_point_elevation(a0, a1, a2);
                _bench_sink = r1;
            } elif (which == 2) {
                var r2: f64 = freezing_point_depression(a0, a1, a2);
                _bench_sink = r2;
            } elif (which == 3 || which == 9) {
                var t3, v3 = osmotic_pressure(a0, a1, a2);
                _bench_sink = v3;
            } elif (which == 4 || which == 10) {
                var t4, v4 = second_order_concentration(a0, a1, a2);
                _bench_sink = v4;
            } elif (which == 5) {
                var t5, v5 = zero_order_half_life(a0, a1);
                _bench_sink = v5;
            } elif (which == 6) {
                var t6, v6 = steady_state_intermediate(a0, a1, a2);
                _bench_sink = v6;
            } elif (which == 7) {
                var t7, v7 = pre_equilibrium_rate(a0, a1, a2, a3);
                _bench_sink = v7;
            } elif (which == 8) {
                var r8: f64 = heat_transfer(a0, a1, a2);
                _bench_sink = r8;
            } else {
                var t11, v11 = michaelis_menten(a0, a1, a2);
                _bench_sink = v11;
            }
            i = i + 1;
        }
        bench_batch_stop(b, per_batch);
        k = k + 1;
    }
    bench_report(b);
}

# Cyrius-only, the overflow audit's B2 (ADR 0002 #29, #30): solution's, electrochemistry's and spectroscopy's functions
# without a Rust bench (nernst_potential and absorbance have theirs above), on typical inputs, then on the edges that
# take each one's other paths. Five words per bench, an electron count or J as its integer word. which: 0 dilution
# (2 M, 0.1 L, 0.5 L), 1 solution_conductivity (126.4 S·cm²/mol, 0.01 M), 2 faraday_mass_deposited (9648.5 C, Cu
# 63.546 g/mol, 2), 3 faraday_charge_required (1 g, 63.546, 2), 4 faraday_mass_ratio (1 g of Cu, 2 → Ag 107.868, 1),
# 5 concentration_from_absorbance (0.5, 100, 1 cm), 6 vibrational_frequency (HCl: 516 N/m, 1.6266·10⁻²⁷ kg),
# 7 rigid_rotor_energy (J = 2, B = 3.19·10¹¹ Hz), 8 rotational_constant (2.64·10⁻⁴⁷ kg·m²), 9 diatomic_moment_of_inertia
# (1.6266·10⁻²⁷ kg, 1.2746·10⁻¹⁰ m); the edges: 10 nernst_potential_edge (0.342, 2, DBL_MAX, 0.1: R·T overflows, the
# unbounded-exponent slow path), 11 vibrational_frequency_edge (500, 2⁻¹⁰²²: k/μ overflows in Rust; the √ fast path),
# 12 vibrational_frequency_subnormal (10⁻³⁰⁰, 5·10⁻³²⁴: a subnormal μ, the exact path), 13 faraday_mass_ratio_tie
# (y·3 with 3y = 2⁵³ + 1, a midpoint the 3/2 shape's test leaves to _km_mono_tie).
fn bench_audit_b2(name, which, per_batch, batches) {
    var x = _bench_b2 + 40 * which;
    var a0: f64 = load64(x);
    var a1: f64 = load64(x + 8);
    var a2: f64 = load64(x + 16);
    var a3: f64 = load64(x + 24);
    var w2 = load64(x + 16);
    var w4 = load64(x + 32);
    var b = bench_new(name);
    var k = 0;
    while (k < batches) {
        bench_batch_start(b);
        var i = 0;
        while (i < per_batch) {
            if (which == 0) {
                var t0, v0 = dilution(a0, a1, a2);
                _bench_sink = v0;
            } elif (which == 1) {
                var r1: f64 = solution_conductivity(a0, a1);
                _bench_sink = r1;
            } elif (which == 2) {
                var t2, v2 = faraday_mass_deposited(a0, a1, w2);
                _bench_sink = v2;
            } elif (which == 3) {
                var t3, v3 = faraday_charge_required(a0, a1, w2);
                _bench_sink = v3;
            } elif (which == 4 || which == 13) {
                var t4, v4 = faraday_mass_ratio(a0, a1, w2, a3, w4);
                _bench_sink = v4;
            } elif (which == 5) {
                var t5, v5 = concentration_from_absorbance(a0, a1, a2);
                _bench_sink = v5;
            } elif (which == 6 || which == 11 || which == 12) {
                var t6, v6 = vibrational_frequency(a0, a1);
                _bench_sink = v6;
            } elif (which == 7) {
                var r7: f64 = rigid_rotor_energy(load64(x), a1);
                _bench_sink = r7;
            } elif (which == 8) {
                var t8, v8 = rotational_constant(a0);
                _bench_sink = v8;
            } elif (which == 9) {
                var r9: f64 = diatomic_moment_of_inertia(a0, a1);
                _bench_sink = r9;
            } else {
                var t10, v10 = nernst_potential(a0, load64(x + 8), a2, a3);
                _bench_sink = v10;
            }
            i = i + 1;
        }
        bench_batch_stop(b, per_batch);
        k = k + 1;
    }
    bench_report(b);
}

# Cyrius-only, the overflow audit's B3 (ADR 0002 #31, #32): gas's, potential's, inorganic's and nuclear's functions
# without a Rust bench (ideal_gas_pressure, binding_energy_per_nucleon and lennard_jones have theirs above), on typical
# inputs, then on the edges that take each one's other paths. Six words per bench, a charge or a count as its integer
# word. which: 0 ideal_gas_volume (1 mol, 273.15 K, 101325 Pa), 1 gas_density (air at STP: 101325 Pa, 0.029 kg/mol,
# 273.15 K), 2 van_der_waals_pressure (CO₂: 1 mol, 300 K, 1 L, a = 0.364, b = 4.267·10⁻⁵), 3 peng_robinson_pressure
# (N₂ at 300 K, 0.025 m³/mol), 4 redlich_kwong_pressure (N₂'s Tc and Pc, 300 K, 0.025 m³/mol), 5 coulomb (e, −e at
# 1 Å), 6 coulomb_force (the same), 7 morse_width_parameter (HCl: 5.634·10¹⁴ rad/s, 1.6267·10⁻²⁷ kg, 7.399·10⁻¹⁹ J),
# 8 born_lande_lattice_energy (NaCl: 1.748, 1, 1, 2.82 Å, 8); the edges: 9 van_der_waals_pressure_edge (n = 10³⁰⁶:
# n·R·T overflows, the unbounded-exponent slow path), 10 peng_robinson_pressure_edge (Tc = 2⁻¹⁰²²: T/Tc overflows,
# Rust's NaN), 11 redlich_kwong_pressure_edge (Tc = 10¹³⁰: Tc^2.5 overflows, the exact rescale), 12
# lennard_jones_edge (ε = 10⁻³⁰⁰, σ/r = 5.8·10²⁵: (σ/r)¹² overflows), 13 morse_width_parameter_subnormal (1, 2⁻¹⁰⁷⁴,
# 2¹⁰²³: the exact root), 14 born_lande_lattice_energy_edge (DBL_MAX, 1, 1, DBL_MAX, DBL_MAX: the prefix overflows),
# 15 binding_energy_per_nucleon_edge (1000, 1000, DBL_MAX: Δm·931.494 overflows), 16 morse_width_parameter_tie
# (ω = y with 3y = 2⁵³ + 1, μ = 9, D_e = ½: a midpoint the fast test leaves to the exact root). B3 ran them at
# 100,000 × 20 calls in tests/kimiya.bcyr, which then neared `cyrius bench`'s 300 s deadline; here they run at the
# standard 1,000,000 × 20, the two exact roots (about 1.2 µs) at 100,000 × 20 as the other files' microsecond rows.
fn bench_audit_b3(name, which, per_batch, batches) {
    var x = _bench_b3 + 48 * which;
    var a0: f64 = load64(x);
    var a1: f64 = load64(x + 8);
    var a2: f64 = load64(x + 16);
    var a3: f64 = load64(x + 24);
    var a4: f64 = load64(x + 32);
    var w0 = load64(x);
    var w1 = load64(x + 8);
    var w2 = load64(x + 16);
    var pr = KmPengRobinsonParams { tc: a0, pc: a1, omega: a2 };
    var b = bench_new(name);
    var k = 0;
    while (k < batches) {
        bench_batch_start(b);
        var i = 0;
        while (i < per_batch) {
            if (which == 0) {
                var t0, v0 = ideal_gas_volume(a0, a1, a2);
                _bench_sink = v0;
            } elif (which == 1) {
                var t1, v1 = gas_density(a0, a1, a2);
                _bench_sink = v1;
            } elif (which == 2 || which == 9) {
                var t2, v2 = van_der_waals_pressure(a0, a1, a2, a3, a4);
                _bench_sink = v2;
            } elif (which == 3 || which == 10) {
                var t3, v3 = peng_robinson_pressure(pr, a3, a4);
                _bench_sink = v3;
            } elif (which == 4 || which == 11) {
                var t4, v4 = redlich_kwong_pressure(a0, a1, a2, a3);
                _bench_sink = v4;
            } elif (which == 5) {
                var t5, v5 = coulomb(a0, a1, a2);
                _bench_sink = v5;
            } elif (which == 6) {
                var t6, v6 = coulomb_force(a0, a1, a2);
                _bench_sink = v6;
            } elif (which == 7 || which == 13 || which == 16) {
                var t7, v7 = morse_width_parameter(a0, a1, a2);
                _bench_sink = v7;
            } elif (which == 8 || which == 14) {
                var t8, v8 = born_lande_lattice_energy(a0, w1, w2, a3, a4);
                _bench_sink = v8;
            } elif (which == 12) {
                var t12, v12 = lennard_jones(a0, a1, a2);
                _bench_sink = v12;
            } else {
                var t15, v15 = binding_energy_per_nucleon(w0, w1, a2);
                _bench_sink = v15;
            }
            i = i + 1;
        }
        bench_batch_stop(b, per_batch);
        k = k + 1;
    }
    bench_report(b);
}

# Cyrius-only, the overflow audit's B4 (ADR 0002 #33, #34): the sums with cancellation and the Shomate antiderivative
# without a Rust bench (gibbs_free_energy, reaction_enthalpy and Shomate::cp have theirs in tests/kimiya.bcyr), on
# typical inputs, then on the edges that take each one's unbounded-exponent slow path. Six words per bench at _bench_b4,
# the slices, species lists and ion records at _bench_b4s. which: 0 hess_law (−100, 50, −30), 1 enthalpy_from_formation
# ([−400], [−200, −100]), 2 reaction_gibbs_energy and 3 reaction_entropy (CH₄ + 2O₂ → CO₂ + 2H₂O(l)), 4 q_value (D + T →
# ⁴He + n), 5 ionic_strength (0.1 M of a 1:1 salt), 6 born_haber_lattice_energy (NaCl: −411.2, 107.3, 495.8, 243.4,
# −349), 7 kohlrausch_molar_conductivity (126.4, 89.9, 0.01 M), 8 limiting_molar_conductivity (NaCl: 50.1, 1, 76.35, 1),
# 9 zero_order_concentration (1, 0.01, 50), 10 shomate_enthalpy_antiderivative (CO₂(g) at 500 K); the edges: 11
# hess_law_edge ([DBL_MAX, DBL_MAX, −DBL_MAX]), 12 enthalpy_from_formation_edge ([DBL_MAX, DBL_MAX] twice), 13
# reaction_enthalpy_edge ([Al₂O₃ ×10³⁰⁸] → [Al₂O₃ ×10³⁰⁸]), 14 q_value_edge ([DBL_MAX, DBL_MAX] − [DBL_MAX,
# 0.999·DBL_MAX]), 15 ionic_strength_edge ([(0.4·DBL_MAX, 2)]), 16 born_haber_lattice_energy_edge (DBL_MAX, −DBL_MAX,
# DBL_MAX, 0, 0), 17 gibbs_free_energy_edge (DBL_MAX, 2, 0.75·DBL_MAX), 18 kohlrausch_molar_conductivity_edge (DBL_MAX,
# DBL_MAX, 1.21), 19 limiting_molar_conductivity_edge (DBL_MAX, 1.5, −DBL_MAX, 1), 20 zero_order_concentration_edge
# (−DBL_MAX, −DBL_MAX, 1.5), 21 shomate_cp_edge (H₂O(g) at 10³⁰⁰ K: C·t² and D·t³ overflow), 22
# shomate_enthalpy_antiderivative_edge (A = 20.786 alone at 5·10⁻³²⁴ K: t underflows).
fn bench_audit_b4(name, which, per_batch, batches) {
    var x = _bench_b4 + 48 * which;
    var a0: f64 = load64(x);
    var a1: f64 = load64(x + 8);
    var a2: f64 = load64(x + 16);
    var a3: f64 = load64(x + 24);
    var a4: f64 = load64(x + 32);
    var a5: f64 = load64(x + 40);
    var ys = _bench_b4s;
    var sh = KmShomate { a: a0, b: a1, c: a2, d: a3, e: a4, t_min: 298.0, t_max: 6000.0 };
    var b = bench_new(name);
    var k = 0;
    while (k < batches) {
        bench_batch_start(b);
        var i = 0;
        while (i < per_batch) {
            if (which == 0) {
                var r0: f64 = hess_law(ys, 3);
                _bench_sink = r0;
            } elif (which == 1) {
                var r1: f64 = enthalpy_from_formation(ys + 24, 1, ys + 32, 2);
                _bench_sink = r1;
            } elif (which == 2) {
                var t2, v2 = reaction_gibbs_energy(ys + 48, 2, ys + 80, 2);
                _bench_sink = v2;
            } elif (which == 3) {
                var t3, v3 = reaction_entropy(ys + 48, 2, ys + 80, 2);
                _bench_sink = v3;
            } elif (which == 4) {
                var r4: f64 = q_value(ys + 112, 2, ys + 128, 2);
                _bench_sink = r4;
            } elif (which == 5) {
                var r5: f64 = ionic_strength(ys + 144, 2);
                _bench_sink = r5;
            } elif (which == 6 || which == 16) {
                var r6: f64 = born_haber_lattice_energy(a0, a1, a2, a3, a4);
                _bench_sink = r6;
            } elif (which == 7 || which == 18) {
                var t7, v7 = kohlrausch_molar_conductivity(a0, a1, a2);
                _bench_sink = v7;
            } elif (which == 8 || which == 19) {
                var r8: f64 = limiting_molar_conductivity(a0, a1, a2, a3);
                _bench_sink = r8;
            } elif (which == 9 || which == 20) {
                var r9: f64 = zero_order_concentration(a0, a1, a2);
                _bench_sink = r9;
            } elif (which == 10 || which == 22) {
                var r10: f64 = sh.enthalpy_antiderivative(a5);
                _bench_sink = r10;
            } elif (which == 11) {
                var r11: f64 = hess_law(ys + 176, 3);
                _bench_sink = r11;
            } elif (which == 12) {
                var r12: f64 = enthalpy_from_formation(ys + 176, 2, ys + 176, 2);
                _bench_sink = r12;
            } elif (which == 13) {
                var t13, v13 = reaction_enthalpy(ys + 200, 1, ys + 200, 1);
                _bench_sink = v13;
            } elif (which == 14) {
                var r14: f64 = q_value(ys + 176, 2, ys + 216, 2);
                _bench_sink = r14;
            } elif (which == 15) {
                var r15: f64 = ionic_strength(ys + 232, 1);
                _bench_sink = r15;
            } elif (which == 17) {
                var t17, v17 = gibbs_free_energy(a0, a1, a2);
                _bench_sink = v17;
            } else {
                var r21: f64 = sh.cp(a5);
                _bench_sink = r21;
            }
            i = i + 1;
        }
        bench_batch_stop(b, per_batch);
        k = k + 1;
    }
    bench_report(b);
}

# Runs every bench.
fn main(): i64 {
    alloc_init();
    _bench_b1 = alloc(48 * 8);
    var bx: f64[48];
    var dmax: f64 = 0x7FEFFFFFFFFFFFFF;
    var q = 0;
    while (q < 48) {
        bx[q] = 0.0;
        q = q + 1;
    }
    bx[0] = 4184.0;                         # 0 specific_heat_from_calorimetry
    bx[1] = 1000.0;
    bx[2] = 1.0;
    bx[4] = 0.512;                          # 1 boiling_point_elevation
    bx[5] = 1.0;
    bx[6] = 2.0;
    bx[8] = 1.86;                           # 2 freezing_point_depression
    bx[9] = 0.5;
    bx[10] = 2.0;
    bx[12] = 2.0;                           # 3 osmotic_pressure
    bx[13] = 0.1;
    bx[14] = 298.15;
    bx[16] = 1.0;                           # 4 second_order_concentration
    bx[17] = 0.1;
    bx[18] = 10.0;
    bx[20] = 1.0;                           # 5 zero_order_half_life
    bx[21] = 0.1;
    bx[24] = 0.1;                           # 6 steady_state_intermediate
    bx[25] = 1.0;
    bx[26] = 10.0;
    bx[28] = 10.0;                          # 7 pre_equilibrium_rate
    bx[29] = 2.0;
    bx[30] = 0.1;
    bx[31] = 1.0;
    bx[32] = 3.0;                           # 8 heat_transfer_tie: 3·y with 3y = 2⁵³ + 1
    bx[33] = 3002399751580331.0;
    bx[34] = 1.0;
    bx[37] = 0.1;                           # 9 osmotic_pressure_subnormal (slot 36: 5·10⁻³²⁴, below)
    bx[38] = 298.15;
    bx[40] = 1.0;                           # 10 second_order_concentration_edge
    bx[41] = dmax;
    bx[42] = 10.0;
    bx[44] = 100.0;                         # 11 michaelis_menten_edge
    bx[45] = dmax;
    bx[46] = dmax;
    memcpy(_bench_b1, &bx, 48 * 8);
    store64(_bench_b1 + 8 * 36, 1);         # 5·10⁻³²⁴ (2⁻¹⁰⁷⁴: through an untyped word)
    bench_audit_b1("thermo/specific_heat_from_calorimetry", 0, 1000000, 20);
    bench_audit_b1("phase/boiling_point_elevation", 1, 1000000, 20);
    bench_audit_b1("phase/freezing_point_depression", 2, 1000000, 20);
    bench_audit_b1("phase/osmotic_pressure", 3, 1000000, 20);
    bench_audit_b1("kinetics/second_order_concentration", 4, 1000000, 20);
    bench_audit_b1("kinetics/zero_order_half_life", 5, 1000000, 20);
    bench_audit_b1("kinetics/steady_state_intermediate", 6, 1000000, 20);
    bench_audit_b1("kinetics/pre_equilibrium_rate", 7, 1000000, 20);
    bench_audit_b1("thermo/heat_transfer_tie", 8, 1000000, 20);
    bench_audit_b1("phase/osmotic_pressure_subnormal", 9, 100000, 20);
    bench_audit_b1("kinetics/second_order_concentration_edge", 10, 1000000, 20);
    bench_audit_b1("kinetics/michaelis_menten_edge", 11, 1000000, 20);
    _bench_b2 = alloc(70 * 8);
    var bw: f64[70];
    q = 0;
    while (q < 70) {
        bw[q] = 0.0;
        q = q + 1;
    }
    bw[0] = 2.0;                            # 0 dilution
    bw[1] = 0.1;
    bw[2] = 0.5;
    bw[5] = 126.4;                          # 1 solution_conductivity
    bw[6] = 0.01;
    bw[10] = 9648.5;                        # 2 faraday_mass_deposited (n = 2, slot 12: below)
    bw[11] = 63.546;
    bw[15] = 1.0;                           # 3 faraday_charge_required (n = 2, slot 17)
    bw[16] = 63.546;
    bw[20] = 1.0;                           # 4 faraday_mass_ratio (n_a = 2, slot 22; n_b = 1, slot 24)
    bw[21] = 63.546;
    bw[23] = 107.868;
