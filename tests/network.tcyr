# network.tcyr — the tests of rust-old/src/network.rs, ported one for one (each test_group is the Rust test's name; all
# 10), and Cyrius-only groups for the reaction records and the caller's buffer, hisab 1.4.0's CSR threshold, the
# transcribed Jacobi rank and the usize words. Adaptations: a matrix is a flat row-major buffer with its dimensions
# (port plan §6.3), so `m[i][j]` is entry i·n + j and `m.len()` the row count; `rate_ragged_matrix_is_error` has no
# direct counterpart (a flat matrix has one row length): its group checks the nearest Cyrius case, a rate vector longer
# or shorter than the rows. The golden corpus separately checks every function over its grid (tests/parity.tcyr).
#
# 2.0.1: cyrius_201_no_growth (sparse_stoichiometric_matrix's dense table from the work-table pool),
# cyrius_201_stoichiometric_matrix_overlap and cyrius_201_rate_overlap (an `out` overlapping an input it would
# overwrite before reading is refused; in place works where the loop allows it).

include "src/error.cyr"
include "src/constants.cyr"
include "src/mathx_data.cyr"
include "src/mathx.cyr"
include "src/validate.cyr"
include "src/numerics.cyr"
include "src/network.cyr"

alloc_init();

# 1 if the Result (t, v) is Err(code).
#must_use
fn is_err_code(t, v, code): i64 {
    if (is_err_result(t) == 1 && v == code) { return 1; }
    return 0;
}

# A quiet NaN (Rust's f64::NAN).
#must_use
fn nan(): f64 {
    var x: f64 = 0x7FF8000000000000;
    return x;
}

# One term record (species index, coefficient) into the 16 bytes at p.
fn term(p, species, coeff: f64) {
    store64(p, species);
    store64(p + 8, coeff);
    return 0;
}

# One reaction record into the 32 bytes at p: its reactants (rp, rn) and products (pp, pn).
fn reaction(p, rp, rn, pp, pn) {
    store64(p, rp);
    store64(p + 8, rn);
    store64(p + 16, pp);
    store64(p + 24, pn);
    return 0;
}

# The reactions of the tests: A → B (rx[0]) and B → C (rx[1]), with A = 0, B = 1, C = 2.
var terms: i64[16];
var rx: i64[8];

# Builds the test reactions' term and reaction records.
fn setup() {
    term(&terms, 0, 1.0);          # A
    term(&terms + 16, 1, 1.0);     # B
    term(&terms + 32, 1, 1.0);     # B
    term(&terms + 48, 2, 1.0);     # C
    reaction(&rx, &terms, 1, &terms + 16, 1);
    reaction(&rx + 32, &terms + 32, 1, &terms + 48, 1);
    return 0;
}

# Entry (i, j) of the n-column matrix at m.
#must_use
fn at(m, n, i, j): f64 {
    var v: f64 = load64(m + 8 * (i * n + j));
    return v;
}

# ── the Rust tests ──────────────────────────────────────────────────────────────────

fn _t_stoich_matrix_basic() {
    test_group("stoich_matrix_basic");
    var m: f64[4];
    var t, v = stoichiometric_matrix(2, &rx, 1, &m, 4);
    var a: f64 = at(&m, 1, 0, 0);
    var b: f64 = at(&m, 1, 1, 0);
    assert(is_ok(t) == 1 && v == 2, "a 2 × 1 matrix");
    assert(a == -1.0, "A consumed");
    assert(b == 1.0, "B produced");
}

fn _t_stoich_matrix_two_reactions() {
    test_group("stoich_matrix_two_reactions");
    var m: f64[6];
    var t, v = stoichiometric_matrix(3, &rx, 2, &m, 6);
    assert(is_ok(t) == 1 && v == 6, "3 species × 2 reactions");
    assert(at(&m, 2, 0, 0) == -1.0 && at(&m, 2, 0, 1) == 0.0, "A: [-1, 0]");
    assert(at(&m, 2, 1, 0) == 1.0 && at(&m, 2, 1, 1) == -1.0, "B: [1, -1]");
    assert(at(&m, 2, 2, 0) == 0.0 && at(&m, 2, 2, 1) == 1.0, "C: [0, 1]");
}

fn _t_stoich_matrix_invalid_species() {
    test_group("stoich_matrix_invalid_species");
    var tt: i64[4];
    term(&tt, 5, 1.0);
    term(&tt + 16, 1, 1.0);
    var r1: i64[4];
    reaction(&r1, &tt, 1, &tt + 16, 1);
    var m: f64[4];
    var t, v = stoichiometric_matrix(2, &r1, 1, &m, 4);
    assert(is_err_code(t, v, KM_ERR_INVALID_INPUT) == 1, "species 5 of 2: InvalidInput");
}

fn _t_sparse_matrix_basic() {
    test_group("sparse_matrix_basic");
    var t, csr = sparse_stoichiometric_matrix(2, &rx, 1);
    assert(is_ok(t) == 1 && csr_nrows(csr) == 2, "nrows = 2");
}

fn _t_network_rank_independent_reactions() {
    test_group("network_rank_independent_reactions");
    var m: f64[6];
    var t, v = stoichiometric_matrix(3, &rx, 2, &m, 6);
    var t2, r = reaction_network_rank(&m, 3, 2);
    assert(is_ok(t) == 1 && is_ok(t2) == 1 && r == 2, "A → B, B → C: rank 2");
}

fn _t_conservation_laws_abc() {
    test_group("conservation_laws_abc");
    assert(conservation_law_count(3, 2) == 1, "A → B → C: one conservation law");
}

fn _t_rate_from_stoich_basic() {
    test_group("rate_from_stoich_basic");
    var m: f64[2];
    var t, v = stoichiometric_matrix(2, &rx, 1, &m, 2);
    var rates: f64[1];
    rates[0] = 0.5;
    var dx: f64[2];
    var t2, v2 = rate_from_stoichiometry(&m, 2, 1, &rates, 1, &dx, 2);
    var a: f64 = dx[0];
    var b: f64 = dx[1];
    assert(is_ok(t2) == 1 && v2 == 2, "two species");
    assert(a == -0.5, "A consumed");
    assert(b == 0.5, "B produced");
}

fn _t_rate_dimension_mismatch() {
    test_group("rate_dimension_mismatch");
    var m: f64[2];
    var t, v = stoichiometric_matrix(2, &rx, 1, &m, 2);
    var rates: f64[2];
    rates[0] = 0.5;
    rates[1] = 0.3;
    var dx: f64[2];
    var t2, v2 = rate_from_stoichiometry(&m, 2, 1, &rates, 2, &dx, 2);
    assert(is_err_code(t2, v2, KM_ERR_INVALID_INPUT) == 1, "2 rates for 1 reaction");
}

# Adapted: a flat matrix has one row length, so the nearest case is a rate vector of another length than every row.
fn _t_rate_ragged_matrix_is_error() {
    test_group("rate_ragged_matrix_is_error");
    var m: f64[6];
    m[0] = -1.0;
    m[1] = 0.0;
    m[2] = 1.0;
    m[3] = -1.0;
    var rates: f64[3];
    rates[0] = 0.5;
    rates[1] = 0.3;
    rates[2] = 7.0;
    var dx: f64[2];
    var t, v = rate_from_stoichiometry(&m, 2, 2, &rates, 3, &dx, 2);
    assert(is_err_code(t, v, KM_ERR_INVALID_INPUT) == 1, "rows of 2, 3 rates");
    var t2, v2 = rate_from_stoichiometry(&m, 2, 2, &rates, 1, &dx, 2);
    assert(is_err_code(t2, v2, KM_ERR_INVALID_INPUT) == 1, "rows of 2, 1 rate");
    var t3, v3 = rate_from_stoichiometry(&m, 2, 2, &rates, 2, &dx, 2);
    assert(is_ok(t3) == 1 && v3 == 2, "rows of 2, 2 rates");
}

fn _t_rate_empty_matrix_is_error() {
    test_group("rate_empty_matrix_is_error");
    var rates: f64[1];
    rates[0] = 1.0;
    var dx: f64[1];
    var t, v = rate_from_stoichiometry(0, 0, 0, 0, 0, &dx, 1);
    assert(is_err_code(t, v, KM_ERR_INVALID_INPUT) == 1, "empty, no rates");
    var t2, v2 = rate_from_stoichiometry(0, 0, 0, &rates, 1, &dx, 1);
    assert(is_err_code(t2, v2, KM_ERR_INVALID_INPUT) == 1, "empty, one rate");
}

# ── Cyrius-only ─────────────────────────────────────────────────────────────────────

# The records and the caller's buffer: malformed records (a negative count, a null list with terms, a null reaction
# list) are InvalidInput; Rust's errors come before the capacity check; a matrix that does not fit leaves `out` alone.
fn _t_cyrius_records_and_buffers() {
    test_group("cyrius_records_and_buffers");
    var m: f64[8];
    var i = 0;
    while (i < 8) {
        m[i] = 777.0;
        i = i + 1;
    }
    var t, v = stoichiometric_matrix(3, &rx, 2, &m, 5);
    var m0: f64 = m[0];
    assert(is_err_code(t, v, KM_ERR_INVALID_INPUT) == 1 && m0 == 777.0, "6 entries in 5: InvalidInput, untouched");
    var t1, v1 = stoichiometric_matrix(3, &rx, 2, 0, 0);
    assert(is_err_code(t1, v1, KM_ERR_INVALID_INPUT) == 1, "a null out");
    var t2, v2 = stoichiometric_matrix(3, 0, 2, &m, 8);
    assert(is_err_code(t2, v2, KM_ERR_INVALID_INPUT) == 1, "a null reaction list with reactions");
    var t3, v3 = stoichiometric_matrix(3, &rx, 0 - 1, &m, 8);
    assert(is_err_code(t3, v3, KM_ERR_INVALID_INPUT) == 1, "a negative reaction count");
    var bad: i64[4];
    reaction(&bad, 0, 1, &terms, 1);
    var t4, v4 = stoichiometric_matrix(3, &bad, 1, &m, 8);
    assert(is_err_code(t4, v4, KM_ERR_INVALID_INPUT) == 1, "a null reactant list with a term");
    reaction(&bad, &terms, 0 - 2, &terms, 1);
    var t5, v5 = sparse_stoichiometric_matrix(3, &bad, 1);
    assert(is_err_code(t5, v5, KM_ERR_INVALID_INPUT) == 1, "a negative term count");
    var none: i64[4];
    reaction(&none, 0, 0, 0, 0);
    var t6, v6 = stoichiometric_matrix(1, &none, 1, &m, 8);
    var z: f64 = m[0];
    assert(is_ok(t6) == 1 && v6 == 1 && z == 0.0, "an empty reaction: a zero column");
    var t7, v7 = stoichiometric_matrix(0 - 1, &rx, 2, &m, 8);
    assert(is_err_code(t7, v7, KM_ERR_INVALID_INPUT) == 1, "n_species past 2⁶³: every index in range, no fit");
    var t8, v8 = sparse_stoichiometric_matrix(0 - 1, &rx, 2);
    assert(is_err_code(t8, v8, KM_ERR_COMPUTATION_ERROR) == 1, "n_species past 2⁶³: the dense table can't be made");
    var tt: i64[2];
    term(&tt, 0 - 1, 1.0);
    var r1: i64[4];
    reaction(&r1, &tt, 1, 0, 0);
    var t9, v9 = stoichiometric_matrix(3, &r1, 1, &m, 8);
    assert(is_err_code(t9, v9, KM_ERR_INVALID_INPUT) == 1, "species index usize::MAX: out of range");
}

# hisab 1.4.0's CSR threshold: |v| > 10⁻¹² is stored, to the ulp; NaN, ±0 and 10⁻¹² itself are dropped, ±∞ kept.
fn _t_cyrius_csr_threshold() {
    test_group("cyrius_csr_threshold");
    var eps: f64 = 0x3D719799812DEA11;      # 1e-12
    var up: f64 = 0x3D719799812DEA12;       # the next double up
    var tt: i64[12];
    term(&tt, 0, eps);
    term(&tt + 16, 1, up);
    term(&tt + 32, 2, nan());
    term(&tt + 48, 3, -0.0);
    var big: f64 = 0x7FF0000000000000;
    term(&tt + 64, 4, big);
    var r1: i64[4];
    reaction(&r1, 0, 0, &tt, 5);
    var t, csr = sparse_stoichiometric_matrix(5, &r1, 1);
    assert(is_ok(t) == 1 && csr_nnz(csr) == 2, "two stored: 10⁻¹² + 1 ulp and +∞");
    var rp = csr_row_ptr(csr);
    var ci = csr_col_idx(csr);
    var c0: f64 = load64(csr_values(csr));
    assert(load64(rp + 8) == 0 && load64(rp + 16) == 1 && load64(rp + 40) == 2, "row offsets 0, 0, 1, 1, 1, 2");
    assert(load64(ci) == 0 && c0 == up, "row 1's entry");
    # hisab 3.4.1's own conversion keeps every nonzero entry: the reason for the transcription.
    var dm = ganita_mat_new(5, 1);
    ganita_mat_set(dm, 0, 0, eps);
    ganita_mat_set(dm, 2, 0, nan());
    var h = csr_from_dense(dm);
    assert(csr_nnz(h) == 2, "csr_from_dense stores 10⁻¹² and NaN");
}

# The transcribed rank: hisab 1.4.0's Jacobi does not converge on Chapman's ozone cycle (Rust's ComputationError, which
# hisab 3.4.1's SVD would answer), the 10⁻¹⁰ threshold is strict, a wide matrix is its transpose, a single column's
# non-finite norm counts as Rust's does, and an empty matrix is an Err.
fn _t_cyrius_rank_transcription() {
    test_group("cyrius_rank_transcription");
    var ch: f64[12];                         # O, O₂, O₃ × the four reactions (rows = species)
    ch[0] = 2.0;
    ch[1] = -1.0;
    ch[2] = 1.0;
    ch[3] = -1.0;
    ch[4] = -1.0;
    ch[5] = -1.0;
    ch[6] = 1.0;
    ch[7] = 2.0;
    ch[8] = 0.0;
    ch[9] = 1.0;
    ch[10] = -1.0;
    ch[11] = -1.0;
    var t, v = reaction_network_rank(&ch, 3, 4);
    assert(is_err_code(t, v, KM_ERR_COMPUTATION_ERROR) == 1, "Chapman: NoConvergence after 400 sweeps");
    var thr: f64 = 0.0000000001;
    var a: f64[1];
    a[0] = thr;
    var t1, r1 = reaction_network_rank(&a, 1, 1);
    assert(is_ok(t1) == 1 && r1 == 0, "σ = 10⁻¹⁰ is not counted");
    var up: f64 = 0x3DDB7CDFD9D7BDBC;
    a[0] = up;
    var t2, r2 = reaction_network_rank(&a, 1, 1);
    assert(is_ok(t2) == 1 && r2 == 1, "one ulp above: counted");
    var w: f64[6];
    w[0] = 1.0;
    w[1] = 0.0;
    w[2] = 0.0;
    w[3] = 0.0;
    w[4] = 0.0;
    w[5] = 3.0;
    var t3, r3 = reaction_network_rank(&w, 2, 3);
    var t4, r4 = reaction_network_rank(&w, 3, 2);
    assert(is_ok(t3) == 1 && is_ok(t4) == 1 && r3 == 2 && r4 == 2, "a wide matrix and a tall one");
    var c: f64[3];
    c[0] = 0x7FF0000000000000;
    c[1] = 0.0;
    c[2] = 1.0;
    var t5, r5 = reaction_network_rank(&c, 3, 1);
    assert(is_ok(t5) == 1 && r5 == 1, "a single column with +∞: its norm +∞ counts");
    c[0] = nan();
    var t6, r6 = reaction_network_rank(&c, 3, 1);
    assert(is_ok(t6) == 1 && r6 == 0, "a single column with NaN: its NaN norm does not");
    var t7, v7 = reaction_network_rank(&c, 0, 0);
    assert(is_err_code(t7, v7, KM_ERR_COMPUTATION_ERROR) == 1, "the empty matrix");
    var t8, v8 = reaction_network_rank(&c, 2, 0);
    assert(is_err_code(t8, v8, KM_ERR_COMPUTATION_ERROR) == 1, "rows of length 0");
    var t9, v9 = reaction_network_rank(0, 2, 2);
    assert(is_err_code(t9, v9, KM_ERR_INVALID_INPUT) == 1, "a null matrix with entries");
    var t10, v10 = reaction_network_rank(&c, 0 - 1, 1);
    assert(is_err_code(t10, v10, KM_ERR_INVALID_INPUT) == 1, "a negative dimension");
}

# The usize words: conservation_law_count saturates as an unsigned subtraction; rate_from_stoichiometry's empty-row sum
# is −0.0 (Rust's `.sum()`).
fn _t_cyrius_usize_words() {
    test_group("cyrius_usize_words");
    assert(conservation_law_count(2, 3) == 0, "rank above n_species: 0");
    assert(conservation_law_count(0 - 1, 1) == 0 - 2, "usize::MAX − 1");
    assert(conservation_law_count(5, 0 - 1) == 0, "rank usize::MAX: 0");
    assert(conservation_law_count(0 - 1, 0 - 1) == 0, "usize::MAX − usize::MAX");
    var dx: f64[2];
    var t, v = rate_from_stoichiometry(0, 2, 0, 0, 0, &dx, 2);
    var a: f64 = dx[0];
    assert(is_ok(t) == 1 && v == 2 && _km_bits(a) == 0x8000000000000000, "rows of length 0: −0.0");
    var t2, v2 = rate_from_stoichiometry(0, 2, 0, 0, 0, &dx, 1);
    assert(is_err_code(t2, v2, KM_ERR_INVALID_INPUT) == 1, "2 rates in a buffer of 1");
}

# 2.0.1: sparse_stoichiometric_matrix's dense table (past 256 entries) comes from src/validate.cyr's pool, so a call
# allocates only the CSR handle it returns (the caller's), the same bytes as compressing the dense matrix alone, and
# every slot is given back.
fn _t_cyrius_201_no_growth() {
    test_group("cyrius_201_no_growth");
    var tt: i64[4];
    term(&tt, 0, 1.0);
    term(&tt + 16, 1, 1.0);
    var rx = alloc(32 * 60);
    var j = 0;
    while (j < 60) {
        reaction(rx + 32 * j, &tt, 1, &tt + 16, 1);
        j = j + 1;
    }
    var dense = alloc(8 * 300);
    var dt, dv = stoichiometric_matrix(5, rx, 60, dense, 300);
    assert(is_ok(dt) == 1 && dv == 300, "the dense 5 × 60 matrix");
    var a0 = alloc_used();
    var h = _km_csr_from_dense(dense, 5, 60);
    var csr_bytes = alloc_used() - a0;
    assert(h != 0 && csr_bytes > 0, "the CSR alone");
    var t0, c0 = sparse_stoichiometric_matrix(5, rx, 60);
    var round = 0;
    while (round < 3) {
        var u0 = alloc_used();
        var t, c = sparse_stoichiometric_matrix(5, rx, 60);
        assert(is_ok(t) == 1 && csr_nnz(c) == 120, "Ok, 120 entries");
        assert_eq(alloc_used() - u0, csr_bytes, "a call allocates the returned CSR only");
        assert(_km_scratch_claimed() == 0, "every slot given back");
        round = round + 1;
    }
}

# 2.0.1: stoichiometric_matrix zeroes the matrix before it reads the reaction records, so a matrix at `out` that
# overlaps the records or a term list, in place included, is Err(InvalidInput), the records untouched (it used to read
# zeroed or overwritten records: a wrong matrix, or a fault on a garbage term pointer); an `out` ending at the
# records or starting just past the term lists gives the separate buffer's matrix.
fn _t_cyrius_201_stoichiometric_matrix_overlap() {
    test_group("cyrius_201_stoichiometric_matrix_overlap");
    var io = alloc(1024);
    var rr = io + 256;                      # the two reaction records (64 bytes)
    var tl = io + 512;                      # their four term lists, one term each (64 bytes)
    term(tl, 0, 1.0);
    term(tl + 16, 1, 1.0);
    term(tl + 32, 1, 1.0);
    term(tl + 48, 2, 1.0);
    reaction(rr, tl, 1, tl + 16, 1);
    reaction(rr + 32, tl + 32, 1, tl + 48, 1);
    var sep: f64[6];
    var t0, v0 = stoichiometric_matrix(3, rr, 2, &sep, 6);
    var b0: f64 = at(&sep, 2, 1, 0);
    var b1: f64 = at(&sep, 2, 1, 1);
    assert(is_ok(t0) == 1 && v0 == 6 && b0 == 1.0 && b1 == -1.0, "separate out: 3 × 2");
    var t1, v1 = stoichiometric_matrix(3, rr, 2, rr, 6);
    assert(is_err_code(t1, v1, KM_ERR_INVALID_INPUT) == 1, "in place (out = the records): InvalidInput");
    var t2, v2 = stoichiometric_matrix(3, rr, 2, rr + 40, 6);
    assert(is_err_code(t2, v2, KM_ERR_INVALID_INPUT) == 1, "out inside the records: InvalidInput");
    var t3, v3 = stoichiometric_matrix(3, rr, 2, rr - 47, 6);
    assert(is_err_code(t3, v3, KM_ERR_INVALID_INPUT) == 1, "the records' first byte inside out: InvalidInput");
    var t4, v4 = stoichiometric_matrix(3, rr, 2, tl + 48, 6);
    assert(is_err_code(t4, v4, KM_ERR_INVALID_INPUT) == 1, "out over the last term list: InvalidInput");
    var t5, v5 = stoichiometric_matrix(3, rr, 2, tl - 40, 6);
    assert(is_err_code(t5, v5, KM_ERR_INVALID_INPUT) == 1, "out over the first term list: InvalidInput");
    var t6, v6 = stoichiometric_matrix(3, rr, 2, tl + 1, 6);
    assert(is_err_code(t6, v6, KM_ERR_INVALID_INPUT) == 1, "a misaligned overlap: InvalidInput");
    var same = 1;
    if (load64(rr) != tl || load64(rr + 8) != 1 || load64(rr + 48) != tl + 48 || load64(rr + 56) != 1) { same = 0; }
    var c3: f64 = load64(tl + 56);
    if (load64(tl + 48) != 2 || c3 != 1.0) { same = 0; }
    assert(same == 1, "the records untouched by the refused calls");
    var t7, v7 = stoichiometric_matrix(3, rr, 2, rr - 48, 6);
    assert(is_ok(t7) == 1 && v7 == 6 && memeq(&sep, rr - 48, 48) == 1, "out ending at the records: Ok");
    var t8, v8 = stoichiometric_matrix(3, rr, 2, tl + 64, 6);
    assert(is_ok(t8) == 1 && v8 == 6 && memeq(&sep, tl + 64, 48) == 1, "out just past the term lists: Ok");
}

# 2.0.1: rate_from_stoichiometry reads every rate for each species, and row i + 1 after writing species i's rate, so an
# `out` overlapping the rates, or starting inside the matrix past its first entry, is Err(InvalidInput), the inputs
# untouched (it used to read rates and rows it had overwritten); out = the matrix (in place) and an `out` below it,
# overlapping, give the separate buffer's rates.
fn _t_cyrius_201_rate_overlap() {
    test_group("cyrius_201_rate_overlap");
    var io = alloc(1024);
    var mat = io + 256;                     # [−1, 0.5; 1, −2; 0, 1]
    var rates = io + 512;                   # [0.25, 3]
    var sm: f64[6];
    sm[0] = -1.0; sm[1] = 0.5; sm[2] = 1.0; sm[3] = -2.0; sm[4] = 0.0; sm[5] = 1.0;
    var sr: f64[2];
    sr[0] = 0.25; sr[1] = 3.0;
    memcpy(mat, &sm, 48);
    memcpy(rates, &sr, 16);
    var sep: f64[3];
    var t0, v0 = rate_from_stoichiometry(mat, 3, 2, rates, 2, &sep, 3);
    var r0: f64 = sep[0];
    var r1: f64 = sep[1];
    var r2: f64 = sep[2];
    assert(is_ok(t0) == 1 && v0 == 3 && r0 == 1.25 && r1 == -5.75 && r2 == 3.0, "separate out: 3 rates");
    var t1, v1 = rate_from_stoichiometry(mat, 3, 2, rates, 2, mat, 3);
    assert(is_ok(t1) == 1 && v1 == 3 && memeq(&sep, mat, 24) == 1, "in place (out = the matrix) = separate buffer");
    memcpy(mat, &sm, 48);
    var t2, v2 = rate_from_stoichiometry(mat, 3, 2, rates, 2, mat - 16, 3);
    assert(is_ok(t2) == 1 && v2 == 3 && memeq(&sep, mat - 16, 24) == 1, "out = matrix − 16, overlapping: Ok");
    memcpy(mat, &sm, 48);
    var t3, v3 = rate_from_stoichiometry(mat, 3, 2, rates, 2, mat + 16, 3);
    assert(is_err_code(t3, v3, KM_ERR_INVALID_INPUT) == 1, "out inside the matrix (row 1): InvalidInput");
    var t4, v4 = rate_from_stoichiometry(mat, 3, 2, rates, 2, mat + 1, 3);
    assert(is_err_code(t4, v4, KM_ERR_INVALID_INPUT) == 1, "a misaligned overlap: InvalidInput");
    var t5, v5 = rate_from_stoichiometry(mat, 3, 2, rates, 2, rates, 3);
    assert(is_err_code(t5, v5, KM_ERR_INVALID_INPUT) == 1, "out = the rates: InvalidInput");
    var t6, v6 = rate_from_stoichiometry(mat, 3, 2, rates, 2, rates - 16, 3);
    assert(is_err_code(t6, v6, KM_ERR_INVALID_INPUT) == 1, "the rates' first value inside out: InvalidInput");
    var t7, v7 = rate_from_stoichiometry(mat, 3, 2, rates, 2, rates + 8, 3);
    assert(is_err_code(t7, v7, KM_ERR_INVALID_INPUT) == 1, "out over the last rate: InvalidInput");
    assert(memeq(mat, &sm, 48) == 1 && memeq(rates, &sr, 16) == 1, "the inputs untouched by the refused calls");
    var t8, v8 = rate_from_stoichiometry(mat, 3, 2, rates, 2, rates - 24, 3);
    assert(is_ok(t8) == 1 && memeq(&sep, rates - 24, 24) == 1, "out ending at the rates: Ok");
}

# Runs every test group; returns the failure count from assert_summary().
fn main(): i64 {
    setup();
    _t_stoich_matrix_basic();
    _t_stoich_matrix_two_reactions();
    _t_stoich_matrix_invalid_species();
    _t_sparse_matrix_basic();
    _t_network_rank_independent_reactions();
    _t_conservation_laws_abc();
    _t_rate_from_stoich_basic();
    _t_rate_dimension_mismatch();
    _t_rate_ragged_matrix_is_error();
    _t_rate_empty_matrix_is_error();
    _t_cyrius_records_and_buffers();
    _t_cyrius_csr_threshold();
    _t_cyrius_rank_transcription();
    _t_cyrius_usize_words();
    _t_cyrius_201_no_growth();
    _t_cyrius_201_stoichiometric_matrix_overlap();
    _t_cyrius_201_rate_overlap();
    return assert_summary();
}

var exit_code = main();
if (exit_code > 0) { exit_code = 1; }
sys_exit_group(exit_code);
