    0x400524EBAE943097, 0x3FDE000000000000, 0x3FF93BD0CD47EB5F,   # CRLIBM misrounded: 64 identical bits (glibc …EB60)
    0x40373608108BCCAB, 0x401E3FD27857DA6C, 0x4213CFE8012E1926,   # the fast test fails
