fn _t_trig_hard_cases() {
    test_group("cr_trig_hard_cases");
    var sent = check_tri(&_T_SC_HARD, 27, "sin / cos hard-to-round argument");
    assert_eq(sent, 18, "the fast test fails on the 2 midpoint-adjacent worst cases and the 16 found arguments");
}

