# _km_cr_sincos gives MPFR's sin and cos at the FFT angles, by the full function and the accurate pair alone, and
# _km_cr_sin's and _km_cr_cos's bits on seeded arguments over every binade and [−8, 8].
fn _t_sincos() {
    test_group("cr_sincos");
    var k = 0;
    while (k < 20) {
        var x: f64 = from_bits(load64(&_T_FFT + 24 * k));
        var ws = load64(&_T_FFT + 24 * k + 8);
        var wc = load64(&_T_FFT + 24 * k + 16);
        var s, c = _km_cr_sincos(x);
        assert_bits_eq(s, ws, "sincos(-2π/2^k): sin");
        assert_bits_eq(c, wc, "sincos(-2π/2^k): cos");
        var sa, ca = _km_cr_sincos_acc(x);
        assert_bits_eq(sa, ws, "sincos(-2π/2^k): sin (accurate path)");
        assert_bits_eq(ca, wc, "sincos(-2π/2^k): cos (accurate path)");
        var s1: f64 = _km_cr_sin(x);
        assert_bits_eq(s1, ws, "sin(-2π/2^k)");
        var c1: f64 = _km_cr_cos(x);
        assert_bits_eq(c1, wc, "cos(-2π/2^k)");
        k = k + 1;
    }
    var st = 0x9E3779B97F4A7C15;
    var u53: f64 = 0x3CA0000000000000;          # 2^-53
    var bad = 0;
    k = 0;
    while (k < 3000) {
        st = st ^ (st << 13);
        st = st ^ (st >> 7);
        st = st ^ (st << 17);
        var f: f64 = f64_from(st >> 11) * u53;
        var x2: f64 = (16.0 * f) - 8.0;
        if ((k & 1) == 1) { x2 = from_bits(((st >> 1) % 0x7FE0000000000000) | (st & 0x8000000000000000)); }
        var s2, c2 = _km_cr_sincos(x2);
        var s3: f64 = _km_cr_sin(x2);
        var c3: f64 = _km_cr_cos(x2);
        if (ulp_bits_match(_km_bits(s2), _km_bits(s3)) != 1) { bad = bad + 1; }
        if (ulp_bits_match(_km_bits(c2), _km_bits(c3)) != 1) { bad = bad + 1; }
        k = k + 1;
    }
    assert_eq(bad, 0, "sincos = (sin, cos) on 3,000 seeded arguments");
}

# atan2 values: subnormal quotients rounded once, exact midpoint quotients (atan(q) < q, so they round toward zero,
# not to even), quotients below half of 2^-1074, the tiny route's edge (|y/x| = 2^-60 against 2^-59), huge
# exponent differences, results near ±π and ±π/2, ±π/4 and ±3π/4, bond and dihedral angles where the fast test
# fails (found by cr_verify.py; fall-back rate 2·10^-5), and Lefèvre and Muller's arctan worst cases (Table 13) as
# atan2(y, 1), scaled, and inverted.
var _T_ATAN2: i64[114] = {
    0x3C48000000000000, 0x7F60000000000000, 0x0000000000000001,   # 3·2^-60 / 2^1015 = 1.5·2^-1074: toward zero
    0xBC48000000000000, 0x7F60000000000000, 0x8000000000000001,   # atan2(-2.602e-18, 3.511e+305)
    0x3C5C000000000000, 0x7F60000000000000, 0x0000000000000003,   # 7·2^-60 / 2^1015 = 3.5·2^-1074: to 3, not even
    0x3C44000000000000, 0x7F60000000000000, 0x0000000000000001,   # 5·2^-61 / 2^1015 = 1.25·2^-1074
    0x0000000000000001, 0x3FF8000000000000, 0x0000000000000001,   # 2^-1074 / 1.5: up to 2^-1074
    0x0000000000000001, 0x7FE0000000000000, 0x0000000000000000,   # atan2(4.941e-324, 8.988e+307) far below: +0
    0x0000000000000001, 0xFFE0000000000000, 0x400921FB54442D18,   # atan2(4.941e-324, -8.988e+307) = π
    0x0000000000000003, 0x4000000000000000, 0x0000000000000001,   # 3·2^-1074 / 2 = 1.5·2^-1074: to 2^-1074
    0x000FFFFFFFFFFFFF, 0x3FE0000000000000, 0x001FFFFFFFFFFFFE,   # atan2(2.225e-308, 0.5)
    0x01A56E1FC2F8F359, 0x4202A05F20000000, 0x000012688B70E62B,   # atan2(1e-300, 1e+10) subnormal
    0x3FF0000000000000, 0x7E37E43C8800759C, 0x01A56E1FC2F8F359,   # atan2(1, 1e+300)
    0x7E37E43C8800759C, 0x01A56E1FC2F8F359, 0x3FF921FB54442D18,   # atan2(1e+300, 1e-300) = π/2
    0x81A56E1FC2F8F359, 0xFE37E43C8800759C, 0xC00921FB54442D18,   # atan2(-1e-300, -1e+300) ≈ −π
    0x3FF0000000000000, 0x43B0000000000000, 0x3C30000000000000,   # atan2(1, 1.153e+18) 2^-60: the tiny route
    0x3FF0000000000000, 0x43A0000000000000, 0x3C40000000000000,   # atan2(1, 5.765e+17) 2^-59: the general route
    0x3FF0000000000000, 0xC3B0000000000000, 0x400921FB54442D18,   # atan2(1, -1.153e+18)
    0x43B0000000000000, 0x3FF0000000000000, 0x3FF921FB54442D18,   # atan2(1.153e+18, 1)
    0xC3B0000000000000, 0xBFF0000000000000, 0xBFF921FB54442D18,   # atan2(-1.153e+18, -1)
    0x3FF0000000000000, 0x3FF0000000000000, 0x3FE921FB54442D18,   # atan2(1, 1) = π/4
    0xBFF0000000000000, 0xBFF0000000000000, 0xC002D97C7F3321D2,   # atan2(-1, -1) = −3π/4
    0x16687E92154EF7AC, 0x16687E92154EF7AC, 0x3FE921FB54442D18,   # atan2(1e-200, 1e-200)
    0x3C1240C7947E7F9F, 0xBC38557EFC44D80A, 0x4007A65641DA3364,   # atan2(2.474e-19, -1.319e-18) a bond angle (metres)
    0x3FD346DB449BC850, 0xC0148F10C423B219, 0x4008AA19DE13F84B,   # atan2(0.3012, -5.14) a dihedral angle
    0xB6B2052C5C09DD05, 0x36B2052C5C09DD07, 0xBFE921FB54442D16,   # atan2(-3.156e-45, 3.156e-45) near −π/4
    0x3FE11680991029E3, 0xC000B9662D1BDCB4, 0x400721CCC8157B12,   # a bond angle (Å): the fast test fails
    0x3B92CF3345BB5CB0, 0x3B80F983F9D64F91, 0x3FF259C9B42B4D48,   # a bond angle (m): the fast test fails
    0xBFD642D379639CDD, 0x3FD4F2447342D681, 0xBFEA1B2A38D0570C,   # a dihedral angle: the fast test fails
    0xCC2AA35BEB3F114D, 0xCC3B63116502202E, 0xC00582F426CB2D86,   # atan2(-8.361e+58, -1.719e+59) the fast test fails
    0x3365F73B700AA590, 0xB38523D51CE98651, 0x4007197C507883BF,   # atan2(4.272e-61, -1.644e-60) the fast test fails
    0x42C7AE72E8326CFE, 0xC5B69619649ADD6B, 0x400921FB54442D07,   # near π: the fast test fails
    0x3EAE000000000546, 0x3FF0000000000000, 0x3EADFFFFFFFFFC7C,   # atan2(8.941e-07, 1) LM Table 13: 0 0^72
    0x3F422E8D75E2BC7F, 0x3FF0000000000000, 0x3F422E8D5694AD2C,   # atan2(0.0005549, 1) LM: 1 0^59, the fast test fails
    0x3FCA933FE176B375, 0x3FF0000000000000, 0x3FCA33F32AC5CEB5,   # atan2(0.2076, 1) LM Table 13: 1 1^55
    0x3FE7BA49F739829F, 0x3FF0000000000000, 0x3FE46AC372243536,   # atan2(0.7415, 1) LM Table 13: 0 0^55
    0x07022E8D75E2BC7F, 0x07B0000000000000, 0x3F422E8D5694AD2C,   # atan2(6.564e-275, 1.183e-271) the same, scaled
    0x3FF0000000000000, 0x3F422E8D75E2BC7F, 0x3FF91FB582995A83,   # atan2(1, 0.0005549) π/2 − arctan
    0x3EE4F8B588E368F1, 0x3FF0000000000000, 0x3EE4F8B588E06854,   # atan2(1e-05, 1) a bond angle near 0
    0x3CD203AF9EE75616, 0xBFF0000000000000, 0x400921FB54442D16,   # atan2(1e-15, -1) near π
};

fn _t_atan2_values() {
    test_group("cr_atan2_values");
    var sent = check_atan2(&_T_ATAN2, 38, "atan2 value");
    assert(sent >= 7, "the fast test fails on the 6 found arguments and the midpoint-adjacent arctan worst case");
}

# acos: (2, argument, expected). acos(1) = +0, acos(−1) = π and acos(±0) = π/2 rounded; |x| < 2^-56 gives π/2;
# the branch points 1/2 and 1/√2 (either side), 1 − 2^-53, Lefèvre and Muller's arccos worst case (Table 11:
# 1 1^62), arguments where the fast test fails (fall-back rate 1.4·10^-5), NaN for |x| > 1 and NaN.
var _T_ACOS: i64[96] = {
    2, 0x3FF0000000000000, 0x0000000000000000,   # acos(1) = +0
    2, 0xBFF0000000000000, 0x400921FB54442D18,   # acos(-1) = π
    2, 0x0000000000000000, 0x3FF921FB54442D18,   # acos(0) = π/2
    2, 0x8000000000000000, 0x3FF921FB54442D18,   # acos(-0) = π/2
    2, 0x3C6FFFFFFFFFFFFF, 0x3FF921FB54442D18,   # acos(1.3877787807814455e-17)
    2, 0x3C70000000000000, 0x3FF921FB54442D18,   # acos(1.3877787807814457e-17)
    2, 0xBC70000000000000, 0x3FF921FB54442D18,   # acos(-1.3877787807814457e-17)
    2, 0x0000000000000001, 0x3FF921FB54442D18,   # acos(4.9406564584124654e-324)
    2, 0x3FE0000000000000, 0x3FF0C152382D7366,   # acos(0.5)
    2, 0xBFE0000000000000, 0x4000C152382D7366,   # acos(-0.5)
    2, 0x3FE6A09E667F3BCD, 0x3FE921FB54442D18,   # acos(0.70710678118654757)
    2, 0x3FE6A09E667F3BCC, 0x3FE921FB54442D19,   # acos(0.70710678118654746)
    2, 0x3FEFFFFFFFFFFFFF, 0x3E50000000000000,   # acos(0.99999999999999989) (1 − 2^-53)
    2, 0xBFEFFFFFFFFFFFFF, 0x400921FB52442D18,   # acos(-0.99999999999999989)
    2, 0x3F4FD737BE914578, 0x3FF91E006D41D8D9,   # acos(0.00097170087713942168) LM Table 11: arccos 1 1^62
    2, 0x3FEFE6744FB2F338, 0x3FB438EB74E8E5BF,   # acos(0.9968816334363515)
    2, 0x3D382C6975598EE2, 0x3FF921FB54442B96,   # acos(8.5881467865955868e-14)
    2, 0x3FD000000000005B, 0x3FF51700E0C14B0E,   # acos(0.25000000000000505)
    2, 0xBFC5C12A6CADE308, 0x3FFBDD85F1CAEA2D,   # acos(-0.16995744997600348) the fast test fails
    2, 0x3FDFE5A69ED96C2C, 0x3FF0C8EC66B20C2D,   # acos(0.49839177620532626) the fast test fails
    2, 0x3FEFFE6474D1F246, 0x3F9449705FA5ED37,   # acos(0.99980376068521859) the fast test fails
    2, 0x3FEFFFFF82308CF1, 0x3F466EDBE79651E5,   # acos(0.99999976565996296) the fast test fails
    2, 0x3CE18D3094D8B41A, 0x3FF921FB54442D10,   # acos(1.948610444537385e-15) the fast test fails
    2, 0xBFEFFFFFFFF7FB1D, 0x400921F5AA628B57,   # acos(-0.99999999994165345) the fast test fails
    2, 0x3FB9999999999F3B, 0x3FF787B22CE3F535,   # acos(0.10000000000002) the fast test fails
    2, 0xBFED3F15C700F91D, 0x4005CA292E211AE5,   # acos(-0.91395081394128719) the fast test fails
    2, 0x3FD3333333333333, 0x3FF441F5ECBEEF59,   # acos(0.29999999999999999)
    2, 0xBFEFFFFFCA501ACB, 0x40092110DC45EA89,   # acos(-0.99999990000000005)
    2, 0x3FF0000000000001, 0x7FF8000000000000,     # acos(1 + 2^-52) = NaN
    2, 0xC000000000000000, 0x7FF8000000000000,     # acos(−2) = NaN
    2, 0x7FF0000000000000, 0x7FF8000000000000,     # acos(+∞) = NaN
    2, 0x7FF8000000000000, 0x7FF8000000000000      # acos(NaN) = NaN
};

fn _t_acos_values() {
    test_group("cr_acos_values");
    var sent = check_tri(&_T_ACOS, 32, "acos value");
    assert(sent >= 8, "the fast test fails on the 8 found arguments");
}

# The accurate paths give the full functions' bits on seeded arguments (sin and cos over [−8, 8] and every binade,
# atan2 over every quadrant and exponent difference, acos over [−1, 1]). (Until M4d this group also checked M2a's
# double-double _km_acos and _km_cos against them, bit-identical here and on cr_verify.py's 1,026,077 acos and 494,663
# cos arguments; M4d moved gas.cyr onto _km_cr_acos and _km_cr_cos and removed the two.)
fn _t_trig_accurate_path_agrees() {
    test_group("cr_trig_accurate_path_agrees");
    var st = 0x2545F4914F6CDD1D;
    var u53: f64 = 0x3CA0000000000000;          # 2^-53
    var bad = 0;
    var k = 0;
    while (k < 2000) {
        st = st ^ (st << 13);
        st = st ^ (st >> 7);
        st = st ^ (st << 17);
        var f: f64 = f64_from(st >> 11) * u53;
        var x: f64 = (16.0 * f) - 8.0;
        if ((k & 3) == 3) { x = from_bits(((st >> 1) % 0x7FE0000000000000) | (st & 0x8000000000000000)); }
        var fid = 0;
        while (fid < 2) {
            var y: f64 = tri(fid, 0, x);
            var z: f64 = tri(fid, 1, x);
            if (ulp_bits_match(_km_bits(y), _km_bits(z)) != 1) { bad = bad + 1; }
            fid = fid + 1;
        }
        var c: f64 = (2.0 * f) - 1.0;
        var a1: f64 = _km_cr_acos(c);
        var a2: f64 = _km_cr_acos_acc(c);
        if (ulp_bits_match(_km_bits(a1), _km_bits(a2)) != 1) { bad = bad + 1; }
        var yb = ((st >> 1) % 0x7FE0000000000000) | ((st << 1) & 0x8000000000000000);
        st = st ^ (st << 13);
        st = st ^ (st >> 7);
        st = st ^ (st << 17);
        var xb = ((st >> 1) % 0x7FE0000000000000) | (st & 0x8000000000000000);
        var ty: f64 = from_bits(yb);
        var tx: f64 = from_bits(xb);
        var t1: f64 = _km_cr_atan2(ty, tx);
        var t2: f64 = _km_cr_atan2_acc(ty, tx);
        if (ulp_bits_match(_km_bits(t1), _km_bits(t2)) != 1) { bad = bad + 1; }
        k = k + 1;
    }
    assert_eq(bad, 0, "fast and accurate paths agree on 2,000 seeded arguments each (sin, cos, atan2, acos)");
}

# x·2^y rounded once (M4d, ADR 0002 #13: nuclear's N₀/2ⁿ past the normal range): (x, y, expected) with MPFR's bits
# (mpfr_ref.scaled_exp2; the special values src/mathx.cyr's). x NaN, ±0, ±∞ give x; y NaN NaN; y = ±∞ IEEE's product;
# |y| > 2200 ±∞ or ±0 at once. Exact scalings round once at the subnormal grid, ties to even; a fractional y's 2^f is
# irrational, so never a tie. M4c's faithful N₀·CR(2⁻ᶠ)·2⁻ᵏ was one ulp off on three of these; the last eight are
# seeded pairs on which the fast test fails.
var _T_E2S: i64[171] = {
    0x0000000000000000, 0x4016000000000000, 0x0000000000000000,   # x = +0: x
    0x8000000000000000, 0xC008000000000000, 0x8000000000000000,   # x = −0: x
    0x7FF0000000000000, 0xC0B3880000000000, 0x7FF0000000000000,   # x = +∞: x
    0xFFF0000000000000, 0x3FD0000000000000, 0xFFF0000000000000,   # x = −∞: x
    0x7FF8000000000000, 0x3FF0000000000000, 0x7FF8000000000000,   # x NaN: NaN
    0x3FF0000000000000, 0x7FF8000000000000, 0x7FF8000000000000,   # y NaN: NaN
    0x4000000000000000, 0x7FF0000000000000, 0x7FF0000000000000,   # y = +∞: +∞
    0xC000000000000000, 0x7FF0000000000000, 0xFFF0000000000000,   # y = +∞: −∞
    0x0000000000000000, 0x7FF0000000000000, 0x7FF8000000000000,   # 0·2^+∞: NaN
    0x4008000000000000, 0xFFF0000000000000, 0x0000000000000000,   # y = −∞: +0
    0xC008000000000000, 0xFFF0000000000000, 0x8000000000000000,   # y = −∞: −0
    0x7FF0000000000000, 0xFFF0000000000000, 0x7FF8000000000000,   # ∞·2^−∞: NaN
    0x3FF8000000000000, 0x40A1310000000000, 0x7FF0000000000000,   # y > 2200: +∞
    0xBFF8000000000000, 0xC0A1310000000000, 0x8000000000000000,   # y < −2200: −0
    0x0000000000000001, 0x40A1300000000000, 0x7FF0000000000000,   # 2^−1074·2^2200 = 2^1126: +∞
    0x7FEFFFFFFFFFFFFF, 0xC0A1300000000000, 0x0000000000000000,   # DBL_MAX·2^−2200: 0
    0x408F400000000000, 0xC090CC0000000000, 0x00000000000001F4,   # 500·2^−1074
    0x3FF0000000000000, 0xC090CC0000000000, 0x0000000000000000,   # 2^−1075: a tie, to even 0
    0x4008000000000000, 0xC090CC0000000000, 0x0000000000000002,   # 1.5·2^−1074: a tie, to 2
    0x4014000000000000, 0xC090CC0000000000, 0x0000000000000002,   # 2.5·2^−1074: a tie, to 2
    0x401C000000000000, 0xC090CC0000000000, 0x0000000000000004,   # 3.5·2^−1074: a tie, to 4
    0x7FEFFFFFFFFFFFFF, 0xC090CC0000000000, 0x3CBFFFFFFFFFFFFF,   # DBL_MAX·2^−1075 exactly
    0x0000000000000001, 0x4090E00000000000, 0x4050000000000000,   # 2^−1074·2^1080 = 64
    0x0000000000000001, 0x40A0620000000000, 0x7FE0000000000000,   # 2^1023
    0x3FF0000000000000, 0x4090000000000000, 0x7FF0000000000000,   # 2^1024: +∞
    0x7FEFFFFFFFFFFFFF, 0x3FF0000000000000, 0x7FF0000000000000,   # 2·DBL_MAX: +∞
    0x7FEFFFFFFFFFFFFF, 0xBFF0000000000000, 0x7FDFFFFFFFFFFFFF,   # DBL_MAX/2, exact
    0x3FF8000000000000, 0xC090C80000000000, 0x0000000000000002,   # 1.5·2^−1074: a tie, to 2
    0x3FFFFFFFFFFFFFFF, 0xC08FF80000000000, 0x0010000000000000,   # (2 − 2^−52)·2^−1023: to 2^−1022
    0xC01A000000000000, 0x0000000000000000, 0xC01A000000000000,   # y = 0: x
    0x3FF0000000000000, 0x8000000000000000, 0x3FF0000000000000,   # y = −0: x
    0x3FF0000000000000, 0x3FE0000000000000, 0x3FF6A09E667F3BCD,   # √2
    0xC000000000000000, 0xBFE0000000000000, 0xBFF6A09E667F3BCD,   # −√2
    0x3FF0000000000000, 0xC090CA0000000000, 0x0000000000000001,   # 2^−1074.5 above the tie: 2^−1074
    0x3FF0000000000000, 0xC090CE0000000000, 0x0000000000000000,   # 2^−1075.5 below it: 0
    0x4008000000000000, 0xC090CA0000000000, 0x0000000000000002,   # 3·2^−1074.5: 2
    0x7FEFFFFFFFFFFFFF, 0xC08FF20000000000, 0x400AE89F995AD3AD,   # DBL_MAX·2^−1022.25 (M4c's faithful: …AC)
    0x7E37E43C8800759C, 0xC08FF20000000000, 0x3E54171F0DE63805,   # 1e300·2^−1022.25 (M4c's: …04)
    0x73D658E3AB795204, 0xC08FF40000000000, 0x33EF9A8F2D6A2BC1,   # 1e250·2^−1022.5 (M4c's: …C2)
    0x408F400000000000, 0xC090CD3333333333, 0x0000000000000196,   # a subnormal
    0xC23176592E000000, 0xC090E2CCCCCCCCCD, 0x800000002AFF49F0,   # a negative subnormal
    0x3DE12E0BE826D695, 0x409019999999999A, 0x7E46AB41D5750EA3,   # normal from tiny x
    0x7FEFFFFFFFFFFFFF, 0xC0A0638000000000, 0x0000000000000001,   # to 2^−1074
    0x0000000000000001, 0x40A0630000000000, 0x7FE6A09E667F3BCD,   # 2^1023.5
    0x7FEFFFFFFFFFFFFF, 0x3E7AD7F29ABCAF48, 0x7FF0000000000000,   # just above 2^1024·(1 − 2^−54): +∞
    0x3FF0000000000000, 0x0000000000000001, 0x3FF0000000000000,   # 2^(2^−1074): 1
    0x3FF0000000000000, 0x8000000000000001, 0x3FF0000000000000,   # 2^(−2^−1074): 1
    0x3FF0000000000000, 0xBFD3333333333333, 0x3FE9FDF8BCCE533E,   # 2^−0.3
    0x0008000000000000, 0xBFE8000000000000, 0x0004C1BF828C6DC5,   # a subnormal x
    0x110AD82239C0E57D, 0x407FD884AE880FC8, 0x30E369AC7397BB69,   # the fast test fails
    0x34B68A94E166E407, 0x4089CDA9DAFA9850, 0x68526906E46785C5,   # the fast test fails
    0x30872C16C0C598A3, 0xC0873782F7B5A20A, 0x02182C818EC674DD,   # the fast test fails
    0x5E2DCD1B9EA28321, 0xC0911C1FF4416282, 0x19BD29DD1A5E899D,   # the fast test fails
    0x4D4C1B6569F9F285, 0xC090BFA40EDEEDE7, 0x0A4DE96F41F1D10F,   # the fast test fails
    0x3625700084B21BD7, 0x407B59BF86770D88, 0x518059E814A22D91,   # the fast test fails
    0x0E94EE6650A6A58E, 0xC0654F9662A82A90, 0x03EDDDF19EDA4FF5,   # the fast test fails
    0x457632A2B4D74A2E, 0x4057C87DEB923EE0, 0x4B68560F072EE2E6    # the fast test fails
};

# Checks x·2^y = want, by the full function and the accurate path alone, and the fast path wherever its test passes.
fn _t_exp2_scaled_values() {
    test_group("cr_exp2_scaled_values");
    var k = 0;
    var sent = 0;
    while (k < 57) {
        var x: f64 = from_bits(load64(&_T_E2S + 24 * k));
        var y: f64 = from_bits(load64(&_T_E2S + 24 * k + 8));
        var want = load64(&_T_E2S + 24 * k + 16);
        var r: f64 = _km_cr_exp2_scaled(x, y);
        assert_bits_eq(r, want, "x·2^y");
        var a: f64 = _km_cr_exp2_scaled_acc(x, y);
        assert_bits_eq(a, want, "x·2^y, accurate path");
        var rf, ok = _km_cr_exp2_scaled_fast(x, y);
        if (ok == 0) { sent = sent + 1; }
        if (ok == 1) { assert_bits_eq(rf, want, "x·2^y, fast path"); }
        k = k + 1;
    }
    assert(sent >= 8, "the fast test fails on the eight found pairs");
}

# The accurate path gives the full function's bits on 4,000 seeded pairs: x over every binade, y over [−2200, 2200], and
# nuclear's edge (y = −n, n past 1022 or −1024, x of every magnitude).
fn _t_exp2_scaled_agrees() {
    test_group("cr_exp2_scaled_agrees");
    var st = 0x9E3779B97F4A7C15;
    var u53: f64 = 0x3CA0000000000000;          # 2^-53
    var bad = 0;
    var k = 0;
    while (k < 4000) {
        st = st ^ (st << 13);
        st = st ^ (st >> 7);
        st = st ^ (st << 17);
        var xb = ((st >> 1) % 0x7FE0000000000000) | (st & 0x8000000000000000);
        st = st ^ (st << 13);
        st = st ^ (st >> 7);
        st = st ^ (st << 17);
        var g: f64 = f64_from(st >> 11) * u53;
        var x: f64 = from_bits(xb);
        var y: f64 = (g * 4400.0) - 2200.0;
        if ((k & 1) == 1) {
            y = -(1022.0 + (g * 178.0));
            if ((k & 2) == 2) { y = 1024.0 + (g * 176.0); }
        }
        var r: f64 = _km_cr_exp2_scaled(x, y);
        var a: f64 = _km_cr_exp2_scaled_acc(x, y);
        if (ulp_bits_match(_km_bits(r), _km_bits(a)) != 1) { bad = bad + 1; }
        k = k + 1;
    }
    assert_eq(bad, 0, "fast and accurate paths agree on 4,000 seeded pairs");
}

# Runs every test group; returns the failure count from assert_summary().
fn main() {
    _t_special_values();
    _t_exact_cases();
    _t_thresholds();
    _t_subnormal_results();
    _t_hard_cases();
    _t_accurate_path_agrees();
    _t_ln_values();
    _t_pow_special_values();
    _t_pow_exact_and_midpoint();
    _t_pow_hard_cases();
    _t_pow_agreement();
    _t_trig_special_values();
    _t_trig_hard_cases();
    _t_trig_payne_hanek();
    _t_sincos();
    _t_atan2_values();
    _t_acos_values();
    _t_trig_accurate_path_agrees();
    _t_exp2_scaled_values();
    _t_exp2_scaled_agrees();
    return assert_summary();
}

var exit_code = main();
if (exit_code > 0) { exit_code = 1; }
sys_exit_group(exit_code);
