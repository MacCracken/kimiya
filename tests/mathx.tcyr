    0xBEE921FB54442D18, 0xBEE921FB544197A0, 0x3FEFFFFFFFF62162,   # -2π/2^19
    0xBED921FB54442D18, 0xBED921FB544387BA, 0x3FEFFFFFFFFD8858,   # -2π/2^20
