    0xBF4921FB54442D18, 0xBF4921FB2AECB360, 0x3FEFFFFF62161A34,   # -2π/2^13
    0xBF3921FB54442D18, 0xBF3921FB49EE4EA6, 0x3FEFFFFFD8858675,   # -2π/2^14
    0xBF2921FB54442D18, 0xBF2921FB51AEB57B, 0x3FEFFFFFF621619C,   # -2π/2^15
