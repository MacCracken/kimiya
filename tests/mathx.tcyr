fn _t_trig_payne_hanek() {
    test_group("cr_trig_payne_hanek");
    var sent = check_tri(&_T_SC_PH, 22, "sin / cos of a Payne–Hanek argument");
    # The reduction keeps 2^-150 relative accuracy even 4.7·10^-19 from a multiple of π/2, so the fast test passes.
    assert_eq(sent, 0, "the fast test passes on every Payne–Hanek row");
}

