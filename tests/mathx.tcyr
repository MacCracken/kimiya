# Checks pow(x, y) = want, by the full function and by the accurate path alone, for n triples at t.
fn check_pow_table(t, n, name) {
    var k = 0;
    while (k < n) {
        var x: f64 = from_bits(load64(t + 24 * k));
        var y: f64 = from_bits(load64(t + 24 * k + 8));
        var want = load64(t + 24 * k + 16);
        var r: f64 = _km_cr_pow(x, y);
        assert_bits_eq(r, want, name);
        var a: f64 = _km_cr_pow_acc(x, y);
        assert_bits_eq(a, want, name);
        k = k + 1;
    }
}

# C99 Annex F's special values (glibc's and MPFR's agree on every one).
fn _t_pow_special_values() {
    test_group("cr_pow_special_values");
    check_pow_table(&_T_POW_SPECIAL, 51, "pow special value");
}

# Exact results and exact midpoints: subnormal ties (3·2^-215)^5 = 121.5·2^-1074 to even 122, (9·2^-430)^2.5,
# 0.5^1075 = 2^-1075 to +0; 54-bit midpoints 10^23, 5^23, 3^34, 262143^3; perfect squares and 32nd powers with
# dyadic y; y = RN(1/3), never exact. glibc misrounds the midpoints; _km_pow_exact rounds them exactly.
fn _t_pow_exact_and_midpoint() {
    test_group("cr_pow_exact_and_midpoint");
    check_pow_table(&_T_POW_EXACT, 32, "pow exact or midpoint result");
}

# The published hard cases (ARITH 2023), arguments found with the fast test failing, and the benches' arguments.
fn _t_pow_hard_cases() {
    test_group("cr_pow_hard_cases");
    check_pow_table(&_T_POW_HARD, 15, "pow hard-to-round argument");
    var k = 0;
    var sent = 0;
    while (k < 15) {
        var x: f64 = from_bits(load64(&_T_POW_HARD + 24 * k));
        var y: f64 = from_bits(load64(&_T_POW_HARD + 24 * k + 8));
        var r: f64 = _km_cr_pow(x, y);
        var rf, ok = _km_cr_pow_fast(x, y);
        if (ok == 0) { sent = sent + 1; }
        if (ok == 1) { assert_bits_eq(rf, r, "pow's fast path result is the function's"); }
        k = k + 1;
    }
    assert(sent >= 6, "the fast test fails on the found pow arguments");
    var tie, tok = _km_cr_pow_fast(from_bits(0x3298000000000000), 5.0);
    assert_eq(tok, 0, "the fast test fails on the subnormal tie (3·2^-215)^5");
}

# The accurate path agrees with the full function on seeded (x, y) and on x^2.5 (Redlich–Kwong's Tc^2.5, which
# gas.cyr calls as _km_cr_pow(x, 2.5) since M3c-3, in place of ADR 0005's double-double _km_pow_2_5), and
# pow(10, x) is exp10(x).
fn _t_pow_agreement() {
    test_group("cr_pow_agreement");
    var s = 0x5DEECE66D2545F49;
    var u53: f64 = 0x3CA0000000000000;          # 2^-53
    var bad = 0;
    var bad10 = 0;
    var bad25 = 0;
    var k = 0;
    while (k < 2000) {
        s = s ^ (s << 13);
        s = s ^ (s >> 7);
        s = s ^ (s << 17);
        var f: f64 = f64_from(s >> 11) * u53;
        var b = ((s >> 1) % 0x7FE0000000000000) + 1;
        var x: f64 = from_bits(b);
        var lx: f64 = _km_cr_ln(x);
        var t: f64 = (1450.0 * f) - 745.0;
        var y: f64 = t / lx;
        if ((k & 3) == 1) { y = (20.0 * f) - 10.0; }
        if ((k & 3) == 2) { y = f64_from((s >> 20) % 61) - 30.0; }
        var r: f64 = _km_cr_pow(x, y);
        var a: f64 = _km_cr_pow_acc(x, y);
        if (ulp_bits_match(_km_bits(r), _km_bits(a)) != 1) { bad = bad + 1; }
        var z: f64 = (630.0 * f) - 324.0;
        var ten: f64 = 10.0;
        var p10: f64 = _km_cr_pow(ten, z);
        var e10: f64 = _km_cr_exp10(z);
        if (ulp_bits_match(_km_bits(p10), _km_bits(e10)) != 1) { bad10 = bad10 + 1; }
        var x25: f64 = from_bits(0x2510000000000000 + ((s >> 4) % 0x3480000000000000));   # 2^-430 … 2^410
        var two5: f64 = 2.5;
        var c25: f64 = _km_cr_pow(x25, two5);
        var a25: f64 = _km_cr_pow_acc(x25, two5);
        if (ulp_bits_match(_km_bits(c25), _km_bits(a25)) != 1) { bad25 = bad25 + 1; }
        k = k + 1;
    }
    assert_eq(bad, 0, "pow's fast and accurate paths agree on 2,000 seeded pairs");
    assert_eq(bad10, 0, "pow(10, x) = exp10(x) on 2,000 seeded x");
    assert_eq(bad25, 0, "pow(x, 2.5): fast and accurate paths agree on 2,000 seeded x from 2^-430 to 2^410");
}

# ln at an argument where glibc 2.44 misrounds (…7a; MPFR …79) and at 0.1 (ADR 0005's _km_ln, which gas and
# electrochemistry called until M3c-3, was a wrapper of _km_cr_ln).
fn _t_ln_values() {
    test_group("cr_ln_values");
    var a: f64 = 1.7602758701689474;
    var r: f64 = _km_cr_ln(a);
    assert_bits_eq(r, 0x3FE21855AD272D79, "ln(1.7602758701689474)");
    var b: f64 = 0.1;
    var rb: f64 = _km_cr_ln(b);
    assert_bits_eq(rb, 0xC0026BB1BBB55515, "ln(0.1) (MPFR; 0.1 is not 1/10, so not -ln 10 rounded)");
}

# ── M4a: sin, cos, sincos, atan2 and acos ───────────────────────────────────────────────────────

# f(x) by the id: 0 sin, 1 cos, 2 acos; acc = 1 for the accurate path alone.
#must_use
fn tri(fid, acc, x: f64): f64 {
    if (acc == 0) {
        if (fid == 0) { var a: f64 = _km_cr_sin(x); return a; }
        if (fid == 1) { var b: f64 = _km_cr_cos(x); return b; }
        var c: f64 = _km_cr_acos(x);
        return c;
    }
    if (fid == 0) { var d: f64 = _km_cr_sin_acc(x); return d; }
    if (fid == 1) { var e: f64 = _km_cr_cos_acc(x); return e; }
    var f: f64 = _km_cr_acos_acc(x);
    return f;
}

# The fast path alone: (its result, 1), or (0, 0) when its rounding test fails.
#must_use
fn trif(fid, x: f64): (f64, i64) {
    if (fid == 0) { var a, oa = _km_cr_sin_fast(x); return (a, oa); }
    if (fid == 1) { var b, ob = _km_cr_cos_fast(x); return (b, ob); }
    var c, oc = _km_cr_acos_fast(x);
    return (c, oc);
}

# Checks the `n` (id, argument, expected) rows at `t` by the full function, the accurate path alone and, where
# its test passes, the fast path; returns how many rows the fast test sends to the accurate path.
#must_use
fn check_tri(t, n, name): i64 {
    var k = 0;
    var sent = 0;
    while (k < n) {
        var fid = load64(t + 24 * k);
        var x: f64 = from_bits(load64(t + 24 * k + 8));
        var want = load64(t + 24 * k + 16);
        var y: f64 = tri(fid, 0, x);
        assert_bits_eq(y, want, name);
        var z: f64 = tri(fid, 1, x);
        assert_bits_eq(z, want, name);
        var yf, ok = trif(fid, x);
        if (ok == 0) { sent = sent + 1; }
        if (ok == 1) { assert_bits_eq(yf, want, name); }
        k = k + 1;
    }
    return sent;
}

# The same for `n` (y, x, expected) rows of atan2.
#must_use
fn check_atan2(t, n, name): i64 {
    var k = 0;
    var sent = 0;
    while (k < n) {
        var y: f64 = from_bits(load64(t + 24 * k));
        var x: f64 = from_bits(load64(t + 24 * k + 8));
        var want = load64(t + 24 * k + 16);
        var r: f64 = _km_cr_atan2(y, x);
        assert_bits_eq(r, want, name);
        var a: f64 = _km_cr_atan2_acc(y, x);
        assert_bits_eq(a, want, name);
        var rf, ok = _km_cr_atan2_fast(y, x);
        if (ok == 0) { sent = sent + 1; }
        if (ok == 1) { assert_bits_eq(rf, want, name); }
        k = k + 1;
    }
    return sent;
}

# sin and cos: (id, argument, expected) with MPFR's bits. ±0, ±∞, NaN, subnormals, the tiny ends (sin x = x below
# 2^-26, cos x = 1 below 2^-27, and cos at x = √2·2^-27 rounded either side, where 1 − x²/2 straddles the midpoint
# 1 − 2^-54), RN(π) and RN(π/2) (r is tiny: the accurate path), DBL_MAX, 1e22, and both sides of the
# Cody–Waite / Payne–Hanek switch at 2^20.
var _T_SC_SPECIAL: i64[126] = {
    0, 0x0000000000000000, 0x0000000000000000,   # sin(0)
    0, 0x8000000000000000, 0x8000000000000000,   # sin(-0)
    0, 0x7FF0000000000000, 0x7FF8000000000000,   # sin(inf) = NaN
    0, 0xFFF0000000000000, 0x7FF8000000000000,   # sin(-inf) = NaN
    0, 0x0000000000000001, 0x0000000000000001,   # sin(4.9406564584124654e-324)
    0, 0x8000000000000001, 0x8000000000000001,   # sin(-4.9406564584124654e-324)
    0, 0x3E4FFFFFFFFFFFFF, 0x3E4FFFFFFFFFFFFF,   # sin(1.4901161193847655e-08) (2^-26 − ulp)
    0, 0x3E50000000000000, 0x3E50000000000000,   # sin(1.4901161193847656e-08)
    0, 0xBE50000000000000, 0xBE50000000000000,   # sin(-1.4901161193847656e-08)
    0, 0x3E3FFFFFFFFFFFFF, 0x3E3FFFFFFFFFFFFF,   # sin(7.4505805969238273e-09) (2^-27 − ulp)
    0, 0x3E40000000000000, 0x3E40000000000000,   # sin(7.4505805969238281e-09)
    0, 0x3E46A09E667F3BCC, 0x3E46A09E667F3BCC,   # sin(1.0536712127723507e-08) (x²/2 just below 2^-54)
    0, 0x3E46A09E667F3BCD, 0x3E46A09E667F3BCD,   # sin(1.0536712127723509e-08) (x²/2 just above 2^-54)
    0, 0x400921FB54442D18, 0x3CA1A62633145C07,   # sin(3.1415926535897931) (RN(π))
    0, 0x3FF921FB54442D18, 0x3FF0000000000000,   # sin(1.5707963267948966) (RN(π/2))
    0, 0xBFF921FB54442D18, 0xBFF0000000000000,   # sin(-1.5707963267948966)
    0, 0x401921FB54442D18, 0xBCB1A62633145C07,   # sin(6.2831853071795862)
    0, 0x7FEFFFFFFFFFFFFF, 0x3F7452FC98B34E97,   # sin(1.7976931348623157e+308) (DBL_MAX)
    0, 0x4480F0CF064DD592, 0xBFEB453AB76BF397,   # sin(1e+22)
    0, 0x4130000000000000, 0x3FD526CCB2FC8656,   # sin(1048576) (the Payne–Hanek edge)
    0, 0x412FFFFFFFFFFFFF, 0x3FD526CCB2DE52A8,   # sin(1048575.9999999999) (the last Cody–Waite argument)
    1, 0x0000000000000000, 0x3FF0000000000000,   # cos(0)
    1, 0x8000000000000000, 0x3FF0000000000000,   # cos(-0)
    1, 0x7FF0000000000000, 0x7FF8000000000000,   # cos(inf) = NaN
    1, 0xFFF0000000000000, 0x7FF8000000000000,   # cos(-inf) = NaN
    1, 0x3E4FFFFFFFFFFFFF, 0x3FEFFFFFFFFFFFFF,   # cos(1.4901161193847655e-08) (2^-26 − ulp)
    1, 0x3E50000000000000, 0x3FEFFFFFFFFFFFFF,   # cos(1.4901161193847656e-08)
    1, 0xBE50000000000000, 0x3FEFFFFFFFFFFFFF,   # cos(-1.4901161193847656e-08)
    1, 0x3E3FFFFFFFFFFFFF, 0x3FF0000000000000,   # cos(7.4505805969238273e-09) (2^-27 − ulp)
    1, 0x3E40000000000000, 0x3FF0000000000000,   # cos(7.4505805969238281e-09)
    1, 0x3E46A09E667F3BCC, 0x3FF0000000000000,   # cos(1.0536712127723507e-08) (x²/2 just below 2^-54)
    1, 0x3E46A09E667F3BCD, 0x3FEFFFFFFFFFFFFF,   # cos(1.0536712127723509e-08) (x²/2 just above 2^-54)
    1, 0x400921FB54442D18, 0xBFF0000000000000,   # cos(3.1415926535897931) (RN(π))
    1, 0x3FF921FB54442D18, 0x3C91A62633145C07,   # cos(1.5707963267948966) (RN(π/2))
    1, 0xBFF921FB54442D18, 0x3C91A62633145C07,   # cos(-1.5707963267948966)
    1, 0x401921FB54442D18, 0x3FF0000000000000,   # cos(6.2831853071795862)
    1, 0x7FEFFFFFFFFFFFFF, 0xBFEFFFE62ECFAB75,   # cos(1.7976931348623157e+308) (DBL_MAX)
    1, 0x4480F0CF064DD592, 0x3FE0BE2CEF01C8F4,   # cos(1e+22)
    1, 0x4130000000000000, 0x3FEE33ADA92FE2AE,   # cos(1048576) (the Payne–Hanek edge)
    1, 0x412FFFFFFFFFFFFF, 0x3FEE33ADA9352C61,   # cos(1048575.9999999999) (the last Cody–Waite argument)
    0, 0x7FF8000000000000, 0x7FF8000000000000,     # sin(NaN) = NaN
    1, 0x7FF8000000000000, 0x7FF8000000000000      # cos(NaN) = NaN
};

# atan2's C99 Annex F special values, the sign and zero matrix included (glibc's and MPFR's agree on every one):
# atan2(±0, +0) = ±0, atan2(±0, −0) = ±π, atan2(±0, x < 0) = ±π, atan2(±0, x > 0) = ±0, atan2(y ≠ 0, ±0) = ±π/2,
# atan2(±∞, +∞) = ±π/4, atan2(±∞, −∞) = ±3π/4, atan2(±∞, finite) = ±π/2, atan2(finite, +∞) = ±0, atan2(finite, −∞)
# = ±π; a NaN argument gives NaN.
var _T_ATAN2_SPECIAL: i64[126] = {
    0x0000000000000000, 0x0000000000000000, 0x0000000000000000,   # atan2(0, 0)
    0x0000000000000000, 0x8000000000000000, 0x400921FB54442D18,   # atan2(0, -0)
    0x0000000000000000, 0x3FF0000000000000, 0x0000000000000000,   # atan2(0, 1)
    0x0000000000000000, 0xBFF0000000000000, 0x400921FB54442D18,   # atan2(0, -1)
    0x0000000000000000, 0x0000000000000001, 0x0000000000000000,   # atan2(0, 4.941e-324)
    0x0000000000000000, 0x8000000000000001, 0x400921FB54442D18,   # atan2(0, -4.941e-324)
    0x0000000000000000, 0x7FF0000000000000, 0x0000000000000000,   # atan2(0, inf)
    0x0000000000000000, 0xFFF0000000000000, 0x400921FB54442D18,   # atan2(0, -inf)
    0x8000000000000000, 0x0000000000000000, 0x8000000000000000,   # atan2(-0, 0)
    0x8000000000000000, 0x8000000000000000, 0xC00921FB54442D18,   # atan2(-0, -0)
    0x8000000000000000, 0x3FF0000000000000, 0x8000000000000000,   # atan2(-0, 1)
    0x8000000000000000, 0xBFF0000000000000, 0xC00921FB54442D18,   # atan2(-0, -1)
    0x8000000000000000, 0x0000000000000001, 0x8000000000000000,   # atan2(-0, 4.941e-324)
    0x8000000000000000, 0x8000000000000001, 0xC00921FB54442D18,   # atan2(-0, -4.941e-324)
    0x8000000000000000, 0x7FF0000000000000, 0x8000000000000000,   # atan2(-0, inf)
    0x8000000000000000, 0xFFF0000000000000, 0xC00921FB54442D18,   # atan2(-0, -inf)
    0x3FF0000000000000, 0x0000000000000000, 0x3FF921FB54442D18,   # atan2(1, 0) = ±π/2
    0x3FF0000000000000, 0x8000000000000000, 0x3FF921FB54442D18,   # atan2(1, -0) = ±π/2
    0xBFF0000000000000, 0x0000000000000000, 0xBFF921FB54442D18,   # atan2(-1, 0) = ±π/2
    0xBFF0000000000000, 0x8000000000000000, 0xBFF921FB54442D18,   # atan2(-1, -0) = ±π/2
    0x0000000000000001, 0x0000000000000000, 0x3FF921FB54442D18,   # atan2(4.941e-324, 0) = ±π/2
    0x0000000000000001, 0x8000000000000000, 0x3FF921FB54442D18,   # atan2(4.941e-324, -0) = ±π/2
    0x7FF0000000000000, 0x7FF0000000000000, 0x3FE921FB54442D18,   # atan2(inf, inf)
    0x7FF0000000000000, 0xFFF0000000000000, 0x4002D97C7F3321D2,   # atan2(inf, -inf)
    0x7FF0000000000000, 0x3FF0000000000000, 0x3FF921FB54442D18,   # atan2(inf, 1)
    0x7FF0000000000000, 0xBFF0000000000000, 0x3FF921FB54442D18,   # atan2(inf, -1)
    0x7FF0000000000000, 0x0000000000000000, 0x3FF921FB54442D18,   # atan2(inf, 0)
    0xFFF0000000000000, 0x7FF0000000000000, 0xBFE921FB54442D18,   # atan2(-inf, inf)
    0xFFF0000000000000, 0xFFF0000000000000, 0xC002D97C7F3321D2,   # atan2(-inf, -inf)
    0xFFF0000000000000, 0x3FF0000000000000, 0xBFF921FB54442D18,   # atan2(-inf, 1)
    0xFFF0000000000000, 0xBFF0000000000000, 0xBFF921FB54442D18,   # atan2(-inf, -1)
    0xFFF0000000000000, 0x0000000000000000, 0xBFF921FB54442D18,   # atan2(-inf, 0)
    0x3FF0000000000000, 0x7FF0000000000000, 0x0000000000000000,   # atan2(1, inf)
    0x3FF0000000000000, 0xFFF0000000000000, 0x400921FB54442D18,   # atan2(1, -inf)
    0xBFF0000000000000, 0x7FF0000000000000, 0x8000000000000000,   # atan2(-1, inf)
    0xBFF0000000000000, 0xFFF0000000000000, 0xC00921FB54442D18,   # atan2(-1, -inf)
    0x7FEFFFFFFFFFFFFF, 0x7FF0000000000000, 0x0000000000000000,   # atan2(1.798e+308, inf)
    0x7FEFFFFFFFFFFFFF, 0xFFF0000000000000, 0x400921FB54442D18,   # atan2(1.798e+308, -inf)
    0x7FF8000000000000, 0x3FF0000000000000, 0x7FF8000000000000,   # atan2(NaN, 1) = NaN
    0x3FF0000000000000, 0x7FF8000000000000, 0x7FF8000000000000,   # atan2(1, NaN) = NaN
    0x7FF8000000000000, 0x0000000000000000, 0x7FF8000000000000,   # atan2(NaN, +0) = NaN
    0x0000000000000000, 0x7FF8000000000000, 0x7FF8000000000000,   # atan2(+0, NaN) = NaN
};

fn _t_trig_special_values() {
    test_group("cr_trig_special_values");
    var s1 = check_tri(&_T_SC_SPECIAL, 42, "sin / cos special value");
    assert(s1 >= 2, "the fast test sends sin(RN(π)) and cos(RN(π/2)) to the accurate path");
    var s2 = check_atan2(&_T_ATAN2_SPECIAL, 42, "atan2 special value (C99 Annex F)");
    assert_eq(s2, 0, "atan2's special values never reach the accurate path");
}

