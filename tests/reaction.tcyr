# reaction.tcyr — the tests of rust-old/src/reaction.rs, ported one for one (each test_group is the
# Rust test's name), plus a Cyrius-only test of the Result error codes. Rust's `.unwrap()` is an
# Ok check, then the payload. The golden corpus separately checks every function over its grid
# (tests/parity.tcyr: gibbs_free_energy class B at 0 ulp, equilibrium_constant class C, K = 4).

include "tests/ulp.cyr"
include "src/error.cyr"
include "src/constants.cyr"
include "src/mathx_data.cyr"
include "src/mathx.cyr"
include "src/validate.cyr"
include "src/reaction.cyr"

alloc_init();

# 1 if |a - b| < eps.
#must_use
fn near(a: f64, b: f64, eps: f64): i64 {
    var d: f64 = f64_abs(a - b);
    if (d < eps) { return 1; }
    return 0;
}

# 1 if the Result (t, v) is Err(code).
#must_use
fn is_err_code(t, v, code): i64 {
    if (is_err_result(t) == 1 && v == code) { return 1; }
    return 0;
}

fn _t_gibbs_basic() {
    test_group("gibbs_basic");
    var t, v = gibbs_free_energy(-100000.0, 298.0, -200.0);
    assert_eq(is_ok(t), 1, "Ok");
    var dg: f64 = v;
    assert(near(dg, -40400.0, 0.000000001), "dG should be ~-40400");
}

fn _t_gibbs_zero_temp_is_error() {
    test_group("gibbs_zero_temp_is_error");
    var t, v = gibbs_free_energy(-100000.0, 0.0, -200.0);
    assert_eq(is_err_result(t), 1, "T = 0 is Err");
}

fn _t_gibbs_nan_is_error() {
    test_group("gibbs_nan_is_error");
    var nan: f64 = _km_nan();
    var inf: f64 = 1.0 / 0.0;
    var t1, v1 = gibbs_free_energy(-100000.0, nan, -200.0);
    assert(is_err_code(t1, v1, KM_ERR_INVALID_TEMPERATURE), "NaN T is InvalidTemperature");
    var t2, v2 = gibbs_free_energy(-100000.0, inf, -200.0);
    assert_eq(is_err_result(t2), 1, "inf T");
    var t3, v3 = gibbs_free_energy(nan, 298.0, -200.0);
    assert_eq(is_err_result(t3), 1, "NaN dH");
    var t4, v4 = gibbs_free_energy(-100000.0, 298.0, nan);
    assert_eq(is_err_result(t4), 1, "NaN dS");
}

fn _t_equilibrium_constant_nan_is_error() {
    test_group("equilibrium_constant_nan_is_error");
    var nan: f64 = _km_nan();
    var ninf: f64 = -1.0 / 0.0;
    var t1, v1 = equilibrium_constant(-5000.0, nan);
    assert(is_err_code(t1, v1, KM_ERR_INVALID_TEMPERATURE), "NaN T is InvalidTemperature");
    var t2, v2 = equilibrium_constant(nan, 298.0);
    assert_eq(is_err_result(t2), 1, "NaN dG");
    var t3, v3 = equilibrium_constant(ninf, 298.0);
    assert_eq(is_err_result(t3), 1, "-inf dG");
}

fn _t_equilibrium_constant_overflow_is_error() {
    test_group("equilibrium_constant_overflow_is_error");
    # −ΔG/RT = 2e6 / (8.314 × 298) ≈ 807 > ln(f64::MAX) ≈ 709.8
    var t1, v1 = equilibrium_constant(-2000000.0, 298.0);
    assert(is_err_code(t1, v1, KM_ERR_COMPUTATION_ERROR), "overflow is ComputationError");
    # Large positive ΔG underflows to 0, which is a valid limit.
    var t2, v2 = equilibrium_constant(2000000.0, 298.0);
    assert_eq(is_ok(t2), 1, "underflow is Ok");
    var k2: f64 = v2;
    var tiny: f64 = 0x01A56E1FC2F8F359;   # 1e-300
    assert(k2 >= 0.0 && k2 < tiny, "K in [0, 1e-300)");
    # Just inside the range: −ΔG/RT = 700.
    var dg: f64 = ((-700.0) * KM_GAS_CONSTANT) * 298.0;
    var t3, v3 = equilibrium_constant(dg, 298.0);
    assert_eq(is_ok(t3), 1, "x = 700 is Ok");
    var k3: f64 = v3;
    var lk: f64 = f64_ln(k3);
    var rel: f64 = f64_abs((lk - 700.0) / 700.0);
    assert(rel < 0.000000000001, "ln K = 700");
}

fn _t_equilibrium_constant_negative_dg() {
    test_group("equilibrium_constant_negative_dg");
    var t, v = equilibrium_constant(-5000.0, 298.0);
    assert_eq(is_ok(t), 1, "Ok");
    var k: f64 = v;
    # exp(5000 / (8.314462618 × 298)) = 7.5232
    var x: f64 = 5000.0 / (KM_GAS_CONSTANT * 298.0);
    var expected: f64 = f64_exp(x);
    assert(near(k, expected, 0.000000000001) && k > 7.52 && k < 7.53, "K = 7.5232");
}

fn _t_equilibrium_constant_positive_dg() {
    test_group("equilibrium_constant_positive_dg");
    var t, v = equilibrium_constant(5000.0, 298.0);
    var k: f64 = v;
    assert(is_ok(t) == 1 && k < 1.0, "positive dG should give K < 1");
}

fn _t_equilibrium_constant_zero_dg() {
    test_group("equilibrium_constant_zero_dg");
    var t, v = equilibrium_constant(0.0, 298.0);
    var k: f64 = v;
    assert(is_ok(t) == 1 && near(k, 1.0, 0.0000000000000002220446049250313), "zero dG should give K = 1");
}

fn _t_equilibrium_constant_zero_temp_is_error() {
    test_group("equilibrium_constant_zero_temp_is_error");
    var t, v = equilibrium_constant(0.0, 0.0);
    assert_eq(is_err_result(t), 1, "T = 0 is Err");
}

fn _t_spontaneous_check() {
    test_group("spontaneous_check");
    assert_eq(is_spontaneous(-100.0), 1, "-100 is spontaneous");
    assert_eq(is_spontaneous(100.0), 0, "100 is not");
    assert_eq(is_spontaneous(0.0), 0, "0 is not");
}

# Cyrius-only: the error code of each guard, in Rust's order (T first), and NaN not spontaneous.
fn _t_cyrius_error_codes() {
    test_group("cyrius_error_codes");
    var nan: f64 = _km_nan();
    var t1, v1 = gibbs_free_energy(nan, -1.0, nan);
    assert(is_err_code(t1, v1, KM_ERR_INVALID_TEMPERATURE), "T is checked before dH and dS");
    var t2, v2 = gibbs_free_energy(nan, 298.0, 0.0);
    assert(is_err_code(t2, v2, KM_ERR_INVALID_INPUT), "NaN dH is InvalidInput");
    var t3, v3 = equilibrium_constant(nan, 298.0);
    assert(is_err_code(t3, v3, KM_ERR_INVALID_INPUT), "NaN dG is InvalidInput");
    var t4, v4 = equilibrium_constant(0.0, -298.0);
    assert(is_err_code(t4, v4, KM_ERR_INVALID_TEMPERATURE), "negative T is InvalidTemperature");
    assert_eq(is_spontaneous(nan), 0, "NaN is not spontaneous");
    var mz: f64 = -0.0;
    assert_eq(is_spontaneous(mz), 0, "-0 is not spontaneous");
}

# Runs every test group; returns the failure count from assert_summary().
fn main() {
    _t_gibbs_basic();
    _t_gibbs_zero_temp_is_error();
    _t_gibbs_nan_is_error();
    _t_equilibrium_constant_nan_is_error();
    _t_equilibrium_constant_overflow_is_error();
    _t_equilibrium_constant_negative_dg();
    _t_equilibrium_constant_positive_dg();
    _t_equilibrium_constant_zero_dg();
    _t_equilibrium_constant_zero_temp_is_error();
    _t_spontaneous_check();
    _t_cyrius_error_codes();
    return assert_summary();
}

var exit_code = main();
if (exit_code > 0) { exit_code = 1; }
sys_exit_group(exit_code);
