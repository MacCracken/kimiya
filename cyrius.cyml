[package]
name = "kimiya"
version = "${file:VERSION}"
description = "kimiya — chemistry engine: elements, molecules, stoichiometry, thermochemistry, gases, solutions, electrochemistry, kinetics, spectroscopy, nuclear chemistry"
license = "GPL-3.0-only"
repository = "https://github.com/MacCracken/kimiya"
language = "cyrius"
cyrius = "6.7.18"

[build]
entry = "src/main.cyr"
output = "build/kimiya"

# stdlib leaves, vendored into lib/ by `cyrius deps` and prepended to every compile.
#   math     — f64_clamp (gas); the transcendentals the modules call are kimiya's own correctly rounded
#              ones (src/mathx.cyr, ADR 0006), which since M4d call no stdlib transcendental
#   ganita   — ganita_f64_cbrt (gas; ganita 1.2.15 in the 6.7.18 bundle), and hisab's own use
#   overflow — the saturating `+|` / `-|` / `*|` operators (atom counts, balancing)
#   tagged / result — the value-form Option and Result
#   fnptr    — callbacks into the ODE and root-finding code (port plan §6.3)
# hisab's own bundle needs math, alloc, vec, ganita, result, str and fmt (dist/hisab.deps).
[deps]
stdlib = ["syscalls", "string", "alloc", "str", "fmt", "io", "vec", "args", "math", "ganita",
    "overflow", "tagged", "result", "fnptr"]

# hisab 3.4.1, pinned by tag: the numerical methods (port plan §6.2). No `path =` override,
# which would bypass the commit pin that cyrius.lock records.
[deps.hisab]
git = "https://github.com/MacCracken/hisab.git"
tag = "3.4.1"
modules = ["dist/hisab.cyr"]

# Test / bench / fuzz compiles only.
[test]
stdlib = ["assert", "bench"]

# `[lib]` is the bundle `cyrius distlib` writes to dist/kimiya.cyr. The list IS the concatenation
# order, and it is load-bearing: no src/ file includes another, so each module resolves at file
# scope against what precedes it. A module does `include` the stdlib leaves it calls (string, vec,
# str): distlib's compile-verify only sees calls a compile reaches, and a bundle reaches none, so
# without them dist/kimiya.deps listed `tagged` alone and a consumer's build failed (M1).
# The full order (docs/development/kimiya-port-plan.md §3 step 3; gas_data added before gas in M2a,
# organic_data before organic in M4b):
#   error → constants → mathx → validate → element_data → element → molecule → reaction → thermo →
#   thermochem_data → thermochem → phase_data → phase → gas_data → gas → solution →
#   electrochemistry_data → electrochemistry → kinetics → stoichiometry → organic_data → organic →
#   inorganic_data → inorganic → potential → nuclear_data → nuclear → spectroscopy_data → spectroscopy → numerics →
#   reaction_dynamics → network → fitting → sensitivity
# Modules are appended as their milestone lands (M2a: reaction, thermo, phase_data, phase, gas_data,
# gas; M2b: thermochem_data and thermochem, after thermo; M3a: solution, electrochemistry_data,
# electrochemistry, after gas; M3b: kinetics, after electrochemistry; M4b: organic_data, organic,
# inorganic_data, inorganic, after kinetics, where stoichiometry joins them before organic_data; M4c:
# nuclear_data, nuclear, after inorganic; M4d: potential, between inorganic and nuclear_data; M4e: spectroscopy_data,
# spectroscopy, after nuclear; M4f: stoichiometry, between kinetics and organic_data; M5a: numerics, reaction_dynamics,
# after spectroscopy; M5b: network, fitting, sensitivity, after reaction_dynamics).
# constants.cyr and *_data.cyr are generated by scripts/oracle; never edit them. thermo.cyr and thermochem.cyr read hisab's EPSILON_F64 (the
# [deps.hisab] bundle); nuclear.cyr's q_value sums its slices with thermo.cyr's _km_sum (M4c).
# spectroscopy.cyr (M4e) calls element.cyr's lookups, organic.cyr's _km_is_enum_value, inorganic.cyr's _km_is_u8 and
# nuclear.cyr's _km_is_u32, and includes lib/alloc.cyr (isotope_pattern's and fft_spectrum's heap work tables).
# stoichiometry.cyr (M4f) calls element.cyr's lookups and molecule.cyr's KmMolecule, and includes lib/alloc.cyr
# (balance_equation's and empirical_formula's heap work tables past their local ones).
# numerics.cyr (M5a: hisab 1.4.0's ODE integrators, dense solve and PCG32 draws, ADR 0003) calls mathx.cyr's correctly
# rounded pow, ln and cos and hisab 3.4.1's pcg32_new / pcg32_next and EPSILON_F64, and includes lib/alloc.cyr and
# lib/hisab.cyr; reaction_dynamics.cyr (M5a) calls numerics.cyr's routines through `callptr` (a builtin).
# M5b: numerics.cyr gains hisab 1.4.0's least squares, Jacobi rank and CSR compression (the CSR a hisab 3.4.1 csr_new
# handle); network.cyr and fitting.cyr call them (fitting also mathx.cyr's correctly rounded ln and exp), and
# sensitivity.cyr hisab 3.4.1's reverse-mode tape (ad_*) for compute_gradient; the three include lib/alloc.cyr, and
# network.cyr and sensitivity.cyr lib/hisab.cyr.
# `cyrius distlib --all` writes the bundle, `--check` verifies it.
[lib]
modules = [
    "src/error.cyr",
    "src/constants.cyr",
    "src/mathx_data.cyr",
    "src/mathx.cyr",
    "src/validate.cyr",
    "src/element_data.cyr",
    "src/element.cyr",
    "src/molecule.cyr",
    "src/reaction.cyr",
    "src/thermo.cyr",
    "src/thermochem_data.cyr",
    "src/thermochem.cyr",
    "src/phase_data.cyr",
    "src/phase.cyr",
    "src/gas_data.cyr",
    "src/gas.cyr",
    "src/solution.cyr",
    "src/electrochemistry_data.cyr",
    "src/electrochemistry.cyr",
    "src/kinetics.cyr",
    "src/stoichiometry.cyr",
    "src/organic_data.cyr",
    "src/organic.cyr",
    "src/inorganic_data.cyr",
    "src/inorganic.cyr",
    "src/potential.cyr",
    "src/nuclear_data.cyr",
    "src/nuclear.cyr",
    "src/spectroscopy_data.cyr",
    "src/spectroscopy.cyr",
    "src/numerics.cyr",
    "src/reaction_dynamics.cyr",
    "src/network.cyr",
    "src/fitting.cyr",
    "src/sensitivity.cyr",
]
